// A REPL whose footer counts and watched jobs come from outside its own
// run, as `agency agent`'s do once its sessions run through the driver.
// stage.js runs this with a line typed on stdin.
import { repl } from "std::ui/cli"

import { bump, tokenCounts, watchAJob } from "./outside.js"

def onSubmit(line: string): any {
  bump()
  return "said: ${line}"
}

def status(): any {
  return { left: "status" }
}

// An Agency function, so the REPL gets it wrapped, as the agent's will be.
def tokens(): any {
  return tokenCounts()
}

node main() {
  watchAJob()
  repl(status, onSubmit, tokens: tokens)
  return "done"
}
