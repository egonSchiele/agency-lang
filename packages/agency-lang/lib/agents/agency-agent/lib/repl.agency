  lineWasTyped,
  repl,
  clearHistory,
  clearScreen,
 } from "std::ui/cli"

import { showCapabilities, editCapabilities } from "./capabilitiesUi.agency"
import {
  canCompact,
  compactConversation,
  compactionDue,
  compactionFailed,
  contextStatus,
 } from "./compaction.agency"
