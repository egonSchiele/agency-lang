import { getGeneratedTools, learnSessionTools } from "std::agents/lib/learning"
import { assistantMessage, userMessage } from "std::thread"

// Two turns of one session with a pause between them, as a session run
// pauses between its turns. The first turn learns two tools. The pause is
// saved, and a second process resumes it and runs the second turn, which
// calls the learned tools.

effect test::nextTurn { }

let turns = 0

node main() {
  turns = turns + 1
  const learned = learnSessionTools({ kind: "file", dir: "./test-output/source", filename: "tools.agency" }, ["seriesInfo", "seriesLabel"]) with approve
  if (learned is failure) {
    return learned
  }
  thread(label: "main", session: "main") {
    userMessage("Learn seriesInfo and seriesLabel")
    assistantMessage("Learned session_seriesInfo and session_seriesLabel")
  }

  interrupt test::nextTurn("The next turn?", {})

  turns = turns + 1
  thread(label: "main", session: "main") {
    const answer = llm("Call the learned function for UNRATE.", tools: getGeneratedTools()) with approve
  }
  return { turns: turns, tools: [tool.name for tool in getGeneratedTools()] }
}
