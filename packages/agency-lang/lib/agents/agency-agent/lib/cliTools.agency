/** @module
  @summary The tools only the command-line agent offers: the user's MCP
  tools, learned tools, Claude Code skills, and saved tools, the tools that
  save skills, tools, and presets, the session search, and in the REPL the
  background job tools. The harness passes them to `agencyAgent`.
*/
import { AgencySource } from "std::agency"
import { AgentSettings, commandJudgeFor, reasoningOptions } from "std::agents/brains/settings"
import { coordinatorTools } from "std::agents/brains/coordinator"
import { getGeneratedTools, learnSessionTools } from "std::agents/lib/learning"
import { jobTools, spillTools } from "std::agents/lib/toolkits"
import { skillsDir } from "std::skills"
import { endTurn } from "std::thread"

import { checkBundledSkill } from "./bundledSkills.agency"
import { claudeSkillTools } from "./claudeSkills.agency"
import { learnSkill, writeToolFor } from "./learn.agency"
import { learnedExtras } from "./learned.agency"
import { useLlmOptions } from "./llmOptionTools.agency"
import { getMcpTools } from "./mcp.agency"
import { deletePreset, listPresets, savePreset } from "./presetTools.agency"
import { searchSessions } from "./sessionSearch.agency"
import { getJudgeModel, getJudgeProvider } from "../shared.agency"

// Skills about the agent itself. The folder ships with the agent, so the
// scan is approved here, as the bundled prompt reads are. An outer handler
// that rejects the scan still wins.
static const agentSkills = skillsDir(
  __dirname + "/../skills",
  "flat",
  name: "coordinator_skills",
) with approve

/** A failure when the bundled skills folder is missing. A wrong path does
  not make skillsDir fail, so the check looks for a skill the folder is
  known to hold. The caller stops the run: the terminal prints the reason
  and exits. */
export def checkCliBundles(): Result<boolean> {
  const checked = checkBundledSkill(agentSkills, "presets")
  if (checked is failure(reason)) {
    return failure("Agent setup failed: ${reason}")
  }
  return success(true)
}

// Whether a turn is offered the background job tools. On for the REPL,
// where a job outlives the turn that started it. A
// one-shot run turns them off (setInteractive in trace.agency): its turn is
// the whole run, so a model that started a job could never read it.
let _jobToolsOn: boolean = true

/** Offer the background job tools to later turns, or stop offering them. */
export def setJobToolsOn(on: boolean) {
  _jobToolsOn = on
}

/** The job tools for this session: none in a one-shot run, whose model
  could never read a job it started, since its turn is the whole run. A
  job's line is judged by the judge slot's model, when one is set. */
export def sessionJobTools(): any[] {
  if (!_jobToolsOn) {
    return []
  }
  return jobTools(commandJudgeFor(getJudgeModel(), getJudgeProvider()))
}

// A long job read is saved and previewed. The coordinator has no shell to
// read its path with, so it gets the readers for saved output too.
def jobAndSpillTools(): any[] {
  const jobs = sessionJobTools()
  if (jobs.length == 0) {
    return []
  }
  return [...jobs, ...spillTools()]
}

export def cliTools(turnStart: any, settings: AgentSettings): any[] {
  """
  The tools the command-line agent adds to the coordinator's own. The
  tools that differ per user come first, since the router reads the first
  names it is given. The learned and saved tools are read from the agent
  home on every turn, so a tool the user saves in this session is callable
  on the next turn.
  """
  return [
    ...learnedExtras(),
    ...getGeneratedTools(),
    ...claudeSkillTools(),
    ...getMcpTools(),
    learnSkill,
    writeToolFor,
    agentSkills,
    listPresets,
    savePreset,
    deletePreset,
    useLlmOptions,
    learnTools.partial(turnStart: turnStart, settings: settings),
    searchSessions,
    ...jobAndSpillTools(),
  ]
}

handoff def learnTools(
  turnStart: any,
  settings: AgentSettings,
  source: AgencySource,
  names: string[] = [],
  namespace: string = "session",
): Result<string> {
  """
  Learn exported Agency functions for this conversation, then continue
  the user's request with those tools available immediately. Read a
  documentation URL first and resolve it to a stdlib module or Agency
  source. An empty names list learns all supported public functions.

  Learning runs the module's top-level code in a subprocess and can ask
  for approval. Every later call also uses the normal subprocess gates.
  Tools remain available after this conversation is resumed. They are
  not saved in the permanent toolbox. Existing names are never replaced;
  choose another namespace if a name is already available.
  """
  const before = [...coordinatorTools(settings, turnStart), ...cliTools(turnStart, settings)]
  const offeredNames = [tool.name for tool in before]
  const learned = learnSessionTools(source, names, namespace, offeredNames)?
  const tools = [...coordinatorTools(settings, turnStart), ...cliTools(turnStart, settings)]
  const answer = llm(
    "The tools ${learned.join(", ")} are now available for this conversation. Continue the user's request using them as needed.",
    {
      ...reasoningOptions(settings),
      memory: true,
      tools: tools
    },
  )
  endTurn()
  return success(answer)
}
