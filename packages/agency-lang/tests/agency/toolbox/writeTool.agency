// writeTool, the plain save primitive: no model is called, the source is
// wrapped and typechecked, and one std::toolbox::save interrupt gates the
// publish. Every node here runs without an LLM mock, so a model call
// anywhere in the path fails the test.
import { remove } from "std::fs"
import { exists, ls } from "std::shell"
import { writeTool, listTools } from "std::toolbox"

const OUT = __dirname + "/test-output"
const TOOLS = __dirname + "/fixtures/tools"
const REQUEST = "{ n: number }"

def goodSource(): string {
  const source = read("good/impl.agency", TOOLS) with approve
  return source catch ""
}

/** What one writeTool call raised, with its outcome. */
type WriteRun = {
  result: Result;
  saves: number;
  reviews: number
}

// Approve everything; a null `saveVerdict` rejects the save. Counts the
// save and review interrupts, so a test can show the save gate was
// raised, or that nothing was asked.
def runWrite(
  name: string,
  source: string,
  dir: string,
  saveVerdict: string | null = "approve",
): WriteRun {
  let saves = 0
  let reviews = 0
  let result: Result = failure("not run")
  handle {
    result = writeTool(
      name: name,
      purpose: "Add one to a number.",
      request: REQUEST,
      source: source,
      dir: dir,
    )
  } with (intr) {
    return match(intr.effect) {
      "std::toolbox::save" => {
        saves = saves + 1
        if (saveVerdict == null) {
          return reject("cancelled by the test")
        }
        return approve()
      }
      "std::toolbox::review" => {
        reviews = reviews + 1
        return approve()
      }
      _ => approve()
    }
  }
  return {
    result: result,
    saves: saves,
    reviews: reviews
  }
}

def cleanup(name: string) {
  remove(OUT + "/${name}") with approve
  remove(OUT + "/staging") with approve
}

def stagingGone(): boolean {
  const staged = ls("${OUT}/staging") with approve
  return (staged catch []).length == 0
}

// The saved tool has the two module files and meta.json, and no generated
// tests: only the design loop tests a draft.
node approveSavesTheTool(): boolean {
  cleanup("plainOne")
  const ran = runWrite("plainOne", goodSource(), OUT)
  const hasImpl = exists("plainOne/impl.agency", OUT)
  const hasTool = exists("plainOne/tool.agency", OUT)
  const hasMeta = exists("plainOne/meta.json", OUT)
  const noCases = !exists("plainOne/tool.test.json", OUT)
  const listed = listTools(OUT) with approve
  let inCatalog = false
  if (listed is success(entries)) {
    inCatalog = some(
      entries,
      \entry -> entry.name == "plainOne" && entry.broken == null && entry.meta.request == REQUEST,
    )
  }
  const cleared = stagingGone()
  cleanup("plainOne")
  return ran.result is success && ran.saves == 1 && ran.reviews == 0 && hasImpl && hasTool && hasMeta && noCases && inCatalog && cleared
}

// The save payload shows what will be published: the source as given
// and the effects the typecheck found.
node saveShowsSourceAndEffects(): boolean {
  cleanup("plainShown")
  let shown: any = null
  handle {
    writeTool(
      name: "plainShown",
      purpose: "Add one to a number.",
      request: REQUEST,
      source: goodSource(),
      dir: OUT,
    )
  } with (intr) {
    if (intr.effect == "std::toolbox::save") {
      shown = intr.data
    }
    return approve()
  }
  cleanup("plainShown")
  if (shown == null) {
    return false
  }
  return shown.name == "plainShown" && shown.dir == OUT && shown.source == goodSource() && shown.effects.length == 0
}

node rejectWritesNothing(): boolean {
  cleanup("plainTwo")
  const ran = runWrite("plainTwo", goodSource(), OUT, null)
  const nothing = !exists("plainTwo", OUT)
  const cleared = stagingGone()
  cleanup("plainTwo")
  return ran.result is failure && "${ran.result.error}" =~ re/cancelled by the test/ && ran.saves == 1 && nothing && cleared
}

// A source without `run` fails the typecheck of the assembled tool. The
// failure is a plain message, and nobody is asked to approve it.
node wrongExportFailsBeforeAsking(): boolean {
  cleanup("plainThree")
  const source = goodSource().replace("export def run(", "export def compute(")
  const ran = runWrite("plainThree", source, OUT)
  const nothing = !exists("plainThree", OUT)
  const cleared = stagingGone()
  cleanup("plainThree")
  return ran.result is failure && "${ran.result.error}" =~ re/run/ && ran.saves == 0 && nothing && cleared
}

// A raw primitive that raises no interrupt is refused by the sandboxed
// compile, the same check the design loop relies on.
node nodeImportFailsBeforeAsking(): boolean {
  cleanup("plainFour")
  const source = goodSource().replace(
    "import { Json } from \"std::validation\"",
    "import { Json } from \"std::validation\"\nimport { _which } from \"agency-lang/stdlib-lib/shell.js\"",
  )
  const ran = runWrite("plainFour", source, OUT)
  const nothing = !exists("plainFour", OUT)
  cleanup("plainFour")
  return ran.result is failure && ran.saves == 0 && nothing
}

// The name check runs before staging and before the gate.
node refusesAnExistingName(): boolean {
  const ran = runWrite("good", goodSource(), TOOLS)
  return ran.result is failure && "${ran.result.error}" =~ re/exists/ && ran.saves == 0
}
