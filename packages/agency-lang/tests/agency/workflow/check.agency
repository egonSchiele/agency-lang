import { checkWorkflow, Workflow, WorkflowProblem } from "std::workflow"
import { Json } from "std::validation"
import { searchNotes, readNote, untyped } from "./fixtures/tools/notes.agency"
import { findLists, addListItems } from "./fixtures/tools/lists.agency"
import { greet } from "./fixtures/tools/withHelper.agency"

const DIR = __dirname + "/fixtures/tools"
const TOOLS = [searchNotes, readNote, untyped]

/** Two steps: search, then read the first match with `textArgs`. */
def twoSteps(noteArgs: Json, textArgs: Json): Workflow {
  return {
    format: 1,
    name: "readFirst",
    description: "Read the first note that matches a title.",
    inputs: "{ noteTitle: string }",
    steps: [
      { id: "note", kind: "tool", module: "./notes.agency", tool: "searchNotes", args: noteArgs },
      { id: "text", kind: "tool", module: "./notes.agency", tool: "readNote", args: textArgs }
    ]
  }
}

def goodNoteArgs(): Json {
  return { query: { "$ref": "inputs.noteTitle" } }
}

def goodTextArgs(): Json {
  return { id: { "$ref": "steps.note[0].id" } }
}

/** `step/field` of the first problem, or what went wrong instead. */
def firstProblem(workflow: Workflow): string {
  const checked = checkWorkflow(workflow, TOOLS, DIR) with approve
  if (checked is success) {
    return "no problems"
  }
  const first = checked.data.problems[0]
  print("first problem: ${JSON.stringify(first)}")
  return "${first.step}/${first.field}"
}

def firstMessage(workflow: Workflow): string {
  const checked = checkWorkflow(workflow, TOOLS, DIR) with approve
  if (checked is success) {
    return "no problems"
  }
  return checked.data.problems[0].message
}

node cleanWorkflowHasNoProblems(): boolean {
  const checked = checkWorkflow(twoSteps(goodNoteArgs(), goodTextArgs()), TOOLS, DIR) with approve
  if (checked is failure) {
    print("problems: ${JSON.stringify(checked.data)}")
    return false
  }
  return checked.value.length == 0
}

node badPathNamesStepAndArgument(): string {
  return firstProblem(twoSteps(goodNoteArgs(), { id: { "$ref": "steps.note[0].title2" } }))
}

node wrongArgumentNameNamesTheArgument(): string {
  return firstProblem(twoSteps({ querry: { "$ref": "inputs.noteTitle" } }, goodTextArgs()))
}

node unknownToolIsRefusedBeforeCompile(): boolean {
  const workflow: Workflow = {
    format: 1,
    name: "shell",
    description: "Run a command.",
    inputs: "{ command: string }",
    steps: [{ id: "run", kind: "tool", module: "std::shell", tool: "bash", args: { command: { "$ref": "inputs.command" } } }]
  }
  return firstMessage(workflow).includes("not among the tools passed")
}

node forwardReferenceIsRefused(): string {
  const workflow = twoSteps({ query: { "$ref": "steps.text.title" } }, goodTextArgs())
  if (!firstMessage(workflow).includes("comes after")) {
    return firstMessage(workflow)
  }
  return firstProblem(workflow)
}

node noReturnTypeIsAWarning(): string {
  const workflow: Workflow = {
    format: 1,
    name: "untypedFirst",
    description: "Read a note named by an untyped tool.",
    inputs: "{ noteTitle: string }",
    steps: [
      { id: "u", kind: "tool", module: "./notes.agency", tool: "untyped", args: { q: { "$ref": "inputs.noteTitle" } } },
      { id: "text", kind: "tool", module: "./notes.agency", tool: "readNote", args: { id: { "$ref": "steps.u[0]" } } }
    ]
  }
  const checked = checkWorkflow(workflow, TOOLS, DIR) with approve
  if (checked is failure) {
    print("problems: ${JSON.stringify(checked.data)}")
    return "failed"
  }
  const warnings: WorkflowProblem[] = checked.value
  if (warnings.length == 0) {
    return "no warnings"
  }
  return "${warnings[0].step}/${warnings[0].field}"
}

node wrongArgumentTypeNamesTheArgument(): string {
  return firstProblem(twoSteps(goodNoteArgs(), { id: { "$ref": "steps.note" } }))
}

node badResultPathNamesTheResult(): string {
  const workflow: Workflow = {
    format: 1,
    name: "readFirst",
    description: "Read the first note that matches a title.",
    inputs: "{ noteTitle: string }",
    steps: [{ id: "note", kind: "tool", module: "./notes.agency", tool: "searchNotes", args: goodNoteArgs() }],
    result: { "$ref": "steps.note[0].nope" }
  }
  return firstProblem(workflow)
}

node badOutputTypeNamesTheStep(): string {
  const workflow: Workflow = {
    format: 1,
    name: "summarize",
    description: "Summarize the first matching note.",
    inputs: "{ noteTitle: string }",
    steps: [
      { id: "note", kind: "tool", module: "./notes.agency", tool: "searchNotes", args: goodNoteArgs() },
      { id: "m", kind: "llm", prompt: "Summarize the note.", context: [{ "$ref": "steps.note[0].body" }], output: "Nope" }
    ]
  }
  return firstProblem(workflow)
}

node everyBadToolIsReported(): string {
  const badTools = [searchNotes.partial(query: "x"), findLists.rename("find"), readNote]
  const checked = checkWorkflow(twoSteps(goodNoteArgs(), goodTextArgs()), badTools, DIR) with approve
  if (checked is success) {
    return "no problems"
  }
  const problems: WorkflowProblem[] = checked.data.problems
  let messages: string[] = []
  for (problem in problems) {
    messages.push(problem.message)
  }
  return messages.join(" | ")
}

/** A workflow whose `raises` leaves out what its last step raises. The
  problem is on that step's tool, from the effects `describe` reports. */
node raisesLeavesOutAStepsEffect(): Json {
  const workflow: Workflow = {
    format: 1,
    name: "addOne",
    description: "Find a list and add soup to it.",
    inputs: "{ query: string }",
    raises: ["std::read"],
    steps: [
      { id: "list", kind: "tool", module: "./lists.agency", tool: "findLists", args: { query: { "$ref": "inputs.query" } } },
      { id: "add", kind: "tool", module: "./lists.agency", tool: "addListItems", args: { listId: { "$ref": "steps.list[0].id" }, items: ["soup"], section: "Meals" } }
    ]
  }
  const checked = checkWorkflow(workflow, [findLists, addListItems], DIR) with approve
  if (checked is success) {
    return "no problems"
  }
  return map(checked.data.problems, \problem -> "${problem.step}/${problem.field}")
}

/** The workflow named by greetWorkflow in run.agency: one step whose tool's
  module imports another local file. */
def greetWorkflow(): Workflow {
  return {
    format: 1,
    name: "greetOne",
    description: "Greet someone loudly.",
    inputs: "{ name: string }",
    steps: [{ id: "greeting", kind: "tool", module: "./withHelper.agency", tool: "greet", args: { name: { "$ref": "inputs.name" } } }]
  }
}

node toolWithLocalImportChecks(): Json {
  const checked = checkWorkflow(greetWorkflow(), [greet], DIR) with approve
  if (checked is failure) {
    return checked.error
  }
  return checked.value
}
