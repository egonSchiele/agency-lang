{
  "sourceFile": "routedTurn.agency",
  "tests": [
    {
      "nodeName": "slotUnsetAsksNoRouter",
      "description": "with the router slot unset no decision request is made",
      "input": "",
      "expectedOutput": "\"coordinator answer|0\"",
      "evaluationCriteria": [
        {
          "type": "exact"
        }
      ],
      "useTestLLMProvider": true,
      "llmMocks": [
        {
          "return": "coordinator answer"
        }
      ]
    },
    {
      "nodeName": "confidentResearchGoesToTheResearcher",
      "description": "a confident research route runs the researcher on the user's message, and the coordinator model is not asked",
      "input": "",
      "expectedOutput": "\"research answer (https://example.com/node)|2|true|true\"",
      "evaluationCriteria": [
        {
          "type": "exact"
        }
      ],
      "useTestLLMProvider": true,
      "llmMocks": [
        {
          "decide": {
            "answer": {
              "type": "choice",
              "choice": "research",
              "confidence": 0.9,
              "probabilities": {
                "research": 0.9,
                "code": 0.05,
                "coordinator": 0.05
              }
            }
          }
        },
        {
          "return": "research answer (https://example.com/node)"
        }
      ]
    },
    {
      "nodeName": "confidentCodeGoesToTheCoder",
      "description": "a confident code route runs the coder on the user's message",
      "input": "",
      "expectedOutput": "\"code answer|2|true\"",
      "evaluationCriteria": [
        {
          "type": "exact"
        }
      ],
      "useTestLLMProvider": true,
      "llmMocks": [
        {
          "decide": {
            "answer": {
              "type": "choice",
              "choice": "code",
              "confidence": 0.9,
              "probabilities": {
                "code": 0.9,
                "research": 0.05,
                "coordinator": 0.05
              }
            }
          }
        },
        {
          "return": "code answer"
        }
      ]
    },
    {
      "nodeName": "coordinatorRouteRunsTheCoordinator",
