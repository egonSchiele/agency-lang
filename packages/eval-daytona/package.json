{
  "name": "@agency-lang/eval-daytona",
  "version": "0.0.1",
  "description": "Run Agency eval tests in Daytona containers, one container per test",
  "type": "module",
  "bin": {
    "agency-eval-daytona": "./dist/src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/main.d.ts",
      "import": "./dist/src/main.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/"
  ],
  "author": "Aditya Bhargava",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/egonSchiele/agency-lang/issues"
  },
  "homepage": "https://github.com/egonSchiele/agency-lang",
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "test:run": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts"
  },
  "dependencies": {
    "@daytona/sdk": "^0.232.0",
    "commander": "^14.0.0",
    "nanoid": "^5.1.6",
    "zod": "^4.3.5"
  },
  "peerDependencies": {
    "agency-lang": ">=0.46.0"
  },
  "devDependencies": {
    "agency-lang": "workspace:*",
    "@types/node": "^25.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
