import { _authorizeCalendar, _listEvents, _createEvent, _updateEvent, _deleteEvent, _isCalendarAuthorized } from "agency-lang/stdlib-lib/calendar.js"

/** @module
  @summary Read and manage Google Calendar events.
  Read and write Google Calendar events from Agency code. Authorizes once
  via Google OAuth, then lists, creates, updates, and deletes events.

  Set `GOOGLE_CLIENT_ID` and `GOOGLE_CLIENT_SECRET` (OAuth 2.0 desktop
  credentials from the Google Cloud console) for the example below.
  `authorizeCalendar` opens a browser for consent. Agency stores the tokens
  locally and refreshes them when possible.

  ```ts
  import { authorizeCalendar, isCalendarAuthorized, listEvents, createEvent } from "std::calendar"
  import { env } from "std::system"

  node main() {
    if (!isCalendarAuthorized()) {
      const clientId = env("GOOGLE_CLIENT_ID") with approve
      const clientSecret = env("GOOGLE_CLIENT_SECRET") with approve
      authorizeCalendar(clientId, clientSecret)
    }

    print(listEvents())

    createEvent(
      summary: "Team meeting",
      start: "2026-05-10T10:00:00-07:00",
      end: "2026-05-10T11:00:00-07:00"
    )
  }
  ```

  Times use ISO 8601 with a timezone (e.g. "2026-05-10T10:00:00-07:00"), or a
  date only (e.g. "2026-05-10") for all-day events. Pair with `std::date`
  helpers like `tomorrow` and `atTime` for convenient date construction.
*/

type CalendarEvent = {
  id: string;
  summary: string;
  description: string;
  location: string;
  start: string;
  end: string;
  htmlLink: string
}

@always(clientId)
effect std::authorizeCalendar { clientId: string }
@always(calendarId)
effect std::listEvents { maxResults: number, calendarId: string, query: string }
effect std::createEvent { summary: string, start: string, end: string, description: string, location: string }
effect std::updateEvent { eventId: string, summary: string, start: string, end: string }
@always(calendarId)
effect std::deleteEvent { eventId: string, calendarId: string }

/**
  Set up Google OAuth desktop credentials before authorizing. Tokens use
  the `google-calendar` provider in `std::auth/oauth` and refresh when
  possible. Use that module directly for custom scopes or callback ports.
*/
@capabilities(fileRead, fileWrite, network, subprocess, env)
export def authorizeCalendar(clientId: string, clientSecret: string): Result raises <std::authorizeCalendar> {
  """
  Open the browser to authorize Google Calendar access.

  @param clientId - The client ID from Google OAuth desktop credentials.
  @param clientSecret - The matching Google OAuth client secret.
  """
  return interrupt std::authorizeCalendar("Are you sure you want to authorize access to Google Calendar?", {
    clientId: clientId
  })

  return try _authorizeCalendar(clientId, clientSecret)
}

@capabilities(fileRead)
export def isCalendarAuthorized(): boolean {
  """
  Check whether Google Calendar tokens are stored locally, without verifying their validity.
  """
  return _isCalendarAuthorized()
}

@capabilities(fileRead, fileWrite, network, subprocess, env)
export def listEvents(maxResults: number = 10, timeMin: string = "", timeMax: string = "", query: string = "", calendarId: string = "primary"): Result raises <std::listEvents> {
  """
  List Google Calendar events in start-time order.

  @param timeMin - An ISO 8601 timestamp with timezone, or empty to start at the current time.
  @param timeMax - An ISO 8601 timestamp with timezone, or empty for no upper bound.
  @param query - Free-text terms to match against events.
  @param calendarId - Use "primary" for the signed-in user's primary calendar.
  """
  return interrupt std::listEvents("Are you sure you want to read your Google Calendar events?", {
    maxResults: maxResults,
    calendarId: calendarId,
    query: query
  })

  return try _listEvents({
    maxResults: maxResults,
    timeMin: timeMin,
    timeMax: timeMax,
    query: query,
    calendarId: calendarId
  })
}

/**
  For an all-day event, pass dates with an exclusive end date. For example,
  May 10 alone uses start `"2026-05-10"` and end `"2026-05-11"`.
*/
@capabilities(fileRead, fileWrite, network, subprocess, env)
export def createEvent(summary: string, start: string, end: string, description: string = "", location: string = "", calendarId: string = "primary"): Result raises <std::createEvent> {
  """
  Create a Google Calendar event.

  @param start - An ISO 8601 timestamp with timezone, or YYYY-MM-DD for an all-day event.
  @param end - An ISO 8601 timestamp with timezone, or the exclusive end date for an all-day event.
  @param calendarId - Use "primary" for the signed-in user's primary calendar.
  """
  return interrupt std::createEvent("Are you sure you want to create this calendar event?", {
    summary: summary,
    start: start,
    end: end,
    description: description,
    location: location
  })

  destructive {
    return try _createEvent({
      summary: summary,
      start: start,
      end: end,
      description: description,
      location: location,
      calendarId: calendarId
    })
  }
}

@capabilities(fileRead, fileWrite, network, subprocess, env)
export def updateEvent(eventId: string, summary: string = "", start: string = "", end: string = "", description: string = "", location: string = "", calendarId: string = "primary"): Result raises <std::updateEvent> {
  """
  Update the supplied fields of a Google Calendar event, leaving empty fields unchanged.

  @param eventId - The event id returned by a calendar listing or creation.
  @param start - A timestamp with timezone or all-day date, or empty to leave unchanged.
  @param end - A timestamp with timezone or exclusive all-day end date, or empty to leave unchanged.
  @param calendarId - The calendar containing the event.
  """
  return interrupt std::updateEvent("Are you sure you want to update this calendar event?", {
    eventId: eventId,
    summary: summary,
    start: start,
    end: end
  })

  destructive {
    return try _updateEvent({
      eventId: eventId,
      summary: summary,
      start: start,
      end: end,
      description: description,
      location: location,
      calendarId: calendarId
    })
  }
}

@capabilities(fileRead, fileWrite, network, subprocess, env)
export def deleteEvent(eventId: string, calendarId: string = "primary"): Result raises <std::deleteEvent> {
  """
  Delete a Google Calendar event.

  @param eventId - The event id returned by a calendar listing or creation.
  @param calendarId - The calendar containing the event.
  """
  return interrupt std::deleteEvent("Are you sure you want to delete this calendar event?", {
    eventId: eventId,
    calendarId: calendarId
  })

  destructive {
    return try _deleteEvent(eventId, calendarId)
  }
}
