node findAsksStdGlob() {
  return [
    grepNames("find . -name '*.txt'"),
    grepNames("find . -iname '*.TXT' -type f"),
    grepNames("find . -type f -not -path '*/node_modules/*'"),
    grepNames("find . -H -name x"),
    grepNames("find . . -name x"),
    grepNames("find . -maxdepth 2 -print0"),
    grepNames("find . -name *.txt"),
    grepNames("find . -delete"),
    grepNames("find . -exec rm {} \\;"),
    grepNames("find . -L -name x"),
    grepNames("find -name x"),
    grepNames("find . -name x foo"),
    grepNames("find . -name a -o -name b"),
    grepNames("find . -maxdepth x"),
    grepNames("find . -maxdepth 0"),
    grepNames("find . -newer one.txt"),
    grepNames("find . -size -1M"),
    grepNames("find one.txt -name x"),
    grepNames("find . -name '*.txt' | head"),
  ]
}

def globPayloads(source: string): any {
  // The for-and-if shape, so `payload` narrows to GlobPayload.
  let out: any[] = []
  for (effect in planFor(source, FIXTURES).effects) {
    if (effect.name == "std::glob") {
      out.push([effect.payload.pattern, effect.payload.dir == FIXTURES])
    }
  }
  return out
}

node findPatterns() {
  return [
    globPayloads("find . -name '*.txt'"),
    globPayloads("find . -maxdepth 1 -name '*.txt'"),
    globPayloads("find . -type f"),
    globPayloads("find . -maxdepth 1"),
    globPayloads("find . -maxdepth 3 -name x"),
    globPayloads("find . -not -name '*.txt'"),
    globPayloads("find . -name '*.txt' -o -type d"),
    globPayloads("find . -path ./node_modules -prune -o -name '*.txt'"),
    globPayloads("find . -maxdepth 1 -not -name x"),
  ]
}

node findUnderRecommendedNeedsNoPrompt() {
  // No interruptHandlers entry: an unanswered interrupt fails the run.
  let found = false
  handle {
    const result = safeBash("find " + FIXTURES + " -name '*.txt'")
    if (result is success(text)) {
      found = text.includes("one.txt")
    }
  } with (intr) {
    if (checkPolicy(recommendedAutoApprovePolicy, intr).type == "approve") {
      return approve()
    }
    return reject()
  }
  return found
}

node findOutsideTheLaunchDirIsUndecided() {
  const plan = planFor("find /etc -name hosts", FIXTURES)
  for (effect in plan.effects) {
    if (effect.name == "std::glob") {
      const intr = { effect: effect.name, data: effect.payload }
      return checkPolicy(recommendedAutoApprovePolicy, intr).type
    }
  }
  return "NO GLOB EFFECT"
}

node findAsksOneQuestion() {
  // find lists in directory order, which differs between file systems,
  // so the lines are compared sorted.
  const result = safeBash("find . -name '*.txt'", cwd: FIXTURES)
  if (result is failure(why)) {
    return "FAILED: ${why}"
  }
  return [line for line in result.value.split("\n") if line != ""].sort()
}

node programsAskStdExec() {
  return [
    grepNames("pnpm test"),
    grepNames("pnpm run build"),
    grepNames("tsc --noEmit"),
    grepNames("pytest tests/*.py"),
    grepNames("pnpm test > out.log"),
    grepNames("make 2>&1 | tail -100"),
    grepNames("git status && pnpm test"),
    grepNames("git push --force"),
    grepNames("find . -delete"),
    grepNames("tail -f one.txt"),
    grepNames("sh -c x"),
    grepNames("env FOO=1 pnpm test"),
    grepNames("sudo make install"),
    grepNames("FOO=1 pnpm test"),
    grepNames("pnpm test $X"),
    grepNames("./gradlew test"),
    grepNames("git log | python3 count.py"),
    grepNames("pnpm test < one.txt"),
    grepNames("echo a; agency --version"),
    grepNames("cd .. && cat one.txt"),
    grepNames("hash -p /tmp/x git; git status"),
    grepNames("export X=1; pnpm test"),
    grepNames("true"),
    grepNames("npx -y foo"),
    grepNames("pnpm test | grep -v warn"),
    grepNames("cat one.txt | pnpm test"),
    grepNames("echo a; which agency"),
  ]
}

/** The payloads of the effects named `name` in the plan for `source`.
 * Read through an `any` local, as payloadValuesAreCorrect does: a name
 * held in a variable does not narrow the Effect union. */
def payloadsNamed(source: string, name: string): any[] {
  let out: any[] = []
  for (effect in planFor(source, FIXTURES).effects) {
    const each: any = effect
    if (each.name == name) {
      out.push(each.payload)
    }
  }
  return out
}

def execFields(source: string): any {
  return [[p.command, p.args, p.subcommand, p.cwd == FIXTURES, p.timeout, p.stdin] for p in payloadsNamed(source, "std::exec")]
}

node execPayloadFields() {
  return [
    execFields("pnpm run build --filter=web"),
    execFields("make"),
    execFields("pytest tests/*.py -k fast"),
  ]
}

node programAsksOneQuestion() {
  // One std::exec question, approved by the test file. A std::bash prompt
  // would fail the run on an unmatched interrupt.
  const result = safeBash("node --version", cwd: FIXTURES)
  if (result is failure(why)) {
    return "FAILED: ${why}"
  }
  return result.value.startsWith("v")
}

node programUnderRecommendedIsUndecided() {
  const plan = planFor("pnpm test", FIXTURES)
  for (effect in plan.effects) {
    if (effect.name == "std::exec") {
      const intr = { effect: effect.name, data: effect.payload }
      return checkPolicy(recommendedAutoApprovePolicy, intr).type
    }
  }
  return "NO EXEC EFFECT"
}

/** The rule "approve always here" saves for `node --version`. */
const NODE_VERSION_POLICY = {
  "std::exec": [
    { "match": { "command": "node", "subcommand": "--version" }, "action": "approve" }
  ]
}

node programUnderASavedRuleRuns() {
  // No interruptHandlers entry: the saved rule must answer the question.
  let ran = false
  handle {
    const result = safeBash("node --version", cwd: FIXTURES)
    if (result is success(text)) {
      ran = text.startsWith("v")
    }
  } with (intr) {
    return checkPolicy(NODE_VERSION_POLICY, intr)
  }
  return ran
}
