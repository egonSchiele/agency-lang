import { setLlmOptions } from "std::llm"

def nextTwoPrimes(): number[] {
  return llm("What are the next 2 prime numbers after that?")
}

node main() {
  // This test checks the thread plumbing by comparing the model's own
  // answers, so under a real LLM it needs the model and route those
  // expectations were captured on. The route matters as much as the model:
  // openai-responses enforces the declared return type strictly, so a
  // prompt asking for two numbers typed as a single `number` comes back as
  // one number there but as a list here.
  setLlmOptions({ model: "gpt-4o-mini", provider: "openai" })
  const msgs = thread {
    const res1: number[] = llm("What is the first prime number > 100?")
    const msgs2 = thread {
      const res2: number[] = nextTwoPrimes()
      const msgs3 = subthread {
        const res3: number[] = nextTwoPrimes()
      }
      const msgs4 = thread {
        const res4: number[] = nextTwoPrimes()
      }

    }
    const msgs5 = subthread {
      const res5: number[] = nextTwoPrimes()
      const msgs6 = subthread {
        const res6: number[] = nextTwoPrimes()
      }
      const msgs7 = thread {
        const res7: number[] = nextTwoPrimes()
      }

    }
  }

  return {
    msgs: msgs,
    msgs2: msgs2,
    msgs3: msgs3,
    msgs4: msgs4,
    msgs5: msgs5,
    msgs6: msgs6,
    msgs7: msgs7
  }
}