import { runWorkflow, Workflow } from "std::workflow"
import { Json } from "std::validation"
import { searchNotes, readNote } from "./fixtures/tools/notes.agency"
import { findLists, addListItems } from "./fixtures/tools/lists.agency"
import { slowEcho } from "./fixtures/tools/slow.agency"

const DIR = __dirname + "/fixtures/tools"
const TOOLS = [searchNotes, readNote, findLists, addListItems]

/** The spec's meal plan, with no limits. */
def mealPlan(): Workflow {
  return {
    format: 1,
    name: "updateMealPlanFromNote",
    description: "Copy this week's meal plan from the groceries note to the weekly meal plan list.",
    inputs: "{ noteTitle: string }",
    steps: [
      { id: "note", kind: "tool", module: "./notes.agency", tool: "searchNotes", args: { query: { "$ref": "inputs.noteTitle" } } },
      { id: "text", kind: "tool", module: "./notes.agency", tool: "readNote", args: { id: { "$ref": "steps.note[0].id" } } },
      { id: "list", kind: "tool", module: "./lists.agency", tool: "findLists", args: { query: "weekly meal plan" } },
      {
        id: "meals",
        kind: "llm",
        prompt: "The note below ends with this week's meal plan, one meal per line. Return the meals as a list of strings, in order, without day names.",
        context: [{ "$ref": "steps.text.body" }],
        output: "string[]"
      },
      {
        id: "add",
        kind: "tool",
        module: "./lists.agency",
        tool: "addListItems",
        args: { listId: { "$ref": "steps.list[0].id" }, items: { "$ref": "steps.meals" }, section: "Meals" }
      }
    ],
    result: { "$ref": "steps.add" }
  }
}

/** The effects every run of a workflow raises on its way to the steps. */
def isPlumbing(effect: string): boolean {
  return effect == "std::read" || effect == "std::workflow::run" || effect == "std::run"
}

node rejectedStepStopsTheWorkflow(): Json {
  let result: Result<Json> = failure("not run")
  handle {
    result = runWorkflow(mealPlan(), { noteTitle: "Groceries" }, TOOLS, DIR)
  } with (intr) {
    if (isPlumbing(intr.effect)) {
      return approve()
    }
    if (intr.effect == "test::lists::add") {
      return reject()
    }
  }
  if (result is success) {
    print("unexpected success: ${JSON.stringify(result.value)}")
    return null
  }
  return [result.error.startsWith("step add (addListItems):"), result.data.step]
}

/** The step's own interrupt is answered by nobody here, so it pauses the
  child and surfaces to the test runner, which approves it. */
node pausedWorkflowResumes(): Json {
  let result: Result<Json> = failure("not run")
  handle {
    result = runWorkflow(mealPlan(), { noteTitle: "Groceries" }, TOOLS, DIR)
  } with (intr) {
    if (isPlumbing(intr.effect)) {
      return approve()
    }
  }
  if (result is failure) {
    print("failed: ${result.error}")
    return null
  }
  return result.value
}

/** The meal plan with `limits` on the LLM step, so the guard holds the typed reply. */
def mealPlanWithGuardedLlm(): Workflow {
  const plan = mealPlan()
  const steps: Json[] = []
  for (step in plan.steps) {
    if (step.id == "meals") {
      steps.push({ ...step, limits: { maxTime: 60000 } })
    } else {
      steps.push(step)
    }
  }
  return { ...plan, steps: steps, limits: { maxTime: 60000 } }
}

/** A guarded LLM step returns its reply from inside the thread, inside the
  guard. The next step gets the list, not the thread's messages. */
node guardedLlmStepRuns(): Json {
  let result: Result<Json> = failure("not run")
  handle {
    result = runWorkflow(mealPlanWithGuardedLlm(), { noteTitle: "Groceries" }, TOOLS, DIR)
  } with approve
  if (result is failure) {
    print("failed: ${result.error}")
    return null
  }
  return result.value
}

/** One step whose tool sleeps two seconds under a 100 ms limit. The guard
  trips, the handler rejects `std::guard`, and the step's check turns the
  guard's failure into the workflow's, naming the step and the cause. */
node stepLimitTrips(): Json {
  const workflow: Workflow = {
    format: 1,
    name: "slowOne",
    description: "Echo text slowly.",
    inputs: "{ text: string }",
    steps: [{ id: "slow", kind: "tool", module: "./slow.agency", tool: "slowEcho", args: { text: { "$ref": "inputs.text" } }, limits: { maxTime: 100 } }],
    limits: { maxTime: 5000 }
  }
  let result: Result<Json> = failure("not run")
  handle {
    result = runWorkflow(workflow, { text: "hi" }, [slowEcho], DIR)
  } with (intr) {
    if (isPlumbing(intr.effect)) {
      return approve()
    }
    if (intr.effect == "std::guard") {
      return reject()
    }
  }
  if (result is success) {
    print("unexpected success: ${JSON.stringify(result.value)}")
    return null
  }
  return [result.data.step, result.data.cause.data.type]
}
