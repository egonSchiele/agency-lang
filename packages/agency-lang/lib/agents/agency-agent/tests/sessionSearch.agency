/*
 * /fork and the search over saved sessions. The search nodes save a real
 * checkpoint of a hand-built conversation into the test's own agent home,
 * then search it from a second session.
 */
import { assistantMessage, sessionThreadId, userMessage } from "std::thread"

import {
  currentSessionId,
  forkSession,
  markTurnDone,
  recordTurn,
  setConversationThread,
  setCurrentRecord,
 } from "../lib/record.agency"
import { newSessionRecord } from "../lib/resume.agency"
import { forkLine } from "../lib/slashCommands/session.agency"
import { SessionRecord, displayTitle, saveSession, sessionLabel } from "../lib/sessions.agency"
import { SessionHit, TimedHit, datedHit, searchSessions } from "../lib/sessionSearch.agency"

static const BRAIN = "test"

// An older session whose conversation is `said` and its reply, saved on
// disk under `id`.
def saveOlderSession(
  id: string,
  title: string,
  lastActive: number,
  said: string,
): boolean {
  thread(session: "talk") {
    userMessage(said)
    assistantMessage("Noted: ${said}")
  }
  const record: SessionRecord = {
    id: id,
    cwd: "/work",
    brain: "test",
    created: 1,
    lastActive: lastActive,
    turns: 1,
    title: title,
    conversationThread: sessionThreadId("talk")
  }
  const saved = saveSession(record, getCheckpoint(checkpoint()))
  return saved is success
}

def search(query: string): SessionHit[] {
  const hits = searchSessions(query) with approve
  return hits catch []
}

def record(title: string, forkedFrom: string | null): SessionRecord {
  const base: SessionRecord = {
    id: "id-1",
    cwd: "/work",
    brain: "test",
    created: 1,
    lastActive: 1000,
    turns: 2,
    title: title
  }
  if (forkedFrom != null) {
    base.forkedFrom = forkedFrom
  }
  return base
}

node aForkIsMarkedInItsTitle(): boolean {
  const forked = displayTitle(record("Fix the parser", "id-0")) == "Fix the parser (fork)"
  const original = displayTitle(record("Fix the parser", null)) == "Fix the parser"
  return forked && original
}

node aForkIsMarkedInThePicker(): boolean {
  const titled = sessionLabel(record("Fix the parser", "id-0"), 1000) == "Fix the parser (fork) · just now · 2 turns"
  const untitled = sessionLabel(record("", "id-0"), 1000) == "id-1 (fork) · just now · 2 turns"
  return titled && untitled
}

// The mark is on the record, so the title a refresh writes keeps it.
node theForkMarkSurvivesANewTitle(): boolean {
  const forked = record("Fix the parser", "id-0")
  forked.title = "Parser error recovery"
  return displayTitle(forked) == "Parser error recovery (fork)"
}

node aHitCarriesADateAndAnAge(): boolean {
  const day = 24 * 60 * 60 * 1000
  const usedAt = 1762300800000
  const timed: TimedHit = {
    sessionId: "s",
    title: "t",
    lastActive: usedAt,
    role: "user",
    snippet: "x"
  }
  const hit = datedHit(timed, usedAt + 3 * day)
  return hit.age == "3d ago" && hit.date.startsWith("2025-11-0")
}

node forkNeedsATurn(): boolean {
  setCurrentRecord(newSessionRecord(BRAIN))
  const before = currentSessionId()
  const forked = forkSession()
  const line = forkLine(forked)
  let fact = false
  if (forked is failure(reason)) {
    fact = reason == "no turns"
  }
  return fact && line.includes("no turns yet") && currentSessionId() == before
}

node forkWritesToANewSession(): boolean {
  setCurrentRecord(newSessionRecord(BRAIN))
  markTurnDone()
  recordTurn("hello")
  const original = currentSessionId()
  const forked = forkSession()
  const line = forkLine(forked)
  const target = recordTurn("")
  const isNew = currentSessionId() != original
  let fact = false
  if (forked is success(ids)) {
    fact = ids.id == currentSessionId() && ids.forkedFrom == original
  }
  const namesTheOriginal = fact && line.includes("--resume ${original}")
  const savedWithoutATurn = target != null && target.record.id == currentSessionId() && target.record.turns == 1
  const remembersItsOrigin = target != null && target.record.forkedFrom == original
  return isNew && namesTheOriginal && savedWithoutATurn && remembersItsOrigin
}

// A fork is saved with no turn behind it. The save still carries the
// conversation's thread id, so the fork's transcript can be read on resume.
node aForkKeepsTheConversationThread(): boolean {
  setCurrentRecord(newSessionRecord(BRAIN))
  setConversationThread("t7")
  markTurnDone()
  recordTurn("hello")
  forkSession()
  const target = recordTurn("")
  return target != null && target.record.conversationThread == "t7"
}

node findsAMessageInAnEarlierSession(): boolean {
  if (!saveOlderSession(
    "older-1",
    "Grep work",
    100,
    "We decided the grep flags are a rule table.",
  )) {
    return false
  }
  setCurrentRecord(newSessionRecord(BRAIN))
  const hits = search("GREP flags")
  if (hits.length != 2) {
    return false
  }
  const hit = hits[1]
  return hit.sessionId == "older-1" && hit.title == "Grep work" && hit.role == "user" && hit.snippet.includes("rule table")
}

node needsEveryWord(): boolean {
  if (!saveOlderSession(
    "older-2",
    "Ledger work",
    100,
    "The kumquat ledger is balanced.",
  )) {
    return false
  }
  setCurrentRecord(newSessionRecord(BRAIN))
  return search("kumquat ledger").length == 2 && search("kumquat banana").length == 0
}

node newestSessionComesFirst(): boolean {
  const savedOld = saveOlderSession("older-3", "Old", 100, "the marmalade plan")
  const savedNew = saveOlderSession("older-4", "New", 200, "the marmalade recipe")
  if (!savedOld || !savedNew) {
    return false
  }
  setCurrentRecord(newSessionRecord(BRAIN))
  const ids = [hit.sessionId for hit in search("marmalade")]
  return ids[0] == "older-4" && ids.includes("older-3")
}

node rejectedSearchReturnsAFailure(): boolean {
  if (!saveOlderSession("older-5", "Any", 100, "something to find")) {
    return false
  }
  setCurrentRecord(newSessionRecord(BRAIN))
  const hits = searchSessions("something") with reject
  return isFailure(hits)
}
