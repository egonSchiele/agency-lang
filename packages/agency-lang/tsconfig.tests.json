{
  // Type-checks the tests. The main tsconfig excludes them so they stay out of
  // dist/, and vitest transpiles without checking types, so nothing else would.
  // The exclude list is the one the main tsconfig used before tests were dropped
  // from the build, so this checks exactly what it used to.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // Own buildinfo file so this check never clobbers the main build's, which
    // the base tsconfig points at ./.agency-build/tsc.tsbuildinfo. Both live in
    // .agency-build/ (gitignored, wiped by `make clean`).
    "tsBuildInfoFile": "./.agency-build/tsc-tests.tsbuildinfo"
  },
  "include": ["lib", "scripts"],
  "exclude": [
    "node_modules",
    "references",
    "tests",
    "*.mts",
    "examples",
    "lib/tui/test",
    "lib/stdlib/__tests__/**",
    "lib/stdlib/**/*.test.ts"
  ]
}
