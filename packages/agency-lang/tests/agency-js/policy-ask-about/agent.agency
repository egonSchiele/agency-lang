import { cliPolicyHandler, askAbout, currentPolicy, parsePolicyFile, flushPolicy } from "std::policy"

// Interrupts another run raised, as they reach this program: as data.
def readInterrupt(root: string): any {
  return {
    type: "interrupt",
    effect: "std::read",
    message: "Read a file",
    data: { dir: "${root}/x", filename: "f" }
  }
}

def deployInterrupt(): any {
  return {
    type: "interrupt",
    effect: "myapp::deploy",
    message: "Deploy?",
    data: { env: "prod" }
  }
}

// A raise that wants a typed value, such as a question.
def questionInterrupt(): any {
  return {
    type: "interrupt",
    effect: "myapp::question",
    message: "Which branch?",
    data: {},
    expectsValue: true
  }
}

def rulesIn(file: string, effect: string): any {
  const onDisk = parsePolicyFile(file)
  if (onDisk is success(saved)) {
    return saved[effect] ?? null
  }
  return "unreadable"
}

def fileContents(file: string): any {
  const onDisk = parsePolicyFile(file)
  if (onDisk is success(saved)) {
    return saved
  }
  return "unreadable"
}

// Asked before `cliPolicyHandler` was called: rejected, and no prompt.
node withoutHandler(args: { root: string, runFile: string }): any {
  const response = askAbout(readInterrupt(args.root), {}, args.runFile)
  return { type: response.type, policy: currentPolicy() }
}

// The rules already in the handler's file count before anything is asked.
node savedRulesFirst(args: { policyFile: string }): any {
  const handler = cliPolicyHandler(file: args.policyFile)
  return currentPolicy()["std::write"]
}

// A handler with no one at the terminal: an undecided interrupt is
// rejected with the non-interactive reason, and no prompt is drawn.
node nonInteractive(args: { policyFile: string, root: string, runFile: string }): any {
  const handler = cliPolicyHandler(file: args.policyFile, interactive: false)
  const response = askAbout(readInterrupt(args.root), {}, args.runFile)
  return { type: response.type, reason: response.value }
}

// A handler started on a layered policy (the file's rules plus a flag's)
// that saves answers only: the program's own "always" answer, given before
// any askAbout, adds only its rule to the file, never the flag's.
node answersOnlyFromTheStart(args: { root: string, runFile: string }): any {
  const layered = {
    "std::ls": [{ action: "approve" }],
    "std::bash": [{ action: "approve" }]
  }
  const handler = cliPolicyHandler(file: args.runFile, policy: layered, answersOnly: true)
  let ownGlob = "rejected"
  handle {
    interrupt std::glob("List files", { dir: "${args.root}/y", pattern: "*" })
    ownGlob = "approved"
  } with handler
  flushPolicy()
  return { ownGlob: ownGlob, file: fileContents(args.runFile) }
}

// An interrupt the run's policy approves is approved with no prompt.
node approvedByPolicy(args: { policyFile: string, root: string, runFile: string }): any {
  const handler = cliPolicyHandler(file: args.policyFile)
  const response = askAbout(readInterrupt(args.root), { "std::read": [{ action: "approve" }] }, args.runFile)
  return response.type
}

// The handler's file approves every read. The run's policy does not, so
// the read is asked about, and the "always" answer goes to the run's file.
// The run's file holds an ls rule. The run's policy is that file plus a
// bash approve (a flag given at resume) and a question reject (copied
// from the saved policy), neither of which belongs in the file.
node main(args: { policyFile: string, root: string, runFile: string }): any {
  const handler = cliPolicyHandler(file: args.policyFile)
  const runPolicy = {
    "std::ls": [{ action: "approve" }],
    "std::bash": [{ action: "approve" }],
    "myapp::question": [{ action: "reject" }]
  }

  // Answered "always approve": the rule is in the policy and on disk
  // before askAbout returns, and only that rule was added on disk.
  const approved = askAbout(readInterrupt(args.root), runPolicy, args.runFile)
  const afterApprove = currentPolicy()
  const runFileAfterApprove = fileContents(args.runFile)

  // The program's own read of the same kind: the rule just saved
  // approves it, so no prompt.
  let ownRead = "rejected"
  handle {
    interrupt std::read("Read another file", { dir: "${args.root}/x", filename: "g" })
    ownRead = "approved"
  } with handler

  // The program's own glob, answered "always approve" at the handler's
  // prompt: the handler is on the run's policy and file now, and it too
  // adds only the new rule to the file.
  let ownGlob = "rejected"
  handle {
    interrupt std::glob("List files", { dir: "${args.root}/x", pattern: "*" })
    ownGlob = "approved"
  } with handler
  flushPolicy()

  // A reject rule decides a raise that wants a value, with no prompt.
  const question = askAbout(questionInterrupt(), currentPolicy(), args.runFile)

  // Answered "reject once", then a message at the follow-up: a reject
  // that carries the message, and no new rule.
  const before = JSON.stringify(currentPolicy())
  const rejected = askAbout(deployInterrupt(), currentPolicy(), args.runFile)
  const after = JSON.stringify(currentPolicy())

  return {
    approved: approved.type,
    policyRule: afterApprove["std::read"],
    policyKeepsBash: afterApprove["std::bash"],
    policyKeepsQuestion: afterApprove["myapp::question"],
    runFileAfterApprove: runFileAfterApprove,
    runFileAtEnd: fileContents(args.runFile),
    handlerFileRead: rulesIn(args.policyFile, "std::read"),
    handlerFileWrite: rulesIn(args.policyFile, "std::write"),
    ownRead: ownRead,
    ownGlob: ownGlob,
    question: question.type,
    rejected: rejected.type,
    rejectReason: rejected.value,
    policyUnchanged: before == after
  }
}
