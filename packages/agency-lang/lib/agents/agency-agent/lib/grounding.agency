/** @module
  @summary The per-run grounding a brain gets: what the agent is, the
  models the run resolved to, date, working directory, and the project
  AGENTS.md. Harness-owned; brains only read it.
*/

import { demoteProvider, getResolvedSlots } from "../shared.agency"
import { Resolved } from "./models.agency"
import { projectContextText } from "./projectContext.agency"

export def sessionFactsText(
  brainName: string,
  slots: Record<string, Resolved>,
  flags: Record<string, any> | null,
): string {
  """
  The identity block: what the agent is, which brain answers turns, and
  the models the run resolved to. Pure — the slots come in as a
  parameter — so tests can call it directly. The same resolved slots
  feed the splash header, so the model names here always match what the
  user saw at startup. Takes only the CLI flags, never the positional
  prompt: this block sits above the user-message boundary, and user
  text serialized into it would be a prompt-injection vector. A
  front-end with no flags passes null, which leaves the block out.
  """
  let modelLines = []
  for (slot in ["main", "reasoning"]) {
    const resolved = slots[slot]
    if (resolved != null && resolved.model != "") {
      modelLines.push(
        "${slot} model: ${resolved.model} (provider: ${demoteProvider(resolved.provider)})",
      )
    }
  }
  if (flags == null) {
    return """
  Your Name: Agency agent
  Brain: ${brainName}
  Models: ${modelLines.join("\n  ")}
  """
  }
  return """
  Your Name: Agency agent
  Brain: ${brainName}
  Models: ${modelLines.join("\n  ")}

  The flags you were started with:
  <flags>
  ${JSON.stringify(flags, null, 2)}
  </flags>
  """
}

// The coordinator is told to answer from the block. The minimal and simple
// brains are not: their prompts are kept as short as they can be.
static const FACTS_RULE = "\nThe `<session_facts>` block says what you are and which models this session runs on. When the user asks your name, model, or provider, answer from it. Never say you cannot know."

def factsRule(brainName: string): string {
  if (brainName == "coordinator") {
    return FACTS_RULE
  }
  return ""
}

// The grounding for this run, built once by runSession. Each turn adds this
// same string to the conversation with ensureSystemMessage, which matches
// by exact text, so a rebuilt block that differs is never added twice.
let _grounding: string = ""

/** Store the grounding for this run. */
export def setGrounding(text: string) {
  _grounding = text
}

/** The grounding stored for this run, or "" before runSession sets it. */
export def grounding(): string {
  return _grounding
}

export def groundingText(brainName: string, flags: Record<string, any> | null): string {
  return """

  <session_facts>
  ${sessionFactsText(brainName, getResolvedSlots(), flags)}
  </session_facts>${factsRule(brainName)}
  ${projectContextText()}"""
}
