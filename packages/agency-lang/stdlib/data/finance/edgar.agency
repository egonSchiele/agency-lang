import { connectorFetch } from "std::data/connector"
import { env } from "std::system"

/** @module
  @summary Find recent SEC filings by ticker or company CIK.
  ## SEC EDGAR — U.S. company filings

  Look up official filings for a U.S.-listed company from the SEC's
  [EDGAR APIs](https://www.sec.gov/search-filings/edgar-application-programming-interfaces).
  Find annual reports (10-K), quarterly reports (10-Q), material-event
  reports (8-K), or other filings by ticker or CIK.

  Returns a list of filings with form type, filing/report dates, and a direct URL to the
  primary document. No API key required, but the SEC requires a descriptive User-Agent with
  contact info; set the `SEC_USER_AGENT` environment variable to override the default.

  ### Usage

  ```ts
  import { edgarFilings } from "std::data/finance/edgar"

  node main() {
    const filings = edgarFilings("AAPL", "10-K", 5) catch []
    for (filing in filings) {
      print("${filing.filingDate}  ${filing.form}  ${filing.url}")
    }
  }
  ```
*/

effect std::edgar { company: string }

/** One SEC filing. `url` links directly to the primary document. */
export type Filing = {
  form: string;
  filingDate: string;
  reportDate: string;
  accessionNumber: string;
  primaryDocument: string;
  description: string;
  url: string
}

const CIK_WIDTH = 10

// SEC requires a descriptive User-Agent with contact info. We read it once at
// module initialization, so later environment changes do not affect this run.
const secUserAgentEnv = env("SEC_USER_AGENT") with approve
const secUserAgent = secUserAgentEnv ?? "agency-lang admin@agency-lang.com"

// Per-host fetch config. The std::edgar interrupt gates the call; each fetch is approved
// at its call site (an outer handler can still reject the std::http::fetchJSON
// interrupt(s)). The ticker map lives on www.sec.gov; submissions on
// data.sec.gov.
const SEC_HEADERS = { "User-Agent": secUserAgent }
const SEC_TICKER_BASE = "https://www.sec.gov/"
const SEC_TICKER_DOMAINS = ["www.sec.gov"]
const SEC_DATA_BASE = "https://data.sec.gov/"
const SEC_DATA_DOMAINS = ["data.sec.gov"]

/* Build the submissions path for a 10-digit CIK. */
def buildSubmissionsPath(cik10: string): string {
  return "submissions/CIK${cik10}.json"
}

/* Build the archive URL for a filing's primary document. */
def buildArchiveUrl(cikNoPad: string, accessionNumber: string, primaryDocument: string): string {
  const accessionNoDashes = accessionNumber.replaceAll("-", "")
  return "https://www.sec.gov/Archives/edgar/data/${cikNoPad}/${accessionNoDashes}/${primaryDocument}"
}

/* Find a ticker in company_tickers.json and return its 10-digit CIK, or "" if absent. */
def parseTickerMap(raw: any, ticker: string): string {
  const rows = Object.values(raw ?? {})
  const want = ticker.toUpperCase()
  const row = find(rows) as r {
    return (r.ticker ?? "").toUpperCase() == want
  }
  if (row == null) {
    return ""
  }
  const cikStr = "${row.cik_str}"
  return cikStr.padStart(CIK_WIDTH, "0")
}

/* Reshape a submissions response into Filing[], optionally filtered by form and capped. */
def parseSubmissions(cik10: string, raw: any, formType: string, limit: number): Filing[] {
  const r: any = raw ?? {}
  const filings: any = r.filings ?? {}
  const recent: any = filings.recent ?? {}
  const forms = recent.form ?? []
  const accessions = recent.accessionNumber ?? []
  const filingDates = recent.filingDate ?? []
  const reportDates = recent.reportDate ?? []
  const primaryDocs = recent.primaryDocument ?? []
  const descriptions = recent.primaryDocDescription ?? []
  // The archive path uses the CIK with leading zeros stripped; Number() does that.
  const cikNoPad = "${Number(cik10)}"
  const rows = map(range(forms.length)) as i {
    return {
      form: forms[i] ?? "",
      filingDate: filingDates[i] ?? "",
      reportDate: reportDates[i] ?? "",
      accessionNumber: accessions[i] ?? "",
      primaryDocument: primaryDocs[i] ?? "",
      description: descriptions[i] ?? "",
      url: buildArchiveUrl(cikNoPad, accessions[i] ?? "", primaryDocs[i] ?? "")
    }
  }
  const filtered = filter(rows) as f {
    return (formType == "") || (f.form == formType)
  }
  if (limit > 0) {
    return filtered.slice(0, limit)
  }
  return filtered
}

/* Finalize a submissions fetch into a Result, shared by both orchestrators. */
def edgarSubmissionsFinalize(cik10: string, formType: string, limit: number, fetchResult: any): Result {
  return match (fetchResult) {
    success(body) => {
      if (((body.filings ?? null) == null)) {
        return failure("EDGAR returned no filings for CIK ${cik10}")
      }
      return success(parseSubmissions(cik10, body, formType, limit))
    }
    failure(err) => failure("EDGAR submissions request failed: ${err}")
  }
}

@capabilities(network)
export def edgarFilingsByCik(cik: string, formType: string = "", limit: number = 20): Result<Filing[]> raises <std::edgar, std::http::fetchJSON> {
  """
  List recent SEC filings for a company by CIK.

  @param cik - The company Central Index Key, with or without leading zeros.
  @param formType - A form such as "10-K" or "8-K", or empty for all forms.
  @param limit - The maximum filings to return, or zero or less for all recent filings.
  """
  const cik10 = cik.padStart(CIK_WIDTH, "0")
  return interrupt std::edgar("Fetch SEC filings for this company?", { company: cik })
  const path = buildSubmissionsPath(cik10)
  // Bind the fetch to its own statement so std::http::fetchJSON fires at statement level.
  const result = connectorFetch(SEC_DATA_BASE, SEC_DATA_DOMAINS, path, headers: SEC_HEADERS) with approve
  return edgarSubmissionsFinalize(cik10, formType, limit, result)
}

/**
  Use `edgarFilingsByCik` when you already know the company CIK to skip
  the ticker-directory request. These functions read the recent-filings
  section of SEC submissions data, rather than the full filing archive.
*/
@capabilities(network)
export def edgarFilings(ticker: string, formType: string = "", limit: number = 20): Result<Filing[]> raises <std::edgar, std::http::fetchJSON> {
  """
  List recent SEC filings for a company by stock ticker. If you already know
  the CIK, prefer edgarFilingsByCik to skip the ticker lookup.

  @param ticker - A stock ticker such as "AAPL", matched without regard to case.
  @param formType - A form such as "10-K" or "8-K", or empty for all forms.
  @param limit - The maximum filings to return, or zero or less for all recent filings.
  """
  return interrupt std::edgar("Fetch SEC filings for this company?", { company: ticker })
  // We bind each fetch to its own statement (never a match scrutinee or call argument) so
  // the std::http::fetchJSON interrupts fire at statement level and resume reliably.
  const tickersResult = connectorFetch(SEC_TICKER_BASE, SEC_TICKER_DOMAINS, "files/company_tickers.json", headers: SEC_HEADERS) with approve
  const tickerMap = tickersResult catch {}
  const cik10 = parseTickerMap(tickerMap, ticker)
  if (cik10 == "") {
    return failure("EDGAR: no company found for ticker '${ticker}' (or the ticker lookup failed)")
  }
  const subResult = connectorFetch(SEC_DATA_BASE, SEC_DATA_DOMAINS, buildSubmissionsPath(cik10), headers: SEC_HEADERS) with approve
  return edgarSubmissionsFinalize(cik10, formType, limit, subResult)
}
