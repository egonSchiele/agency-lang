import { systemMessage } from "std::thread"

/** @module
@summary Rewrite a user prompt before passing it to another agent.

`promptRewriter` returns only the revised prompt from an isolated
conversation. Use it when a request needs a clearer goal or output format.
*/

static const systemPrompt = """
Rewrite the user's prompt so an agent can act on it. State the goal and
deliverable clearly. Supply sensible defaults for missing details and
state them in the rewrite. Specify the output format when the task implies
one. Ask for citations for factual claims, recent sources for time-sensitive
questions, and an explanation when information is unavailable.

Preserve the user's intent, constraints, and wording choices. Do not
invent conflicting facts or preferences. Keep a clear prompt nearly
unchanged. Return only the rewritten prompt, without answering it.
"""

export def promptRewriter(prompt: string): string {
  """
  Rewrite a prompt with a clearer goal and output requirements.
  Return the rewritten prompt without answering it.
  """
  thread {
    systemMessage(systemPrompt)
    const res = llm("Rewrite this prompt: <prompt>${prompt}</prompt>")
    return res
  }
}
