/*
 * The reading specialist, as the coordinator sees it: a router over two
 * stdlib agents. agencyTopic: true goes to agencyResearcherAgent (the bundled
 * Agency docs); false, the default, goes to researcherAgent (web, Wikipedia,
 * URLs). General is the default because a general researcher asked about
 * Agency is merely less expert, while the Agency researcher asked about
 * anything else has only Agency documentation to answer from. This file
 * adds the shared session, the REPL formatting rules, and the memory and
 * todo tools the agent gives its specialists.
 */
import { _insideToolCall } from "agency-lang/stdlib-lib/thread.js"
import { question } from "std::agent"
import { agencyResearcherAgent } from "std::agents/agency/researcher"
import { memoryTools, planningTools } from "std::agents/lib/toolkits"
import { researcherAgent } from "std::agents/researcher"
import { setMemoryId } from "std::memory"
import { endTurn } from "std::thread"

import { announce } from "../lib/announce.agency"
import { timeBudget } from "../lib/budgets.agency"

export static const researchTools: any[] = [...memoryTools(), ...planningTools()]

static const replStyle = """Reply for a terminal REPL that renders Markdown: use headings, bullets, bold, links, and fenced code blocks. Put a blank line between a heading and whatever follows it, or the renderer truncates the rest.

For a question spanning more than two sources, call `todoWrite` first and tick each item off as you finish that source.

Keep replies brief. Cite sources. Show, do not lecture."""

export handoff def researchAgent(
  userMsg: string,
  agencyTopic: boolean = false,
  maxSeconds: number | null = null,
  maxDollars: number | null = null,
): Result<string> {
  """
  Answer a question that needs reading rather than writing: looking something
  up, summarizing a document, gathering background, or recalling a stored
  fact.

  @param userMsg - a message describing what needs to be found out.
  @param agencyTopic - true when the question is about the Agency language
    itself (its syntax, types, stdlib, or CLI), which routes to the agent
    that reads the bundled Agency documentation. Leave it false for every
    other subject, including questions about other languages.
  @param maxSeconds - working-time cap in seconds, when the user gave a
    deadline; null for the default (30 minutes, 10 for an Agency topic).
  @param maxDollars - spend cap in dollars, when the user gave one; null
    for the default ($50, $10 for an Agency topic).
  """
  announce("researchAgent", userMsg)
  setMemoryId("research")
  let answer: Result<string> = failure("no research ran")
  if (agencyTopic) {
    answer = agencyResearcherAgent(
      question: userMsg,
      context: replStyle,
      maxCost: maxDollars ?? $10.00,
      maxTime: timeBudget(maxSeconds, 10m),
      session: "research",
      extraTools: [...researchTools, question],
      keepDraft: false,
    )
  } else {
    answer = researcherAgent(
      task: userMsg,
      context: replStyle,
      maxCost: maxDollars ?? $50.00,
      maxTime: timeBudget(maxSeconds, 30m),
      session: "research",
      extraTools: researchTools,
      keepDraft: false,
    )
  }
  // A finished answer is the user's reply as written. A coordinator
  // follow-up read it as a message to itself and wrote about it ("the
  // report above stands") to a user who never saw it. A run the budget cut
  // short is a failure (keepDraft: false), not a draft passed off as the
  // answer, so it hands back like any failure and the coordinator can say
  // what is unfinished. researchTurn calls this from code, where there is
  // no llm() call to end.
  if (_insideToolCall() && isSuccess(answer)) {
    endTurn()
  }
  return answer
}
