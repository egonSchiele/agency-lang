// Write a caption file beside every image in a folder, from the WD14
// tagger, dropping the tags that describe the style rather than the
// subject. The loop is yours: change the drop list, the threshold, or
// the model, and it is still four calls.
//
//   agency local serve wd14-tagger
//   agency run --approve std::glob --approve std::vision --approve std::write examples/captionFolder.agency
import { STYLE_TAGS } from "../index.agency"
import { tagImage } from "std::vision"
import { glob } from "std::shell"

node main() {
  const images = glob("*.png", "./drawings")
  if (isFailure(images)) {
    print("could not list ./drawings: ${images.error}")
    return
  }
  for (image in images.value) {
    const tags = tagImage(image, "wd14-tagger") catch []
    const kept = filter(tags) as tag {
      return !STYLE_TAGS.includes(tag.tag)
    }
    const names = map(kept) as tag {
      return tag.tag
    }
    const sidecar = image.replace(".png", ".txt")
    write(sidecar, names.join(", "), "./drawings")
    print("${sidecar}: ${names.join(", ")}")
  }
}
