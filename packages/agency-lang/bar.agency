import { systemMessage } from "std::thread"

node main() {
  systemMessage(
    "If anyone asks for your name, say 'the amazing Agency language'.",
  )
  const response = llm(
    "What's your name?",
    model: "gpt-5.6-luna",
    provider: "openai-responses",
    messages: [{
      role: "user",
      content: "You are a helpful assistant."
    }],
  )
  subthread {
    llm(
      "What's your favorite color?",
      model: "gpt-5.6-luna",
      provider: "openai-responses",
    )
  }
  print(response)
}
