/*
 * The oracle, as the coordinator sees it. The agent is std::agents/oracle;
 * this file adds the slow-model slot the user chose, the question tool so
 * it can ask the user, and the dispatch announcement. It is a handoff: it
 * continues the coordinator's conversation. The docstring is written for
 * routing, not for the agent's own behaviour.
 */
import { question } from "std::agent"
import { oracleAgent as stdOracleAgent } from "std::agents/oracle"

import { getSlowModel, getSlowProvider } from "../../../shared.agency"
import { announce } from "../lib/announce.agency"
import { timeBudget } from "../lib/budgets.agency"

export handoff def oracleAgent(
  userMsg: string,
  maxSeconds: number | null = null,
  maxDollars: number | null = null,
): Result<string> {
  """
  Ask the oracle — a read-only senior reviewer — for a second opinion
  before acting on something that would be expensive to get wrong. Call
  this when:

  - You're about to execute a non-trivial plan or diff and a flaw would
    be costly to undo
  - You're stuck on a bug after one or two failed attempts
  - You suspect existing code already solves the problem and a targeted
    look hasn't settled it

  Do NOT consult the oracle for conversational questions, opinions, or
  advice the user asked *you* for — answer those yourself from what you
  know and what you can read directly. A second opinion is worth its cost
  when you're about to act, not when you're about to reply.

  The oracle continues this conversation: it sees everything above, and
  its reading and reasoning stay in your history. Ask the question itself.

  @param userMsg - the question
  @param maxSeconds - working-time cap in seconds, when the user gave a
    deadline; null for the default (15 minutes).
  @param maxDollars - spend cap in dollars, when the user gave one; null
    for the default ($20).
  """
  announce("oracle", userMsg)
  return stdOracleAgent(
    question: userMsg,
    maxCost: maxDollars ?? $20.00,
    maxTime: timeBudget(maxSeconds, 15m),
    model: getSlowModel(),
    provider: getSlowProvider(),
    extraTools: [question],
  )
}
