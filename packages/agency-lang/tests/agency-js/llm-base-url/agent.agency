node main() {
  const first: string = llm("First server", {
    model: "local-text", provider: "openai-compat",
    baseUrl: { openAiCompat: "https://first.example/v1" },
  })
  const second: string = llm("Second server",
    model: "local-text", provider: "openai-compat",
    baseUrl: { openAiCompat: "https://second.example/v1" })
  const spam: boolean = llm("Is this spam?", {
    model: "english", provider: "typesafe",
    baseUrl: { typesafe: "https://decision.example" },
    apiKey: { typesafe: "unused" },
  })
  const fallback: string = llm("Default server", {
    model: "local-text", provider: "openai-compat",
  })
  return { first: first, second: second, spam: spam, fallback: fallback }
}
