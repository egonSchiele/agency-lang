/** @module
  @summary Checks a skills tool built over a folder that ships with the
  agent. A wrong folder path does not make skillsDir fail: it builds a
  tool that lists no skills. So the check looks for one skill the folder
  is known to hold.
*/

/** "" when the tool lists `skillName`; otherwise the problem, for printing. */
export def missingBundledSkill(tool: any, skillName: string): string {
  if (isFailure(tool)) {
    return "could not build the skills tool that should list ${skillName}: ${tool.error}"
  }
  const description = "${tool.description}"
  if (!description.includes("<name>${skillName}</name>")) {
    return "the ${tool.name} tool does not list the ${skillName} skill, so its skills folder path is wrong"
  }
  return ""
}
