import { cliPolicyHandler, setPolicy, Policy, ScopedRuleFields } from "std::policy"

// File contents and code diffs print above the approval prompt, whose
// body would cut them off after a few lines. The preview prints whether
// a rule decided the interrupt or the user was asked, so an auto-approved
// change is still visible.

const FIELDS: ScopedRuleFields = {}
const POLICY = {}
const APPROVE_REVIEW: Policy = { "std::toolbox::review": [{ action: "approve" }] }
const APPROVE_WRITES: Policy = { "std::write": [{ action: "approve" }] }

node main(args: { policyFile: string }): string {
  // Long enough that the prompt's table must wrap it to fit.
  const letter = "a"
  const longDir = "/work/${letter.repeat(200)}"
  setPolicy(args.policyFile, POLICY)
  const handler = cliPolicyHandler(file: args.policyFile, fields: FIELDS)
  handle {
    interrupt std::write("write this file?", {
      dir: "/work",
      filename: "write.js\u001b[2J\u202e",
      mode: "overwrite",
      content: "function writePreview() {\n  const first = 1;\n  const second = 2;\n  const third = 3;\n  const fourth = 4;\n  const fifth = 5;\n  const total = first + second + third + fourth + fifth;\n  return \"write-preview-tail\" + total;\n}\u001b[2J\u202e"
    })
    interrupt std::write("create an empty file?", {
      dir: "/work", filename: "empty.js", mode: "create-only", content: ""
    })
    // AST and formatter writes carry no content in their interrupt.
    interrupt std::write("write an AST?", {
      dir: "/work", filename: "metadata.agency", overwrite: true
    })
    interrupt std::write("write custom content?", {
      dir: "/work", filename: "custom.txt", content: { value: "structured-write-content" }
    })
    interrupt std::edit("apply this edit?", {
      dir: longDir,
      filename: "greet.agency",
      before: "def greet(): string {\n  return \"hi\"\n}",
      after: "def greet(): string {\n  return \"hello\"\n}",
    })
    interrupt std::toolbox::review("review this tool?\u001b[2J\u061c", {
      // A tool name is chosen by the agent and lands in the prompt's own
      // table, which keeps a carriage return: everything after it
      // overwrites the row up to that point.
      name: "greetHindi\r wiped",
      stagingDir: "/tmp/staging",
      // The draft goes through the diff, which keeps an escape sequence
      // (it clears the screen) and a bidi override (it makes the code
      // read as something other than what it runs as).
      source: "def run(): string {\n  return \"namaste\"\u001b[2J\u202e\n}",
      previous: "def run(): string {\n  return \"hello\"\n}",
      effects: ["std::llm"],
      tested: true,
      // What the reviewer and the author said goes under the diff. It is
      // model-written text, so the same escape sequence is stripped.
      notes: ["search results carry no dates\u001b[2J"],
      blocking: ["run ignores the topic"],
      unresolved: [{ point: "asks for a publication time", reason: "no std search returns one" }],
      resumed: true
    })
    // Raised the way designSkill raises it: the answer is assigned, so
    // the prompt takes the path for a raise that expects a value. The
    // skill prints above the prompt; the prompt's table keeps dir and name.
    let answer = interrupt std::skills::review("Review this skill before it is saved", {
      dir: "/home/me/.agency-agent/skills",
      name: "tv-tables",
      description: "Show tables in tv when the user asks\u001b[2J",
      body: "# tv\n\nRun tv agent new yourself. See [the docs](https://example.com/x)."
    })
  } with (data) {
    return handler(data)
  }
  return "completed"
}

// A rule answers this one, so no prompt is drawn. The diff is then the
// only place the user sees what the agent wrote.
node autoApproved(args: { policyFile: string }): string {
  setPolicy(args.policyFile, APPROVE_REVIEW)
  const handler = cliPolicyHandler(file: args.policyFile, fields: FIELDS)
  handle {
    interrupt std::toolbox::review("review this tool?\u001b[2J\u061c", {
      name: "silentTool",
      stagingDir: "/tmp/staging",
      source: "def run(): string {\n  return \"quiet\"\n}",
      previous: "",
      effects: [],
      tested: true,
      notes: [],
      blocking: [],
      unresolved: [],
      resumed: false
    })
  } with (data) {
    return handler(data)
  }
  return "completed"
}

node autoApprovedWrite(args: { policyFile: string }): string {
  setPolicy(args.policyFile, APPROVE_WRITES)
  const handler = cliPolicyHandler(file: args.policyFile, fields: FIELDS)
  handle {
    interrupt std::write("append to this file?", {
      dir: "/work", filename: "append.js", mode: "append",
      content: "console.log(\"auto-write-preview\");"
    })
  } with (data) {
    return handler(data)
  }
  return "completed"
}

// An interrupt with no data at all. Reading a field off it throws, and
// the diff renderer runs in front of the guard that used to catch that.
node nullPayload(args: { policyFile: string }): string {
  setPolicy(args.policyFile, APPROVE_REVIEW)
  const handler = cliPolicyHandler(file: args.policyFile, fields: FIELDS)
  handle {
    interrupt std::toolbox::review("review nothing?", null)
  } with (data) {
    return handler(data)
  }
  return "survived"
}
