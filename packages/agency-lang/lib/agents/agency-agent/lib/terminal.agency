/** @module
  @summary `agency agent`'s interactive terminal on the session core. The
  process has two runs: this one, the shell run, which draws the prompt and
  runs the slash commands, and the session run, a run of the session
  program, which the driver starts, resumes and saves
  (lib/stdlib/agentTerminalDriver.ts). The shell is asked about what no
  rule decides, prints what the driver has to say, and gives the policy in
  force. See docs/dev/agents/session-driver.md, "The terminal".
*/
import {
  _resumeSession,
  _runOnce,
  _savedTranscript,
  _send,
  _startSession,
 } from "agency-lang/stdlib-lib/agentTerminalDriver.js"
import {
  SESSION_POLICIES_DIR,
  readCarriedPolicy,
  saveCarriedPolicy,
  sessionRunPolicy,
 } from "agency-lang/stdlib-lib/agentDriver/index.js"
import { _resolveRunPolicy } from "agency-lang/stdlib-lib/runPolicy.js"
import { _exit } from "agency-lang/stdlib-lib/system.js"
import { Policy, askAbout, currentPolicy, parsePolicyFile } from "std::policy"
import { cwd } from "std::system"
import { pushMessage } from "std::ui/cli"

import { REPL_STYLE } from "./answer.agency"
import { POLICY_DIR, POLICY_PATH } from "./config.agency"
import { limitFlagsFromArgs } from "./toolLimits.agency"
import { getPolicyForAgent } from "./policy.agency"
import { SessionRecord, projectDir } from "./sessions.agency"
import { startupModelFlags } from "./session.agency"
import { renderReply, renderUserLine, showTranscript } from "./transcript.agency"
import { takePendingNotes } from "./pendingNotes.agency"
import { agentNameFor } from "./agentName.agency"

// The file an "always" answer is saved to: policy.json, or the session's
// own policy file when it carries one.
let _policyFile: string = ""

/** Asks the person about an interrupt the session run raised, under the
  policy in force, and saves an "always" answer to the policy file. */
def askForSession(intr: any): any {
  return askAbout(intr, currentPolicy(), _policyFile)
}

def policyForSession(): Policy {
  return currentPolicy()
}

/** Prints a line the driver has for the person. */
def showForSession(kind: string, text: string) {
  if (kind == "reply") {
    renderReply(text)
  } else if (kind == "error") {
    pushMessage(color.red(text))
  } else if (kind == "warning") {
    pushMessage(color.yellow(text))
  } else {
    pushMessage(color.dim(text))
  }
}

/** The session was forked: a session policy file "always" answers go to
  moves to the new id, as the driver copied it there. */
def forkedForSession(from: string, to: string) {
  if (_policyFile == carriedPolicyPath(from)) {
    _policyFile = carriedPolicyPath(to)
  }
}

def shellFunctions(): any {
  return {
    ask: askForSession,
    policy: policyForSession,
    show: showForSession,
    forked: forkedForSession
  }
}

/** The policy the session runs under, and where "always" answers go. */
export type SessionPolicy = {
  policy: Policy;
  file: string
}

def anyPolicyFlag(flags: any): boolean {
  return (flags.policy ?? "") != "" || (flags.approve ?? "") != "" || (flags.reject ?? "") != ""
}

def carriedPolicyPath(id: string): string {
  return path.join(POLICY_DIR, SESSION_POLICIES_DIR, "${id}.json")
}

/** A new session's policy. With policy flags, the policy they resolve to
  becomes the session's own, saved in its policy file, so it follows the
  session to any front-end that resumes it, and "always" answers go there
  too. With none, the saved policy, and answers go to policy.json. */
export def newSessionPolicy(id: string, flags: any): SessionPolicy {
  const resolved = getPolicyForAgent(flags.policy ?? "", flags.approve ?? "", flags.reject ?? "", true)
  const policy = resolved.startPolicy ?? {}
  if (!anyPolicyFlag(flags)) {
    return { policy: policy, file: resolved.policyFile }
  }
  const saved = saveCarriedPolicy({ home: POLICY_DIR, id: id, policy: policy })
  if (saved is failure(reason)) {
    print(color.yellow("This session's policy could not be saved with it: ${reason}"))
    return { policy: policy, file: resolved.policyFile }
  }
  return { policy: policy, file: carriedPolicyPath(id) }
}

/** The saved policy, policy.json, or none when it can't be read. */
def savedPolicy(): Policy {
  const parsed = parsePolicyFile(POLICY_PATH)
  if (parsed is success(policy)) {
    return policy
  }
  return {}
}

/** A resumed session's policy. One that carries its own runs under it, in
  place of the saved policy, keeping the saved policy's rejects and laying
  the flags given now on top. One that carries none runs as a new session
  without its own would. */
export def resumedSessionPolicy(id: string, flags: any): SessionPolicy {
  const carried = readCarriedPolicy({ home: POLICY_DIR, id: id })
  if (carried is failure(reason)) {
    print(color.red(reason))
    _exit(1)
  }
  if (carried.value == null) {
    const resolved = getPolicyForAgent(flags.policy ?? "", flags.approve ?? "", flags.reject ?? "", true)
    return { policy: resolved.startPolicy ?? {}, file: resolved.policyFile }
  }
  let extra: Policy | null = null
  if (anyPolicyFlag(flags)) {
    const fromFlags = _resolveRunPolicy({
      policy: flags.policy ?? "",
      approve: flags.approve ?? "",
      reject: flags.reject ?? ""
    }, cwd())
    if (fromFlags is failure(reason)) {
      print(color.red(reason))
      _exit(1)
    }
    extra = fromFlags.value
  }
  const run = sessionRunPolicy({ carried: carried, saved: savedPolicy(), extra: extra })
  if (run is failure(reason)) {
    print(color.red(reason))
    _exit(1)
  }
  return { policy: run.value, file: carriedPolicyPath(id) }
}

/** Where "always" answers go from now on. Set before the session starts. */
export def setSessionPolicyFile(file: string) {
  _policyFile = file
}

/** True when the session's approvals come from the saved policy file,
  policy.json, and false when it runs on a policy of its own or on
  --policy, --approve or --reject, none of which is written back to it. */
export def usesSavedPolicy(): boolean {
  return _policyFile == POLICY_PATH
}

/** What the session program starts with, from the command line. A
  one-shot run (`-p`) has no record, no reply style, and no one at the
  terminal. */
export def programStartFor(
  args: any,
  brainName: string,
  record: SessionRecord | null,
  oneShot: boolean = false,
): any {
  const replyStyle = if oneShot then "" else REPL_STYLE
  return {
    brain: brainName,
    preset: args.flags.preset ?? "",
    models: startupModelFlags(args),
    limits: limitFlagsFromArgs(args),
    session: {
      cwd: cwd(),
      replyStyle: replyStyle,
      record: record,
      flags: args.flags,
      budget: { maxCost: -1, maxTime: -1 }
    },
    agentName: agentNameFor(brainName),
    oneShot: oneShot,
    saveSearchChoice: true,
    trace: {
      debug: args.flags.debug ?? false,
      verbose: args.flags.verbose ?? false,
      interactive: !oneShot
    }
  }
}

/** `agency agent -p`: one message to a session that saves nothing. What
  no rule decides is declined, with the reason the policy handler gives a
  run with no one to ask, so the shell's handler must be non-interactive.
  Returns the reply, or the error when there is none. */
export def runOneShot(args: any, brainName: string, prompt: string, target: string): string {
  const outcome = _runOnce(
    programStartFor(args, brainName, null, true),
    { kind: "message", text: prompt, notes: [], target: target },
    { ask: askForSession, policy: policyForSession },
  )
  if (outcome.reply != "") {
    return outcome.reply
  }
  return outcome.error
}

/** Starts the session run. Exits with the reason when it can't start. */
export def startSessionRun(start: any) {
  const problem = _startSession(start, projectDir(), POLICY_DIR, shellFunctions())
  if (problem != "") {
    print(color.red(problem))
    _exit(1)
  }
}

/** Shows the saved conversation and goes on with the session. Exits with
  the reason when it can't. */
export def resumeSessionRun(record: SessionRecord) {
  print(color.dim("Resuming: ${record.title}"))
  showTranscript(_savedTranscript(projectDir(), record.id))
  const problem = _resumeSession(projectDir(), POLICY_DIR, record.id, shellFunctions())
  if (problem != "") {
    print(color.red(problem))
    _exit(1)
  }
}

/** Sends a message to the session, with the notes the person made since
  the last one. `target` is a start target such as "code", or "". */
export def sendMessage(text: string, target: string = "") {
  _send({
    kind: "message",
    text: text,
    notes: takePendingNotes(),
    target: target
  })
}

/** The `-i` prompt from the command line, as the first turn. */
export def sendSeedMessage(text: string, target: string) {
  renderUserLine(text)
  sendMessage(text, target)
}
