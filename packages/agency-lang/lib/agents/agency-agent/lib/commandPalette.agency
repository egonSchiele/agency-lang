import { SkillCommand, commandsDir } from "std::skills"
import { cwd } from "std::system"

import { claudeSkillCommands } from "./claudeSkills.agency"

export static const projectCommands = commandsDir("${cwd()}/.claude/commands") with approve

/** Every `/name` command a turn can expand, in precedence order: the
  user's Claude Code skills, then the project's `.claude/commands` files. */
export def slashCommands(): SkillCommand[] {
  return [...claudeSkillCommands(), ...projectCommands]
}

export def builtinPalette(): Record<string, string> {
  return {
    "/exit": "Exit the agent",
    "/clear": "Clear the screen",
    "/clear-history": "Clear the input history (recall + saved file)",
    "/cost": "Show cumulative LLM cost and tokens",
    "/rename": "Give this session a title: /rename <title>",
    "/model": "Switch the model (bare to pick, or slot=model)",
    "/models": "List / filter the hosted model catalog",
    "/local": "Switch to a local model",
    "/preset": "Switch to a saved preset (bare to list them)",
    "/policy": "Add the rules of the built-in recommended policy that your policy file lacks",
    "/search": "Choose the web search backend (hosted / Tavily / Brave / off)",
    "/settings": "View and change capability settings for the current model",
    "/mcp": "List configured MCP servers and their tools",
    "/paste": "Multi-line paste mode (Ctrl+D submits, Ctrl+C cancels)",
    "/help": "Show available slash commands"
  }
}

// The first command with a name wins, as in `expandSlash`, and the
// built-ins are laid over the result so a skill or file named `clear`
// can't shadow the built-in `/clear`.
export def paletteFrom(commands: SkillCommand[]): Record<string, string> {
  let out: Record<string, string> = {}
  for (cmd in commands) {
    const key = "/${cmd.name}"
    if (out[key] != null) {
      continue
    }
    let label = cmd.description
    if (cmd.argHint != "") {
      label = "${cmd.description} ${cmd.argHint}"
    }
    out[key] = label
  }
  const builtins = builtinPalette()
  for (key in builtins) {
    out[key] = builtins[key]
  }
  return out
}

export def mergedPalette(): Record<string, string> {
  return paletteFrom(slashCommands())
}
