import { systemMessage } from "std::thread"

node main() {
  let story = ""
  let response = llm(
    "Write the first line of a story about a talking cat."
  )
  story += response
  for (i in range(20)) {
    print(i)
    response = llm(
      "Write the next line of the story about the talking cat."
    )
    story += response
  }
  print(story)
  return story
}
