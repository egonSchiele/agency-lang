// A turn routed by a decision model, through the coordinator brain, under a
// scripted model. The router slot is set by hand: these tests are about
// the turn, and tests/modelRequest.agency covers how the slot is set.
import { getThread, image, listThreads } from "std::thread"

import { setMessageRewritten } from "../../../lib/rewrittenMessage.agency"
import { applyResolved, getResolvedSlots } from "../../../shared.agency"
import { coordinatorBrain } from "../coordinator.agency"

static const PNG = "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+M8AAAMBAQDJ/pLvAAAAAElFTkSuQmCC"
static const ROUTER_QUESTION = "Which agent should handle the user's latest message?"
static const RESEARCHER_PERSONA = "You are a research analyst."

// Every model request, in order: its messages.
let requests: any[] = []

callback("onLLMCallStart") as data {
  requests = [...requests, data.messages]
}

def lastMessage(messages: any[]): any {
  return messages[messages.length - 1]
}

def isRouterRequest(messages: any[]): boolean {
  return startsWithText(lastMessage(messages), ROUTER_QUESTION)
}

def routerRequests(): number {
  return ([messages for messages in requests if isRouterRequest(messages)]).length
}

def contentOf(message: any): string {
  return "${message.content}"
}

def startsWithText(message: any, prefix: string): boolean {
  const content = contentOf(message)
  return content.startsWith(prefix)
}

def includesText(message: any, text: string): boolean {
  const content = contentOf(message)
  return content.includes(text)
}

// How many messages in the request start with the text.
def countStarting(messages: any[], prefix: string): number {
  return ([message for message in messages if startsWithText(message, prefix)]).length
}

// How many messages in the request hold the text.
def countIncluding(messages: any[], text: string): number {
  return ([message for message in messages if includesText(message, text)]).length
}

def setRouter() {
  applyResolved(
    {
      ...getResolvedSlots(),
      router: {
        model: "jev-1.14",
        provider: "openrouter",
        via: "test"
      }
    },
  )
}

// The main thread's messages, found by its label. listThreads with
// lazySummarize: false does not ask a model to summarize closed threads.
def mainThread(): any[] {
  const threads = listThreads(lazySummarize: false) catch []
  for (info in threads) {
    if (info.label == "main") {
      return getThread(info.id, 0, 1000) catch []
    }
  }
  return []
}

// Each turn sends what the harness sends the main target:
// [message, ...attachments] (dispatchToBrain in lib/turn.agency).
// Bound to locals: `brain.init(...) with approve` miscompiles (compiler bug).
def startBrain(): any {
  const brain = coordinatorBrain()
  const init = brain.init
  init({
    interactive: false,
    grounding: ""
  }) with approve
  return brain.runTurn
}

node slotUnsetAsksNoRouter(): string {
  const turn = startBrain()
  const reply = turn("", ["find the release date of node 24"]) with approve
  return "${reply}|${routerRequests()}"
}

// The researcher runs with the user's message as its task, and the
// coordinator model is never asked: the only other request is the
// researcher's, with its persona.
node confidentResearchGoesToTheResearcher(): string {
  const turn = startBrain()
  setRouter()
  const reply = turn("", ["find the release date of node 24"]) with approve
  const second = requests[1]
  const isResearcher = countStarting(second, RESEARCHER_PERSONA) == 1
  const taskIsTheMessage = includesText(lastMessage(second), "find the release date of node 24")
  return "${reply}|${requests.length}|${isResearcher}|${taskIsTheMessage}"
}

// The coder runs on the main thread, not a `code` thread of its own, so
// its reply is the main thread's last message.
node confidentCodeGoesToTheCoder(): string {
  const turn = startBrain()
  setRouter()
  const reply = turn("", ["add a --verbose flag to the build script"]) with approve
  const taskIsTheMessage = includesText(
    lastMessage(requests[1]),
    "add a --verbose flag to the build script",
  )
  const onMain = contentOf(lastMessage(mainThread())) == reply
  return "${reply}|${requests.length}|${taskIsTheMessage}|${onMain}"
}

node coordinatorRouteRunsTheCoordinator(): string {
  const turn = startBrain()
  setRouter()
  const reply = turn("", ["hello there"]) with approve
  return "${reply}|${requests.length}|${routerRequests()}|${isRouterRequest(requests[1])}"
}

node anAttachmentIsNotRouted(): string {
  const turn = startBrain()
  setRouter()
  const reply = turn("", ["look at this", image(PNG, "image/png", base64: true)]) with approve
  return "${reply}|${routerRequests()}"
}

node aLongMessageIsNotRouted(): string {
  const turn = startBrain()
  setRouter()
  let long = ""
  for (i in range(0, 900)) {
    long = "${long}0123456789"
  }
  const reply = turn("", [long]) with approve
  return "${reply}|${routerRequests()}"
}

// A message the harness rewrote (a slash command, or a project block after
// the coder changed folders) is not what the router was measured on.
node aRewrittenMessageIsNotRouted(): string {
  const turn = startBrain()
  setRouter()
  setMessageRewritten(true)
  const reply = turn("", ["find the release date of node 24"]) with approve
  return "${reply}|${routerRequests()}"
}

// The coordinator's other tools are on its line; the routed subagents are
// not, being options of their own.
node theQuestionNamesTheCoordinatorsTools(): string {
  const turn = startBrain()
  setRouter()
  const reply = turn("", ["hello there"]) with approve
  const question = contentOf(lastMessage(requests[0]))
  const toolsLine = question.substring(question.indexOf("Its other tools:"))
  return "${toolsLine.includes("oracleAgent")}|${toolsLine.includes("researchAgent")}|${toolsLine.includes("codeAgent,")}"
}

// The next turn goes to the coordinator, whose request holds the routed
// turn's prompt and reply and no researcher persona.
node theNextTurnSeesTheRoutedTurn(): string {
  const turn = startBrain()
  setRouter()
  const first = turn("", ["find the release date of node 24"]) with approve
  const second = turn("", ["and the one before it?"]) with approve
  const coordinator = requests[requests.length - 1]
  const sawPrompt = countIncluding(coordinator, "find the release date of node 24") > 0
  const sawReply = ([message for message in coordinator if message.content == first]).length
  return "${second}|${sawPrompt}|${sawReply}|${countStarting(coordinator, RESEARCHER_PERSONA)}"
}

// The researcher pauses on a read approval. The test answers it through the
// checkpoint, so mainAgent runs again from its saved frame; the router is
// still asked once. Asked again, it would take the next mock, a text
// mock, and fail.
node aResumedTurnDoesNotAskAgain(): string {
  const turn = startBrain()
  setRouter()
  const reply = turn("", ["summarize the notes file"])
  return "${reply}|${routerRequests()}"
}
