{
  "verbose": false,
  "observability": true,
  "log": {
    "projectId": "agency-lang",
    "debugMode": false,
    "logFile": "log.jsonl"
  },
  "client": {
    "logLevel": "warn",
    "defaultModel": "claude-sonnet-4-6",
    "defaultProvider": "anthropic"
  },
  "typechecker": {
    "enabled": true
  },
  "doc": {
    "outDir": "docs/site/stdlib",
    "baseUrl": "https://github.com/egonSchiele/agency-lang/tree/main/packages/agency-lang/stdlib"
  },
  "coverage": {
    "exclude": [
      "tests/agency/topsort/cycles/**",
      "tests/agency/expectedCompileError/**"
    ]
  }
}