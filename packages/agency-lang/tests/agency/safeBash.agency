    outcomeOf(planFor("cat -n one.txt", FIXTURES)),
    outcomeOf(planFor("head -3 one.txt", FIXTURES)),
    outcomeOf(planFor("tail -n 2 one.txt", FIXTURES)),
    outcomeOf(planFor("cat -b one.txt", FIXTURES)),
    outcomeOf(planFor("head -c 5 one.txt", FIXTURES)),
    outcomeOf(planFor("head -n 0 one.txt", FIXTURES)),
    outcomeOf(planFor("cat one.txt two.txt", FIXTURES)),
    outcomeOf(planFor("cat one.txt > copy.txt", FIXTURES)),
    outcomeOf(planFor("cat one.txt | head", FIXTURES)),
    outcomeOf(planFor("wc -l one.txt", FIXTURES)),
    outcomeOf(planFor("cat nope.txt", FIXTURES)),
    outcomeOf(planFor("head -n 1 -n 2 one.txt", FIXTURES)),
    outcomeOf(planFor("head -2 -n 1 one.txt", FIXTURES)),
    outcomeOf(planFor("tail -n 1 -n 2 one.txt", FIXTURES)),
    outcomeOf(planFor("head one.txt two.txt", FIXTURES)),
    outcomeOf(planFor("cat -n one.txt two.txt", FIXTURES)),
  ]
}

/** Files whose line endings test the shell-free rendering, kept apart
 * from FIXTURES so no grep parity row's output changes. */
static const READ_FIXTURES = __dirname + "/stdlib/read-fixtures"

def exactParityOf(source: string, kind: string, cwd: string): any {
  // Without this check, a row whose command fell back to the bash path
  // would compare the real program with itself and pass for no reason.
  if (planFor(source, cwd).execution.kind != kind) {
    return "NOT SHELL-FREE: ${source}"
  }
  let ours = ""
  let theirs = ""
  let failed = ""
  handle {
    const shellFree = safeBash(source, cwd: cwd)
    if (shellFree is success(out)) {
      ours = out
    } else if (shellFree is failure(why)) {
      failed = "${why}"
    }
    // bash returns an ExecResult, not a Result.
    const real = bash(source, cwd: cwd)
    theirs = real.stdout
  } with approve
  // A failure is reported, not compared: a failed run and a program that
  // printed nothing would otherwise both be "".
  if (failed != "") {
    return "FAILED: ${failed}"
  }
  // These commands print in order, so the comparison is exact.
  if (ours == theirs) {
    return true
  }
  return [source, ours, theirs]
}

node shellFreeReadMatchesRealTools() {
  return [
    exactParityOf("cat one.txt", "read", READ_FIXTURES),
    exactParityOf("cat -n one.txt", "read", READ_FIXTURES),
    exactParityOf("head -1 one.txt", "read", READ_FIXTURES),
    exactParityOf("head -n 1 one.txt", "read", READ_FIXTURES),
    exactParityOf("head -n 100 one.txt", "read", READ_FIXTURES),
    exactParityOf("tail -1 one.txt", "read", READ_FIXTURES),
    exactParityOf("tail -n 100 one.txt", "read", READ_FIXTURES),
    exactParityOf("cat noeol.txt", "read", READ_FIXTURES),
    exactParityOf("cat -n noeol.txt", "read", READ_FIXTURES),
    exactParityOf("tail -1 noeol.txt", "read", READ_FIXTURES),
    exactParityOf("cat empty.txt", "read", READ_FIXTURES),
    exactParityOf("cat -n empty.txt", "read", READ_FIXTURES),
    exactParityOf("cat crlf.txt", "read", READ_FIXTURES),
    exactParityOf("tail -1 crlf.txt", "read", READ_FIXTURES),
    exactParityOf("cat one.txt noeol.txt", "read", READ_FIXTURES),
    exactParityOf("cat noeol.txt one.txt", "read", READ_FIXTURES),
    exactParityOf("cat empty.txt one.txt", "read", READ_FIXTURES),
    exactParityOf("cat one.txt one.txt", "read", READ_FIXTURES),
  ]
}

node catOfTwoFilesAsksTwoQuestions() {
  // Two std::read approvals, one per file, and no shell. The plan's kind
  // comes first, because the bash path asks the same two questions and
  // prints the same text; only the kind tells the two apart.
  const kind = planFor("cat one.txt two.txt", FIXTURES).execution.kind
  const result = safeBash("cat one.txt two.txt", cwd: FIXTURES)
  if (result is failure(why)) {
    return "FAILED: ${why}"
  }
  return [kind, result.value]
}

node loneReadAsksOneQuestion() {
  // One std::read approval, and no shell: a std::bash prompt would fail
  // the run, because the test file answers only the read message.
  const result = safeBash("head -1 one.txt", cwd: FIXTURES)
  if (result is failure(why)) {
    return "FAILED: ${why}"
  }
  return result.value
}

/** A folder of its own for the tests that write through bash. */
static const SHELL_FIXTURE = __dirname + "/stdlib/__safebash_shell__"

node ampersandRedirectWritesTheFile() {
  // `&>` is a redirect of both streams in bash. Under dash it would be
  // `echo hi &` and then `> out.txt`, which empties the file and prints to
  // stdout. The test file approves the std::bash question.
  remove(SHELL_FIXTURE) with approve
  mkdir(SHELL_FIXTURE) with approve
  const ran = safeBash("echo hi &> out.txt", cwd: SHELL_FIXTURE)
  const written = read("out.txt", SHELL_FIXTURE) with approve
  remove(SHELL_FIXTURE) with approve
  return match(ran) {
    success(out) => [out, written]
    failure(why) => "FAILED: ${why}"
  }
}

node echoIsTheSameAloneAndInAChain() {
  // bash's echo does not read backslash escapes, alone or in a chain. The
  // lone echo asks nothing; the chain asks std::bash, which is the one
  // question the test file approves. The trailing `true` has no rule, so
  // the chain stays on the bash path even when chains of echoes run in
  // process; without it this node would compare the in-process echo with
  // itself.
  const alone = safeBash("echo 'a\\tb'")
  const chain = safeBash("echo 'a\\tb'; echo x; true")
  return [alone, chain]
}

node bashOnlyFormsStayUnparseable() {
  // The parser accepts what bash 3.2 accepts, because macOS ships that
  // version. `|&` and `&>>` are bash 4 forms; 3.2 rejects both with a
  // syntax error, so a parser that accepted them would make a narrow plan
  // fail there. Pinned so a tarsec release cannot widen this unnoticed.
  return [grepNames("make |& tail"), grepNames("echo hi &>> log")]
}

node shellFreeEchoMatchesBash() {
  return [
    exactParityOf("echo hi", "echo", FIXTURES),
    exactParityOf("echo -n hi", "echo", FIXTURES),
    exactParityOf("echo -n", "echo", FIXTURES),
    exactParityOf("echo -nn a b", "echo", FIXTURES),
    exactParityOf("echo 'a\\tb'", "echo", FIXTURES),
  ]
}

def chainSummary(source: string): any {
  const plan = planFor(source, FIXTURES)
  return [outcomeOf(plan), plan.execution.kind, [e.name for e in plan.effects]]
}

node chainsOfInProcessCommands() {
  return [
    chainSummary("echo a; echo b"),
    chainSummary("echo \"=== one ===\"; cat one.txt; echo; echo \"=== two ===\"; cat two.txt"),
    chainSummary("cat one.txt && cat two.txt"),
    chainSummary("grep hello one.txt || echo none"),
    chainSummary("echo a && echo b || echo c"),
    chainSummary("echo a; git status"),
    chainSummary("echo a; true"),
    chainSummary("echo a && (echo b || echo c)"),
    chainSummary("echo a; cat one.txt | head"),
    chainSummary("cat nope.txt; echo hi"),
    chainSummary("echo hi > out.txt; cat out.txt"),
    chainSummary("cat one.txt && rm one.txt"),
    chainSummary("echo a; agency --version"),
  ]
}

node chainMatchesBash() {
  // Every grep here names one file, so no skipped-folders note appears
  // and the comparison can be exact.
  return [
    exactParityOf("echo \"=== one ===\"; cat one.txt; echo; echo \"=== two ===\"; cat two.txt", "chain", FIXTURES),
    exactParityOf("cat one.txt && echo finished", "chain", FIXTURES),
    exactParityOf("grep hello one.txt || echo none", "chain", FIXTURES),
    exactParityOf("grep zzz one.txt || echo none", "chain", FIXTURES),
    exactParityOf("echo a && echo b || echo c", "chain", FIXTURES),
    exactParityOf("cat -n one.txt; cat -n two.txt", "chain", FIXTURES),
  ]
}

/** A folder of its own for the chain test that really writes. */
static const CHAIN_FIXTURE = __dirname + "/stdlib/__safebash_chain__"

def destructiveFlag(result: Result<string>): any {
  if (result is failure) {
    return result.destructiveRan
  }
  return "UNEXPECTEDLY SUCCEEDED"
}

node chainFailureAfterAWriteIsDestructive() {
  remove(CHAIN_FIXTURE) with approve
  mkdir(CHAIN_FIXTURE) with approve
  bash("cp " + FIXTURES + "/one.txt .", cwd: CHAIN_FIXTURE) with approve
  // The write ran, then the grep found nothing. The failure must say a
  // destructive step ran, or the tool loop may retry and write twice.
  const after = safeBash("echo hi > out.txt; grep zzz one.txt", cwd: CHAIN_FIXTURE)
  // Here the grep fails first and && skips the write, so nothing ran.
  const before = safeBash("grep zzz one.txt && echo hi > out.txt", cwd: CHAIN_FIXTURE)
  remove(CHAIN_FIXTURE) with approve
  return [destructiveFlag(after), destructiveFlag(before)]
}

node chainFailsLikeBash() {
  // grep with no match exits 1, so && skips the echo and the chain fails;
  // || runs it and the chain succeeds. Approved by the test file.
  const skipped = safeBash("grep zzz one.txt && echo yes", cwd: FIXTURES)
  const ran = safeBash("grep zzz one.txt || echo no", cwd: FIXTURES)
  return [skipped is failure, ran]
}

node chainOfReadsAsksOnlyTheReads() {
  // The two cats ask std::read each; the echoes ask nothing, and no
  // shell runs.
  const result = safeBash("echo \"=== one ===\"; cat one.txt; echo; echo \"=== two ===\"; cat two.txt", cwd: FIXTURES)
  if (result is failure(why)) {
    return "FAILED: ${why}"
  }
  return result.value
}

