import { searchTools, searchProviderNames, setSearchMode, SearchMode } from "std::agents/lib/search"

def selected(mode: SearchMode) {
  setSearchMode(mode)
  return { tools: searchTools(), providerNames: searchProviderNames() }
}

node selectedSearch() {
  return selected("auto")
}

node selectedSearchTavilyMode() {
  return selected("tavily")
}

node selectedSearchBraveMode() {
  return selected("brave")
}

node selectedSearchOffMode() {
  return selected("off")
}
