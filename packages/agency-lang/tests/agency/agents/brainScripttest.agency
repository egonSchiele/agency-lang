// The scripttest brain from std::agents/brains/scripttest, and its
// agencyScript subagent. Every case uses a scripted model; the agencyScript
// cases run the program it returns in a separate process.
import { agencyScript, scripttestBrain } from "std::agents/brains/scripttest"
import { AgentSettings } from "std::agents/brains/settings"

// Every model request, in order.
let calls: any[] = []

callback("onLLMCallStart") as data {
  calls = [...calls, data]
}

def emptySettings(): AgentSettings {
  return {
    context: "",
    model: "",
    provider: "",
    reasoningModel: "",
    reasoningProvider: "",
    routerModel: "",
    routerProvider: "",
    coderTools: []
  }
}

def requestHasSystemText(call: any, text: string): boolean {
  for (message in call.messages) {
    const content = "${message.content}"
    if (message.role == "system" && content.includes(text)) {
      return true
    }
  }
  return false
}

// The minimal brain's four tools, then agencyScript, then the caller's.
node offersTheFourToolsThenAgencyScript(): string[] {
  scripttestBrain(["say hi"], emptySettings(), [requestHasSystemText])
  return [tool.name for tool in calls[0].tools]
}

// The model is told to use agencyScript and keeps the minimal brain's
// coding rules. The writer's tutorial is not on this thread.
node tellsTheModelToUseAgencyScript(): string {
  scripttestBrain(["say hi"], emptySettings(), [])
  const rule = requestHasSystemText(calls[0], "call agencyScript")
  const tutorial = requestHasSystemText(calls[0], "<agency_tutorial>")
  const codingRules = requestHasSystemText(calls[0], "You are a coding assistant")
  return "${rule}|${tutorial}|${codingRules}"
}

// The writer's program runs, and its main node's value comes back.
node runsTheWritersProgram(): any {
  handle {
    const result = agencyScript("return three")
    if (result is success(value)) {
      return value
    }
    return "${result.error}"
  } with approve
}

// When the writer gives up, the failure comes back and nothing runs: the
// handler would reject std::run with a different message.
node writerFailureRunsNothing(): boolean {
  handle {
    const result = agencyScript("return three")
    if (result is failure(err)) {
      return err.startsWith("The Agency writer could not write the program")
    }
    return false
  } with (intr) {
    return reject("std::run was raised")
  }
}

// Every effect the program raises reaches this program's handler: first
// std::run to start it, then the program's own file read.
node theProgramsReadAsksThisHandler(): string {
  let seen: string[] = []
  handle {
    agencyScript("read package.json")
  } with (intr) {
    seen = [...seen, intr.effect]
    if (intr.effect == "std::run") {
      return approve()
    }
    return reject()
  }
  return seen.join(",")
}
