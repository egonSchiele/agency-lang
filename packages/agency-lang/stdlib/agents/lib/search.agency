/** @module
  @summary Selects one web-search provider from the configured API keys.

  Agents receive one client-side search tool: Brave when BRAVE_API_KEY is
  set, otherwise Tavily when TAVILY_API_KEY is set. With neither key set,
  they receive no client-side search tool. The catalog order sets the
  preference for all agents that use this helper.
*/
import { _hostedSearchTools } from "agency-lang/stdlib-lib/llm.js"
import { env } from "std::system"
import { search as braveSearch, tavilySearch } from "std::web/search"

type SearchProvider = {
  name: string;
  envKey: string;
  toolName: string;
  tool: any
}

static const providers: SearchProvider[] = [
  {
    name: "Brave",
    envKey: "BRAVE_API_KEY",
    toolName: "web_search_brave",
    tool: braveSearch
  },
  {
    name: "Tavily",
    envKey: "TAVILY_API_KEY",
    toolName: "web_search_tavily",
    tool: tavilySearch
  },
]

def hasKey(provider: SearchProvider): boolean {
  const key = env(provider.envKey) with approve
  return key != null && key != ""
}

def selectedProviders(): SearchProvider[] {
  const provider = find(providers, hasKey)
  if (provider == null) {
    return []
  }
  return [provider]
}

def boundTool(provider: SearchProvider): any {
  // The key is bound here rather than left to the tool's own env fallback,
  // which only applies when `apiKey` arrives empty. Handing the model an
  // `apiKey` slot means it fills one: a real run had it send
  // `"</antml_parameter>\n<parameter name=..."` as the key, which reached
  // the HTTP layer and failed the search outright. A bound argument is not
  // in the schema at all, so there is nothing to fill.
  const key = env(provider.envKey) with approve
  return provider.tool.partial(apiKey: key).rename(provider.toolName)
}

export def searchTools(): any[] {
  """
  Return one web-search tool, preferring BRAVE_API_KEY over TAVILY_API_KEY.
  Return an empty array when neither key is set.
  """
  return map(selectedProviders(), boundTool)
}

export def searchProviderName(toolName: string): string | null {
  """
  Return a search tool's provider name from the catalog, or null for an
  unknown tool. This lookup does not read API keys or contact a provider.

  @param toolName - The name assigned to the search tool
  """
  const provider = find(providers, \provider -> provider.toolName == toolName)
  if (provider == null) {
    return null
  }
  return provider.name
}

export def hostedSearchTools(model: string = "", provider: string = ""): string[] {
  """
  Return the provider-hosted search capabilities available to a call on this
  model through this provider, or an empty array when that route offers none
  (the base "openai" client, local models). Pass the same model and provider
  the call will use: the answer depends on the route, not the model alone.

  @param model - The model that will run the call, or "" for the ambient default
  @param provider - The provider the call will route through, or "" for the ambient default
  """
  return _hostedSearchTools(model, provider)
}

export def searchProviderNames(): string[] {
  """
  Return the selected web-search provider's name, preferring Brave over
  Tavily, or an empty array when neither API key is set.
  """
  return map(selectedProviders(), \provider -> provider.name)
}
