import {
  _isMcpAvailable,
  _readProjectMcpConfig,
  _mergeMcpServers,
  _loadMcpTools,
  _loadMcpToolsWithStatus,
  _mcpPackageProblem,
  _connectMcpServers,
  _mcpServerStates,
  _startMcpLogin,
  _finishMcpLogin,
  _cancelMcpLogin,
  _disconnectMcpServer,
  _logoutMcpServer,
  _mcpNotInstalled,
  _reconnectMcpServer,
  _configureMcpServers,
  _pendingMcpServers,
  _markMcpServerFailed,
  _mcpCommandLine,
  _mcpEnvLine
} from "agency-lang/stdlib-lib/mcp.js"
import { keys } from "std::object"

/** @module
  @summary Load MCP tools, report server connection status, and log in to servers.
  Read project server settings, merge them with global settings, and load
  tools for use in `llm()`. Calls to loaded tools raise `mcp::call` so handlers
  and policies can approve or reject them.

  `connectMcpServers` connects servers without ever starting a login. A server
  that needs one gets the status `needsLogin`. `startMcpLogin` and
  `finishMcpLogin` log in to it in two steps, so the program can open the
  login page with `openUrl` in between. `logoutMcpServer` deletes a saved
  login and raises `mcp::logout`. These functions need `@agency-lang/mcp`
  0.0.6 or newer; `mcpPackageProblem` says when the installed one is older.

  Every function that can start a stdio server's command raises `mcp::connect`
  with the server's name, command line, and environment first. A server that
  is not approved is not started. HTTP servers start no process and raise
  nothing.

  ```ts
  import { readProjectMcpConfig, loadMcpToolsWithStatus } from "std::mcp"

  const servers = readProjectMcpConfig(".")
  const loaded = loadMcpToolsWithStatus(servers)
  printJSON(loaded.status)
  ```
*/

/** Loaded tools and each server's "connected" or "unavailable" status. */
export type McpLoadResult = {
  tools: any[];
  status: Record<string, string>
}

// The effect an MCP tool call raises before its JSON-RPC fires. Raised from TS
// (lib/stdlib/mcpGate.ts) via agency.interrupt with this exact name; declared
// here so handlers can match the effect and inspect its server, tool, and args.
@always(server, tool)
effect mcp::call {
  server: string,
  tool: string,
  args: Record<string, any>
}

// Raised before a stdio server's command starts. An HTTP server starts no
// process, so it raises nothing. `command` quotes any word with a space or a
// quote in it. `env` is the server's environment as sorted KEY=value words,
// or "" when it has none. An always-approve rule pins all three, because a
// variable such as NODE_OPTIONS can change what the same command runs.
@always(server, command, env)
effect mcp::connect {
  server: string,
  command: string,
  env: string
}

// The message a server gets when starting it was not approved.
static const NOT_APPROVED = "starting it was not approved"

// The servers whose start was approved, and the names of the ones refused.
type StartApproval = {
  approved: Record<string, any>;
  refused: string[]
}

// Ask before a stdio server's command starts. Succeeds with no question for
// an HTTP server.
def approveStart(name: string, config: Record<string, any>): Result raises <mcp::connect> {
  if (config.command == null) {
    return success(name)
  }
  return interrupt mcp::connect("Are you sure you want to start this MCP server?", {
    server: name,
    command: _mcpCommandLine(config),
    env: _mcpEnvLine(config)
  })
  return success(name)
}

// Ask about every stdio server in `merged`, one at a time.
def approveStarts(merged: Record<string, any>): StartApproval raises <mcp::connect> {
  let approval: StartApproval = {
    approved: {},
    refused: []
  }
  for (name in keys(merged)) {
    const answer = approveStart(name, merged[name])
    if (isFailure(answer)) {
      approval.refused.push(name)
    } else {
      approval.approved[name] = merged[name]
    }
  }
  return approval
}

export def isMcpAvailable(): boolean {
  """True when the @agency-lang/mcp package is installed and reachable."""
  return _isMcpAvailable()
}

@capabilities(fileRead)
export def readProjectMcpConfig(dir: string): Record<string, any> {
  """Read the mcpServers block from the project agency.json under `dir`."""
  return _readProjectMcpConfig(dir)
}

export def mergeMcpServers(global: Record<string, any>, project: Record<string, any>): Record<string, any> {
  """Merge global and project mcpServers configs (project wins on collision)."""
  return _mergeMcpServers(global, project)
}

@capabilities(fileRead, fileWrite, network, subprocess)
export def loadMcpTools(merged: Record<string, any>, onOAuthRequired?): any[] raises <mcp::connect> {
  """Load gated MCP tools for every server in `merged`. Asks before starting
  each stdio server, and skips one that is not approved. Returns [] when the
  package is absent, incompatible, or no servers are configured."""
  const approval = approveStarts(merged)
  return _loadMcpTools(approval.approved, onOAuthRequired)
}

@capabilities(fileRead, fileWrite, network, subprocess)
export def loadMcpToolsWithStatus(merged: Record<string, any>, onOAuthRequired?): McpLoadResult raises <mcp::connect> {
  """
  Load MCP tools and report which servers connected. Asks before starting
  each stdio server. A server that is not approved is "unavailable".

  @param merged - Server configurations, such as the output of mergeMcpServers.
  """
  const approval = approveStarts(merged)
  let loaded = _loadMcpToolsWithStatus(approval.approved, onOAuthRequired)
  for (name in approval.refused) {
    loaded.status[name] = "unavailable"
  }
  return loaded
}

/** One MCP server's state. `message` is empty unless the status is "failed".
  `tools` is empty unless the status is "connected". */
export type McpServerState = {
  name: string;
  status: "connected" | "needsLogin" | "failed";
  message: string;
  tools: any[]
}

// Raised before a saved MCP login is deleted.
@always(server)
effect mcp::logout {
  server: string
}

export def mcpPackageProblem(): string {
  """
  Return why the installed @agency-lang/mcp is too old for the server-state
  functions, with the command to upgrade it. Returns an empty string when it
  is new enough or not installed.
  """
  return _mcpPackageProblem()
}

@capabilities(fileRead, fileWrite, network, subprocess)
export def connectMcpServers(merged: Record<string, any>): McpServerState[] raises <mcp::connect> {
  """
  Connect every server in `merged` and return each one's state. Asks before
  starting each stdio server; one that is not approved is "failed". Never
  starts a login: a server that needs one comes back as "needsLogin".

  @param merged - Server configurations, such as the output of mergeMcpServers.
  """
  const approval = approveStarts(merged)
  let states = _connectMcpServers(approval.approved)
  for (name in approval.refused) {
    _markMcpServerFailed(name, NOT_APPROVED)
    states.push({
      name: name,
      status: "failed",
      message: NOT_APPROVED,
      tools: []
    })
  }
  return states
}

export def configureMcpServers(merged: Record<string, any>) {
  """
  Store the server configurations without connecting anything.
  connectPendingMcpServers connects them later.

  @param merged - Server configurations, such as the output of mergeMcpServers.
  """
  _configureMcpServers(merged)
}

@capabilities(fileRead, fileWrite, network, subprocess)
export def connectPendingMcpServers(): McpServerState[] raises <mcp::connect> {
  """
  Connect every stored server that has no state yet, and return their states.
  Asks before starting each stdio server, the same way connectMcpServers does.
  """
  const pending = _pendingMcpServers()
  if (keys(pending).length == 0) {
    return []
  }
  return connectMcpServers(pending)
}

export def mcpServerStates(): McpServerState[] {
  """
  Return the current state of every MCP server connected so far, with the
  tools of each connected one. Connects nothing.
  """
  return _mcpServerStates()
}

@capabilities(fileRead, fileWrite, network)
export def startMcpLogin(merged: Record<string, any>, name: string): Result<string> {
  """
  Start a login to an MCP server and return the URL of its login page,
  without waiting. Call finishMcpLogin to wait for the person to log in.

  @param merged - Server configurations, such as the output of mergeMcpServers.
  @param name - The server's name in the mcpServers config.
  """
  return _startMcpLogin(merged, name)
}

@capabilities(fileRead, fileWrite, network)
export def finishMcpLogin(name: string): McpServerState {
  """
  Wait for the person to finish the login startMcpLogin began, then connect
  to the server and return its state.

  @param name - The server's name in the mcpServers config.
  """
  return _finishMcpLogin(name)
}

@capabilities(network)
export def cancelMcpLogin(name: string) {
  """
  Stop a login to an MCP server that is in progress.

  @param name - The server's name in the mcpServers config.
  """
  _cancelMcpLogin(name)
}

@capabilities(network)
export def disconnectMcpServer(name: string) {
  """
  Close the connection to an MCP server and drop its tools. The saved login
  stays, and nothing connects to the server again until it is reconnected.

  @param name - The server's name in the mcpServers config.
  """
  _disconnectMcpServer(name)
}

export def mcpNotInstalled(): string {
  """
  Return the message that says @agency-lang/mcp is not installed, with the
  command to install it.
  """
  return _mcpNotInstalled()
}

@capabilities(fileWrite, network)
export def logoutMcpServer(name: string): Result raises <mcp::logout> {
  """
  Delete the saved login for an MCP server and disconnect from it.

  @param name - The server's name in the mcpServers config.
  """
  return interrupt mcp::logout("Are you sure you want to log out of this MCP server?", {
    server: name
  })

  return _logoutMcpServer(name)
}

@capabilities(fileRead, fileWrite, network, subprocess)
export def reconnectMcpServer(merged: Record<string, any>, name: string): McpServerState raises <mcp::connect> {
  """
  Disconnect from an MCP server and connect again with its saved login.
  Asks before starting a stdio server; one that is not approved is "failed".
  Never starts a login.

  @param merged - Server configurations, such as the output of mergeMcpServers.
  @param name - The server's name in the mcpServers config.
  """
  if (merged[name] != null) {
    const answer = approveStart(name, merged[name])
    if (isFailure(answer)) {
      _markMcpServerFailed(name, NOT_APPROVED)
      return {
        name: name,
        status: "failed",
        message: NOT_APPROVED,
        tools: []
      }
    }
  }
  return _reconnectMcpServer(merged, name)
}
