/** @module The `/settings` command UI for the agency agent: show the
  session's capability profile and pick one change to it. The profile is
  the one the session reported at its last pause, and the change is sent to
  the session as a `capabilities` answer, which saves and applies it
  (capabilityChange.agency). */

import { _pause, _send } from "agency-lang/stdlib-lib/agentTerminalDriver.js"
import { ChoiceItem, chooseOption } from "std::ui/cli"
import { pushMessage } from "std::ui/cli"

import { CAPABILITY_FIELDS, providerLacksEmbeddings } from "./capabilities.agency"
import { CapabilityChange, CapabilityReport } from "./capabilityChange.agency"

/** Human label for a capability source layer. Interprets the source
  strings resolveCapabilities emits (capabilities.agency). */
def capabilitySourceLabel(report: CapabilityReport, source: string): string {
  if (source == "default") {
    return "built-in default"
  }
  if (source == "catalog") {
    return "the model's own limit"
  }
  if (source == "provider") {
    return "provider default: ${report.provider}"
  }
  if (source == "model") {
    return "built-in for ${report.model}"
  }
  if (source == "user-global") {
    return "your global override"
  }
  if (source == "user-provider") {
    return "your override for ${report.provider}"
  }
  if (source == "embedding-override") {
    return "on: the embedding slot names a model"
  }
  return "your override for ${report.model}"
}

/** One "value (source)" cell. */
def capabilityRow(report: CapabilityReport, fieldKey: string): string {
  const values = report.values
  const sources = report.sources
  if (fieldKey == "summarize") {
    return "${values.summarize}   (${capabilitySourceLabel(report, sources.summarize)})"
  }
  if (fieldKey == "memory") {
    return "${values.memory}   (${capabilitySourceLabel(report, sources.memory)})"
  }
  let cap = "none"
  if (values.maxTokens != null) {
    cap = "${values.maxTokens}"
  }
  return "${cap}   (${capabilitySourceLabel(report, sources.maxTokens)})"
}

/** Render the profile with per-field provenance. */
export def showCapabilities(report: CapabilityReport) {
  pushMessage("Capabilities for ${report.model} (${report.provider}):")
  for (field in CAPABILITY_FIELDS) {
    pushMessage("  ${field.label}   ${capabilityRow(report, field.key)}")
  }
}

/** Ask which scope an override applies to. Returns "" on cancel. */
def pickOverrideScope(report: CapabilityReport): string {
  let scopeItems: ChoiceItem[] = []
  scopeItems.push({ key: "model", label: "this model (${report.model})" })
  scopeItems.push({ key: "provider", label: "this provider (${report.provider})" })
  scopeItems.push({ key: "global", label: "all models" })
  const scopeKey = chooseOption(
    "Scope",
    "Where should this apply?",
    scopeItems,
    allowCancel: true,
  )
  if (scopeKey == null) {
    return ""
  }
  return scopeKey
}

/** On or off for a boolean field, or null on cancel. When memory is
  turned on, says why it can't be, or notes what it lacks. */
def pickOnOff(report: CapabilityReport, fieldKey: string): boolean | null {
  let onOffItems: ChoiceItem[] = []
  onOffItems.push({ key: "on", label: "on" })
  onOffItems.push({ key: "off", label: "off" })
  const picked = chooseOption(fieldKey, "Enable ${fieldKey}?", onOffItems, allowCancel: true)
  if (picked == "" || picked == null) {
    return null
  }
  if (fieldKey == "memory" && picked == "on") {
    const status = report.embedding
    if (status.state == "key-missing") {
      pushMessage(
        color.red(
        "Cannot enable memory: the embedding slot needs ${status.varName}, which is not set. Export it, or point the embedding slot elsewhere via /model.",
      ),
      )
      return null
    }
    if (status.state == "no-override" && providerLacksEmbeddings(report.provider)) {
      pushMessage(
        color.dim(
        "Note: ${report.provider} has no embeddings endpoint, so Tier-2 semantic recall stays off. Point the embedding slot at a provider that has one, e.g. /model embedding=openai/text-embedding-3-small, or a served local model, e.g. /model embedding=mlx/qwen3-embedding-4b-mlx.",
      ),
      )
    }
  }
  return picked == "on"
}

/** The output-token cap: a positive number, "reset" to remove the
  override, or "" on cancel. */
def pickMaxTokens(): string {
  let capItems: ChoiceItem[] = []
  capItems.push({ key: "reset", label: "reset — remove my override, use the default" })
  const picked = chooseOption(
    "maxTokens",
    "Default output-token cap. Type a number, or pick reset.",
    capItems,
    allowFreeText: true,
    allowCancel: true,
  )
  if (picked == null) {
    return ""
  }
  return picked
}

/** The value the person picked for a field: `{ value }`, with a null value
  for a reset, or null when they cancelled or typed something unusable. */
def pickValue(report: CapabilityReport, fieldKey: string): any {
  if (fieldKey == "maxTokens") {
    const picked = pickMaxTokens()
    if (picked == "") {
      return null
    }
    if (picked == "reset") {
      return { value: null }
    }
    const parsed = parseInt(picked)
    if (parsed <= 0) {
      pushMessage(color.red("Not a positive number: ${picked}"))
      return null
    }
    return { value: parsed }
  }
  const on = pickOnOff(report, fieldKey)
  if (on == null) {
    return null
  }
  return { value: on }
}

/** Interactive edit: field, value, scope. The change, or null when the
  person stopped. */
export def editCapabilities(report: CapabilityReport): CapabilityChange | null {
  let fieldItems: ChoiceItem[] = []
  for (field in CAPABILITY_FIELDS) {
    fieldItems.push({ key: field.key, label: "${field.label} — ${field.description}" })
  }
  const fieldKey = chooseOption(
    "Settings",
    "Pick a setting to change (empty to exit).",
    fieldItems,
    allowCancel: true,
  )
  if (fieldKey == "" || fieldKey == null) {
    return null
  }
  const picked = pickValue(report, fieldKey)
  if (picked == null) {
    return null
  }
  const scopeKey = pickOverrideScope(report)
  if (scopeKey == "") {
    return null
  }
  return { scope: scopeKey, field: fieldKey, value: picked.value }
}

/** `/settings`: show the profile, pick a change, and send it to the
  session, which saves it, applies it, and says so. */
export def settingsSlashCommand(): boolean {
  const before: any = _pause() ?? {}
  const report = before.capabilities ?? null
  if (report == null) {
    pushMessage(color.red("This session reports no capability profile."))
    return true
  }
  showCapabilities(report)
  const change = editCapabilities(report)
  if (change == null) {
    return true
  }
  _send({ kind: "capabilities", settings: change })
  const after: any = _pause() ?? {}
  showCapabilities(after.capabilities ?? report)
  return true
}
