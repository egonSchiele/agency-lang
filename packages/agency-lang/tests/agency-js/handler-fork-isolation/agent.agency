// A handler applies only inside the branch that registered it: branch B's
// handler is never consulted for branch A's interrupt, and the other way
// round (HandlerEntry.stack, docs/dev/runtime/interrupts.md).
//
// Each branch's handler approves its own kickoff and, while answering it,
// reads a file. That read raises std::read from inside the handler body.
// The handler that is running never hears its own raise, and the sibling's
// handler is in another branch, so no handler answers the read and it is
// rejected. Before branch scoping, the sibling's handler was asked about it
// (and printed ASKED).
//
// This is an agency-js test because the ask-counts cannot ride the
// return value: prints share one stdout, so the JS side counts the ASKED
// lines instead.
//
// Correct: no ASKED line at all (no cross-branch ask), both reads
// rejected, and "A done,B done", which shows each branch's own handler
// still answered its own kickoff. A check that skipped every handler
// would leave the kickoffs unanswered and fail that last part.
node runForkIsolation(): string {
  const results = fork(["A", "B"]) as tag {
    handle {
      interrupt("kickoff-${tag}")
      return "${tag} done"
    } with (data) {
      if (data.effect == "std::read") {
        print("ASKED ${tag}")
        return reject()
      }
      if (data.message == "kickoff-${tag}") {
        const contents = read("agent.agency", __dirname)
        if (isFailure(contents)) {
          print("READ ${tag} rejected")
        }
        return approve()
      }
      return pass()
    }
  }
  return results.join(",")
}
