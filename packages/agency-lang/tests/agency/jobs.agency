import { jobOutput, stopJob, listJobs } from "std::jobs"
import { safeBash, startJob } from "std::safeBash"
import { mkdir, remove } from "std::fs"
import { bash } from "std::shell"

// Each node is its own run, with its own jobs. A job outlives the run that
// started it, so every node stops each job it starts, and every job has a
// one-minute limit in case a node fails before its stop. Job ids are
// random, so each node reads its job's id from listJobs().

def endsInBackground(question: string): boolean {
  return question.endsWith("in the background?")
}

// The id of the job a start made. A start that failed throws its own
// message, so the case reports why and not a missing job.
def heldId(started: Result<string>): string {
  if (started is failure(err)) {
    throw("startJob failed: ${err}")
  }
  const jobs = listJobs()
  if (jobs.length == 0) {
    throw("startJob succeeded, but the run holds no job.")
  }
  return jobs[0].id
}

node rejectedStartsNothing() {
  let result: any = null
  handle {
    result = startJob("sleep 30", maxMinutes: 1)
  } with (intr) {
    return reject("no background jobs")
  }
  return [isFailure(result), result.rejected, listJobs().length]
}

node backgroundQuestionSaysSo() {
  let questions: string[] = []
  handle {
    const id = heldId(startJob("sleep 1", maxMinutes: 1))
    safeBash("sleep 1")
    stopJob(id)
  } with (intr) {
    questions.push(intr.message)
    return approve()
  }
  return [
    endsInBackground(questions[0]),
    endsInBackground(questions[questions.length - 1]),
  ]
}

node startReadStop() {
  let started: any = null
  let id = ""
  let first: any = null
  let second: any = null
  handle {
    // The printf form keeps the expected text, A1 and B2, out of the
    // command, so the output cannot match by echoing the command.
    started = startJob("printf 'A%s\\n' 1; sleep 1; printf 'B%s\\n' 2", maxMinutes: 1)
    id = heldId(started)
    first = jobOutput(id, wait: 10)
    second = jobOutput(id)
    stopJob(id)
  } with (intr) {
    return approve()
  }
  return [
    started.value.includes(id),
    first.value.state,
    first.value.exitCode,
    first.value.stdout.includes("A1"),
    first.value.stdout.includes("B2"),
    second.value.stdout,
  ]
}

node stopEndsIt() {
  let stopped: any = null
  handle {
    stopped = stopJob(heldId(startJob("sleep 30", maxMinutes: 1)))
  } with (intr) {
    return approve()
  }
  return [stopped.value.state, listJobs()[0].unread]
}

// A time guard that runs out during a wait raises std::guard, as a trip
// between statements does, so the handler is asked. The job keeps running.
node guardTripDuringWaitAsksTheHandler() {
  let asked = false
  let blockFailed = false
  let state = ""
  handle {
    const id = heldId(startJob("sleep 30", maxMinutes: 1))
    const waited = guard(time: 200ms) {
      return jobOutput(id, wait: 30)
    }
    blockFailed = isFailure(waited)
    state = listJobs()[0].state
    stopJob(id)
  } with (intr) {
    if (intr.effect == "std::guard") {
      asked = true
      return reject()
    }
    return approve()
  }
  return [asked, blockFailed, state]
}

// Approving the trip with more time lets the block finish with the
// report the cut-short wait returned. This fails if the wait throws.
node guardTripDuringWaitCanBeApproved() {
  let asked = false
  let waited: any = null
  handle {
    const id = heldId(startJob("sleep 30", maxMinutes: 1))
    waited = guard(time: 200ms) {
      const report = jobOutput(id, wait: 30)
      if (report is failure(why)) {
        return "read failed: ${why}"
      }
      return report.value.state
    }
    stopJob(id)
  } with (intr) {
    if (intr.effect == "std::guard") {
      asked = true
      return approve({
        maxTime: 60000
      })
    }
    return approve()
  }
  return [asked, isSuccess(waited), waited.value]
}

// A handler that rejects the trip during the wait leaves the output
// unread, so the next read returns it. This fails if the wait and the read
// are one step.
node rejectedWaitKeepsOutput() {
  let later: any = null
  handle {
    const id = heldId(startJob("printf 'A%s\\n' 1; sleep 30", maxMinutes: 1))
    // The runner copies output to disk every quarter second, so give the
    // job time to print before the wait that is cut short.
    sleep(2s)
    const waited = guard(time: 200ms) {
      return jobOutput(id, wait: 30)
    }
    later = jobOutput(id)
    stopJob(id)
  } with (intr) {
    if (intr.effect == "std::guard") {
      return reject()
    }
    return approve()
  }
  return later.value.stdout.includes("A1")
}

node foregroundForInstantCommands() {
  let result: any = null
  let saysBackground = false
  handle {
    result = startJob("echo hi")
  } with (intr) {
    if (endsInBackground(intr.message)) {
      saysBackground = true
    }
    return approve()
  }
  return [
    result.value.startsWith("This command ran in the foreground"),
    result.value.includes("hi"),
    listJobs().length,
    saysBackground,
  ]
}

// An agency line runs in this process, so it never becomes a job, and the
// line in front of its output must not say it was quick.
node foregroundForAgencyCommands() {
  let result: any = null
  handle {
    result = startJob("agency typecheck tests/agency/jobs.agency")
  } with approve
  return [
    result.value.startsWith("This command ran in the foreground"),
    result.value.includes("finishes at once"),
    listJobs().length,
  ]
}

node unknownId() {
  const read = jobOutput("job-000000")
  const stopped = stopJob("job-000000")
  return [
    isFailure(read) && read.error.includes("There is no job job-000000 in this session"),
    isFailure(stopped) && stopped.error.includes("This session has no jobs"),
  ]
}

node missingFolder() {
  let result: any = null
  handle {
    result = startJob("sleep 1", cwd: "/no/such/folder", maxMinutes: 1)
  } with (intr) {
    return approve()
  }
  return [isFailure(result), result.error.includes("was not run"), listJobs().length]
}

/* The questions a line asks as a job, each as its effect and the end of
 its folder, and whether the job started. Every job it starts is
 stopped. */
def jobQuestions(line: string): any {
  let asked: any[] = []
  let result: any = null
  handle {
    result = startJob(line, cwd: __dirname, maxMinutes: 1)
    for (job in listJobs()) {
      stopJob(job.id)
    }
  } with (intr) {
    const folder: string = intr.data.cwd ?? ""
    asked.push([intr.effect, folder.endsWith("/tests/agency/stdlib")])
    return approve()
  }
  return [line, asked, isSuccess(result)]
}

// A job's line runs whole in the job's own process, where nothing checks
// it a step at a time. So only one command, or a `cd` and one command,
// gets narrow questions as a job: the `cd` is checked at launch and the
// command starts in its folder. Any other line of several steps asks
// std::bash.
node aJobIsOneStepOrACdAndOneStep() {
  return [
    jobQuestions("cd stdlib && pnpm --version"),
    jobQuestions("pnpm --version && pnpm --version"),
    jobQuestions("pnpm --version"),
  ]
}

// The job starts in the cd's folder: its listing shows a folder that is
// only inside tests/agency/stdlib, and not the tests folder's own files.
node aJobRunsInItsCdFolder() {
  let output: any = null
  handle {
    const id = heldId(startJob("cd stdlib && ls", cwd: __dirname, maxMinutes: 1))
    output = jobOutput(id, wait: 10)
    stopJob(id)
  } with (intr) {
    return approve()
  }
  return [output.value.stdout.includes("grep-fixtures"), output.value.stdout.includes("jobs.agency")]
}

/** A folder of its own, with `sub` and `other` in it. */
static const JOBS_FIXTURE = __dirname + "/stdlib/__jobs_cd__"

// The handler swaps `sub` for a link while it answers, so at launch the
// cd's folder leads somewhere other than the folder that was approved, and
// no job starts.
node aJobWhoseCdChangedDoesNotStart() {
  remove(JOBS_FIXTURE) with approve
  mkdir(JOBS_FIXTURE) with approve
  bash("mkdir sub other", cwd: JOBS_FIXTURE) with approve
  let result: any = null
  let swapped: boolean[] = []
  handle {
    result = startJob("cd sub && ls", cwd: JOBS_FIXTURE, maxMinutes: 1)
  } with (intr) {
    if (swapped.length == 0) {
      bash("rm -r sub && ln -s other sub", cwd: JOBS_FIXTURE) with approve
      swapped.push(true)
    }
    return approve()
  }
  const jobs = listJobs().length
  bash("rm -f sub", cwd: JOBS_FIXTURE) with approve
  remove(JOBS_FIXTURE) with approve
  return [isFailure(result), isFailure(result) && result.error.includes("now leads to"), jobs]
}

// A job launches a shell. In the foreground, the `cat` after this `cd` is
// run by safeBash itself, and its question describes the stdlib read, not
// a program a shell runs. So as a job the line asks the broad question.
node aJobOfAStepSafeBashRunsItselfAsksBroad() {
  remove(JOBS_FIXTURE) with approve
  mkdir(JOBS_FIXTURE) with approve
  bash("mkdir sub && printf 'a\\n' > sub/a.txt", cwd: JOBS_FIXTURE) with approve
  let result: any = null
  let asked: string[] = []
  handle {
    result = startJob("cd sub && cat a.txt", cwd: JOBS_FIXTURE, maxMinutes: 1)
  } with (intr) {
    asked.push(intr.effect)
    return reject("no")
  }
  const jobs = listJobs().length
  remove(JOBS_FIXTURE) with approve
  return [asked, isFailure(result), jobs]
}

// The handler swaps `one.txt` for a link to another file while it answers.
// A job's one step gets the check a foreground step gets, so the read now
// plans to the link's target, which nobody approved, and no job starts.
node aJobWhoseFileChangedDoesNotStart() {
  remove(JOBS_FIXTURE) with approve
  mkdir(JOBS_FIXTURE) with approve
  bash("mkdir sub && printf 'one\\n' > one.txt && printf 'SECRET\\n' > sub/secret.txt", cwd: JOBS_FIXTURE) with approve
  let result: any = null
  let swapped: boolean[] = []
  handle {
    result = startJob("cat one.txt | head -1", cwd: JOBS_FIXTURE, maxMinutes: 1)
  } with (intr) {
    if (swapped.length == 0) {
      bash("rm one.txt && ln -s sub/secret.txt one.txt", cwd: JOBS_FIXTURE) with approve
      swapped.push(true)
    }
    return approve()
  }
  const jobs = listJobs()
  for (job in jobs) {
    stopJob(job.id)
  }
  bash("rm -f one.txt", cwd: JOBS_FIXTURE) with approve
  remove(JOBS_FIXTURE) with approve
  return [isFailure(result), isFailure(result) && result.error.includes("it now asks to read"), jobs.length]
}

node timeLimitCarriesTheLimit() {
  let result: any = null
  handle {
    result = startJob("sleep 1", maxMinutes: 2)
    for (job in listJobs()) {
      stopJob(job.id)
    }
  } with (intr) {
    if (intr.data.timeout != 120000) {
      return reject("timeout was ${intr.data.timeout}")
    }
    return approve()
  }
  return isSuccess(result)
}
