import { setLlmOptions } from "std::llm"

const adjective = "hot"
node main(name: string, item: string) {
  // Pinned: the exact-match expectation is this model's exact echo.
  setLlmOptions({ model: "gpt-4o-mini", provider: "openai" })
  const adjective2 = "spicy"
  const result: string = llm("Respond with ONLY this exact text: '${name} wants ${adjective} ${adjective2} ${item}'")
  return result
}