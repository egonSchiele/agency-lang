// A rebind survives a real pause: the interrupt below is answered from the
// test file, so the program is checkpointed and resumed, and the body still
// sees the value the decorator passed. No handler in the program.
decorator def withTwo(call: Call, block: (args: object) -> any): any {
  return block({ ...call.args, n: 2 })
}

@withTwo
def f(n: number): number {
  interrupt("go?")
  return n
}

node main() {
  return f(1)
}
