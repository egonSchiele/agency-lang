import { grep } from "std::shell"
import { exit } from "std::system"
import { edit } from "std::fs"
import { pkgDir, repoRoot, stamp, pushBranch, ensureDir, handleScheduledInterrupt } from "./branch.agency"

/** @module
  Weekly maintenance agent: find "magic" constants scattered across the
  codebase that should be centralized in `lib/constants.ts`.

  It reads the current `lib/constants.ts` (to learn the house rule and avoid
  re-suggesting values already centralized), then uses search to hunt for
  literal values that are duplicated across files or that callers need to
  recognize/override. It moves the constants it finds and pushes a branch
  containing both the changes and a report explaining them.

  Security posture: runs non-interactively on GitHub Actions with a least-
  privilege `GITHUB_TOKEN` (`contents: write` only). The model gets `read`,
  `grep`, and `edit` — but never `exec`. File edits land in the diff a human
  reviews before merging; shell commands would not, and the runner's token
  sits in its environment. A handler additionally rejects any edit under
  `.github/`, because opening a pull request runs that branch's workflows with
  repository secrets before the review finishes — the one edit that acts
  before the review gate closes. Because this agent changes code rather than
  prose, CI also runs on the branch and catches a bad move before the pull
  request is opened. See `branch.agency`.
*/

node main() {
  handle {
    const root = repoRoot()
    const pkg = pkgDir()

    // Read the current constants file with the typed `read` tool (not a raw `cat`).
    const constsResult = read("lib/constants.ts", pkg) with approve
    let consts = ""
    if (constsResult is success(text)) {
      consts = text
    } else {
      print("Failed to read lib/constants.ts. Aborting.")
      exit(1)
    }

    const branch = "chore/constants-review"

    const rubric = """You maintain a TypeScript codebase (a programming language called Agency). The file lib/constants.ts is the single home for project-wide 'magic values': a literal (string or number) belongs there when it is used in more than one file, or when callers need to recognize or override it. Your job: find literals in the codebase that meet that bar but are NOT yet in lib/constants.ts, and would be clearer if centralized. Use the read and grep tools (search paths relative to the repository root; the code lives under packages/agency-lang/lib). Concentrate on lib/. Good candidates: the same string or number literal hardcoded in several files (env-var names, model names, default thresholds, timeouts, magic sentinels, file/dir names used as a cross-process contract). Ignore: values used in exactly one place, test fixtures, obvious loop bounds like 0/1, and anything already exported from lib/constants.ts. For each candidate: use the edit tool to add the constant to lib/constants.ts and update every call site to import it from there, then report a markdown bullet giving the literal value, every file:line you changed, and a one-line reason it belongs there. Keep each edit's oldText as small as possible while still matching uniquely. Only edit files under packages/agency-lang/lib — the branch stages nothing outside it, so an edit elsewhere would be silently dropped from the commit and leave the branch inconsistent. If a call site lies outside lib, do not move that constant; report it as a candidate for a human instead. If you find nothing worth moving, change nothing and reply with exactly the text NO ISSUES and nothing else."""

    const prompt = """${rubric}

Current lib/constants.ts (do NOT re-suggest anything already here):

${consts}"""

    // One LLM call, so there is no partial progress to save: a tripped budget
    // means this run produced nothing, and the next weekly run starts fresh.
    let finding = ""
    const budget = guard(label: "constants-review", cost: $3.00, time: 25m) {
      let inner = ""
      thread(session: "constants-review") {
        inner = llm(prompt, tools: [read, grep, edit]) with approve
      }
      return inner
    }
    if (budget is success(text)) {
      finding = text
    } else {
      print("Budget tripped before the review finished; nothing to push.")
      return
    }

    // Exact match: the rubric promises exactly `NO ISSUES`, so a reply that only
    // contains the phrase alongside real findings is still treated as a finding.
    if (finding.trim() == "NO ISSUES") {
      print("Reviewed the codebase; no un-centralized constants worth moving. Nothing to do.")
      return
    }

    const report = """# Constants centralization review

Automated weekly scan for 'magic' literals that belong in `lib/constants.ts`, run at ${stamp()} UTC. The changes on this branch have ALREADY been applied; each item below explains one of them. CI runs on this branch — check it before merging.

${finding}
"""

    const reportDir = "${pkg}/docs/dev/_reports"
    ensureDir(reportDir)
    const writeResult = write("constants-review.md", report, dir: reportDir) with approve
    if (writeResult is failure(err)) {
      print("Failed to write the report: ${err}. Aborting.")
      exit(1)
    }

    const url = pushBranch(
      root,
      branch,
      ["packages/agency-lang/lib", "packages/agency-lang/docs/dev/_reports"],
      "chore: centralize magic constants into lib/constants.ts",
    )
    if (url == "") {
      print("Nothing pushed; the log above says why (no changes, or a protected branch).")
    } else {
      print("Pushed ${branch}. Open a PR: ${url}")
    }
  } with handleScheduledInterrupt
}
