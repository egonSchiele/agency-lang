
// Interrupt, resume, then a TIME trip during a sleep (distinct from a
// cost trip's post-call check). The finalize runs with
// the RESTORED locals: progress was assigned before the pause and must
// survive serialization into the finalize.
def work(): string {
  const progress = "pre-interrupt"
  interrupt("continue?")
  sleep(2000)
  return "done"

  finalize {
    if (progress != null) {
      return "resumed-finalize:${progress}"
    }
    return "lost-locals"
  }
}

node main() {
  // The time trip during sleep() is a std::guard interrupt.
  // Rejecting it sends the guard down its trip path.
  handle {
    const result = guard(time: 600ms) {
      return work()
    }
    if (isFailure(result)) { return "unexpected" }
    return result.value
  } with (i) {
    return match(i.effect) {
      "std::guard" => reject()
      _ => pass()
    }
  }
}
