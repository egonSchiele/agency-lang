// A guard(time:) block counts time spent waiting on a model even when a
// callback ran Agency code just before the request. The callback's function
// returns right before the request goes out, and no step runs while it is
// out, so a return that paused the clock would hide the whole request.
//
// Wall-clock on purpose, like the in-flight nodes in trip-time.agency: the
// mock's delay is a real timer that honors the abort signal, and nothing can
// advance a fake clock while the request is out. The only timing
// requirement is limit << delay (100ms vs 5s).

let loud = false

def isLoud(): boolean {
  return loud
}

callback("onLLMCallStart") as data {
  if (isLoud()) {
    print("starting")
  }
}

node midRequestAfterCallback() {
  handle {
    const r = guard(time: 100ms) {
      const answer: string = llm("Reply with: pong")
      return "done:${answer}"
    }
    if (isFailure(r)) {
      return "tripped"
    }
    return "not tripped: ${r.value}"
  } with (i) {
    return match(i.effect) {
      "std::guard" => reject()
      _ => pass()
    }
  }
}
