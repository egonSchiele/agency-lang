/** @module
  @summary The coordinator brain: one main LLM that routes to the code,
  research, oracle, explorer, review, writing, and rewrite subagents. The harness (agent.agency
  and lib/) owns the CLI, the REPL, the policy handler, and the per-turn
  guard; this module only answers turns.
*/
import { _exit } from "agency-lang/stdlib-lib/system.js"
import { question } from "std::agent"
import { AgencySource } from "std::agency"
import { writableFileTools, whatIAmDoing } from "std::agents/lib/toolkits"
import { now, elapsedTime } from "std::date"
import { setMemoryId } from "std::memory"
import { skillsDir } from "std::skills"
import { Attachment, endTurn, systemMessage } from "std::thread"

import { generateImageFile, viewImageFile } from "../../lib/images.agency"
import { addGlobalInstructions } from "../../lib/globalInstructions.agency"
import { projectContextText } from "../../lib/projectContext.agency"
import { learnedExtras } from "../../lib/learned.agency"
import { claudeSkillTools } from "../../lib/claudeSkills.agency"
import { getMcpTools } from "../../lib/mcp.agency"
import { searchSessions } from "../../lib/sessionSearch.agency"
import { getGeneratedTools, learnSessionTools, learnSkill, writeToolFor } from "./learn.agency"
import { checkBundledSkill } from "./lib/bundledSkills.agency"
import { useLlmOptions } from "./llmOptionTools.agency"
import { deletePreset, listPresets, savePreset, setDefaultPreset } from "./presetTools.agency"
import {
  getCapabilities,
  getRouterModel,
  getRouterProvider,
  getSlowModel,
  getSlowProvider,
 } from "../../shared.agency"
import { AgentBrain, BrainContext } from "../brain.agency"
import { agencyCodeAgent, codeAgent, setCodeOneShot, superpowersSkill } from "./subagents/code.agency"
import { explorerAgent } from "./subagents/explorer.agency"
import { oracleAgent } from "./subagents/oracle.agency"
import { researchAgent } from "./subagents/research.agency"
import { reviewAgent } from "./subagents/review.agency"
import { rewriteAgent } from "./subagents/rewrite.agency"
import { Route, pickRoute } from "./router.agency"
import { writingAgent } from "./subagents/writing.agency"

// Per-run grounding, from BrainContext. Spliced into the system prompt.
let _context: string = ""

let first = true

// The same flag for a coder started directly with --agent.
let coderFirst = true

// Bundled prompts are read at static-init, before the policy handler exists.
// coordinatorInit only checks the reads succeeded.
static const MAIN_PROMPT = read("./prompts/main.md", __dirname) with approve

// Skills about the agent itself. The folder ships with the agent, so the
// scan is approved here, as the prompt reads above are. An outer handler
// that rejects the scan still wins.
static const coordinatorSkills = skillsDir(
  __dirname + "/skills",
  "flat",
  name: "coordinator_skills",
) with approve

// The read-only file tools let the coordinator answer a question that
// hinges on a few files from its own context, instead of paying for a
// subagent dispatch. Bigger sweeps still go to the explorer.
//
// `write` and `edit` are here for the same reason: a file whose content the
// coordinator already has, or a small change to one it has read, should not
// cost a codeAgent dispatch. Handing a whole file to codeAgent means writing
// it out twice. Anything that needs a build or tests still goes to codeAgent.
export static const mainAgentTools = [
  researchAgent,
  codeAgent,
  agencyCodeAgent,
  reviewAgent,
  oracleAgent,
  explorerAgent,
  writingAgent,
  rewriteAgent,
  generateImageFile,
  viewImageFile,
  learnSkill,
  writeToolFor,
  coordinatorSkills,
  listPresets,
  savePreset,
  deletePreset,
  setDefaultPreset,
  useLlmOptions,
  ...writableFileTools(),
]

def exitIfBroken(checked: Result<boolean>) {
  match(checked) {
    failure(reason) => {
      print(color.red("Agent setup failed: ${reason}"))
      _exit(1)
    }
    _ => null
  }
}

def coordinatorInit(context: BrainContext) {
  if (isFailure(MAIN_PROMPT)) {
    print(color.red("Failed to read prompts/main.md: ${MAIN_PROMPT.error}"))
    _exit(1)
  }
  exitIfBroken(checkBundledSkill(superpowersSkill, "brainstorming"))
  exitIfBroken(checkBundledSkill(coordinatorSkills, "presets"))
  _context = context.grounding
  first = true
  coderFirst = true
  // One-shot autonomy: tell the coders there is no human to answer
  // questions and no next turn, so they must drive to a finished artifact.
  setCodeOneShot(!context.interactive)
}

// The tools that differ per user, each kind read once per turn. The
// learned ones are read from the agent home on every turn, not once at
// startup, so a tool the user saves in this session is callable on the
// next turn.
type UserTools = {
  mcp: any[];
  learned: any[];
  skills: any[];
  generated: any[]
}

def userTools(): UserTools {
  return {
    mcp: getMcpTools(),
    learned: learnedExtras(),
    skills: claudeSkillTools(),
    generated: getGeneratedTools()
  }
}

def turnBuiltIns(turnStart: any): any[] {
  return [
    learnTools.partial(turnStart: turnStart),
    whatIAmDoing,
    searchSessions,
    question,
    elapsedTime.partial(since: turnStart),
  ]
}

def offeredTools(user: UserTools, turnStart: any): any[] {
  return [
    ...mainAgentTools,
    ...user.mcp,
    ...user.learned,
    ...user.skills,
    ...user.generated,
    ...turnBuiltIns(turnStart),
  ]
}

// The tools one turn offers.
export def turnTools(turnStart: any): any[] {
  return offeredTools(userTools(), turnStart)
}

// The names the router reads on the coordinator's line, which keeps the
// first 30: the tools that differ per user first, since they are what the
// router cannot otherwise know about, then the built-in ones. The routed
// subagents are options of their own.
def routerToolNames(user: UserTools, turnStart: any): string[] {
  const tools = [
    ...user.learned,
    ...user.generated,
    ...user.skills,
    ...user.mcp,
    ...mainAgentTools,
    ...turnBuiltIns(turnStart),
  ]
  return [tool.name for tool in tools if tool.name != "researchAgent" && tool.name != "codeAgent"]
}

def mainOptions(tools: any[]): any {
  const options: any = { memory: true, tools: tools }
  const slowModel = getSlowModel()
  if (slowModel != "") {
    options.model = slowModel
    options.provider = getSlowProvider()
  }
  return options
}

handoff def learnTools(
  turnStart: any,
  source: AgencySource,
  names: string[] = [],
  namespace: string = "session",
): Result<string> {
  """
  Learn exported Agency functions for this conversation, then continue
  the user's request with those tools available immediately. Read a
  documentation URL first and resolve it to a stdlib module or Agency
  source. An empty names list learns all supported public functions.

  Learning runs the module's top-level code in a subprocess and can ask
  for approval. Every later call also uses the normal subprocess gates.
  Tools remain available after this conversation is resumed. They are
  not saved in the permanent toolbox. Existing names are never replaced;
  choose another namespace if a name is already available.
  """
  const offeredNames = [tool.name for tool in turnTools(turnStart)]
  const learned = learnSessionTools(source, names, namespace, offeredNames)?
  const answer = llm(
    "The tools ${learned.join(", ")} are now available for this conversation. Continue the user's request using them as needed.",
    mainOptions(turnTools(turnStart)),
  )
  endTurn()
  return success(answer)
}

// A routed turn is longer than this, the router was not measured on such
// messages: the REPL puts pending notes, which can be a whole `!` command's
// output, above the message in one string.
static const ROUTE_MAX_CHARS = 8000

type TurnRoute = {
  route: Route;
  text: string
}

// The message when the prompt is plain text, else "". The harness sends the
// main target [message, ...attachments], so one part is a plain message.
def plainText(prompt: string | (string | Attachment)[]): string {
  return match(prompt) {
    plain: string => plain
    parts: (string | Attachment)[] => {
      if (parts.length == 1) {
        return "${parts[0]}"
      }
      return ""
    }
  }
}

// Which agent takes the turn. Only a plain-text message of a routable
// length is asked about, and only when the router slot is set. See
// docs/dev/agents/agent-router.md.
def routeFor(
  prompt: string | (string | Attachment)[],
  user: UserTools,
  turnStart: any,
): TurnRoute {
  const text = plainText(prompt)
  const model = getRouterModel()
  if (model == "" || text == "" || text.length > ROUTE_MAX_CHARS) {
    return {
      route: "coordinator",
      text: text
    }
  }
  const choice = pickRoute(text, routerToolNames(user, turnStart), model, getRouterProvider())
  if (choice.notice != "") {
    print(color.dim(choice.notice))
  }
  return {
    route: choice.route,
    text: text
  }
}

def mainAgent(prompt: string | (string | Attachment)[]): string {
  // The prompt tells the model to report progress (whatIAmDoing) and watch
  // the clock (elapsedTime), so both must be in its tool list. elapsedTime
  // is anchored to this turn's start.
  const turnStart = now()
  const user = userTools()
  const routed = routeFor(prompt, user, turnStart)
  thread(label: "main", session: "main") {
    setMemoryId("main")
    if (first) {
      const sysPrompt = MAIN_PROMPT catch ""
      systemMessage("${sysPrompt}${_context}")
      first = false
    }
    // The coordinator runs on the slow (capable) slot: it holds the whole
    // conversation and makes every routing decision, so it gets the
    // strongest model the user configured. High-volume work still runs on
    // the subagents' own slots.
    addGlobalInstructions()
    // A routed subagent runs here from code, on the main thread. Its persona
    // expires with its llm() call; its prompt and reply stay.
    const result = match(routed.route) {
      "research" => replyText("The researcher", researchAgent(routed.text))
      "code" => replyText("The coder", codeAgent(routed.text))
      _ => llm(prompt, mainOptions(offeredTools(user, turnStart)))
    }
    // The researcher sets its own memory id; the main thread keeps "main".
    setMemoryId("main")
  }
  return result
}

// Named subagents take text; the harness sends them text, so this is the
// identity in practice and a guard against a future caller.
def promptText(prompt: string | (string | Attachment)[]): string {
  return match(prompt) {
    text: string => text
    parts: (string | Attachment)[] => "${parts[0]}"
  }
}

// A --target call has no coordinator to read the Result.
def replyText(name: string, result: Result<string>): string {
  if (isFailure(result)) {
    return "${name} stopped before finishing: ${result.error}"
  }
  return result.value
}

def researchTurn(userMsg: string): string {
  return replyText("The researcher", researchAgent(userMsg))
}

// The coder, oracle, and explorer are handoffs: as tools they continue the
// caller's thread. Called directly by --agent there is no caller thread
// to continue, so give each its own. The thread is this brain's display
// choice: if the stdlib agents opened it, every direct call from a user
// program would get a labelled, summarized thread too. The coder's thread
// is a session, so a later turn sees the files it read on earlier ones.
// On its first turn it gets the project block the coordinator's own prompt
// carries.
def coderTurn(target: string, userMsg: string): string {
  let reply = ""
  thread(label: target, session: target) {
    if (coderFirst) {
      systemMessage(projectContextText())
      coderFirst = false
    }
    if (target == "agencyCode") {
      reply = replyText("The Agency coder", agencyCodeAgent(userMsg))
    } else {
      reply = replyText("The coder", codeAgent(userMsg))
    }
  }
  return reply
}

def oracleTurn(userMsg: string): string {
  let reply = ""
  thread(label: "oracle", summarize: true) {
    reply = replyText("The oracle", oracleAgent(userMsg))
  }
  return reply
}

def explorerTurn(userMsg: string): string {
  let reply = ""
  thread(label: "explorer", summarize: true) {
    reply = replyText("The explorer", explorerAgent(userMsg))
  }
  return reply
}

def coordinatorRunTurn(
  target: string,
  prompt: string | (string | Attachment)[],
): string {
  return match(target) {
    "code" => coderTurn("code", promptText(prompt))
    "agencyCode" => coderTurn("agencyCode", promptText(prompt))
    "research" => researchTurn(promptText(prompt))
    "oracle" => oracleTurn(promptText(prompt))
    "explorer" => explorerTurn(promptText(prompt))
    "review" => reviewAgent(promptText(prompt))
    "writing" => writingAgent(promptText(prompt))
    "rewrite" => rewriteAgent(promptText(prompt))
    _ => mainAgent(prompt)
  }
}

export def coordinatorBrain(): AgentBrain {
  return {
    name: "coordinator",
    session: "main",
    description: "One coordinator LLM that routes to code, Agency code, research, oracle, explorer, review, writing, and rewrite subagents",
    startTargets: ["code", "agencyCode", "research", "oracle", "explorer", "review", "writing", "rewrite"],
    init: coordinatorInit,
    runTurn: coordinatorRunTurn
  }
}
