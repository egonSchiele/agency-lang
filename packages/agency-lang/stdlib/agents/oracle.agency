import { hostedSearchTools, searchTools } from "std::agents/lib/search"
import { AGENT_SPILL_OVER, llmOptions, withContext } from "std::agents/lib/shared"
import {
  readOnlyFileTools,
  agencyCodeTools,
  agencyDocTools,
  webTools,
  spillTools,
  SAVE_DRAFT_HINT,
 } from "std::agents/lib/toolkits"
import { guarded } from "std::decorators"
import { agentSkill } from "std::skills"
import { ensureSystemMessage } from "std::thread"

/** @module
@summary Get a focused second opinion on a plan, design, or persistent bug.

The oracle reads the code and returns an analysis with a recommendation.
Its built-in tools inspect files and sources. Use `explorerAgent` for a
broad overview of a codebase or body of documentation.

When called as an LLM tool, the oracle continues the caller's conversation.
From code, wrap the call in `thread { ... }` when you want an isolated consult.
*/

static const skills = agentSkill("oracle")

static const systemPrompt = """
Give a focused second opinion on a plan, design, or persistent bug.
Read the code, explain your conclusion, and recommend a concrete next
step. Do not change files or run commands.

- Ground claims in code you have read. Batch independent lookups.
- Before recommending a new helper, type, or approach, search for an
  existing solution. Cite its file path and line number if you find one.
- Explain flaws and overlooked constraints directly, with file paths,
  line numbers, and relevant quotes. Distinguish evidence from assumptions.
- Lead with the analysis. Include the evidence the caller needs to assess
  it, without a codebase tour or a restatement of their plan.
- End with a recommendation: proceed, change a specific part, or use a
  different approach. If the choice depends on a condition, name it.
  When the plan is sound, a brief verdict is enough.

Use the bundled Agency documentation to check language questions.
When the request leaves a reasonable assumption open, state it and
answer. Ask for clarification only when the ambiguity prevents a useful
judgment.${SAVE_DRAFT_HINT}
"""

// Read-only by design: the oracle inspects, consults, and judges, and a
// reviewer that can edit is no longer a reviewer.
export def buildTools(): any[] {
  """
  Return the oracle's file, Agency-source, and web lookup tools.
  """
  return [
    ...readOnlyFileTools(),
    ...agencyCodeTools(),
    ...agencyDocTools(),
    ...webTools(),
    ...spillTools(),
    ...searchTools(),
    skills,
  ]
}

def consider(
  question: string,
  context: string,
  model: string,
  provider: string,
  extraTools: any[],
): string {
  ensureSystemMessage(systemPrompt)
  return llm(
    withContext(task: question, context: context),
    llmOptions(
    model: model,
    provider: provider,
    tools: buildTools().concat(extraTools).concat([saveDraft]),
    spillToolResultsOver: AGENT_SPILL_OVER,
    hostedTools: hostedSearchTools(model, provider),
    reasoningEffort: "high",
    thinking: true,
  ),
  )
}

/** Called from code, this runs on the caller's thread like any function:
  the system prompt, the reads, and the answer stay there. Wrap the call
  in `thread { ... }` for an isolated consult. */
@guarded(cost: maxCost, time: maxTime)
export handoff def oracleAgent(
  question: string,
  context: string = "",
  maxCost: number = $20.00,
  maxTime: number = 15m,
  model: string = "",
  provider: string = "",
  extraTools: any[] = [],
): Result<string> {
  """
  Read the code and give a focused second opinion on a plan, design, or bug.
  It never changes anything. It continues your conversation and sees
  everything said so far, so ask the question itself without restating the
  context.

  @param maxCost - Cost budget in USD.
  @param maxTime - Time budget in milliseconds.
  @param model - Model override, or "" for the ambient model.
  @param provider - Provider for the model override, ignored when model is empty.
  @param extraTools - Tools to add to the built-in lookup tools.
  """

  // Return position: a draft the model saved reaches the guard, which
  // returns it as the backup answer if the budget runs out.
  return consider(
    question: question,
    context: context,
    model: model,
    provider: provider,
    extraTools: extraTools,
  )
}
