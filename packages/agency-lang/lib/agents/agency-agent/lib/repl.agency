/** @module
  @summary The interactive terminal: slash commands, the status line, and
  how a message becomes a turn and its reply is drawn. The agent is one
  run: a message calls the harness's `runTurn` here, and a command calls
  the function that makes its change. After each line the session is saved
  (lib/stdlib/agentReplSession.ts). See docs/dev/agents/agent-sessions.md.
*/
import {
  _installSessionHooks,
  _sessionOnSubmit,
  _takeCheckpointToRestore,
 } from "agency-lang/stdlib-lib/agentReplSession.js"
import { _setReplResubmit } from "agency-lang/stdlib-lib/cli.js"
import { _addToTranscript } from "agency-lang/stdlib-lib/agentTranscript.js"
import { localModelsSupported, listModelNames } from "std::agency/local"
import { listHostedModels } from "std::llm"
import { getModelCosts } from "std::thread"
import {
  chooseOption,
  ChoiceItem,
  pushMessage,
  lineWasTyped,
  repl,
  clearHistory,
  clearScreen,
 } from "std::ui/cli"

import { settingsSlashCommand } from "./capabilitiesUi.agency"
import { compactIfDue, contextStatus } from "./compaction.agency"
import { HISTORY_PATH } from "./config.agency"
import { mcpSlashCommand } from "./mcpMenu.agency"
import { filterHostedModels } from "./modelFilters.agency"
import { withPendingNotes } from "./pendingNotes.agency"
import { presetListLines, presetTable } from "./presets.agency"
import {
  conversationThread,
  forkSession,
  markTurnDone,
  recordTurn,
  renameSession,
  sessionTitle,
  waitingTarget,
 } from "./record.agency"
import { availableBackendItems } from "./search.agency"
import {
  applyPendingLlmOptions,
  modelChoiceItems,
  scopedPickerNotes,
  parseModelsFilters,
  parsePresetCommand,
 } from "./session.agency"
import {
  changeModel,
  changePreset,
  changeSearch,
  compactNow,
  saveToPreset,
  useLocal,
 } from "./sessionChanges.agency"
import { sessionFacts } from "./sessionFacts.agency"
import { forkSessionPolicy } from "./sessionPolicy.agency"
import { attachClipboardImage } from "./slashCommands/image.agency"
import { policySlashCommand } from "./slashCommands/policy.agency"
import { forkLine, renameLine } from "./slashCommands/session.agency"
import { shellCommand } from "./slashCommands/shell.agency"
import { jobsSlashCommand } from "./slashCommands/jobs.agency"
import { renderReply, renderUserLine } from "./transcript.agency"
import { runTurn } from "./turn.agency"
import { formatTurnFailure, parseModelSpec } from "./utils.agency"

static const ESC_HINT = " Press Esc to stop."

def searchSlashCommand(): boolean {
  const opts = availableBackendItems()
  const choice = chooseOption(
    "Web search backend",
    "Pick how this agent searches the web. Current: ${sessionFacts().search}",
    opts,
    false,
    true,
  )
  if (choice != "" && choice != null && choice != undefined) {
    // A backend the session can't use is reported as an error notice.
    changeSearch(choice)
    if (sessionFacts().search == choice) {
      pushMessage("Web search backend set to: ${choice}")
    }
  }
  return true
}

// The usage rows give one row per kind and model, so the model name alone
// does not identify a row: a model used for completions and for images has
// two, and an addCost() charge has kind "manual" and no model at all.
def costRowLabel(kind: string, model: string): string {
  if (kind == "completion") {
    return model
  }
  if (model == "") {
    return "(${kind})"
  }
  return "${model} (${kind})"
}

/** The run's spend: every row of its usage meter, which a checkpoint
  carries across a resume. */
def totalCost(): number {
  let total = 0.0
  for (m in getModelCosts()) {
    total = total + m.cost
  }
  return total
}

def costSlashCommand(): boolean {
  // The total and the rows come from the same meter, so the lines here
  // can never disagree.
  const byModel = getModelCosts()
  let totalTokens = 0
  let totalCacheRead = 0
  let totalCacheWrite = 0
  for (m in byModel) {
    // Cache reads and writes are input tokens too. Counting only
    // inputTokens + outputTokens reports a fraction of a cached
    // conversation — on a long agent run, often under a tenth of it.
    totalTokens = totalTokens
      + m.inputTokens + m.outputTokens
      + m.cachedInputTokens + m.cacheCreationInputTokens
    totalCacheRead = totalCacheRead + m.cachedInputTokens
    totalCacheWrite = totalCacheWrite + m.cacheCreationInputTokens
  }
  pushMessage("Cost:   $${totalCost().toFixed(4)}")
  pushMessage("Tokens: ${totalTokens}")
  if (totalCacheRead > 0 || totalCacheWrite > 0) {
    pushMessage(
      color.dim("        ${totalCacheWrite} written to cache, ${totalCacheRead} read back"),
    )
  }
  if (byModel.length > 0) {
    pushMessage("")
    pushMessage("By model:")
    for (m in byModel) {
      const up = m.inputTokens + m.cachedInputTokens + m.cacheCreationInputTokens
      pushMessage(
        "  ${costRowLabel(m.kind, m.model)}  ↑${up} ↓${m.outputTokens}  $${m.cost.toFixed(4)}",
      )
    }
  }
  return true
}

def pushSlots(heading: string, models: any) {
  pushMessage(heading)
  for (slot in Object.keys(models)) {
    const value = models[slot]
    if (value != null) {
      pushMessage(color.dim("  ${slot}: ${value.model} (${value.via})"))
    }
  }
}

/** The session's models as text, to tell whether a command changed them. */
def modelsNow(): string {
  return JSON.stringify(sessionFacts().models)
}

def modelSlashCommand(command: string): boolean {
  let spec = parseModelSpec(command)
  if (spec == "") {
    const facts = sessionFacts()
    pushSlots("Current models:", facts.models)
    const established = facts.fixedProvider
    const items = modelChoiceItems({}, established)
    for (line in scopedPickerNotes(established, items.length)) {
      pushMessage(color.dim(line))
    }
    const choice = chooseOption(
      "Model",
      "Pick a model, or type one (or slot=model, e.g. reasoning=claude-opus-4-8). Empty to cancel.",
      items,
      allowFreeText: true,
      allowCancel: true,
    )
    if (choice == "" || choice == null) {
      return true
    }
    spec = choice
  }
  const before = modelsNow()
  // A refused spec is reported as an error notice.
  changeModel(spec)
  if (modelsNow() != before) {
    pushSlots("Model set:", sessionFacts().models)
  }
  return true
}

def presetSlashCommand(command: string): boolean {
  const parsed = parsePresetCommand(command)
  if (parsed.kind == "list") {
    for (line in presetListLines(presetTable(), sessionFacts().preset)) {
      pushMessage(line)
    }
    return true
  }
  if (parsed.kind == "save") {
    saveToPreset(parsed.name)
    return true
  }
  const name = parsed.name
  changePreset(name)
  const after = sessionFacts()
  if (after.preset == name) {
    pushSlots("Preset set: ${name}", after.models)
  }
  return true
}

def modelsSlashCommand(trimmed: string): boolean {
  const filters = parseModelsFilters(trimmed)
  const models = filterHostedModels(listHostedModels(), filters)
  if (models.length == 0) {
    pushMessage("No models match.")
    return true
  }
  for (model in models) {
    pushMessage(
      "  ${model.name}  (${model.provider}, $${model.inputCost}/1M in, $${model.outputCost}/1M out, ${model.contextWindow} ctx)",
    )
  }
  return true
}

def localSlashCommand(): boolean {
  if (!localModelsSupported()) {
    pushMessage(
      color.yellow(
      "Local models need smoltalk-llama-cpp. Install:  ! npm i -g smoltalk-llama-cpp",
    ),
    )
    return true
  }
  let items: ChoiceItem[] = []
  for (modelName in listModelNames()) {
    items.push({
      key: modelName.name,
      label: modelName.name
    })
  }
  const choice = chooseOption(
    "Local model",
    "Pick a local model, or type an hf: URI / .gguf path (downloads on first use):",
    items,
    allowFreeText: true,
    allowCancel: true,
  )
  if (choice == "" || choice == null) {
    return true
  }
  // The switch says what it did, or why it could not, in a notice.
  useLocal(choice)
  return true
}

def renameSlashCommand(title: string): boolean {
  pushMessage(renameLine(renameSession(title)))
  return true
}

def forkSlashCommand(): boolean {
  const forked = forkSession()
  if (forked is success(fact)) {
    // A session with a policy file of its own keeps that policy.
    forkSessionPolicy(fact.forkedFrom, fact.id)
  }
  pushMessage(forkLine(forked))
  return true
}

def compactSlashCommand(keep: string): boolean {
  compactNow(keep)
  return true
}

// The start target of the `-i` prompt, until the REPL submits it. That
// line is a message whatever it starts with, sent to this target.
let _seedWaits = false
let _seedTarget = ""

// Slash-command + user-message dispatcher invoked by `repl()` for
// every Enter keystroke. Return `false` to terminate the loop.
def dispatch(msg: string): boolean {
  if (_seedWaits) {
    _seedWaits = false
    return messageTurn(_seedTarget, msg)
  }
  // Trim once for built-in matching so `"/help\n"` (piped) or
  // `"  /clear"` behave the same as `"/clear"`. The turn receives the raw
  // `msg`, so the model sees the exact text the user typed.
  const trimmed = msg.trim()
  return match(trimmed) {
    "" => true
    "/exit" => false
    "/quit" => false
    "/clear" => {
      clearScreen()
      return true
    }
    "/clear-history" => {
      clearHistory()
      pushMessage("Input history cleared.")
      return true
    }
    "/help" => {
      pushMessage(
        "Commands: /exit, /clear, /clear-history, /cost, /model, /models, /local, /preset, /policy, /search, /settings, /mcp, /rename, /init, /image, /compact, /fork, /jobs, /paste, /help. Start a line with ! to run a shell command yourself.",
      )
      return true
    }
    "/settings" => settingsSlashCommand()
    "/mcp" => mcpSlashCommand()
    "/search" => searchSlashCommand()
    "/cost" => costSlashCommand()
    "/model" => modelSlashCommand(trimmed)
    "/models" => modelsSlashCommand(trimmed)
    "/local" => localSlashCommand()
    "/preset" => presetSlashCommand(trimmed)
    "/policy" => policySlashCommand()
    "/rename" => renameSlashCommand("")
    "/image" => imageSlashCommand("")
    "/compact" => compactSlashCommand("")
    "/jobs" => jobsSlashCommand("")
    "/fork" => forkSlashCommand()
    _ => prefixedCommand(trimmed, msg)
  }
}

def prefixedCommand(trimmed: string, msg: string): boolean {
  if (isShellCommand(trimmed)) {
    return shellCommand(trimmed.slice(1).trim())
  }
  if (trimmed.startsWith("/image ")) {
    return imageSlashCommand(trimmed.slice(7).trim())
  }
  if (trimmed.startsWith("/jobs ")) {
    return jobsSlashCommand(trimmed.slice(6))
  }
  if (trimmed.startsWith("/compact ")) {
    return compactSlashCommand(trimmed.slice(9).trim())
  }
  if (trimmed.startsWith("/rename ")) {
    return renameSlashCommand(trimmed.slice(8))
  }
  if (trimmed.startsWith("/model ")) {
    return modelSlashCommand(trimmed)
  }
  if (trimmed.startsWith("/models ")) {
    return modelsSlashCommand(trimmed)
  }
  if (trimmed.startsWith("/preset ")) {
    return presetSlashCommand(trimmed)
  }
  return messageTurn("", msg)
}

// A `!` line is a shell command only when the user typed it and pressed
// Enter at the prompt. Pasted text, a `/paste` buffer, and text written in
// the editor go to the model as a message, however they start, because a
// command here runs with no approval.
def isShellCommand(trimmed: string): boolean {
  return trimmed.startsWith("!") && !trimmed.includes("\n") && lineWasTyped()
}

// `/image` alone holds the image for the next message. With text after
// it, that text is sent now, with the image.
def imageSlashCommand(message: string): boolean {
  if (!attachClipboardImage()) {
    return true
  }
  if (message == "") {
    pushMessage(color.dim("The image will go with your next message."))
    return true
  }
  return messageTurn("", message)
}

/** One message as a turn: the model answers it, and the reply is drawn.
  `target` is a start target such as "code", or "" for the main agent.
  An edit's diff is drawn by the policy handler: in its prompt, or when a
  rule approves the edit. */
def messageTurn(target: string, text: string): boolean {
  // Before the turn, so a turn picked up from a checkpoint taken at an
  // approval already has its entry, and it is not added twice.
  _addToTranscript("user", text)
  // The message is worked out on its own line. A call inside the argument
  // of a `try` call is run again when a turn is picked up from a
  // checkpoint, and takes the saved frame of the turn (#1506).
  const message = withPendingNotes(text)
  const reply = try runTurn(target, message)
  if (reply is success(replyText)) {
    if (replyText != "" && replyText != null) {
      _addToTranscript("assistant", replyText)
      renderReply(replyText)
    } else {
      pushMessage(color.red("No reply generated."))
    }
  } else if (reply is failure(problem)) {
    pushMessage(color.red(formatTurnFailure("${problem}")))
  }
  applyPendingLlmOptions()
  markTurnDone()
  compactIfDue(conversationThread(), ESC_HINT)
  return true
}

/** The footer: the session's title, its spend, and how full its context
  is. */
export def buildStatus(): { left: string; right: string; context: string } {
  return {
    left: sessionTitle(),
    right: "$${totalCost().toFixed(4)}",
    context: contextStatus(conversationThread())
  }
}

/** Hand the REPL's submit its Agency functions. Called from `main` before
  any restore: a resumed process skips the statements a restore replays
  past, and these functions must be the ones this process loaded. */
export def installSessionHooks() {
  _installSessionHooks(dispatch, recordTurn, waitingTarget)
}

/** Runs the REPL. The `-i` prompt from the command line, when there is
  one, is the REPL's first line: it is submitted without being typed, so
  it is saved, and its approvals are, as any line's. Runs inside the
  policy handler `agent.agency` installs. */
export def startInteractive(seedTarget: string, seedPrompt: string, saveHistory: boolean = true) {
  if (seedPrompt != "") {
    renderUserLine(seedPrompt)
    _seedTarget = seedTarget
    _seedWaits = true
    _setReplResubmit(seedPrompt)
  }
  // "" turns the history file off, for an incognito session.
  const historyFile = if saveHistory then HISTORY_PATH else ""
  repl(
    status: buildStatus,
    onSubmit: _sessionOnSubmit,
    prompt: "> ",
    historyFile: historyFile,
    historyMax: 1000,
    herdrName: "agency",
  )
  // A line stopped on an approval no rule decides, and the REPL ended so
  // the run can go back to that approval. The restore replaces this run's
  // state with the one saved there, the REPL starts again, and its first
  // submit picks the line up with the person asked.
  const waiting = _takeCheckpointToRestore()
  if (waiting != null) {
    restore(waiting, {})
  }
  print(color.cyan("\nGoodbye!"))
}
