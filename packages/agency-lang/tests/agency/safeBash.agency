node ghJqHasNoRule() {
  return [
    ghBroad("gh pr view 1 --json title --jq .title"),
    ghBroad("gh pr view 1 --json title --jq=.title"),
    ghBroad("gh pr view 1 --json title -q .title"),
    ghBroad("gh run view 5 --json jobs --jq .jobs"),
    ghBroad("gh run view 5 --json jobs --jq=.jobs"),
    ghBroad("gh run view 5 -wq .jobs"),
    ghBroad("gh run view 5 --json jobs '--jq' '.jobs'"),
    ghBroad("gh run view 5 --json jobs \"--jq=.jobs\""),
    ghBroad("gh run view 5 --json jobs '-q' '.jobs'"),
  ]
}

// A glob is expanded by bash after the plan is made, so a file named
// `--jq=env.GITHUB_TOKEN` in the folder would become that flag. A gh line
// with a glob has no rule, owned subcommand or not.
node ghGlobHasNoRule() {
  return [
    ghBroad("gh run view 5 --json jobs *"),
    ghBroad("gh api rate_limit [-]-jq env.GITHUB_TOKEN"),
    ghBroad("gh run view 5 --json=*"),
    ghBroad("gh pr view 1 *"),
  ]
}

// Every short gh flag must have a long name, or `-Z a --zlong b` would pass
// the one-name-per-flag check. A letter with no long name has no rule.
node ghLongFlagsFailClosed() {
  const plain = ghLongFlags({ plain: ["Z"], values: [], positionals: [] })
  const valued = ghLongFlags({ plain: [], values: [{ flag: "Y", value: "1" }], positionals: [] })
  return [refusalOf(plain), refusalOf(valued)]
}

/** A failure's message, or "ACCEPTED" when the result was a success. */
def refusalOf(result: Result<any>): string {
  if (result is failure(why)) {
    return why
  }
  return "ACCEPTED"
}

/** A plan's outcome, and the program and subcommand of each std::exec. */
def ghExecRow(source: string): any {
  const plan = planFor(source, "/repo")
  const effects: any[] = plan.effects
  return [outcomeOf(plan), [[effect.name, effect.payload.command, effect.payload.subcommand] for effect in effects]]
}

node ghUnownedStaysExec() {
  return [
    ghExecRow("gh pr comment 1 -b hi"),
    ghExecRow("gh run view 5"),
    ghExecRow("gh pr create --fill"),
    ghExecRow("gh -R o/r pr view 1"),
  ]
}

// Three gh lines a coding agent writes to review a pull request.
static const CODER_PR_VIEW = "gh pr view 1451 --repo egonSchiele/agency-lang --json title,body,author,baseRefName,headRefName,state,additions,deletions,changedFiles,files"
static const CODER_PR_DIFF = "gh pr diff 1451 --repo egonSchiele/agency-lang > /tmp/pr1451.diff && wc -l /tmp/pr1451.diff"
static const CODER_COMMITS = "gh pr view 1451 --repo egonSchiele/agency-lang --json commits --jq '.commits[].messageHeadline'"

def effectNames(plan: Plan): string[] {
  return [effect.name for effect in plan.effects]
}

// The first line is narrow. The second is broad because `wc` reads a file
// the line makes, which does not exist when the plan is made; its gh half
// is narrow on its own. Its reason holds a real path, which differs
// between machines, so the row checks that the reason names the file. The
// third uses --jq, which has no rule.
node ghLinesACoderWrites() {
  const diff = planFor(CODER_PR_DIFF, "/repo")
  const diffAlone = planFor("gh pr diff 1451 --repo egonSchiele/agency-lang > /tmp/pr1451.diff", "/repo")
  const reason = diff.broadReason
  let diffReason: any = null
  if (reason != null) {
    diffReason = [reason.kind, reason.detail.includes("pr1451.diff")]
  }
  return [
    ghPlan(CODER_PR_VIEW),
    [outcomeOf(diff), diffReason],
    [outcomeOf(diffAlone), effectNames(diffAlone)],
    ghBroad(CODER_COMMITS),
  ]
}

/** A git repository whose origin is agency-lang on GitHub, and one with no
  remote. Both are made by the tests below and removed after. */
static const GH_ORIGIN_FIXTURE = __dirname + "/stdlib/__safebash_gh_origin__"
static const GH_NO_REMOTE_FIXTURE = __dirname + "/stdlib/__safebash_gh_noremote__"

/** The folder a fake `gh` is written into for a test. */
static const FAKE_GH_DIR = __dirname + "/stdlib/__safebash_fake_gh__"

def makeGhFixtures() {
  remove(GH_ORIGIN_FIXTURE) with approve
  mkdir(GH_ORIGIN_FIXTURE) with approve
  bash("git init -q && git remote add origin https://github.com/egonSchiele/agency-lang.git", cwd: GH_ORIGIN_FIXTURE) with approve
  remove(GH_NO_REMOTE_FIXTURE) with approve
  mkdir(GH_NO_REMOTE_FIXTURE) with approve
  bash("git init -q", cwd: GH_NO_REMOTE_FIXTURE) with approve
}

def removeGhFixtures() {
  remove(GH_ORIGIN_FIXTURE) with approve
  remove(GH_NO_REMOTE_FIXTURE) with approve
}

/** Run `source` through safeBash in `dir`, approved, with a `gh` on the
  search path that is the shell script `script`. Puts PATH back before it
  returns, whether the run succeeded or failed. */
def runWithFakeGh(script: string, source: string, dir: string): any {
  remove(FAKE_GH_DIR) with approve
  mkdir(FAKE_GH_DIR) with approve
  write("gh", "#!/bin/sh\n${script}\n", FAKE_GH_DIR) with approve
  bash("chmod +x gh", cwd: FAKE_GH_DIR) with approve
  const path = env("PATH") with approve
  setEnv("PATH", "${FAKE_GH_DIR}:${path}") with approve
  const result = runNarrow(source, dir)
  setEnv("PATH", path ?? "") with approve
  remove(FAKE_GH_DIR) with approve
  return result
}

// The handler records the question and rejects it, so gh never runs and
// the test needs no network and no gh.
node ghLookupFillsThePair() {
  makeGhFixtures()
  let seen: any[] = []
  handle {
    safeBash("gh pr view 1451", cwd: GH_ORIGIN_FIXTURE)
  } with (intr) {
    seen.push([intr.effect, intr.data.owner, intr.data.repo, intr.data.number])
    return reject()
  }
  removeGhFixtures()
  return seen
}

node ghLookupFailureRaisesNothing() {
  makeGhFixtures()
  let seen: any[] = []
  let failed = ""
  handle {
    const result = safeBash("gh pr view 1451", cwd: GH_NO_REMOTE_FIXTURE)
    if (result is failure(why)) {
      failed = why
    }
  } with (intr) {
    seen.push(intr.effect)
    return reject()
  }
  removeGhFixtures()
  return [seen, failed.includes("--repo OWNER/REPO")]
}

/** A failed run's exit code line, which must be the last line, and the
 note on the line before it when there is one. */
def exitAndNote(failed: string): any {
  const lines = failed.split("\n")
  const at = lines.indexOf("Command exited with code 4")
  if (at == -1 || at != lines.length - 1) {
    return ["NO EXIT 4 LAST LINE", null]
  }
  if (at > 0 && lines[at - 1].startsWith("GitHub CLI is not logged in")) {
    return [4, lines[at - 1]]
  }
  return [4, null]
}

def loginRow(script: string): any {
  const result = runWithFakeGh(script, "gh pr view 1 --repo o/r", STDLIB_TESTS)
  if (result[0] != "failure") {
    return result
  }
  return exitAndNote(result[1])
}

// The exact text of a failed command. The agent's trace reads the status
// line (`safeBashFailure` in lib/stdlib/agentToolTrace.ts), so a change to
// this shape has to change that reader too.
node safeBashFailureText() {
  const result = safeBash("sh -c 'echo out; echo err >&2; exit 3'", cwd: STDLIB_TESTS) with approve
  if (result is failure(why)) {
    return why
  }
  return "NOT A FAILURE"
}

// The coding agent's bash tool passes exitIsFailure: false. A non-zero exit
// then comes back as a result with the same text, and a refusal is still a
// failure.
node exitAsResult() {
  const exited = safeBash("sh -c 'echo out; echo err >&2; exit 3'", cwd: STDLIB_TESTS, exitIsFailure: false) with approve
  const refused = safeBash("sh -c 'exit 3'", cwd: STDLIB_TESTS, exitIsFailure: false) with reject
  return [isSuccess(exited), exited.value, isFailure(refused)]
}

// A line that exits 4 gets the note only when gh printed its login message.
// The last row prints that message from a line with no gh in it, so only
// the check that gh ran keeps the note off.
node ghLoginNote() {
  const plain = safeBash("sh -c 'echo gh auth login >&2; exit 4'", cwd: STDLIB_TESTS) with approve
  let notGh: any = "NOT A FAILURE"
  if (plain is failure(why)) {
    notGh = exitAndNote(why)
  }
  return [
    loginRow("echo 'To get started with GitHub CLI, please run:  gh auth login' >&2; exit 4"),
    loginRow("echo boom >&2; exit 4"),
    notGh,
  ]
}

// The fake gh prints its arguments, one per line. This fails if safeBash
// raises the second plan and runs the first, whose --repo is empty.
node ghRunsWhatItAsked() {
  makeGhFixtures()
  const result = runWithFakeGh("printf '%s\\n' \"$@\"", "gh pr view 1451", GH_ORIGIN_FIXTURE)
  removeGhFixtures()
  return result
}

static const ORIGIN_O_R: GhRepo = { owner: "o", repo: "r" }

node ghApiReads() {
