/** @module Slot registry + dispatch table for model selection. A slot is a
  named purpose a model fills. `SLOT_KIND` keeps slot-specific behavior keyed on
  a CLOSED enum so consumers switch on the kind, not the raw name; adding a slot
  whose semantics match an existing kind is a one-line data edit. Pure. */

export static const SLOTS = ["main", "reasoning", "embedding", "router", "judge", "image"]
export static const SLOT_ALIASES: Record<string, string> = {
  fast: "main",
  slow: "reasoning"
}

export type SlotKind = "fast" | "slow" | "derived"

export static const SLOT_KIND: Record<string, SlotKind> = {
  main: "fast",
  reasoning: "slow",
  embedding: "derived",
  router: "derived",
  judge: "derived",
  image: "derived"
}

/** The model a slot gets when no layer sets it, for the slots that have
  one. It applies only in a hosted session whose environment has the
  provider's key: startup checks the key once (`defaultSlots` in
  shared.agency) and keeps the rows that pass. The judge has no default on
  purpose: it sends shell command lines to its provider, so the user picks
  the provider. The image slot has none here because `generateImage` has
  its own: an empty slot sends no model, and the default applies. */
export static const SLOT_DEFAULTS: Record<string, string> = {
  router: "openrouter/jev-1.14"
}

/** The value that empties a slot: it turns off a slot's default, or
  clears a model a lower layer set, such as one in settings.model. */
export static const SLOT_OFF = "off"

/** Slots with no default that `off` can still empty. Without it, a
  remembered `/model image=...` choice could never be taken back. */
static const OFF_WITHOUT_DEFAULT = ["judge", "image"]

/** True when `off` means something in the slot. */
export def slotCanBeOff(name: string): boolean {
  const slot = canonicalSlot(name)
  return SLOT_DEFAULTS[slot] != null || OFF_WITHOUT_DEFAULT.includes(slot)
}

/** The providers smoltalk's decide() answers through. The router and
  judge slots take only these. */
export static const DECISION_PROVIDERS: string[] = ["typesafe", "laya", "openai", "openrouter", "llama-cpp"]

/** The providers smoltalk's image() answers through. The image slot
  takes only these. */
export static const IMAGE_PROVIDERS: string[] = ["openai", "google", "litellm", "openai-compat"]

/** Slots whose value may name only these providers. Every other slot
  takes the chat providers (`knownProviders()` in models.agency). Kept
  apart so `typesafe` and `laya` never reach a chat slot. */
static const SLOT_PROVIDERS: Record<string, string[]> = {
  router: DECISION_PROVIDERS,
  judge: DECISION_PROVIDERS,
  image: IMAGE_PROVIDERS
}

/** A derived slot points away from the chat model, so its value must name
  its provider. What a message calls the slot, and the form it shows. */
static const PROVIDER_FORM: Record<string, { title: string; example: string }> = {
  embedding: {
    title: "Embedding",
    example: "openai/text-embedding-3-small"
  },
  router: {
    title: "Router",
    example: "openrouter/jev-1.14"
  },
  judge: {
    title: "Judge",
    example: "openrouter/jev-1.14"
  },
  image: {
    title: "Image",
    example: "openai/gpt-image-1"
  }
}

export def canonicalSlot(name: string): string {
  if (SLOT_ALIASES[name] != null) {
    return SLOT_ALIASES[name]
  }
  return name
}

export def isKnownSlot(name: string): boolean {
  return SLOTS.includes(canonicalSlot(name))
}

export def slotKind(name: string): SlotKind {
  return SLOT_KIND[canonicalSlot(name)]
}

/** The providers a value in this slot may name. */
export def providersFor(name: string, chatProviders: string[]): string[] {
  return SLOT_PROVIDERS[canonicalSlot(name)] ?? chatProviders
}

/** The providers this slot is limited to, or [] when it takes any chat
  provider. */
export def onlyProvidersFor(name: string): string[] {
  return SLOT_PROVIDERS[canonicalSlot(name)] ?? []
}

/** True when the slot's value must be in the provider/model form. The
  PROVIDER_FORM table decides, so a slot that needs the form always has
  the message text for it. */
export def needsProviderForm(name: string): boolean {
  return PROVIDER_FORM[canonicalSlot(name)] != null
}

/** True for a slot a chat model fills: not a derived slot. */
export def isChatSlot(name: string): boolean {
  return slotKind(name) != "derived"
}

/** How a message names the slot ("Embedding"), and an example value in
  the provider/model form. Only for a slot that needs the form. */
export def providerFormTitle(name: string): string {
  return PROVIDER_FORM[canonicalSlot(name)].title
}

export def providerFormExample(name: string): string {
  return PROVIDER_FORM[canonicalSlot(name)].example
}

/** The slots an llmOptions block reaches: the chat slots. A derived slot
  calls no chat model, so a router on another provider than the main
  model is no reason to warn about options a provider may reject. */
export def chatSlots(names: string[]): string[] {
  return [name for name in names if isChatSlot(name)]
}
