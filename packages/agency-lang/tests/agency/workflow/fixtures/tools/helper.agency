/** A helper that a tool module imports, so a test can describe a module
  whose imports are local files. */
export def shout(text: string): string {
  """
  Return the text in capitals, with an exclamation mark.

  @param text - The text to shout
  """
  return "${text.toUpperCase()}!"
}

/** What `Outer` holds. A module that imports `Outer` never names this. */
export type Inner = {
  count: number
}

/** A type whose body names another alias of this module. */
export type Outer = {
  inner: Inner
}
