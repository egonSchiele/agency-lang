import { middleHello, open } from "./middle.agency"

// `middleHello` reads a static in words.agency two calls away, so the
// compiler adds no edge to it: only the order a resume visits modules
// in sets it in time. `open` reads a global in config.agency two calls
// away. `bracket` is a function in this module.
static const GREETING = bracket(middleHello())

def bracket(word: string): string {
  return "${open()}${word}>"
}

export def greet(name: string): string {
  return "${GREETING}, ${name}"
}
