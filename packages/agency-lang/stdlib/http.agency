import {
  _cachedFetch,
  _fetch,
  _fetchJSON,
  _fetchMarkdown,
  _fetchTarget,
} from "agency-lang/stdlib-lib/http.js"

/** @module
  @summary Fetch web content as text, JSON, or Markdown.
  Fetch URLs from Agency code. Returns the response as text, JSON, or Markdown.
  Aborting tears down the in-flight request. A request that has not finished
  in 30 seconds, headers and body together, fails with a message naming the
  URL and the limit; `timeout` raises the limit per call, and `0` removes it.

  When a model calls one of these as a tool, a GET with no body or headers
  of a URL the same conversation already fetched is not fetched again: the
  tool returns what the first fetch returned, and `refresh: true` fetches
  anyway.
  Direct calls from Agency code always make a request.

  ```ts
  import { fetch, fetchJSON } from "std::http"

  node main() {
    const page = fetch("https://example.com")
    const data = fetchJSON("https://api.example.com/status")
    print(page)
  }
  ```
*/

@always(method, baseUrl)
effect std::http::fetch { baseUrl: string, path: string, method: string, scheme: string, network: string }
@always(method, baseUrl)
effect std::http::fetchJSON { baseUrl: string, path: string, method: string, scheme: string, network: string }
@always(method, baseUrl)
effect std::http::fetchMarkdown { baseUrl: string, path: string, method: string, scheme: string, network: string }

/** An HTTP request method. POST/PUT/PATCH/DELETE may carry a body; GET/HEAD do not. */
export type HttpMethod = "GET" | "HEAD" | "POST" | "PUT" | "PATCH" | "DELETE"

/**
  On abort, Agency tears down the in-flight HTTP request and body read. The
  abort surfaces as an AgencyCancelledError that propagates out of the
  surrounding `try`.
*/
@capabilities(network)
export def fetch(
  baseUrl | url: string,
  path: string = "",
  headers: Record<string, any> = {},
  allowedDomains: string[] = [],
  method: HttpMethod = "GET",
  body: Record<string, any> | string | null = null,
  timeout: number = 30000,
  refresh: boolean = false,
): Result {
  """
  Fetch a URL as text.

  @param path - Optional path appended to baseUrl.
  @param allowedDomains - Allowed destination domains, or empty for no restriction.
  @param body - Text sent as-is, or an object sent as JSON.
  @param timeout - Whole-request time limit in milliseconds, or zero for no limit.
  @param refresh - Refetch a repeated GET that would otherwise reuse the conversation's cached response.
  """
  // A GET this conversation already made returns the stored result,
  // before any interrupt: nothing is fetched, so there is nothing to approve.
  const cached = _cachedFetch(baseUrl, path, method, body, headers, refresh, "fetch")
  if (cached != null) {
    return success(cached.value)
  }
  // Where the request goes, as words a policy rule can match: the scheme,
  // and whether the host is public or on this machine or its network.
  const target = _fetchTarget(baseUrl, path)
  return interrupt std::http::fetch("Allow a ${method} request to this URL?", {
    baseUrl: baseUrl,
    path: path,
    method: method,
    scheme: target.scheme,
    network: target.network
  })
  return try _fetch(baseUrl, path, headers, allowedDomains, method, body, timeout)
}

/**
  On abort, Agency tears down the in-flight HTTP request and body read. The
  abort surfaces as an AgencyCancelledError that propagates out of the
  surrounding `try`.
*/
@capabilities(network)
export def fetchJSON(
  baseUrl | url: string,
  path: string = "",
  headers: Record<string, any> = {},
  allowedDomains: string[] = [],
  method: HttpMethod = "GET",
  body: Record<string, any> | string | null = null,
  timeout: number = 30000,
  refresh: boolean = false,
): Result {
  """
  Fetch a URL and parse the response as JSON.

  @param path - Optional path appended to baseUrl.
  @param allowedDomains - Allowed destination domains, or empty for no restriction.
  @param body - Text sent as-is, or an object sent as JSON.
  @param timeout - Whole-request time limit in milliseconds, or zero for no limit.
  @param refresh - Refetch a repeated GET that would otherwise reuse the conversation's cached response.
  """
  // A GET this conversation already made returns the stored result,
  // before any interrupt: nothing is fetched, so there is nothing to approve.
  const cached = _cachedFetch(baseUrl, path, method, body, headers, refresh, "fetchJSON")
  if (cached != null) {
    return success(cached.value)
  }
  // Where the request goes, as words a policy rule can match: the scheme,
  // and whether the host is public or on this machine or its network.
  const target = _fetchTarget(baseUrl, path)
  return interrupt std::http::fetchJSON("Allow a ${method} request to this URL and parse the response as JSON?", {
    baseUrl: baseUrl,
    path: path,
    method: method,
    scheme: target.scheme,
    network: target.network
  })
  return try _fetchJSON(baseUrl, path, headers, allowedDomains, method, body, timeout)
}

/**
  On abort, Agency tears down the in-flight HTTP request and body read. The
  abort surfaces as an AgencyCancelledError that propagates out of the
  surrounding `try`.
*/
@capabilities(network)
export def fetchMarkdown(
  baseUrl | url: string,
  path: string = "",
  headers: Record<string, any> = {},
  allowedDomains: string[] = [],
  method: HttpMethod = "GET",
  body: Record<string, any> | string | null = null,
  timeout: number = 30000,
  refresh: boolean = false,
): Result {
  """
  Fetch a web page as readable Markdown for an LLM, or plain text for non-HTML responses.

  @param path - Optional path appended to baseUrl.
  @param allowedDomains - Allowed destination domains, or empty for no restriction.
  @param body - Text sent as-is, or an object sent as JSON.
  @param timeout - Whole-request time limit in milliseconds, or zero for no limit.
  @param refresh - Refetch a repeated GET that would otherwise reuse the conversation's cached response.
  """
  // A GET this conversation already made returns the stored result,
  // before any interrupt: nothing is fetched, so there is nothing to approve.
  const cached = _cachedFetch(baseUrl, path, method, body, headers, refresh, "fetchMarkdown")
  if (cached != null) {
    return success(cached.value)
  }
  // Where the request goes, as words a policy rule can match: the scheme,
  // and whether the host is public or on this machine or its network.
  const target = _fetchTarget(baseUrl, path)
  return interrupt std::http::fetchMarkdown("Allow a ${method} request to this URL?", {
    baseUrl: baseUrl,
    path: path,
    method: method,
    scheme: target.scheme,
    network: target.network
  })
  return try _fetchMarkdown(baseUrl, path, headers, allowedDomains, method, body, timeout)
}
