    planKind("type agency"),
    planKind("command -v agency"),
    planKind("command agency test x.test.json"),
    planKind("command echo agency"),
    planKind("which git agency"),
    planKind("agency test $f"),
    planKind("agency test x.test.json > out"),
    planKind("ls agency-lang"),
    planKind("which git"),
