// A resume can replace a paused function's arguments. An overridden `!`
// argument is checked before the body sees it, the same as a fresh call.

import { getMutable, setMutable } from "../../helpers/mutableVar.js"

def messageOf(result: any): string {
  if (isFailure(result)) {
    return result.error
  }
  return "no failure"
}

// On its first run, takes a checkpoint and restores it with new arguments.
def plan(spec: { type: "daily" }!, note: string): Result<{ spec: { type: "daily" }, note: string }> {
  const cp = checkpoint()
  if (getMutable("planRestores", 0) == 0) {
    setMutable("planRestores", 1)
    restore(cp, { args: { spec: { type: "daily", extra: 1 }, note: "second" } })
  }
  setMutable("planBodyRan", true)
  return success({ spec: spec, note: note })
}

node validOverride() {
  setMutable("planRestores", 0)
  const result = plan({ type: "daily" }, "first")
  return result.value
}

def planBadly(spec: { type: "daily" }!): Result<{ type: "daily" }> {
  const cp = checkpoint()
  if (getMutable("badRestores", 0) == 0) {
    setMutable("badRestores", 1)
    restore(cp, { args: { spec: "nope" } })
  }
  setMutable("badBodyRan", true)
  return success(spec)
}

node invalidOverride() {
  setMutable("badRestores", 0)
  setMutable("badBodyRan", false)
  const result = planBadly({ type: "daily" })
  return [getMutable("badBodyRan", false), messageOf(result)]
}
