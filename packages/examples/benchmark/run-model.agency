/**
 * Benchmark one model across different kinds of LLM work: raw speed,
 * structured output, tool use, reasoning, instruction following, memory
 * across turns, long-context retrieval, and classification. The results go
 * to one JSON file. `compare.agency` reads several of those files and prints
 * them side by side, and `run-all.sh` runs this script once per model and
 * then runs the comparison.
 *
 * This script never names a model. Agency's own flags choose it, so the
 * same script works for hosted models and local ones:
 *
 *   agency run --model claude-sonnet-5 run-model.agency --label claude-sonnet-5
 *   agency run --local qwen3.5-2b run-model.agency --label qwen3.5-2b
 *
 * Agency's flags go before the filename, and this script's flags go after it.
 *
 * Every case is graded by plain code, not by another model, so a run only
 * pays for calls to the model under test.
 */
import { parseArgs } from "std::args"
import { now, format } from "std::date"
import { getCost, getTokens, getModelCosts } from "std::thread"
import { setLlmOptions } from "std::llm"
import { exec, which } from "std::shell"

type CaseInfo = {
  name: string,
  category: string,
  description: string
}

// A case asks one or more questions in one or more calls and scores itself
// from 0 to 1, so a case with several questions is graded as a fraction. The
// "stress" category is left out of "all": it holds the cases that make a
// small model loop, which measure the runtime's limits more than the model.
const ALL_CASES: CaseInfo[] = [
  { name: "latency", category: "speed", description: "Answer a trivial prompt with one word" },
  { name: "throughput", category: "speed", description: "Write a 400-word story" },
  { name: "extract", category: "structured", description: "Pull invoice fields out of two messy emails" },
  { name: "toolChain", category: "tools", description: "Chain three tools, recovering from one error, ignoring three distractors" },
  { name: "trustTool", category: "tools", description: "Call a tool three times and trust it over common sense" },
  { name: "reasoning", category: "reasoning", description: "Three short problems, each with a trap" },
  { name: "format", category: "instructions", description: "List exactly four fruits in a strict format" },
  { name: "needle", category: "context", description: "Find one line hidden in a long log" },
  { name: "classify", category: "classification", description: "Label six reviews, including sarcasm" },
  { name: "faithfulness", category: "faithfulness", description: "Answer from a document, and admit what it does not say" },
  { name: "lipogram", category: "stress", description: "Rewrite a sentence without the letter e. Run it with --cases stress" }
]

/** A case's own verdict: a score from 0 to 1, and what the model said. A
 *  non-empty `error` means the case could not be graded at all. */
type CaseOutcome = {
  score: number,
  detail: string,
  error: string
}

type CaseResult = {
  caseName: string,
  category: string,
  trial: number,
  passed: boolean,
  score: number,
  latencyMs: number,
  tokens: number,
  // The tokens the model wrote, thinking included. Divided by the time,
  // this is the model's speed, which the total token count is not: a long
  // prompt makes `tokens` large and says nothing about how fast the model
  // writes.
  outputTokens: number,
  cost: number,
  detail: string,
  error: string,
  // Why the provider ended a reply early, such as "refusal" or "length",
  // when one did. Empty when every reply in the case ended normally.
  stopReason: string
}

/** The shape of the JSON file this script writes, and compare.agency reads. */
type RunFile = {
  label: string,
  model: string,
  // The machine the run was made on, so files from different machines can
  // be told apart: the chip, the memory, and the operating system.
  machine: string,
  // A short name for the machine, given with --machine-label, for column
  // headings and file names. Empty when none was given.
  machineLabel: string,
  settings: RunSettings,
  startedAt: string,
  trials: number,
  haystackLines: number,
  results: CaseResult[]
}

/** The choices that change what a run measures, recorded so two runs can be
 *  compared knowing what differed. The draft model and the prefill step are
 *  the server's settings for an MLX model, so the run is told them with
 *  flags; it cannot read them from the server. */
type RunSettings = {
  // "hosted", "mlx", or "llama-cpp".
  backend: string,
  // The thinking policy: auto, on, off, or default.
  thinking: string,
  thinkingBudget: number,
  // 0 when the provider's default applied.
  maxTokens: number,
  // Seconds; 0 when the runtime's default applied.
  timeout: number,
  // The draft model for speculative decoding, or "" for none.
  draft: string,
  // Tokens of prompt read per pass on the MLX server; 0 when its default applied.
  prefillStep: number
}

// The model the run's calls actually went to, as the runtime reports it.
// It is saved next to the label, so a result file says which model made it
// even when the label is a nickname.
let seenModel: string = ""

// The reasons the provider gave for ending a reply early during the current
// case: "content_filter" when it refused, "length" when the reply hit the
// token cap. A reply that ended normally, or to call a tool, adds nothing.
// A case that ends this way is recorded as an error, not a wrong answer:
// the model never got to answer.
let earlyStops: string[] = []

callback("onLLMCallEnd") as data {
  seenModel = "${data.model}"
  const reason = data.result.stopReason
  if (reason != null && reason != "stop" && reason != "tool_use" && reason != "stop_sequence") {
    // The provider's own word for it when there is one: "refusal" says
    // more than "content_filter".
    const raw = data.result.rawStopReason
    let word = "${reason}"
    if (raw != null && raw != "") {
      word = "${raw}"
    }
    earlyStops.push(word)
  }
}

// ---------------------------------------------------------------------------
// Small helpers
// ---------------------------------------------------------------------------

def scoreOf(ok: boolean): number {
  return if ok then 1 else 0
}

def outcome(score: number, detail: string): CaseOutcome {
  return { score: score, detail: detail, error: "" }
}

// Agency's message for a reply that does not fit the type starts with a long
// schema report and ends with the reply itself. The reply is the part worth
// reading, so it is moved to the front. The marker is the wording of that
// message in lib/runtime/llmRetry.ts; if the wording changes and the marker
// is not found, the whole message is kept as is.
def errored(message: string): CaseOutcome {
  const marker = "Raw output (first 200 chars): "
  const at = message.indexOf(marker)
  if (at >= 0) {
    return { score: 0, detail: "", error: "reply did not fit the type. The model sent: " + message.slice(at + marker.length) }
  }
  return { score: 0, detail: "", error: message }
}

def wordCount(text: string): number {
  const words = filter(text.trim().split(" ")) as w { return w != "" }
  return words.length
}

def hasAnyChar(text: string, chars: string): boolean {
  for (c in chars.split("")) {
    if (text.includes(c)) {
      return true
    }
  }
  return false
}

def oneLine(text: string, limit: number = 70): string {
  const flat = text.split("\n").join(" ").trim()
  if (flat.length <= limit) {
    return flat
  }
  return flat.slice(0, limit) + "…"
}

def seconds(ms: number): string {
  const s = ms / 1000
  return s.toFixed(1) + "s"
}

def splitList(text: string): string[] {
  const trimmed = map(text.split(",")) as s { return s.trim() }
  return filter(trimmed) as s { return s != "" }
}

// "mlx-community/Qwen3.8-27B-4bit" becomes "mlx-community_Qwen3.8-27B-4bit".
def fileSafe(name: string): string {
  return name.split("/").join("_").split(":").join("_")
}

// ---------------------------------------------------------------------------
// Tools. The data is made up on purpose: a model can only answer correctly
// if it actually called the tool and read the result.
// ---------------------------------------------------------------------------

def getOrderStatus(orderId: string): string {
  """
  Look up the shipping status of an order.

  @param orderId - The order number
  """
  if (orderId.includes("4471")) {
    return "Order 4471: shipped 2026-02-02 via Parcelway, tracking number ZX-9321-Q"
  }
  return "No order found with id ${orderId}"
}

def lookupCustomer(email: string): string {
  """
  Find a customer's id from their email address.

  @param email - The customer's email address
  """
  if (email.toLowerCase() == "jreyes@example.com") {
    return "Customer id C-5530 (Jordan Reyes)"
  }
  return "No customer with email ${email}"
}

// How many times getBalance has been called in the current case. The first
// call in the tool-chain case fails, so the model has to try again.
let balanceCalls = 0

def getBalance(customerId: string): string {
  """
  Get the outstanding balance on a customer's account.

  @param customerId - The customer id, such as C-1234
  """
  balanceCalls = balanceCalls + 1
  if (balanceCalls == 1) {
    return "Error: the accounts service timed out. Try again."
  }
  if (customerId.includes("5530")) {
    return "Balance for C-5530: $2,718.40, overdue since 2026-01-15"
  }
  return "No account for ${customerId}"
}

def getTemperature(city: string): string {
  """
  Get the current temperature in a city, in degrees Celsius.

  @param city - The city name
  """
  const name = city.toLowerCase()
  if (name.includes("oslo")) {
    return "Oslo: 23°C"
  }
  if (name.includes("lisbon")) {
    return "Lisbon: 12°C"
  }
  if (name.includes("cairo")) {
    return "Cairo: 9°C"
  }
  return "No weather data for ${city}"
}

def convertCurrency(amount: number, from: string, to: string): string {
  """
  Convert an amount of money between two currencies.

  @param amount - The amount to convert
  @param from - The three-letter currency code to convert from
  @param to - The three-letter currency code to convert to
  """
  return "${amount} ${from} is about ${amount * 0.92} ${to}"
}

// ---------------------------------------------------------------------------
// Speed
// ---------------------------------------------------------------------------

def caseLatency(): CaseOutcome {
  const answer: string = llm("Reply with only the word OK.")
  const cleaned = answer.trim().toLowerCase().split(".").join("")
  return outcome(scoreOf(cleaned == "ok"), answer)
}

// compare.agency turns this case's tokens and time into tokens per second.
def caseThroughput(): CaseOutcome {
  const story: string = llm("Write a 400-word short story about a lighthouse keeper who finds a message in a bottle. Output only the story.")
  const words = wordCount(story)
  return outcome(scoreOf(words >= 250), "${words} words")
}

// ---------------------------------------------------------------------------
// Structured output. Each of these cases asks for `T!`, so a reply that does
// not fit the type comes back as a failure. The case records the failure's
// message as its error, and that message quotes the model's raw reply.
// ---------------------------------------------------------------------------

type Invoice = {
  vendor: string,
  invoiceNumber: string,
  @jsonSchema({ description: "the total amount due, in dollars" })
  total: number,
  @jsonSchema({ description: "the payment due date, as YYYY-MM-DD" })
  dueDate: string
}

const INVOICE_EMAIL = """
hey team, forwarding this from accounts. Invoice #INV-20931 from Bluefin Logistics LLC.
Line items: freight $1,240.00, fuel surcharge $86.50, handling $45.
Please pay by March 14, 2026. (Ignore the old quote of $900, that was before the surcharge.)
"""

// Twelve chairs at $190 is $2,280, plus the tax is $2,462.40. The January
// quote is a trap.
const INVOICE_EMAIL_2 = """
Subject: Re: Re: PO 8812
Northwind Traders Inc. sent their invoice NT-8812 for the office chairs: 12 chairs at $190 each,
so $2,280, plus $182.40 sales tax. They want it paid by the 30th of April 2026.
(Their quote in January said $2,100, but that was for 11 chairs.)
"""

type ExpectedInvoice = {
  vendor: string,
  invoiceNumber: string,
  total: number,
  dueDate: string
}

// How many of the four fields came back right, and what came back.
def gradeInvoice(email: string, expected: ExpectedInvoice): { right: number, detail: string } {
  const reply: Invoice! = llm("Extract the invoice details from this email:\n${email}")
  if (isFailure(reply)) {
    return { right: 0, detail: "no reply: ${oneLine(reply.error, 40)}" }
  }
  const invoice = reply.value
  let right = 0
  if (invoice.vendor.toLowerCase().includes(expected.vendor)) {
    right = right + 1
  }
  if (invoice.invoiceNumber.includes(expected.invoiceNumber)) {
    right = right + 1
  }
  if (Math.abs(invoice.total - expected.total) < 0.01) {
    right = right + 1
  }
  if (invoice.dueDate == expected.dueDate) {
    right = right + 1
  }
  return { right: right, detail: "${invoice.vendor} | ${invoice.invoiceNumber} | ${invoice.total} | ${invoice.dueDate}" }
}

// Two emails, four fields each, so the score is eighths. Each email is its
// own call on a fresh thread.
def caseExtract(): CaseOutcome {
  let first: any = null
  thread {
    first = gradeInvoice(INVOICE_EMAIL, { vendor: "bluefin", invoiceNumber: "20931", total: 1371.5, dueDate: "2026-03-14" })
  }
  let second: any = null
  thread {
    second = gradeInvoice(INVOICE_EMAIL_2, { vendor: "northwind", invoiceNumber: "8812", total: 2462.4, dueDate: "2026-04-30" })
  }
  return outcome((first.right + second.right) / 8, "${first.detail} || ${second.detail}")
}

// ---------------------------------------------------------------------------
// Tool use
// ---------------------------------------------------------------------------

// Four tool calls in a row, each needing the last one's result: the email
// gives the id, the balance fails once and then gives the dollars, and the
// conversion gives the euros. $2,718.40 at the tool's rate is 2500.928
// euros. Three of the five tools are distractors.
def caseToolChain(): CaseOutcome {
  balanceCalls = 0
  const answer: string = llm("How much does the customer with the email jreyes@example.com owe us, in euros?", {
    tools: [getOrderStatus, lookupCustomer, getBalance, getTemperature, convertCurrency]
  })
  const digits = answer.split(",").join("")
  const ok = digits.includes("2500") || digits.includes("2501")
  return outcome(scoreOf(ok), answer)
}

// The tool's numbers contradict what the model knows about these cities. A
// model that answers "Cairo" skipped the tool or ignored it.
def caseTrustTool(): CaseOutcome {
  const answer: string = llm("Using the temperature tool, which of Oslo, Lisbon, and Cairo is the warmest right now? Answer with just the city name.", {
    tools: [getTemperature]
  })
  const name = answer.toLowerCase()
  const ok = name.includes("oslo") && !name.includes("cairo") && !name.includes("lisbon")
  return outcome(scoreOf(ok), answer)
}

// ---------------------------------------------------------------------------
// Reasoning
// ---------------------------------------------------------------------------

type NumberAnswer = {
  @jsonSchema({ description: "your working, step by step" })
  reasoning: string,
  answer: number
}

type NameAnswer = {
  @jsonSchema({ description: "your working, step by step" })
  reasoning: string,
  name: string
}

// Three boxes plus two singles costs $51. Four boxes costs $60, and twenty
// singles costs $60. So the answer is 51.
const MUFFINS = "A bakery sells muffins for $3 each, or in boxes of 6 for $15. Sam needs at least 20 muffins and wants to spend as little as possible. How many dollars does Sam spend?"

// $24 is 80% of the original price, so the original was $30. The trap is to
// add 20% to $24 and get $28.80.
const JACKET = "A jacket costs $24 after a 20% discount. What was the price before the discount, in dollars?"

// Ben can only have the fish, Dee has the parrot, Ana has no dog, so Cy does.
const PUZZLE = """
Ana, Ben, Cy, and Dee each own exactly one pet: a cat, a dog, a fish, or a parrot.
No two people own the same kind of pet.
1. Ben is allergic to both fur and feathers.
2. Dee's pet can fly.
3. Ana does not own the dog.
Who owns the dog?
"""

// A number problem's answer, or null when the reply did not fit the type.
def askNumber(question: string): number | null {
  const reply: NumberAnswer! = llm(question)
  if (isFailure(reply)) {
    return null
  }
  return reply.value.answer
}

// Three problems, each its own call on a fresh thread, so the score is
// thirds. A reply that does not fit the type counts as wrong.
def caseReasoning(): CaseOutcome {
  let muffins: number | null = null
  thread {
    muffins = askNumber(MUFFINS)
  }
  let jacket: number | null = null
  thread {
    jacket = askNumber(JACKET)
  }
  let who = ""
  thread {
    const reply: NameAnswer! = llm(PUZZLE)
    if (!isFailure(reply)) {
      who = reply.value.name
    }
  }
  let right = 0
  if (muffins == 51) {
    right = right + 1
  }
  if (jacket == 30) {
    right = right + 1
  }
  if (who.toLowerCase().includes("cy")) {
    right = right + 1
  }
  return outcome(right / 3, "${muffins} | ${jacket} | ${who}")
}

// ---------------------------------------------------------------------------
// Instruction following
// ---------------------------------------------------------------------------

def caseFormat(): CaseOutcome {
  const answer: string = llm("List exactly 4 fruits. Put each fruit on its own line, all lowercase, with no numbering, bullets, punctuation, or any other text.")
  const lines = filter(answer.trim().split("\n")) as l { return l.trim() != "" }
  const clean = every(lines) as l { return l == l.toLowerCase() && !hasAnyChar(l, "-*.,:;0123456789") }
  return outcome(scoreOf(lines.length == 4 && clean), lines.join(" / "))
}

// Models see tokens, not letters, so this is hard for most of them.
def caseLipogram(): CaseOutcome {
  const answer: string = llm("Rewrite this sentence without using the letter e anywhere, in upper or lower case. Keep the meaning. Output only the new sentence.\n\nThe weather was terrible yesterday, so we stayed inside and read books.")
  const ok = !answer.toLowerCase().includes("e") && wordCount(answer) >= 6
  return outcome(scoreOf(ok), answer)
}

// ---------------------------------------------------------------------------
// Context
// ---------------------------------------------------------------------------

def buildHaystack(lines: number): string {
  let parts: string[] = []
  const needleAt = Math.floor(lines * 0.7)
  for (i in range(lines)) {
    if (i == needleAt) {
      parts.push("Log ${i}: NOTE, the night shift channel was renamed to violet-kettle-42.")
    } else {
      parts.push("Log ${i}: the night shift at dock ${i} counted the crates and signed off.")
    }
  }
  return parts.join("\n")
}

// Providers cache long prompts: when a request starts with the same text as
// a recent one, they skip re-reading it, so it comes back faster and costs
// less. This prompt would be identical in every trial, so trials 2 and 3
// would measure the cache instead of the model. Starting it with the current
// time makes every prompt differ from the first line. The time also differs
// between separate benchmark runs, so a rerun cannot hit the cache either.
def caseNeedle(lines: number): CaseOutcome {
  const haystack = buildHaystack(lines)
  const answer: string = llm("Log file exported at ${now()}:\n\n${haystack}\n\nWhat was the night shift channel renamed to? Reply with just the new name.")
  return outcome(scoreOf(answer.includes("violet-kettle-42")), answer)
}

// ---------------------------------------------------------------------------
// Classification
// ---------------------------------------------------------------------------

type Sentiment = "positive" | "negative" | "neutral"

type Sentiments = {
  @jsonSchema({ description: "one label per review, in the same order as the reviews" })
  labels: Sentiment[]
}

const REVIEWS = """
1. Arrived two days early and works perfectly.
2. Oh great, another charger that dies after a week.
3. It's a phone case. It fits the phone.
4. I wanted to hate it, but honestly it's the best thing I bought this year.
5. Not bad, not great. Does the job.
6. Customer service never answered any of my three emails.
"""

const EXPECTED_SENTIMENTS: Sentiment[] = ["positive", "negative", "neutral", "positive", "neutral", "negative"]

def caseClassify(): CaseOutcome {
  const reply: Sentiments! = llm("Label the sentiment of each review as positive, negative, or neutral.\n${REVIEWS}")
  if (isFailure(reply)) {
    return errored(reply.error)
  }
  const labels = reply.value.labels
  let right = 0
  for (expected, i in EXPECTED_SENTIMENTS) {
    if (i < labels.length && labels[i] == expected) {
      right = right + 1
    }
  }
  return outcome(right / EXPECTED_SENTIMENTS.length, labels.join(", "))
}

// ---------------------------------------------------------------------------
// Faithfulness
// ---------------------------------------------------------------------------

type Lookup = {
  @jsonSchema({ description: "whether the document answers the question" })
  found: boolean,
  @jsonSchema({ description: "the answer, taken from the document; an empty string when the document does not say" })
  answer: string
}

type Lookups = {
  @jsonSchema({ description: "one entry per question, in the same order as the questions" })
  answers: Lookup[]
}

const MEMO = """
Facilities memo, 3 March. The Elm Street office closes for repainting from Monday 9 March
to Wednesday 11 March. Staff should work from the Harbour Road office or from home on those
days. The Harbour Road car park has 40 spaces, and badge access works at both sites. The
kitchen at Elm Street will be restocked when it reopens.
"""

const MEMO_QUESTIONS = """
1. How many spaces does the Harbour Road car park have?
2. Which company is doing the repainting?
3. On which dates is the Elm Street office closed?
4. How much will the repainting cost?
"""

// Two questions the memo answers and two it does not, so a model that
// always says "not in the document" scores a half, and so does one that
// always makes something up. The score is quarters.
def caseFaithfulness(): CaseOutcome {
  const reply: Lookups! = llm("Answer each question from this memo alone. When the memo does not say, say so.\n\nMemo:\n${MEMO}\nQuestions:\n${MEMO_QUESTIONS}")
  if (isFailure(reply)) {
    return errored(reply.error)
  }
  const answers = reply.value.answers
  const expected = [
    { found: true, contains: "40" },
    { found: false, contains: "" },
    { found: true, contains: "11" },
    { found: false, contains: "" }
  ]
  let right = 0
  for (want, i in expected) {
    if (i >= answers.length) {
      continue
    }
    const got = answers[i]
    if (want.found && got.found && got.answer.includes(want.contains)) {
      right = right + 1
    }
    if (!want.found && !got.found) {
      right = right + 1
    }
  }
  const shown = map(answers) as a { return if a.found then a.answer else "(not in memo)" }
  return outcome(right / expected.length, shown.join(" | "))
}

// ---------------------------------------------------------------------------
// Running
// ---------------------------------------------------------------------------

def unknownCase(name: string): CaseOutcome {
  return outcome(0, "unknown case ${name}")
}

def runOne(caseName: string, haystackLines: number): CaseOutcome {
  return match(caseName) {
    "latency" => caseLatency()
    "throughput" => caseThroughput()
    "extract" => caseExtract()
    "toolChain" => caseToolChain()
    "trustTool" => caseTrustTool()
    "reasoning" => caseReasoning()
    "format" => caseFormat()
    "needle" => caseNeedle(haystackLines)
    "classify" => caseClassify()
    "faithfulness" => caseFaithfulness()
    "lipogram" => caseLipogram()
    _ => unknownCase(caseName)
  }
}

// ---------------------------------------------------------------------------
// Thinking policy
// ---------------------------------------------------------------------------

// Every model gets the same thinking policy, so the comparison is fair. A
// hosted provider's default differs from the next one's: Anthropic models do
// not think unless asked, OpenAI reasoning models always do, and local
// thinking models think until told to stop. The policy: no thinking on the
// cases that do not need it, and thinking with one budget on the two
// reasoning cases. Two providers do not follow the off switch: OpenAI's
// reasoning models always think, at their default effort, and Gemini keeps
// its own default, because the Google client only sends a thinking setting
// when thinking is on. The comparison's settings table shows the policy
// asked for, not what each provider did with it.
const REASONING_CASES = ["reasoning"]

// How each model is told about thinking. "auto" is the policy above; "off"
// and "on" apply one setting to every case; "default" leaves each model to
// its own default, which is what the runs before this policy measured.
// The reasoning case asks for written working in its reply type, so a
// model shows its steps there whether or not it thinks first.
let thinkingMode = "auto"
let thinkingBudget = 4096

// Tokens kept for the answer above the thinking budget. A provider that
// budgets thinking (Anthropic's older models, for one) refuses a call whose
// cap is not above its budget, and a cap the budget fills leaves the model
// nothing to answer with.
const ANSWER_ROOM = 4096

// The cap on output tokens for the run: the flag, raised when a thinking
// case's budget would fill it. 0 leaves the provider's default in place,
// except on a run that thinks, where the budget needs a cap above it.
def maxTokensFor(flag: number): number {
  const thinks = thinkingMode == "on" || thinkingMode == "auto"
  if (!thinks) {
    return flag
  }
  if (flag > 0 && flag > thinkingBudget) {
    return flag
  }
  const raised = thinkingBudget + ANSWER_ROOM
  if (flag > 0) {
    print("--max-tokens ${flag} is not above the thinking budget of ${thinkingBudget}; using ${raised}")
  }
  return raised
}

def thinkingFor(caseName: string): void {
  if (thinkingMode == "default") {
    return
  }
  const on = thinkingMode == "on" || (thinkingMode == "auto" && REASONING_CASES.includes(caseName))
  if (on) {
    setLlmOptions({ thinking: { enabled: true, budgetTokens: thinkingBudget } })
  } else {
    setLlmOptions({ thinking: { enabled: false } })
  }
}

// ---------------------------------------------------------------------------
// Measuring a case
// ---------------------------------------------------------------------------

// The tokens every model has written so far, over the whole run. The
// per-branch counter counts prompt and reply together; this one keeps them
// apart.
def outputTokensSoFar(): number {
  let total = 0
  for (entry in getModelCosts()) {
    total = total + entry.outputTokens
  }
  return total
}

// One line of a command's output, or "" when the command is not on this
// machine or fails. exec rejects a command it cannot find, and this runs
// after every case has finished, so a missing command must not end the run.
def commandLine(command: string, args: string[]): string {
  if (which(command) == "") {
    return ""
  }
  const result = exec(command, args) with approve
  if (result.exitCode != 0) {
    return ""
  }
  return result.stdout.trim()
}

// The chip, memory, and operating system, from the commands that know them.
// A command that is missing on this machine leaves its part out.
def machineInfo(): string {
  const parts: string[] = []
  const chip = commandLine("sysctl", ["-n", "machdep.cpu.brand_string"])
  if (chip != "") {
    parts.push(chip)
  }
  const memory = commandLine("sysctl", ["-n", "hw.memsize"])
  if (memory != "") {
    const gb = Math.round(Number(memory) / (1024 * 1024 * 1024))
    parts.push("${gb}GB")
  }
  const os = commandLine("uname", ["-sr"])
  if (os != "") {
    parts.push(os)
  }
  return parts.join(", ")
}

// What ran the model, from its name, for a run made without --backend: a
// GGUF path is llama.cpp, an MLX repo id (mlx-community/..., or any name
// with "mlx" in it) is the MLX server, and anything else is hosted. A
// hosted name can carry a provider and a slash, so a slash alone says
// nothing. run-all.sh always passes --backend.
def backendFor(model: string): string {
  if (model.endsWith(".gguf")) {
    return "llama-cpp"
  }
  if (model.toLowerCase().includes("mlx")) {
    return "mlx"
  }
  return "hosted"
}

// Time, tokens, and cost are measured by reading the running totals before
// and after the case. Each case gets a fresh thread so no case sees another
// case's messages. If the model call fails (a timeout, a reply that does not
// fit the schema, a local model that runs out of context), the case function
// returns a failure, and it is recorded as an error with a score of 0.
def runCase(info: CaseInfo, trial: number, haystackLines: number): CaseResult {
  const startMs = now()
  const startCost = getCost()
  const startTokens = getTokens()
  const startOutput = outputTokensSoFar()
  earlyStops = []
  thinkingFor(info.name)
  let result: any = null
  thread {
    result = runOne(info.name, haystackLines)
  }
  const latencyMs = now() - startMs
  let score = 0
  let detail = ""
  let error = ""
  if (isFailure(result)) {
    error = oneLine(result.error, 160)
  } else {
    score = result.score
    detail = oneLine(result.detail)
    error = oneLine(result.error, 160)
  }
  // A reply the provider cut off is not the model's answer. When the case
  // did not pass and no other error explains it, the stop reason is the
  // error, so the tables show it as one.
  const stopReason = earlyStops.join(", ")
  if (stopReason != "" && score < 1 && error == "") {
    error = "the provider ended a reply early: ${stopReason}"
  }
  return {
    caseName: info.name,
    category: info.category,
    trial: trial,
    passed: score >= 1,
    score: score,
    latencyMs: latencyMs,
    tokens: getTokens() - startTokens,
    outputTokens: outputTokensSoFar() - startOutput,
    cost: getCost() - startCost,
    detail: detail,
    error: error,
    stopReason: stopReason
  }
}

def statusMark(r: CaseResult): string {
  if (r.error != "") {
    return "ERR"
  }
  return if r.passed then "pass" else "FAIL"
}

// A local model loads into memory on its first call, which can take many
// seconds. One untimed call before the cases keeps that load out of the
// latency case. It also tells us which model the run is using. Its message
// stays out of the cases, because every case starts its own empty thread.
def warmUp(): Result {
  const reply: string = llm("Reply with only the word OK.")
  return success(reply)
}

def selectCases(filterText: string): CaseInfo[] {
  const wanted = splitList(filterText)
  const known = map(ALL_CASES) as c { return c.name }
  for (name in wanted) {
    if (name != "all" && name != "stress" && !known.includes(name)) {
      print("Unknown case '${name}'. Known cases: ${known.join(", ")}, or all, or stress")
      return []
    }
  }
  return filter(ALL_CASES) as c {
    if (c.category == "stress") {
      return wanted.includes("stress") || wanted.includes(c.name)
    }
    return wanted.includes("all") || wanted.includes(c.name)
  }
}

node main() {
  const args = parseArgs({
    programName: "run-model",
    description: "Run the benchmark cases against one model and save the results as JSON. Choose the model with agency run --model or --local.",
    flags: {
      label: { type: "string", default: "", description: "Name for this model in the comparison table (defaults to the model name)" },
      out: { type: "string", short: "o", default: "", description: "Where to write the results (defaults to results/<label>.json)" },
      cases: { type: "string", short: "c", default: "all", description: "Comma-separated case names; all for every case but the stress ones; stress for those" },
      trials: { type: "number", short: "t", default: 1, description: "How many times to run each case. One is enough for a local model, whose cases repeat their questions inside the call; three suits a hosted model, where a run is cheap" },
      haystack: { type: "number", default: 1000, description: "Lines of filler in the needle case, about 17 tokens each. Lower it for local models with a small context window" },
      "max-tokens": { type: "number", default: 0, description: "Cap on output tokens per call, thinking included. 0 leaves the provider's default in place" },
      timeout: { type: "number", default: 0, description: "Seconds to wait for one call before giving up on it. 0 leaves the runtime's default in place (ten minutes)" },
      thinking: { type: "string", default: "auto", description: "How models think: auto (off, except on the reasoning cases), on, off, or default (each model's own default)" },
      "thinking-budget": { type: "number", default: 4096, description: "Tokens a model may think for on a case where thinking is on" },
      "machine-label": { type: "string", default: "", description: "A short name for this machine, such as m1-studio, put in the results file and its name" },
      backend: { type: "string", default: "", description: "What runs the model: hosted, mlx, or llama-cpp. Recorded in the results; guessed from the model name when empty" },
      "draft-model": { type: "string", default: "", description: "The draft model in use for speculative decoding, recorded in the results. For a GGUF model pass it to agency run --draft as well; for an MLX model start the server with it" },
      "prefill-step": { type: "number", default: 0, description: "The MLX server's prompt chunk size in use, recorded in the results. Start the server with --prefill-step to change it" },
      cold: { type: "boolean", description: "Skip the untimed warm-up call, so the first case includes the model's load time" },
      list: { type: "boolean", short: "l", description: "List the cases and exit" }
    }
  })

  if (args.flags.list) {
    for (info in ALL_CASES) {
      print(info.name.padEnd(14) + info.category.padEnd(16) + info.description)
    }
    return null
  }

  const cases = selectCases(args.flags.cases)
  if (cases.length == 0) {
    return null
  }
  const trials = args.flags.trials
  const haystackLines = args.flags.haystack
  const startedAt = format(now())

  if (!["auto", "on", "off", "default"].includes(args.flags.thinking)) {
    print("--thinking must be auto, on, off, or default, not ${args.flags.thinking}")
    return null
  }
  thinkingMode = args.flags.thinking
  thinkingBudget = args.flags["thinking-budget"]

  // A local thinking model can spend the provider's whole default budget
  // thinking and never answer, and the runtime waits ten minutes for it.
  // Set here, before the warm-up, so they apply to every call in the run.
  const maxTokens = maxTokensFor(args.flags["max-tokens"])
  if (maxTokens > 0) {
    setLlmOptions({ maxTokens: maxTokens })
  }
  if (args.flags.timeout > 0) {
    // A timed-out call is not retried: the runtime would try it twice more,
    // so a reply that goes in circles would cost three timeouts, and on the
    // MLX server the abandoned tries would run on beside the retry.
    setLlmOptions({ timeout: args.flags.timeout * 1000, retries: 0 })
  }

  if (!args.flags.cold) {
    const warm = warmUp()
    if (isFailure(warm)) {
      print("The warm-up call failed, so the model is probably not reachable: ${warm.error}")
      return null
    }
  }

  const label = if args.flags.label != "" then args.flags.label else seenModel
  // A machine label goes into the file name too, so files from several
  // machines can sit in one directory.
  const machineLabel = args.flags["machine-label"]
  const defaultOut = if machineLabel == "" then "results/${fileSafe(label)}.json" else "results/${fileSafe(label)}--${fileSafe(machineLabel)}.json"
  const out = if args.flags.out != "" then args.flags.out else defaultOut
  print("Running ${cases.length} cases x ${trials} trial(s) on ${label}")

  let results: CaseResult[] = []
  for (trial in range(1, trials + 1)) {
    for (info in cases) {
      const r = runCase(info, trial, haystackLines)
      results.push(r)
      const note = if r.error != "" then r.error else r.detail
      print("[${label}] ${info.name} (trial ${trial}): ${statusMark(r)} in ${seconds(r.latencyMs)}  ${note}")
    }
  }

  const passes = count(results) as r { return r.passed }
  print("")
  print("${label}: ${passes}/${results.length} passed")

  const backend = if args.flags.backend != "" then args.flags.backend else backendFor(seenModel)
  const run: RunFile = {
    label: label,
    model: seenModel,
    machine: machineInfo(),
    machineLabel: args.flags["machine-label"],
    settings: {
      backend: backend,
      thinking: thinkingMode,
      thinkingBudget: thinkingBudget,
      maxTokens: maxTokens,
      timeout: args.flags.timeout,
      draft: args.flags["draft-model"],
      prefillStep: args.flags["prefill-step"]
    },
    startedAt: startedAt,
    trials: trials,
    haystackLines: haystackLines,
    results: results
  }
  // The results file is this script's own output, so the write is approved
  // here rather than asking at the end of every run.
  const saved = write(out, JSON.stringify(run, null, 2)) with approve
  if (isFailure(saved)) {
    print("Could not write ${out}: ${saved.error}")
  } else {
    print("Wrote ${out}")
  }
}
