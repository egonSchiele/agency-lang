/** @module
@summary Transform, search, and group arrays.
Provides array helpers such as `map`, `filter`, and `reduce`. These helpers
are also available without an import in every Agency file. Use this module
when you want to name the import explicitly.
*/
export {
  map,
  filter,
  exclude,
  find,
  findIndex,
  reduce,
  flatMap,
  every,
  some,
  count,
  sortBy,
  unique,
  groupBy,
} from "std::index"
