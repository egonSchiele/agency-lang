{
  "tests": [
    {
      "nodeName": "errorFindingSurfaces",
      "description": "the judge's error finding surfaces through reviewAgent",
      "input": "",
      "expectedOutput": "true",
      "evaluationCriteria": [
        {
          "type": "exact"
        }
      ],
      "useTestLLMProvider": true,
      "llmMocks": [
        {
          "return": [
            {
              "error": true,
              "feedback": "1+1 is 2, not 3"
            }
          ]
        }
      ]
    },
    {
      "nodeName": "trippedReviewIsAFailureWhenNotFailOpen",
      "description": "a review whose budget runs out with nothing saved is a failure with failOpen: false",
      "input": "",
      "expectedOutput": "\"failure\"",
      "evaluationCriteria": [
        {
          "type": "exact"
        }
      ],
      "useTestLLMProvider": true,
      "llmMocks": [
        {
          "return": [
            {
              "error": true,
              "feedback": "never seen"
            }
          ],
          "delayMs": 60000
        }
      ]
    },
    {
      "nodeName": "trippedReviewFailsOpenByDefault",
      "description": "the same review fails open to no findings by default",
      "input": "",
      "expectedOutput": "\"success:0\"",
      "evaluationCriteria": [
        {
          "type": "exact"
        }
      ],
      "useTestLLMProvider": true,
      "llmMocks": [
        {
          "return": [
            {
              "error": true,
              "feedback": "never seen"
            }
          ],
          "delayMs": 60000
        }
      ]
    },
    {
      "nodeName": "cutShortReviewIsAFailureWhenNotFailOpen",
      "description": "a review cut short after saving a finding is a failure with failOpen: false, carrying the finding",
      "input": "",
      "expectedOutput": "\"failure:1\"",
      "evaluationCriteria": [
        {
          "type": "exact"
        }
      ],
      "useTestLLMProvider": true,
      "llmMocks": [
        {
          "toolCall": {
            "name": "saveDraft",
            "args": {
              "value": [
                {
                  "error": false,
                  "feedback": "the task is stated"
                }
              ]
            }
          }
        },
        {
          "return": [
            {
              "error": true,
              "feedback": "never seen"
            }
          ],
          "delayMs": 60000
        }
      ]
    },
    {
      "nodeName": "cutShortReviewReturnsItsFindingsByDefault",
      "description": "the same review returns its saved finding by default",
      "input": "",
      "expectedOutput": "\"success:1\"",
      "evaluationCriteria": [
        {
          "type": "exact"
        }
      ],
      "useTestLLMProvider": true,
      "llmMocks": [
        {
          "toolCall": {
            "name": "saveDraft",
            "args": {
              "value": [
                {
                  "error": false,
                  "feedback": "the task is stated"
                }
              ]
            }
          }
        },
        {
          "return": [
            {
              "error": true,
              "feedback": "never seen"
            }
          ],
          "delayMs": 60000
        }
      ]
    }
  ]
}
