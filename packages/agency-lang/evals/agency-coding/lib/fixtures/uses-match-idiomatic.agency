import { foo } from "./foo.agency"

export def callFoo(effect: string, dir: string = "."): string {
  let outcome = ""
  handle {
    const result = foo(effect, dir)
    outcome = match(result) {
      success(v) => "approved"
      failure(e) => "rejected: ${e}"
    }
  } with (data) {
    return match(data.effect) {
      "std::read" => approve()
      "std::write" if (data.data.dir == ".") => approve()
      "std::write" => reject("only writes to the current directory are allowed")
      "std::email" => reject("email is never allowed")
    }
  }
  return outcome
}
