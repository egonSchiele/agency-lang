/*
 * Tool and LLM call tracing, and the flags that decide when to show it. An
 * interactive run traces by default; a one-shot run stays quiet unless the
 * user asked for it.
 *
 * No @module banner here on purpose: a file holding a top-level callback()
 * cannot also carry one, or the preprocessor rejects it. See issue below.
 */
import { _setTraceOptions, _traceOptions } from "agency-lang/stdlib-lib/agentProcess.js"
import { _printAgentTrace } from "agency-lang/stdlib-lib/agentToolTrace.js"
import { searchProviderName } from "std::agents/lib/search"
import { env } from "std::system"
import { pushMessage } from "std::ui/cli"

import { REPL_STYLE, setReplyStyle } from "./answer.agency"
import { setJobToolsOn } from "./cliTools.agency"
import {
  isPlainObject,
  retryReasonLabel,
 } from "./utils.agency"
import { renderLLMCallResponse } from "./utils/renderLLMCallResponse.agency"


let AGENT_DEBUG_ENV = env("AGENT_DEBUG") with approve

// Debug, verbose and interactive are facts about the process, so they live
// in process state (agentProcess.ts), not in this module's globals: the
// shell run and the session run each have their own copy of those. Only the
// AGENT_DEBUG environment variable is read here, per run, and it adds to
// the process's debug flag.
def debugOn(): boolean {
  return _traceOptions().debug || AGENT_DEBUG_ENV == "1"
}

def verboseOn(): boolean {
  return _traceOptions().verbose
}

// Live tool-call tracing. Always shown in the interactive REPL, but in
// one-shot mode it's suppressed unless the user opts in
// with `--verbose` / `--debug` (AGENT_DEBUG). A function, not a static
// const: it reads globals that `main()` sets after module init, so the
// value must be computed per call.
export def isTraceEnabled(): boolean {
  return _traceOptions().interactive || verboseOn() || debugOn()
}

// Which tools print, and how, is the renderer's table (TOOL_PRESENTATIONS in
// agentToolTrace.ts). Nothing here names a tool. The debug flag makes every
// summary line carry the registered tool name, which is how a reader finds
// the call in the log.
callback("onToolCallStart") as data {
  if (isTraceEnabled()) {
    _printAgentTrace({ kind: "toolStart", toolName: data.toolName, args: data.args, provider: searchProviderName(data.toolName) }, debugOn())
  }
}

callback("onToolCallEnd") as data {
  if (isTraceEnabled()) {
    const provider = searchProviderName(data.toolName)
    const base = { kind: "toolEnd", toolName: data.toolName, args: data.args, timeTaken: data.timeTaken, provider: provider }
    if (data.result is success(_result)) {
      _printAgentTrace({ ...base, value: _result, outcome: "success" }, debugOn())
    } else if (data.result is failure(_error)) {
      _printAgentTrace({ ...base, value: _error, outcome: "failure" }, debugOn())
    } else if (isPlainObject(data.result) && data.result.type == "reject") {
      _printAgentTrace({ ...base, value: data.result.value ?? "Tool call rejected", outcome: "failure" }, debugOn())
    } else {
      _printAgentTrace({ ...base, value: data.result, outcome: "plain" }, debugOn())
    }
  }
}

callback("onLLMCallStart") as data {
  if (debugOn() || verboseOn()) {
    pushMessage(color.green.dim("💬 [${data.model}] ${data.prompt}"))
  }
}

callback("onLLMCallEnd") as data {
  if (isTraceEnabled() && data.result.hostedToolResults) {
    for (result in data.result.hostedToolResults) {
      _printAgentTrace({ kind: "hostedSearch", result: result })
    }
  }
  if (debugOn() || verboseOn()) {
    pushMessage(
      color.green.dim("💬 [${data.model}] ${renderLLMCallResponse(data.result)}"),
    )
  } else if (isTraceEnabled() && (data.result.toolCalls ?? []).length > 0) {
    // Text written beside tool calls is the model's progress report. A
    // response with no tool calls is the answer, which the REPL prints.
    _printAgentTrace({ kind: "narration", text: data.result.output ?? "" })
  }
}

// The color for each notice level (lib/notice.agency).
def printNotice(text: string, level: string) {
  if (level == "error") {
    pushMessage(color.red(text))
  } else if (level == "warning") {
    pushMessage(color.yellow(text))
  } else {
    pushMessage(color.dim(text))
  }
}

// Prints the events this terminal shows: a subagent's start and a failed
// router call from std::agents/agency, and the session's notices and
// budget stops. Any other event prints nothing.
callback("onEmit") as data {
  if (isPlainObject(data) && data.type == "agencyAgent.subagentStart" && isTraceEnabled()) {
    _printAgentTrace({ kind: "agentStart", toolName: data.agent, message: data.message })
  } else if (isPlainObject(data) && data.type == "agencyAgent.routerFailed") {
    print(color.dim(data.error))
  } else if (isPlainObject(data) && data.type == "session.notice") {
    printNotice(data.text, data.level)
  } else if (isPlainObject(data) && data.type == "session.budgetStop" && _traceOptions().interactive) {
    // Only with a person at the terminal. A one-shot run's output is
    // the reply and nothing else.
    print(color.yellow(
      "⏳ The ${data.dimension} budget for ${data.label} ran out; stopping that step with its best result so far.",
    ))
  }
}

callback("onLLMRetry") as data {
  if (isTraceEnabled()) {
    pushMessage(
      color.dim(
      "⟳ ${retryReasonLabel(data.reason)} — retrying (${data.attempt}/${data.maxRetries})…",
    ),
    )
  }
}

export def isDebug(): boolean {
  """
  Whether debug tracing is on for this run.
  """
  return debugOn()
}

export def isVerbose(): boolean {
  """
  Whether verbose tracing is on for this run.
  """
  return verboseOn()
}

export def setDebug(on: boolean) {
  """
  Turn debug tracing on for the rest of the run.

  @param on - Whether to trace
  """
  _setTraceOptions({ ..._traceOptions(), debug: on })
}

export def setVerbose(on: boolean) {
  """
  Turn verbose tracing on for the rest of the run.

  @param on - Whether to trace
  """
  _setTraceOptions({ ..._traceOptions(), verbose: on })
}

export def setInteractive(on: boolean) {
  """
  Record whether a user is at a terminal, which decides whether tool traces
  are shown by default.

  A one-shot run also gets no reply style and no background job tools,
  so both follow this flag.

  @param on - Whether the run is interactive
  """
  _setTraceOptions({ ..._traceOptions(), interactive: on })
  if (on) {
    setReplyStyle(REPL_STYLE)
  } else {
    setReplyStyle("")
  }
  setJobToolsOn(on)
}

export def isInteractive(): boolean {
  """
  Whether a user is at a terminal to answer prompts. False in one-shot and
  piped runs, where there is nobody to respond to an interrupt.
  """
  return _traceOptions().interactive
}
