def globPayloads(source: string): any {
  // The for-and-if shape, so `payload` narrows to GlobPayload.
  let out: any[] = []
  for (effect in planFor(source, FIXTURES).effects) {
    if (effect.name == "std::glob") {
      out.push([effect.payload.pattern, effect.payload.dir == FIXTURES])
    }
  }
  return out
}

node findPatterns() {
  return [
