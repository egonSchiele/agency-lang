import { question } from "std::agent"
import { agencyReviewAgent } from "std::agents/agency/review"
import { reviewAgent as generalReviewAgent } from "std::agents/review"
import { Feedback, mergeFeedback, renderFeedback } from "std::agents/lib/feedback"
import { setMemoryId } from "std::memory"

import { announce } from "../lib/announce.agency"

// The review itself lives in std::agents/agency/review, so users get the
// same reviewer. What is left here is the agent-shaped part: pulling code
// snippets out of a chat message, and reviewing the .agency files the code
// agent just wrote.

type AgencyCode = {
  code: string
}

export def reviewAgent(userMsg: string, agencyTask: boolean = false): string {
  """
  Review code and report what is wrong with it: errors, risks, and things
  worth changing.

  @param userMsg - the code to review, or a message describing what to review.
  @param agencyTask - true when the code is Agency code, which routes to the
    reviewer that parses and typechecks it. Leave it false for every other
    language, where that reviewer has nothing useful to say.
  """
  announce("reviewAgent", userMsg)
  if (!agencyTask) {
    const general = generalReviewAgent(work: userMsg, task: "Review this code.")
    return renderFeedback(general)
  }
  return renderFeedback(review(userMsg))
}

export def review(userMsg: string): Result<Feedback[]> {
  thread(label: "review", summarize: true, session: "review") {
    setMemoryId("review")

    const snippets: AgencyCode[] = llm(
      `Extract any Agency code snippets from the following message: ${userMsg}`,
    )

    let feedback: Result<Feedback[]> = success([])

    for (codeSnippet in snippets) {
      feedback = mergeFeedback(feedback, agencyReviewAgent(codeSnippet.code, extraTools: [question]))
    }
  }
  return feedback
}
