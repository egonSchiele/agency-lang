/**
 * Read the JSON files that run-model.agency wrote, one per model, and print
 * them side by side.
 *
 *   agency run compare.agency results/*.json
 *   agency run compare.agency results/gpt-5.4-mini.json results/qwen3.5-2b.json
 *
 * Three tables are printed:
 *   1. Each case, each model: trials passed, then the mean and median time.
 *      The raw time of every trial is in the JSON files. When the mean and
 *      median are far apart, one trial was much slower than the others.
 *   2. Each category, each model: the average score, as a percent.
 *   3. One row per model: pass rate, mean and median time, speed, and the tokens and
 *      cost of one trial, so runs with different trial counts compare fairly.
 */
import { parseArgs } from "std::args"
import { basename, dirname } from "std::path"

// The same shapes run-model.agency writes.
type CaseResult = {
  caseName: string,
  category: string,
  trial: number,
  passed: boolean,
  score: number,
  latencyMs: number,
  tokens: number,
  // Absent in files written before the benchmark recorded output tokens.
  outputTokens?: number,
  cost: number,
  detail: string,
  error: string,
  // Absent in files written before the benchmark recorded stop reasons.
  stopReason?: string
}

type RunFile = {
  label: string,
  model: string,
  // Absent in files written before the benchmark recorded the machine.
  machine?: string,
  machineLabel?: string,
  settings?: RunSettings,
  startedAt: string,
  trials: number,
  haystackLines: number,
  results: CaseResult[]
}

// The choices a run was made with. See run-model.agency.
type RunSettings = {
  backend: string,
  thinking: string,
  thinkingBudget: number,
  maxTokens: number,
  timeout: number,
  draft: string,
  prefillStep: number
}

// A run's heading in the tables: its label, and its machine's label when
// the runs come from more than one machine, so the same model on two
// machines gets two columns that can be told apart.
def headingOf(run: RunFile, runs: RunFile[]): string {
  const labels = filter(map(runs) as r { return r.machineLabel }) as l { return l != null && l != "" }
  let seen: string[] = []
  for (l in labels) {
    if (!seen.includes(l)) {
      seen.push(l)
    }
  }
  if (seen.length < 2 || run.machineLabel == null || run.machineLabel == "") {
    return run.label
  }
  return "${run.label} @ ${run.machineLabel}"
}

// ---------------------------------------------------------------------------
// Small helpers
// ---------------------------------------------------------------------------

def pad(text: string, width: number): string {
  return text.padEnd(width)
}

def rule(width: number): string {
  const dash = "-"
  return dash.repeat(width)
}

def seconds(ms: number): string {
  const s = ms / 1000
  return s.toFixed(1) + "s"
}

def median(values: number[]): number {
  if (values.length == 0) {
    return 0
  }
  const sorted = sortBy(values) as v { return v }
  const middle = Math.floor(sorted.length / 2)
  if (sorted.length % 2 == 0) {
    return (sorted[middle - 1] + sorted[middle]) / 2
  }
  return sorted[middle]
}

def sumOf(values: number[]): number {
  return reduce(values, 0) as (total, v) { return total + v }
}

def average(values: number[]): number {
  if (values.length == 0) {
    return 0
  }
  return sumOf(values) / values.length
}

// Every distinct value, in the order it first appears. The tables list cases
// and categories in the order run-model.agency ran them.
def inOrder(values: string[]): string[] {
  let seen: string[] = []
  for (v in values) {
    if (!seen.includes(v)) {
      seen.push(v)
    }
  }
  return seen
}

// Each model gets a column wide enough for its label, and at least wide
// enough for a cell like "3/3 12.4s | 10.1s (1 err)".
def columnWidth(label: string): number {
  return Math.max(label.length, 25) + 2
}

// ---------------------------------------------------------------------------
// Reading the files
// ---------------------------------------------------------------------------

// A path is split into its directory and file name, because read() only
// accepts a bare file name inside a directory. The caller approves the read.
def readRuns(path: string): RunFile[] {
  const text = read(basename(path), dirname(path))
  if (isFailure(text)) {
    print("Skipping ${path}: ${text.error}")
    return []
  }
  const parsed = try JSON.parse(text.value)
  if (isFailure(parsed)) {
    print("Skipping ${path}: it is not valid JSON")
    return []
  }
  const data = parsed.value
  // An older combined file, from when this script wrote one, holds a list
  // of runs.
  if (data.runs != null) {
    return data.runs
  }
  if (data.results == null) {
    print("Skipping ${path}: it has no results, so it was not written by run-model.agency")
    return []
  }
  return [data]
}

// ---------------------------------------------------------------------------
// Tables
// ---------------------------------------------------------------------------

def casesOf(run: RunFile, caseName: string): CaseResult[] {
  return filter(run.results) as r { return r.caseName == caseName }
}

// One cell of the case table: trials passed, then the mean and median time.
// For example "2/3 1.7s | 1.2s". A case the model never ran shows as "-".
def caseCell(runs: CaseResult[]): string {
  if (runs.length == 0) {
    return "-"
  }
  const passes = count(runs) as r { return r.passed }
  const errors = count(runs) as r { return r.error != "" }
  const times = map(runs) as r { return r.latencyMs }
  let text = "${passes}/${runs.length} ${seconds(average(times))} | ${seconds(median(times))}"
  if (errors > 0) {
    text = text + " (${errors} err)"
  }
  return text
}

def headerRow(firstColumn: string, firstWidth: number, runs: RunFile[]): string {
  let header = pad(firstColumn, firstWidth)
  for (run in runs) {
    const heading = headingOf(run, runs)
    header = header + pad(heading, columnWidth(heading))
  }
  return header
}

def printCaseTable(runs: RunFile[], caseNames: string[]) {
  const firstWidth = 14
  const header = headerRow("case", firstWidth, runs)
  print("")
  print(header)
  print(rule(header.length))
  for (caseName in caseNames) {
    let row = pad(caseName, firstWidth)
    for (run in runs) {
      row = row + pad(caseCell(casesOf(run, caseName)), columnWidth(headingOf(run, runs)))
    }
    print(row)
  }
  print("Each cell: trials passed, mean time | median time.")
}

def printCategoryTable(runs: RunFile[], categories: string[]) {
  const firstWidth = 16
  const header = headerRow("category", firstWidth, runs)
  print("")
  print(header)
  print(rule(header.length))
  for (category in categories) {
    let row = pad(category, firstWidth)
    for (run in runs) {
      const inCategory = filter(run.results) as r { return r.category == category }
      let text = "-"
      if (inCategory.length > 0) {
        const scores = map(inCategory) as r { return r.score }
        const percent = average(scores) * 100
        text = percent.toFixed(0) + "%"
      }
      row = row + pad(text, columnWidth(headingOf(run, runs)))
    }
    print(row)
  }
}

// Tokens the model wrote per second: every token it wrote over every
// second it took, across the cases that finished. Pooled this way, a
// one-word reply counts for its two tokens, not for a whole case; averaging
// the cases' own rates would let it drag the number down by half. Thinking
// is included. A file from before the count was recorded shows "-".
def outputSpeed(run: RunFile): string {
  const counted = filter(run.results) as r { return r.error == "" && r.latencyMs > 0 && r.outputTokens != null && r.outputTokens > 0 }
  if (counted.length == 0) {
    return "-"
  }
  const tokens = sumOf(map(counted) as r { return r.outputTokens })
  const seconds = sumOf(map(counted) as r { return r.latencyMs }) / 1000
  return (tokens / seconds).toFixed(0)
}

// The same rate on the throughput case alone: one short prompt and a long
// reply, so it is the cleanest number for comparing machines. A file from
// before output tokens were recorded falls back to the total count, which
// includes the short prompt and so runs a little high.
def storySpeed(run: RunFile): string {
  const stories = filter(casesOf(run, "throughput")) as r { return r.error == "" && r.latencyMs > 0 }
  if (stories.length == 0) {
    return "-"
  }
  const tokens = sumOf(map(stories) as r { return if r.outputTokens != null && r.outputTokens > 0 then r.outputTokens else r.tokens })
  const seconds = sumOf(map(stories) as r { return r.latencyMs }) / 1000
  return (tokens / seconds).toFixed(0)
}

def printSummaryTable(runs: RunFile[]) {
  let labelWidth = 7
  for (run in runs) {
    labelWidth = Math.max(labelWidth, headingOf(run, runs).length + 2)
  }
  print("")
  print(pad("model", labelWidth) + pad("passed", 10) + pad("avg score", 11) + pad("mean time", 11) + pad("median time", 13) + pad("out tok/s", 11) + pad("story tok/s", 13) + pad("tokens/trial", 14) + "cost/trial")
  print(rule(labelWidth + 93))
  for (run in runs) {
    const results = run.results
    const passes = count(results) as r { return r.passed }
    const scores = map(results) as r { return r.score }
    const times = map(results) as r { return r.latencyMs }
    const tokenCounts = map(results) as r { return r.tokens }
    const costs = map(results) as r { return r.cost }
    const trials = Math.max(run.trials, 1)
    const tokens = Math.round(sumOf(tokenCounts) / trials)
    const cost = sumOf(costs) / trials
    print(pad(headingOf(run, runs), labelWidth) + pad("${passes}/${results.length}", 10) + pad(average(scores).toFixed(2), 11) + pad(seconds(average(times)), 11) + pad(seconds(median(times)), 13) + pad(outputSpeed(run), 11) + pad(storySpeed(run), 13) + pad("${tokens}", 14) + "$" + cost.toFixed(4))
  }
  printMachines(runs)
  printSettingsTable(runs)
}

// The choices each run was made with, for the runs that recorded them. Two
// runs of one model that differ here measured different things.
def printSettingsTable(runs: RunFile[]) {
  const recorded = filter(runs) as r { return r.settings != null }
  if (recorded.length == 0) {
    return
  }
  let labelWidth = 7
  for (run in recorded) {
    labelWidth = Math.max(labelWidth, headingOf(run, runs).length + 2)
  }
  print("")
  print(pad("model", labelWidth) + pad("backend", 11) + pad("thinking", 10) + pad("budget", 8) + pad("max tokens", 12) + pad("timeout", 9) + pad("prefill", 9) + "draft")
  print(rule(labelWidth + 65))
  for (run in recorded) {
    const s = run.settings
    const timeout = if s.timeout == 0 then "default" else "${s.timeout}s"
    const maxTokens = if s.maxTokens == 0 then "default" else "${s.maxTokens}"
    const prefill = if s.prefillStep == 0 then "default" else "${s.prefillStep}"
    const draft = if s.draft == "" then "none" else s.draft
    print(pad(headingOf(run, runs), labelWidth) + pad(s.backend, 11) + pad(s.thinking, 10) + pad("${s.thinkingBudget}", 8) + pad(maxTokens, 12) + pad(timeout, 9) + pad(prefill, 9) + draft)
  }
}

// Where each run was made, when the file says. Runs from one machine are
// listed once, under that machine.
def printMachines(runs: RunFile[]) {
  let machines: string[] = []
  for (run in runs) {
    if (run.machine != null && run.machine != "" && !machines.includes(run.machine)) {
      machines.push(run.machine)
    }
  }
  if (machines.length == 0) {
    return
  }
  print("")
  for (machine in machines) {
    const labels = map(filter(runs) as r { return r.machine == machine }) as r { return r.label }
    print("${machine}: ${labels.join(", ")}")
  }
}

node main() {
  const args = parseArgs({
    programName: "compare",
    description: "Compare benchmark results from several run-model.agency JSON files.",
    flags: {}
  })

  const paths = args.positionals
  if (paths.length == 0) {
    print("Pass the result files to compare, for example: agency run compare.agency results/*.json")
    return null
  }

  // The same run can arrive twice, once in its own file and once inside an
  // older combined file.
  let runs: RunFile[] = []
  let seenKeys: string[] = []
  for (path in paths) {
    // Reading the files the user named is the point of this script, so the
    // reads are approved here rather than asking once per file.
    const fileRuns = readRuns(path) with approve
    for (run in fileRuns) {
      const key = "${run.label}@${run.startedAt}"
      if (!seenKeys.includes(key)) {
        seenKeys.push(key)
        runs.push(run)
      }
    }
  }
  if (runs.length == 0) {
    print("No results to compare.")
    return null
  }

  let allCaseNames: string[] = []
  let allCategories: string[] = []
  for (run in runs) {
    for (r in run.results) {
      allCaseNames.push(r.caseName)
      allCategories.push(r.category)
    }
  }

  printCaseTable(runs, inOrder(allCaseNames))
  printCategoryTable(runs, inOrder(allCategories))
  printSummaryTable(runs)
}
