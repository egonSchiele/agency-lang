// #630: @validate tags must run through Record values, cross-module, via the
// defining module's descriptor (see ages.agency for why inlining would crash).

import { Age, Repaired } from "./ages.agency"

node rejects() {
  const ages: Record<string, Age>! = { a: 30, b: 12 }
  if (ages is failure(err)) {
    return "rejected:${err}"
  }
  return "accepted"
}

node passes() {
  const ages: Record<string, Age>! = { a: 30, b: 45 }
  if (ages is success(v)) {
    return "ok:${v.a},${v.b}"
  }
  return "rejected"
}

def tryRepair(): string {
  const fixed: Record<string, Repaired>! = { a: -5, b: 2 }
  if (fixed is failure(why)) {
    return "failure"
  }
  return "fixed:${fixed.value.a},${fixed.value.b}"
}

node transforms() {
  // Was the write-back pin. The predicate contract retires transforms: the
  // cross-module modifying validator (clampToOne, still routed through the
  // defining module's descriptor - the #630 point) must error loudly.
  const outcome = try tryRepair()
  if (outcome is failure(why)) {
    const reason = "${why}"
    if (reason.includes("modified the value")) {
      if (reason.includes("clampToOne")) {
        return "errored:named"
      }
      return "errored:unnamed"
    }
    return "errored:other"
  }
  return outcome.value
}

node patternTest() {
  // Type patterns ride the same descriptor machinery (tier 2).
  const good: any = { a: 30 }
  const bad: any = { a: 12 }
  let out = ""
  if (good is Record<string, Age>) {
    out = "good-yes"
  }
  if (bad is Record<string, Age>) {
    out = "${out},bad-yes"
  } else {
    out = "${out},bad-no"
  }
  return out
}

node nested() {
  const deep: Record<string, Record<string, Age>>! = { x: { a: 12 } }
  if (deep is failure(err)) {
    return "deep-rejected"
  }
  return "deep-accepted"
}
