/*
 * designSkill: the caller's draft is shown first, revise feedback goes to
 * one model call, accept saves through writeSkill's own gate. Nodes that
 * never revise run with no LLM mock, so a model call on the accept path
 * fails them. Output goes under test-output/ (gitignored), one directory
 * per node.
 */
import { remove } from "std::fs"
import { exists } from "std::shell"
import { designSkill, SkillEntry } from "std::skills"

def outDir(node: string): string {
  const dir = "${__dirname}/test-output/skills-design/${node}"
  remove(dir) with approve
  return dir
}

/** What one designSkill call raised, with its outcome. */
type DesignRun = {
  outcome: Result<SkillEntry>;
  reviews: number;
  saves: number;
  shown: string[]
}

// Answer each review with the next scripted answer: null rejects, "bare"
// is a valueless approve(), anything else is passed to approve(). Every
// other interrupt is approved. `shown` collects the body of each review,
// in order.
def runDesign(
  dir: string,
  name: string,
  body: string,
  answers: any[],
  maxRounds: number = 3,
): DesignRun {
  let reviews = 0
  let saves = 0
  const shown: string[] = []
  let outcome: Result<SkillEntry> = failure("not run")
  handle {
    outcome = designSkill(dir, name, "Use when testing designSkill", body, maxRounds)
  } with (intr) {
    return match(intr.effect) {
      "std::skills::review" => {
        shown.push(intr.data.body)
        const answer = answers[reviews]
        reviews = reviews + 1
        if (answer == null) {
          return reject("cancelled by the test")
        }
        if (answer == "bare") {
          return approve()
        }
        return approve(answer)
      }
      "std::skills::save" => {
        saves = saves + 1
        return approve()
      }
      _ => approve()
    }
  }
  return {
    outcome: outcome,
    reviews: reviews,
    saves: saves,
    shown: shown
  }
}

// One review, then one save, and the file holds the draft as shown.
node acceptSavesTheDraft(): boolean {
  const dir = outDir("accept")
  const ran = runDesign(dir, "first-draft", "Read the README first.", ["accept"])
  if (ran.outcome is failure) {
    return false
  }
  const raw = read("first-draft.md", dir) with approve
  if (raw is failure) {
    return false
  }
  return ran.reviews == 1 && ran.saves == 1 && raw.value.includes("Read the README first.")
}

node bareApproveAccepts(): boolean {
  const dir = outDir("bare")
  const ran = runDesign(dir, "bare-accept", "Body.", ["bare"])
  return ran.outcome is success && ran.saves == 1 && exists("bare-accept.md", dir)
}

node rejectAtReviewWritesNothing(): boolean {
  const dir = outDir("reject-review")
  const ran = runDesign(dir, "rejected", "Body.", [null])
  return ran.outcome is failure && "${ran.outcome.error}" =~ re/cancelled by the test/ && ran.saves == 0 && !exists("rejected.md", dir)
}

// Accepting the review is not the last word: writeSkill's save gate is
// still raised, and a rejection there writes nothing.
node rejectAtSaveWritesNothing(): boolean {
  const dir = outDir("reject-save")
  let outcome: Result<SkillEntry> = failure("not run")
  handle {
    outcome = designSkill(dir, "unsaved", "Use when testing", "Body.")
  } with (intr) {
    return match(intr.effect) {
      "std::skills::review" => approve("accept")
      "std::skills::save" => reject("not this one")
      _ => approve()
    }
  }
  return outcome is failure && "${outcome.error}" =~ re/not this one/ && !exists("unsaved.md", dir)
}

// Revise feedback goes to the model once; the second review shows the
// redraft, and accepting it saves the redraft.
node reviseShowsTheRedraft(): boolean {
  const dir = outDir("revise")
  const answers = [
    "shorter",
    "accept",
  ]
  const ran = runDesign(dir, "revised", "The long first draft.", answers)
  if (ran.outcome is failure) {
    return false
  }
  const raw = read("revised.md", dir) with approve
  if (raw is failure) {
    return false
  }
  return ran.reviews == 2 && ran.saves == 1 && ran.shown.join("|") == "The long first draft.|The short redraft." && raw.value.includes("The short redraft.") && !raw.value.includes("long first")
}

// The revise loop lives inside the call: after maxRounds reviews without
// an accept, the call gives up and nothing is written.
node givesUpAfterMaxRounds(): boolean {
  const dir = outDir("give-up")
  const answers = [
    "shorter",
    "shorter still",
  ]
  const ran = runDesign(dir, "endless", "Body.", answers, 2)
  return ran.outcome is failure && "${ran.outcome.error}" =~ re/gave up/ && ran.reviews == 2 && ran.saves == 0 && !exists("endless.md", dir)
}

node whitespaceFeedbackFails(): boolean {
  const dir = outDir("empty-feedback")
  const ran = runDesign(dir, "empty-feedback", "Body.", ["   "])
  return ran.outcome is failure && "${ran.outcome.error}" =~ re/feedback/ && ran.saves == 0 && !exists("empty-feedback.md", dir)
}

// The answer is text; an object is not an answer.
node objectAnswerFails(): boolean {
  const dir = outDir("no-feedback")
  const ran = runDesign(dir, "no-feedback", "Body.", [{ verdict: "revise" }])
  return ran.outcome is failure && "${ran.outcome.error}" =~ re/feedback/ && ran.saves == 0
}

// A redraft whose description breaks onto two lines could not be saved,
// so it is refused before the user is shown it.
node multilineRedraftFails(): boolean {
  const dir = outDir("multiline-redraft")
  const ran = runDesign(dir, "two-lines", "Body.", ["shorter"])
  return ran.outcome is failure && "${ran.outcome.error}" =~ re/one line/ && ran.reviews == 1 && !exists("two-lines.md", dir)
}

// A description the frontmatter grammar cannot hold (needs quoting, and
// contains all three quote characters) fails before the first prompt,
// not after the user has accepted.
node unrepresentableDescriptionFailsBeforeAsking(): boolean {
  const dir = outDir("unrepresentable")
  let reviews = 0
  let outcome: Result<SkillEntry> = failure("not run")
  handle {
    outcome = designSkill(dir, "unrep", " \"d\" 's' `t`", "Body.")
  } with (intr) {
    if (intr.effect == "std::skills::review") {
      reviews = reviews + 1
    }
    return approve()
  }
  return outcome is failure && reviews == 0 && !exists("unrep.md", dir)
}

// The same value from the redraft model is refused before it is shown.
node unrepresentableRedraftFails(): boolean {
  const dir = outDir("unrepresentable-redraft")
  const ran = runDesign(dir, "unrep-redraft", "Body.", ["shorter"])
  return ran.outcome is failure && "${ran.outcome.error}" =~ re/frontmatter/ && ran.reviews == 1 && !exists("unrep-redraft.md", dir)
}

// The input checks run before the first prompt.
node invalidNameFailsBeforeAsking(): boolean {
  const dir = outDir("invalid-name")
  const ran = runDesign(dir, "Not Kebab", "Body.", ["accept"])
  return ran.outcome is failure && ran.reviews == 0 && ran.saves == 0
}

node duplicateNameFailsBeforeAsking(): boolean {
  const dir = outDir("duplicate")
  const first = runDesign(dir, "twice", "Body.", ["accept"])
  if (first.outcome is failure) {
    return false
  }
  const second = runDesign(dir, "twice", "Body.", ["accept"])
  return second.outcome is failure && second.reviews == 0 && second.saves == 0
}

node emptyDirFailsBeforeAsking(): boolean {
  const ran = runDesign("", "empty-dir", "Body.", ["accept"])
  return ran.outcome is failure && ran.reviews == 0
}
