/*
 * Project instructions from the working directory and its parents. The
 * nodes build a tree under test-output (git-ignored) and remove it before
 * and after.
 */
import { mkdir, remove } from "std::fs"
import { bash } from "std::shell"

import { setAgentCwd } from "std::index"

import {
  InstructionFile,
  approvingInstructionReads,
  instructionFolders,
  instructionsText,
  loadProjectInstructions,
  projectContextText,
  withProjectContextIfMoved,
 } from "../lib/projectContext.agency"

def tree(): string {
  return __dirname + "/test-output/project-context"
}

def clearTree() {
  remove(tree(), allowedPaths: [__dirname + "/test-output"]) with approve
}

def addFile(folder: string, name: string, text: string): boolean {
  const written = write(name, text, dir: folder) with approve
  return written is success
}

// repo has `.git` and AGENTS.md; repo/sub has CLAUDE.md; repo/sub/work has
// AGENTS.md and CLAUDE.md; repo/sub/empty has neither. False when a file
// could not be written, so a node fails instead of testing an empty tree.
def buildTree(): boolean {
  clearTree()
  const repo = tree() + "/repo"
  mkdir(repo + "/.git") with approve
  mkdir(repo + "/sub/work") with approve
  mkdir(repo + "/sub/empty") with approve
  const written = [
    addFile(repo, "AGENTS.md", "root rules"),
    addFile(repo + "/sub", "CLAUDE.md", "sub rules"),
    addFile(repo + "/sub/work", "AGENTS.md", "work rules"),
    addFile(repo + "/sub/work", "CLAUDE.md", "ignored rules"),
  ]
  return !written.includes(false)
}

def load(start: string): InstructionFile[] {
  return loadProjectInstructions(instructionFolders(start)) with approve
}

node readsRootFirstNearestLast(): boolean {
  if (!buildTree()) {
    return false
  }
  const files = load(tree() + "/repo/sub/work")
  clearTree()
  const texts = [file.text for file in files]
  return JSON.stringify(texts) == JSON.stringify(["root rules", "sub rules", "work rules"])
}

node skipsFoldersWithNoFile(): boolean {
  if (!buildTree()) {
    return false
  }
  const files = load(tree() + "/repo/sub/empty")
  clearTree()
  const texts = [file.text for file in files]
  return JSON.stringify(texts) == JSON.stringify(["root rules", "sub rules"])
}

// A project whose AGENTS.md is a symlink to its CLAUDE.md. The file layer
// refuses to read through the link, so the CLAUDE.md is read by name.
node linkedAgentsMdFallsBackToClaudeMd(): boolean {
  clearTree()
  const repo = tree() + "/linked"
  mkdir(repo + "/.git") with approve
  if (!addFile(repo, "CLAUDE.md", "linked rules")) {
    return false
  }
  const linked = bash("ln -s CLAUDE.md AGENTS.md", cwd: repo) with approve
  const files = load(repo)
  clearTree()
  const texts = [file.text for file in files]
  return linked.exitCode == 0 && JSON.stringify(texts) == JSON.stringify(["linked rules"])
}

node aRejectingHandlerStopsTheReads(): boolean {
  if (!buildTree()) {
    return false
  }
  let files: InstructionFile[] = []
  handle {
    files = load(tree() + "/repo/sub/work")
  } with reject
  clearTree()
  return files.length == 0
}

node textNamesEachFolder(): boolean {
  const text = instructionsText(
    [
      {
        dir: "/r",
        text: "root rules"
      },
      {
        dir: "/r/s",
        text: "sub rules"
      },
    ],
  )
  return text == "Instructions from /r:\nroot rules\n\nInstructions from /r/s:\nsub rules"
}

node noFilesIsEmptyText(): boolean {
  return instructionsText([]) == ""
}

// The block is built for the agent's working directory, which a coder can
// change with `setAgentCwd`, and not for the directory the agent started in.
node blockFollowsTheAgentDirectory(): boolean {
  if (!buildTree()) {
    return false
  }
  const work = tree() + "/repo/sub/work"
  setAgentCwd(work)
  const block = projectContextText()
  clearTree()
  return block.includes("Current working directory: ${work}") && block.includes("work rules")
}

// After the agent's directory changes, the next message carries the new
// folder's block once. A message sent with no change is left alone.
node movedDirectorySendsTheBlockAgain(): string {
  if (!buildTree()) {
    return "could not build the tree"
  }
  setAgentCwd(tree() + "/repo/sub/work")
  projectContextText()
  const unmoved = withProjectContextIfMoved("first message")
  setAgentCwd(tree() + "/repo/sub/empty")
  const moved = withProjectContextIfMoved("second message")
  const afterwards = withProjectContextIfMoved("third message")
  clearTree()
  const facts = [
    unmoved == "first message",
    moved.includes("sub rules"),
    !moved.includes("work rules"),
    moved.endsWith("second message"),
    afterwards == "third message",
  ]
  return JSON.stringify(facts)
}

// Before any block has been built there is nothing to replace.
node noBlockYetSendsNothing(): boolean {
  setAgentCwd(tree() + "/repo/sub/empty")
  return withProjectContextIfMoved("only message") == "only message"
}

def rejectEverything(intr: any): any {
  return reject()
}

// The block for a moved folder is read inside the agent's policy handler.
// With no rule for the read, where the user would be asked, the harness's
// own read of the instruction files is approved, and the same file read
// any other way still goes to the handler, which here rejects it.
node movedBlockIsReadUnderAPolicy(): string {
  if (!buildTree()) {
    return "could not build the tree"
  }
  setAgentCwd(tree() + "/repo/sub/work")
  projectContextText()
  setAgentCwd(tree() + "/repo/sub/empty")
  const policy = approvingInstructionReads.partial(policyHandler: rejectEverything, rules: {})
  let moved = ""
  let direct: any = null
  handle {
    moved = withProjectContextIfMoved("second message")
    direct = read("CLAUDE.md", tree() + "/repo/sub")
  } with policy
  clearTree()
  const facts = [moved.includes("sub rules"), moved.includes("root rules"), direct is failure]
  return JSON.stringify(facts)
}

// A rule that rejects reading one folder still wins: that folder's
// instructions are left out, and the others are read.
node rejectRuleStillStopsTheRead(): string {
  if (!buildTree()) {
    return "could not build the tree"
  }
  setAgentCwd(tree() + "/repo/sub/work")
  projectContextText()
  setAgentCwd(tree() + "/repo/sub/empty")
  const rules = {
    "std::read": [{ match: { dir: tree() + "/repo/sub" }, action: "reject" }]
  }
  const policy = approvingInstructionReads.partial(policyHandler: rejectEverything, rules: rules)
  let moved = ""
  handle {
    moved = withProjectContextIfMoved("second message")
  } with policy
  clearTree()
  const facts = [moved.includes("sub rules"), moved.includes("root rules")]
  return JSON.stringify(facts)
}
