import { Code, combine, fill } from "std::agency"

export def makeFieldGetters(names: string[]): Code {
  let parts = []
  for (name in names) {
    const one = fill([|
      def #fnName(): string {
        return #label: string
      }
    |], { fnName: "field_${name}", label: name })
    if (isFailure(one)) {
      return [| 0 |]
    }
    parts = [...parts, one.value]
  }
  const merged = combine(parts)
  if (isFailure(merged)) {
    return [| 0 |]
  }
  return merged.value
}
