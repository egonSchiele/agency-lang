import { _exit } from "agency-lang/stdlib-lib/system.js"
import { _isLogging } from "agency-lang/stdlib-lib/statelog.js"
import { _pause } from "agency-lang/stdlib-lib/agentTerminalDriver.js"
import { parseArgs } from "std::args"
import { map } from "std::array"
import { setLlmOptions } from "std::llm"
import { disableMemory } from "std::memory"
import { cliPolicyHandler } from "std::policy"
import { evalOutput, evalValue, setAgentName } from "std::statelog"
import { cwd, env, isTTY, readStdin, setTitle } from "std::system"
import { getCost } from "std::thread"
import { setSlashPalette } from "std::ui/cli"
import { pushMessage, repl, clearScreen } from "std::ui/cli"

import { agencyAgentBrains } from "std::agents/agency"

import { agentNameFor } from "./lib/agentName.agency"
import { parseAgentArgs } from "./lib/args.agency"
import { mergedPalette } from "./lib/commandPalette.agency"
import { getHeader } from "./lib/header.agency"
import { maybeLoadMcp } from "./lib/mcp.agency"
import { getPolicyForAgent, printPolicyHelp } from "./lib/policy.agency"
import { activePreset, presetTable, serverNotice, startPreset } from "./lib/presets.agency"
import { startInteractive } from "./lib/repl.agency"
import { chooseSession, incognitoProblem, newSessionRecord } from "./lib/resume.agency"
import { pickModelsForAgent } from "./lib/session.agency"
import { SessionRecord } from "./lib/sessions.agency"
import { loadSettings } from "./lib/settings.agency"
import {
  SessionPolicy,
  newSessionPolicy,
  programStartFor,
  resumeSessionRun,
  resumedSessionPolicy,
  setSessionPolicyFile,
  startSessionRun,
 } from "./lib/terminal.agency"
import { applyToolLimits, limitFlagsFromArgs, setStartupLimitFlags } from "./lib/toolLimits.agency"
import { setDebug, setVerbose, setInteractive } from "./lib/trace.agency"
import { runSession, setPolicyArg } from "./lib/runSession.agency"
import {
  setBrainName,
  runTurn,
  resolveBrainName,
  resolveStartTarget,
  startTargetsFor,
 } from "./lib/turn.agency"
import { formatTurnFailure } from "./lib/utils.agency"
import { getCapabilities } from "./shared.agency"

def oneShotAgent(target: string, prompt: string): string {
  setInteractive(false)
  // Mark the input and reply in the statelog so a one-shot run is gradable:
  // `agency eval grade` reads the agent's output from the trace's
  // `evalOutputRecorded` events, not from stdout.
  evalValue(prompt)
  let reply = ""
  runSession(false) {
    const result = try runTurn(target, prompt)
    // Not `match`: a match expression inside a block body keeps its value on
    // the wrong stack, so `reply` would end up null (compiler bug).
    if (result is success(r)) {
      reply = r
    } else if (result is failure(f)) {
      reply = formatTurnFailure(f)
    }
  }
  evalOutput(reply)
  return reply
}

/** The process-level setup a one-shot run does in this run. An
  interactive session does it in its own run, the session program's. */
def setUpOneShot(args: any) {
  // The preset must be chosen before models resolve: it is one of their layers.
  startPreset(args.flags.preset ?? "", loadSettings())
  pickModelsForAgent(args)
  // Memory stays off for the agent. After every model reply it ran a fact
  // extraction and a summary on another model, and the tool calls waited
  // for both, often a minute or more per round.
  disableMemory() with approve
  setStartupLimitFlags(limitFlagsFromArgs(args))
  applyToolLimits(activePreset(), true)
  const capsMaxTokens = getCapabilities().maxTokens
  if (capsMaxTokens != null) {
    setLlmOptions({
      maxTokens: capsMaxTokens
    })
  }
}

/** The policy an incognito session runs under. It is not saved, so it
  carries no policy of its own. */
def incognitoPolicy(flags: any): SessionPolicy {
  const resolved = getPolicyForAgent(flags.policy ?? "", flags.approve ?? "", flags.reject ?? "", true)
  return { policy: resolved.startPolicy ?? {}, file: resolved.policyFile }
}

/** The interactive terminal: picks the session, runs it under its policy,
  and runs the REPL on it. The session program runs in its own run,
  through the driver; this run draws the prompt and asks the person. */
def interactive(args: any, brainName: string, startAgent: string, seedPrompt: string, incognito: boolean) {
  setSlashPalette(mergedPalette())
  let chosen: SessionRecord | null = null
  if (!incognito) {
    chosen = chooseSession(args.flags.continue, args.flags.resume ?? null)
  }
  let record: SessionRecord | null = null
  let sessionPolicy: SessionPolicy = { policy: {}, file: "" }
  if (chosen != null) {
    sessionPolicy = resumedSessionPolicy(chosen.id, args.flags)
  } else if (incognito) {
    sessionPolicy = incognitoPolicy(args.flags)
  } else {
    const fresh = newSessionRecord(brainName)
    record = fresh
    sessionPolicy = newSessionPolicy(fresh.id, args.flags)
  }
  setSessionPolicyFile(sessionPolicy.file)
  // The shell's own interrupts (`!cmd` needs none, but an MCP connect or
  // an `/image` read does) are judged by the session's policy too, and an
  // "always" answer to a session's approval is saved by this handler's
  // state (askAbout).
  const handler = cliPolicyHandler(
    file: sessionPolicy.file,
    policy: sessionPolicy.policy,
    interactive: true,
  )
  handle {
    setTitle("Agency Agent")
    clearScreen()
    if (chosen != null) {
      resumeSessionRun(chosen)
    } else {
      startSessionRun(programStartFor(args, brainName, record))
      print(getHeader(brainName, _pause()))
    }
    const firstPause: any = _pause() ?? {}
    const notice = serverNotice(presetTable(), firstPause.preset ?? "")
    if (notice != "") {
      print(color.yellow(notice))
    }
    if (incognito) {
      print(
        color.yellow(
          "Incognito: nothing from this session is logged or saved. Your messages still go to the model provider.",
        ),
      )
    }
    startInteractive(startAgent, seedPrompt, saveHistory: !incognito)
  } with handler
}

/* A seeded turn is if the user invokes the Agency agent with
an initial prompt – by using the agency doctor command, for example.
It means that agent starts with an initial prompt already there to respond to. */

node main() {
  // Parse CLI flags first — `parseArgs` exits on --help / --version /
  // usage errors, before any handlers or the TUI are installed.
  const args = parseAgentArgs()

  // NOTE: --trace / --log / --agent-home are declared here only for
  // --help and so parseArgs accepts them. runBundledAgent extracts them from
  // the forwarded args and passes them to this process via env vars
  // (AGENCY_CONFIG_OVERRIDES for the first two, AGENCY_AGENT_HOME for the
  // last).

  if (args.flags.debug) {
    setDebug(true)
  }
  if (args.flags.verbose) {
    setVerbose(true)
  }

  // `--policy` is an optional-value flag: a bare `--policy` (no name or
  // path) prints the usage + the built-in policies and exits, rather than
  // silently doing nothing.
  if (args.flags.policy == "") {
    printPolicyHelp()
    _exit(0)
  }
  setPolicyArg(
    args.flags.policy ?? "",
    approve: args.flags.approve ?? "",
    reject: args.flags.reject ?? "",
  )

  const brainName = resolveBrainName(args.flags.brain ?? null, loadSettings())
  const brainNames = map(agencyAgentBrains(), \entry -> entry.name)
  if (!brainNames.includes(brainName)) {
    print(color.red("Unknown --brain value: ${brainName}. Valid: ${brainNames.join(", ")}"))
    _exit(1)
    return
  }
  setBrainName(brainName)

  // Positional args (everything after flags) are joined with spaces to
  // form the starting prompt. `--` ends flag parsing if a positional
  // would otherwise look like a flag.
  const positionalQuery = args.positionals.join(" ")
  const hasQuery = positionalQuery != ""
  const wantInteractive = args.flags.interactive

  // Seeded interactive: run the prompt as the first turn, then hand over the
  // REPL (needs a TTY + query, and not --print). Everything else is one-shot.
  const seededInteractive = wantInteractive && hasQuery && isTTY() && !args.flags.print
  const isOneShot = !seededInteractive && (args.flags.print || hasQuery || !isTTY())

  // Group this trace under its brain wherever runs are compared.
  setAgentName(agentNameFor(brainName))

  // Validate the --agent target up front, before any model or session setup.
  const requestedStartTarget = args.flags.agent ?? ""
  const resolvedStartTarget = resolveStartTarget(brainName, requestedStartTarget)
  let startAgent = ""
  if (resolvedStartTarget == null) {
    const validTargets = ["main", ...startTargetsFor(brainName)].join(", ")
    print(
      color.red(
        "Unknown --agent value: ${requestedStartTarget}. Valid for the ${brainName} brain: ${validTargets}",
      ),
    )
    _exit(1)
    return
  } else {
    startAgent = resolvedStartTarget
  }

  // Store the configured MCP servers. They connect on the first turn, under
  // the policy handler, which answers each stdio server's mcp::connect.
  // They are the process's, so the session run uses them too.
  maybeLoadMcp(loadSettings())
  setAgentCwd(cwd())

  // One-shot runs are not saved, so a resume flag on one is a mistake
  // rather than something to ignore.
  if (isOneShot && (args.flags.continue || args.flags.resume != null)) {
    print(
      color.red(
        "--continue and --resume need an interactive session; one-shot runs are not saved.",
      ),
    )
    _exit(1)
  }
  // The launcher already turned logging off; here the agent's own records
  // go too. Incognito takes the one-shot path: no session, so nothing saved.
  const incognito = args.flags.incognito
  if (incognito) {
    const problem = incognitoProblem(args.flags.continue, args.flags.resume ?? null, _isLogging())
    if (problem != "") {
      print(color.red(problem))
      _exit(1)
    }
  }

  if (!isOneShot) {
    interactive(args, brainName, startAgent, positionalQuery, incognito)
    return
  }

  setUpOneShot(args)
  let prompt = positionalQuery
  if (!hasQuery) {
    const fromStdin = readStdin()
    if (fromStdin == null || fromStdin == "") {
      _exit(0)
    }
    prompt = fromStdin
  }
  print(oneShotAgent(startAgent, prompt))
  const roundedCost = "$${getCost().toFixed(4)}"
  print(color.dim("\nSession cost: ${roundedCost}"))
}
