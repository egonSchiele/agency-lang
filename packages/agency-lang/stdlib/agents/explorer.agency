import { hostedSearchTools, searchTools } from "std::agents/lib/search"
import { AGENT_SPILL_OVER, llmOptions, withContext } from "std::agents/lib/shared"
import {
  readOnlyFileTools,
  agencyDocTools,
  webTools,
  spillTools,
  SAVE_DRAFT_HINT,
  ASK_USER_HINT,
 } from "std::agents/lib/toolkits"
import { guarded } from "std::decorators"
import { agentSkill } from "std::skills"
import { ensureSystemMessage } from "std::thread"

import { communicationTools } from "./lib/toolkits.agency"

/** @module
@summary Survey a codebase or documentation and return an organized answer.

Use `explorerAgent` for documentation summaries, module tours, and explanations
that span many files. Its built-in tools read files and sources. Use
`oracleAgent` for a focused design judgment.

When called as an LLM tool, the explorer continues the caller's conversation.
From code, wrap the call in `thread { ... }` when you want an isolated survey.
*/

static const skills = agentSkill("explorer")

static const systemPrompt = """
Survey the requested codebase or documentation and explain what exists.
Cover the full scope the caller asked for. Leave design judgments and
recommendations to the oracle. Do not change files or run commands.

- Inventory the relevant directories before choosing what to read. For a
  docs survey, inspect the docs tree so you do not miss whole sections.
- Read the relevant files before drawing conclusions. Batch independent
  reads and searches in one turn. Complete the coverage you planned.
- Lead with a short answer, then organize findings by theme. Explain
  connections across files rather than summarizing each file in turn.
- Cite a file path for every substantive claim, with line numbers when
  useful. State gaps in what you could find.
- Use a small fenced text diagram when it helps explain a pipeline,
  module structure, or data flow.

Use the bundled Agency docs as the authority on the language.
`agencyStdlib` lists the available std:: modules with summaries.

A broad request is enough to begin a survey. Do not ask the caller to
narrow it. Ask only for missing facts you cannot find by reading.
Use `whatIAmDoing` to keep the user informed as you work.${ASK_USER_HINT}${SAVE_DRAFT_HINT}
"""

// Read-only by design: the explorer surveys and describes, and a surveyor
// that can edit is no longer a surveyor.
export def buildTools(): any[] {
  """
  Return the explorer's file, source, and web lookup tools.
  """
  return [
    ...readOnlyFileTools(),
    ...agencyDocTools(),
    ...webTools(),
    ...spillTools(),
    ...searchTools(),
    ...communicationTools(),
    skills,
  ]
}

def survey(
  question: string,
  context: string,
  model: string,
  provider: string,
  extraTools: any[],
): string {
  ensureSystemMessage(systemPrompt)
  return llm(
    withContext(task: question, context: context),
    llmOptions(
    model: model,
    provider: provider,
    tools: [...buildTools(), ...extraTools, saveDraft],
    spillToolResultsOver: AGENT_SPILL_OVER,
    hostedTools: hostedSearchTools(model, provider),
    reasoningEffort: "high",
    thinking: true,
  ),
  )
}

/** Called from code, this runs on the caller's thread like any function:
  the system prompt, the reads, and the answer stay there. Wrap the call
  in `thread { ... }` for an isolated survey. */
@guarded(cost: maxCost, time: maxTime)
export handoff def explorerAgent(
  question: string,
  context: string = "",
  maxCost: number = $20.00,
  maxTime: number = 15m,
  model: string = "",
  provider: string = "",
  extraTools: any[] = [],
): Result<string> {
  """
  Survey a codebase or documentation and return an organized answer with sources.
  It never changes anything. It continues your conversation, and every file it
  reads stays in your history, so say how much ground to cover and scope the
  question tightly.

  @param question - The question and the scope to cover.
  @param maxCost - Cost budget in USD.
  @param maxTime - Time budget in milliseconds.
  @param model - Model override, or "" for the ambient model.
  @param provider - Provider for the model override, ignored when model is empty.
  @param extraTools - Tools to add to the built-in lookup tools.
  """

  // Return position: a draft the model saved reaches the guard, which
  // returns it as the backup answer if the budget runs out.
  return survey(
    question: question,
    context: context,
    model: model,
    provider: provider,
    extraTools: extraTools,
  )
}
