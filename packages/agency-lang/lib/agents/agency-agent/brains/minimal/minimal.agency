/** @module
  @summary A coding brain with six tools and a short prompt: each turn is
  one tool loop in a single conversation thread, with no subagents. For
  benchmarks and sandboxed runs, where every tool definition and prompt
  line is paid for on every request.
*/
import { AGENT_SPILL_OVER } from "std::agents/lib/shared"
import { codingFileAndShellTools, CODING_RULES } from "std::agents/lib/toolkits"
import { Attachment, systemMessage } from "std::thread"

import { AgentBrain, BrainContext } from "../brain.agency"
import { addGlobalInstructions } from "../../lib/globalInstructions.agency"

// Per-run grounding, from BrainContext. Spliced into the system prompt.
let _context: string = ""

let first = true

def minimalInit(context: BrainContext) {
  _context = context.grounding
  first = true
}

def minimalRunTurn(
  target: string,
  prompt: string | (string | Attachment)[],
): string {
  thread(label: "minimal", session: "minimal") {
    if (first) {
      systemMessage("${CODING_RULES}${_context}")
      first = false
    }
    addGlobalInstructions()
    const result = llm(
      prompt,
      tools: codingFileAndShellTools(),
      spillToolResultsOver: AGENT_SPILL_OVER,
    )
  }
  return result
}

export def minimalBrain(): AgentBrain {
  return {
    name: "minimal",
    session: "minimal",
    description: "One coder with six tools (read, bash, edit, write, readSpill, grepSpill) and a short prompt",
    startTargets: [],
    init: minimalInit,
    runTurn: minimalRunTurn
  }
}
