/** @module
  @summary PROTOTYPE. The stdlib review agent, adapted to the agency-review
  suite's contract: input { task, source } in, Feedback[] out. Any other
  review implementation competes on the same suite by supplying its own
  adapter file like this one.

  Run the suite against it with:
    pnpm run agency eval run evals/agency-review/agents/stdlib.agency \
      --suite evals/agency-review --out runs/agency-review
*/
import { agencyReviewAgent } from "std::agents/agency/review"
import { Feedback } from "std::agents/lib/feedback"
import { evalValue } from "std::statelog"

type ReviewInput = {
  task: string;
  source: string
}

// The adapter, not the suite, says which model the implementation runs on:
// "stdlib reviewer on openai-responses/gpt-4o-mini" is the thing under
// test. Named explicitly here because with the repo's agency.json (base
// "openai" provider) the reviewer asks for hosted web_search, the provider
// refuses, and the judgment silently fails open to "no findings".
static const MODEL = "gpt-4o-mini"
static const PROVIDER = "openai-responses"

node main(input: ReviewInput): Feedback[] {
  evalValue(input)
  const reviewed = agencyReviewAgent(
    source: input.source,
    task: input.task,
    model: MODEL,
    provider: PROVIDER,
  )
  if (reviewed is failure(err)) {
    return [{ error: true, feedback: "review agent failed: ${err}" }]
  }
  return reviewed.value
}
