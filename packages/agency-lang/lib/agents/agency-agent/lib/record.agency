/** @module
  @summary The session a run writes to: its record, the turn count, the
  title, and the thread the conversation runs on. This is session state,
  so it lives apart from resume.agency, which picks a session at the
  terminal.
*/
import { now } from "std::date"

import {
  SessionRecord,
  displayTitle,
  newSessionId,
  projectDir,
 } from "./sessions.agency"
import { cleanTitle, conversationText, shouldRefreshTitle, titleFor } from "./sessionTitle.agency"

// The session this run writes to; null for one-shot runs, which are not
// saved. A `let`, so a restore brings back the resumed session's own
// record, turn count and title included.
let _current: SessionRecord | null = null

// Set by the REPL when a turn ran to completion, so a slash command or an
// empty line is not recorded as a turn.
let _turnDone = false

// Set at startup by an --incognito run, which has no session, so
// /rename can say why.
let _incognito = false

// Set by `/rename`: the record changed without a turn, and the title is
// the user's now.
let _renamed = false
let _titlePinned = false

// The slug id of the thread the conversation runs on, such as "t3". The
// harness records it after each turn. Compaction, the title, and the
// transcript find the conversation by it.
let _conversationThread = ""

/** Where to write after a turn: the session directory and its index row. */
export type SaveTarget = {
  dir: string;
  record: SessionRecord
}

/** The footer text: the session title, or "" before the first turn. */
export def sessionTitle(): string {
  const record = _current
  if (record == null) {
    return ""
  }
  return displayTitle(record)
}

export def markTurnDone() {
  _turnDone = true
}

/** What a rename did: the title the session has now. */
export type Renamed = {
  title: string
}

/** What a fork did: the id this run writes to now, and the id of the
  session it was copied from, which stays on disk as it was last saved. */
export type Forked = {
  id: string;
  forkedFrom: string
}

/** `/rename <title>`: give the session a title of the user's choosing.
  Fails with "not saved" when this run has no session, and with "empty
  title" when the title is blank once cleaned. Each front-end words the
  result itself. The REPL saves after it. */
export def renameSession(title: string): Result<Renamed> {
  const record = _current
  if (record == null) {
    return failure("not saved")
  }
  const clean = cleanTitle(title)
  if (clean == "") {
    return failure("empty title")
  }
  record.title = clean
  _renamed = true
  _titlePinned = true
  return success({ title: clean })
}

/** A `folder` answer moved the session: the record says its new folder,
  and it was active now, so a front-end that keeps the newer of two copies
  keeps the moved one. Does nothing for a run with no session, or for the
  folder the record already names: that is no move, and a front-end that
  sorts by `lastActive` must not move the chat for it. */
export def moveRecord(cwd: string) {
  const record = _current
  if (record == null || record.cwd == cwd) {
    return
  }
  record.cwd = cwd
  record.lastActive = now()
}

/** The id of the session this run writes to, or "" when it has none. */
export def currentSessionId(): string {
  const record = _current
  if (record == null) {
    return ""
  }
  return record.id
}

/** Record the thread the conversation runs on. An empty id is ignored. */
export def setConversationThread(id: string) {
  if (id != "") {
    _conversationThread = id
  }
}

/** The slug id of the conversation's thread, or "" before the first turn. */
export def conversationThread(): string {
  return _conversationThread
}

/** `/fork`: from here on this run writes to a new session, a copy of the
  one it was. The original stays on disk as it was last saved. Fails with
  "not saved" when this run has no session, and with "no turns" when it
  has none to copy. Each front-end words the result itself. The REPL
  saves after it. */
export def forkSession(): Result<Forked> {
  const record = _current
  if (record == null) {
    return failure("not saved")
  }
  if (record.turns == 0) {
    return failure("no turns")
  }
  const t = now()
  const id = newSessionId()
  _current = {
    id: id,
    cwd: record.cwd,
    brain: record.brain,
    created: t,
    lastActive: t,
    turns: record.turns,
    title: record.title,
    forkedFrom: record.id
  }
  // Marks the record changed, so it is saved without a turn.
  _renamed = true
  return success({ id: id, forkedFrom: record.id })
}

/** An --incognito run has no session: nothing is saved and no title is
  made. Marks the run so /rename can say why. */
export def startIncognito() {
  _incognito = true
}

/** Whether this is an --incognito run, so the terminal can say why it has
  no session to rename or fork. */
export def isIncognito(): boolean {
  return _incognito
}

/** Make `record` the session this run writes to. Null is a run that is
  not saved. */
export def setCurrentRecord(record: SessionRecord | null) {
  _current = record
}

/** The session this run writes to, or null when it is not saved. */
export def currentRecord(): SessionRecord | null {
  return _current
}

/** Record a completed turn: bump the count, refresh the title when due,
  and say where the checkpoint should be written. Null when there is
  nothing to save: no turn ran and no rename happened. */
export def recordTurn(userMsg: string): SaveTarget | null {
  const record = _current
  if (record == null || (!_turnDone && !_renamed)) {
    return null
  }
  // Before the early return below, so a save with no turn behind it, such
  // as after /fork or /rename, also carries the id.
  if (_conversationThread != "") {
    record.conversationThread = _conversationThread
  }
  _renamed = false
  if (!_turnDone) {
    return {
      dir: projectDir(),
      record: record
    }
  }
  _turnDone = false
  record.turns = record.turns + 1
  record.lastActive = now()
  if (!_titlePinned && shouldRefreshTitle(record.turns)) {
    // Title the conversation so far, the reply included, so turn 1 sees
    // the first exchange and not just the prompt. The prompt alone is the
    // fallback when the brain's thread cannot be read.
    let source = conversationText(_conversationThread)
    if (source == "") {
      source = userMsg
    }
    const title = titleFor(source)
    if (title != "") {
      record.title = title
    }
  }
  return {
    dir: projectDir(),
    record: record
  }
}

/** Where to save a session whose turn waits on an approval, or null for
  a run that is not saved. The record is as it was before the turn: the
  turn has not finished, so it is not counted. */
export def waitingTarget(): SaveTarget | null {
  const record = _current
  if (record == null) {
    return null
  }
  if (_conversationThread != "") {
    record.conversationThread = _conversationThread
  }
  return {
    dir: projectDir(),
    record: record
  }
}
