import { foo } from "./foo.agency"

export def callFoo(effect: string, dir: string = "."): string {
  let outcome = ""
  handle {
    const result = foo(effect, dir)
    if (result is success(v)) {
      outcome = "approved"
    }
    if (result is failure(e)) {
      outcome = "rejected: ${e}"
    }
  } with (data) {
    if (data.effect == "std::read") {
      return approve()
    }
    if (data.effect == "std::write") {
      if (data.data.dir == ".") {
        return approve()
      }
      return reject("only writes to the current directory are allowed")
    }
    return reject("email is never allowed")
  }
  return outcome
}
