import { codeAgent, setCodeOneShot } from "../../../lib/agents/agency-agent/brains/coordinator/subagents/code.agency"

node agencyTaskUsesWorker(): string {
  setCodeOneShot(true)
  return codeAgent("Compile and test this Agency project", agencyTask: true) with approve
}

node otherTaskUsesWorker(): string {
  setCodeOneShot(true)
  return codeAgent("Inspect the build output and report the result") with approve
}
