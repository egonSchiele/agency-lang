/** @module
  @summary The harness side of a turn: which brain is selected, the one
  session wrapper that installs the policy handler, and the per-turn work
  (slash expansion, attachments, the hard stop for a subagent budget trip)
  that happens before `agencyAgent` sees the message. See
  docs/dev/agents/agent-brains.md.
*/
import { isCoordinatorBrain } from "std::agents/agency"
import { map } from "std::array"
import { cliPolicyHandler } from "std::policy"
import { expandSlash } from "std::skills"
import { Attachment, currentThreadId } from "std::thread"
import { pushMessage } from "std::ui/cli"

import { answerTurn } from "./answer.agency"
import { detectAttachments, modalityFilter } from "./attachments.agency"
import { guardStopHandler } from "./budget.agency"
import { checkCliBundles } from "./cliTools.agency"
import { slashCommands } from "./commandPalette.agency"
import { groundingText, setGrounding } from "./grounding.agency"
import { getPolicyForAgent } from "./policy.agency"
import { approvingInstructionReads, withProjectContextIfMoved } from "./projectContext.agency"
import { setConversationThread } from "./resume.agency"
import { setMessageRewritten } from "./rewrittenMessage.agency"
import { Settings } from "./settings.agency"
import { START_TARGETS, runStartTarget } from "./startTargets.agency"

export static const DEFAULT_BRAIN = "coordinator"

// The brain this run talks to. Set once by main(); read by runTurn/runSession.
let _brainName: string = ""

// The `--policy` argument (a built-in name or a policy-file path), or ""
// when absent. main() sets it; policyHandlerFor() reads it.
let _policyArg: string = ""

// The `--approve` / `--reject` arguments (effect lists), or "" when
// absent. Session-only overlays on the resolved policy.
let _approveArg: string = ""
let _rejectArg: string = ""

export def setBrainName(name: string) {
  _brainName = name
}

export def currentBrainName(): string {
  return _brainName
}

// A missing brain is a harness bug: main() must call setBrainName() before
// runSession or runTurn.
static const NO_BRAIN = "No brain selected: main() must call setBrainName() first"

export def setPolicyArg(arg: string, approve: string = "", reject: string = "") {
  _policyArg = arg
  _approveArg = approve
  _rejectArg = reject
}

/** The `--agent` values a brain accepts besides `main`. Only the
  brains built on the coordinator have subagents to start. */
export def startTargetsFor(brainName: string): string[] {
  if (isCoordinatorBrain(brainName)) {
    return START_TARGETS
  }
  return []
}

export def resolveStartTarget(
  brainName: string,
  requested: string,
): string | null {
  """
  Normalize the CLI's `main` alias to the empty main target and reject names
  the selected brain does not expose.
  """
  let target = requested
  if (target == "main") {
    target = ""
  }
  if (target != "" && !startTargetsFor(brainName).includes(target)) {
    return null
  }
  return target
}

export def resolveBrainName(flag: string | null, settings: Settings): string {
  """
  Which brain to run: the --brain flag, else the `brain` setting, else the
  default.
  """
  if (flag != null && flag != "") {
    return flag
  }
  // settings.json is hand-editable, so check the runtime shape, not just
  // the declared type.
  const fromSettings = settings.brain
  if (fromSettings is string && fromSettings != "") {
    return fromSettings
  }
  return DEFAULT_BRAIN
}

/** True when the session's approvals come from the saved policy file,
  and false under --policy, --approve, or --reject, which run on a
  per-session copy that is never written back to it. */
export def usesSavedPolicy(): boolean {
  return _policyArg == "" && _approveArg == "" && _rejectArg == ""
}

// Load (or initialize) the policy and return the installed CLI policy handler.
def policyHandlerFor(interactive: boolean): any {
  const { policyFile, startPolicy } = getPolicyForAgent(_policyArg, _approveArg, _rejectArg, interactive)
  const handler = cliPolicyHandler(
    file: policyFile,
    policy: startPolicy,
    // One-shot (-p) runs have no user at a terminal: an undecided effect
    // is rejected with a reason the model reads, never prompted.
    interactive: interactive,
  )
  return approvingInstructionReads.partial(policyHandler: handler, rules: startPolicy ?? {})
}

export def runSession(interactive: boolean, body: () -> void raises <*>) {
  """
  The only place a turn is answered from. Builds the grounding once, then
  installs the policy handler, checks the bundled files under it, and runs
  `body` (the one-shot turn or the REPL) under it. Both production paths
  go through here.
  """
  if (_brainName == "") {
    throw(NO_BRAIN)
    return
  }
  // Built before the policy handler exists, so reading the project's
  // AGENTS.md never prompts. Every turn adds this same string.
  setGrounding(groundingText(_brainName))
  const handler = policyHandlerFor(interactive)
  handle {
    checkCliBundles()
    body()
  } with handler
}

def checkForAttachments(expanded: string): Attachment[] {
  // Auto-attach image/PDF files the user referenced (drag-drop or typed
  // path), filtered to what the resolved model accepts. Never silent:
  // every attach and every skip prints a visible line.
  const detected = modalityFilter(detectAttachments(expanded))
  for (skippedFile in detected.skipped) {
    pushMessage(
      color.yellow("📎 skipped ${skippedFile.label} (${skippedFile.reason})"),
    )
  }
  if (detected.attached.length == 0) {
    return []
  }
  for (item in detected.attached) {
    pushMessage(color.dim("📎 attached ${item.label}"))
  }
  const attachments = map(detected.attached) as item {
    return item.attachment
  }
  return attachments
}

def dispatchToBrain(target: string, userMsg: string): string {
  if (_brainName == "") {
    throw(NO_BRAIN)
    return ""
  }
  // A coder may have changed the agent's working directory on an earlier
  // turn. The model then needs that folder's instructions with this message.
  const expanded = withProjectContextIfMoved(expandSlash(userMsg, slashCommands()))
  setMessageRewritten(expanded != userMsg)
  if (target != "") {
    return runStartTarget(target, expanded)
  }
  const attachments = checkForAttachments(expanded)
  return answerTurn(_brainName, expanded, attachments)
}

export def runTurn(target: string, userMsg: string): string {
  """
  Run one user turn. A subagent's budget trip that no inner handler owns is
  answered here as a hard stop, so the subagent returns its best result and
  the brain continues. A whole-agent limit comes only from the `--max-time`
  and `--max-cost` flags, which the runtime enforces as a root budget.
  """
  // The turn runs on this run's active thread, which is the conversation.
  // Recorded before the turn too, so a turn the user cancels still leaves
  // the id behind.
  setConversationThread(currentThreadId())
  let reply = ""
  handle {
    reply = dispatchToBrain(target, userMsg)
  } with guardStopHandler
  setConversationThread(currentThreadId())
  return reply
}
