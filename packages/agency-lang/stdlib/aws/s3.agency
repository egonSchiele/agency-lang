import {
  _s3Get,
  _s3GetBinary,
  _s3Put,
  _s3PutBinary,
  _createBucket,
  _s3PresignGet,
 } from "agency-lang/stdlib-lib/aws/s3.js"

/** @module
  @summary Read and write S3 objects, create buckets, and share download links.
  Read and write text or binary objects in Amazon S3, create buckets, and
  generate presigned download links. No AWS SDK installation is needed.

  Credentials come from the standard AWS environment variables
  (`AWS_ACCESS_KEY_ID`, `AWS_SECRET_ACCESS_KEY`, and optionally
  `AWS_SESSION_TOKEN`). The region defaults to `AWS_REGION`, then `us-east-1`,
  and can be overridden per call.

  ```ts
  import { s3Put, s3Get } from "std::aws/s3"

  node main() {
    s3Put("my-bucket", "notes.txt", "hello") with approve
    const text = s3Get("my-bucket", "notes.txt") with approve
    print(text)
  }
  ```

  Bind `bucket` with `.partial(bucket: "my-bucket")` before handing a
  function to an agent to keep that tool within one bucket.

  Binary uploads and downloads use base64 strings.
*/

effect std::aws::s3::get {
  bucket: string;
  key: string;
  region: string
}

effect std::aws::s3::getBinary {
  bucket: string;
  key: string;
  region: string
}

effect std::aws::s3::put {
  bucket: string;
  key: string;
  region: string
}

effect std::aws::s3::putBinary {
  bucket: string;
  key: string;
  region: string
}

effect std::aws::s3::createBucket {
  bucket: string;
  region: string
}

effect std::aws::s3::presignGet {
  bucket: string;
  key: string;
  expiresIn: number;
  region: string
}

/** The result of a successful `s3Put` / `s3PutBinary`. */
export type S3PutResult = {
  bucket: string;
  key: string;
  url: string;
  etag: string
}

/** The result of a successful `createBucket`. */
export type S3CreateBucketResult = {
  bucket: string;
  region: string;
  location: string
}

@capabilities(network)
export def s3Get(
  bucket: string,
  key: string,
  region: string = "",
): Result<string> raises <std::aws::s3::get> {
  """
  Download an S3 object as UTF-8 text.

  @param key - A non-empty object key with no complete "." or ".." path segments.
  @param region - Leave empty to use AWS_REGION, then us-east-1.
  """
  return interrupt std::aws::s3::get("Allow reading the object '${key}' from S3 bucket '${bucket}'?", {
    bucket: bucket,
    key: key,
    region: region
  })
  return try _s3Get(bucket, key, region)
}

@capabilities(network)
export def s3GetBinary(
  bucket: string,
  key: string,
  region: string = "",
): Result<string> raises <std::aws::s3::getBinary> {
  """
  Download an S3 object as a base64 string.

  @param key - A non-empty object key with no complete "." or ".." path segments.
  @param region - Leave empty to use AWS_REGION, then us-east-1.
  """
  return interrupt std::aws::s3::getBinary("Allow reading the binary object '${key}' from S3 bucket '${bucket}'?", {
    bucket: bucket,
    key: key,
    region: region
  })
  return try _s3GetBinary(bucket, key, region)
}

@capabilities(network)
export def s3Put(
  bucket: string,
  key: string,
  content: string,
  region: string = "",
  contentType: string = "text/plain",
): Result<S3PutResult> raises <std::aws::s3::put> {
  """
  Upload UTF-8 text to an S3 object.

  @param key - A non-empty object key with no complete "." or ".." path segments.
  @param region - Leave empty to use AWS_REGION, then us-east-1.
  @param contentType - The MIME type readers should use for the object.
  """
  return interrupt std::aws::s3::put("Allow writing the object '${key}' to S3 bucket '${bucket}'?", {
    bucket: bucket,
    key: key,
    region: region
  })
  destructive {
    return try _s3Put(bucket, key, content, region, contentType)
  }
}

@capabilities(network)
export def s3PutBinary(
  bucket: string,
  key: string,
  base64: string,
  region: string = "",
  contentType: string = "application/octet-stream",
): Result<S3PutResult> raises <std::aws::s3::putBinary> {
  """
  Upload base64-encoded binary to an S3 object.

  @param key - A non-empty object key with no complete "." or ".." path segments.
  @param region - Leave empty to use AWS_REGION, then us-east-1.
  @param base64 - Valid base64 encoding of the bytes to upload.
  @param contentType - The MIME type readers should use for the object.
  """
  return interrupt std::aws::s3::putBinary("Allow writing the binary object '${key}' to S3 bucket '${bucket}'?", {
    bucket: bucket,
    key: key,
    region: region
  })
  destructive {
    return try _s3PutBinary(bucket, key, base64, region, contentType)
  }
}

/**
  The URL is computed locally without downloading the object. Treat it
  as a credential: anyone holding it can download the object. With temporary
  AWS credentials, it stops working when the session expires even if the
  requested expiry is later.
*/
export def s3PresignGet(
  bucket: string,
  key: string,
  expiresIn: number = 1h,
  region: string = "",
): Result<string> raises <std::aws::s3::presignGet> {
  """
  Create a shareable download URL for a private S3 object.

  @param key - A non-empty object key with no complete "." or ".." path segments.
  @param expiresIn - A whole number of milliseconds from 1 through 604800000, at most seven days.
  @param region - Leave empty to use AWS_REGION, then us-east-1.
  """
  raise std::aws::s3::presignGet("Allow creating a download link for '${key}' in S3 bucket '${bucket}', usable by anyone for ${expiresIn}ms?", {
    bucket: bucket,
    key: key,
    expiresIn: expiresIn,
    region: region
  })
  return try _s3PresignGet(bucket, key, expiresIn, region)
}

@capabilities(network)
export def createBucket(
  bucket: string,
  region: string = "",
): Result<S3CreateBucketResult> raises <std::aws::s3::createBucket> {
  """
  Create an S3 bucket.

  @param bucket - A globally unique S3 bucket name.
  @param region - Leave empty to use AWS_REGION, then us-east-1.
  """
  return interrupt std::aws::s3::createBucket("Allow creating the S3 bucket '${bucket}'?", {
    bucket: bucket,
    region: region
  })
  destructive {
    return try _createBucket(bucket, region)
  }
}
