
// sleep is NOT exempt: it is the program deliberately spending time,
// not waiting on a human. A sleep that overruns the budget still trips.
// The handler answers the trip. A time trip during `sleep` raises a
// `std::guard` interrupt at the next step, as a trip between statements
// does, and rejecting it sends the guard down its Failure path.
node main() {
  handle {
  const result = guard(time: 20ms) {
    sleep(150ms)
    sleep(1ms)
    return "did not trip"
  }
  if (isFailure(result)) {
    return "tripped:${result.data.type}"
  }
  return result.value
  } with (i) {
    return match(i.effect) {
      "std::guard" => reject()
      _ => pass()
    }
  }
}
