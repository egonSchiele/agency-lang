import { agentPrompt, bundledDocsDir, docsSkill } from "std::skills"

// A brief docs tool lists each page as one `path - description` line, with no
// XML and no directory path, and the writer's
// tutorial ships with the package. Both are built outside any handler, which
// pins that neither raises an interrupt.
node main() {
  const brief = docsSkill("guide", brief: true)
  const full = docsSkill("guide")
  const tutorial = agentPrompt("agency-tutorial.md")
  return [
    brief.description.includes("\nbasic-syntax.md - "),
    brief.description.includes("<skill>"),
    brief.description.includes(bundledDocsDir()),
    brief.description.length < full.description.length,
    tutorial.includes("## Interrupts"),
  ]
}
