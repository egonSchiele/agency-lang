/** @module
  @summary Which session this run is (new, `--continue`, or `--resume`),
  the picker, the record of a new session, and the restore of a saved
  one. A session is saved from the REPL (lib/stdlib/agentReplSession.ts).
  The files are in sessions.agency and the title in sessionTitle.agency.
*/
import { _checkpointFitsThisCode, _pickUpOnResume } from "agency-lang/stdlib-lib/agentReplSession.js"
import { _isCheckpoint, _readTranscript } from "agency-lang/stdlib-lib/agentSessions.js"
import { _exit } from "agency-lang/stdlib-lib/system.js"
import { now } from "std::date"
import { cwd } from "std::system"
import { chooseOption, ChoiceItem } from "std::ui/cli"

import {
  SessionRecord,
  findSession,
  isEarlierAgentsSession,
  listSessions,
  mostRecentSession,
  newSessionId,
  readCheckpointFile,
  sessionLabel,
 } from "./sessions.agency"
import { showTranscript } from "./transcript.agency"

static const EARLIER_VERSION = "This session was saved by an earlier version of agency agent and can't be continued."

export def incognitoProblem(continueFlag: boolean, resumeArg: string | null, logging: boolean): string {
  """
  Why an --incognito run cannot start, or "" when it can.

  @param continueFlag - Whether --continue was passed
  @param resumeArg - The --resume value, or null when absent
  @param logging - Whether this run's statelog records anything
  """
  if (continueFlag || resumeArg != null) {
    return "--incognito sessions are not saved, so they cannot continue or resume one."
  }
  // The launcher turns logging off. An agent started another way keeps
  // the logging it was built with, and the header would be wrong.
  if (logging) {
    return "--incognito needs logging off, and this run has it on. Start it with agency agent --incognito."
  }
  return ""
}

/** Which saved session, if any, this run continues. `resumeArg` is the
  `--resume` value: null when absent, "" for a bare `--resume` (open the
  picker), else an id. Exits on an unknown id, and on a session the old
  terminal loop saved, which this version can't resume. */
export def chooseSession(
  continueFlag: boolean,
  resumeArg: string | null,
): SessionRecord | null {
  if (resumeArg != null && resumeArg != "") {
    const found = findSession(resumeArg)
    if (found == null && isEarlierAgentsSession(resumeArg)) {
      print(color.red(EARLIER_VERSION))
      _exit(1)
    }
    if (found == null) {
      print(color.red("No saved session with id ${resumeArg} in ${cwd()}."))
      _exit(1)
    }
    return found
  }
  if (resumeArg == "") {
    return pickSession()
  }
  if (continueFlag) {
    const recent = mostRecentSession()
    if (recent == null) {
      print(color.yellow("No saved session for this directory; starting a new one."))
    }
    return recent
  }
  return null
}

def pickSession(): SessionRecord | null {
  const all = listSessions()
  if (all.length == 0) {
    print(color.yellow("No saved sessions for this directory; starting a new one."))
    return null
  }
  const nowMs = now()
  // A "new session" row rather than allowCancel: before the REPL exists,
  // Escape raises a cancellation instead of returning "".
  let items: ChoiceItem[] = [
    {
    key: "new",
    label: "Start a new session"
  },
  ]
  for (record in all) {
    items.push({
      key: record.id,
      label: sessionLabel(record, nowMs)
    })
  }
  const choice = chooseOption(
    "Resume a session",
    "Pick a saved session from this directory.",
    items,
  )
  if (choice == "new") {
    return null
  }
  return findSession(choice)
}

/** The record of a new session, which is saved after its first turn. */
export def newSessionRecord(brainName: string): SessionRecord {
  const t = now()
  return {
    id: newSessionId(),
    cwd: cwd(),
    brain: brainName,
    created: t,
    lastActive: t,
    turns: 0,
    title: "",
    runFormat: "checkpoint"
  }
}

/** Go on with a saved session: print its conversation, then restore its
  checkpoint. The Agency state becomes the saved one and the program
  continues from the saved point, so nothing placed after this call runs.
  Exits with the reason when the session can't be continued. */
export def resumeSession(chosen: SessionRecord) {
  const saved = readCheckpointFile(chosen.id)
  if (saved == null || !_isCheckpoint(saved)) {
    print(color.red("The file for session ${chosen.id} is missing or is not a checkpoint this agent can resume."))
    _exit(1)
  }
  // The runtime refuses a checkpoint paused in code that has changed
  // since. Checked here, so the reason is the agent's and comes before
  // the conversation is printed.
  if (!_checkpointFitsThisCode(saved)) {
    print(color.red(EARLIER_VERSION))
    _exit(1)
  }
  print(color.dim("Resuming: ${chosen.title}"))
  showTranscript(_readTranscript(saved, chosen.conversationThread ?? ""))
  _pickUpOnResume()
  restore(saved, {})
}
