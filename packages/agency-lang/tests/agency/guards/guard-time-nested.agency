
// Nested time guards. The inner guard has a tight budget (20ms) and
// trips on the long sleep; the outer has a generous budget (5s) and
// catches the inner's Failure without itself tripping. Verifies that
// inner trips don't leak into the outer scope (uninstall properly
// restores the outer's abort plumbing).
// The handler answers the trip. A time trip during `sleep` raises a
// `std::guard` interrupt at the next step, as a trip between statements
// does, and rejecting it sends the guard down its Failure path.
node main() {
  handle {
  const outer = guard(time: 5s) {
    const inner = guard(time: 20ms) {
      sleep(150ms)
      sleep(1ms)
      return "inner ran"
    }
    if (isFailure(inner)) {
      return "inner tripped"
    }
    return "inner did not trip"
  }
  if (isFailure(outer)) {
    return "outer tripped (unexpected)"
  }
  return outer.value
  } with (i) {
    return match(i.effect) {
      "std::guard" => reject()
      _ => pass()
    }
  }
}
