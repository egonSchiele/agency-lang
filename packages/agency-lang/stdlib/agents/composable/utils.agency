/** @module
@summary Ask for a reply through a generic interrupt.

`ask` lets the host or a handler supply a value. For a named user-question
effect and a string reply, use `question` from `std::agent`.
*/

export def ask(question: string) raises <unknown> {
  """
  Ask the user a question and return their response.
  """
  const response = interrupt(question)
  return response
}
