import { applyAgentCwd } from "std::index"
import { isAbsolute } from "std::path"

import {
  _ls,
  _grep,
  _glob,
  _stat,
  _exists,
  _which,
  _exec,
  _bash,
  _searchTarget,
 } from "agency-lang/stdlib-lib/shell.js"


/** @module
  @summary Run commands, search files, and inspect filesystem metadata.
  Use `exec` for an executable with separate arguments, or `bash` for shell
  syntax such as pipes and redirects. Use `ls`, `grep`, and `glob` to inspect
  files. These operations request approval. `stat`, `exists`, and `which`
  provide metadata without an approval interrupt.

  ```ts
  import { bash } from "std::shell"

  node main() {
    const result = bash("ls -la") with approve
    print(result.stdout)
  }
  ```
*/

// Exported so `std::safeBash` can declare the same return type on both its
// paths: a fast-path result and a real `bash()` result have to be the same
// shape by construction, not by coincidence.
/** Captured standard output, standard error, and exit code from a command. */
export type ExecResult = {
  stdout: string;
  stderr: string;
  exitCode: number
}

@always(command, subcommand)
effect std::exec {
  command: string;
  args: string[];
  subcommand: string;
  cwd: string;
  timeout: number;
  stdin: string
}
@always(command, cwd)
effect std::bash {
  command: string;
  cwd: string;
  timeout: number;
  stdin: string
}
@alwaysUnder(dir)
effect std::ls {
  dir: string;
  recursive: boolean;
  maxResults: number
}
@alwaysUnder(dir)
effect std::grep {
  pattern: string;
  dir: string;
  file: string | null;
  flags: string;
  maxResults: number;
  ignoreCase: boolean;
  wholeWord: boolean;
  filesOnly: boolean;
  invert: boolean
}
@alwaysUnder(dir)
effect std::glob {
  pattern: string;
  dir: string;
  maxResults: number
}

@capabilities(fileRead, subprocess)
export def exec(
  command: string,
  args: string[] = [],
  cwd: string = "",
  timeout: number = 0,
  stdin: string = "",
  allowedExecutables: string[] = [],
  blockedCommands: string[] = [],
  allowedPaths: string[] = [],
  useAgentCwd: boolean = false,
): ExecResult {
  """

  Run an executable with separate arguments and no shell expansion.
  Use this for commands whose arguments are already available as values.

  @param command - The executable to run
  @param args - Arguments to pass
  @param cwd - Working directory for the command
  @param timeout - Time limit in milliseconds (e.g. 30s)
  @param stdin - Input to feed to the command
  @param allowedExecutables - Only allow running these executables (allow-list)
  @param blockedCommands - Block running these executables
  @param allowedPaths - Only allow cwd values under these path prefixes
  @param useAgentCwd - When true, a relative or empty cwd is resolved against the agent working directory if one is set; an absolute cwd is left unchanged
  """
  if (useAgentCwd) {
    cwd = applyAgentCwd(cwd)
  }
  // `subcommand` is a synthetic, agent-facing summary of the first
  // positional argument. It lets policy files pin a rule to (command,
  // subcommand) — e.g. auto-approve `git log` but not `git push` —
  // without teaching the policy matcher to walk into `args[0]`.
  // Empty when no args, so handlers can detect bare invocations.
  let subcommand = ""
  if (args.length > 0) {
    subcommand = args[0]
  }
  return interrupt std::exec("Are you sure you want to run this command?", {
    command: command,
    args: args,
    subcommand: subcommand,
    cwd: cwd,
    timeout: timeout,
    stdin: stdin
  })

  return _exec(
    command,
    args,
    cwd,
    timeout,
    stdin,
    {
    allowedExecutables: allowedExecutables,
    blockedCommands: blockedCommands,
    allowedPaths: allowedPaths
  },
  )
}

/**
  `allowedPaths` restricts `cwd`, but bash cannot meaningfully restrict the
  shell command string itself, so prefer running an executable directly with
  structured arguments when capability narrowing matters.
*/
@capabilities(fileRead, subprocess)
export def bash(
  command: string,
  cwd: string = "",
  timeout: number = 0,
  stdin: string = "",
  blockedCommands: string[] = [],
  allowedPaths: string[] = [],
  useAgentCwd: boolean = false,
): ExecResult {
  """

  Run a bash command with pipes, redirects, and globbing.
  Use exec with separate arguments when values should remain literal.

  @param command - The shell command to run
  @param cwd - Working directory for the command
  @param timeout - Time limit in milliseconds (e.g. 30s)
  @param stdin - Input to feed to the command
  @param blockedCommands - Block commands that start with these strings
  @param allowedPaths - Only allow cwd values under these path prefixes
  @param useAgentCwd - When true, a relative or empty cwd is resolved against the agent working directory if one is set; an absolute cwd is left unchanged
  """
  if (useAgentCwd) {
    cwd = applyAgentCwd(cwd)
  }
  return interrupt std::bash("Are you sure you want to run this shell command?", {
    command: command,
    cwd: cwd,
    timeout: timeout,
    stdin: stdin
  })

  return _bash(
    command,
    cwd,
    timeout,
    stdin,
    {
    blockedCommands: blockedCommands,
    allowedPaths: allowedPaths
  },
  )
}

type LsEntry = {
  name: string;
  path: string;
  type: "file" | "dir" | "other";
  size: number
}

/**
Recursive listings skip node_modules, .git, dist, build, .next, and .cache.
Non-recursive listings include those directories. Symlinked entries are omitted.
*/
@capabilities(fileRead)
export idempotent def ls(
  dir: string = ".",
  recursive: boolean = false,
  maxResults: number = 1000,
  allowedPaths: string[] = [],
  useAgentCwd: boolean = false,
): Result {
  """
  List directory entries, optionally including subdirectories. A recursive
  listing skips node_modules, .git, dist, build, .next, and .cache.
  Narrow dir or raise maxResults when the listing reaches its limit.

  @param allowedPaths - Restrict searches to these directories, or leave empty for no restriction.
  @param useAgentCwd - Resolve a relative dir against the agent working directory when set.
  """
  if (useAgentCwd) {
    dir = applyAgentCwd(dir)
  }
  const target = try _searchTarget(dir, "ls")
  if (isFailure(target)) {
    return target
  }
  return interrupt std::ls("Are you sure you want to list this directory?", {
    dir: target.value.dir,
    recursive: recursive,
    maxResults: maxResults
  })

  return try _ls(target.value.dir, ".", recursive, maxResults, allowedPaths)
}

type GrepMatch = {
  file: string;
  line: number;
  text: string
}

/**
Directory searches skip common build and dependency directories, plus paths
ignored by .gitignore when `respectGitignore` is true. A directly named file
is always searched. Symlinked entries are omitted.

Match paths are relative to the searched directory. For a single-file search,
they contain the filename. Use `filesOnly` when you only need matching paths.
*/
@capabilities(fileRead)
export idempotent def grep(
  pattern: string,
  path | dir: string = ".",
  flags: string = "",
  maxResults: number = 200,
  allowedPaths: string[] = [],
  useAgentCwd: boolean = false,
  ignoreCase: boolean = false,
  wholeWord: boolean = false,
  filesOnly: boolean = false,
  invert: boolean = false,
  respectGitignore: boolean = true,
): Result {
  """
  Search a file or directory recursively with a JavaScript regular expression.
  A directory search skips node_modules, .git, dist, build, .next, and .cache.
  Narrow path or refine the pattern when results reach maxResults.

  @param path - Directory or single file to search.
  @param flags - Regex flags i, m, s, or u; use the named options for whole-word and inverted searches.
  @param allowedPaths - Restrict searches to these directories, or leave empty for no restriction.
  @param useAgentCwd - Resolve a relative path against the agent working directory when set.
  @param wholeWord - Match only whole words.
  @param filesOnly - Return matching file paths instead of lines.
  @param invert - Return nonmatching lines.
  @param respectGitignore - Honor .gitignore during directory searches; false includes ignored files.
  """
  if (useAgentCwd) {
    path = applyAgentCwd(path)
  }
  const target = try _searchTarget(path, "grep")
  if (isFailure(target)) {
    return target
  }
  return interrupt std::grep("Are you sure you want to search files with grep?", {
    pattern: pattern,
    dir: target.value.dir,
    file: target.value.file,
    flags: flags,
    maxResults: maxResults,
    ignoreCase: ignoreCase,
    wholeWord: wholeWord,
    filesOnly: filesOnly,
    invert: invert
  })

  const query = {
    pattern: pattern,
    flags: flags,
    ignoreCase: ignoreCase,
    wholeWord: wholeWord,
    filesOnly: filesOnly,
    invert: invert
  }
  return try _grep(
    target.value.dir,
    ".",
    query,
    maxResults,
    allowedPaths,
    respectGitignore,
    target.value.file,
  )
}

@capabilities(fileRead)
export idempotent def glob(
  pattern: string,
  dir: string = ".",
  maxResults: number = 500,
  allowedPaths: string[] = [],
  useAgentCwd: boolean = false,
): Result {
  """
  Find files matching a glob such as "src/**/*.ts". Symlinked entries are omitted.

  @param allowedPaths - Restrict searches to these directories, or leave empty for no restriction.
  @param useAgentCwd - Resolve a relative dir against the agent working directory when set.
  """
  if (useAgentCwd) {
    dir = applyAgentCwd(dir)
  }
  const target = try _searchTarget(dir, "glob")
  if (isFailure(target)) {
    return target
  }
  return interrupt std::glob("Are you sure you want to glob files?", {
    pattern: pattern,
    dir: target.value.dir,
    maxResults: maxResults
  })

  return try _glob(target.value.dir, ".", pattern, maxResults, allowedPaths)
}

type StatInfo = {
  exists: boolean;
  type: "file" | "dir" | "other" | "missing";
  size: number;
  modifiedMs: number
}

@capabilities(fileRead)
export def stat(
  filename: string,
  dir: string = "",
  allowedPaths: string[] = [],
  useAgentCwd: boolean = false,
): StatInfo {
  """
  Return metadata about a filesystem entry: whether it exists, its type ("file", "dir", "other", or "missing" if absent), size in bytes, and mtime in ms. A symlink below dir is reported as missing. With no dir, the path itself is resolved the way you spelled it.

  @param filename - The path to stat
  @param dir - Directory to resolve a relative filename against; filename cannot escape it. When empty, filename resolves against the process cwd and absolute paths are accepted
  @param allowedPaths - Only allow paths under these prefixes
  @param useAgentCwd - When true, resolve a relative filename against the agent working directory if one is set; absolute filenames are unaffected
  """
  if (useAgentCwd && !isAbsolute(filename)) {
    dir = applyAgentCwd(dir)
  }
  if (dir == "") {
    return _stat(filename, ".", allowedPaths)
  }
  return _stat(dir, filename, allowedPaths)
}

@capabilities(fileRead)
export def exists(
  filename: string,
  dir: string = "",
  allowedPaths: string[] = [],
  useAgentCwd: boolean = false,
): boolean {
  """
  Return true if a file or directory exists at the given path. A symlink below dir is reported as missing. Probing a path outside allowedPaths raises an error rather than silently returning false.

  @param filename - The path to check
  @param dir - Directory to resolve a relative filename against; filename cannot escape it. When empty, filename resolves against the process cwd and absolute paths are accepted
  @param allowedPaths - Only allow paths under these prefixes
  @param useAgentCwd - When true, resolve a relative filename against the agent working directory if one is set; absolute filenames are unaffected
  """
  if (useAgentCwd && !isAbsolute(filename)) {
    dir = applyAgentCwd(dir)
  }
  if (dir == "") {
    return _exists(filename, ".", allowedPaths)
  }
  return _exists(dir, filename, allowedPaths)
}

@capabilities(subprocess)
export def which(command: string): string {
  """
  Find an executable in PATH, or return an empty string if absent.
  """
  return _which(command)
}
