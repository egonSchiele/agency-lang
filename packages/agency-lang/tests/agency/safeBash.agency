/** A folder of its own for the symlink test. A link in FIXTURES would
 * change the output of the grep parity rows, which search it with -r. */
static const LINK_FIXTURE = __dirname + "/stdlib/__safebash_link__"

node readPayloadNamesTheRealParent(): any {
  remove(LINK_FIXTURE) with approve
  mkdir(LINK_FIXTURE) with approve
  bash("mkdir inside outside && echo hi > outside/target.txt && ln -s ../outside/target.txt inside/link.txt", cwd: LINK_FIXTURE) with approve
  let dir = ""
  let filename = ""
  const plan = planFor("cat link.txt", LINK_FIXTURE + "/inside")
  for (effect in plan.effects) {
    if (effect.name == "std::read") {
      dir = effect.payload.dir
      filename = effect.payload.filename
    }
  }
  remove(LINK_FIXTURE) with approve
  return [dir == LINK_FIXTURE + "/outside", filename]
}

