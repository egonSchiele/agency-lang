/** @module
  @summary The interactive terminal: slash commands, the status line, and how
  a turn and its reply are drawn. It calls the harness runTurn and decides
  nothing about the work itself.
*/
import { localModelsSupported, listModelNames } from "std::agency/local"
import { listHostedModels } from "std::llm"
import {
  Policy,
  addPolicyRules,
  missingPolicyRules,
  recommendedAutoApprovePolicy,
 } from "std::policy"
import { expandSlash } from "std::skills"
import { getCost, getModelCosts } from "std::thread"
import { chooseOption, ChoiceItem } from "std::ui"
import {
  clearMessages,
  pushMessage,
  repl,
  clearHistory,
 } from "std::ui/cli"

import { showCapabilities, editCapabilities } from "./capabilitiesUi.agency"
import { HISTORY_PATH, POLICY_PATH } from "./config.agency"
import { mcpSlashCommand } from "./mcp.agency"
import { filterHostedModels } from "./modelFilters.agency"
import { noModelChoices } from "./modelRequest.agency"
import { Resolved } from "./models.agency"
import { activePresetName, presetListLines, presetTable } from "./presets.agency"
import { diffResolved, Ctx } from "./resolution.agency"
import {
  configureSearch,
  setSearchBackend,
  getSearchBackend,
  availableBackendItems,
 } from "./search.agency"
import {
  Session,
  switchModel,
  reactToSlotChange,
  establishedProvider,
  modelChoiceItems,
  parseModelsFilters,
  parsePresetName,
  switchPreset,
 } from "./session.agency"
import { formatTurnFailure } from "./utils.agency"
import { configureLocalModel, getResolvedSlots, currentProvider } from "../shared.agency"


// UI mode select — one-line swap between the alt-screen TUI and the
// line-mode REPL. Both modules expose the same `repl` / `pushMessage`
// / `clearMessages` surface (line mode re-exports `pushMessage` and
// `clearMessages` from `std::ui`). Trial both and decide. See
// `docs/superpowers/ideas/2026-06-02-line-mode-agent.md`.
//
//import { clearMessages, pushMessage, repl } from "std::ui"

import { _installSessionHooks, _sessionOnSubmit } from "agency-lang/stdlib-lib/agentSessions.js"

import {
  markTurnDone,
  recordTurn,
  renameSession,
  saveSeedTurn,
  sessionTitle,
 } from "./resume.agency"
import { renderReply, renderUserLine } from "./transcript.agency"
import { runTurn, usesSavedPolicy } from "./turn.agency"
import { parseModelSpec } from "./utils.agency"

let _session: Session = noModelChoices()


def searchSlashCommand(): boolean {
  const opts = availableBackendItems()
  const choice = chooseOption(
    "Web search backend",
    "Pick how this agent searches the web. Current: ${getSearchBackend()}",
    opts,
    false,
    true,
  )
  if (choice != "" && choice != null && choice != undefined) {
    setSearchBackend(choice)
    pushMessage("Web search backend set to: ${choice}")
  }
  return true
}

// getModelCosts() returns one row per kind and model, so the model name alone
// does not identify a row: a model used for completions and for images has
// two, and an addCost() charge has kind "manual" and no model at all.
def costRowLabel(kind: string, model: string): string {
  if (kind == "completion") {
    return model
  }
  if (model == "") {
    return "(${kind})"
  }
  return "${model} (${kind})"
}

def costSlashCommand(): boolean {
  // Derive BOTH the header total and the per-model breakdown from the
  // same figure (getModelCosts, the invocation's usage meter), so the
  // `Cost:` / `Tokens:` lines and the rows below them can never visibly
  // disagree.
  // (getCost()/getTokens() read the per-branch accumulator, a different
  // scope — adjacent in the output, they could in principle diverge.)
  // Rows are sorted by cost descending by getModelCosts(); a subagent
  // on a pricier model (e.g. the oracle on opus-4.8) shows up here.
  const byModel = getModelCosts()
  let totalCost = 0.0
  let totalTokens = 0
  let totalCacheRead = 0
  let totalCacheWrite = 0
  for (m in byModel) {
    totalCost = totalCost + m.cost
    // Cache reads and writes are input tokens too. Counting only
    // inputTokens + outputTokens reports a fraction of a cached
    // conversation — on a long agent run, often under a tenth of it.
    totalTokens = totalTokens
      + m.inputTokens + m.outputTokens
      + m.cachedInputTokens + m.cacheCreationInputTokens
    totalCacheRead = totalCacheRead + m.cachedInputTokens
    totalCacheWrite = totalCacheWrite + m.cacheCreationInputTokens
  }
  pushMessage("Cost:   $${totalCost.toFixed(4)}")
  pushMessage("Tokens: ${totalTokens}")
  if (totalCacheRead > 0 || totalCacheWrite > 0) {
    pushMessage(
      color.dim("        ${totalCacheWrite} written to cache, ${totalCacheRead} read back"),
    )
  }
  if (byModel.length > 0) {
    pushMessage("")
    pushMessage("By model:")
    for (m in byModel) {
      const up = m.inputTokens + m.cachedInputTokens + m.cacheCreationInputTokens
      pushMessage(
        "  ${costRowLabel(m.kind, m.model)}  ↑${up} ↓${m.outputTokens}  $${m.cost.toFixed(4)}",
      )
    }
  }
  return true
}

def modelSlashCommand(command: string): boolean {
  let spec = parseModelSpec(command)
  if (spec == "") {
    pushMessage("Current models:")
    const current = getResolvedSlots()
    for (slot in Object.keys(current)) {
      const resolved = current[slot]
      if (resolved != null) {
        pushMessage("  ${slot}: ${resolved.model} (${resolved.via})")
      }
    }
    const items = modelChoiceItems({}, establishedProvider(_session))
    const choice = chooseOption(
      "Model",
      "Pick a model, or type one (or slot=model, e.g. reasoning=claude-opus-4-8). Empty to cancel.",
      items,
      allowFreeText: true,
      allowCancel: true,
    )
    if (choice == "" || choice == null) {
      return true
    }
    spec = choice
  }
  const ctx: Ctx = {
    provider: currentProvider(),
    price: "standard"
  }
  const out = switchModel(_session, spec, ctx, getResolvedSlots())
  _session = out.session
  for (change in out.changes) {
    reactToSlotChange(change)
  }
  pushResolvedSlots("Model set:", out.resolved)
  return true
}

def pushResolvedSlots(heading: string, resolved: Record<string, Resolved>) {
  pushMessage(heading)
  for (slot in Object.keys(resolved)) {
    const value = resolved[slot]
    if (value != null) {
      pushMessage(color.dim("  ${slot}: ${value.model} (${value.via})"))
    }
  }
}

// One line per rule, the way it sits in the policy file.
export def policyRuleLines(rules: Policy): string[] {
  let lines: string[] = []
  for (effect in Object.keys(rules)) {
    for (rule in rules[effect]) {
      lines.push("  ${effect}  ${JSON.stringify(rule)}")
    }
  }
  return lines
}

// A saved policy.json never receives the rules `recommended` gains after
// the file was made. This shows them and adds them on a yes. It is a
// command the user runs, not a startup step, so a policy never grows
// without its owner asking.
def policySlashCommand(): boolean {
  if (!usesSavedPolicy()) {
    pushMessage("This session runs on --policy, --approve, or --reject, not on your saved policy. Start the agent without them to update the saved one.")
    return true
  }
  const missing = missingPolicyRules(recommendedAutoApprovePolicy)
  const lines = policyRuleLines(missing)
  if (lines.length == 0) {
    pushMessage("Your policy already has every rule in the recommended policy.")
    return true
  }
  pushMessage("The recommended policy has ${lines.length} rules your policy does not. They go after your own rules, so everything you already approve or reject stays decided the same way:")
  for (line in lines) {
    pushMessage(color.dim(line))
  }
  const choice = chooseOption(
    "Policy",
    "Add these rules to ${POLICY_PATH}?",
    [{ key: "add", label: "Add them" }, { key: "skip", label: "Leave my policy as it is" }],
    allowCancel: true,
  )
  if (choice != "add") {
    pushMessage("Policy left as it is.")
    return true
  }
  const written = addPolicyRules(missing)
  if (written is failure(reason)) {
    pushMessage(color.red("Could not save the policy: ${reason}"))
    return true
  }
  pushMessage("Added ${lines.length} rules.")
  return true
}

def presetSlashCommand(command: string): boolean {
  const name = parsePresetName(command)
  if (name == "") {
    for (line in presetListLines(presetTable(), activePresetName())) {
      pushMessage(line)
    }
    return true
  }
  const switched = switchPreset(name)
  if (switched is failure(reason)) {
    pushMessage(color.red("Could not switch preset: ${reason}"))
    return true
  }
  _session = switched.value.session
  for (change in switched.value.changes) {
    reactToSlotChange(change)
  }
  pushResolvedSlots("Preset set: ${name}", switched.value.resolved)
  return true
}

def modelsSlashCommand(trimmed: string): boolean {
  const filters = parseModelsFilters(trimmed)
  const models = filterHostedModels(listHostedModels(), filters)
  if (models.length == 0) {
    pushMessage("No models match.")
    return true
  }
  for (model in models) {
    pushMessage(
      "  ${model.name}  (${model.provider}, $${model.inputCost}/1M in, ${model.contextWindow} ctx)",
    )
  }
  return true
}

def localSlashCommand(): boolean {
  if (!localModelsSupported()) {
    pushMessage(
      color.yellow(
      "Local models need smoltalk-llama-cpp. Install:  ! npm i -g smoltalk-llama-cpp",
    ),
    )
    return true
  }
  let items: ChoiceItem[] = []
  for (modelName in listModelNames()) {
    items.push({
      key: modelName.name,
      label: modelName.name
    })
  }
  const choice = chooseOption(
    "Local model",
    "Pick a local model, or type an hf: URI / .gguf path (downloads on first use):",
    items,
    allowFreeText: true,
    allowCancel: true,
  )
  if (choice == "" || choice == null) {
    return true
  }
  const before = getResolvedSlots()
  configureLocalModel(choice)
  configureSearch(true)
  for (change in diffResolved(before, getResolvedSlots())) {
    reactToSlotChange(change)
  }
  pushMessage("Switched to local model: ${choice}")
  return true
}

// Slash-command + user-message dispatcher invoked by `repl()` for
// every Enter keystroke. Return `false` to terminate the loop.
def _runTurn(msg: string): boolean {
  // Trim once for built-in matching so `"/help\n"` (piped) or
  // `"  /clear"` behave the same as `"/clear"`. `expandSlash` is
  // whitespace-tolerant in its own right, but it still receives the
  // raw `msg` so the LLM sees the exact text the user typed when
  // nothing matches.
  const trimmed = msg.trim()
  return match(trimmed) {
    "" => true
    "/exit" => false
    "/quit" => false
    "/clear" => {
      clearMessages()
      return true
    }
    "/clear-history" => {
      clearHistory()
      pushMessage("Input history cleared.")
      return true
    }
    "/help" => {
      pushMessage(
        "Commands: /exit, /clear, /clear-history, /cost, /model, /models, /local, /preset, /policy, /search, /settings, /mcp, /rename, /paste, /help",
      )
      return true
    }
    "/settings" => {
      showCapabilities()
      editCapabilities()
      return true
    }
    "/mcp" => mcpSlashCommand()
    "/search" => searchSlashCommand()
    "/cost" => costSlashCommand()
    "/model" => modelSlashCommand(trimmed)
    "/models" => modelsSlashCommand(trimmed)
    "/local" => localSlashCommand()
    "/preset" => presetSlashCommand(trimmed)
    "/policy" => policySlashCommand()
    "/rename" => renameSlashCommand("")
    _ => {
      if (trimmed.startsWith("/rename ")) {
        return renameSlashCommand(trimmed.slice(8))
      }
      if (trimmed.startsWith("/model ")) {
        return modelSlashCommand(trimmed)
      }
      if (trimmed.startsWith("/models ")) {
        return modelsSlashCommand(trimmed)
      }
      if (trimmed.startsWith("/preset ")) {
        return presetSlashCommand(trimmed)
      }
      return renderUserTurn(trimmed, msg)
    }
  }
}


def renameSlashCommand(title: string): boolean {
  pushMessage(renameSession(title))
  return true
}

def renderUserTurn(trimmed: string, msg: string): boolean {
  const result = try runTurn("", msg)
  renderAgentResponse(result)
  markTurnDone()
  return true
}

export def buildStatus(): { left: string; right: string; context: string } {
  const roundedCost = "$${getCost().toFixed(4)}"
  return {
    left: sessionTitle(),
    right: roundedCost,
    context: ""
  }
}

export def runSeedTurn(target: string, msg: string) {
  renderUserLine(msg)
  const response = try runTurn(target, msg)
  renderAgentResponse(response)
  markTurnDone()
  saveSeedTurn(msg)
}

export def renderAgentResponse(response: Result<string | null>): void {
  if (response is success(reply)) {
    if (reply != "" && reply != null) {
      renderReply(reply)
    } else {
      pushMessage(color.red("No reply generated."))
    }
  } else if (response is failure(f)) {
    pushMessage(color.red(formatTurnFailure(f)))
  }
}

/** Hand the REPL turn its Agency callbacks. Called from main() before any
  restore, since a resumed process skips the rest of startup. */
export def installSessionHooks() {
  _installSessionHooks(_runTurn, recordTurn)
}

// Runs inside runSession's policy handler; the REPL installs none of its own.
export def startInteractive(seedTarget: string, seedPrompt: string) {
  if (seedPrompt != "") {
    runSeedTurn(seedTarget, seedPrompt)
  }
  repl(
    status: buildStatus,
    onSubmit: _sessionOnSubmit,
    prompt: "> ",
    historyFile: HISTORY_PATH,
    historyMax: 1000,
  )
  print(color.cyan("\nGoodbye!"))
}

