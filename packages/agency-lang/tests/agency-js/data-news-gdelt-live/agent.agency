import { gdeltNews } from "std::data/news/gdelt"

node liveGdelt(): number {
  handle {
    const articles = gdeltNews("technology", 3, "1w") catch []
    return articles.length
  } with (data) {
    if (data.effect == "std::gdelt") {
      return approve()
    }
    if (data.effect == "std::http::fetchJSON") {
      return approve()
    }
    return reject()
  }
}
