// Visible tests for the fib coding eval: plain import-and-assert nodes.
// The eval framework runs this pair through std::agency's testFile() inside
// the reject-all sandbox wrapper; the agent self-checks with
// `agency test fib-tests.test.json`.
import { fib } from "./fib.agency"

export node base0(): number {
  return fib(0)
}

export node base1(): number {
  return fib(1)
}

export node small(): number {
  return fib(7)
}

export node ten(): number {
  return fib(10)
}
