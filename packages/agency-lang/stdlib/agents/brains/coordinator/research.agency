/** @module
  @summary The reading specialist of the Agency agent's coordinator brain:
  a router over two stdlib agents. `agencyTopic: true` goes to
  `agencyResearcherAgent` (the bundled Agency docs); false, the default,
  goes to `researcherAgent` (web, Wikipedia, URLs). General is the default
  because a general researcher asked about Agency is merely less expert,
  while the Agency researcher asked about anything else has only Agency
  documentation to answer from. This file adds the formatting rules and
  the memory tools the coordinator gives its specialists.
*/
import { _insideToolCall } from "agency-lang/stdlib-lib/thread.js"
import { agencyResearcherAgent } from "std::agents/agency/researcher"
import { AgentSettings } from "std::agents/brains/settings"
import { timeBudget } from "std::agents/brains/coordinator/budgets"
import { memoryTools } from "std::agents/lib/toolkits"
import { researcherAgent } from "std::agents/researcher"
import { setMemoryId } from "std::memory"
import { emit } from "std::statelog"
import { handBack } from "std::thread"

def researchTools(): any[] {
  return memoryTools()
}

static const researchStyle = """For a question spanning more than two sources, list the sources you plan to check in the same response as your first search.

Keep replies brief. Cite sources. Show, do not lecture."""

export handoff def researchAgent(
  settings: AgentSettings,
  userMsg: string,
  agencyTopic: boolean = false,
  maxSeconds: number | null = null,
  maxDollars: number | null = null,
): Result<string> {
  """
  Answer a question that needs reading rather than writing: looking something
  up, summarizing a document, gathering background, or recalling a stored
  fact.

  @param userMsg - a message describing what needs to be found out.
  @param agencyTopic - true when the question is about the Agency language
    itself (its syntax, types, stdlib, or CLI), which routes to the agent
    that reads the bundled Agency documentation. Leave it false for every
    other subject, including questions about other languages.
  @param maxSeconds - working-time cap in seconds, when the user gave a
    deadline; null for the default (30 minutes, 10 for an Agency topic).
  @param maxDollars - spend cap in dollars, when the user gave one; null
    for the default ($50, $10 for an Agency topic).
  """
  emit({ type: "agencyAgent.subagentStart", agent: "researchAgent", message: userMsg })
  setMemoryId("research")
  const context = "${researchStyle}\n\n${settings.context}"
  let answer: Result<string> = failure("no research ran")
  if (agencyTopic) {
    answer = agencyResearcherAgent(
      question: userMsg,
      context: context,
      maxCost: maxDollars ?? $10.00,
      maxTime: timeBudget(maxSeconds, 10m),
      model: settings.model,
      provider: settings.provider,
      extraTools: researchTools(),
      keepDraft: false,
      offerSaveDraft: false,
    )
  } else {
    answer = researcherAgent(
      task: userMsg,
      context: context,
      maxCost: maxDollars ?? $50.00,
      maxTime: timeBudget(maxSeconds, 30m),
      model: settings.model,
      provider: settings.provider,
      extraTools: researchTools(),
      keepDraft: false,
      offerSaveDraft: false,
    )
  }
  // Research never ends the coordinator's turn: it may be a first step
  // toward a bigger task. The user has not seen the answer, because the
  // terminal prints only the turn's reply, so the hand-back says so. Without
  // that, the coordinator can write about the answer ("the report above
  // stands") to a user who never saw it. A run the budget cut short is a
  // failure (keepDraft: false) and hands back like any failure. Called from
  // code by the router, research is the turn's reply already, and there is
  // no hand-back.
  if (_insideToolCall() && isSuccess(answer)) {
    handBack(researchHandBack(answer.value))
  }
  return answer
}

// The message that returns control to the coordinator after a finished
// research call.
def researchHandBack(answer: string): string {
  return """[researchAgent finished. The user has not seen this answer.]
${answer}
If it answers the user's request, reply with it in full. Otherwise continue with the request."""
}
