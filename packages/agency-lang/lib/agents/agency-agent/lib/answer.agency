/** @module
  @summary One turn of the command-line agent, answered by `agencyAgent`
  from the stdlib. The harness passes in what only it has: the user's
  global instructions, the models the run resolved to, the CLI's own tools,
  and the job tools when a person is at the REPL. See
  docs/dev/agents/agent-brains.md.
*/
import { AgencyAgentBrain, agencyAgent } from "std::agents/agency"
import { AgentSettings, ModelChoice } from "std::agents/brains/settings"
import { now } from "std::date"
import { Attachment, ensureSystemMessage } from "std::thread"

import { cliTools, sessionJobTools } from "./cliTools.agency"
import { globalInstructionsText } from "./globalInstructions.agency"
import { grounding } from "./grounding.agency"
import { addJobsNote } from "./jobsNote.agency"
import { messageWasRewritten } from "./rewrittenMessage.agency"
import {
  getResolvedSlots,
  getRouterModel,
  getRouterProvider,
  getSlowModel,
  getSlowProvider,
} from "../shared.agency"

// A negative budget is no limit. A whole-agent limit comes from --max-cost
// and --max-time, which the runtime enforces as a root budget.
static const NO_LIMIT = -1

// How replies are shown in the REPL. The heading rule is about the terminal
// renderer, which drops the text after a heading that has no blank line.
export static const REPL_STYLE = "Reply for a terminal REPL that renders Markdown. Put code and command output in fenced code blocks, and a blank line after every heading, or the renderer drops the text that follows."

// The line on how to format a reply, or "" for none. It starts as the
// REPL's. A one-shot run clears it (setInteractive in trace.agency), and
// the session core sets the one its front-end gave it.
let _replyStyle: string = REPL_STYLE

/** Set the line that tells the model how replies are shown, or "" for
  none. */
export def setReplyStyle(style: string) {
  _replyStyle = style
}

/** Add the reply style to the conversation thread, when there is one. A
  one-shot run prints the reply as plain text, so it has none. The line
  goes on the thread and not in `context`, because `context` also reaches
  the writing reviewer and the rewriter, which would read it as part of
  the task the prose was written for. */
export def addReplStyle() {
  if (_replyStyle != "") {
    ensureSystemMessage(_replyStyle)
  }
}

// The budget of one turn. No limit unless the session core sets one: the
// terminal's whole-agent limit is the root budget from its flags.
let _turnMaxCost: number = NO_LIMIT
let _turnMaxTime: number = NO_LIMIT

/** Set the budget of each later turn: a cost in dollars and a time in
  milliseconds. A negative value is no limit. */
export def setTurnBudget(maxCost: number, maxTime: number) {
  _turnMaxCost = maxCost
  _turnMaxTime = maxTime
}

/** The settings a turn runs with. The main model is the ambient one, which
  pickModelsForAgent set at startup, so it is left empty here. */
export def cliSettings(): AgentSettings {
  return {
    context: globalInstructionsText(),
    model: "",
    provider: "",
    reasoningModel: getSlowModel(),
    reasoningProvider: getSlowProvider(),
    routerModel: routerModelFor(),
    routerProvider: getRouterProvider(),
    coderTools: sessionJobTools()
  }
}

/** The router model, or "" when the harness rewrote this turn's message.
  The router was measured on messages as the user typed them. */
def routerModelFor(): string {
  if (messageWasRewritten()) {
    return ""
  }
  return getRouterModel()
}

/** The main model by name, for a brain that starts other programs. A
  started program cannot see this program's ambient model, so the brain
  needs the name to pass on. Every other brain gets "", the ambient model. */
export def namedMainModel(brainName: string): ModelChoice {
  const main = getResolvedSlots()["main"]
  if (brainName != "spawntest" || main == null) {
    return { model: "", provider: "" }
  }
  return { model: main.model, provider: main.provider }
}

/** The text the user reads for a subagent's result. */
export def replyText(name: string, result: Result<string>): string {
  if (isFailure(result)) {
    return "${name} stopped before finishing: ${result.error}"
  }
  return result.value
}

export def answerTurn(
  brainName: string,
  message: string,
  attachments: Attachment[],
): string {
  """
  Answer one turn with agencyAgent. A failure becomes the text the user
  reads. The grounding goes on the conversation thread, where it stays and
  is cached, rather than in the per-call context.

  @param brainName - The brain that answers
  @param message - The user's message, after slash expansion
  @param attachments - The files the message referenced
  """
  if (grounding() != "") {
    ensureSystemMessage(grounding())
  }
  addJobsNote()
  const settings = cliSettings()
  let mainTools: any[] = []
  // The minimal and simple brains get neither: their prompts are kept as
  // short as they can be.
  if (brainName == "coordinator") {
    addReplStyle()
    mainTools = cliTools(now(), settings)
  }
  const main = namedMainModel(brainName)
  const result = agencyAgent(
    task: message,
    context: settings.context,
    brain: brainName as AgencyAgentBrain,
    maxCost: _turnMaxCost,
    maxTime: _turnMaxTime,
    model: main.model,
    provider: main.provider,
    reasoningModel: settings.reasoningModel,
    reasoningProvider: settings.reasoningProvider,
    routerModel: settings.routerModel,
    routerProvider: settings.routerProvider,
    extraTools: {
      main: mainTools,
      coder: settings.coderTools
    },
    attachments: attachments,
  )
  return replyText("The agent", result)
}
