import { llmOptions, withContext } from "std::agents/lib/shared"
import {
  agencyCodeTools,
  agencyDocTools,
  readOnlyFileTools,
 } from "std::agents/lib/toolkits"
import { guarded } from "std::decorators"
import { agentSkill } from "std::skills"
import { ensureSystemMessage } from "std::thread"

/** @module
@summary Answer Agency-language questions using bundled documentation and source.

Use this agent for syntax, types, control flow, CLI usage, diagnostics, and
standard-library APIs. Its built-in tools include the packaged docs and
source checks. It can also read the caller's project. For anything outside
the language, use `researcherAgent` from `std::agents/researcher`, which
searches the web and Wikipedia.

This agent has no web or Wikipedia tools, on purpose: an answer about
Agency assembled from the open web is usually an answer about some other
language.

As an LLM tool it continues the caller's conversation. From code, use a
`thread` block when you want an isolated answer.
*/

static const skills = agentSkill("agency/researcher")

static const systemPrompt = """You answer questions about the Agency programming language.

The bundled documentation is authoritative, so read it rather than recalling:
- `agencyGuide` for syntax, types, control flow, error handling, and built-ins
- `agencyCliDocs` for the command-line tool
- `agencyDiagnostics` for a type-checker code (AG####), its meaning, and its fix
- `agencyStdlib` for what each std:: module offers, one summary per module

Agency is not TypeScript, Python, or Rust, and the differences are exactly where a confident answer goes wrong. When a question touches a construct you have not just read about, read the page before answering.

Ground each claim in what you read, and name the page. When the docs do not answer the question, say so rather than filling the gap from another language. You can read the user's own Agency files and typecheck a snippet to check an answer, but you cannot change anything."""

export def buildTools(): any[] {
  """
  Return bundled documentation, project lookup, and Agency source-checking tools.
  """
  return [...agencyDocTools(), ...agencyCodeTools(), ...readOnlyFileTools(), skills]
}

def answer(
  question: string,
  context: string,
  model: string,
  provider: string,
  extraTools: any[],
): string {
  ensureSystemMessage(systemPrompt)
  return llm(
    withContext(task: question, context: context),
    llmOptions(
      model: model,
      provider: provider,
      tools: buildTools().concat(extraTools).concat([saveDraft]),
    ),
  )
}

@guarded(cost: maxCost, time: maxTime, keepDraft: keepDraft)
export handoff def agencyResearcherAgent(
  question: string,
  context: string = "",
  maxCost: number = $10.00,
  maxTime: number = 10m,
  model: string = "",
  provider: string = "",
  extraTools: any[] = [],
  keepDraft: boolean = true,
): Result<string> {
  """
  Answer a question about the Agency language from the bundled documentation,
  naming the page each claim came from.

  @param question - The question about Agency
  @param context - Extra material folded into the prompt, or ""
  @param maxCost - Cost budget in USD.
  @param maxTime - Time budget in milliseconds.
  @param model - Model override, or "" for the ambient model
  @param provider - Provider for the model override, ignored when model is empty.
  @param extraTools - Extra tools to offer the LLM, appended to the built-in set
  @param keepDraft - False returns a budget failure even when a draft was saved.
  """
  // Return position: a draft the model saved reaches the guard, which
  // returns it as the backup answer if the budget runs out.
  return answer(
    question: question,
    context: context,
    model: model,
    provider: provider,
    extraTools: extraTools,
  )
}
