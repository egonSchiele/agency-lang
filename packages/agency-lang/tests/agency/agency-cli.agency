// std::agency cli(): an `agency` command line run as function calls.
import { cli, cliHandles } from "std::agency"
import { mkdir } from "std::fs"
import { safeBash } from "std::safeBash"

const SOLUTION = """
export def add(a: number, b: number): number {
  return a + b
}
"""

const HARNESS = """
import { add } from "./solution.agency"

export node sum(a: number, b: number = 1): number {
  return add(a, b)
}
"""

const SUITE = """
{
  "sourceFile": "harness.agency",
  "tests": [
    { "nodeName": "sum", "args": { "a": 3, "b": 4 }, "expectedOutput": "7", "evaluationCriteria": [{ "type": "exact" }] }
  ]
}
"""

const BAD_TYPES = """
export def f(): number {
  return "x"
}
"""

def seed(dir: string) {
  mkdir(dir) with approve
  write("solution.agency", SOLUTION, dir) with approve
  write("harness.agency", HARNESS, dir) with approve
  write("suite.test.json", SUITE, dir) with approve
  write("bad.agency", BAD_TYPES, dir) with approve
}

export node handles(): boolean[] {
  return [cliHandles("test"), cliHandles("tc"), cliHandles("help"), cliHandles("")]
}

export node testRunsTheHarness(): string {
  const dir = "./.cli-test"
  seed(dir)
  handle {
    const r = cli(["test", "suite.test.json"], dir)
    if (r is failure(err)) {
      return "failed: ${err}"
    }
    if (r is success(out)) {
      if (out.exitCode == 0 && out.stdout.includes("1/1 tests passed")) {
        return "ok"
      }
      return "unexpected: ${out.stdout}"
    }
    return "unreachable"
  } with approve
  return "unreachable"
}

// The same command through safeBash fails with the diagnostics and then the
// status line a bash command's failure ends with, which the agent's trace
// reads.
export node safeBashFailureEndsWithExitCode(): any[] {
  const dir = "./.cli-safebash-typecheck"
  seed(dir)
  const result = safeBash("agency typecheck bad.agency", cwd: dir) with approve
  if (result is failure(why)) {
    const lines = why.split("\n")
    return [why.includes("error AG"), lines[lines.length - 1]]
  }
  return ["NOT A FAILURE"]
}

export node typecheckReportsErrors(): string {
  const dir = "./.cli-typecheck"
  seed(dir)
  handle {
    const r = cli(["typecheck", "bad.agency"], dir)
    if (r is failure(err)) {
      return "failed: ${err}"
    }
    if (r is success(out)) {
      if (out.exitCode == 1 && out.stdout.includes("error AG")) {
        return "ok"
      }
      return "unexpected: ${out.exitCode} ${out.stdout}"
    }
    return "unreachable"
  } with approve
  return "unreachable"
}

export node astAndFmtReadTheFile(): string {
  const dir = "./.cli-ast"
  seed(dir)
  handle {
    const ast = cli(["ast", "solution.agency"], dir)
    const fmt = cli(["fmt", "solution.agency"], dir)
    if (ast is success(a)) {
      if (fmt is success(f)) {
        if (a.exitCode == 0 && a.stdout.includes("\"type\"") && f.exitCode == 0 && f.stdout.includes("export def add")) {
          return "ok"
        }
        return "unexpected: ${a.stdout} ${f.stdout}"
      }
    }
    return "failed"
  } with approve
  return "unreachable"
}

def classify(r: any): string {
  if (r is failure(err)) {
    const text = "${err}"
    if (text.includes("takes a file, not a flag")) {
      return "flag"
    }
    if (text.includes("takes exactly one argument")) {
      return "arity"
    }
    if (text.includes("no function runs")) {
      return "unsupported"
    }
    if (text.includes("no subcommand given")) {
      return "none"
    }
    return text
  }
  return "succeeded"
}

export node otherFormsSayWhatTheCallShouldBe(): string[] {
  return [
    classify(cli(["help"])),
    classify(cli(["test", "--json"])),
    classify(cli(["test", "a.test.json", "b.test.json"])),
    classify(cli(["test"])),
    classify(cli([])),
  ]
}
