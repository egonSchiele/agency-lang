let cleanups = 0

def spin(n: number): number {
  let i = 0
  while (i < n) {
    i = i + 1
  }
  return i
}

def worker(): string {
  saveDraft("worker-draft")
  const s = spin(30000000)
  return "worker-done"

  finalize {
    cleanups = cleanups + 1
  }
}

node main(): string {
  handle {
    const r = guard(time: 5ms, label: "outer") {
      return worker()
    }
    if (isFailure(r)) {
      return "failure:${r.error}|cleanups:${cleanups}"
    }
    return "value:${r.value}|cleanups:${cleanups}"
  } with (intr) {
    if (intr.effect == "std::guard" && intr.data.label == "outer") {
      return reject("budget")
    }
    return pass()
  }
}
