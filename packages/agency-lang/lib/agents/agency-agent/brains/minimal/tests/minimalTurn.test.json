{
  "sourceFile": "minimalTurn.agency",
  "tests": [
    {
      "nodeName": "runsAToolAndAnswers",
      "description": "A turn runs the bash call the model makes, puts its output in the thread, and returns the model's reply. The grounding reaches the system prompt.",
      "input": "",
      "expectedOutput": "\"Done from minimal!|true|true\"",
      "evaluationCriteria": [{ "type": "exact" }],
      "useTestLLMProvider": true,
      "llmMocks": [
        { "toolCalls": [{ "name": "bash", "args": { "command": "echo MINIMAL-BASH-RAN" } }] },
        { "return": "Done from minimal!" }
      ]
    },
    {
      "nodeName": "twoTurnsOneSystemPrompt",
      "description": "Two turns land on the caller's thread, which holds the system prompt once and both user messages.",
      "input": "",
      "expectedOutput": "\"1 system, 2 user\"",
      "evaluationCriteria": [{ "type": "exact" }],
      "useTestLLMProvider": true,
      "llmMocks": [{ "return": "one" }, { "return": "two" }]
    },
    {
      "nodeName": "offersFourTools",
      "description": "The minimal brain's tool list is read, bash, edit, and write. A long bash output's notice gives a path that read and bash both read.",
      "input": "",
      "expectedOutput": "[\"read\",\"bash\",\"edit\",\"write\"]",
      "evaluationCriteria": [{ "type": "exact" }]
    }
  ]
}
