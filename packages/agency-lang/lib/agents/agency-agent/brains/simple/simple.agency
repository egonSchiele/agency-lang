/** @module
  @summary The simplest brain: each turn is one LLM call with no tools, on
  the caller's conversation thread. Exists as the worked example of adding
  a brain.
*/
import { Attachment, ensureSystemMessage } from "std::thread"

import { AgentBrain, BrainContext } from "../brain.agency"
import { addGlobalInstructions } from "../../lib/globalInstructions.agency"

// Per-run grounding, from BrainContext. Spliced into the system prompt.
let _context: string = ""

def simpleInit(context: BrainContext) {
  _context = context.grounding
}

def simpleRunTurn(
  target: string,
  prompt: string | (string | Attachment)[],
): string {
  ensureSystemMessage(
    "You are a helpful assistant. Answer directly and concisely.${_context}",
  )
  addGlobalInstructions()
  return llm(prompt)
}

export def simpleBrain(): AgentBrain {
  return {
    name: "simple",
    description: "One tool-less LLM call per turn, in a single thread",
    startTargets: [],
    init: simpleInit,
    runTurn: simpleRunTurn
  }
}
