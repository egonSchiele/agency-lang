import test {
  cwdSlug,
  relativeAge,
  sessionLabel,
  saveSession,
  listSessions,
  findSession,
  isAnotherFrontEndsSession,
  mostRecentSession,
  readCheckpointFile,
  SessionRecord,
 } from "../../lib/agents/agency-agent/lib/sessions.agency"
import test { shouldRefreshTitle } from "../../lib/agents/agency-agent/lib/sessionTitle.agency"
import test {
  markTurnDone,
  recordTurn,
  renameSession,
 } from "../../lib/agents/agency-agent/lib/record.agency"
import test { startSession } from "../../lib/agents/agency-agent/lib/resume.agency"
import test { renameLine } from "../../lib/agents/agency-agent/lib/slashCommands/session.agency"

// A rename with no turn still produces a save (the record carries the new
// title, and the turn count is untouched); the save after it is a no-op.
// Turn 1 would normally title the session with an LLM call; a renamed
// session keeps its title instead. The lines are the terminal's wording.
node renameFlow(): any {
  startSession(null, "simple")
  const empty = renameLine(renameSession("   "))
  const renamed = renameLine(renameSession("minnesota   news 8/29"))
  const target = recordTurn("")
  let title = ""
  let turns = -1
  if (target != null) {
    title = target.record.title
    turns = target.record.turns
  }
  const again = recordTurn("")
  markTurnDone()
  const afterTurn = recordTurn("first prompt")
  let titleAfterTurn = ""
  let turnsAfterTurn = -1
  if (afterTurn != null) {
    titleAfterTurn = afterTurn.record.title
    turnsAfterTurn = afterTurn.record.turns
  }
  return {
    empty: empty,
    renamed: renamed,
    title: title,
    turns: turns,
    again: again,
    titleAfterTurn: titleAfterTurn,
    turnsAfterTurn: turnsAfterTurn
  }
}

node slug(): string {
  return cwdSlug("/Users/me/my proj_v2")
}

node ages(): string[] {
  const t = 1000000000
  return [
    relativeAge(t, t + 5000),
    relativeAge(t, t + 90 * 1000),
    relativeAge(t, t + 3 * 3600 * 1000),
    relativeAge(t, t + 49 * 3600 * 1000),
  ]
}

node label(): string {
  const record: SessionRecord = {
    id: "abc",
    cwd: "/x",
    brain: "coordinator",
    created: 0,
    lastActive: 0,
    turns: 1,
    title: "Fix the parser"
  }
  return sessionLabel(record, 3600 * 1000)
}

node untitledLabelShowsId(): boolean {
  const record: SessionRecord = {
    id: "abc",
    cwd: "/x",
    brain: "coordinator",
    created: 0,
    lastActive: 0,
    turns: 0,
    title: ""
  }
  return sessionLabel(record, 0).startsWith("abc ·")
}

node refreshSchedule(): boolean[] {
  return [shouldRefreshTitle(1), shouldRefreshTitle(2), shouldRefreshTitle(5), shouldRefreshTitle(10)]
}

// The store round trip, in the per-test AGENCY_AGENT_HOME sandbox: two
// sessions saved, listed most recently active first, found by id, and
// the checkpoint read back unchanged. Saving a session again replaces
// its record.
// A session another front-end saved in this folder is not offered: its run
// file is the session core's pause, which `restore` cannot read. Before,
// `--continue` took the newest record of any kind and restored its file.
node anotherFrontEndsSessionIsSkipped(): any {
  // Only the other front-end's session is saved here. A session of this
  // terminal's would be counted by storeRoundTrip, which shares the folder.
  const theirs: SessionRecord = {
    id: "theirs",
    cwd: "/x",
    brain: "coordinator",
    created: 20,
    lastActive: 9999999999999,
    turns: 1,
    title: "an app's",
    runFormat: "savedRun"
  }
  saveSession(theirs, { version: 1, pause: [] })
  const recent = mostRecentSession()
  return {
    listed: [r.id for r in listSessions() if r.id == "theirs"],
    newestIsTheirs: recent != null && recent.id == "theirs",
    foundById: findSession("theirs") != null,
    saysWhy: isAnotherFrontEndsSession("theirs"),
    saysNothingForAnUnknownId: isAnotherFrontEndsSession("no-such-session")
  }
}

node storeRoundTrip(): any {
  const first: SessionRecord = {
    id: "s1",
    cwd: "/x",
    brain: "coordinator",
    created: 10,
    lastActive: 10,
    turns: 1,
    title: "first"
  }
  const second: SessionRecord = {
    id: "s2",
    cwd: "/x",
    brain: "simple",
    created: 20,
    lastActive: 20,
    turns: 1,
    title: "second"
  }
  saveSession(first, { fake: "checkpoint one" })
  saveSession(second, { fake: "checkpoint two" })
  first.turns = 2
  first.lastActive = 30
  first.title = "first, renamed"
  saveSession(first, { fake: "checkpoint one, again" })
  const order = [r.id for r in listSessions()]
  const recent = mostRecentSession()
  const found = findSession("s2")
  const recentTitle = if recent == null then "" else recent.title
  const foundBrain = if found == null then "" else found.brain
  return {
    count: listSessions().length,
    order: order,
    recentTitle: recentTitle,
    foundBrain: foundBrain,
    checkpoint: readCheckpointFile("s1"),
    missing: readCheckpointFile("nope")
  }
}
