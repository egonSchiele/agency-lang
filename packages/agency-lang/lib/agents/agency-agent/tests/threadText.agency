/*
 * Test helper: scan every thread for a message of a given role containing
 * `needle`. listThreads with lazySummarize: false enumerates real thread ids
 * without triggering the on-demand LLM summarization of closed threads
 * (which would burn mocks).
 */
import { currentThreadId, getThread, listThreads } from "std::thread"

export def threadHasText(role: string, needle: string): boolean {
  const threads = listThreads(lazySummarize: false)
  if (isFailure(threads)) {
    return false
  }
  for (info in threads.value) {
    const messages = getThread(info.id, 0, 200)
    if (isSuccess(messages)) {
      for (message in messages.value) {
        if (message.role == role && message.content.includes(needle)) {
          return true
        }
      }
    }
  }
  return false
}

export def threadHasSystemText(needle: string): boolean {
  return threadHasText("system", needle)
}

/** On the active thread: how many system messages contain `needle`, and
  how many user messages there are, as "1 system, 2 user". */
export def activeThreadCounts(needle: string): string {
  const messages = getThread(currentThreadId(), 0, 200) catch []
  const systems = [message for message in messages if message.role == "system" && message.content.includes(needle)]
  const users = [message for message in messages if message.role == "user"]
  return "${systems.length} system, ${users.length} user"
}
