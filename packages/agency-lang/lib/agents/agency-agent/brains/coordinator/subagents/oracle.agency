/*
 * The oracle, as the agency agent's coordinator sees it.
 *
 * The agent itself lives in std::agents/oracle, so users get the same
 * reviewer in their own agents. This wrapper supplies the things that are
 * the agency agent's business and not the stdlib's: the slow-model slot
 * the user selected, `inheritContext` so the consult runs in a subthread
 * of the coordinator's conversation instead of starting blind, and thread
 * tools so the oracle can read other threads (such as an earlier explorer
 * survey) instead of re-deriving their work.
 *
 * The docstring below is what the coordinator reads when deciding whether to
 * call this, so it is written for routing, not for the agent's own behavior.
 */
import { oracleAgent as stdOracleAgent } from "std::agents/oracle"
import { getThread, listThreads } from "std::thread"

import { getSlowModel, getSlowProvider } from "../../../shared.agency"
import { announce } from "../lib/announce.agency"

export def oracleAgent(userMsg: string): string {
  """
  Ask the oracle — a read-only senior reviewer — for a second opinion
  before acting on something that would be expensive to get wrong. Call
  this when:

  - You're about to execute a non-trivial plan or diff and a flaw would
    be costly to undo
  - You're stuck on a bug after one or two failed attempts
  - You suspect existing code already solves the problem and a targeted
    look hasn't settled it

  Do NOT consult the oracle for conversational questions, opinions, or
  advice the user asked *you* for — answer those yourself from what you
  know and what you can read directly. A second opinion is worth its cost
  when you're about to act, not when you're about to reply.

  The oracle sees the conversation so far and can read other threads (an
  earlier explorer survey, for example), so don't restate the discussion.
  State the specific question, the relevant file paths, and what you've
  already tried.

  @param userMsg - the specific question you want answered
  """
  announce("oracle", userMsg)
  const result = stdOracleAgent(
    question: userMsg,
    model: getSlowModel(),
    provider: getSlowProvider(),
    extraTools: [listThreads, getThread],
    inheritContext: true,
  )
  if (isFailure(result)) {
    return "The oracle could not finish: ${result.error}"
  }
  return result.value
}
