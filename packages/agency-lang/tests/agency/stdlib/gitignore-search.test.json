{
  "tests": [
    {
      "nodeName": "globSkipsIgnored",
      "input": "",
      "expectedOutput": "[\"kept.md\"]",
      "evaluationCriteria": [{ "type": "exact" }],
      "description": "glob skips a file and a folder the fixture's .gitignore ignores"
    },
    {
      "nodeName": "globIncludesIgnoredWhenAsked",
      "input": "",
      "expectedOutput": "[\"ignored.md\",\"kept.md\",\"out/inside.md\"]",
      "evaluationCriteria": [{ "type": "exact" }],
      "description": "glob with respectGitignore false includes ignored files"
    },
    {
      "nodeName": "lsRecursiveSkipsIgnored",
      "input": "",
      "expectedOutput": "[\"kept.md\"]",
      "evaluationCriteria": [{ "type": "exact" }],
      "description": "a recursive ls skips what the fixture's .gitignore ignores"
    },
    {
      "nodeName": "lsRecursiveIncludesIgnoredWhenAsked",
      "input": "",
      "expectedOutput": "[\".gitignore\",\"ignored.md\",\"kept.md\",\"out\",\"out/inside.md\"]",
      "evaluationCriteria": [{ "type": "exact" }],
      "description": "a recursive ls with respectGitignore false lists every entry"
    },
    {
      "nodeName": "grepSkipsIgnored",
      "input": "",
      "expectedOutput": "[\"kept.md\"]",
      "evaluationCriteria": [{ "type": "exact" }],
      "description": "grep skips a file and a folder the fixture's .gitignore ignores"
    },
    {
      "nodeName": "grepIncludesIgnoredWhenAsked",
      "input": "",
      "expectedOutput": "[\"ignored.md\",\"kept.md\",\"out/inside.md\"]",
      "evaluationCriteria": [{ "type": "exact" }],
      "description": "grep with respectGitignore false searches ignored files"
    }
  ]
}
