import { search } from "std::web/search"

node main() {
  // Live Brave search. Runs only in the weekly live-api workflow, which
  // provides BRAVE_API_KEY. The catch-all handler auto-approves the
  // std::search interrupt so the request actually goes out.
  handle {
    const results = search("TypeScript programming language", count: 3)
    if (results.length == 0) {
      return "brave failed: no results"
    }
    const first = results[0]
    if (first.url == "") {
      return "brave failed: empty url"
    }
    return "brave ok"
  } with (data) {
    return approve()
  }
}
