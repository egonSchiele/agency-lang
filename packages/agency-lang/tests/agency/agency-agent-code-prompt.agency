import { agencyCodePrompt, agencyCodeRules, agencyTutorial } from "std::agents/brains/coordinator/code"

// The Agency coder's rules are read from the packaged prompts, and a file
// that did not ship reads as "" — a SILENT empty system prompt. This node
// is the guard.
node codePromptLoads(): boolean {
  return agencyCodeRules != "" && agencyCodePrompt.includes(agencyCodeRules)
}

// The Agency coder learns the language from the tutorial. A tutorial that
// did not ship reads as "", which would leave the prompt with an empty block.
node codePromptHasTutorial(): boolean {
  return agencyTutorial != "" && agencyCodePrompt.includes(agencyTutorial)
}
