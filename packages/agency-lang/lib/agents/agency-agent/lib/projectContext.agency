/** @module
  @summary The project half of the grounding: date, working directory, and
  the AGENTS.md block. The harness imports it for every brain's grounding,
  and the code subagent for its own prompt.
*/
import { today } from "std::date"
import { checkPolicy } from "std::policy"
import { getAgentCwd } from "std::index"
import { exists } from "std::shell"
import { cwd } from "std::system"

import { projectFolders } from "./claudeSkills.agency"
import { _repositoryAncestors } from "agency-lang/stdlib-lib/gitignore.js"

// The files a folder's instructions come from, in the order they are tried.
const INSTRUCTION_FILES = ["AGENTS.md", "CLAUDE.md"]

export type InstructionFile = {
  dir: string;
  text: string
}

export def loadAgentsMd(dir: string): string {
  """
  Read `AGENTS.md` from `dir`, or else `CLAUDE.md`, and return the raw
  contents; the caller wraps them in a <project_context> block. A file
  that is missing or cannot be read is passed over, so an `AGENTS.md`
  that is a symlink to `CLAUDE.md` gives the `CLAUDE.md`. Returns an
  empty string when neither can be read.
  """
  for (name in INSTRUCTION_FILES) {
    if (exists(name, dir)) {
      const result = read(name, dir) with approve
      if (isSuccess(result)) {
        return result.value
      }
    }
  }
  return ""
}

/** The folders whose instructions apply to `start`, outermost first: the
  repository root down to `start`. Outside a repository only `start` counts. */
@capabilities(fileRead)
export def instructionFolders(start: string): string[] {
  return [...projectFolders(start, _repositoryAncestors(start))].reverse()
}

export def loadProjectInstructions(folders: string[]): InstructionFile[] {
  """
  Read the instruction file of each folder, in the order given, and leave
  out the folders that have none.
  """
  const loaded: InstructionFile[] = [{
    dir: folder,
    text: loadAgentsMd(folder)
  } for folder in folders]
  return [file for file in loaded if file.text.trim() != ""]
}

/** One block per instruction file, each under the folder it came from. The
  nearest folder is last, so the model reads the most specific rules last. */
export def instructionsText(files: InstructionFile[]): string {
  const blocks: string[] = ["Instructions from ${file.dir}:\n${file.text}" for file in files]
  return blocks.join("\n\n")
}

// The folder the project block was last built for. Empty until the first
// block is built.
let _blockDir = ""

// True while `projectContextText` reads the instruction files.
let _readingInstructions = false

/** True for the `std::read` of an instruction file that `projectContextText`
  is making right now. */
def isInstructionRead(intr: any): boolean {
  if (!_readingInstructions || intr.effect != "std::read") {
    return false
  }
  return INSTRUCTION_FILES.includes(intr.data.filename)
}

/** A policy handler that also approves the harness's own reads of the
  instruction files, and hands every other interrupt to `policyHandler`.
  The first block is read before the agent installs its policy handler,
  so the user is never asked about it. A block built later (after the
  working directory moves, or for a coder's first turn) is read inside the
  handler, and without this the user would be asked to approve reading
  `AGENTS.md` before the agent saw their message. Only the question goes
  away: a `reject` rule in `rules` still rejects the read, and a root
  policy is a separate handler that can reject it too. */
export def approvingInstructionReads(policyHandler: any, rules: any, intr: any): any {
  if (!isInstructionRead(intr)) {
    return policyHandler(intr)
  }
  if (checkPolicy(rules, intr).type == "reject") {
    return policyHandler(intr)
  }
  return approve()
}

/** The agent's working directory: the folder its file tools resolve paths
  against, which a coder can change with `setAgentCwd`. Before the agent
  has set one, it is the directory the run started in. */
export def projectDir(): string {
  const agentDir = getAgentCwd()
  if (agentDir != "") {
    return agentDir
  }
  return cwd()
}

export def projectContextText(): string {
  """
  The part of the grounding that is about the project rather than the
  agent: date, working directory, and the AGENTS.md block. The block holds
  the instructions of the agent's working directory and of each parent up
  to the repository root. A coder started directly with `--agent code` gets
  it too.
  """
  const dir = projectDir()
  _blockDir = dir
  _readingInstructions = true
  const files = loadProjectInstructions(instructionFolders(dir)) with approve
  _readingInstructions = false
  const projectContext = instructionsText(files)
  return """

  Current date: ${today()}
  Current working directory: ${dir}

  <project_context>
  ${projectContext}
  </project_context>
  """
}

/** The user's message, with the project block above it when the agent's
  working directory has changed since the block was last built. The model
  was given the old folder's instructions as authoritative, so it needs the
  new folder's before it acts on the message. */
export def withProjectContextIfMoved(message: string): string {
  if (_blockDir == "" || projectDir() == _blockDir) {
    return message
  }
  const block = projectContextText()
  return "The working directory changed. This project block replaces the earlier one.${block}\n\n${message}"
}
