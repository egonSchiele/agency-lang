/** @module MCP for the agency agent: store the configured servers at startup,
  connect them on the first turn without starting a login, and give the
  coordinator the tools of every connected server on each turn. The
  @agency-lang/mcp package holds each server's state, and this file keeps no
  copy, so a resumed session shows the new process's servers. The `/mcp` menu
  is in mcpMenu.agency. Sits above `settings.agency` (imports from it, nothing
  imports back), so there is no import cycle. */

import {
  McpServerState,
  configureMcpServers,
  connectPendingMcpServers,
  mcpServerStates,
  mcpPackageProblem,
  mergeMcpServers,
  isMcpAvailable,
  readProjectMcpConfig,
 } from "std::mcp"
import { keys } from "std::object"
import { cwd } from "std::system"

import { notice } from "./notice.agency"
import { Settings, getMcpServers } from "./settings.agency"

/** The global mcpServers merged with the project's. The project wins when
  both define a name. */
export def mergedMcpServers(settings: Settings): Record<string, any> {
  return mergeMcpServers(getMcpServers(settings), readProjectMcpConfig(cwd()))
}

/** "1 tool" or "<n> tools". */
export def toolCountText(count: number): string {
  if (count == 1) {
    return "1 tool"
  }
  return "${count} tools"
}

/** A server's state as one sentence. Startup, a finished login, and a
  reconnect all print it. */
export def stateLine(state: McpServerState): string {
  const tools = toolCountText(state.tools.length)
  return match(state.status) {
    "connected" => "✔ ${state.name} connected · ${tools}. You can use them from your next message."
    "needsLogin" => "${state.name} needs you to log in."
    _ => "${state.name} failed to connect: ${state.message}"
  }
}

/** The lines startup prints: the package problem alone when there is one,
  otherwise one line for each server that is not connected. */
export def startupLines(problem: string, states: McpServerState[]): string[] {
  if (problem != "") {
    return ["MCP: ${problem}"]
  }
  let lines: string[] = []
  for (state in states) {
    const line = stateLine(state)
    if (state.status == "needsLogin") {
      lines.push("MCP: ${line} Type /mcp to log in.")
    } else if (state.status == "failed") {
      lines.push("MCP: ${line}")
    }
  }
  return lines
}

/** Store the configured servers in the package, at startup. Connects nothing:
  starting a stdio server asks the user, and the policy handler that answers
  does not exist yet. The servers connect on the first turn. Prints the
  package problem when there is one. No-op when @agency-lang/mcp is not
  installed or no servers are configured. */
export def maybeLoadMcp(settings: Settings) {
  if (!isMcpAvailable()) {
    return
  }
  const merged = mergedMcpServers(settings)
  if (keys(merged).length == 0) {
    return
  }
  const problem = mcpPackageProblem()
  if (problem != "") {
    print(color.yellow("MCP: ${problem}"))
    return
  }
  configureMcpServers(merged)
}

/** Connect the stored servers that have no state yet, and print a line for
  each one that needs a login or failed. Runs under the policy handler, so a
  stdio server's mcp::connect question is answered there. A resumed session
  connects here too, since the package's state belongs to the process. */
export def startPendingMcpServers() {
  if (!isMcpAvailable()) {
    return
  }
  for (line in startupLines("", connectPendingMcpServers())) {
    notice(line, "warning")
  }
}

/** The tools of every connected MCP server, for the coordinator's tool list.
  Connects any stored server that has no state yet first. Read from the
  package on every turn, so a login or log out in /mcp shows up on the next
  message. */
export def getMcpTools(): any[] {
  startPendingMcpServers()
  let tools: any[] = []
  for (state in mcpServerStates()) {
    tools = [...tools, ...state.tools]
  }
  return tools
}
