@capabilities(fileRead, network, subprocess, env)
export idempotent def ghIssueGet(
  number: number,
  owner: string = "",
  repo: string = "",
): IssueSummary raises <std::github::issueGet> {
  """
  Read an issue's details and description. Pull request numbers are rejected.
  @param owner - Pass with repo, or leave both empty to use the agent working directory's origin remote.
  @param repo - The repository name without the owner, supplied together with owner.
  """
  _ghCheckNumber(number)
  const coord = _ghResolveRepo(owner, repo, getAgentCwd())
  return interrupt std::github::issueGet("Read issue #${number} on ${coord.owner}/${coord.repo}", {
    owner: coord.owner,
    repo: coord.repo,
    number: number
  })
  return _ghIssueGet(number, coord.owner, coord.repo)
}

/**
  GitHub includes pull requests in the underlying page, then this tool
  removes them. Use `ghIssueSearch` with `is:issue` when you need pagination
  that counts issues alone.
*/
@capabilities(fileRead, network, subprocess, env)
export idempotent def ghIssueList(
  state: IssueState = "open",
  labels: string[] = [],
  perPage: number = 30,
  page: number = 1,
  owner: string = "",
  repo: string = "",
): IssueSummary[] raises <std::github::issueList> {
  """
  List issues, optionally filtered by labels. A short or empty page can
  still have later pages because pull requests are excluded from results.
  To page through every issue exactly, use ghIssueSearch with "is:issue".
  @param labels - Only issues carrying all of these labels ([] for any).
  @param perPage - Results per page, at most 100.
  @param page - Page number, starting at 1.
  @param owner - Pass with repo, or leave both empty to use the agent working directory's origin remote.
  @param repo - The repository name without the owner, supplied together with owner.
  """
  const coord = _ghResolveRepo(owner, repo, getAgentCwd())
  const pageSize = _ghClampPerPage(perPage)
  const pageNumber = _ghClampPage(page)
  return interrupt std::github::issueList("List ${state} issues on ${coord.owner}/${coord.repo}", {
    owner: coord.owner,
    repo: coord.repo,
    state: state,
    labels: labels,
    perPage: pageSize,
    page: pageNumber
  })
  return _ghIssueList(state, labels, pageSize, pageNumber, coord.owner, coord.repo)
}

@capabilities(fileRead, network, subprocess, env)
export idempotent def ghIssueComments(
  number: number,
  perPage: number = 30,
  page: number = 1,
  owner: string = "",
  repo: string = "",
): CommentInfo[] raises <std::github::issueCommentList> {
  """
  List the comments on an issue.
  @param perPage - Results per page, at most 100.
  @param page - Page number, starting at 1.
  @param owner - Pass with repo, or leave both empty to use the agent working directory's origin remote.
  @param repo - The repository name without the owner, supplied together with owner.
  """
  _ghCheckNumber(number)
  const coord = _ghResolveRepo(owner, repo, getAgentCwd())
  const pageSize = _ghClampPerPage(perPage)
  const pageNumber = _ghClampPage(page)
  return interrupt std::github::issueCommentList("List comments on issue #${number} on ${coord.owner}/${coord.repo}", {
    owner: coord.owner,
    repo: coord.repo,
    number: number,
    perPage: pageSize,
    page: pageNumber
  })
  return _ghIssueComments(number, pageSize, pageNumber, coord.owner, coord.repo)
}

@capabilities(fileRead, network, subprocess, env)
export idempotent def ghIssueSearch(
  query: string,
  perPage: number = 30,
  page: number = 1,
  owner: string = "",
  repo: string = "",
): IssueSummary[] raises <std::github::issueSearch> {
  """
  Search issues and pull requests in one repository. The query must not
  contain a repo:, org:, or user: qualifier.
  @param query - GitHub search syntax, e.g. "crash in:title label:bug".
  @param perPage - Results per page, at most 100.
  @param page - Page number, starting at 1.
  @param owner - Pass with repo, or leave both empty to use the agent working directory's origin remote.
  @param repo - The repository name without the owner, supplied together with owner.
  """
  const coord = _ghResolveRepo(owner, repo, getAgentCwd())
  const pageSize = _ghClampPerPage(perPage)
  const pageNumber = _ghClampPage(page)
  const scopedQuery = _ghScopedSearchQuery(coord.owner, coord.repo, query)
  return interrupt std::github::issueSearch("Search issues on ${coord.owner}/${coord.repo}: ${query}", {
    owner: coord.owner,
    repo: coord.repo,
    query: scopedQuery,
    perPage: pageSize,
    page: pageNumber
  })
  return _ghIssueSearch(scopedQuery, pageSize, pageNumber)
}

// ---- Writes ----------------------------------------------------------------
// Destructive blocks mark writes so a retry does not repeat them.

/**
  Use `ghPrReview` to submit several inline comments in one review. The
  comment attaches to the selected commit, defaulting to the PR head.
*/
@capabilities(fileRead, network, subprocess, env)
export def ghPrReviewComment(
  number: number,
  path: string,
  line: number,
  body: string,
  side: DiffSide = "RIGHT",
  commitSha: string = "",
  owner: string = "",
  repo: string = "",
): ReviewCommentInfo raises <std::github::prReviewComment> {
  """
  Post one inline comment on a pull request diff. For several comments at
  once, use ghPrReview: one call, one approval.
  @param path - The repository-relative path shown in the pull request diff.
  @param line - The one-based file line on the chosen diff side, within a changed hunk.
  @param body - The comment text (markdown).
  @param side - Which side of the diff: "RIGHT" (new code) or "LEFT" (old).
  @param commitSha - The commit to anchor to. Empty means the PR head commit.
  @param owner - Pass with repo, or leave both empty to use the agent working directory's origin remote.
  @param repo - The repository name without the owner, supplied together with owner.
  """
  _ghCheckNumber(number)
  _ghCheckNumber(line)
  const coord = _ghResolveRepo(owner, repo, getAgentCwd())
  return interrupt std::github::prReviewComment("Post an inline review comment on ${path}:${line} of pull request #${number} on ${coord.owner}/${coord.repo}", {
    owner: coord.owner,
    repo: coord.repo,
    number: number,
    path: path,
    line: line,
    body: body
  })
  // The head-SHA read stays outside the destructive block: a failed read
  // must not count as a failed mutation.
  let sha = commitSha
  if (sha == "") {
    sha = _ghPrHeadSha(number, coord.owner, coord.repo)
  }
  destructive {
    return _ghPrReviewComment(
      number,
      path,
      line,
      body,
      side,
      sha,
      coord.owner,
      coord.repo,
    )
  }
}

/**
  Submit overall feedback and inline comments together. Use `ghPrApprove`
  for a formal approval, which has its own effect.
*/
@capabilities(fileRead, network, subprocess, env)
export def ghPrReview(
  number: number,
  event: ReviewEvent = "COMMENT",
  body: string = "",
  comments: ReviewComment[] = [],
  owner: string = "",
  repo: string = "",
): ReviewSummary raises <std::github::prReview> {
  """
  Submit a pull request review with an overall comment and optional inline
  comments, either commenting or requesting changes.
  @param body - Overall review text in Markdown, required when requesting changes.
  @param comments - Inline comments, each with path, line, body, and an optional side.
  @param owner - Pass with repo, or leave both empty to use the agent working directory's origin remote.
  @param repo - The repository name without the owner, supplied together with owner.
  """
  _ghCheckNumber(number)
  _ghCheckReview(event, body, comments)
  const coord = _ghResolveRepo(owner, repo, getAgentCwd())
  return interrupt std::github::prReview("Submit a ${event} review with ${comments.length} inline comments on pull request #${number} on ${coord.owner}/${coord.repo}", {
    owner: coord.owner,
    repo: coord.repo,
    number: number,
    event: event,
    body: body,
    comments: comments
  })
  destructive {
    return _ghPrReview(number, event, body, comments, coord.owner, coord.repo)
  }
}

@capabilities(fileRead, network, subprocess, env)
export def ghPrApprove(
  number: number,
  body: string = "",
  owner: string = "",
  repo: string = "",
): ReviewSummary raises <std::github::prApprove> {
  """
  Approve a pull request. This is a formal review approval that can satisfy
  branch protection and unblock a merge.
  @param body - Optional approval text (markdown).
  @param owner - Pass with repo, or leave both empty to use the agent working directory's origin remote.
  @param repo - The repository name without the owner, supplied together with owner.
  """
  _ghCheckNumber(number)
  const coord = _ghResolveRepo(owner, repo, getAgentCwd())
  return interrupt std::github::prApprove("APPROVE pull request #${number} on ${coord.owner}/${coord.repo}", {
    owner: coord.owner,
    repo: coord.repo,
    number: number,
    body: body
  })
  destructive {
    return _ghPrApprove(number, body, coord.owner, coord.repo)
  }
}

@capabilities(fileRead, network, subprocess, env)
export def ghIssueCreate(
  title: string,
  body: string,
  labels: string[] = [],
  assignees: string[] = [],
  owner: string = "",
  repo: string = "",
): IssueSummary raises <std::github::issueCreate> {
  """
  Create an issue.
  @param body - The issue body (markdown).
  @param labels - Labels to apply on creation.
  @param assignees - Usernames to assign on creation.
  @param owner - Pass with repo, or leave both empty to use the agent working directory's origin remote.
  @param repo - The repository name without the owner, supplied together with owner.
  """
  const coord = _ghResolveRepo(owner, repo, getAgentCwd())
  return interrupt std::github::issueCreate("Create issue \"${title}\" on ${coord.owner}/${coord.repo}", {
    owner: coord.owner,
    repo: coord.repo,
    title: title,
    body: body,
    labels: labels,
    assignees: assignees
  })
  destructive {
    return _ghIssueCreate(title, body, labels, assignees, coord.owner, coord.repo)
  }
}

@capabilities(fileRead, network, subprocess, env)
export def ghIssueComment(
  number: number,
  body: string,
  owner: string = "",
  repo: string = "",
): CommentInfo raises <std::github::issueComment> {
  """
  Post a comment on an issue or pull request.
  @param number - The issue or pull request number.
  @param body - The comment text (markdown).
  @param owner - Pass with repo, or leave both empty to use the agent working directory's origin remote.
  @param repo - The repository name without the owner, supplied together with owner.
  """
  _ghCheckNumber(number)
  const coord = _ghResolveRepo(owner, repo, getAgentCwd())
  return interrupt std::github::issueComment("Post a comment on issue #${number} on ${coord.owner}/${coord.repo}", {
    owner: coord.owner,
    repo: coord.repo,
    number: number,
    body: body
  })
  destructive {
    return _ghIssueComment(number, body, coord.owner, coord.repo)
  }
}

@capabilities(fileRead, network, subprocess, env)
export def ghIssueClose(
  number: number,
  reason: CloseReason = "completed",
  owner: string = "",
  repo: string = "",
): IssueSummary raises <std::github::issueUpdate> {
  """
  Close an issue or pull request.
  @param number - The issue or pull request number.
  @param owner - Pass with repo, or leave both empty to use the agent working directory's origin remote.
  @param repo - The repository name without the owner, supplied together with owner.
  """
  _ghCheckNumber(number)
  const coord = _ghResolveRepo(owner, repo, getAgentCwd())
  return interrupt std::github::issueUpdate("Close issue #${number} on ${coord.owner}/${coord.repo} as ${reason}", {
    owner: coord.owner,
    repo: coord.repo,
    number: number,
    state: "closed",
    reason: reason
  })
  destructive {
    return _ghIssueClose(number, reason, coord.owner, coord.repo)
  }
}

@capabilities(fileRead, network, subprocess, env)
export def ghIssueLabel(
  number: number,
  labels: string[],
  owner: string = "",
  repo: string = "",
): string[] raises <std::github::issueLabel> {
  """
  Add labels to an issue or pull request. Returns the full label list after the change.
  @param number - The issue or pull request number.
  @param labels - The labels to add.
  @param owner - Pass with repo, or leave both empty to use the agent working directory's origin remote.
  @param repo - The repository name without the owner, supplied together with owner.
  """
  _ghCheckNumber(number)
  const coord = _ghResolveRepo(owner, repo, getAgentCwd())
  return interrupt std::github::issueLabel("Add labels ${JSON.stringify(labels)} to issue #${number} on ${coord.owner}/${coord.repo}", {
    owner: coord.owner,
    repo: coord.repo,
    number: number,
    labels: labels
  })
  destructive {
    return _ghIssueLabel(number, labels, coord.owner, coord.repo)
  }
}
