import { connectorFetch, clampLimit, dateStrToEpochMs } from "std::data/connector"
import { bskySearch } from "std::data/social/bluesky"

node coreHelpers(): any {
  return [
    dateStrToEpochMs("1970-01-01T00:00:01.000Z"),
    dateStrToEpochMs("not a date"),
    dateStrToEpochMs(""),
    clampLimit(500, 100),
    clampLimit(-3, 100),
    clampLimit(7, 100)
  ]
}

// connectorFetch pre-approves nothing: a direct call raises the fetch
// interrupt like fetchJSON itself, so the test-level rejection reaches it
// and no request is sent.
node directConnectorFetchIsGated(): boolean {
  const result = connectorFetch("https://example.com", ["example.com"], "/x")
  return isFailure(result)
}

// The gate for the shared core: connector verbs approve connectorFetch's
// std::http::fetchJSON interrupt at the call site (`with approve`). That
// approve must stay a vote, not a bypass — this OUTER handler must still
// receive the fetch interrupt, and its reject must win, so no request is
// ever sent.
node outerHandlerStillSeesFetch(): boolean {
  handle {
    const result = bskySearch("agency")
    if (isFailure(result)) {
      return result.error.includes("outer-saw:std::http::fetchJSON")
    }
    return false
  } with (intr) {
    if (intr.effect == "std::bluesky") {
      return approve()
    }
    return reject("outer-saw:${intr.effect}")
  }
}
