/*
 * The two coders, as the coordinator sees them. Both are the stdlib coding
 * agent (std::agents/coding) and both are handoffs: they continue the
 * coordinator's conversation, so they see the request and whatever was read
 * before it, and their edits and test output stay in its history.
 *
 * `codeAgent` is for every language but Agency. `agencyCodeAgent` adds the
 * Agency prompt, the bundled docs tools, and the typecheck and test tools.
 * The docstrings are written for routing, not for the agents' own behaviour.
 *
 * Relative paths resolve against the agent working directory
 * (`setAgentCwd`/`getAgentCwd`), which `agent.agency` pins to the user's
 * cwd at startup.
 */
import { cli, cliHandles, CLI_NOT_AVAILABLE } from "std::agency"
import { codingAgent, buildTools as codingAgentTools } from "std::agents/coding"
import { agencyCodeTools, agencyDocToolsBrief } from "std::agents/lib/toolkits"
import { plannerAgent } from "std::agents/planner"
import { getAgentCwd } from "std::index"
import { exec } from "std::shell"
import { skillsDir } from "std::skills"
import { ensureSystemMessage } from "std::thread"

import { AGENT_SOURCE_DIR } from "../../../lib/agentSource.agency"
import { globalInstructionsText } from "../../../lib/globalInstructions.agency"
import { announce } from "../lib/announce.agency"
import { timeBudget } from "../lib/budgets.agency"


// The name matches what prompts/code.md tells the model.
export static const superpowersSkill = skillsDir(
  path.join(AGENT_SOURCE_DIR, "skills/superpowers"),
  "flat",
  name: "superpowersSkill",
) with approve


export def agencyCli(args: string[]): any {
  """
  Run the `agency` CLI with the given arguments. Returns an object with
  `stdout`, `stderr`, and `exitCode` (same shape as `bash`). `test`,
  `typecheck`, `ast`, `fmt`, and `run <file>` run in-process through the
  matching std::agency function (testFile, typecheckFile, parseAST,
  format, runFile), which you can also call directly. Other subcommands
  run the executable, which may not be installed. Arguments are passed
  directly (no shell interpretation).

  @param args - CLI arguments, e.g. ["typecheck", "foo.agency"]. The
    first element is the subcommand.
  """
  if (args.length > 0 && cliHandles(args[0])) {
    const ran = cli(args, getAgentCwd())
    if (ran is failure(err)) {
      return {
        stdout: "",
        stderr: "${err}",
        exitCode: 1
      }
    }
    return ran.value
  }
  const result = exec("agency", args, useAgentCwd: true)
  if (result.exitCode != 0 && result.stderr.includes("ENOENT")) {
    return {
      stdout: "",
      stderr: CLI_NOT_AVAILABLE,
      exitCode: result.exitCode
    }
  }
  return result
}

/** Read a bundled prompt file, or "" when it cannot be read. The prompts
  ship with the agent, so a missing one means a packaging problem, not a
  runtime condition worth failing the turn over. The empty-string fallback
  makes a broken path a SILENT failure (the agent runs with no system
  prompt), which is why tests/agency/agency-agent-code-prompt.agency
  asserts both prompts load. Exported for that test. */
export def promptFile(filename: string): string {
  const contents = read(filename, path.join(AGENT_SOURCE_DIR, "brains/coordinator/prompts")) with approve
  if (isFailure(contents)) {
    return ""
  }
  return contents.value
}

// The Agency coder's system prompt. It expires with the handoff, as every
// system message pushed during one does.
export static const agencyCodePrompt = promptFile("code.md")

// Passed as context in one-shot / autonomous mode (`agency agent -p`)
static const ONE_SHOT_NOTE = promptFile("oneShot.md")

// Set by the coordinator (`setCodeOneShot`) before the first dispatch when
// the run is non-interactive. Gates `ONE_SHOT_NOTE`.
let _oneShot = false

export def setCodeOneShot(oneShot: boolean) {
  _oneShot = oneShot
}

// The default budget for one coder dispatch, and for escalate's planner.
static const CODE_MAX_COST = $20.00
static const CODE_MAX_TIME = 15m

def escalate(task: string, reason: string, plan: string): string {
  """
  Switch this task to plan-as-code: writes and runs a purpose-built agent for a
  multi-step task, showing you the plan first. Reach for this ONLY when the task
  genuinely needs a multi-step plan you cannot finish in a few direct edits. Do
  NOT use it for ordinary follow-ups. After it returns, REPORT its result; do not
  redo the work it already did.

  @param reason - why this task needs a multi-step plan.
  @param plan - your outline of the steps.
  """
  const planned = plannerAgent(
    task,
    context: "${reason}\n\n${globalInstructionsText()}",
    plan: plan,
    maxCost: CODE_MAX_COST,
    maxTime: CODE_MAX_TIME,
  )
  if (isFailure(planned)) {
    return "Planner stopped: ${planned.error}"
  }
  return planned.value
}

// What each coder is given on top of the stdlib coding agent's own tools.
// `escalate` joins per dispatch, bound to the task.
export static const codeExtras: any[] = [superpowersSkill]

export static const agencyCodeExtras: any[] = [
  ...codeExtras,
  ...agencyDocToolsBrief(),
  ...agencyCodeTools(),
  agencyCli,
]

// The full lists, for the tests that check tool names.
export static const codeTools: any[] = [...codingAgentTools(), ...codeExtras]

export static const agencyCodeAgentTools: any[] = [...codingAgentTools(), ...agencyCodeExtras]

static const REPL_STYLE = "Reply for a terminal REPL that renders Markdown, and put code and command output in fenced code blocks."

// An unattended run has no reader for a formatted reply and no next turn,
// and oneShot.md holds the rules for working that way.
def dispatchContext(): string {
  if (_oneShot) {
    return "${ONE_SHOT_NOTE}\n\n${globalInstructionsText()}"
  }
  return "${REPL_STYLE}\n\n${globalInstructionsText()}"
}

// Both coders are the stdlib coding agent. They differ in the tools they add.
def runCoder(
  userMsg: string,
  maxSeconds: number | null,
  maxDollars: number | null,
  extras: any[],
): Result<string> {
  return codingAgent(
    task: userMsg,
    context: dispatchContext(),
    maxCost: maxDollars ?? CODE_MAX_COST,
    maxTime: timeBudget(maxSeconds, CODE_MAX_TIME),
    extraTools: [...extras, escalate.partial(task: userMsg)],
  )
}

export handoff def codeAgent(
  userMsg: string,
  maxSeconds: number | null = null,
  maxDollars: number | null = null,
): Result<string> {
  """
  Hand a coding task to the coder: reading, writing, and editing code,
  running commands, builds, and tests. Use it for every language except
  Agency. It continues this conversation, so it sees everything above, and
  its edits and command output stay in your history.

  @param userMsg - what needs doing.
  @param maxSeconds - working-time cap in seconds, when the user gave a
    deadline; null for the default (15 minutes).
  @param maxDollars - spend cap in dollars, when the user gave one; null
    for the default ($20).
  """
  announce("codeAgent", userMsg)
  return runCoder(userMsg, maxSeconds, maxDollars, codeExtras)
}

export handoff def agencyCodeAgent(
  userMsg: string,
  maxSeconds: number | null = null,
  maxDollars: number | null = null,
): Result<string> {
  """
  Hand a task about Agency code to the Agency coder: writing, editing,
  typechecking, running, and testing `.agency` files, and questions about
  Agency syntax, the standard library, or the `agency` CLI. It has the
  Agency documentation and the typechecker, which the general coder does
  not. It continues this conversation, so it sees everything above, and
  its edits and command output stay in your history.

  @param userMsg - what needs doing.
  @param maxSeconds - working-time cap in seconds, when the user gave a
    deadline; null for the default (15 minutes).
  @param maxDollars - spend cap in dollars, when the user gave one; null
    for the default ($20).
  """
  announce("agencyCodeAgent", userMsg)
  ensureSystemMessage(agencyCodePrompt)
  return runCoder(userMsg, maxSeconds, maxDollars, agencyCodeExtras)
}
