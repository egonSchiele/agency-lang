import { ghPrGet, ghIssueList, ghIssueComment, ghPrReview, ghPrApprove } from "std::github"
import { setEnv } from "std::system"
import { exec } from "std::shell"
import { setAgentCwd } from "std::index"
import { alwaysScopeFor, ScopedField } from "std::policy"

// Every GitHub call here targets owner "o" / repo "r" and is served by
// fetchMocks in main.test.json, so no test can reach the real network.

// A throwaway git repo under /tmp whose origin remote is o/r, so default
// resolution has a known answer on every machine. Same pattern as git.agency.
def makeSandbox(): string {
  let dir = ""
  handle {
    const made = exec("mktemp", ["-d", "/tmp/agency-github-test.XXXXXX"])
    dir = made.stdout.trim()
    exec("sh", ["-c", "GIT_CEILING_DIRECTORIES=${dir} git init -q && git remote add origin https://github.com/o/r.git"], cwd: dir)
  } with approve
  return dir
}

// Only ever removes a real path under /tmp/.
def teardown(dir: string) {
  if (dir.startsWith("/tmp/") && dir != "/tmp/") {
    handle {
      exec("rm", ["-rf", dir])
    } with approve
  }
}

node rejectedReadFails(): string {
  setEnv("GITHUB_TOKEN", "test-token") with approve
  const pr = ghPrGet(7, owner: "o", repo: "r") with reject
  if (isFailure(pr)) {
    return "pass"
  }
  return "FAIL rejection did not block the request"
}

node approvedReadReturnsTypedData(): string {
  setEnv("GITHUB_TOKEN", "test-token") with approve
  const pr = ghPrGet(7, owner: "o", repo: "r") with approve
  if (isFailure(pr)) {
    return "FAIL approved read failed: ${JSON.stringify(pr)}"
  }
  if (pr.number != 7 || pr.title != "Add feature" || pr.author != "alice" || pr.headSha != "abc123") {
    return "FAIL wrong mapping: ${JSON.stringify(pr)}"
  }
  return "pass"
}

node approvingOneEffectDoesNotApproveAnother(): string {
  setEnv("GITHUB_TOKEN", "test-token") with approve
  handle {
    const issues = ghIssueList(owner: "o", repo: "r")
    if (isFailure(issues)) {
      return "pass"
    }
    return "FAIL issueList went through under a prGet-only handler"
  } with (intr) {
    if (intr.effect == "std::github::prGet") {
      return approve()
    }
    return reject()
  }
}

node payloadCarriesResolvedRepo(): string {
  let sawOwner = ""
  let sawRepo = ""
  handle {
    const pr = ghPrGet(7, owner: "o", repo: "r")
  } with (intr) {
    if (intr.effect == "std::github::prGet") {
      sawOwner = intr.data.owner
      sawRepo = intr.data.repo
    }
    return reject()
  }
  if (sawOwner == "o" && sawRepo == "r") {
    return "pass"
  }
  return "FAIL payload had owner=${sawOwner} repo=${sawRepo}"
}

node defaultResolutionFillsPayload(): string {
  // No owner/repo passed: the origin remote of the agent working directory
  // is resolved BEFORE the raise, so the payload names it.
  const dir = makeSandbox()
  setAgentCwd(dir)
  let sawOwner = ""
  let sawRepo = ""
  handle {
    const pr = ghPrGet(1)
  } with (intr) {
    if (intr.effect == "std::github::prGet") {
      sawOwner = intr.data.owner
      sawRepo = intr.data.repo
    }
    return reject()
  }
  teardown(dir)
  if (sawOwner == "o" && sawRepo == "r") {
    return "pass"
  }
  return "FAIL payload had owner=${sawOwner} repo=${sawRepo}"
}

node payloadCarriesClampedPaging(): string {
  // Paging is clamped before the raise, so a handler judges the real request.
  let sawPerPage = 0
  let sawPage = 0
  handle {
    const issues = ghIssueList(perPage: 500, page: 0, owner: "o", repo: "r")
  } with (intr) {
    if (intr.effect == "std::github::issueList") {
      sawPerPage = intr.data.perPage
      sawPage = intr.data.page
    }
    return reject()
  }
  if (sawPerPage == 100 && sawPage == 1) {
    return "pass"
  }
  return "FAIL payload had perPage=${sawPerPage} page=${sawPage}"
}

node badNumberFailsBeforeRaise(): string {
  let raised = false
  handle {
    const pr = ghPrGet(7.5, owner: "o", repo: "r")
    if (!isFailure(pr)) {
      return "FAIL a fractional number went through"
    }
  } with (intr) {
    raised = true
    return reject()
  }
  if (raised) {
    return "FAIL the interrupt was raised for a fractional number"
  }
  return "pass"
}

node alwaysScopePinsOwnerAndRepo(): string {
  // Importing std::github registered the @always scopes at JS-load
  // (pattern: tests/agency/effect-always-registry).
  const scope: ScopedField[] = alwaysScopeFor("std::github::prGet")
  if (scope.length != 2) {
    return "FAIL scope: ${JSON.stringify(scope)}"
  }
  if (scope[0].field != "owner" || scope[0].matchSubpaths) {
    return "FAIL first field: ${JSON.stringify(scope)}"
  }
  if (scope[1].field != "repo" || scope[1].matchSubpaths) {
    return "FAIL second field: ${JSON.stringify(scope)}"
  }
  return "pass"
}

node rejectedWritePostsNothing(): string {
  setEnv("GITHUB_TOKEN", "test-token") with approve
  const comment = ghIssueComment(9, "should never land", owner: "o", repo: "r") with reject
  if (isFailure(comment)) {
    return "pass"
  }
  return "FAIL rejected comment was posted"
}

node approvedWritePostsBody(): string {
  setEnv("GITHUB_TOKEN", "test-token") with approve
  const comment = ghIssueComment(9, "hello from the test", owner: "o", repo: "r") with approve
  if (isFailure(comment)) {
    return "FAIL approved comment failed: ${JSON.stringify(comment)}"
  }
  if (comment.author != "agency-bot") {
    return "FAIL wrong mapping: ${JSON.stringify(comment)}"
  }
  return "pass"
}

node reviewPayloadCarriesComments(): string {
  let sawCount = 0
  let sawBody = ""
  handle {
    const r = ghPrReview(7, "COMMENT", "overall", [{ path: "a.ts", line: 3, body: "inline one" }], owner: "o", repo: "r")
  } with (intr) {
    if (intr.effect == "std::github::prReview") {
      sawCount = intr.data.comments.length
      sawBody = intr.data.comments[0].body
    }
    return reject()
  }
  if (sawCount == 1 && sawBody == "inline one") {
    return "pass"
  }
  return "FAIL payload comments: ${sawCount} ${sawBody}"
}

node approveIsItsOwnEffect(): string {
  setEnv("GITHUB_TOKEN", "test-token") with approve
  handle {
    const r = ghPrApprove(7, owner: "o", repo: "r")
    if (isFailure(r)) {
      return "pass"
    }
    return "FAIL prApprove went through under a review-only handler"
  } with (intr) {
    if (intr.effect == "std::github::prReview" || intr.effect == "std::github::prComment") {
      return approve()
    }
    return reject()
  }
}
