/** @module
  @summary The Agency agent as a program that does one task and exits.

  The spawning brain starts it as a process of its own, once per task.

  ```
  agency run --detach task.log --wait-for-response task.agency -- "Summarize the README"
  ```

  It runs the minimal brain: one coder with read, bash, edit, and write. It
  answers none of the agent's approval questions, so each one reaches the
  program's host. Started with `--wait-for-response`, the program holds each
  one until a person answers it with `agency attach`.

  The one question it answers itself is a budget that ran out. It ends the
  agent there, with the reply it has so far.
*/
import { agencyAgent } from "std::agents/agency"
import { parseArgs } from "std::args"

node main() {
  const args = parseArgs({
    programName: "task",
    description: "Run the Agency agent on one task, print its reply, and exit.",
    flags: {
      model: {
        type: "string",
        default: "",
        description: "The model, or the configured one when left out"
      },
      provider: {
        type: "string",
        default: "",
        description: "The model's provider"
      }
    }
  })
  const task = args.positionals.join(" ")
  if (task == "") {
    print("No task was given.")
    return
  }
  print("Task: ${task}")
  let reply: Result<string> = failure("no reply")
  handle {
    reply = agencyAgent(
      task,
      brain: "minimal",
      model: args.flags.model,
      provider: args.flags.provider,
    )
  } with (intr) {
    // Every other question is left for the person who attaches.
    if (intr.effect != "std::guard") {
      return pass()
    }
    // A budget ran out. Nobody is watching to grant more, so the agent
    // stops with its best result.
    print("The ${intr.data.dimension} budget ran out, so the agent was stopped.")
    return reject()
  }
  if (reply is success(text)) {
    print(text)
  } else if (reply is failure(err)) {
    print("The agent failed: ${err}")
  }
}
