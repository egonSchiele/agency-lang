/*
 * Harness tests: the work that happens around agencyAgent (slash
 * expansion, attachments, the hard stop for a budget trip, the grounding)
 * and the session wrapper that installs the policy handler around every
 * turn. The turns run the simple brain or the coordinator brain under a
 * scripted model, and the prompt each request carried is read from the
 * onLLMCallStart callback.
 *
 * `slashCommandExpands` depends on the working directory being
 * packages/agency-lang, whose .claude/commands/check-tests.md is the
 * fixture (projectCommands is a static read of ${cwd()}/.claude/commands).
 */
import { exists } from "std::shell"
import { currentThreadId, getThread } from "std::thread"

import { guardStopHandler } from "../lib/budget.agency"
import { cliSettings } from "../lib/answer.agency"
import { messageWasRewritten, setMessageRewritten } from "../lib/rewrittenMessage.agency"
import { setInteractive } from "../lib/trace.agency"
import {
  setBrainName,
  runTurn,
  runSession,
  setPolicyArg,
  resolveBrainName,
  resolveStartTarget,
 } from "../lib/turn.agency"
import { applyResolved } from "../shared.agency"

static const PNG = "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+M8AAAMBAQDJ/pLvAAAAAElFTkSuQmCC"

// The prompt of every model request, in order.
let prompts: any[] = []

callback("onLLMCallStart") as data {
  prompts = [...prompts, data.prompt]
}

let _readBinaryInterrupts = 0

// "text" for a bare message, or "array:<n>" for a message with n
// attachments after it.
def promptShape(prompt: any): string {
  return match(prompt) {
    text: string => "text"
    parts: any[] => "array:${parts.length - 1}"
  }
}

def promptText(prompt: any): string {
  return match(prompt) {
    text: string => text
    parts: any[] => "${parts[0]}"
  }
}

// The CLI policy is the inner handler and approves std::readBinary. Every
// approval is only a vote, so this outer handler sees an attempted read,
// records it, and rejects it. detectAttachments converts that rejection to a
// skipped attachment, which is why the final prompt alone cannot prove that
// no read was attempted.
def auditReadBinary(intr: any): any {
  if (intr.effect == "std::readBinary") {
    _readBinaryInterrupts = _readBinaryInterrupts + 1
    return reject("unexpected attachment read")
  }
  return pass()
}

// A plain message reaches the model as the bare text, and is not marked
// rewritten.
node plainMessageReachesTheModel(): string {
  setBrainName("simple")
  const reply = runTurn("", "hello there") with approve
  return "${reply}|${promptShape(prompts[0])}|${promptText(prompts[0])}|${messageWasRewritten()}"
}

// A project slash command is expanded by the harness before the model sees
// it, and marked rewritten so the router leaves it alone.
node slashCommandExpands(): string {
  setBrainName("simple")
  runTurn("", "/check-tests") with approve
  const text = promptText(prompts[0])
  return "${text.startsWith("/")}|${text.includes("Please review the tests you have written")}|${messageWasRewritten()}"
}

// An image path on the main target is detected, read, and attached by the
// harness. (The "📎 attached" line goes to the UI and is not asserted here.)
node mainTargetGetsAttachment(): string {
  setBrainName("simple")
  applyResolved(
    {
      main: {
        model: "gpt-4o",
        provider: "openai",
        via: "test"
      }
    },
  )
  writeBinary("turn-a.png", PNG, "/tmp") with approve
  runTurn("", "look at /tmp/turn-a.png") with approve
  return "${promptShape(prompts[0])}|${promptText(prompts[0]) == "look at /tmp/turn-a.png"}"
}

// A message to a named target arrives as bare text AND no read was
// attempted. The outer audit is essential: detectAttachments turns a
// rejected read into a skipped attachment, so prompt shape alone is not
// evidence that detection was bypassed.
node namedTargetGetsBareTextWithoutReading(): string {
  setBrainName("coordinator")
  setPolicyArg("${__dirname}/stubPolicy.json")
  writeBinary("turn-b.png", PNG, "/tmp") with approve
  let reply = ""
  handle {
    runSession(false) {
      reply = runTurn("oracle", "look at /tmp/turn-b.png")
    }
  } with auditReadBinary
  return "${reply}|${_readBinaryInterrupts}"
}

// A budget trip that no inner handler owns is a hard stop: the harness
// handler rejects it, so the guarded work returns a failure instead of
// parking on an unanswered interrupt.
node budgetTripIsHardStop(): string {
  setInteractive(false)
  let outcome = ""
  handle {
    const result = guard(cost: 0.000001, label: "sub") {
      return llm("Reply with a long answer.")
    }
    outcome = if isFailure(result) then "stopped" else "ran"
  } with guardStopHandler
  return outcome
}

// The unit tests for modalityFilter prove its internals. This integration
// case proves the harness still calls it before the turn is answered.
node textOnlyModelDropsAttachment(): string {
  setBrainName("simple")
  applyResolved(
    {
      main: {
        model: "gpt-3.5-turbo",
        provider: "openai",
        via: "test"
      }
    },
  )
  writeBinary("turn-text-only.png", PNG, "/tmp") with approve
  runTurn("", "look at /tmp/turn-text-only.png") with approve
  return promptShape(prompts[0])
}

// The CLI policy handler decides every interrupt a turn raises. With
// nobody present, a write it has no rule for is rejected, and the file is
// not written.
node sessionPolicyDecidesTheAgentsInterrupts(): string {
  setBrainName("coordinator")
  setPolicyArg("${__dirname}/stubPolicy.json")
  let reply = ""
  runSession(false) {
    reply = runTurn("", "write the file")
  }
  const written = exists("turn-policy-write.txt", "/tmp") with approve
  return "${reply}|${written}"
}

// The grounding is built once and added once, even after the working
// directory changes between turns, because its text holds the directory.
node groundingStaysOnThread(): string {
  setBrainName("simple")
  setPolicyArg("${__dirname}/stubPolicy.json")
  let count = -1
  runSession(false) {
    runTurn("", "first")
    setAgentCwd("/tmp")
    runTurn("", "second")
    const messages = getThread(currentThreadId(), 0, 200) catch []
    const facts = [message for message in messages if message.role == "system" && message.content.includes("<session_facts>")]
    count = facts.length
  }
  return "${count}"
}

// The router was measured on messages as the user typed them, so a turn
// whose message the harness rewrote passes no router model.
node rewrittenMessageGetsNoRouter(): string {
  applyResolved(
    {
      router: {
        model: "router-model",
        provider: "openai",
        via: "test"
      }
    },
  )
  setMessageRewritten(false)
  const typed = cliSettings().routerModel
  setMessageRewritten(true)
  const rewritten = cliSettings().routerModel
  return "${typed}|${rewritten}"
}

// The terminal reply style is the harness's, and only a REPL session has a
// reader for it.
node replStyleOnlyInTheRepl(): string {
  setInteractive(true)
  const repl = cliSettings().context.includes("terminal REPL")
  setInteractive(false)
  const oneShot = cliSettings().context.includes("terminal REPL")
  return "${repl}|${oneShot}"
}

node resolvesBrainNamePrecedence(): string {
  const flagWins = resolveBrainName("flag-brain", {
    brain: "settings-brain"
  })
  const settingsNext = resolveBrainName(null, {
    brain: "settings-brain"
  })
  const emptyFlagFallsThrough = resolveBrainName("", {
    brain: "settings-brain"
  })
  const defaultLast = resolveBrainName(null, {})
  return "${flagWins}|${settingsNext}|${emptyFlagFallsThrough}|${defaultLast}"
}

node resolvesStartTargets(): string {
  const emptyMain = resolveStartTarget("coordinator", "")
  const namedMain = resolveStartTarget("coordinator", "main")
  const coder = resolveStartTarget("coordinator", "code")
  const invalid = resolveStartTarget("coordinator", "bogus")
  return "${emptyMain == ""}|${namedMain == ""}|${coder == "code"}|${invalid == null}"
}
