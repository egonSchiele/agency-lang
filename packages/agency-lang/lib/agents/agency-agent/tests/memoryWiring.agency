import { setEnv } from "std::system"

import {
  overrideFromResolved,
  embeddingsOverride,
  providerEnvMissing,
  embeddingKeyStatus,
  memoryEnablePlan,
  memoryConfigFor,
  resolveLocalEmbedding,
  resolveLocalEmbeddingSlot,
  EmbeddingKeyStatus,
 } from "../shared.agency"
import { Resolved } from "../lib/models.agency"

// The override maps the slot value and demotes the provider.
node overrideFromSlot(): string {
  const override = embeddingsOverride({
    "embedding": {
      model: "text-embedding-3-small",
      provider: "openai-responses",
      via: "test"
    }
  })
  if (override == null) {
    return "null"
  }
  return "${override.model}/${override.provider}"
}

// Empty model, empty provider, and an absent slot all mean unset. The
// checks are explicit so a wrong non-null result cannot pin itself
// into the fixture.
node overrideNullCases(): string {
  const emptyModel = overrideFromResolved({
    model: "",
    provider: "llama-cpp",
    via: "local"
  })
  const emptyProvider = overrideFromResolved({
    model: "text-embedding-3-small",
    provider: "",
    via: "settings"
  })
  const absent = embeddingsOverride({})
  if (emptyModel == null && emptyProvider == null && absent == null) {
    return "all-null"
  }
  return "not-null"
}

// setEnv makes the key check deterministic. A set key is present, an
// empty key is missing, and unknown providers never report missing.
// The value == null branch stays untested here: std::system has no
// unsetEnv, and the inherited environment is machine-dependent. The
// degraded run in the e2e task covers it.
node keyMissingStates(): string {
  setEnv("OPENROUTER_API_KEY", "test-key") with approve
  const present = providerEnvMissing("openrouter")
  setEnv("OPENROUTER_API_KEY", "") with approve
  const missing = providerEnvMissing("openrouter")
  const unknown = providerEnvMissing("llama-cpp")
  return "${present}/${missing}/${unknown}"
}

// Proxy providers also need their base URL. A litellm override with the
// key set but no base URL is unusable, and the status names the base-URL
// var so the notices point at the right fix.
node baseUrlCountsAsMissing(): string {
  setEnv("LITELLM_API_KEY", "test-key") with approve
  setEnv("LITELLM_BASE_URL", "") with approve
  const slots = {
    "embedding": {
      model: "some-embed",
      provider: "litellm",
      via: "test"
    }
  }
  const missing = embeddingKeyStatus(slots)
  setEnv("LITELLM_BASE_URL", "http://localhost:4000") with approve
  const ready = embeddingKeyStatus(slots)
  return "${missing.state}:${missing.varName}/${ready.state}"
}

// The status composes override + key check, and carries the payload the
// checkpoints need.
node statusStates(): string {
  setEnv("OPENROUTER_API_KEY", "") with approve
  const slots = {
    "embedding": {
      model: "some-embed",
      provider: "openrouter",
      via: "test"
    }
  }
  const missing = embeddingKeyStatus(slots)
  setEnv("OPENROUTER_API_KEY", "key") with approve
  const ready = embeddingKeyStatus(slots)
  const none = embeddingKeyStatus({})
  return "${missing.state}:${missing.varName}/${ready.state}/${none.state}"
}

// The plan covers all four outcomes, including the precedence case
// where memory is on, no override exists, and a stale key flag could
// mislead a wrong implementation.
node planOutcomes(): string {
  const ready: EmbeddingKeyStatus = {
    state: "ready",
    override: {
      model: "m",
      provider: "openai"
    },
    varName: "OPENAI_API_KEY"
  }
  const missing: EmbeddingKeyStatus = {
    state: "key-missing",
    override: {
      model: "m",
      provider: "openai"
    },
    varName: "OPENAI_API_KEY"
  }
  const none: EmbeddingKeyStatus = {
    state: "no-override",
    override: null,
    varName: ""
  }
  const off = memoryEnablePlan(false, "default", ready)
  const noSlot = memoryEnablePlan(true, "default", none)
  const keyless = memoryEnablePlan(true, "default", missing)
  const good = memoryEnablePlan(true, "default", ready)
  return "${off}/${noSlot}/${keyless}/${good}"
}

// The wiring seam: the override reaches the config, and null keeps the
// default shape. This is what makes an ignored parameter in
// enableAgentMemory fail a test instead of shipping.
node configCarriesOverride(): string {
  const withOverride = memoryConfigFor({
    model: "text-embedding-3-small",
    provider: "openai"
  })
  const bare = memoryConfigFor(null)
  const embeddings = withOverride.embeddings
  if (embeddings == null) {
    return "override-lost"
  }
  const bareHasNone = bare.embeddings == null
  const dirsMatch = withOverride.dir == bare.dir
  return "${embeddings.model}/${embeddings.provider}/${bareHasNone}/${dirsMatch}"
}

// A provider-level memory:false yields to a ready embedding override; a
// user-level memory:false does not, and a provider-level off with no
// override stays off.
node planWithOverrideAndProviderOff(): string {
  const ready: EmbeddingKeyStatus = {
    state: "ready",
    override: {
      model: "mlx-community/Qwen3-Embedding-4B-4bit-DWQ",
      provider: "mlx"
    },
    varName: ""
  }
  const none: EmbeddingKeyStatus = {
    state: "no-override",
    override: null,
    varName: ""
  }
  const a = memoryEnablePlan(false, "provider", ready)
  const b = memoryEnablePlan(false, "user-global", ready)
  const c = memoryEnablePlan(false, "provider", none)
  const d = memoryEnablePlan(true, "default", ready)
  return "${a}/${b}/${c}/${d}"
}

// A catalog name becomes the served repo id, a repo id passes through, a
// hosted provider and a catalog typo are failures.
node resolveLocalEmbeddingSpecs(): string {
  const catalog = resolveLocalEmbedding("mlx/qwen3-embedding-4b-mlx")
  const raw = resolveLocalEmbedding("mlx/mlx-community/Other-Embedding-4bit")
  const hosted = resolveLocalEmbedding("openai/text-embedding-3-small")
  const typo = resolveLocalEmbedding("mlx/qwen3-embeding")
  const a = if isFailure(catalog) then "ERR" else catalog.value.model
  const b = if isFailure(raw) then "ERR" else raw.value.model
  const c = if isFailure(hosted) then "ERR" else "ok"
  const d = if isFailure(typo) then "ERR" else "ok"
  return "${a}|${b}|${c}|${d}"
}

// A local provider in the embedding slot resolves to the served name; a
// hosted one passes through untouched.
node localEmbeddingSlotResolves(): string {
  const main: Resolved = {
    model: "gpt-5.5",
    provider: "openai",
    via: "test"
  }
  const local = resolveLocalEmbeddingSlot({
    main: main,
    embedding: {
      model: "qwen3-embedding-4b-mlx",
      provider: "mlx",
      via: "settings"
    }
  })
  const hosted = resolveLocalEmbeddingSlot({
    main: main,
    embedding: {
      model: "text-embedding-3-small",
      provider: "openai",
      via: "settings"
    }
  })
  const a = if isFailure(local) then "ERR" else "${local.value.embedding.model}:${local.value.embedding.via}"
  const b = if isFailure(hosted) then "ERR" else hosted.value.embedding.model
  return "${a}|${b}"
}

// llama-cpp/<name> parses as a local embedding spec. The download itself
// is the integration suite's job; here the name exists nowhere, and
// registerLocalModel's failure is what comes back.
node llamaCppEmbeddingSpec(): string {
  const r = resolveLocalEmbedding("llama-cpp/definitely-not-a-model-name")
  if (isFailure(r)) {
    return if r.error.includes("Unknown local model") then "unknown-model" else "other:${r.error}"
  }
  return "ok:${r.value.provider}"
}
