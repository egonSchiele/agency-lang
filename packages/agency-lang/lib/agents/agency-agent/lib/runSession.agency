/** @module
  @summary The terminal agent's session wrapper: the policy flags, and the
  one place that installs the CLI policy handler around every turn. It
  prompts at the terminal, so the session core does not use it: there the
  policy is the run's own. See docs/dev/agents/agent-brains.md.
*/
import { _exit } from "agency-lang/stdlib-lib/system.js"
import { cliPolicyHandler } from "std::policy"

import { parseAgentArgs } from "./args.agency"
import { claudeSkillCommands } from "./claudeSkills.agency"
import { checkCliBundles } from "./cliTools.agency"
import { projectCommands } from "./commandPalette.agency"
import { groundingText, setGrounding } from "./grounding.agency"
import { getPolicyForAgent } from "./policy.agency"
import { approvingInstructionReads } from "./projectContext.agency"
import { NO_BRAIN, currentBrainName } from "./turn.agency"

// The `--policy` argument (a built-in name or a policy-file path), or ""
// when absent. main() sets it; policyHandlerFor() reads it.
let _policyArg: string = ""

// The `--approve` / `--reject` arguments (effect lists), or "" when
// absent. Session-only overlays on the resolved policy.
let _approveArg: string = ""
let _rejectArg: string = ""

export def setPolicyArg(arg: string, approve: string = "", reject: string = "") {
  _policyArg = arg
  _approveArg = approve
  _rejectArg = reject
}

/** True when the session's approvals come from the saved policy file,
  and false under --policy, --approve, or --reject, which run on a
  per-session copy that is never written back to it. */
export def usesSavedPolicy(): boolean {
  return _policyArg == "" && _approveArg == "" && _rejectArg == ""
}

// Load (or initialize) the policy and return the installed CLI policy handler.
def policyHandlerFor(interactive: boolean): any {
  const { policyFile, startPolicy } = getPolicyForAgent(_policyArg, _approveArg, _rejectArg, interactive)
  const handler = cliPolicyHandler(
    file: policyFile,
    policy: startPolicy,
    // One-shot (-p) runs have no user at a terminal: an undecided effect
    // is rejected with a reason the model reads, never prompted.
    interactive: interactive,
  )
  return approvingInstructionReads.partial(policyHandler: handler, rules: startPolicy ?? {})
}

export def runSession(interactive: boolean, body: () -> void raises <*>) {
  """
  The only place a turn is answered from. Builds the grounding once, then
  installs the policy handler, checks the bundled files under it, and runs
  `body` (the one-shot turn or the REPL) under it. Both production paths
  go through here.
  """
  const brainName = currentBrainName()
  if (brainName == "") {
    throw(NO_BRAIN)
    return
  }
  // Built before the policy handler exists, so reading the project's
  // AGENTS.md never prompts. Every turn adds this same string.
  setGrounding(groundingText(brainName, parseAgentArgs().flags))
  // The same for the user's commands and skills: scanned here, and every
  // turn reads what this process kept.
  claudeSkillCommands()
  projectCommands()
  const handler = policyHandlerFor(interactive)
  handle {
    const bundles = checkCliBundles()
    if (bundles is failure(reason)) {
      print(color.red(reason))
      _exit(1)
    }
    body()
  } with handler
}
