// call.args is the arguments the decorator was handed. It does not change
// when the decorator rebinds, so block(call.args) after block({...}) runs
// the body with the original arguments.
decorator def twice(call: Call, block: (args: object) -> any): any {
  block({ ...call.args, n: 100 })
  return block(call.args)
}

@twice
def f(n: number): number {
  return n
}

node main() {
  return f(7)
}
