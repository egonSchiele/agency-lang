/** @module
  @summary The interactive terminal: slash commands, the status line, and how
  a line reaches the session. The session runs in its own run, through the
  driver (terminal.agency): a message or a command that changes the session
  is sent to it as an answer, and what the commands show is read from its
  pause. See docs/dev/agents/session-driver.md, "The terminal".
*/
import {
  _cost,
  _costRows,
  _endedBecause,
  _footerTokens,
  _pause,
  _send,
 } from "agency-lang/stdlib-lib/agentTerminalDriver.js"
import { localModelsSupported, listModelNames } from "std::agency/local"
import { listHostedModels } from "std::llm"
import {
  chooseOption,
  ChoiceItem,
  pushMessage,
  lineWasTyped,
  repl,
  clearHistory,
  clearScreen,
 } from "std::ui/cli"

import { settingsSlashCommand } from "./capabilitiesUi.agency"
import { HISTORY_PATH } from "./config.agency"
import { mcpSlashCommand } from "./mcpMenu.agency"
import { filterHostedModels } from "./modelFilters.agency"
import { presetListLines, presetTable } from "./presets.agency"
import { availableBackendItems } from "./search.agency"
import {
  modelChoiceItems,
  scopedPickerNotes,
  parseModelsFilters,
  parsePresetCommand,
 } from "./session.agency"
import { displayTitle } from "./sessions.agency"
import { attachClipboardImage } from "./slashCommands/image.agency"
import { policySlashCommand } from "./slashCommands/policy.agency"
import { shellCommand } from "./slashCommands/shell.agency"
import { jobsSlashCommand } from "./slashCommands/jobs.agency"
import { sendMessage, sendSeedMessage } from "./terminal.agency"
import { parseModelSpec } from "./utils.agency"

/** What the session reported at its last pause, or an empty object before
  it has one. */
def pauseNow(): any {
  return _pause() ?? {}
}

def searchSlashCommand(): boolean {
  const before = pauseNow()
  const opts = availableBackendItems()
  const choice = chooseOption(
    "Web search backend",
    "Pick how this agent searches the web. Current: ${before.search ?? ""}",
    opts,
    false,
    true,
  )
  if (choice != "" && choice != null && choice != undefined) {
    // A backend the session can't use is reported by the session itself.
    _send({ kind: "search", backend: choice })
    const after = pauseNow()
    if (after.search == choice) {
      pushMessage("Web search backend set to: ${choice}")
    }
  }
  return true
}

// The usage rows give one row per kind and model, so the model name alone
// does not identify a row: a model used for completions and for images has
// two, and an addCost() charge has kind "manual" and no model at all.
def costRowLabel(kind: string, model: string): string {
  if (kind == "completion") {
    return model
  }
  if (model == "") {
    return "(${kind})"
  }
  return "${model} (${kind})"
}

def costSlashCommand(): boolean {
  // The session's usage, from the driver: the run's own total, which a
  // checkpoint carries across a resume.
  const byModel = _costRows()
  let totalTokens = 0
  let totalCacheRead = 0
  let totalCacheWrite = 0
  for (m in byModel) {
    // Cache reads and writes are input tokens too. Counting only
    // inputTokens + outputTokens reports a fraction of a cached
    // conversation — on a long agent run, often under a tenth of it.
    totalTokens = totalTokens
      + m.inputTokens + m.outputTokens
      + m.cachedInputTokens + m.cacheCreationInputTokens
    totalCacheRead = totalCacheRead + m.cachedInputTokens
    totalCacheWrite = totalCacheWrite + m.cacheCreationInputTokens
  }
  pushMessage("Cost:   $${_cost().toFixed(4)}")
  pushMessage("Tokens: ${totalTokens}")
  if (totalCacheRead > 0 || totalCacheWrite > 0) {
    pushMessage(
      color.dim("        ${totalCacheWrite} written to cache, ${totalCacheRead} read back"),
    )
  }
  if (byModel.length > 0) {
    pushMessage("")
    pushMessage("By model:")
    for (m in byModel) {
      const up = m.inputTokens + m.cachedInputTokens + m.cacheCreationInputTokens
      pushMessage(
        "  ${costRowLabel(m.kind, m.model)}  ↑${up} ↓${m.outputTokens}  $${m.cost.toFixed(4)}",
      )
    }
  }
  return true
}

def pushSlots(heading: string, models: any) {
  pushMessage(heading)
  for (slot in Object.keys(models)) {
    const value = models[slot]
    if (value != null) {
      pushMessage(color.dim("  ${slot}: ${value.model} (${value.via})"))
    }
  }
}

/** True when the session's models changed between two pauses. */
def modelsChanged(before: any, after: any): boolean {
  return JSON.stringify(before.models ?? {}) != JSON.stringify(after.models ?? {})
}

def modelSlashCommand(command: string): boolean {
  let spec = parseModelSpec(command)
  const before = pauseNow()
  if (spec == "") {
    pushSlots("Current models:", before.models ?? {})
    const established = before.fixedProvider ?? ""
    const items = modelChoiceItems({}, established)
    for (line in scopedPickerNotes(established, items.length)) {
      pushMessage(color.dim(line))
    }
    const choice = chooseOption(
      "Model",
      "Pick a model, or type one (or slot=model, e.g. reasoning=claude-opus-4-8). Empty to cancel.",
      items,
      allowFreeText: true,
      allowCancel: true,
    )
    if (choice == "" || choice == null) {
      return true
    }
    spec = choice
  }
  // A refused spec is reported by the session itself, as an error notice.
  _send({ kind: "model", spec: spec })
  const after = pauseNow()
  if (modelsChanged(before, after)) {
    pushSlots("Model set:", after.models ?? {})
  }
  return true
}

def presetSlashCommand(command: string): boolean {
  const parsed = parsePresetCommand(command)
  if (parsed.kind == "list") {
    const current = pauseNow()
    for (line in presetListLines(presetTable(), current.preset ?? "")) {
      pushMessage(line)
    }
    return true
  }
  if (parsed.kind == "save") {
    _send({ kind: "savePreset", name: parsed.name })
    return true
  }
  const name = parsed.name
  _send({ kind: "preset", name: name })
  const after = pauseNow()
  if (after.preset == name) {
    pushSlots("Preset set: ${name}", after.models ?? {})
  }
  return true
}

def modelsSlashCommand(trimmed: string): boolean {
  const filters = parseModelsFilters(trimmed)
  const models = filterHostedModels(listHostedModels(), filters)
  if (models.length == 0) {
    pushMessage("No models match.")
    return true
  }
  for (model in models) {
    pushMessage(
      "  ${model.name}  (${model.provider}, $${model.inputCost}/1M in, $${model.outputCost}/1M out, ${model.contextWindow} ctx)",
    )
  }
  return true
}

def localSlashCommand(): boolean {
  if (!localModelsSupported()) {
    pushMessage(
      color.yellow(
      "Local models need smoltalk-llama-cpp. Install:  ! npm i -g smoltalk-llama-cpp",
    ),
    )
    return true
  }
  let items: ChoiceItem[] = []
  for (modelName in listModelNames()) {
    items.push({
      key: modelName.name,
      label: modelName.name
    })
  }
  const choice = chooseOption(
    "Local model",
    "Pick a local model, or type an hf: URI / .gguf path (downloads on first use):",
    items,
    allowFreeText: true,
    allowCancel: true,
  )
  if (choice == "" || choice == null) {
    return true
  }
  // The session switches and says so, or says why it can't.
  _send({ kind: "local", model: choice })
  return true
}

// Slash-command + user-message dispatcher invoked by `repl()` for
// every Enter keystroke. Return `false` to terminate the loop.
def _runTurn(msg: string): boolean {
  const goOn = dispatch(msg)
  // Another front-end took the session: it can't go on here.
  if (_endedBecause() != "") {
    return false
  }
  return goOn
}

def dispatch(msg: string): boolean {
  // Trim once for built-in matching so `"/help\n"` (piped) or
  // `"  /clear"` behave the same as `"/clear"`. The session receives the
  // raw `msg`, so the model sees the exact text the user typed.
  const trimmed = msg.trim()
  return match(trimmed) {
    "" => true
    "/exit" => false
    "/quit" => false
    "/clear" => {
      clearScreen()
      return true
    }
    "/clear-history" => {
      clearHistory()
      pushMessage("Input history cleared.")
      return true
    }
    "/help" => {
      pushMessage(
        "Commands: /exit, /clear, /clear-history, /cost, /model, /models, /local, /preset, /policy, /search, /settings, /mcp, /rename, /init, /image, /compact, /fork, /jobs, /paste, /help. Start a line with ! to run a shell command yourself.",
      )
      return true
    }
    "/settings" => settingsSlashCommand()
    "/mcp" => mcpSlashCommand()
    "/search" => searchSlashCommand()
    "/cost" => costSlashCommand()
    "/model" => modelSlashCommand(trimmed)
    "/models" => modelsSlashCommand(trimmed)
    "/local" => localSlashCommand()
    "/preset" => presetSlashCommand(trimmed)
    "/policy" => policySlashCommand()
    "/rename" => sendAnswer({ kind: "rename", title: "" })
    "/image" => imageSlashCommand("")
    "/compact" => sendAnswer({ kind: "compact", keep: "" })
    "/jobs" => jobsSlashCommand("")
    "/fork" => sendAnswer({ kind: "fork" })
    _ => prefixedCommand(trimmed, msg)
  }
}

def prefixedCommand(trimmed: string, msg: string): boolean {
  if (isShellCommand(trimmed)) {
    return shellCommand(trimmed.slice(1).trim())
  }
  if (trimmed.startsWith("/image ")) {
    return imageSlashCommand(trimmed.slice(7).trim())
  }
  if (trimmed.startsWith("/jobs ")) {
    return jobsSlashCommand(trimmed.slice(6))
  }
  if (trimmed.startsWith("/compact ")) {
    return sendAnswer({ kind: "compact", keep: trimmed.slice(9).trim() })
  }
  if (trimmed.startsWith("/rename ")) {
    return sendAnswer({ kind: "rename", title: trimmed.slice(8) })
  }
  if (trimmed.startsWith("/model ")) {
    return modelSlashCommand(trimmed)
  }
  if (trimmed.startsWith("/models ")) {
    return modelsSlashCommand(trimmed)
  }
  if (trimmed.startsWith("/preset ")) {
    return presetSlashCommand(trimmed)
  }
  sendMessage(msg)
  return true
}

/** Sends a command's answer. The session reports what it did with a
  notice, which the terminal's trace callbacks print. */
def sendAnswer(answer: any): boolean {
  _send(answer)
  return true
}

// A `!` line is a shell command only when the user typed it and pressed
// Enter at the prompt. Pasted text, a `/paste` buffer, and text written in
// the editor go to the model as a message, however they start, because a
// command here runs with no approval.
def isShellCommand(trimmed: string): boolean {
  return trimmed.startsWith("!") && !trimmed.includes("\n") && lineWasTyped()
}

// `/image` alone holds the image for the next message. With text after
// it, that text is sent now, with the image.
def imageSlashCommand(message: string): boolean {
  if (!attachClipboardImage()) {
    return true
  }
  if (message == "") {
    pushMessage(color.dim("The image will go with your next message."))
    return true
  }
  sendMessage(message)
  return true
}

/** The footer: the session's title, its spend, and how full its context
  is, as the session reported them at its last pause. */
export def buildStatus(): { left: string; right: string; context: string } {
  const pause = pauseNow()
  const record = pause.record ?? null
  const title = if record == null then "" else displayTitle(record)
  return {
    left: title,
    right: "$${_cost().toFixed(4)}",
    context: pause.context ?? ""
  }
}

/** The session's tokens, for the footer's per-turn counts. */
def footerTokens(): any {
  return _footerTokens()
}

/** Runs the REPL on the session, after the `-i` prompt when there is one. */
export def startInteractive(seedTarget: string, seedPrompt: string, saveHistory: boolean = true) {
  if (seedPrompt != "") {
    sendSeedMessage(seedPrompt, seedTarget)
  }
  // "" turns the history file off, for an incognito session.
  const historyFile = if saveHistory then HISTORY_PATH else ""
  repl(
    status: buildStatus,
    onSubmit: _runTurn,
    prompt: "> ",
    historyFile: historyFile,
    historyMax: 1000,
    herdrName: "agency",
    tokens: footerTokens,
  )
  print(color.cyan("\nGoodbye!"))
}
