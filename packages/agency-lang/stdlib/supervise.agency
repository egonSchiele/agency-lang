/** @module
@summary Check and steer long-running work at regular intervals.

```ts
import { supervise, SuperviseDecision } from "std::supervise"

def checkProgress(elapsed: number, draft: any): SuperviseDecision {
  printJSON(draft)
  return { action: "continue", message: "" }
}

node main() {
  return supervise(every: 5m, maxTime: 30m, check: checkProgress) {
    return llm("Investigate the task", { tools: [saveDraft] })
  }
}
```

The callback can continue, redirect with a message, or stop. Redirection
steers a paused LLM loop. Continue and stop work for any block.
Stopping can return work the block preserved with `saveDraft`.

Use supervision in one execution path. Concurrent sibling fork branches
can assign the same guard label and answer each other's checks.
*/

/**
The check's decision. `message` supplies redirect text or a stop reason;
continue ignores it.
*/
export type SuperviseDecision = {
  action: "continue" | "redirect" | "stop";
  message: string
}

// Give nested instances separate guard labels. Forks clone this counter,
// so sibling instances can still collide while sharing a handler chain.
let _instanceCounter = 0

/**
The check receives elapsed working time and the latest saved draft, or null.
Use the draft to assess progress. A stopped block can return a saved partial
result under the usual guard salvage rules.
*/
export def supervise(
  every: number,
  maxTime: number,
  check: (elapsed: number, draft: any) -> SuperviseDecision,
  block: () -> any,
): Result<any> {
  """
  Run a block and periodically check whether to continue, redirect, or stop.
  Do not call supervise concurrently in sibling fork branches.

  @param every - Working-time interval in milliseconds between checks.
  @param maxTime - Total working-time budget in milliseconds, at least `every`.
  @param check - Callback receiving elapsed time and the latest saved draft.
  """
  if (maxTime < every) {
    return failure("supervise: maxTime is less than the check interval, so no checkpoint would ever be reached")
  }
  _instanceCounter = _instanceCounter + 1
  const instanceLabel = "std::supervise#${_instanceCounter}"
  handle {
    const captured = guard(time: every, label: instanceLabel) {
      return block()
    }
    return captured
  } with (intr) {
    // Match this instance so nested guards keep their own handlers and budgets.
    if (intr.effect != "std::guard" || intr.data.label != instanceLabel) {
      return pass()
    }
    // Count actual working time, including overshoot before a trip is answered.
    const spent = intr.data.spent
    if (spent >= maxTime) {
      return reject("supervise: maxTime reached")
    }
    // guardTripInterrupt provides the innermost saved draft as a progress report.
    const decision = check(spent, intr.data.draftValue ?? null)
    // Grants add to the old limit. Cover overshoot before adding the next
    // interval, or the runtime would refuse a grant that leaves it exceeded.
    const overshoot = spent - intr.data.limit
    let nextInterval = every
    if (maxTime - spent < every) {
      nextInterval = maxTime - spent
    }
    const grant = overshoot + nextInterval
    return match(decision.action) {
      "continue" => approve({ maxTime: grant })
      "redirect" => approve({ maxTime: grant, message: decision.message })
      "stop" => reject(decision.message)
    }
  }
}
