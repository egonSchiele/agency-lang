// The brain names the CLI accepts and the --agent targets each brain has.
// The brains themselves are listed by agencyAgentBrains in std::agents/agency.
import { brainFlagHelp } from "../lib/args.agency"
import { resolveStartTarget } from "../lib/turn.agency"

node helpListsRegisteredBrains(): string {
  const help = brainFlagHelp()
  return "${help.includes("default: coordinator")}|${help.includes("coordinator: One coordinator LLM")}|${help.includes("simple: ")}"
}

// `main` is the brain's own entry. Only the coordinator has subagents to
// start directly.
node startTargetsOnlyForTheCoordinator(): string {
  const main = resolveStartTarget("simple", "main")
  const coderOnCoordinator = resolveStartTarget("coordinator", "code")
  const coderOnSimple = resolveStartTarget("simple", "code")
  const unknown = resolveStartTarget("coordinator", "bogus")
  return "${main}|${coderOnCoordinator}|${coderOnSimple == null}|${unknown == null}"
}
