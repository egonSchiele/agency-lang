    globPayloads("find . -not -name '*.txt'"),
    globPayloads("find . -name '*.txt' -o -type d"),
    globPayloads("find . -path ./node_modules -prune -o -name '*.txt'"),
    globPayloads("find . -maxdepth 1 -not -name x"),
