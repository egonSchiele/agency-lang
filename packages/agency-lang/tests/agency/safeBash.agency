    refAndPath("git log one.txt --"),
    refAndPath("git diff main one.txt"),
    refAndPath("git diff main -- one.txt"),
    refAndPath("git blame one.txt"),
    refAndPath("git blame -- one.txt"),
    refAndPath("git blame nope.txt"),
    refAndPath("git log one.txt two.txt"),
    refAndPath("git log -- -x"),
    refAndPath("git log 'one.txt'"),
  ]
}

