import { WriteMode } from "std::index"

import { keepOutput } from "std::spill"

import { _write, _read } from "agency-lang/stdlib-lib/builtins.js"
import { _bash, _grep } from "agency-lang/stdlib-lib/shell.js"
import { _renderGrepOutput, _skippedDirsNote } from "agency-lang/stdlib-lib/grepDialect.js"
import { _renderReadView } from "agency-lang/stdlib-lib/readDialect.js"

/** @module
@summary Represent and execute plans made by safeBash.

Use `safeBash` from `std::safeBash` to run commands. This module holds its
plan types and executors. Executors assume the caller has already approved
every effect in the plan; they do not raise those approvals themselves.

```ts
import { outcomeOf, planFor } from "std::safeBash"

node main() {
  const plan = planFor("git status", "/project")
  print(outcomeOf(plan))
}
```

A plan pairs the required approvals with an execution. Inspect the plan to
test classification without executing its commands.
*/

/** A required approval, with a payload checked for its effect. */
export type Effect =
  | { name: "std::bash" }
  | { name: "std::write"; payload: WritePayload }
  | { name: "std::git::status"; payload: { cwd: string } }
  | { name: "std::git::log"; payload: { cwd: string; ref: string; path: string } }
  | { name: "std::git::diff"; payload: GitDiffPayload }
  | { name: "std::grep"; payload: GrepPayload }
  | { name: "std::read"; payload: ReadPayload }
  | { name: "std::ls"; payload: LsPayload }
  | { name: "std::glob"; payload: GlobPayload }
  | { name: "std::exec"; payload: ExecPayload }

export type WritePayload = {
  dir: string;
  filename: string;
  content: string;
  mode: WriteMode
}

/**
Build the write approval from the same payload used by `writeExecution`.
*/
export def writeEffect(write: WritePayload): Effect {
  """Build a write approval descriptor without raising it."""
  return {
    name: "std::write",
    payload: write
  }
}

export def writeExecution(write: WritePayload): WriteExec {
  """Build a file-write execution plan without running it."""
  return {
    kind: "write",
    filename: write.filename,
    dir: write.dir,
    content: write.content,
    mode: write.mode
  }
}

/** The fields the grep tool's own std::grep interrupt carries. */
export type GrepPayload = {
  pattern: string;
  dir: string;
  file: string | null;
  flags: string;
  maxResults: number;
  ignoreCase: boolean;
  wholeWord: boolean;
  filesOnly: boolean;
  invert: boolean
}

export def grepEffect(payload: GrepPayload): Effect {
  """Build a grep approval descriptor without raising it."""
  return {
    name: "std::grep",
    payload: payload
  }
}

/** The fields the read tool's own std::read interrupt is keyed on: the
 real parent of the file, and its name. */
export type ReadPayload = {
  dir: string;
  filename: string
}

export def readEffect(payload: ReadPayload): Effect {
  """Build a file-read approval descriptor without raising it."""
  return {
    name: "std::read",
    payload: payload
  }
}

/** The fields the ls tool's own std::ls interrupt is keyed on. On the
 bash path `maxResults` is 0, meaning no cap: real ls, tree, and du list
 everything. */
export type LsPayload = {
  dir: string;
  recursive: boolean;
  maxResults: number
}

export def lsEffect(payload: LsPayload): Effect {
  """Build a directory-listing approval descriptor without raising it."""
  return {
    name: "std::ls",
    payload: payload
  }
}

/** The fields the glob tool's own std::glob interrupt is keyed on. On the
 bash path `maxResults` is 0, meaning no cap: real find lists
 everything. */
export type GlobPayload = {
  pattern: string;
  dir: string;
  maxResults: number
}

export def globEffect(payload: GlobPayload): Effect {
  """Build a file-search approval descriptor without raising it."""
  return {
    name: "std::glob",
    payload: payload
  }
}

/** The fields the exec tool's own std::exec interrupt carries. From
 safeBash, `cwd` is safeBash's resolved working directory, `timeout` is
 0 and `stdin` is empty, which is how safeBash runs the line, and an
 argument may be an unexpanded glob or `~` that bash expands. */
export type ExecPayload = {
  command: string;
  args: string[];
  subcommand: string;
  cwd: string;
  timeout: number;
  stdin: string
}

export def execEffect(payload: ExecPayload): Effect {
  """Build a command-execution approval descriptor without raising it."""
  return {
    name: "std::exec",
    payload: payload
  }
}

export type GitDiffPayload = {
  cwd: string;
  ref: string;
  ref2: string;
  staged: boolean;
  path: string
}

// Dispatch in safeBash must handle every execution variant.
/** What happens if every effect in the plan is approved. */
export type Execution = BashExec | EchoExec | WriteExec | AgencyExec | RefuseExec | GrepExec | ReadExec | ChainExec

export type BashExec = {
  kind: "bash";
  command: string
}

export type EchoExec = {
  kind: "echo";
  content: string
}

/** An `agency <subcommand> <file>` line, run through std::agency's cli(). */
export type AgencyExec = {
  kind: "agency";
  args: string[]
}

export type WriteExec = {
  kind: "write";
  filename: string;
  dir: string;
  content: string;
  mode: WriteMode
}

/** Whether grep prints file names: `-H` gives "always", `-h` gives
 "never", neither gives "default". */
export type GrepFileNames = "default" | "always" | "never"

/** What a grep command said about printing. The rules that turn this
 into grep's output live in `_renderGrepOutput`
 (lib/stdlib/grepDialect.ts), whose type of the same name must keep
 these fields. */
export type GrepRender = {
  /** `-n` was given. */
  lineNumbers: boolean;
  fileNames: GrepFileNames;
  /** The path as bash hands it to grep, or "" when none was written. */
  argument: string;
  /** The path names one file, not a directory. */
  oneFile: boolean
}

/** A lone grep, run through the grep tool's own search with no shell.
 The search reads only what `payload` says, so the approval means what
 the grep tool's approval means. */
export type GrepExec = {
  kind: "grep";
  payload: GrepPayload;
  render: GrepRender
}

/**
Build the search execution from the same payload used by `grepEffect`.
*/
export def grepExecution(payload: GrepPayload, render: GrepRender): GrepExec {
  """Build a grep execution plan without running the search."""
  return {
    kind: "grep",
    payload: payload,
    render: render
  }
}

/** How the shell-free path prints a file: whole, numbered (cat -n), the
 first `lines` lines (head), or the last `lines` lines (tail). The rules
 live in `_renderReadView` (lib/stdlib/readDialect.ts), whose type of
 the same name must keep these fields. */
export type ReadView =
  | { kind: "whole" }
  | { kind: "numbered" }
  | { kind: "head"; lines: number }
  | { kind: "tail"; lines: number }

/** A lone cat of one or more files, or a head or tail of one, run
 through the read tool's own read with no shell. The read covers only
 what `payloads` names, so the approval means what the read tool's
 approval means. */
export type ReadExec = {
  kind: "read";
  payloads: ReadPayload[];
  view: ReadView
}

/** How a chain step follows the one before it: `;` always runs it, `&&`
 only after a success, `||` only after a failure. */
export type Join = "seq" | "and" | "or"

/** The executions a chain may hold: every in-process kind, and nothing
 that spawns a shell. */
export type StepExec = EchoExec | WriteExec | GrepExec | ReadExec

export type ChainStep = {
  join: Join;
  execution: StepExec
}

/** Several in-process commands joined by `;`, `&&`, or `||`, run left to
 right with bash's rule for each join. */
export type ChainExec = {
  kind: "chain";
  steps: ChainStep[]
}

/**
Build file reads from the same payloads used by `readEffect`.
*/
export def readExecution(payloads: ReadPayload[], view: ReadView): ReadExec {
  """Build a file-read execution plan without reading files."""
  return {
    kind: "read",
    payloads: payloads,
    view: view
  }
}

export type RefuseExec = {
  kind: "refuse";
  reason: string
}

/** Why a plan asks the broad std::bash question. `detail` is the parser
 message for `unparseable`, the first unrecognized command's message for
 `unrecognized`, the render failure for `unrenderable`, and "" for
 `noEffects`. */
export type BroadReason = {
  kind: "unparseable" | "unrecognized" | "noEffects" | "unrenderable";
  detail: string
}

/** The whole decision about one call to safeBash, made before anything runs. */
export type Plan = {
  effects: Effect[];
  execution: Execution;
  /** Why the plan asks the broad std::bash question, or null when it does not. */
  broadReason: BroadReason | null;
  /** The command word of every simple command planFor decided over, in
    order; "" for an assignment-only command; [] when unparseable. */
  verbs: string[]
}

/**
Requires Bash on the search path. Successful stderr is omitted from the
result. Nonzero exits return failures, including grep's "no match" and
diff's "files differ" statuses. Long output is saved with a preview.
*/
@capabilities(fileRead, subprocess)
export def runBash(command: string, cwd: string, source: string = ""): Result<string> {
  """
  Execute a Bash command after its planned effects have been approved.
  Return stdout on success, or an exit failure with output on nonzero exit.
  """
  // raiseAll already obtained the plan's approvals. Use _bash to avoid
  // asking for a second, broader approval after those specific decisions.
  const attempt = try _bash(command, cwd, 0, "", {})
  if (attempt is failure(why)) {
    return failure("`${command}` was not run: ${why}")
  }
  // try wraps the returned ExecResult in the success value.
  const result: any = attempt.value
  // `source` is the command as the user typed it, which can differ from
  // the narrowed text this function ran; the trace names the original.
  const label = if (source == "") then command else source
  if (result.exitCode != 0) {
    return exitFailure(command, result.exitCode, result.stdout, result.stderr, label)
  }
  return success(keepOutput(result.stdout, result.exitCode, label))
}

// Include the exit code and both streams, saving long output for later retrieval.
def exitFailure(command: string, exitCode: number, stdout: string, stderr: string, label: string): Result<string> {
  const out = keepOutput(stdout, exitCode, label)
  return failure(
    JSON.stringify(
    {
    command: command,
    exitCode: exitCode,
    stderr: keepOutput(stderr, exitCode, label),
    stdout: out
  },
  ),
  )
}

@capabilities(fileRead)
export def runGrep(exec: GrepExec, command: string): Result<string> {
  """
  Execute an approved in-process grep plan and return its rendered output.
  No matches return an exit-code-1 failure.
  """
  const found = grepResults(exec)
  if (isFailure(found)) {
    return found
  }
  const results: any[] = found.value
  if (results.length == 0) {
    return exitFailure(command, 1, "", grepNotes(exec.payload, 0), command)
  }
  return success(keepOutput(grepText(exec, results), 0, command))
}

@capabilities(fileRead)
export def printGrep(exec: GrepExec): Result<string> {
  """
  Execute an approved grep plan and return its full output.
  No matches return a failure carrying any search notes.
  """
  const found = grepResults(exec)
  if (isFailure(found)) {
    return found
  }
  const results: any[] = found.value
  if (results.length == 0) {
    return failure(grepNotes(exec.payload, 0))
  }
  return success(grepText(exec, results))
}

@capabilities(fileRead)
def grepResults(exec: GrepExec): Result<any[]> {
  // The caller already approved std::grep for this payload.
  const payload = exec.payload
  const query = {
    pattern: payload.pattern,
    flags: payload.flags,
    ignoreCase: payload.ignoreCase,
    wholeWord: payload.wholeWord,
    filesOnly: payload.filesOnly,
    invert: payload.invert
  }
  return try _grep(payload.dir, ".", query, payload.maxResults, [], true, payload.file)
}

// Append search notes after the rendered matches.
def grepText(exec: GrepExec, results: any[]): string {
  const printed = _renderGrepOutput(results, exec.render)
  const notes = grepNotes(exec.payload, results.length)
  if (notes == "") {
    return printed
  }
  return printed + notes + "\n"
}

@capabilities(fileRead)
export def runRead(exec: ReadExec, command: string): Result<string> {
  """
  Execute approved file reads and return cat, head, or tail output.
  """
  return match(printRead(exec)) {
    success(text) => success(keepOutput(text, 0, command))
    failure(why) => failure(why)
  }
}

/**
Files are concatenated before rendering, so a missing final newline joins
the next file's first line. A failed read drops previously collected text.
*/
@capabilities(fileRead)
export def printRead(exec: ReadExec): Result<string> {
  """
  Execute approved file reads and return their full rendered output.
  """
  // The caller already approved std::read for each payload.
  let joined = ""
  for (payload in exec.payloads) {
    const text = try _read(payload.dir, payload.filename)
    if (isFailure(text)) {
      return text
    }
    joined = joined + text.value
  }
  return success(_renderReadView(joined, exec.view))
}

// Report skipped folders and any match limit reached by the in-process grep.
def grepNotes(payload: GrepPayload, found: number): string {
  let notes: string[] = []
  if (payload.file == null) {
    notes.push(_skippedDirsNote())
  }
  if (found >= payload.maxResults) {
    notes.push("(safeBash stopped after ${payload.maxResults} matches. Narrow the pattern or the path.)")
  }
  return notes.join("\n")
}

@capabilities(fileRead, fileWrite)
export def runWrite(exec: WriteExec): Result<string> {
  """
  Execute an approved redirected echo write and return an empty stdout string.
  """
  // Match write()'s destructive marker so tool-loop retries account for the write.
  destructive {
    const written = try _write(exec.dir, exec.filename, exec.content, exec.mode)
    if (isFailure(written)) {
      return written
    }
  }
  return success("")
}

@capabilities(fileRead, fileWrite)
export def runChain(exec: ChainExec, command: string): Result<string> {
  """
  Execute approved in-process commands with Bash-style ;, &&, and || joins.
  Return a failure when the last command executed failed.
  """
  let out = ""
  let ok = true
  let lastError = ""
  for (step in exec.steps) {
    if (skipsStep(step.join, ok)) {
      continue
    }
    let printed: Result<string> = success("")
    if (step.execution.kind == "write") {
      // Mark this activation too: a later failure must not let the tool
      // loop retry the chain and repeat an earlier write.
      destructive {
        printed = printStep(step.execution)
      }
    } else {
      printed = printStep(step.execution)
    }
    if (printed is success(text)) {
      out = out + text
      ok = true
    } else if (printed is failure(why)) {
      ok = false
      lastError = "${why}"
    }
  }
  if (!ok) {
    return exitFailure(command, 1, out, lastError, command)
  }
  return success(keepOutput(out, 0, command))
}

/** Whether bash skips a step after this join, given how the last step that
 ran ended. */
def skipsStep(join: Join, ok: boolean): boolean {
  return (join == "and" && !ok) || (join == "or" && ok)
}

@capabilities(fileRead, fileWrite)
def printStep(exec: StepExec): Result<string> {
  """
  Execute an approved chain step before saving long output.
  """
  return match(exec) {
    { kind: "echo", content } => success(content)
    { kind: "write" } => runWrite(exec)
    { kind: "grep" } => printGrep(exec)
    { kind: "read" } => printRead(exec)
  }
}
