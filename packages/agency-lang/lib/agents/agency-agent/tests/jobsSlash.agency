// `/jobs stop` reads the session's jobs through the terminal's driver.
// Stopping a job the session holds, and one that already ended, is tested
// with a real session in tests/agency-js/agent-terminal.
import { withPendingNotes } from "../lib/pendingNotes.agency"
import { jobsSlashCommand, stoppedNote } from "../lib/slashCommands/jobs.agency"

// A job the session does not hold was not stopped, so the model is not
// told it was.
node stopOfAJobTheSessionDoesNotHoldLeavesNoNote(): string {
  jobsSlashCommand("stop job-000000")
  return withPendingNotes("next")
}

node theNoteSaysTheUserStoppedTheJob(): boolean {
  return stoppedNote("job-abc123", "sleep 30") == "I stopped background job job-abc123 myself: sleep 30"
}
