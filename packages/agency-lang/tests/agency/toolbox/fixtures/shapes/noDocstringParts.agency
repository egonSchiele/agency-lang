/** @module
  @summary Add one to a number.
*/

export type Request = {
  n: number
}

export def tool(request: Request): Result<number> {
  """
  Add one.
  """
  return guard(time: 1m, cost: $0.10) {
    return request.n + 1

    finalize {
      return 0
    }
  }
}

export node main(request: Request): Result<number> {
  return tool(request)
}
