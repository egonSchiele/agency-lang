// `theme` is a ThemeName union: custom ColorScheme objects and unknown
// scheme names are now compile errors (AG6019), not runtime fallbacks, so
// this test covers only the named-theme paths.
import { highlight, diff } from "std::syntax"

node named(): string {
  return highlight("const x = 1", "ts", theme: "monokai")
}

node themedDiff(): string {
  return diff("const x = 1", "const x = 2", color: true, language: "ts", theme: "monokai")
}
