// designWorkflow: each draft that passes the check is shown in a
// std::workflow::review interrupt; accept saves it through writeWorkflow,
// feedback or a failed edit draws another draft, and a passing edit is
// saved with no model call. Each node's model replies are the llmMocks in
// design.test.json, so a model call a node does not expect fails it.
// Output goes under test-output/design/, one directory per node.
import { designWorkflow, writeWorkflow, Workflow, WorkflowEntry } from "std::workflow"
import { add, multiply } from "std::math"
import { mkdir, remove } from "std::fs"
import { exists } from "std::shell"
import { Json } from "std::validation"

const TOOLS = [add, multiply]
const REQUEST = "Add two numbers and double the sum."

def outDir(node: string): string {
  const dir = "${__dirname}/test-output/design/${node}"
  remove(dir) with approve
  mkdir(dir) with approve
  return dir
}

/** What one designWorkflow call raised, with its outcome. */
type DesignRun = {
  outcome: Result<WorkflowEntry>;
  reviews: Json[];
  saves: number
}

// Answers each review with the next scripted answer: null rejects, "bare"
// is a valueless approve(), anything else is passed to approve(). A false
// `approveSave` rejects the save. Every other interrupt is approved.
def runDesign(dir: string, answers: any[], maxRounds: number = 3, approveSave: boolean = true): DesignRun {
  const reviews: Json[] = []
  let saves = 0
  let outcome: Result<WorkflowEntry> = failure("not run")
  handle {
    outcome = designWorkflow(REQUEST, TOOLS, dir, maxRounds)
  } with (intr) {
    return match(intr.effect) {
      "std::workflow::review" => {
        const answer = answers[reviews.length]
        reviews.push(intr.data)
        if (answer == null) {
          return reject("cancelled by the test")
        }
        if (answer == "bare") {
          return approve()
        }
        return approve(answer)
      }
      "std::workflow::save" => {
        saves = saves + 1
        if (!approveSave) {
          return reject("not saved")
        }
        return approve()
      }
      _ => approve()
    }
  }
  return { outcome: outcome, reviews: reviews, saves: saves }
}

def savedName(ran: DesignRun): string {
  if (ran.outcome is failure(err)) {
    return "failed: ${err}"
  }
  return ran.outcome.value.name
}

/** Add two numbers and double the sum, under `name`. */
def doubleSum(name: string, tool: string = "add"): Workflow {
  return {
    format: 1,
    name: name,
    description: "Add two numbers and double the sum.",
    inputs: "{ a: number; b: number }",
    steps: [
      { id: "sum", kind: "tool", module: "std::math", tool: tool, args: { a: { "$ref": "inputs.a" }, b: { "$ref": "inputs.b" } } },
      { id: "doubled", kind: "tool", module: "std::math", tool: "multiply", args: { a: { "$ref": "steps.sum" }, b: 2 } }
    ],
    result: { "$ref": "steps.doubled" }
  }
}

node acceptSaves(): Json {
  const dir = outDir("accept")
  const ran = runDesign(dir, ["accept"])
  const saved = read("workflows/doubleSum.json", dir) with approve
  return [
    savedName(ran),
    ran.reviews.length,
    ran.saves,
    exists("workflows/doubleSum.json", dir),
    (saved catch "").includes("\"limits\"")
  ]
}

node bareApprovalAccepts(): Json {
  const dir = outDir("bare")
  const ran = runDesign(dir, ["bare"])
  return [savedName(ran), ran.saves]
}

// Typed at a prompt: capitals and spaces still accept, with no second draft.
node acceptIgnoresCaseAndSpaces(): Json {
  const dir = outDir("acceptCase")
  const ran = runDesign(dir, [" Accept "])
  return [savedName(ran), ran.reviews.length]
}

node reviewPayload(): Json {
  const dir = outDir("payload")
  const ran = runDesign(dir, ["accept"])
  const shown = ran.reviews[0]
  return [shown.name, shown.workflow.steps.length, shown.previous, shown.warnings, shown.attempts, shown.round, shown.maxRounds]
}

// The second draft is what lands, and its review shows the first as
// `previous`.
node feedbackRedrafts(): Json {
  const dir = outDir("feedback")
  const ran = runDesign(dir, ["Call it sumTwice.", "accept"])
  return [savedName(ran), ran.reviews.length, ran.reviews[1].previous.name, ran.reviews[1].round]
}

// One mock: a second model call would fail the node.
node editedWorkflowSaves(): Json {
  const dir = outDir("edited")
  const ran = runDesign(dir, [doubleSum("editedSum")])
  return [savedName(ran), ran.reviews.length, ran.saves]
}

// The edit calls `subtract`, which is not in the tool list, so the model
// drafts again and its draft is what lands.
node failedEditIsRedrafted(): Json {
  const dir = outDir("failedEdit")
  const ran = runDesign(dir, [doubleSum("editedSum", "subtract"), "accept"])
  return [savedName(ran), ran.reviews.length]
}

// The first draft takes the name of a saved workflow, so the model drafts
// again without asking anyone, and the saved one is left as it was.
node takenNameIsRedrafted(): Json {
  const dir = outDir("taken")
  const kept: Workflow = { ...doubleSum("doubleSum"), description: "The one already saved." }
  writeWorkflow(kept, TOOLS, dir) with approve
  const ran = runDesign(dir, ["accept"])
  const original = read("workflows/doubleSum.json", dir) with approve
  return [savedName(ran), ran.reviews.length, ran.reviews[0].attempts, (original catch "").includes("The one already saved.")]
}

// Every draft takes the saved name and calls `subtract`, which is not in
// the tool list. The failure after six attempts names both problems, so
// each attempt heard about both at once.
node takenNameWithOtherProblems(): Json {
  const dir = outDir("takenAndBad")
  writeWorkflow(doubleSum("doubleSum"), TOOLS, dir) with approve
  const message = savedName(runDesign(dir, ["accept"]))
  return [message.includes("is already saved"), message.includes("is not among the tools")]
}

node rejectAtReviewWritesNothing(): Json {
  const dir = outDir("rejectReview")
  const ran = runDesign(dir, [null])
  return [isFailure(ran.outcome), ran.saves, exists("workflows/doubleSum.json", dir)]
}

node rejectAtSaveWritesNothing(): Json {
  const dir = outDir("rejectSave")
  const ran = runDesign(dir, ["accept"], 3, false)
  return [isFailure(ran.outcome), ran.saves, exists("workflows/doubleSum.json", dir)]
}

node lastRoundFeedbackFails(): Json {
  const dir = outDir("lastRound")
  const ran = runDesign(dir, ["Make it shorter."], 1)
  const message = savedName(ran)
  return [message.includes("no draft was accepted in 1 rounds"), message.includes("Make it shorter."), ran.reviews.length]
}

node blankFeedbackIsRefused(): Json {
  const dir = outDir("blank")
  const ran = runDesign(dir, ["   "])
  return [savedName(ran).includes("cannot be blank"), ran.saves]
}
