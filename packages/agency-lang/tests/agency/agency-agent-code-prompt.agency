import test { promptFile, agencyCodePrompt, agencyTutorial } from "../../lib/agents/agency-agent/brains/coordinator/subagents/code.agency"

// The coordinator loads its prompts through the contained read wrapper,
// and promptFile falls back to "" on failure — a SILENT empty system
// prompt. This node is the guard.
node codePromptLoads(): boolean {
  return promptFile("agency-code.md") != ""
}

// The Agency coder learns the language from the tutorial. A tutorial that
// did not ship reads as "", which would leave the prompt with an empty block.
node codePromptHasTutorial(): boolean {
  return agencyTutorial != "" && agencyCodePrompt.includes(agencyTutorial)
}
