import { setSearchMode } from "std::agents/lib/search"
import { oracleAgent } from "std::agents/oracle"
import { setAgentCwd } from "std::index"
import { setLlmOptions } from "std::llm"
import { evalValue } from "std::statelog"
import { env } from "std::system"

/** @module
@summary Eval entry nodes that ask the stdlib oracle, `std::agents/oracle`,
to write a plan for a change to this repository.

The oracle gets read-only access to the repository as it was before the
change was designed. `evals/architecture-review/lib/prepare-snapshots.sh`
unpacks each test's commit under `$ARCH_REVIEW_SNAPSHOTS`. Reads, greps,
listings, and globs inside that snapshot are approved. Every other
interrupt is rejected, which keeps the oracle off the network, so it
cannot read a later version of the code on GitHub.
*/

type PlanDesignInput = {
  commit: string;
  task: string
}

const MODEL = "z-ai/glm-5.3-flash"
const PROVIDER = "openrouter"

// OpenRouter providers that serve GLM 5.3 Flash at fp8. Some other providers return empty replies.
const GLM_ROUTE = {
  provider: {
    only: ["baseten/fp8", "siliconflow/fp8", "z-ai/fp8"],
    order: ["baseten/fp8", "siliconflow/fp8", "z-ai/fp8"]
  }
}

def designTask(input: PlanDesignInput, repoDir: string): string {
  return """
${input.task}

Write an implementation plan for this change. Do not write the code.

The repository is at ${repoDir}. Read its CLAUDE.md first, then the code the change touches. File names you give the read, grep, ls, and glob tools are relative to that folder.

The plan must say:
1. which files change, and what changes in each
2. where the data the change needs comes from
3. what stays unchanged that a reader might expect to change
4. the other designs you considered, and why you did not choose them
"""
}

def insideRepo(intr, repoDir: string): boolean {
  return intr.data.dir == repoDir || intr.data.dir.startsWith("${repoDir}/")
}

def writePlan(input: PlanDesignInput, maxTime: number): string {
  evalValue(input)
  const root = env("ARCH_REVIEW_SNAPSHOTS") with approve
  if (root == null) {
    return "No plan: ARCH_REVIEW_SNAPSHOTS is not set."
  }
  const repoDir = "${root}/${input.commit}/packages/agency-lang"
  setAgentCwd(repoDir)
  setSearchMode("off")
  setLlmOptions({
    openRouter: GLM_ROUTE,
    maxToolCallRounds: 60
  })
  let plan: Result<string> = failure("the oracle never ran")
  handle {
    thread {
      plan = oracleAgent(
        question: designTask(input, repoDir),
        model: MODEL,
        provider: PROVIDER,
        maxTime: maxTime,
      )
    }
  } with (intr) {
    return match(intr.effect) {
      "std::read" if (insideRepo(intr, repoDir)) => approve()
      "std::grep" if (insideRepo(intr, repoDir)) => approve()
      "std::ls" if (insideRepo(intr, repoDir)) => approve()
      "std::glob" if (insideRepo(intr, repoDir)) => approve()
      _ => reject()
    }
  }
  if (plan is failure(err)) {
    return "No plan: the oracle failed: ${err}"
  }
  return plan.value
}

/** The stdlib oracle with no extra guidance, at a 10-minute budget. */
node baseline(input: PlanDesignInput): string {
  return writePlan(input, 10m)
}
