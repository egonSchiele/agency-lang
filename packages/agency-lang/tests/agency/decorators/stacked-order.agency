// Stacked decorators nest, outermost first.
let trace: string[] = []

decorator def outer(call: Call, block: () -> any): any {
  trace = [...trace, "outer:in"]
  const result = block(call.args)
  trace = [...trace, "outer:out"]
  return result
}

decorator def inner(call: Call, block: () -> any): any {
  trace = [...trace, "inner:in"]
  const result = block(call.args)
  trace = [...trace, "inner:out"]
  return result
}

@outer
@inner
def work(): string {
  trace = [...trace, "body"]
  return "done"
}

node main() {
  work()
  return trace
}
