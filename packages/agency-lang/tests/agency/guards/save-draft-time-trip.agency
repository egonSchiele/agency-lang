
node main() {
  // The time trip during sleep() is a std::guard interrupt.
  // Rejecting it sends the guard down its trip path.
  handle {
    const result = guard(time: 500ms) {
      saveDraft("timed-draft")
      sleep(2000)                 // exceeds 500ms → time trip
      return "done"
    }
    if (isFailure(result)) { return "unexpected" }
    return result.value
  } with (i) {
    return match(i.effect) {
      "std::guard" => reject()
      _ => pass()
    }
  }
}
