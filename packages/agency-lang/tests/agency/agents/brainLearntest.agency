// The learntest brain from std::agents/brains/learntest: its tool list and
// its system message. The `learn` tool itself is covered by
// tests/agency-js/learntest-brain, where a scripted model calls it.
import { learntestBrain } from "std::agents/brains/learntest"
import { AgentSettings } from "std::agents/brains/settings"

// Every model request, in order.
let calls: any[] = []

callback("onLLMCallStart") as data {
  calls = [...calls, data]
}

def emptySettings(): AgentSettings {
  return {
    context: "",
    model: "",
    provider: "",
    reasoningModel: "",
    reasoningProvider: "",
    routerModel: "",
    routerProvider: "",
    judgeModel: "",
    judgeProvider: "",
    imageModel: "",
    imageProvider: "",
    coderTools: []
  }
}

def requestHasSystemText(call: any, text: string): boolean {
  for (message in call.messages) {
    const content = "${message.content}"
    if (message.role == "system" && content.includes(text)) {
      return true
    }
  }
  return false
}

// The minimal brain's four tools, then learn, then the caller's.
node offersLearnAfterTheFourTools(): string[] {
  learntestBrain(["say hi"], emptySettings(), [requestHasSystemText])
  return [tool.name for tool in calls[0].tools]
}

// The model is told it can gain tools, where the list of them is, and
// which tool to call, and it keeps the minimal brain's coding rules.
node givesTheModelThePrimer(): string {
  learntestBrain(["say hi"], emptySettings(), [])
  const gain = requestHasSystemText(calls[0], "You can gain tools")
  const index = requestHasSystemText(calls[0], "agents/prompts/learnable-tools.md lists them")
  const tool = requestHasSystemText(calls[0], "call learn with the file's path")
  const codingRules = requestHasSystemText(calls[0], "You are a coding assistant")
  return "${gain}|${index}|${tool}|${codingRules}"
}
