/** The payloads of the effects named `name` in the plan for `source`.
 * Read through an `any` local, as payloadValuesAreCorrect does: a name
 * held in a variable does not narrow the Effect union. */
def payloadsNamed(source: string, name: string): any[] {
  let out: any[] = []
  for (effect in planFor(source, FIXTURES).effects) {
    const each: any = effect
    if (each.name == name) {
      out.push(each.payload)
    }
  }
  return out
}

def execFields(source: string): any {
  return [[p.command, p.args, p.subcommand, p.cwd == FIXTURES, p.timeout, p.stdin] for p in payloadsNamed(source, "std::exec")]
}

node execPayloadFields() {
  return [
    execFields("pnpm run build --filter=web"),
    execFields("make"),
    execFields("pytest tests/*.py -k fast"),
  ]
}

node programAsksOneQuestion() {
  // One std::exec question, approved by the test file. A std::bash prompt
  // would fail the run on an unmatched interrupt.
  const result = safeBash("node --version", cwd: FIXTURES)
  if (result is failure(why)) {
    return "FAILED: ${why}"
  }
  return result.value.startsWith("v")
}

node programUnderRecommendedIsUndecided() {
  const plan = planFor("pnpm test", FIXTURES)
  for (effect in plan.effects) {
    if (effect.name == "std::exec") {
      const intr = { effect: effect.name, data: effect.payload }
      return checkPolicy(recommendedAutoApprovePolicy, intr).type
    }
  }
  return "NO EXEC EFFECT"
}

/** The rule "always approve when" saves for `node --version`. */
const NODE_VERSION_POLICY = {
  "std::exec": [
    { "match": { "command": "node", "subcommand": "--version" }, "action": "approve" }
  ]
}

node programUnderASavedRuleRuns() {
  // No interruptHandlers entry: the saved rule must answer the question.
  let ran = false
  handle {
    const result = safeBash("node --version", cwd: FIXTURES)
    if (result is success(text)) {
      ran = text.startsWith("v")
    }
  } with (intr) {
    return checkPolicy(NODE_VERSION_POLICY, intr)
  }
  return ran
}


/** A folder of its own for the linked-path listing test. */
static const LS_FILE_LINK_FIXTURE = __dirname + "/stdlib/__safebash_ls_file_link__"

node listingOfALinkedFileIsRefused() {
  remove(LS_FILE_LINK_FIXTURE) with approve
  mkdir(LS_FILE_LINK_FIXTURE) with approve
  bash("mkdir inside outside && echo hi > outside/target.txt && echo hi > inside/plain.txt && ln -s ../outside/target.txt inside/link.txt && ln -s plain.txt inside/alias.txt && ln -s ../outside inside/dirlink", cwd: LS_FILE_LINK_FIXTURE) with approve
  const inside = LS_FILE_LINK_FIXTURE + "/inside"
  const outside = LS_FILE_LINK_FIXTURE + "/outside"
  const linked = planFor("ls -l link.txt", inside).broadReason
  const aliased = planFor("ls -l alias.txt", inside).broadReason
  const bareLinked = planFor("ls link.txt", inside).broadReason
  const dirLinked = planFor("ls -l dirlink", inside).broadReason
  const duLinked = planFor("du dirlink", inside).broadReason
  const foundLinked = planFor("find dirlink -name x", inside).broadReason
  const followed = lsDirs("ls dirlink", inside)
  const walked = lsDirs("ls -R dirlink", inside)
  const plain = lsDirs("ls -l plain.txt", inside)
  remove(LS_FILE_LINK_FIXTURE) with approve
  return [linked, aliased, bareLinked, dirLinked, duLinked, foundLinked, followed == outside, walked == outside, plain == inside]
}

node listingOfAFileAsksOneQuestion() {
  // One std::ls question for the folder that holds the file, approved by
  // the test file. A std::bash prompt would fail the run.
  const result = safeBash("ls -la one.txt", cwd: FIXTURES)
  if (result is failure(why)) {
    return "FAILED: ${why}"
  }
  return result.value.includes("one.txt")
}

// ---------------------------------------------------------------------------
// git
//
// Every node below but the last three goes through `planFor`, `effectsFor`,
// or `isRefused`, and runs nothing. That matters most for the refusals: a
// test that called `safeBash("git checkout -- .")` to see it refused would,
// on the day the refusal broke, discard every uncommitted change in the
// checkout the tests run in.
// ---------------------------------------------------------------------------

/** A plan's outcome and each effect's name and payload, planned in a
  folder that does not exist, so no word names anything on disk. */
def gitPlan(source: string): any {
  const plan = planFor(source, "/repo")
  const effects: any[] = plan.effects
  return [outcomeOf(plan), [[effect.name, effect.payload] for effect in effects]]
}

node gitReads() {
  return [
    gitPlan("git status"),
    gitPlan("git status --porcelain"),
    gitPlan("git status -sb"),
    gitPlan("git log"),
    gitPlan("git log --oneline -n 5 main"),
    gitPlan("git log -5"),
    gitPlan("git log --follow -p main"),
    gitPlan("git diff"),
    gitPlan("git diff --staged --stat"),
    gitPlan("git diff main feature"),
    gitPlan("git diff main..feature"),
    gitPlan("git diff HEAD~1"),
    gitPlan("git show"),
    gitPlan("git show --stat abc123"),
    gitPlan("git branch"),
    gitPlan("git branch -a"),
    gitPlan("git branch --merged main"),
    gitPlan("git remote -v"),
    gitPlan("git stash list"),
  ]
}

/** In the fixtures folder, where `one.txt` and `two.txt` exist: the
  outcome, and the first effect's name, ref, and path. */
def refAndPath(source: string): any {
  const plan = planFor(source, FIXTURES)
  if (plan.effects.length == 0) {
    return [outcomeOf(plan)]
  }
  const effect: any = plan.effects[0]
  if (effect.payload == null) {
    return [outcomeOf(plan), effect.name]
  }
  return [outcomeOf(plan), effect.name, effect.payload.ref ?? null, effect.payload.path ?? null]
}

node gitRefsAndPaths() {
  return [
