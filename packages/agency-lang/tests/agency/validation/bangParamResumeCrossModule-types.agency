// The validator and the type it guards live here. Consumers import the
// type and never name the validator.

import { getMutable, setMutable } from "../../helpers/mutableVar.js"

export def checkStamp(value: string): Result<string> {
  setMutable("crossStamp", getMutable("crossStamp", 0) + 1)
  return success(value)
}

@validate(checkStamp)
export type Stamp = string

export def resetStampRuns() {
  setMutable("crossStamp", 0)
}

export def readStampRuns(): number {
  return getMutable("crossStamp", 0)
}
