/** @module In-session model selection for the agency agent. Holds the
  `/model` command's switch logic and the model pickers. This module sits
  ABOVE the resolution / slot / shared layers: it imports from them, and
  nothing they own imports back, so there is no import cycle. */

import {
  printLocalCatalog,
  localModelsSupported,
  listModelNames,
 } from "std::agency/local"
import { listHostedModels } from "std::llm"
import { disableMemory } from "std::memory"
import { isTTY } from "std::system"
import { chooseOption, ChoiceItem } from "std::ui"
import { pushMessage } from "std::ui/cli"

import {
  filterHostedModels,
  ModelFilters,
 } from "./modelFilters.agency"
import {
  ModelChoices,
  ModelFlags,
  ModelRequest,
  localModelOf,
  modelFlagsFromArgs,
  noModelChoices,
  noModelFlags,
  requestIsLocal,
  requestProvider,
 } from "./modelRequest.agency"
import {
  parseModelFlag,
  embeddingSpecHasProvider,
  missingProviderEnvVar,
  Resolved,
 } from "./models.agency"
import { activePreset, findPreset, setActivePreset } from "./presets.agency"
import { configureSearch, getSearchSession } from "./search.agency"
import {
  diffResolved,
  Ctx,
  SlotChange,
 } from "./resolution.agency"
import {
  ModelSettings,
  getModelSettings,
  loadSettings,
 } from "./settings.agency"
import { SLOTS } from "./slots.agency"
import { ToolLimits, applyToolLimits } from "./toolLimits.agency"
import {
  demoteProvider,
  applyResolved,
  overrideFromResolved,
  configureLocalModel,
  getResolvedSlots,
  getCapabilities,
  getCapabilitiesResolved,
  markMemoryEnabledByOverride,
  embeddingKeyStatus,
  memoryEnablePlan,
  enableAgentMemory,
  resolveHostedModels,
  resolveRequestAgainst,
 } from "../shared.agency"

// In-session model selection state: the /model choices.
export type Session = ModelChoices

// Whether startup enabled memory WITH the embedding override. The pause
// guard in reactToSlotChange consults this instead of re-deriving from the
// slots: a keyless override took the fallback path, so memory runs on
// DERIVED embeddings and a main-provider change still shifts the embedding
// space. Exported mutator so tests (and agent startup) can drive the guard.
let _memoryEmbeddingsPinned = false

export def markMemoryEmbeddingsPinned(pinned: boolean) {
  _memoryEmbeddingsPinned = pinned
}

// The startup model flags and settings.model, kept for the session so
// /model and /preset resolve with the same inputs startup did, without
// reading settings.json inside a turn.
let _startupFlags: ModelFlags = noModelFlags()
let _startupModelSettings: ModelSettings = {}

export def setStartupModelFlags(flags: ModelFlags, settings: ModelSettings) {
  _startupFlags = flags
  _startupModelSettings = settings
}

/** The request for this session's startup flags, active preset, and these /model choices. */
export def currentModelRequest(choices: ModelChoices): ModelRequest {
  return {
    flags: _startupFlags,
    preset: activePreset(),
    choices: choices
  }
}

export def applyModelRequest(request: ModelRequest, settings: ModelSettings): Result<boolean> {
  """
  Resolve and apply a request's models, local or hosted. A hosted
  failure changes nothing and returns the message. A local model that
  fails to load still ends the process (configureLocalModel). The
  web-search setup is the caller's job.

  @param request - What the run asked for
  @param settings - settings.model
  """
  const local = localModelOf(request)
  if (local != null) {
    configureLocalModel(local.model, local.embedding)
    return success(true)
  }
  const resolved = resolveHostedModels(request, settings)
  if (resolved is failure(reason)) {
    return failure(reason)
  }
  applyResolved(resolved.value)
  return success(true)
}

// Persistent knowledge graph, gated on the capability profile.
export def maybeEnableMemory() {
  const status = embeddingKeyStatus(getResolvedSlots())
  const capabilities = getCapabilitiesResolved()
  const plan = memoryEnablePlan(capabilities.values.memory, capabilities.sources.memory, status)
  markMemoryEmbeddingsPinned(plan == "enable-override")
  return match(plan) {
    "skip" => null
    "enable-override" => {
      if (!capabilities.values.memory) {
        markMemoryEnabledByOverride()
      }
      enableAgentMemory(status.override)
      return null
    }
    "enable-fallback" => {
      print(
        color.dim(
        "Memory: the embedding slot needs ${status.varName}, which is not set. Falling back to the default embedding behavior.",
      ),
      )
      enableAgentMemory()
      return null
    }
    _ => {
      enableAgentMemory()
      return null
    }
  }
}

/** Apply an in-session model selection. Takes effect on
  the NEXT turn; no in-flight call is mutated. */
export def switchModel(
  prior: Session,
  spec: string,
  ctx: Ctx,
  before: Record<string, Resolved>,
): { session: Session; resolved: Record<string, Resolved>; changes: SlotChange[] } {
  // The caller builds ctx from currentProvider(), which returns the
  // PROMOTED name on openai sessions. priceDefault and the built-in
  // tables key by public provider names, so demote before resolving —
  // otherwise a switch that lets any slot fall through to the built-in
  // defaults fails with "openai-responses has no built-in defaults".
  const ctx2: Ctx = {
    provider: demoteProvider(ctx.provider),
    price: ctx.price
  }
  let next: Session = JSON.parse(JSON.stringify(prior))
  const parsed = parseModelFlag(spec)
  if (parsed.slot != "" && !SLOTS.includes(parsed.slot)) {
    pushMessage(
      color.red(
      "Unknown model slot '${parsed.slot}'. Valid slots: ${SLOTS.join(", ")}.",
    ),
    )
    return {
      session: prior,
      resolved: before,
      changes: []
    }
  }
  if (parsed.slot == "embedding" && !embeddingSpecHasProvider(parsed.model)) {
    // The embedding slot exists to point AWAY from the chat provider, so
    // the provider can never be inferred. Require the explicit form.
    pushMessage(
      color.red(
      "Embedding models need the provider/model form, e.g. embedding=openai/text-embedding-3-small.",
    ),
    )
    return {
      session: prior,
      resolved: before,
      changes: []
    }
  }
  if (parsed.slot == "") {
    next.pin = parsed.model
  } else {
    next.slots[parsed.slot] = parsed.model
  }

  const request = currentModelRequest(next)
  const settings = _startupModelSettings
  const established = requestProvider(request, settings) != ""
  const all = resolveRequestAgainst(request, settings, ctx2, established)
  if (all is failure(reason)) {
    pushMessage(color.red("Could not switch model: ${reason}"))
    return {
      session: prior,
      resolved: before,
      changes: []
    }
  }
  const resolved = all.value
  applyResolved(resolved)
  return {
    session: next,
    resolved: resolved,
    changes: diffResolved(before, resolved)
  }
}

/** React to one resolved-slot change. Phase 1: a `main`-slot provider change
  means the embedding space behind memory changed, so pause memory and warn.
  (std::memory has no tier-2-only toggle yet -- full pause; structured recall
  returns when a selective toggle lands.) Returns true if it emitted the notice. */
export def reactToSlotChange(change: SlotChange): boolean {
  if (change.slot == "main" && change.before.provider != change.after.provider) {
    // Skip the pause only when startup actually enabled memory WITH the
    // override. A set-but-keyless slot took the fallback path, so memory
    // runs on derived embeddings and the provider change still shifts
    // the embedding space behind recall.
    if (_memoryEmbeddingsPinned) {
      return false
    }
    pushMessage(
      color.dim(
      "Warning: provider changed - memory is paused until restart (recall would be unreliable).",
    ),
    )
    // `with approve`: the agent is deliberately auto-pausing memory on a
    // provider switch, not asking the user — so don't surface an approval prompt.
    disableMemory() with approve
    return true
  }
  if (change.slot == "embedding") {
    const override = overrideFromResolved(change.after)
    if (override != null) {
      const missing = missingProviderEnvVar(override.provider)
      if (missing != "") {
        pushMessage(
          color.yellow(
          "Warning: the embedding slot needs ${missing}, which is not set. The assignment takes effect at next agent start, and memory falls back to the default embedding behavior until it is exported.",
        ),
        )
        return true
      }
      // The healthy path must not be silent: enableMemory already ran,
      // so the user would otherwise believe embeddings switched now.
      pushMessage(
        color.dim(
        "Embedding slot set: memory embeddings use ${override.provider}/${override.model} at next agent start.",
      ),
      )
      return true
    }
  }
  return false
}

// ChoiceItem list for the model pickers: the hosted catalog, filtered, each
// labeled with provider + input price for an informed pick.
/** The provider a session is held to by --provider, a preset, or
  settings.model, or "" when none is. switchModel never splits a
  `provider/model` spec under one, so the picker has to know. */
export def establishedProvider(choices: ModelChoices): string {
  return requestProvider(currentModelRequest(choices), _startupModelSettings)
}

// The key is what switchModel receives, so it carries the provider: a
// bare name would be sent to the session's current provider. Under an
// established provider a `provider/model` key is
// never split, so there the list narrows to that provider and the keys
// stay bare. Providers are compared and written demoted, because the
// catalog says `openai-responses` and the resolver only knows `openai`.
export def modelChoiceItems(filters: ModelFilters, established: string = ""): ChoiceItem[] {
  let items: ChoiceItem[] = []
  for (model in filterHostedModels(listHostedModels(), filters)) {
    const provider = demoteProvider(model.provider)
    if (established != "" && provider != demoteProvider(established)) {
      continue
    }
    const label = "${model.name}  (${model.provider}, $${model.inputCost}/1M in, $${model.outputCost}/1M out)"
    const key = if established == "" then "${provider}/${model.name}" else model.name
    items.push({
      key: key,
      label: label
    })
  }
  return items
}

// What the /model picker says when the provider is established. The list
// is that provider's only, and a `provider/model` spec is not split, so
// /model cannot move the session to another provider. A provider with no
// rows in the hosted catalog, such as a proxy or a local one, leaves the
// list empty, and the model has to be typed.
export def scopedPickerNotes(established: string, itemCount: number): string[] {
  if (established == "") {
    return []
  }
  const scope = "Listing ${established} models only. The provider is fixed by --provider, a preset, or settings.model.provider, and /model cannot change it; start without that setting to pick from every provider."
  if (itemCount == 0) {
    return [scope, "The catalog has no models for ${established}. Type the model name."]
  }
  return [scope]
}

// Parse a `/models [provider]` command line into filters. Bare `/models` (or a
// trailing-space-only arg) yields no filters; `/models <provider>` narrows to
// one provider. Extracted from the handler so it is unit-testable.
export def parseModelsFilters(cmd: string): ModelFilters {
  const prefix = "/models "
  if (!cmd.startsWith(prefix)) {
    return {}
  }
  const arg = cmd.substring(prefix.length).trim()
  if (arg == "") {
    return {}
  }
  return {
    provider: arg
  }
}

// Bare --local: prompt for a model, or print the catalog and exit when
// there is no terminal to prompt on.
def pickGuidedLocalModel(): string {
  if (!isTTY()) {
    printLocalCatalog()
    process.exit(0)
  }
  if (!localModelsSupported()) {
    print(color.yellow("Local models need the smoltalk-llama-cpp package."))
    print("Install it, then re-run:  ! npm i -g smoltalk-llama-cpp")
    process.exit(1)
  }
  const items = map(listModelNames(), \modelName -> { key: modelName.name, label: modelName.name })
  const choice = chooseOption(
    "Local model",
    "Pick a model, or type an hf: URI / .gguf path (downloads on first use):",
    items,
    allowFreeText: true,
    allowCancel: true,
  )
  if (choice == "" || choice == null) {
    process.exit(0)
  }
  return choice
}

def withGuidedLocal(flags: ModelFlags): ModelFlags {
  if (flags.local != "") {
    return flags
  }
  return {
    ...flags,
    local: pickGuidedLocalModel()
  }
}

/** Resolve and apply the agent's models at startup from the CLI flags,
  the active preset, and settings.model. Exits with a message on bad
  flags or an unresolvable request. */
export def pickModelsForAgent(args: Record<string, any>) {
  const parsed = modelFlagsFromArgs(args)
  if (parsed is failure(reason)) {
    print(color.red(reason))
    process.exit(1)
    return
  }
  setStartupModelFlags(withGuidedLocal(parsed.value), getModelSettings(loadSettings()))
  const request = currentModelRequest(noModelChoices())
  const applied = applyModelRequest(request, _startupModelSettings)
  if (applied is failure(reason)) {
    print(reason)
    process.exit(1)
    return
  }
  configureSearch(requestIsLocal(request))
}

/** What a switch produced. The first three fields have the meaning they
  have in switchModel's result; `session` is always the empty choices. */
export type PresetSwitch = {
  session: Session;
  resolved: Record<string, Resolved>;
  changes: SlotChange[];
  limits: ToolLimits
}

// configureSearch reads and saves settings.json and may ask the user a
// question, so it runs only when the switch changes local versus hosted,
// the same case /local covers.
def followLocality(isLocal: boolean) {
  if (isLocal != getSearchSession().isLocal) {
    configureSearch(isLocal)
  }
}

/** The preset name in a `/preset [name]` command line, or "". */
export def parsePresetName(cmd: string): string {
  const prefix = "/preset"
  if (!cmd.startsWith(prefix)) {
    return ""
  }
  return cmd.substring(prefix.length).trim()
}

export def switchPreset(name: string): Result<PresetSwitch> {
  """
  Switch this session to a saved preset, with no /model choices. Takes
  effect on the next turn. Changes nothing, and returns the reason, when
  the preset is unknown or its models do not resolve.

  @param name - The preset's name
  """
  const preset = findPreset(name)
  if (preset is failure(reason)) {
    return failure(reason)
  }
  const before = getResolvedSlots()
  const request: ModelRequest = {
    flags: _startupFlags,
    preset: preset.value,
    choices: noModelChoices()
  }
  const applied = applyModelRequest(request, _startupModelSettings)
  if (applied is failure(reason)) {
    return failure(reason)
  }
  followLocality(requestIsLocal(request))
  setActivePreset(name)
  const after = getResolvedSlots()
  return success({
    session: noModelChoices(),
    resolved: after,
    changes: diffResolved(before, after),
    limits: applyToolLimits(preset.value, false)
  })
}
