{
  "tests": [
    {
      "nodeName": "schemasOfEachPart",
      "description": "the warnings, the inputs schema in its input form, and each LLM step's output schema by step id, from one std::run",
      "input": "",
      "expectedOutput": "[[],[\"a\",\"b\"],[\"a\",\"b\",\"note\"],[\"explain\"],[\"title\",\"summary\"],[\"title\",\"summary\"],[\"std::run\"]]",
      "evaluationCriteria": [
        {
          "type": "exact"
        }
      ]
    },
    {
      "nodeName": "stringOutputIsAStringSchema",
      "description": "an LLM step whose output is `string` has a string schema",
      "input": "",
      "expectedOutput": "\"string\"",
      "evaluationCriteria": [
        {
          "type": "exact"
        }
      ]
    },
    {
      "nodeName": "refusedWorkflowStartsNothing",
      "description": "a workflow with problems fails with them and raises no std::run",
      "input": "",
      "expectedOutput": "[[\"diff\"],[]]",
      "evaluationCriteria": [
        {
          "type": "exact"
        }
      ]
    },
    {
      "nodeName": "unrepresentableInputsAreRefused",
      "description": "a regex in the inputs type is refused by the check, on the inputs field, before any std::run",
      "input": "",
      "expectedOutput": "[[\"null/inputs\"],[]]",
      "evaluationCriteria": [
        {
          "type": "exact"
        }
      ]
    },
    {
      "nodeName": "rejectedRunKeepsTheRejection",
      "description": "a rejected std::run fails the call, keeps rejected, and has no data.problems",
      "input": "",
      "expectedOutput": "[true,true,[\"std::run\"]]",
      "evaluationCriteria": [
        {
          "type": "exact"
        }
      ]
    },
    {
      "nodeName": "unrepresentableOutputIsRefused",
      "description": "an LLM output type holding regex is refused by the check, naming the step, before any std::run",
      "input": "",
      "expectedOutput": "[[\"explain/output\"],[]]",
      "evaluationCriteria": [
        {
          "type": "exact"
        }
      ]
    },
    {
      "nodeName": "unreachableInputsTypeIsRefused",
      "description": "an inputs type naming a type the program cannot reach is refused on the inputs field, before any std::run",
      "input": "",
      "expectedOutput": "[[\"null/inputs\"],[]]",
      "evaluationCriteria": [
        {
          "type": "exact"
        }
      ]
    },
    {
      "nodeName": "unreachableOutputTypeIsRefused",
      "description": "an LLM output type naming a type the program cannot reach is refused on the step, before any std::run",
      "input": "",
      "expectedOutput": "[[\"explain/output\"],[]]",
      "evaluationCriteria": [
        {
          "type": "exact"
        }
      ]
    }
  ]
