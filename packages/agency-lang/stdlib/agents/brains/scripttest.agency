/** @module
  @summary A trial brain: the minimal brain, plus a subagent that writes and runs a short Agency program in place of a node or shell script.

  A brain of the Agency agent. It is the minimal brain with one more tool,
  `agencyScript`, and a short system message that tells the model to use
  it instead of `node -e` or a shell script.

  `agencyScript` is a subagent. The stdlib Agency writer writes and checks
  the program on a thread of its own, and the program then runs in a
  separate process. The writer's tutorial and tools stay on its own
  thread, so they cost nothing on the calls where the tool is not used.

  Every file read, file write, and command in the program raises its own
  interrupt, which reaches the same handlers as the agent's other tools.
  So the user approves what the program does, and does not have to read
  the program first, as they would for `node -e '<script>'`.
*/
import { runCode } from "std::agency"
import { agencyCodingAgent } from "std::agents/agency/coding"
import { minimalBrain } from "std::agents/brains/minimal"
import { AgentSettings } from "std::agents/brains/settings"
import { getAgentCwd } from "std::index"
import { Attachment, ensureSystemMessage } from "std::thread"

static const SCRIPT_RULE = """
When you need a short script to compute, parse, or check something, such as reading a JSON file and counting its entries, call agencyScript with the task instead of running `node -e`, `python -c`, or a shell script. Use node, python, or the shell only when the question is about those programs themselves, such as how Python imports a module.
"""

// The writer's budget for one script. A short check needs far less than
// the writer's defaults of $20 and 15 minutes.
static const SCRIPT_MAX_COST = $1.00
static const SCRIPT_MAX_TIME = 5m

export def agencyScript(task: string): Result {
  """
  Write and run a short Agency program for a task, and return what the program returns. Each file it reads or writes and each command it runs asks for approval as your other tools do. The writer does not see this conversation, so the task must name every file and say what result to return.

  @param task - What the program should do and return, with every file path it needs
  """
  // `strict` checks the draft against the rules the separate process
  // enforces, so a program that passes the writer's checks also compiles
  // there.
  const written = agencyCodingAgent(
    task,
    strict: true,
    maxCost: SCRIPT_MAX_COST,
    maxTime: SCRIPT_MAX_TIME,
  )
  if (written is failure(err)) {
    return failure("The Agency writer could not write the program: ${err}")
  }
  // The program's relative paths name files in the agent's working
  // directory, as the agent's own file tools do.
  return runCode(written.value, cwd: getAgentCwd())
}

export def scripttestBrain(
  prompt: string | (string | Attachment)[],
  settings: AgentSettings,
  extraTools: any[],
): Result<string> {
  """
  Answer one message with the minimal brain, plus a subagent that writes
  and runs a short Agency program in place of a node or shell script.

  @param prompt - The message, alone or followed by its attachments
  @param settings - The call's settings
  @param extraTools - Tools added to the brain's own
  """
  ensureSystemMessage(SCRIPT_RULE)
  return minimalBrain(prompt, settings, [agencyScript, ...extraTools])
}
