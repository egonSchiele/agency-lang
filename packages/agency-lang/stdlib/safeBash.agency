/** @module
@summary Run Bash commands with approvals matched to their actions.

```ts
import { safeBash } from "std::safeBash"

node main() {
  return safeBash("git status")
}
```

Recognized commands ask for specific approvals such as a file read or Git
status. When a command cannot be described that way, the whole command
asks for `std::bash` approval. Handlers and policies decide the requests
before execution begins.

Some echo, grep, cat, head, and tail commands run in process. Other commands
run under Bash, preserving the command's control flow. Explicit destructive
spellings such as `rm` and `git reset --hard` are refused. That list does not
cover every way to perform a destructive action; approval rules still apply.

Use `planFor` to inspect the planned effects and execution without running
the command. See `docs/dev/stdlib/safe-bash.md` for classification rules.
*/

export { MAX_STDOUT_LEN } from "std::spill"

export type Word =
  | LiteralWord
  | PathWord
  | GlobWord
  | FlagWord
  | SingleQuotedWord
  | DoubleQuotedWord
  | VariableWord
  | InterpolatedVariableWord

export type ScriptName = LiteralWord | PathWord

export type LiteralWord = {
  tag: "literal";
  text: string
}

export type PathWord = {
  tag: "path";
  text: string
}

/** An unquoted word bash will expand (`*.ts`, `src/*.md`). Its own node
 so it is never mistaken for the quoted text `'*.ts'`; no rule here
 treats it as a literal. */
export type GlobWord = {
  tag: "glob";
  text: string
}

export type FlagWord = {
  tag: "flag";
  flagName: string;
  flagValue?: string;
  /** Present and true when the value is an unquoted glob (`--include=*.ts`). */
  valueIsGlob?: boolean
}

export type SingleQuotedWord = {
  tag: "singleQuoted";
  text: string
}

export type DoubleQuotedWord = {
  tag: "doubleQuoted";
  parts: Word[]
}

export type VariableWord = {
  tag: "variable";
  name: string
}

/** Adjacent word parts, such as `$HOME.txt` or `"a"b`, that form one Bash argument. */
export type InterpolatedVariableWord = {
  tag: "interpolatedVariable";
  parts: (
  | LiteralWord
  | VariableWord
  | SingleQuotedWord
  | DoubleQuotedWord)[]
}

/** `name=value` (or `name=` with a null value) before a command. */
export type Assignment = {
  tag: "assignment";
  name: string;
  value?: Word
}

/** A redirect like `> out.txt`, `>> log`, `2> err.txt`, `< in.txt`, or
 the dup `2>&1` (op `>&`, target a one-digit literal). `fd` is the
 explicit file descriptor (`2` in `2>`), or undefined for the default.
 Heredocs and here-strings are rejected rather than parsed. */
export type Redirect = {
  tag: "redirect";
  fd?: number;
  op: string;
  target: Word
}

export type SimpleCommand = {
  tag: "simpleCommand";
  assignments: Assignment[];
  /* The command name, or null for an assignment-only line (`FOO=bar`).
    Bash requires at least one of a command name or an assignment. */
  command?: ScriptName;
  /** Every word after the command name, in source order. */
  args: Word[];
  redirects: Redirect[]
}

export type Command = SimpleCommand | Pipeline | And | Or | Parens

/** What may sit between pipes: a simple command or a parenthesized group. */
export type PipelineStage = SimpleCommand | Parens

/** `a | b | c`: flat, two or more stages, binding tighter than `&&`/`||`. */
export type Pipeline = {
  tag: "pipeline";
  stages: PipelineStage[]
}

export type And = {
  tag: "and";
  left: Command;
  right: Command
}

export type Or = {
  tag: "or";
  left: Command;
  right: Command
}

export type Parens = {
  tag: "parens";
  command: Command
}

export type BashNode =
  | Command
  | SimpleCommand
  | Assignment
  | Redirect
  | Word
  | ScriptName

export type BashAST = Command[]

// Flags are classified separately so git diff --staged can reach its rule.
def literalArgs(command: SimpleCommand): Result<string[]> {
  """
  Return literal non-flag arguments, failing if another argument needs expansion.
  """
  let out: string[] = []
  for (arg in command.args) {
    if (arg.tag == "flag") {
      continue
    }
    if (arg.tag != "literal") {
      return failure("`${arg.tag}` is not a literal argument")
    }
    out.push(arg.text)
  }
  return success(out)
}

def flagNames(command: SimpleCommand): string[] {
  """
  Return the command's flags as written.
  """
  let out: string[] = []
  for (arg in command.args) {
    if (arg.tag == "flag") {
      out.push(renderFlag(arg))
    }
  }
  return out
}

/* Bash expands `~` only when unquoted, so only the unquoted word tags
  expand; everything else literalTarget accepts stays literal. */
def tildeModeFor(word: Word): string {
  return match(word) {
    { tag: "literal" } => "expand"
    { tag: "path" } => "expand"
    _ => "literal"
  }
}

/* The one owner of redirect-write preparation: validate the redirect,
  extract the literal target, resolve it (quote-aware tilde, strict
  symlink walk), and return the payload both plan sides derive from. Any
  failure sends the whole command to the broad std::bash question. */
@capabilities(fileRead)
def prepareRedirectWrite(redirect: Redirect, cwd: string, content: string): Result<WritePayload> {
  if (redirect.fd != null) {
    return failure("redirect with an explicit file descriptor")
  }
  return resolveRedirectWrite(redirect, cwd, content)
}

@capabilities(fileRead)
def resolveRedirectWrite(redirect: Redirect, cwd: string, content: string): Result<WritePayload> {
  """
  Resolve an output redirect's target, whichever stream it redirects.
  """
  if (redirect.op != ">" && redirect.op != ">>") {
    return failure("`${redirect.op}` is not an output redirect")
  }
  const target = literalTarget(redirect.target)
  if (isFailure(target)) {
    return target
  }
  const resolved = try _resolveRedirectTarget(target.value, cwd, tildeModeFor(redirect.target))
  if (resolved is failure(why)) {
    return failure("${why}")
  }
  return success({
    dir: resolved.value.dir,
    filename: resolved.value.filename,
    content: content,
    mode: writeMode(redirect.op)
  })
}

// A redirect reads or writes a file whatever the command is, so it is
// accounted for here, apart from the verb. Without this check,
// `echo pwned >> .bashrc; git status` would be classified as a Git read,
// and any rule that approves Git reads would approve the write.
//
// Each redirect contributes the effect of the file it reads or writes. One
// that only moves a stream, such as `2>&1`, contributes nothing. A
// redirect with no rule in the body, or a target that is not literal, is
// a failure, which sends the whole string to std::bash. A variable target
// cannot fill the payload unless safeBash expands it itself.
def redirectEffect(redirects: Redirect[], cwd: string): Result<Effect[]> {
  """
  Determine the file-read and file-write effects contributed by redirects.
  """
  // A dup redirect (`2>&1`) moves a stream and writes no file, so it
  // contributes nothing; it is the only `>&` form the parser accepts.
  // prepareRedirectWrite stays strict on purpose: the shell-free write
  // path computes the bytes it writes, and a dup changes which stream
  // echo's output goes to.
  // A redirect to /dev/null writes no file either.
  const fileRedirects = [redirect for redirect in redirects if redirect.op != ">&" && !discardsOutput(redirect)]
  const inputs = [redirect for redirect in fileRedirects if redirect.op == "<"]
  const outputs = [redirect for redirect in fileRedirects if redirect.op != "<"]
  if (inputs.length > 1) {
    return failure("more than one input redirect")
  }
  if (outputs.length > 1) {
    return failure("more than one redirect")
  }
  let effects: Effect[] = []
  for (redirect in inputs) {
    const read = inputRedirectRead(redirect, cwd)
    if (isFailure(read)) {
      return read
    }
    effects.push(readEffect(read.value))
  }
  for (redirect in outputs) {
    // `2>file` and `1>file` write that file the way `>file` does. This path
    // runs the command through bash, so it never computes the bytes written.
    if (!redirectsStdoutOrStderr(redirect)) {
      return failure("redirect with an explicit file descriptor")
    }
    const prepared = resolveRedirectWrite(redirect, cwd, "")
    if (isFailure(prepared)) {
      return prepared
    }
    effects.push(writeEffect(prepared.value))
  }
  return success(effects)
}

def redirectsStdoutOrStderr(redirect: Redirect): boolean {
  """
  Check that a redirect names no descriptor, standard output, or standard error.
  """
  return redirect.fd == null || redirect.fd == 1 || redirect.fd == 2
}

def discardsOutput(redirect: Redirect): boolean {
  """
  Check for an output redirect of standard output or standard error to /dev/null.
  """
  if (redirect.op != ">" && redirect.op != ">>") {
    return false
  }
  if (!redirectsStdoutOrStderr(redirect)) {
    return false
  }
  return match(literalTarget(redirect.target)) {
    success(text) => text == "/dev/null"
    failure(_) => false
  }
}

@capabilities(fileRead)
def inputRedirectRead(redirect: Redirect, cwd: string): Result<ReadPayload> {
  """
  Resolve a literal input redirect to a regular file.
  """
  if (redirect.fd != null) {
    return failure("redirect with an explicit file descriptor")
  }
  const target = literalTarget(redirect.target)
  if (isFailure(target)) {
    return target
  }
  const path = resolveReadPath(target.value, redirect.target, cwd, "an input redirect")
  if (isFailure(path)) {
    return path
  }
  return success({
    dir: path.value.dir,
    filename: path.value.filename
  })
}

// The payload must name the target without evaluating shell variables.
def literalTarget(word: Word): Result<string> {
  """
  Return a redirect target's text if it needs no shell expansion.
  """
  return literalWordText(word)
}

// The return type is narrowed rather than `string` so an invalid mode
// cannot reach the `std::write` payload or the `_write` call.
def writeMode(op: string): WriteMode {
  """
  Return append mode for >> and overwrite mode otherwise.
  """
  return match(op) {
    ">>" => "append"
    _ => "overwrite"
  }
}

/** What one simple command asks, and the command bash runs for it. The
 command is the one that was written, except a git command, which safeBash
 writes itself. */
type SimpleRule = {
  effects: Effect[];
  command: Command
}

export def effectsFor(
  command: SimpleCommand,
  cwd: string,
  readsStdin: boolean = false,
  origin: GhRepo | null = null,
): Result<Effect[]> {
  """
  Classify the approvals needed by one simple command.
  Return a failure when it needs the broader Bash approval.

  @param cwd - The resolved working directory used in approval payloads.
  @param readsStdin - Whether a pipe supplies this command's input.
  @param origin - The repository a `gh` command acts on when it names none. Left null, such a command's std::github effects name no repository.
  """
  const rule = simpleCommandRule(command, cwd, origin, readsStdin)?
  return success(rule.effects)
}

// The one path every simple command is classified by. The checks before
// the verb apply to every verb, git included, which is why `gitEffects`
// has no other caller: a second path would have to repeat them.
@capabilities(fileRead)
def simpleCommandRule(command: SimpleCommand, cwd: string, origin: GhRepo | null, readsStdin: boolean): Result<SimpleRule> {
  """
  Classify one simple command: the approvals it needs and the command to run for it.
  """
  const name = command.command
  if (name == null) {
    return failure("an assignment with no command")
  }
  // A path word is never a recognized command: `/bin/git` must not become
  // a git read. The wall may look at path words, because a wall match can
  // only ever cause a refusal.
  if (name.tag != "literal") {
    return failure("the command word is not a literal")
  }
  // Leading assignments can change the repository or other behavior beyond
  // what a narrow payload describes, as with GIT_DIR=/elsewhere git status.
  if (command.assignments.length > 0) {
    return failure("a leading assignment changes what the command does")
  }
  const redirect = redirectEffect(command.redirects, cwd)?
  if (name.text == "git") {
    const git = gitEffects(command, cwd)?
    return success({ effects: [...git.effects, ...redirect], command: git.command })
  }
  // A gh read raises std::github. Every other gh line falls through to
  // verbEffects and asks std::exec. The glob and --jq checks cover both.
  if (name.text == "gh") {
    if (ghHasGlob(command)) {
      return failure("a glob in a gh line can expand to a flag, such as --jq")
    }
    if (ghHasJq(command)) {
      return failure("gh's --jq runs a program that can read the environment")
    }
    if (ghOwns(command)) {
      const gh = ghEffects(command, cwd, origin)?
      return success({ effects: [...gh.effects, ...redirect], command: gh.command })
    }
  }
  const effects = verbEffects(name.text, command, cwd, readsStdin, redirect)?
  return success({ effects: effects, command: command })
}

// `echo` contributes nothing on its own, whatever its arguments: bash
// runs it and expands anything in it, so `echo $HOME` and `echo -n hi`
// are both fine on this path. The flag and literal-argument restrictions
// belong to the shell-free path, which computes the output itself.
@capabilities(fileRead)
def verbEffects(verb: string, command: SimpleCommand, cwd: string, readsStdin: boolean, redirects: Effect[]): Result<Effect[]> {
  """
  Classify a command that bash runs as written, by its verb.
  """
  return match(verb) {
    "echo" => success(redirects)
    "grep" => match(readGrep(command, cwd, GREP_FLAGS)) {
      success(found) => grepReadEffects(found, readsStdin, redirects)
      failure(why) => failure(why)
    }
    "tr" => trEffects(command, readsStdin, redirects)
    "find" => findEffects(command, cwd, redirects)
    _ => otherVerbEffects(verb, command, cwd, readsStdin, redirects)
  }
}

@capabilities(fileRead)
def otherVerbEffects(verb: string, command: SimpleCommand, cwd: string, readsStdin: boolean, redirects: Effect[]): Result<Effect[]> {
  """
  Classify a file read, directory listing, or external program invocation.
  """
  const listing = LIST_VERBS[verb]
  if (listing != null) {
    return listEffects(verb, command, cwd, listing, redirects)
  }
  const spec = READ_VERBS[verb]
  if (spec == null) {
    return execEffects(verb, command, cwd, readsStdin, redirects)
  }
  return match(readFileVerb(verb, command, cwd, spec)) {
    success(found) => fileReadEffects(verb, found, readsStdin, redirects)
    failure(why) => failure(why)
  }
}

/** Bash builtins. The exec tool cannot run one, so no std::exec payload
 can describe it, and some change what later commands run (`cd`,
 `hash -p`, `enable -f`, `export`). `bash -c 'compgen -b'` on bash 3.2,
 plus mapfile, readarray, and compopt from bash 5. kill, printf, pwd,
 and test are also programs, but bash runs the builtin of that name, so
 the builtin rule is the one that describes them. */
static const BUILTIN_VERBS: string[] = [
  ".", ":", "[", "alias", "bg", "bind", "break", "builtin", "caller", "cd",
  "command", "compgen", "complete", "compopt", "continue", "declare",
  "dirs", "disown", "echo", "enable", "eval", "exec", "exit", "export",
  "false", "fc", "fg", "getopts", "hash", "help", "history", "jobs", "kill",
  "let", "local", "logout", "mapfile", "popd", "printf", "pushd", "pwd",
  "read", "readarray", "readonly", "return", "set", "shift", "shopt",
  "source", "suspend", "test", "times", "trap", "true", "type", "typeset",
  "ulimit", "umask", "unalias", "unset", "wait"
]

/** Programs that never become std::exec. They ask std::bash. */
static const NO_EXEC_PROGRAMS: string[] = [
  // Programs that exist to run another program. A payload for one would
  // name the wrapper, while what runs is in its arguments, so a rule
  // `{ command: "sh" }` would approve anything.
  "sh", "bash", "zsh", "dash", "fish", "xargs", "env", "sudo", "doas",
  "nohup", "time", "timeout", "watch", "nice", "script",
  // Package runners. `npx -y foo` has subcommand `-y`, so a saved
  // `{ npx, -y }` would cover every package. (`pnpm dlx` and `npm exec`
  // are keyed on a subcommand that names the behaviour, so they stay.)
  "npx", "bunx", "uvx", "pipx",
  // A lone `agency` line runs in process through std::agency, and
  // recommended approves std::exec for agency's safe subcommands, which
  // were chosen for the exec tool. A bash spelling must not pick that up.
  "agency",
  // A lone `which agency` is refused by tryAgencyPlan, so that the model
  // does not go looking for the binary. A chain must not turn the same
  // lookup into a question a saved rule answers.
  "which", "whereis"
]

// A program no arm or table owns asks std::exec, the question the exec
// tool asks for the same program and arguments. Bash builtins, programs
// that run other programs, and a program whose stdin the payload cannot
// describe ask std::bash.
def execEffects(verb: string, command: SimpleCommand, cwd: string, readsStdin: boolean, redirects: Effect[]): Result<Effect[]> {
  """
  Build an execution approval for a program whose arguments and input can be described.
  """
  if (BUILTIN_VERBS.includes(verb)) {
    return failure("`${verb}` is a bash builtin, not a program")
  }
  // safeBash has no rule for a wrapper program, so it asks std::bash. The
  // rejection fixtures check this exact sentence, so rewording it breaks
  // them.
  if (NO_EXEC_PROGRAMS.includes(verb)) {
    return failure("no rule for `${verb}`")
  }
  const piped = pipedProgram(verb, readsStdin, command)
  if (isFailure(piped)) {
    return piped
  }
  const args = execArgs(verb, command.args)
  if (isFailure(args)) {
    return args
  }
  const payload: ExecPayload = {
    command: verb,
    args: args.value,
    subcommand: subcommandOf(args.value),
    cwd: cwd,
    timeout: 0,
    stdin: ""
  }
  return success([execEffect(payload), ...redirects])
}

/* The first argument, which the exec tool and its `@always` call the
 subcommand, or "" for a bare program. */
def subcommandOf(args: string[]): string {
  if (args.length == 0) {
    return ""
  }
  return args[0]
}

def execArgs(verb: string, words: Word[]): Result<string[]> {
  """
  Return program arguments as payload text, failing on variables or interpolations.
  """
  let out: string[] = []
  for (word in words) {
    const text = execArgText(word)
    if (isFailure(text)) {
      return failure("the ${verb} arguments are not literal")
    }
    out.push(text.value)
  }
  return success(out)
}

def execArgText(word: Word): Result<string> {
  return match(word) {
    { tag: "flag" } => success(renderFlag(word))
    { tag: "glob", text } => success(text)
    _ => literalWordText(word)
  }
}

def readEffects(paths: ReadPath[]): Effect[] {
  return [readEffect({ dir: path.dir, filename: path.filename }) for path in paths]
}

def fileReadEffects(verb: string, found: FileRead, readsStdin: boolean, redirects: Effect[]): Result<Effect[]> {
  return match(found) {
    { kind: "stdin" } => stdinStage(verb, readsStdin, redirects)
    { kind: "files", paths } => success([...readEffects(paths), ...redirects])
  }
}

/** Which flags a verb takes. Short letters are listed one per entry, so a
 combined `-rn` is checked letter by letter. A long flag that takes no
 value is listed as written (`--color=never`). */
export type FlagSpec = {
  /** Flags that stand alone. */
  plain: string[];
  /** Flags that take a value, from the rest of the word (`-A3`), after
   `=` (`--regexp=x`), or from the next word (`-A 3`). Each may appear
   once. */
  valued: string[];
  /** Every flag must come before the first positional word. True for a
   command real grep will run: BSD grep, and GNU grep with
   POSIXLY_CORRECT set, read a later `-s` as a file to search. */
  optionsFirst: boolean;
  /** The valued flag a bare digit flag stands for: with `n`, head's `-20`
   is `-n 20`. A digit flag after a valued flag is that flag's value,
   so `head -n -5` stays a refused value. */
  digitFlag?: string;
  /** A single-dash flag is one word, listed with its dash (`-name`), and
   never a run of letters. True for find. No verb mixes the two kinds,
   so a table holds letters or words, not both. */
  wholeWords?: boolean
}

/** One valued flag and its value. `flag` is the letter for a short flag
 (`A`) and the whole name for a long one (`--regexp`). */
export type FlagValue = {
  flag: string;
  value: string
}

/** A command's arguments checked against a FlagSpec. */
export type SplitArgs = {
  plain: string[];
  values: FlagValue[];
  positionals: Word[]
}

/** What one flag word contributed, and how many words it used: 2 when
 its value was the next word. */
type FlagRead = {
  plain: string[];
  values: FlagValue[];
  consumed: number
}

/** The grep flags safeBash can describe exactly. An allowlist: it has to
 hold for GNU grep (Linux), BSD grep (macOS), and a grep a user put on
 their PATH such as ugrep, because the bash path runs whichever grep the
 shell finds. Left out on purpose, so a grep using
 one asks std::bash:
 - `-R`: GNU grep follows every symlink below the path.
 - `-f`, `--exclude-from`, `--include-from` read another file.
 - `--include`, `--exclude`, `--exclude-dir`: the shell-free path cannot
   carry them out, and the bash path is narrow only for one named file,
   where they change nothing.
 - `-m` counts per file, and the payload's maxResults is a total.
 - `-P` is missing from BSD grep.
 - `-z`, `-d`, `-D` mean different things in different greps.
 - ugrep's `--filter` runs a program and `--save-config` writes a file.
 - The long spellings of short flags (`--recursive`, `--ignore-case`). */
export static const GREP_FLAGS: FlagSpec = {
  plain: ["n", "r", "i", "w", "l", "v", "E", "F", "c", "h", "H", "o", "s", "--color=never"],
  valued: ["e", "A", "B", "C"],
  optionsFirst: true
}

def splitFlags(verb: string, command: SimpleCommand, spec: FlagSpec): Result<SplitArgs> {
  """
  Validate arguments against a flag table and separate flags, values, and positional words.
  """
  const args = command.args
  let plain: string[] = []
  let values: FlagValue[] = []
  let positionals: Word[] = []
  let index = 0
  while (index < args.length) {
    const word = args[index]
    if (word is { tag: "flag" }) {
      // Checked before the table, so a late flag is reported the same way
      // whether or not the table knows it.
      if (spec.optionsFirst && positionals.length > 0) {
        return failure("an option after the first argument is a file name to some versions of ${verb}")
      }
      const next: Word | null = if (index + 1 < args.length) then args[index + 1] else null
      const read = readFlagWord(verb, word, next, spec)
      if (isFailure(read)) {
        return read
      }
      for (entry in read.value.values) {
        const earlier = [seen for seen in values if seen.flag == entry.flag]
        if (earlier.length > 0) {
          return failure("${verb} takes `${flagDisplay(entry.flag)}` only once")
        }
      }
      plain = [...plain, ...read.value.plain]
      values = [...values, ...read.value.values]
      index = index + read.value.consumed
      continue
    }
    const dash = refuseQuotedOption(verb, word)
    if (isFailure(dash)) {
      return dash
    }
    positionals.push(word)
    index = index + 1
  }
  return success({
    plain: plain,
    values: values,
    positionals: positionals
  })
}

def readFlagWord(verb: string, word: FlagWord, next: Word | null, spec: FlagSpec): Result<FlagRead> {
  """
  Read one flag word and its value according to the flag table.
  """
  if (word.flagName.startsWith("--")) {
    return readLongFlag(verb, word, next, spec)
  }
  const digitFlag = spec.digitFlag
  const digits = word.flagName.slice(1)
  if (digitFlag != null && word.flagValue == null && isDigits(digits)) {
    return success({
      plain: [],
      values: [{ flag: digitFlag, value: digits }],
      consumed: 1
    })
  }
  if (word.flagValue != null) {
    return failure("${verb} does not take `${renderFlag(word)}`")
  }
  if (spec.wholeWords == true) {
    return readWholeWord(verb, word, next, spec)
  }
  const letters = word.flagName.slice(1)
  let found: string[] = []
  let position = 0
  while (position < letters.length) {
    const letter = letters.charAt(position)
    if (spec.plain.includes(letter)) {
      found.push(letter)
      position = position + 1
      continue
    }
    if (!spec.valued.includes(letter)) {
      return failure("${verb} does not take `-${letter}`")
    }
    const rest = letters.slice(position + 1)
    if (rest != "") {
      return success({
        plain: found,
        values: [{ flag: letter, value: rest }],
        consumed: 1
      })
    }
    const value = nextWordValue(verb, letter, next)
    if (isFailure(value)) {
      return value
    }
    return success({
      plain: found,
      values: [{ flag: letter, value: value.value }],
      consumed: 2
    })
  }
  return success({
    plain: found,
    values: [],
    consumed: 1
  })
}

/* A single-dash flag looked up whole, for a table of whole words. */
def readWholeWord(verb: string, word: FlagWord, next: Word | null, spec: FlagSpec): Result<FlagRead> {
  const name = word.flagName
  if (spec.plain.includes(name)) {
    return success({
      plain: [name],
      values: [],
      consumed: 1
    })
  }
  if (!spec.valued.includes(name)) {
    return failure("${verb} does not take `${name}`")
  }
  const value = nextWordValue(verb, name, next)
  if (isFailure(value)) {
    return value
  }
  return success({
    plain: [],
    values: [{ flag: name, value: value.value }],
    consumed: 2
  })
}

def readLongFlag(verb: string, word: FlagWord, next: Word | null, spec: FlagSpec): Result<FlagRead> {
  const written = renderFlag(word)
  if (spec.plain.includes(written)) {
    return success({
      plain: [written],
      values: [],
      consumed: 1
    })
  }
  if (!spec.valued.includes(word.flagName)) {
    // The flag as written, value and all, so a refused `--color=always`
    // is not read as a refusal of `--color=never`.
    return failure("${verb} does not take `${written}`")
  }
  if (word.flagValue == null) {
    const value = nextWordValue(verb, word.flagName, next)
    if (isFailure(value)) {
      return value
    }
    return success({
      plain: [],
      values: [{ flag: word.flagName, value: value.value }],
      consumed: 2
    })
  }
  if (word.valueIsGlob == true) {
    return failure("the value of `${word.flagName}` is a glob bash may expand")
  }
  return success({
    plain: [],
    values: [{ flag: word.flagName, value: word.flagValue }],
    consumed: 1
  })
}

def nextWordValue(verb: string, flag: string, next: Word | null): Result<string> {
  """
  Read the literal word after a valued flag, refusing a leading dash.
  """
  if (next == null) {
    return failure("${verb}'s `${flagDisplay(flag)}` needs a value")
  }
  // The parser represents a leading dash as a flag, including negative counts.
  if (next is { tag: "flag" }) {
    return failure("the value of `${flagDisplay(flag)}` starts with a dash")
  }
  const text = literalWordText(next)
  if (text is failure(why)) {
    return failure("the value of `${flagDisplay(flag)}` is not literal")
  }
  const dash = refuseQuotedOption(verb, next)
  if (isFailure(dash)) {
    return dash
  }
  return success(text.value)
}

def refuseQuotedOption(verb: string, word: Word): Result {
  """
  Reject a quoted word that the program would interpret as an option.
  """
  const text = literalWordText(word)
  if (text is success(written)) {
    if (written.startsWith("-")) {
      return failure("a quoted `${written}` is still an option to ${verb}")
    }
  }
  return success(null)
}

/* A flag as the model wrote it: `-A` for a letter, `--regexp` as is. */
def flagDisplay(flag: string): string {
  if (flag.startsWith("-")) {
    return flag
  }
  return "-${flag}"
}

/** A path resolved for safeBash: a grep's, a read's, or a listing's.
 Mirrors `GrepTarget` in lib/stdlib/shell.ts: `file` is null for a
 folder, and `argument` is the path as bash hands it to the program. */
type PathTarget = {
  dir: string;
  file: string | null;
  argument: string
}

/** A grep command checked against a flag table, with its one path resolved. */
type GrepCall = {
  split: SplitArgs;
  /** The pattern as the command wrote it. */
  pattern: string;
  /** The resolved path. Its `argument` is "" when -r searched "." because
   no path was written, since grep then prints bare names. */
  target: PathTarget
}

/** The pattern, and the words after it that name paths. */
type GrepWords = {
  pattern: string;
  paths: Word[]
}

/** grep's context flags, whose values are line counts. */
static const CONTEXT_FLAGS: string[] = ["A", "B", "C"]

/** What a grep command reads: the path it names (or `.` with -r), or
 its stdin when it names no path. */
type GrepRead = { kind: "stdin" } | { kind: "search"; call: GrepCall }

// A command that names no file and reads its stdin. Fed by a pipe, it reads
// only the previous command's output, so it adds nothing beyond its
// redirects. Anywhere else its stdin is safeBash's closed one, so the
// command does nothing useful and stays unrecognized.
def stdinStage(verb: string, readsStdin: boolean, redirects: Effect[]): Result<Effect[]> {
  """
  Accept a command that reads no files only when a pipe supplies its input.
  """
  if (readsStdin) {
    return success(redirects)
  }
  return failure("${verb} with no path reads stdin")
}

// The counterpart of stdinStage for a program std::exec describes. The
// payload's `stdin` is empty, so a program fed by a pipe or by `<` would be
// described wrongly, and it stays unrecognized. The `<` is read from the
// command's own redirects and not from the effects. By this point it has
// become a std::read effect, which does not say which command it came from.
def pipedProgram(verb: string, readsStdin: boolean, command: SimpleCommand): Result {
  """
  Refuse program invocations whose input cannot be described by the execution payload.
  """
  if (readsStdin) {
    return failure("`${verb}` reads a pipe, and std::exec cannot say what it reads")
  }
  const inputs = [redirect for redirect in command.redirects if redirect.op == "<"]
  if (inputs.length > 0) {
    return failure("`${verb}` reads an input redirect, and std::exec cannot say what it reads")
  }
  return success(null)
}

@capabilities(fileRead)
def readGrep(command: SimpleCommand, cwd: string, spec: FlagSpec): Result<GrepRead> {
  """
  Validate a grep command and resolve the pattern and path it searches.
  """
  const split = splitFlags("grep", command, spec)
  if (isFailure(split)) {
    return split
  }
  const args = split.value
  const words = grepWords(args)
  if (isFailure(words)) {
    return words
  }
  for (entry in args.values) {
    if (CONTEXT_FLAGS.includes(entry.flag) && !isDigits(entry.value)) {
      return failure("the value of `-${entry.flag}` is not a number")
    }
  }
  const paths = words.value.paths
  if (paths.length > 1) {
    return failure("grep with more than one path")
  }
  if (paths.length == 0) {
    return searchHere(args, words.value.pattern, cwd)
  }
  const pathWord = paths[0]
  const text = literalWordText(pathWord)
  if (text is failure(why)) {
    return failure("the grep path is not literal")
  }
  const target = resolveTarget(text.value, pathWord, cwd)
  if (isFailure(target)) {
    return target
  }
  return success({
    kind: "search",
    call: {
      split: args,
      pattern: words.value.pattern,
      target: target.value
    }
  })
}

/* With no path, `-r` searches the working directory and grep prints bare
 names. That check comes first: a pipe does not stop `-r` from reading
 files (ugrep reads both). Without `-r`, grep reads its stdin. */
@capabilities(fileRead)
def searchHere(args: SplitArgs, pattern: string, cwd: string): Result<GrepRead> {
  if (!args.plain.includes("r")) {
    return success({ kind: "stdin" })
  }
  const here = try _searchTargetIn(".", cwd, "literal")
  if (isFailure(here)) {
    return here
  }
  return success({
    kind: "search",
    call: {
      split: args,
      pattern: pattern,
      target: {
        dir: here.value.dir,
        file: here.value.file,
        argument: ""
      }
    }
  })
}

def grepWords(args: SplitArgs): Result<GrepWords> {
  """
  Separate the grep pattern from paths, honoring the -e flag.
  """
  const fromFlag = [entry.value for entry in args.values if entry.flag == "e"]
  if (fromFlag.length > 0) {
    return success({
      pattern: fromFlag[0],
      paths: args.positionals
    })
  }
  if (args.positionals.length == 0) {
    return failure("grep with no pattern")
  }
  const first = literalWordText(args.positionals[0])
  if (first is failure(why)) {
    return failure("the grep pattern is not literal")
  }
  return success({
    pattern: first.value,
    paths: args.positionals.slice(1)
  })
}

static const DIGITS = "0123456789"

def isDigits(text: string): boolean {
  const others = [char for char in text.split("") if !DIGITS.includes(char)]
  return text != "" && others.length == 0
}

// The one place a grep command's flags become std::grep's fields. The bash
// path and the shell-free path both call it, so both build the approval
// the same way. They differ only in the pattern, its regex flags, and the
// cap they pass.
def grepPayload(call: GrepCall, pattern: string, flags: string, maxResults: number): GrepPayload {
  """
  Build an approval payload from a validated grep call.
  """
  const letters = call.split.plain
  return {
    pattern: pattern,
    dir: call.target.dir,
    file: call.target.file,
    flags: flags,
    maxResults: maxResults,
    ignoreCase: letters.includes("i"),
    wholeWord: letters.includes("w"),
    filesOnly: letters.includes("l"),
    invert: letters.includes("v")
  }
}

/* The effects of a grep that runs through bash, by what it reads. */
def grepReadEffects(found: GrepRead, readsStdin: boolean, redirects: Effect[]): Result<Effect[]> {
  return match(found) {
    { kind: "stdin" } => stdinStage("grep", readsStdin, redirects)
    { kind: "search", call } => grepSearchEffects(call, redirects)
  }
}

// The grep tool skips files such as .git and ignored directories. A real
// directory grep could read them, so it cannot reuse the tool's narrow approval.
def grepSearchEffects(call: GrepCall, redirects: Effect[]): Result<Effect[]> {
  """
  Describe a Bash grep of one named file, refusing directory searches.
  """
  if (call.target.file == null) {
    return failure("grep through bash would search a directory, and reads files the grep tool skips")
  }
  // 0 means no cap, which is true of grep without -m.
  return success([grepEffect(grepPayload(call, call.pattern, "", 0)), ...redirects])
}

/** The flags the grep tool's search can carry out exactly. A lone grep
 that uses only these runs shell-free. -c, -o, -A, -B, and -C have no
 equivalent in the tool, so a grep using them runs through bash. No real
 grep reads these arguments, so a flag may follow the pattern, as GNU
 grep allows. */
static const SHELL_FREE_GREP_FLAGS: FlagSpec = {
  plain: ["n", "r", "i", "w", "l", "v", "E", "F", "h", "H", "s", "--color=never"],
  valued: ["e"],
  optionsFirst: false
}

/** The regex flags a shell-free search runs with. `u` makes `.` match a
 whole character, as grep does in a UTF-8 locale, not half of an emoji. */
static const SHELL_FREE_REGEX_FLAGS = "u"

/** The most matches a shell-free grep returns; the output says so when it stops. */
static const SHELL_FREE_GREP_CAP = 1000

// A grep that safeBash runs in process goes through the grep tool's own
// search and not the grep program, so its approval means what the grep
// tool's approval means. This applies only when every flag and every
// character of the pattern means the same thing to grep and to the tool.
// A failure means "not this path", and the general rules then decide.
@capabilities(fileRead)
def tryShellFreeGrep(command: SimpleCommand, cwd: string): Result<Plan> {
  """
  Plan an in-process grep when its pattern and flags translate to the grep tool.
  """
  const name = command.command
  if (name == null || name.tag != "literal" || name.text != "grep") {
    return failure("not grep")
  }
  if (command.assignments.length > 0 || command.redirects.length > 0) {
    return failure("not a lone grep")
  }
  return match(readGrep(command, cwd, SHELL_FREE_GREP_FLAGS)) {
    success(found) => shellFreeGrepRead(found, command)
    failure(why) => failure(why)
  }
}

def shellFreeGrepRead(found: GrepRead, command: SimpleCommand): Result<Plan> {
  return match(found) {
    { kind: "stdin" } => failure("a lone grep with no path reads stdin")
    { kind: "search", call } => shellFreeGrepPlan(call, command)
  }
}

@capabilities(fileRead)
def shellFreeGrepPlan(call: GrepCall, command: SimpleCommand): Result<Plan> {
  """
  Build an in-process search plan from a validated grep call.
  """
  const letters = call.split.plain
  const target = call.target
  // Without -r, grep does not search a directory, and the tool would.
  if (target.file == null && !letters.includes("r")) {
    return failure("grep without -r does not search a directory")
  }
  const syntax = grepSyntax(letters)
  if (isFailure(syntax)) {
    return syntax
  }
  const regex = _grepPatternToRegex(call.pattern, syntax.value, letters.includes("w"))
  if (regex == null) {
    return failure("the pattern does not translate to the grep tool's regex")
  }
  // With both -H and -h the later one wins in grep, and the split does
  // not keep their order.
  if (letters.includes("H") && letters.includes("h")) {
    return failure("grep with both -H and -h")
  }
  const payload = grepPayload(call, regex, SHELL_FREE_REGEX_FLAGS, SHELL_FREE_GREP_CAP)
  const render: GrepRender = {
    lineNumbers: letters.includes("n"),
    fileNames: grepFileNames(letters),
    argument: target.argument,
    oneFile: target.file != null
  }
  return success({
    effects: [grepEffect(payload)],
    execution: grepExecution(payload, render),
    broadReason: null,
    verbs: verbNames([command])
  })
}

/* Which pattern syntax the letters choose. GNU grep refuses -E with -F. */
def grepSyntax(letters: string[]): Result<"basic" | "extended" | "fixed"> {
  if (letters.includes("E") && letters.includes("F")) {
    return failure("grep with both -E and -F")
  }
  if (letters.includes("F")) {
    return success("fixed")
  }
  if (letters.includes("E")) {
    return success("extended")
  }
  return success("basic")
}

def grepFileNames(letters: string[]): GrepFileNames {
  if (letters.includes("H")) {
    return "always"
  }
  if (letters.includes("h")) {
    return "never"
  }
  return "default"
}

/** How many of something a command takes: at least `least`, and at most
 `most`, or any number when `most` is null. */
type CountRange = {
  least: number;
  most: number | null
}

static const ANY_NUMBER: CountRange = { least: 0, most: null }
static const AT_MOST_ONE: CountRange = { least: 0, most: 1 }
static const EXACTLY_TWO: CountRange = { least: 2, most: 2 }

def countFits(given: number, range: CountRange): boolean {
  const most = range.most
  if (given < range.least) {
    return false
  }
  return most == null || given <= most
}

/* How many `noun`s a range allows, for a message: `2 paths`, `at most 1
 path`, `1 to 2 sets`. */
def describeCount(range: CountRange, noun: string): string {
  const most = range.most
  if (most == null) {
    return "at least ${range.least} ${noun}s"
  }
  const nouns = if (most == 1) then noun else "${noun}s"
  if (range.least == most) {
    return "${most} ${nouns}"
  }
  if (range.least == 0) {
    return "at most ${most} ${nouns}"
  }
  return "${range.least} to ${most} ${nouns}"
}

/** A read verb's flags, how many paths it takes, and which of its valued
 flags hold a count. */
export type ReadVerb = {
  flags: FlagSpec;
  /** head and tail take one path, because several files print headers;
   uniq takes one, because a second positional is its output file; diff
   and cmp compare exactly two. */
  paths: CountRange;
  /** The valued flags whose value must be digits, such as `-n` on head. */
  countFlags: string[]
}

/** The verbs that read the files they name, or their stdin when they
 name none. Every letter means the same thing in GNU, BSD, and busybox
 coreutils. Left out: cat -A -e -t -v (GNU and BSD spell the escapes
 differently); tail -f (never returns); tail -r (BSD only); wc -L (GNU
 only); diff -r (reads a whole tree under a question that names one
 folder) and -y (column width depends on the terminal); sort -o
 (writes a file), -m, -c; uniq's second positional. tac is not on
 macOS; the line is recognized and the shell reports it missing. sort
 may spill a large input to files under $TMPDIR, which no payload
 names. */
export static const READ_VERBS: Record<string, ReadVerb> = {
  cat: {
    flags: { plain: ["n", "b", "s"], valued: [], optionsFirst: true },
    paths: ANY_NUMBER,
    countFlags: []
  },
  head: {
    flags: { plain: [], valued: ["n", "c"], optionsFirst: true, digitFlag: "n" },
    paths: AT_MOST_ONE,
    countFlags: ["n", "c"]
  },
  tail: {
    flags: { plain: [], valued: ["n", "c"], optionsFirst: true, digitFlag: "n" },
    paths: AT_MOST_ONE,
    countFlags: ["n", "c"]
  },
  wc: {
    flags: { plain: ["l", "w", "c", "m"], valued: [], optionsFirst: true },
    paths: ANY_NUMBER,
    countFlags: []
  },
  diff: {
    flags: { plain: ["u", "q", "N", "w", "b", "B", "--color=never"], valued: ["U"], optionsFirst: true },
    paths: EXACTLY_TWO,
    countFlags: ["U"]
  },
  cmp: {
    flags: { plain: [], valued: [], optionsFirst: true },
    paths: EXACTLY_TWO,
    countFlags: []
  },
  sort: {
    flags: { plain: ["n", "r", "u", "f", "b"], valued: ["k", "t"], optionsFirst: true },
    paths: ANY_NUMBER,
    countFlags: []
  },
  uniq: {
    flags: { plain: ["c", "d", "u", "i"], valued: [], optionsFirst: true },
    paths: AT_MOST_ONE,
    countFlags: []
  },
  cut: {
    flags: { plain: [], valued: ["d", "f", "c"], optionsFirst: true },
    paths: ANY_NUMBER,
    countFlags: []
  },
  nl: {
    flags: { plain: [], valued: ["b"], optionsFirst: true },
    paths: ANY_NUMBER,
    countFlags: []
  },
  tac: {
    flags: { plain: [], valued: [], optionsFirst: true },
    paths: ANY_NUMBER,
    countFlags: []
  },
  rev: {
    flags: { plain: [], valued: [], optionsFirst: true },
    paths: ANY_NUMBER,
    countFlags: []
  }
}

/** One resolved path of a read verb. `argument` is the path as bash hands
 it to the program. */
type ReadPath = {
  dir: string;
  filename: string;
  argument: string
}

/** What a read verb reads: the files it names, or its stdin. */
type FileRead = { kind: "stdin" } | { kind: "files"; paths: ReadPath[]; split: SplitArgs }

/** tr reads only its stdin; its positionals are character sets, not
 paths. optionsFirst stays true: BSD tr reads `tr a b -d` as three
 operands and prints a usage error, GNU reads -d as a flag. */
static const TR_FLAGS: FlagSpec = {
  plain: ["d", "s"],
  valued: [],
  optionsFirst: true
}

/** How many sets tr takes, by its plain flags sorted and joined. `tr -s
 a b` squeezes after translating, so -s takes one set or two. */
static const TR_SET_COUNTS: Record<string, CountRange> = {
  "": { least: 2, most: 2 },
  d: { least: 1, most: 1 },
  s: { least: 1, most: 2 },
  ds: { least: 2, most: 2 }
}

def trEffects(command: SimpleCommand, readsStdin: boolean, redirects: Effect[]): Result<Effect[]> {
  """
  Validate a piped tr filter and return its redirect effects.
  """
  const split = splitFlags("tr", command, TR_FLAGS)
  if (isFailure(split)) {
    return split
  }
  const key = [...split.value.plain].sort().join("")
  const counts = TR_SET_COUNTS[key]
  if (counts == null) {
    return failure("tr takes `-d` and `-s` once each")
  }
  for (word in split.value.positionals) {
    const text = literalWordText(word)
    if (text is failure(why)) {
      return failure("a tr set is not literal")
    }
  }
  if (!countFits(split.value.positionals.length, counts)) {
    return failure("tr takes ${describeCount(counts, "set")} here")
  }
  return stdinStage("tr", readsStdin, redirects)
}

// A folder is refused because the program would read what no payload names
// (`diff a b` of two folders reads every file under both, links followed).
// A FIFO or a device is refused because a read of it may never return. A
// missing path is refused too, so any doubt asks std::bash.
@capabilities(fileRead)
def resolveReadPath(text: string, word: Word, cwd: string, subject: string): Result<ReadPath> {
  """
  Resolve a literal read path to a regular file, failing for directories or special files.
  """
  const target = resolveTarget(text, word, cwd)
  if (isFailure(target)) {
    return target
  }
  const file = target.value.file
  if (file == null) {
    return failure("${subject} would read a directory")
  }
  return success({
    dir: target.value.dir,
    filename: file,
    argument: target.value.argument
  })
}

@capabilities(fileRead)
def resolveTarget(text: string, word: Word, cwd: string): Result<PathTarget> {
  """
  Resolve a path against the working directory and distinguish files from directories.
  """
  return try _searchTargetIn(text, cwd, tildeModeFor(word))
}

/** A listing's path, resolved, with whether its last step is a symlink. */
type ListTarget = {
  target: PathTarget;
  linked: boolean
}

@capabilities(fileRead)
def resolveTargets(verb: string, words: Word[], cwd: string): Result<ListTarget[]> {
  """
  Resolve listing operands and record whether each final component is a symlink.
  """
  let out: ListTarget[] = []
  for (word in words) {
    const text = literalWordText(word)
    if (text is failure(why)) {
      return failure("the ${verb} path is not literal")
    }
    const target = resolveTarget(text.value, word, cwd)
    if (isFailure(target)) {
      return target
    }
    const linked = lastStepIsLink(target.value, cwd)
    if (isFailure(linked)) {
      return linked
    }
    out.push({ target: target.value, linked: linked.value })
  }
  return success(out)
}

/** Last segments that can never be a link: `.`, `..`, and the empty one
 of `/`. `.` is also what a listing with no path lists. */
static const UNLINKED_SEGMENTS: string[] = [".", "..", ""]

// Compare the written final component and its real parent with the resolved
// target. Links earlier in the path do not affect this comparison.
@capabilities(fileRead)
def lastStepIsLink(target: PathTarget, cwd: string): Result<boolean> {
  """
  Determine whether the operand's final path component was a symlink.
  """
  const written = lastSegment(target.argument)
  if (UNLINKED_SEGMENTS.includes(written)) {
    return success(false)
  }
  if (written != realLastSegment(target)) {
    return success(true)
  }
  // `argument` already has its `~` expanded, so the literal mode is right,
  // as in readGrep's lookup of ".".
  const parent = try _searchTargetIn(parentOf(target.argument), cwd, "literal")
  if (isFailure(parent)) {
    return parent
  }
  return success(parent.value.dir != realParent(target))
}

/** The real path's last segment: the file's name, or the folder's own. */
def realLastSegment(target: PathTarget): string {
  const file = target.file
  if (file != null) {
    return file
  }
  return lastSegment(target.dir)
}

/** The real path's parent folder. */
def realParent(target: PathTarget): string {
  if (target.file != null) {
    return target.dir
  }
  return parentOf(target.dir)
}

def requireFolder(verb: string, target: PathTarget): Result<string> {
  """
  Return the resolved directory or fail if the operand is a file.
  """
  if (target.file != null) {
    return failure("${verb} of a file is not a listing")
  }
  return success(target.dir)
}

def checkCountFlags(split: SplitArgs, countFlags: string[]): Result {
  """
  Check that count-valued flags contain digits.
  """
  for (entry in split.values) {
    if (countFlags.includes(entry.flag) && !isDigits(entry.value)) {
      return failure("the value of `${flagDisplay(entry.flag)}` is not a number")
    }
  }
  return success(null)
}

/** Whether a listing walks the tree always, or only when given -R. */
export type ListWalk = "always" | "withR"

/** What a listing verb does with a path that names a file: list the
 folder that holds it, or refuse. */
export type FileArgument = "folder" | "refuse"

/** A verb that lists directories: its flags, which valued flags hold a
 count, and whether it walks the tree. */
export type ListVerb = {
  flags: FlagSpec;
  /** The valued flags whose value must be digits, such as `-L` on tree. */
  countFlags: string[];
  recursive: ListWalk;
  /** What a file given to the verb asks: its folder, or nothing. */
  files: FileArgument
}

/** The verbs that list the folders they name, or `.` when they name
 none. Every letter means the same thing in GNU and BSD. Left out: `-L`
 on every verb (follows symlinks out of the folder) and `ls -G` (color
 on macOS, no group column on GNU). tree is not on macOS by default;
 the line is recognized and the shell reports it missing. A recursive
 listing through bash shows the entries under `.git` and `node_modules`
 that the ls tool's walk leaves out, and no file's contents. Given a
 file, ls prints that one entry and du that one file's size, so both
 ask for the folder that holds it, with no walk even though du always
 walks a folder. tree prints the name and an error, so it refuses. */
export static const LIST_VERBS: Record<string, ListVerb> = {
  ls: {
    flags: { plain: ["l", "a", "A", "h", "1", "t", "r", "S", "R", "d", "p", "F", "--color=never"], valued: [], optionsFirst: true },
    countFlags: [],
    recursive: "withR",
    files: "folder"
  },
  tree: {
    flags: { plain: ["a", "d", "--noreport"], valued: ["L", "I"], optionsFirst: true },
    countFlags: ["L"],
    recursive: "always",
    files: "refuse"
  },
  du: {
    flags: { plain: ["s", "h", "a", "c"], valued: ["d"], optionsFirst: true },
    countFlags: ["d"],
    recursive: "always",
    files: "folder"
  }
}

/** find's expression, as whole words. An allowlist: an unlisted word is
 unrecognized, which is what keeps -exec, -delete, -fprint, -L, and the
 ones this list forgot on the std::bash path. -newer is out because it
 reads another file's time. -iname is out because the glob tool's
 pattern is case-sensitive and the payload would say so. -H and -P are
 out because find takes them only before its paths, where the ordering
 rule refuses them. */
static const FIND_FLAGS: FlagSpec = {
  plain: ["-not", "-o", "-a", "-prune", "-print", "-print0"],
  valued: ["-name", "-path", "-type", "-maxdepth", "-mindepth", "-size"],
  optionsFirst: false,
  wholeWords: true
}

/** The expression words that widen or invert what -name selects. With
 any of them the pattern is `**`, because `-not -name x` lists the
 opposite of x and `-name x -o -type d` lists more than x. */
static const FIND_WIDENING_WORDS: string[] = ["-not", "-o", "-prune"]

static const FIND_COUNT_FLAGS: string[] = ["-maxdepth", "-mindepth"]

@capabilities(fileRead)
def findEffects(command: SimpleCommand, cwd: string, redirects: Effect[]): Result<Effect[]> {
  """
  Build search approvals for the literal directories a supported find command searches.
  """
  const split = splitFlags("find", command, FIND_FLAGS)
  if (isFailure(split)) {
    return split
  }
  const counts = checkCountFlags(split.value, FIND_COUNT_FLAGS)
  if (isFailure(counts)) {
    return counts
  }
  const depths = [entry.value for entry in split.value.values if entry.flag == "-maxdepth"]
  if (depths.length > 0 && digitsValue(depths[0]) == 0) {
    return failure("find -maxdepth 0 lists only the path itself")
  }
  const positionals = split.value.positionals
  if (positionals.length == 0) {
    return failure("find needs a path before its tests")
  }
  if (leadingPositionals(command) != positionals.length) {
    return failure("find takes its paths before its tests")
  }
  const entries = resolveTargets("find", positionals, cwd)
  if (isFailure(entries)) {
    return entries
  }
  const dirs = findFolders(entries.value)
  if (isFailure(dirs)) {
    return dirs
  }
  const pattern = findPattern(split.value)
  const searches = [globEffect({ pattern: pattern, dir: dir, maxResults: 0 }) for dir in dirs.value]
  return success([...searches, ...redirects])
}

/* How many of a command's arguments come before its first flag word. */
def leadingPositionals(command: SimpleCommand): number {
  let count = 0
  for (word in command.args) {
    if (word is { tag: "flag" }) {
      return count
    }
    count = count + 1
  }
  return count
}

// The glob tool matches a whole relative path with `*` stopping at `/`,
// while -name matches the last part at any depth, so -name's value gets a
// `**/` in front unless the search stops at depth 1. With no -name, or with
// a word that widens or inverts it, the pattern is everything.
def findPattern(split: SplitArgs): string {
  """
  Build a glob pattern covering the paths selected by a find expression.
  """
  const names = [entry.value for entry in split.values if entry.flag == "-name"]
  const widened = [word for word in split.plain if FIND_WIDENING_WORDS.includes(word)]
  const depths = [entry.value for entry in split.values if entry.flag == "-maxdepth"]
  const depthOne = depths.length > 0 && digitsValue(depths[0]) == 1
  if (names.length == 1 && widened.length == 0) {
    const prefix = if (depthOne) then "" else "**/"
    return prefix + names[0]
  }
  return if (depthOne) then "*" else "**"
}

/** The folder a listing with no path lists. */
static const CURRENT_DIR_WORD: Word = { tag: "literal", text: "." }

@capabilities(fileRead)
def listEffects(verb: string, command: SimpleCommand, cwd: string, spec: ListVerb, redirects: Effect[]): Result<Effect[]> {
  """
  Build one listing approval for each directory a supported listing command inspects.
  """
  const split = splitFlags(verb, command, spec.flags)
  if (isFailure(split)) {
    return split
  }
  const counts = checkCountFlags(split.value, spec.countFlags)
  if (isFailure(counts)) {
    return counts
  }
  const named = split.value.positionals
  const words: Word[] = if (named.length == 0) then [CURRENT_DIR_WORD] else named
  const entries = resolveTargets(verb, words, cwd)
  if (isFailure(entries)) {
    return entries
  }
  const walk = spec.recursive == "always" || split.value.plain.includes("R")
  const follows = followsFolderLink(verb, split.value)
  let payloads: LsPayload[] = []
  for (entry in entries.value) {
    const payload = listingOf(verb, spec, entry, walk, follows)
    if (isFailure(payload)) {
      return payload
    }
    payloads.push(payload.value)
  }
  const listings = [lsEffect(payload) for payload in mergeListings(payloads)]
  return success([...listings, ...redirects])
}

/** The ls flags under which a folder link given as an operand is printed
 as itself instead of followed. POSIX: a symbolic link to a directory
 given as an operand is followed unless -F, -d, or -l is given. */
static const LS_LINK_FLAGS: string[] = ["l", "d", "F"]

// Only ls follows a folder link operand, and only without -l, -d, or -F.
// du and tree follow a link operand only under -H, -L, or -l, and none of
// those is in their rows. Adding one of those flags to a du or tree row
// makes this function wrong.
def followsFolderLink(verb: string, split: SplitArgs): boolean {
  """
  Determine whether the listing program follows a directory symlink operand.
  """
  const printsLink = [flag for flag in LS_LINK_FLAGS if split.plain.includes(flag)]
  return verb == "ls" && printsLink.length == 0
}

def listingOf(verb: string, spec: ListVerb, entry: ListTarget, walk: boolean, follows: boolean): Result<LsPayload> {
  """
  Build a listing payload for an operand, refusing undescribed symlink behavior.
  """
  const target = entry.target
  if (entry.linked && (target.file != null || !follows)) {
    return failure("${verb} of a symlink is not described")
  }
  if (spec.files == "refuse" || target.file == null) {
    return match(requireFolder(verb, target)) {
      success(dir) => success({ dir: dir, recursive: walk, maxResults: 0 })
      failure(why) => failure(why)
    }
  }
  return success({ dir: target.dir, recursive: false, maxResults: 0 })
}

def mergeListings(payloads: LsPayload[]): LsPayload[] {
  """
  Combine listing approvals for the same directory, keeping recursive scope when needed.
  """
  let out: LsPayload[] = []
  for (payload in payloads) {
    const seen = [kept for kept in out if kept.dir == payload.dir]
    if (seen.length > 0) {
      out = [widened(kept, payload) for kept in out]
    } else {
      out.push(payload)
    }
  }
  return out
}

/* `kept`, recursive if `extra` walks the same folder. */
def widened(kept: LsPayload, extra: LsPayload): LsPayload {
  if (kept.dir != extra.dir) {
    return kept
  }
  return {
    dir: kept.dir,
    recursive: kept.recursive || extra.recursive,
    maxResults: kept.maxResults
  }
}

// find never follows a link operand without -H or -L, which the ordering
// rule refuses, so a linked path is refused here. A file is refused by
// `requireFolder`.
def findFolders(entries: ListTarget[]): Result<string[]> {
  """
  Return find's resolved directory operands, refusing files and final-component symlinks.
  """
  let dirs: string[] = []
  for (entry in entries) {
    if (entry.linked) {
      return failure("find of a symlink is not described")
    }
    const dir = requireFolder("find", entry.target)
    if (isFailure(dir)) {
      return dir
    }
    dirs.push(dir.value)
  }
  return success(dirs)
}

@capabilities(fileRead)
def readFileVerb(verb: string, command: SimpleCommand, cwd: string, spec: ReadVerb): Result<FileRead> {
  """
  Validate a file-reading command and resolve its operands, or identify stdin input.
  """
  const split = splitFlags(verb, command, spec.flags)
  if (isFailure(split)) {
    return split
  }
  const counts = checkCountFlags(split.value, spec.countFlags)
  if (isFailure(counts)) {
    return counts
  }
  const positionals = split.value.positionals
  if (!countFits(positionals.length, spec.paths)) {
    return failure("${verb} takes ${describeCount(spec.paths, "path")}")
  }
  if (positionals.length == 0) {
    return success({ kind: "stdin" })
  }
  let paths: ReadPath[] = []
  for (word in positionals) {
    const text = literalWordText(word)
    if (text is failure(why)) {
      return failure("the ${verb} path is not literal")
    }
    const path = resolveReadPath(text.value, word, cwd, verb)
    if (isFailure(path)) {
      return path
    }
    paths.push(path.value)
  }
  return success({
    kind: "files",
    paths: paths,
    split: split.value
  })
}

// ---------------------------------------------------------------------------
// git
//
// A git command gets a rule only when an existing `std::git::*` effect
// describes it completely. safeBash then asks that effect, and runs a git
// command it writes itself (`gitCommand`), not the text the model wrote.
// Git reads a command line with rules of its own, and they can disagree
// with this classifier: `git checkout '*.py'` discards files, and `git
// diff /dev/null <file>` prints a file outside the repository. Writing
// the `--` between refs and paths makes git read each word the way it was
// classified, or fail.
// ---------------------------------------------------------------------------

/** The flag that ends the flags, as the parser returns it. */
static const END_OF_FLAGS = "--"

/** How a git subcommand's words are read.
 - `refsAndPaths`: words before `--` are refs and words after it are
   paths. With no `--`, a word that names something on disk is a path.
 - `paths`: every word is a path, on either side of a `--`.
 - `names`: every word is a plain name, such as a branch. A `--` has no
   rule. */
type GitWords = "refsAndPaths" | "paths" | "names"

/** A git subcommand's flags, how its words are read, and how many of
 each kind it takes. */
type GitVerb = {
  flags: FlagSpec;
  words: GitWords;
  refs: CountRange;
  paths: CountRange;
  names: CountRange
}

static const NONE: CountRange = { least: 0, most: 0 }
static const EXACTLY_ONE: CountRange = { least: 1, most: 1 }
static const AT_MOST_TWO: CountRange = { least: 0, most: 2 }
static const AT_LEAST_ONE: CountRange = { least: 1, most: null }

/** The git subcommands with one shape, and the flags each takes. An
 allowlist: a subcommand or flag left out sends the command to std::bash.
 A listed flag changes how a result is shown (`--oneline`, `--stat`) or
 shows less of it (`-n`, `--author`). None shows more than the payload
 describes or does something else. Left out on purpose:
 - `--all` on log shows every branch, and the payload has one `ref`.
 - `--no-index` on diff compares two files outside the repository.
 - `--output` on diff writes a file.
 - `--format` and `--pretty`: the value is nearly always quoted, and a
   flag with a quoted value is not read as a flag yet.
 - `-u` on add stages tracked changes only, and the payload cannot say so.
 - A path on show or status, and a ref on blame: the effect has no field
   for it.
 diff takes at most one path, and that is a safety rule: with two paths
 after `--` git compares the two files, wherever they are. */
static const GIT_VERBS: Record<string, GitVerb> = {
  status: {
    flags: { plain: ["s", "b", "--short", "--branch", "--porcelain", "--porcelain=v1"], valued: [], optionsFirst: false },
    words: "names",
    refs: NONE,
    paths: NONE,
    names: NONE
  },
  log: {
    flags: {
      plain: ["p", "--patch", "--oneline", "--stat", "--name-only", "--name-status", "--graph", "--decorate", "--no-color", "--reverse", "--no-merges", "--follow"],
      valued: ["n", "S", "G", "--max-count", "--author", "--grep", "--since", "--until"],
      optionsFirst: false,
      digitFlag: "n"
    },
    words: "refsAndPaths",
    refs: AT_MOST_ONE,
    paths: AT_MOST_ONE,
    names: NONE
  },
  diff: {
    flags: {
      plain: ["w", "--staged", "--cached", "--stat", "--shortstat", "--numstat", "--name-only", "--name-status", "--no-color"],
      valued: [],
      optionsFirst: false
    },
    words: "refsAndPaths",
    refs: AT_MOST_TWO,
    paths: AT_MOST_ONE,
    names: NONE
  },
  show: {
    flags: { plain: ["s", "--no-patch", "--stat", "--name-only", "--name-status", "--oneline", "--no-color"], valued: [], optionsFirst: false },
    words: "refsAndPaths",
    refs: AT_MOST_ONE,
    paths: NONE,
    names: NONE
  },
  blame: {
    flags: { plain: [], valued: [], optionsFirst: false },
    words: "refsAndPaths",
    refs: NONE,
    paths: EXACTLY_ONE,
    names: NONE
  },
  remote: {
    flags: { plain: ["v"], valued: [], optionsFirst: false },
    words: "names",
    refs: NONE,
    paths: NONE,
    names: NONE
  },
  add: {
    flags: { plain: ["A", "--all"], valued: [], optionsFirst: false },
    words: "paths",
    refs: NONE,
    paths: ANY_NUMBER,
    names: NONE
  },
  switch: {
    flags: { plain: ["c", "--create"], valued: [], optionsFirst: false },
    words: "names",
    refs: NONE,
    paths: NONE,
    names: EXACTLY_ONE
  },
  restore: {
    flags: { plain: ["--staged"], valued: [], optionsFirst: false },
    words: "paths",
    refs: NONE,
    paths: AT_LEAST_ONE,
    names: NONE
  }
}

// The four subcommands whose words depend on their flags. One row cannot
// state them, so each has a function below. Left out on purpose: `-D` on
// branch and `-f` on checkout force, `--amend` and `--no-verify` on
// commit do more than the payload says, and `-u` on stash takes untracked
// files too.
static const GIT_BRANCH_FLAGS: FlagSpec = {
  plain: ["a", "r", "v", "d", "--all", "--remotes", "--list", "--show-current", "--merged", "--no-merged", "--delete"],
  valued: [],
  optionsFirst: false
}
static const GIT_STASH_FLAGS: FlagSpec = { plain: [], valued: ["m", "--message"], optionsFirst: false }
static const GIT_COMMIT_FLAGS: FlagSpec = { plain: ["a", "q", "--all", "--quiet"], valued: ["m", "--message"], optionsFirst: false }
static const GIT_NEW_BRANCH_FLAGS: FlagSpec = { plain: ["b"], valued: [], optionsFirst: false }
static const NO_GIT_FLAGS: FlagSpec = { plain: [], valued: [], optionsFirst: false }

static const MESSAGE_FLAGS: string[] = ["m", "--message"]
static const DELETE_FLAGS: string[] = ["d", "--delete"]
/** The listing flags that take a branch to compare with. */
static const MERGED_FLAGS: string[] = ["--merged", "--no-merged"]
/** The words `git stash` takes as a second subcommand here. */
static const STASH_PUSH = "push"
static const STASH_LIST = "list"
static const STASH_POP = "pop"
/** The commit `git show` shows when none is named. */
static const SHOW_DEFAULT_REF = "HEAD"

/** One of a git command's words: its text, for a payload, and the word
 the parser produced, for the command that runs. The word keeps the
 model's quoting, so a quoted `'~/x'` stays quoted. An unquoted `~/x` has
 no rule: bash would expand it, and the payload would name a path the
 command does not use. */
type GitWord = {
  text: string;
  word: Word
}

/** A git command after its flags and words were checked against its row. */
type GitArgs = {
  sub: string;
  plain: string[];
  values: FlagValue[];
  refs: GitWord[];
  paths: GitWord[];
  names: GitWord[];
  cwd: string
}

type SortedGitWords = {
  refs: GitWord[];
  paths: GitWord[];
  names: GitWord[]
}

/** One count a row limits: how many were given, the limit, and what to
 call them in a message. */
type GitCount = {
  given: number;
  range: CountRange;
  noun: string
}

// The caller, `simpleCommandRule`, has already checked the command word,
// refused a leading assignment, and worked out the redirect effects. Do
// not add a second caller: it would skip those checks.
@capabilities(fileRead)
def gitEffects(command: SimpleCommand, cwd: string): Result<SimpleRule> {
  """
  Classify a git command: the effects it asks and the git command to run for it.
  Fail for a subcommand, flag, or word without an exact rule.
  """
  if (command.args.length == 0) {
    return failure("git with no subcommand")
  }
  const first = command.args[0]
  if (first.tag != "literal") {
    return failure("the git subcommand is not a plain word")
  }
  const sub = first.text
  const words = command.args.slice(1)
  const verb = GIT_VERBS[sub]
  if (verb != null) {
    return gitRowRule(sub, verb, words, cwd, command.redirects)
  }
  return match(sub) {
    "branch" => gitBranchRule(words, cwd, command.redirects)
    "stash" => gitStashRule(words, cwd, command.redirects)
    "commit" => gitCommitRule(words, cwd, command.redirects)
    "checkout" => gitCheckoutRule(words, cwd, command.redirects)
    _ => failure("no rule for `git ${sub}`")
  }
}

@capabilities(fileRead)
def gitRowRule(sub: string, verb: GitVerb, words: Word[], cwd: string, redirects: Redirect[]): Result<SimpleRule> {
  """
  Apply a subcommand's table row: check its flags and word counts, then build its effects and command.
  """
  const read = gitArgsFor(sub, words, verb.flags, verb.words, cwd)?
  const args = checkGitCounts(read, verb)?
  const effects = gitPayloads(args)?
  const built = gitCommand([sub], args, verb.words, redirects)
  // Outside a repository `git diff` ignores the `--` and compares files.
  // It is the one subcommand that does anything there.
  if (sub == "diff") {
    return success({ effects: effects, command: insideRepository(built) })
  }
  return success({ effects: effects, command: built })
}

@capabilities(fileRead)
def gitArgsFor(sub: string, words: Word[], flags: FlagSpec, kind: GitWords, cwd: string): Result<GitArgs> {
  """
  Check a git subcommand's flags against a flag table and sort its other words into refs, paths, and names.
  """
  // `splitFlags` would report `--` as a flag the table does not list, so
  // only the words before it go through the table.
  const cut = endOfFlagsIndex(words)
  const split = splitFlags("git ${sub}", gitWordsCommand(words.slice(0, cut)), flags)?
  const front = gitWordsOf(split.positionals)?
  // A word after `--` that looks like a flag is tagged a flag by the
  // parser, and `gitWordsOf` fails on it, so `git log -- -x` has no rule.
  const back = gitWordsOf(words.slice(cut + 1))?
  const sorted = sortGitWords(sub, kind, cut < words.length, front, back, cwd)?
  return success({
    sub: sub,
    plain: split.plain,
    values: split.values,
    refs: sorted.refs,
    paths: sorted.paths,
    names: sorted.names,
    cwd: cwd
  })
}

/* Where the first `--` is, or the number of words when there is none. */
def endOfFlagsIndex(words: Word[]): number {
  for (word, index in words) {
    if (word.tag == "flag" && word.flagName == END_OF_FLAGS) {
      return index
    }
  }
  return words.length
}

/* `splitFlags` reads a command, so the words are given to it as one. */
def gitWordsCommand(words: Word[]): SimpleCommand {
  return {
    tag: "simpleCommand",
    assignments: [],
    command: GIT_WORD,
    args: words,
    redirects: []
  }
}

def gitWordsOf(words: Word[]): Result<GitWord[]> {
  """
  Pair each word with its text, failing when a word is not fully literal or bash would expand it.
  """
  const texts = literalWords(words)?
  let paired: GitWord[] = []
  for (word, index in words) {
    // Bash expands a leading `~` in an unquoted word, so the payload's
    // `~/x` would not be the path git gets. The git tools read the same
    // text as a folder named `~`.
    if (tildeModeFor(word) == "expand" && texts[index].startsWith("~")) {
      return failure("a git argument starts with `~`, which bash would expand")
    }
    paired.push({ text: texts[index], word: word })
  }
  return success(paired)
}

@capabilities(fileRead)
def sortGitWords(
  sub: string,
  kind: GitWords,
  separated: boolean,
  front: GitWord[],
  back: GitWord[],
  cwd: string,
): Result<SortedGitWords> {
  """
  Sort a git command's words by how its subcommand reads them. `front` and `back` are the words before and after a `--`.
  """
  return match(kind) {
    "names" => {
      if (separated) {
        return failure("`git ${sub}` with a `--` has no rule")
      }
      return success({ refs: [], paths: [], names: front })
    }
    "paths" => success({ refs: [], paths: [...front, ...back], names: [] })
    "refsAndPaths" => {
      if (separated) {
        return success({ refs: front, paths: back, names: [] })
      }
      return success(refsAndPathsByDisk(front, cwd))
    }
  }
}

// Git decides whether a word is a ref or a path by looking at the
// repository. Nothing runs while a command is classified, so this reads
// the disk: a word that names a file or folder is a path, and any other
// word is a ref. The command that runs has a `--` between the two, so a
// wrong sort cannot make git do something else. It can only make git
// fail, or answer about a path where the model meant a branch of the
// same name.
@capabilities(fileRead)
def refsAndPathsByDisk(words: GitWord[], cwd: string): SortedGitWords {
  let refs: GitWord[] = []
  let paths: GitWord[] = []
  for (entry in words) {
    if (onDisk(entry, cwd)) {
      paths.push(entry)
    } else {
      refs.push(entry)
    }
  }
  return { refs: refs, paths: paths, names: [] }
}

// The check reads the parser's own word, so a quoted `'~/x'` is looked up
// as a folder named `~`, the way bash will pass it. `resolveTarget` fails
// for a device such as `/dev/null`, so a device is sorted as a ref, and
// git then rejects it as one.
@capabilities(fileRead)
def onDisk(entry: GitWord, cwd: string): boolean {
  return !isFailure(resolveTarget(entry.text, entry.word, cwd))
}

def checkGitCounts(args: GitArgs, verb: GitVerb): Result<GitArgs> {
  """
  Check how many refs, paths, and names a git command gave against its row.
  """
  const counts: GitCount[] = [
    { given: args.refs.length, range: verb.refs, noun: "ref" },
    { given: args.paths.length, range: verb.paths, noun: "path" },
    { given: args.names.length, range: verb.names, noun: "name" },
  ]
  for (count in counts) {
    if (!countFits(count.given, count.range)) {
      return failure("git ${args.sub} takes ${describeCount(count.range, count.noun)}")
    }
  }
  return success(args)
}

// What each single-shape subcommand asks. The words were checked against
// the row, so an arm only fills a payload. Add a subcommand by adding its
// row to `GIT_VERBS` and its arm here.
def gitPayloads(args: GitArgs): Result<Effect[]> {
  """
  Build the effects of a single-shape git subcommand from its checked flags and words.
  """
  const cwd = args.cwd
  return match(args.sub) {
    "status" => success([gitStatusEffect({ cwd: cwd })])
    "log" => success(
      [gitLogEffect({ cwd: cwd, ref: firstText(args.refs, ""), path: firstText(args.paths, "") })],
    )
    "diff" => success(
      [
      gitDiffEffect({
        cwd: cwd,
        ref: firstText(args.refs, ""),
        ref2: firstText(args.refs.slice(1), ""),
        staged: hasAny(args.plain, ["--staged", "--cached"]),
        path: firstText(args.paths, "")
      }),
    ],
    )
    "show" => success([gitShowEffect({ cwd: cwd, ref: firstText(args.refs, SHOW_DEFAULT_REF) })])
    "blame" => success([gitBlameEffect({ cwd: cwd, path: args.paths[0].text })])
    "remote" => success([gitRemoteListEffect({ cwd: cwd })])
    "add" => addEffects(args)
    "switch" => success(
      [gitSwitchEffect({ cwd: cwd, branch: args.names[0].text, create: hasAny(args.plain, ["c", "--create"]) })],
    )
    "restore" => restoreEffects(args)
    _ => failure("no rule for `git ${args.sub}`")
  }
}

// `git add` with no path and no `-A` stages nothing, so it would be an
// approval for nothing.
def addEffects(args: GitArgs): Result<Effect[]> {
  const all = hasAny(args.plain, ["A", "--all"])
  if (!all && args.paths.length == 0) {
    return failure("`git add` with nothing to add")
  }
  return success([gitAddEffect({ cwd: args.cwd, paths: textsOf(args.paths), all: all })])
}

// Only the form that unstages has a rule. The refuse wall refuses every
// other restore before a plan is made, and this does not rely on that.
def restoreEffects(args: GitArgs): Result<Effect[]> {
  if (!hasAny(args.plain, ["--staged"])) {
    return failure("`git restore` without `--staged` discards work")
  }
  return success([gitRestoreEffect({ cwd: args.cwd, paths: textsOf(args.paths), staged: true })])
}

@capabilities(fileRead)
def gitBranchRule(words: Word[], cwd: string, redirects: Redirect[]): Result<SimpleRule> {
  """
  Classify `git branch`: a listing, a new branch, or a delete.
  """
  const args = gitArgsFor("branch", words, GIT_BRANCH_FLAGS, "names", cwd)?
  const effects = branchEffects(args)?
  // `--merged` takes the next word as the branch to compare with, so it
  // is written last, right before that word.
  const others = [flag for flag in args.plain if !MERGED_FLAGS.includes(flag)]
  const merged = [flag for flag in args.plain if MERGED_FLAGS.includes(flag)]
  const ordered: GitArgs = { ...args, plain: [...others, ...merged] }
  return success({ effects: effects, command: gitCommand(["branch"], ordered, "names", redirects) })
}

// `git branch -v newname` creates a branch, so a listing flag beside a
// name has no rule. Only `--merged` and `--no-merged` take a word.
def branchEffects(args: GitArgs): Result<Effect[]> {
  const cwd = args.cwd
  const names = textsOf(args.names)
  if (hasAny(args.plain, DELETE_FLAGS)) {
    if (args.plain.length != 1 || !countFits(names.length, AT_LEAST_ONE)) {
      return failure("`git branch -d` takes branch names and no other flag")
    }
    return success([gitBranchDeleteEffect({ cwd: cwd, branch: name, force: false }) for name in names])
  }
  if (args.plain.length > 0 || names.length == 0) {
    const allowed = if (hasAny(args.plain, MERGED_FLAGS)) then AT_MOST_ONE else NONE
    if (!countFits(names.length, allowed)) {
      return failure("a listing `git branch` takes ${describeCount(allowed, "name")}")
    }
    return success([gitBranchListEffect({ cwd: cwd })])
  }
  if (!countFits(names.length, EXACTLY_ONE)) {
    return failure("`git branch` takes one new branch name here, and a start point has no rule")
  }
  return success([gitBranchCreateEffect({ cwd: cwd, branch: names[0] })])
}

@capabilities(fileRead)
def gitStashRule(words: Word[], cwd: string, redirects: Redirect[]): Result<SimpleRule> {
  """
  Classify `git stash`: push, pop, or list.
  """
  const args = gitArgsFor("stash", words, GIT_STASH_FLAGS, "names", cwd)?
  if (!countFits(args.names.length, AT_MOST_ONE)) {
    return failure("`git stash` with these arguments has no rule")
  }
  const action = firstText(args.names, STASH_PUSH)
  const effects = stashEffects(cwd, action, flagValues(args.values, MESSAGE_FLAGS))?
  // The action is written right after `stash`, before the flags. After
  // them, git would read it as a path to stash.
  const flagsOnly: GitArgs = { ...args, names: [] }
  return success({ effects: effects, command: gitCommand(["stash", action], flagsOnly, "names", redirects) })
}

// The payload has one message. `-m a --message b` gives git two, and
// `splitFlags` allows one of each spelling, so the count is checked here.
def stashEffects(cwd: string, action: string, messages: string[]): Result<Effect[]> {
  if (!countFits(messages.length, AT_MOST_ONE)) {
    return failure("`git stash` takes one message")
  }
  if (action == STASH_PUSH) {
    const message = if (messages.length == 0) then "" else messages[0]
    return success([gitStashPushEffect({ cwd: cwd, message: message })])
  }
  if (messages.length > 0) {
    return failure("`git stash ${action}` takes no message")
  }
  return match(action) {
    STASH_LIST => success([gitStashListEffect({ cwd: cwd })])
    STASH_POP => success([gitStashPopEffect({ cwd: cwd })])
    _ => failure("no rule for `git stash ${action}`")
  }
}

// `-a` stages every tracked change before the commit, so it asks for the
// add as well. The add's `all: true` describes staging everything, which
// is slightly more than `-a` does, so the approval covers what happens.
@capabilities(fileRead)
def gitCommitRule(words: Word[], cwd: string, redirects: Redirect[]): Result<SimpleRule> {
  """
  Classify `git commit -m`, with or without `-a`.
  """
  const args = gitArgsFor("commit", words, GIT_COMMIT_FLAGS, "names", cwd)?
  const messages = flagValues(args.values, MESSAGE_FLAGS)
  // The payload has one message. `-m a --message b` gives git two.
  if (!countFits(messages.length, EXACTLY_ONE) || args.names.length > 0) {
    return failure("`git commit` needs one `-m` and no paths")
  }
  const commit = gitCommitEffect({ cwd: cwd, message: messages[0] })
  const built = gitCommand(["commit"], args, "names", redirects)
  if (hasAny(args.plain, ["a", "--all"])) {
    const add = gitAddEffect({ cwd: cwd, paths: [], all: true })
    return success({ effects: [add, commit], command: built })
  }
  return success({ effects: [commit], command: built })
}

@capabilities(fileRead)
def gitCheckoutRule(words: Word[], cwd: string, redirects: Redirect[]): Result<SimpleRule> {
  """
  Classify `git checkout <ref>` and `git checkout -b <name>`.
  """
  // `-b` is looked for first: its word is a new branch name, and sorting
  // it by the disk would refuse `git checkout -b src` beside a `src` folder.
  const creating = [word for word in words if word.tag == "flag" && word.flagName == "-b"].length > 0
  if (creating) {
    return gitCheckoutNewBranch(words, cwd, redirects)
  }
  return gitCheckoutRef(words, cwd, redirects)
}

@capabilities(fileRead)
def gitCheckoutNewBranch(words: Word[], cwd: string, redirects: Redirect[]): Result<SimpleRule> {
  const args = gitArgsFor("checkout", words, GIT_NEW_BRANCH_FLAGS, "names", cwd)?
  if (!countFits(args.names.length, EXACTLY_ONE)) {
    return failure("`git checkout -b` takes one new branch name here, and a start point has no rule")
  }
  const effect = gitSwitchEffect({ cwd: cwd, branch: args.names[0].text, create: true })
  return success({ effects: [effect], command: gitCommand(["checkout"], args, "names", redirects) })
}

// `git checkout <word>` discards the changes to a file when the word is
// not a ref: git then reads it as a pathspec, so `'*.py'` matches every
// Python file. The word is sorted like a log's, and exactly one ref and
// no path is allowed, so a word that names a file has no rule. The
// command that runs ends in `--`, so a word that is not a real ref makes
// git fail with "invalid reference" and no file is touched.
@capabilities(fileRead)
def gitCheckoutRef(words: Word[], cwd: string, redirects: Redirect[]): Result<SimpleRule> {
  const args = gitArgsFor("checkout", words, NO_GIT_FLAGS, "refsAndPaths", cwd)?
  if (!countFits(args.refs.length, EXACTLY_ONE) || !countFits(args.paths.length, NONE)) {
    return failure("`git checkout` takes one branch or commit here, and a path would discard its changes")
  }
  const effect = gitCheckoutEffect({ cwd: cwd, target: args.refs[0].text, force: false })
  return success({ effects: [effect], command: gitCommand(["checkout"], args, "refsAndPaths", redirects) })
}

static const GIT_WORD: LiteralWord = { tag: "literal", text: "git" }
static const END_OF_FLAGS_WORD: FlagWord = { tag: "flag", flagName: "--" }

// The one place a git command is assembled. It returns the parser's own
// type, so the text that runs is printed by `astToBash` like every other
// narrow command, and that printer quotes whatever needs quoting.
//
// The flags are built from what `splitFlags` checked, not copied from the
// model's text. The refs, names, and paths are the model's own words,
// with their quoting. The `--` is written whenever the words are refs or
// paths, including when there are no paths: `git checkout main` runs as
// `git checkout main --`.
def gitCommand(subcommand: string[], args: GitArgs, kind: GitWords, redirects: Redirect[]): SimpleCommand {
  """
  Build the git command to run: the fixed flags, the subcommand, the checked flags, and the words in the order git reads them.
  """
  const separator: Word[] = if (kind == "names") then [] else [END_OF_FLAGS_WORD]
  return {
    tag: "simpleCommand",
    assignments: [],
    command: GIT_WORD,
    args: [
      ...fixedFlagWords(),
      ...[literalWordOf(word) for word in subcommand],
      ...flagWords(args.plain, args.values),
      ...wordsOf(args.refs),
      ...wordsOf(args.names),
      ...separator,
      ...wordsOf(args.paths),
    ],
    redirects: redirects
  }
}

// `(git rev-parse --show-toplevel >/dev/null && git diff ...)`.
// When git sees no work tree, `rev-parse` fails and the diff never runs:
// "not a git repository" outside one, and "must be run in a work tree"
// in a bare repository or inside a `.git` folder. `--is-inside-work-tree`
// would not do, because it prints `false` and exits 0 in those two. The
// check runs when the command runs, and git answers it: looking for a
// `.git` folder while planning would be a second guess about what git
// will do. The parentheses make the pair one unit, so it can be a stage
// of a pipe.
def insideRepository(diff: SimpleCommand): Command {
  """
  Wrap a git diff so it runs only where git sees a work tree.
  """
  const check: SimpleCommand = {
    tag: "simpleCommand",
    assignments: [],
    command: GIT_WORD,
    args: [...fixedFlagWords(), literalWordOf("rev-parse"), { tag: "flag", flagName: "--show-toplevel" }],
    redirects: [{ tag: "redirect", op: ">", target: { tag: "path", text: "/dev/null" } }]
  }
  return { tag: "parens", command: { tag: "and", left: check, right: diff } }
}

/* The flags every git command starts with, the same list the git tools
  use, as words. */
def fixedFlagWords(): Word[] {
  const flags: string[] = _gitHardeningFlags()
  return [fixedWord(text) for text in flags]
}

def fixedWord(text: string): Word {
  if (text.startsWith("-")) {
    return { tag: "flag", flagName: text }
  }
  return literalWordOf(text)
}

def literalWordOf(text: string): Word {
  return { tag: "literal", text: text }
}

// Several spellings of a flag run as one: `-n5`, `-n 5`, `-5`, and
// `--max-count=5` were all read by `splitFlags`, and each is written back
// from what it read.
def flagWords(plain: string[], values: FlagValue[]): Word[] {
  """
  Build flag words from the flags `splitFlags` checked.
  """
  let valued: Word[] = []
  for (entry in values) {
    valued = [...valued, ...valuedFlagWords(entry)]
  }
  return [...[plainFlagWord(name) for name in plain], ...valued]
}

/* A plain flag as the table spells it: a letter (`p`), a long name
  (`--oneline`), or a long name with its value (`--porcelain=v1`). */
def plainFlagWord(name: string): Word {
  if (!name.startsWith("--")) {
    return { tag: "flag", flagName: "-${name}" }
  }
  const equals = name.indexOf("=")
  if (equals < 0) {
    return { tag: "flag", flagName: name }
  }
  return { tag: "flag", flagName: name.slice(0, equals), flagValue: name.slice(equals + 1) }
}

// A letter's value is written as a quoted word of its own. A literal
// word would print bare when its text allows, and bash would then expand
// a leading `~` in a commit message.
def valuedFlagWords(entry: FlagValue): Word[] {
  if (entry.flag.startsWith("--")) {
    return [{ tag: "flag", flagName: entry.flag, flagValue: entry.value }]
  }
  return [{ tag: "flag", flagName: "-${entry.flag}" }, { tag: "singleQuoted", text: entry.value }]
}

def wordsOf(words: GitWord[]): Word[] {
  return [entry.word for entry in words]
}

def textsOf(words: GitWord[]): string[] {
  return [entry.text for entry in words]
}

def firstText(words: GitWord[], fallback: string): string {
  if (words.length == 0) {
    return fallback
  }
  return words[0].text
}

def hasAny(items: string[], wanted: string[]): boolean {
  return [item for item in items if wanted.includes(item)].length > 0
}

/* The values given for any of these spellings of a flag. */
def flagValues(values: FlagValue[], flags: string[]): string[] {
  return [entry.value for entry in values if flags.includes(entry.flag)]
}

// ---------------------------------------------------------------------------
// gh
//
// A `gh` read raises the std::github read effect the typed tool raises for
// the same data, and safeBash writes the gh command that runs, with the
// repository spelled out. Only the reads in GH_VERBS are owned. Every other
// gh subcommand, every write included, asks std::exec.
// ---------------------------------------------------------------------------

/** How many items a gh list reads when no --limit is given. */
static const GH_DEFAULT_LIMIT = 30

/** perPage 0: every page gh fetches for one pull request or issue. */
static const GH_EVERY_PAGE = 0
static const GH_FIRST_PAGE = 1

static const GH_WORD: LiteralWord = { tag: "literal", text: "gh" }
static const GH_HOST_GITHUB: Assignment = { tag: "assignment", name: "GH_HOST", value: { tag: "literal", text: "github.com" } }

/** A pull request or issue a gh command names: a number, and the pair a
  URL gave, or "" for both when it was a bare number. */
type GhTarget = {
  number: number;
  owner: string;
  repo: string
}

/** The repository a gh command acts on, and the folder whose origin remote
  names it when the command itself does not. */
type GhResolved = {
  owner: string;
  repo: string;
  lookup: string | null
}

/** What one gh command asks, and the gh command safeBash runs for it. */
type GhRule = {
  effects: Effect[];
  command: SimpleCommand
}

/** What a row's --repo means.
 - "base": the repository the command acts on. Optional; when it is
   absent the pair comes from the target URL, from `origin`, or from a
   lookup. Written as `--repo github.com/OWNER/REPO`.
 - "filter": a search filter. Required, exactly once. Written as
   `--repo OWNER/REPO`, because gh search does not read a host there,
   with `GH_HOST=github.com` before the command to pin the host. */
type GhRepoFlag = "base" | "filter"

type GhVerb = {
  flags: FlagSpec;
  /** "pull" or "issues" when the subcommand takes one number or URL. */
  target: "pull" | "issues" | "none";
  /** How many plain words it takes besides the target: search words. */
  words: CountRange;
  repoFlag: GhRepoFlag;
  /** The values --state takes here; [] when the row has no --state. */
  states: string[];
  /** The --json field names gh accepts here; [] when it has no --json. */
  jsonFields: string[];
  /** The --json fields with no rule here, because each reads more than
    this subcommand's effect says. */
  heavyFields: string[]
}

static const GH_REPO_FLAGS: string[] = ["R", "--repo"]
static const GH_JSON_FLAGS: string[] = ["--json"]

/** The flags whose value gh splits at commas into a list. */
static const GH_LIST_FLAGS: string[] = ["--label", "--match"]

// The --json fields of gh 2.88.1, from the JSON FIELDS block of each
// subcommand's --help.
static const GH_PR_FIELDS: string[] = [
  "additions", "assignees", "author", "autoMergeRequest", "baseRefName", "baseRefOid", "body",
  "changedFiles", "closed", "closedAt", "closingIssuesReferences", "comments", "commits",
  "createdAt", "deletions", "files", "fullDatabaseId", "headRefName", "headRefOid",
  "headRepository", "headRepositoryOwner", "id", "isCrossRepository", "isDraft", "labels",
  "latestReviews", "maintainerCanModify", "mergeCommit", "mergeStateStatus", "mergeable",
  "mergedAt", "mergedBy", "milestone", "number", "potentialMergeCommit", "projectCards",
  "projectItems", "reactionGroups", "reviewDecision", "reviewRequests", "reviews", "state",
  "statusCheckRollup", "title", "updatedAt", "url",
]
static const GH_CHECK_FIELDS: string[] = [
  "bucket", "completedAt", "description", "event", "link", "name", "startedAt", "state", "workflow",
]
static const GH_ISSUE_FIELDS: string[] = [
  "assignees", "author", "body", "closed", "closedAt", "closedByPullRequestsReferences",
  "comments", "createdAt", "id", "isPinned", "labels", "milestone", "number", "projectCards",
  "projectItems", "reactionGroups", "state", "stateReason", "title", "updatedAt", "url",
]
static const GH_SEARCH_ISSUE_FIELDS: string[] = [
  "assignees", "author", "authorAssociation", "body", "closedAt", "commentsCount", "createdAt",
  "id", "isLocked", "isPullRequest", "labels", "number", "repository", "state", "title",
  "updatedAt", "url",
]

// The gh reads safeBash recognizes, keyed by the group and subcommand. The
// flags are an allowlist. A flag that changes how a result is shown, or
// shows less of it, is listed. Left out on purpose, so a line using one
// asks std::bash:
// - `--web` opens a browser.
// - `--jq`/`-q` run a jq program that can read the environment, and
//   `--template`/`-t` is another small language. `--json` covers the need.
// - `--search` on a list command takes a search query, which can name
//   another repository or contradict `--state`. `gh search issues` covers it.
// - `--watch` keeps `gh pr checks` running until the checks finish.
// - `--owner` widens `gh search issues` to every repository of an owner.
// - The list fields in `heavyFields`, which read the comments, files, or
//   checks of every pull request listed.
static const GH_VERBS: Record<string, GhVerb> = {
  "pr view": {
    flags: { plain: ["c", "--comments"], valued: [...GH_REPO_FLAGS, ...GH_JSON_FLAGS], optionsFirst: false },
    target: "pull",
    words: NONE,
    repoFlag: "base",
    states: [],
    jsonFields: GH_PR_FIELDS,
    heavyFields: []
  },
  "pr diff": {
    flags: { plain: ["--name-only", "--patch"], valued: [...GH_REPO_FLAGS, "--color", "e", "--exclude"], optionsFirst: false },
    target: "pull",
    words: NONE,
    repoFlag: "base",
    states: [],
    jsonFields: [],
    heavyFields: []
  },
  "pr checks": {
    flags: { plain: ["--required"], valued: [...GH_REPO_FLAGS, ...GH_JSON_FLAGS], optionsFirst: false },
    target: "pull",
    words: NONE,
    repoFlag: "base",
    states: [],
    jsonFields: GH_CHECK_FIELDS,
    heavyFields: []
  },
  "pr list": {
    flags: {
      plain: ["d", "--draft"],
      valued: [...GH_REPO_FLAGS, ...GH_JSON_FLAGS, "s", "--state", "B", "--base", "L", "--limit", "A", "--author", "a", "--assignee", "l", "--label", "H", "--head"],
      optionsFirst: false
    },
    target: "none",
    words: NONE,
    repoFlag: "base",
    states: ["open", "closed", "merged", "all"],
    jsonFields: GH_PR_FIELDS,
    heavyFields: ["comments", "commits", "files", "reviews", "latestReviews", "statusCheckRollup"]
  },
  "issue view": {
    flags: { plain: ["c", "--comments"], valued: [...GH_REPO_FLAGS, ...GH_JSON_FLAGS], optionsFirst: false },
    target: "issues",
    words: NONE,
    repoFlag: "base",
    states: [],
    jsonFields: GH_ISSUE_FIELDS,
    heavyFields: []
  },
  "issue list": {
    flags: {
      plain: [],
      valued: [...GH_REPO_FLAGS, ...GH_JSON_FLAGS, "s", "--state", "l", "--label", "L", "--limit", "A", "--author", "a", "--assignee", "--mention", "m", "--milestone"],
      optionsFirst: false
    },
    target: "none",
    words: NONE,
    repoFlag: "base",
    states: ["open", "closed", "all"],
    jsonFields: GH_ISSUE_FIELDS,
    heavyFields: ["comments"]
  },
  "search issues": {
    flags: {
      plain: ["--include-prs"],
      valued: [...GH_REPO_FLAGS, ...GH_JSON_FLAGS, "--state", "--label", "--author", "--assignee", "L", "--limit", "--sort", "--order", "--match"],
      optionsFirst: false
    },
    target: "none",
    words: AT_LEAST_ONE,
    repoFlag: "filter",
    states: ["open", "closed"],
    jsonFields: GH_SEARCH_ISSUE_FIELDS,
    heavyFields: []
  }
}

/** Each short flag the gh tables list, and its long name. No letter means
  two things across the rows (checked against gh 2.88.1's --help). */
static const GH_LONG_NAMES: Record<string, string> = {
  R: "--repo",
  L: "--limit",
  s: "--state",
  l: "--label",
  B: "--base",
  A: "--author",
  a: "--assignee",
  H: "--head",
  m: "--milestone",
  e: "--exclude",
  c: "--comments",
  d: "--draft",
  X: "--method"
}

/** The reads of one pull request or issue that a view can ask for. */
type GhRead = "get" | "files" | "comments" | "reviews" | "checks"

/** The pr view --json fields that read more than the pull request
  itself. A field not listed here reads "get". That includes `commits`
  and `projectItems`, although the typed ghPrGet returns neither: no
  std::github effect covers them, and `pr view N --json commits` is the
  spelling a model uses to list a pull request's commits. `pr list` has no
  rule for `commits`, because there it reads every listed pull request. */
static const PR_VIEW_FIELD_READS: Record<string, GhRead> = {
  files: "files",
  comments: "comments",
  reviews: "reviews",
  latestReviews: "reviews",
  statusCheckRollup: "checks"
}
static const ISSUE_VIEW_FIELD_READS: Record<string, GhRead> = { comments: "comments" }

// What a view with no --json fetches, from gh 2.88.1's source. `pr view`
// asks for comments, reviews, and statusCheckRollup with the pull request
// (defaultFields in pkg/cmd/pr/view/view.go), with or without --comments.
// `issue view` asks for lastComment, or every comment with --comments
// (pkg/cmd/issue/view/view.go).
static const PR_VIEW_PLAIN_READS: GhRead[] = ["get", "comments", "reviews", "checks"]
static const ISSUE_VIEW_PLAIN_READS: GhRead[] = ["get", "comments"]

/** The order a view's effects are raised in, whatever order the fields came in. */
static const GH_READ_ORDER: GhRead[] = ["get", "files", "comments", "reviews", "checks"]

/* The row a gh command names with its first two words, or null. A flag or
  a quoted word in either place is no row: `gh -R o/r pr view 1` keeps
  asking std::exec. */
def ghVerbKey(command: SimpleCommand): string | null {
  const args = command.args
  if (args.length < 2) {
    return null
  }
  const group = args[0]
  const sub = args[1]
  if (group.tag != "literal" || sub.tag != "literal") {
    return null
  }
  const key = "${group.text} ${sub.text}"
  if (GH_VERBS[key] == null) {
    return null
  }
  return key
}

def ghOwns(command: SimpleCommand): boolean {
  return ghVerbKey(command) != null || ghIsApi(command)
}

/* `gh api`, whose rule reads a path where the other rows read a subcommand.
  The word's text decides, not its tag: gh reads `'api'` as `api`, and a
  quoted spelling that fell through to std::exec would be approved by a
  saved rule for `gh` and `api`, POSTs included. */
def ghIsApi(command: SimpleCommand): boolean {
  if (command.args.length == 0) {
    return false
  }
  const text = literalWordText(command.args[0])
  if (text is success(written)) {
    return written == "api"
  }
  return false
}

// Bash expands a glob after the plan is made, so on a line that would ask
// std::exec, `*` in a folder holding a file named `--jq=env.GITHUB_TOKEN`
// becomes that flag. Checked before ghHasJq, which cannot see through it.
def ghHasGlob(command: SimpleCommand): boolean {
  for (word in command.args) {
    if (word.tag == "glob") {
      return true
    }
    if (word is { tag: "flag" } && word.valueIsGlob == true) {
      return true
    }
  }
  return false
}

// gh's --jq runs a jq program inside gh, and jq reads the environment
// (`env.GITHUB_TOKEN`). The check looks at what gh will see: a quoted
// `'--jq'` is a quoted word to the parser and the flag to gh. A word with
// no literal text, such as a variable, is skipped, because splitFlags or
// execArgs refuses it; a glob was refused by ghHasGlob.
def ghHasJq(command: SimpleCommand): boolean {
  for (word in command.args) {
    if (isJqFlag(ghArgText(word))) {
      return true
    }
  }
  return false
}

def ghArgText(word: Word): string {
  if (word is { tag: "flag" }) {
    return word.flagName
  }
  const text = literalWordText(word)
  if (text is success(written)) {
    return written
  }
  return ""
}

/* `--jq`, `--jq=x`, or a group of short flags with `q` in it (`-wq`). */
def isJqFlag(text: string): boolean {
  if (text == "--jq" || text.startsWith("--jq=")) {
    return true
  }
  return text.startsWith("-") && !text.startsWith("--") && text.includes("q")
}

def ghEffects(command: SimpleCommand, cwd: string, origin: GhRepo | null): Result<GhRule> {
  """
  Classify a gh read: the std::github effects it raises and the gh command safeBash runs for it.
  """
  if (ghIsApi(command)) {
    return ghApiRule(command.args.slice(1), cwd, origin, command.redirects)
  }
  const key = ghVerbKey(command)
  if (key == null) {
    return failure("no rule for this gh command")
  }
  const verb: GhVerb = GH_VERBS[key]
  const split = ghLongFlags(splitFlags("gh", gitWordsCommand(command.args.slice(2)), verb.flags)?)?
  let words = split.positionals
  let target: GhTarget | null = null
  if (verb.target != "none") {
    if (words.length == 0) {
      return failure("`gh ${key}` needs a number or a URL")
    }
    const text = literalWordText(words[0])?
    target = try _ghParseTarget(text, verb.target)?
    words = words.slice(1)
  }
  if (!countFits(words.length, verb.words)) {
    return failure(ghWordsMessage(key, verb))
  }
  const searchWords = ghSearchWords(words)?
  ghCheckValues(key, verb, split.values)?
  const repo = ghRepoFor(verb, split.values, target, cwd, origin)?
  const effects = ghPayloads(key, verb, split, target, searchWords, repo)?
  return success({ effects: effects, command: ghCommand(key, verb, split, target, words, repo, command.redirects) })
}

/* The search words' text. ghCommand writes the words back as the model
  wrote them, and bash expands a leading `~` in an unquoted word, so the
  query would hold a home folder the payload does not show. */
def ghSearchWords(words: Word[]): Result<string[]> {
  const texts = literalWords(words)?
  for (word, index in words) {
    if (tildeModeFor(word) == "expand" && texts[index].startsWith("~")) {
      return failure("a gh search word starts with `~`, which bash would expand")
    }
  }
  return success(texts)
}

def ghWordsMessage(key: string, verb: GhVerb): string {
  if (verb.words.least > 0) {
    return "`gh ${key}` needs words to search for"
  }
  if (verb.target == "none") {
    return "`gh ${key}` takes no words besides its flags"
  }
  return "`gh ${key}` takes one number or URL and no other words"
}

/* A flag's long name. A short letter with no entry in GH_LONG_NAMES fails,
  so a letter added to a table without one cannot pass the check below
  under its second spelling. */
def ghLongName(flag: string): Result<string> {
  if (flag.startsWith("--")) {
    return success(flag)
  }
  const long = GH_LONG_NAMES[flag]
  if (long == null) {
    return failure("gh's `-${flag}` has no long name, so a second spelling of it could not be caught")
  }
  return success(long)
}

/** The same flags with every short name replaced by its long name. Fails
  when a long name then appears twice, as in `-L 5 --limit 500`, where a
  payload built from one value would not say what gh does with the other. */
def ghLongFlags(split: SplitArgs): Result<SplitArgs> {
  let values: FlagValue[] = []
  for (entry in split.values) {
    values.push({ flag: ghLongName(entry.flag)?, value: entry.value })
  }
  for (entry in values) {
    if ([other for other in values if other.flag == entry.flag].length > 1) {
      return failure("gh takes `${entry.flag}` only once")
    }
  }
  let plain: string[] = []
  for (name in split.plain) {
    const long = ghLongName(name)?
    if (!plain.includes(long)) {
      plain.push(long)
    }
  }
  return success({ plain: plain, values: values, positionals: split.positionals })
}

/* The checks on flag values that the payload relies on. */
def ghCheckValues(key: string, verb: GhVerb, values: FlagValue[]): Result {
  for (entry in values) {
    // gh writes filter values into a search query, where a `repo:` widens it.
    if (_ghHasScopeQualifier(entry.value)) {
      return failure("the value of `${entry.flag}` names another repository")
    }
    // gh reads a list flag such as --label as one CSV line, where a quote
    // or a line break changes how the value splits. No flag needs either.
    if (entry.value.includes("\"") || entry.value.includes("\n") || entry.value.includes("\r")) {
      return failure("the value of `${entry.flag}` holds a quote or a line break")
    }
    if (GH_LIST_FLAGS.includes(entry.flag) && entry.value.split(",").includes("")) {
      return failure("the value of `${entry.flag}` has an empty item")
    }
  }
  const states = flagValues(values, ["--state"])
  if (states.length > 0 && !verb.states.includes(states[0])) {
    return failure("`gh ${key}` takes --state ${verb.states.join(", ")}, not `${states[0]}`")
  }
  for (fields in flagValues(values, ["--json"])) {
    for (field in fields.split(",")) {
      if (!verb.jsonFields.includes(field)) {
        return failure("`gh ${key}` has no --json field `${field}`")
      }
      if (verb.heavyFields.includes(field)) {
        return failure("`gh ${key} --json ${field}` reads more than a list")
      }
    }
  }
  return success(null)
}

/* The value of a flag, or the fallback when it was not given. */
def ghValueOf(values: FlagValue[], flag: string, fallback: string): string {
  const given = flagValues(values, [flag])
  if (given.length == 0) {
    return fallback
  }
  return given[0]
}

/** How many items a list reads: --limit, from 1 to the most GitHub returns
  in one page, or gh's default. */
def ghLimit(values: FlagValue[]): Result<number> {
  const given = flagValues(values, ["--limit"])
  if (given.length == 0) {
    return success(GH_DEFAULT_LIMIT)
  }
  const limit = if (isDigits(given[0])) then digitsValue(given[0]) else 0
  if (limit < 1 || limit > GITHUB_MAX_PER_PAGE) {
    return failure("gh's `--limit` takes a number from 1 to ${GITHUB_MAX_PER_PAGE}")
  }
  return success(limit)
}

/* The repository a gh command acts on. For a `base` row the model's
  --repo or URL wins, then `origin`, and with neither the pair is left for
  a lookup in `cwd`. A `filter` row must name it with --repo. */
def ghRepoFor(verb: GhVerb, values: FlagValue[], target: GhTarget | null, cwd: string, origin: GhRepo | null): Result<GhResolved> {
  const given = flagValues(values, ["--repo"])
  if (verb.repoFlag == "filter") {
    if (given.length == 0) {
      return failure("gh search needs --repo OWNER/REPO, or it searches all of GitHub")
    }
    const pair = try _ghParseRepoFlag(given[0])?
    return success({ owner: pair.owner, repo: pair.repo, lookup: null })
  }
  let named: GhRepo | null = null
  if (given.length > 0) {
    const pair = try _ghParseRepoFlag(given[0])?
    named = { owner: pair.owner, repo: pair.repo }
  }
  if (target != null && target.owner != "") {
    if (named != null && (named.owner != target.owner || named.repo != target.repo)) {
      return failure("the URL and --repo name two different repositories")
    }
    return success({ owner: target.owner, repo: target.repo, lookup: null })
  }
  if (named != null) {
    return success({ owner: named.owner, repo: named.repo, lookup: null })
  }
  if (origin != null) {
    return success({ owner: origin.owner, repo: origin.repo, lookup: null })
  }
  return success({ owner: "", repo: "", lookup: cwd })
}

/* The one place that names the gh rows, one arm per row, as gitPayloads
  does for git. */
def ghPayloads(key: string, verb: GhVerb, split: SplitArgs, target: GhTarget | null, words: string[], repo: GhResolved): Result<Effect[]> {
  const values = split.values
  const number = if (target == null) then 0 else target.number
  const state = ghValueOf(values, "--state", "open")
  const limit = ghLimit(values)?
  const fields = ghJsonFields(values)
  return match(key) {
    "pr view" => success([ghPullRead(read, number, repo) for read in ghViewReads(fields, PR_VIEW_FIELD_READS, PR_VIEW_PLAIN_READS)])
    "pr diff" => success([{ name: "std::github::prDiff", payload: ghNumberPayload(number, repo), lookup: repo.lookup }])
    "pr checks" => success([ghPullRead("checks", number, repo)])
    "pr list" => success([
      {
        name: "std::github::prList",
        payload: {
          owner: repo.owner,
          repo: repo.repo,
          state: state,
          base: ghValueOf(values, "--base", ""),
          perPage: limit,
          page: GH_FIRST_PAGE
        },
        lookup: repo.lookup
      }
    ])
    "issue view" => success(ghIssueReads(ghViewReads(fields, ISSUE_VIEW_FIELD_READS, ISSUE_VIEW_PLAIN_READS), number, repo))
    "issue list" => success([
      {
        name: "std::github::issueList",
        payload: {
          owner: repo.owner,
          repo: repo.repo,
          state: state,
          labels: ghListValue(values, "--label"),
          perPage: limit,
          page: GH_FIRST_PAGE
        },
        lookup: repo.lookup
      }
    ])
    "search issues" => ghSearchEffects(words, split, limit, repo)
    _ => failure("no rule for `gh ${key}`")
  }
}

// The payload's query is the query gh sends, so a handler that reads it
// sees the filter flags and gh's own `type:issue`. GitHub search unions
// repository qualifiers, so neither the words nor a filter value may name
// another repository; ghCheckValues checks the values.
def ghSearchEffects(words: string[], split: SplitArgs, limit: number, repo: GhResolved): Result<Effect[]> {
  if (_ghHasScopeQualifier(words.join(" "))) {
    return failure("the search words name a repo:, org:, or user:; pass --repo OWNER/REPO instead")
  }
  const values = split.values
  const kind: string[] = if (split.plain.includes("--include-prs")) then [] else ["issue"]
  const qualifiers: Record<string, string[]> = {
    assignee: flagValues(values, ["--assignee"]),
    author: flagValues(values, ["--author"]),
    "in": ghListValue(values, "--match"),
    label: ghListValue(values, "--label"),
    repo: ["${repo.owner}/${repo.repo}"],
    state: flagValues(values, ["--state"]),
    "type": kind
  }
  const query = try _ghSearchQuery(words, qualifiers)?
  return success([
    {
      name: "std::github::issueSearch",
      payload: { owner: repo.owner, repo: repo.repo, query: query, perPage: limit, page: GH_FIRST_PAGE },
      lookup: repo.lookup
    }
  ])
}

/* The --json field names, or null when the command has no --json. */
def ghJsonFields(values: FlagValue[]): string[] | null {
  const given = flagValues(values, ["--json"])
  if (given.length == 0) {
    return null
  }
  return given[0].split(",")
}

/* The items of a flag gh splits at commas, or [] when it was not given. */
def ghListValue(values: FlagValue[], flag: string): string[] {
  const given = flagValues(values, [flag])
  if (given.length == 0) {
    return []
  }
  return given[0].split(",")
}

/* A view's distinct reads, in GH_READ_ORDER. */
def ghViewReads(fields: string[] | null, table: Record<string, GhRead>, plain: GhRead[]): GhRead[] {
  if (fields == null) {
    return plain
  }
  const wanted: GhRead[] = [table[field] ?? "get" for field in fields]
  return [read for read in GH_READ_ORDER if wanted.includes(read)]
}

def ghNumberPayload(number: number, repo: GhResolved): GhNumberPayload {
  return { owner: repo.owner, repo: repo.repo, number: number }
}

def ghPagedPayload(number: number, repo: GhResolved): GhPagedPayload {
  return { owner: repo.owner, repo: repo.repo, number: number, perPage: GH_EVERY_PAGE, page: GH_FIRST_PAGE }
}

def ghPullRead(read: GhRead, number: number, repo: GhResolved): Effect {
  return match(read) {
    "get" => ({ name: "std::github::prGet", payload: ghNumberPayload(number, repo), lookup: repo.lookup })
    "files" => ({ name: "std::github::prFiles", payload: ghPagedPayload(number, repo), lookup: repo.lookup })
    "comments" => ({ name: "std::github::issueCommentList", payload: ghPagedPayload(number, repo), lookup: repo.lookup })
    "reviews" => ({ name: "std::github::prReviewList", payload: ghPagedPayload(number, repo), lookup: repo.lookup })
    "checks" => ({ name: "std::github::prChecks", payload: ghPagedPayload(number, repo), lookup: repo.lookup })
  }
}

// `gh issue view N` shows a pull request when N is one, and the number
// cannot tell which it is before gh runs. The typed ghIssueGet refuses a
// pull request, so a read of the issue itself asks prGet as well.
def ghIssueReads(reads: GhRead[], number: number, repo: GhResolved): Effect[] {
  let effects: Effect[] = []
  for (read in reads) {
    if (read == "comments") {
      effects.push({ name: "std::github::issueCommentList", payload: ghPagedPayload(number, repo), lookup: repo.lookup })
    } else {
      effects.push({ name: "std::github::issueGet", payload: ghNumberPayload(number, repo), lookup: repo.lookup })
      effects.push({ name: "std::github::prGet", payload: ghNumberPayload(number, repo), lookup: repo.lookup })
    }
  }
  return effects
}

// The one place a gh command is assembled, from checked data, as
// gitCommand does for git. The flags are rebuilt from what ghLongFlags
// returned, never copied from the model's text, and --repo always comes
// last, naming the repository the payloads name. A `base` row's --repo
// names the host. gh search reads no host in --repo and searches gh's
// default host, so a `filter` row sets GH_HOST for that one command. On a
// first pass with a lookup pending the pair is empty; that text never runs.
def ghCommand(key: string, verb: GhVerb, split: SplitArgs, target: GhTarget | null, words: Word[], repo: GhResolved, redirects: Redirect[]): SimpleCommand {
  """
  Build the gh command to run: the subcommand, the number, the search words, the checked flags, and --repo.
  """
  const numberWords: Word[] = if (target == null) then [] else [literalWordOf("${target.number}")]
  const pair = "${repo.owner}/${repo.repo}"
  const repository = if (verb.repoFlag == "base") then "github.com/${pair}" else pair
  const host: Assignment[] = if (verb.repoFlag == "filter") then [GH_HOST_GITHUB] else []
  return {
    tag: "simpleCommand",
    assignments: host,
    command: GH_WORD,
    args: [
      ...[literalWordOf(part) for part in key.split(" ")],
      ...numberWords,
      ...words,
      ...flagWords(split.plain, [entry for entry in split.values if entry.flag != "--repo"]),
      { tag: "flag", flagName: "--repo" },
      literalWordOf(repository),
    ],
    redirects: redirects
  }
}

// `gh api` is the one gh command where the model writes the web request
// itself. A GET of six paths has a rule (_ghParseApiPath in
// lib/stdlib/safeBashGh.ts holds them): a pull request, its files,
// reviews, or review comments, an issue, or its comments. gh sends a GET
// unless told otherwise, and switches to POST as soon as it is given a
// field, so the only flag allowed is -X/--method GET. Left out:
// -f/-F/--field/--raw-field/--input (they POST), --paginate and --slurp
// (no bound on the requests), -H/--header, --hostname (safeBash writes its
// own), -i/--include, --verbose, -p/--preview, --cache, --silent, and
// --jq/--template.
static const GH_API_FLAGS: FlagSpec = { plain: [], valued: ["X", "--method"], optionsFirst: false }

static const GH_API_HOST: Word[] = [{ tag: "flag", flagName: "--hostname" }, { tag: "literal", text: "github.com" }]
static const GH_API_GET: Word[] = [{ tag: "flag", flagName: "--method" }, { tag: "literal", text: "GET" }]

/** One of the six `gh api` reads, as _ghParseApiPath returns it. owner and
  repo are "" when the path used {owner} and {repo}. */
type GhApiRead = {
  endpoint: "prGet" | "prFiles" | "prReviewList" | "prReviewCommentList" | "issueGet" | "issueCommentList";
  owner: string;
  repo: string;
  number: number;
  perPage: number;
  page: number
}

def ghApiRule(words: Word[], cwd: string, origin: GhRepo | null, redirects: Redirect[]): Result<GhRule> {
  """
  Classify a gh api GET: the std::github read effect for its path, and the gh api command safeBash runs for it.
  """
  const split = ghLongFlags(splitFlags("gh", gitWordsCommand(words), GH_API_FLAGS)?)?
  if (ghValueOf(split.values, "--method", "GET").toUpperCase() != "GET") {
    return failure("gh api with a method other than GET has no rule")
  }
  if (split.positionals.length != 1) {
    return failure("`gh api` takes one path")
  }
  const text = literalWordText(split.positionals[0])?
  const read: GhApiRead = try _ghParseApiPath(text)?
  const repo = ghApiRepo(read, cwd, origin)
  return success({ effects: ghApiEffects(read, repo)?, command: ghApiCommand(read, repo, redirects) })
}

/* The repository a gh api path acts on: the names it holds, or with
  {owner} and {repo}, `origin`, or a lookup in `cwd`. */
def ghApiRepo(read: GhApiRead, cwd: string, origin: GhRepo | null): GhResolved {
  if (read.owner != "") {
    return { owner: read.owner, repo: read.repo, lookup: null }
  }
  if (origin != null) {
    return { owner: origin.owner, repo: origin.repo, lookup: null }
  }
  return { owner: "", repo: "", lookup: cwd }
}

// An issue path asks prGet as well as issueGet, for the reason
// ghIssueReads gives: the number may be a pull request. The endpoint names
// come from API_ROUTES in TypeScript, so an endpoint this match does not
// know has no rule.
def ghApiEffects(read: GhApiRead, repo: GhResolved): Result<Effect[]> {
  const one = ghNumberPayload(read.number, repo)
  const paged: GhPagedPayload = { owner: repo.owner, repo: repo.repo, number: read.number, perPage: read.perPage, page: read.page }
  return match(read.endpoint) {
    "prGet" => success([{ name: "std::github::prGet", payload: one, lookup: repo.lookup }])
    "prFiles" => success([{ name: "std::github::prFiles", payload: paged, lookup: repo.lookup }])
    "prReviewList" => success([{ name: "std::github::prReviewList", payload: paged, lookup: repo.lookup }])
    "prReviewCommentList" => success([{ name: "std::github::prReviewCommentList", payload: paged, lookup: repo.lookup }])
    "issueGet" => success([{ name: "std::github::issueGet", payload: one, lookup: repo.lookup }, { name: "std::github::prGet", payload: one, lookup: repo.lookup }])
    "issueCommentList" => success([{ name: "std::github::issueCommentList", payload: paged, lookup: repo.lookup }])
    _ => failure("no rule for the gh api endpoint `${read.endpoint}`")
  }
}

// On a first pass with a lookup pending the names in the path are empty;
// that text never runs.
def ghApiCommand(read: GhApiRead, repo: GhResolved, redirects: Redirect[]): SimpleCommand {
  """
  Build the gh api command to run, with the host, the method, and the path written out.
  """
  return {
    tag: "simpleCommand",
    assignments: [],
    command: GH_WORD,
    args: [
      literalWordOf("api"),
      ...GH_API_HOST,
      ...GH_API_GET,
      { tag: "singleQuoted", text: _ghApiPath(read, repo.owner, repo.repo) },
    ],
    redirects: redirects
  }
}


/** How many lines head and tail print when no count is given. */
static const DEFAULT_LINE_COUNT = 10

/** The read verbs the shell-free path prints itself. */
static const SHELL_FREE_READ_VERBS: string[] = ["cat", "head", "tail"]

// A cat of one or more files, or a head or tail of one, that safeBash runs
// in process goes through the read tool's own read and not the program,
// so its approval means what the read tool's approval means. This applies
// only to the flags `_renderReadView` prints exactly. A failure means
// "not this path", and the general rules then decide.
@capabilities(fileRead)
def tryShellFreeRead(command: SimpleCommand, cwd: string): Result<Plan> {
  """
  Plan an in-process cat, head, or tail when its output can be reproduced.
  """
  const name = command.command
  if (name == null || name.tag != "literal" || !SHELL_FREE_READ_VERBS.includes(name.text)) {
    return failure("not a lone read")
  }
  if (command.assignments.length > 0 || command.redirects.length > 0) {
    return failure("not a lone read")
  }
  const verb = name.text
  const spec = READ_VERBS[verb]
  if (spec == null) {
    return failure("not a lone read")
  }
  return match(readFileVerb(verb, command, cwd, spec)) {
    success(found) => shellFreeReadOf(verb, found, command)
    failure(why) => failure(why)
  }
}

@capabilities(fileRead)
def tryShellFreeStep(command: SimpleCommand, cwd: string): Result<Plan> {
  """
  Plan one supported echo, grep, or file read for in-process execution.
  """
  const echo = trySeeIfShellFree(command, cwd)
  if (echo is success(plan)) {
    return echo
  }
  const search = tryShellFreeGrep(command, cwd)
  if (search is success(plan)) {
    return search
  }
  return tryShellFreeRead(command, cwd)
}

/** One command of a chain and how it follows the one before. */
type ChainLink = {
  join: Join;
  command: SimpleCommand
}

@capabilities(fileRead)
def tryShellFreeChain(commands: Command[], cwd: string): Result<Plan> {
  """
  Plan a chain only when every command can run in process.
  """
  const links = chainLinks(commands)
  if (isFailure(links)) {
    return links
  }
  if (links.value.length < 2) {
    return failure("not a chain")
  }
  let steps: ChainStep[] = []
  let effects: Effect[] = []
  for (link in links.value) {
    const plan = tryShellFreeStep(link.command, cwd)
    if (isFailure(plan)) {
      return plan
    }
    const execution = stepExecOf(plan.value.execution)
    if (isFailure(execution)) {
      return execution
    }
    steps.push({ join: link.join, execution: execution.value })
    effects = [...effects, ...plan.value.effects]
  }
  return success({
    effects: effects,
    execution: { kind: "chain", steps: steps },
    broadReason: null,
    verbs: verbNames([link.command for link in links.value])
  })
}

// Keep this match exhaustive so every new execution kind gets a chain decision.
def stepExecOf(exec: Execution): Result<StepExec> {
  """
  Return an in-process execution suitable for a chain step.
  """
  return match(exec) {
    { kind: "echo" } => success(exec)
    { kind: "write" } => success(exec)
    { kind: "grep" } => success(exec)
    { kind: "read" } => success(exec)
    { kind: "bash" } => failure("a shell is not a chain step")
    { kind: "agency" } => failure("an agency command is not a chain step")
    { kind: "refuse" } => failure("a refused command is not a chain step")
    { kind: "chain" } => failure("a chain is not a chain step")
  }
}

def chainLinks(commands: Command[]): Result<ChainLink[]> {
  """
  Flatten a command line into simple commands and their preceding joins.
  """
  let out: ChainLink[] = []
  for (command in commands) {
    const links = linksOf(command, "seq")
    if (isFailure(links)) {
      return links
    }
    out = [...out, ...links.value]
  }
  return success(out)
}

def linksOf(command: Command, join: Join): Result<ChainLink[]> {
  // A second walk over the tree beside `flattenOne`, on purpose.
  // `flattenOne` feeds the refuse wall, so it must see through
  // parentheses and pipelines. A chain must stop at them: bash skips
  // `(b || c)` in `a && (b || c)` as a whole, which a flat list cannot
  // say. One walk answering both would give the wall a reason to skip a
  // node. The parser is left-associative (`a && b || c` is
  // `Or(And(a, b), c)`), so the flat list with a join per link runs in
  // bash's order.
  return match(command) {
    { tag: "simpleCommand" } => success([{ join: join, command: command }])
    { tag: "and", left, right } => joinedLinks(left, join, right, "and")
    { tag: "or", left, right } => joinedLinks(left, join, right, "or")
    { tag: "parens" } => failure("a parenthesized group is not run in process")
    { tag: "pipeline" } => failure("a pipeline is not run in process")
  }
}

def joinedLinks(left: Command, leftJoin: Join, right: Command, rightJoin: Join): Result<ChainLink[]> {
  const first = linksOf(left, leftJoin)
  if (isFailure(first)) {
    return first
  }
  const second = linksOf(right, rightJoin)
  if (isFailure(second)) {
    return second
  }
  return success([...first.value, ...second.value])
}

def shellFreeReadOf(verb: string, found: FileRead, command: SimpleCommand): Result<Plan> {
  return match(found) {
    { kind: "stdin" } => failure("a lone read with no path reads stdin")
    { kind: "files", paths, split } => shellFreeReadPlan(verb, paths, split, command)
  }
}

def shellFreeReadPlan(verb: string, paths: ReadPath[], split: SplitArgs, command: SimpleCommand): Result<Plan> {
  // How many paths each verb takes is READ_VERBS' rule, already applied
  // by readFileVerb: head and tail take at most one.
  const view = readViewFor(verb, split, paths.length)
  if (isFailure(view)) {
    return view
  }
  const payloads: ReadPayload[] = [{ dir: path.dir, filename: path.filename } for path in paths]
  return success({
    effects: [readEffect(payload) for payload in payloads],
    execution: readExecution(payloads, view.value),
    broadReason: null,
    verbs: verbNames([command])
  })
}

// Only render forms with matching GNU and BSD output. They disagree on
// cat -n across several files and on head -n 0.
def readViewFor(verb: string, split: SplitArgs, pathCount: number): Result<ReadView> {
  """
  Choose an in-process rendering for supported cat, head, or tail options.
  """
  if (verb == "cat") {
    const others = [letter for letter in split.plain if letter != "n"]
    if (others.length > 0) {
      return failure("not rendered shell-free")
    }
    if (split.plain.length > 0 && pathCount > 1) {
      return failure("cat -n of several files is refused shell-free")
    }
    if (split.plain.length > 0) {
      return success({ kind: "numbered" })
    }
    return success({ kind: "whole" })
  }
  const notCounts = [entry for entry in split.values if entry.flag != "n"]
  if (notCounts.length > 0) {
    return failure("not rendered shell-free")
  }
  const counts = [entry.value for entry in split.values if entry.flag == "n"]
  const lines = if (counts.length == 0) then DEFAULT_LINE_COUNT else digitsValue(counts[0])
  if (lines == 0) {
    return failure("a count of 0 is refused shell-free")
  }
  if (verb == "head") {
    return success({ kind: "head", lines: lines })
  }
  return success({ kind: "tail", lines: lines })
}

/* The number a string of digits spells. The caller checked `isDigits`. */
def digitsValue(text: string): number {
  let value = 0
  for (char in text.split("")) {
    value = value * 10 + DIGITS.indexOf(char)
  }
  return value
}

static const BASH_EFFECT: Effect = {
  name: "std::bash"
}

def refusePlan(reason: string, verbs: string[]): Plan {
  return {
    effects: [],
    execution: {
      kind: "refuse",
      reason: reason
    },
    broadReason: null,
    verbs: verbs
  }
}

def bashPlan(command: string, effects: Effect[], verbs: string[], broadReason: BroadReason | null): Plan {
  // Spawning a shell always raises at least one effect, so a log of
  // effects is a complete audit of shell invocations. A string of nothing
  // but echoes would otherwise raise nothing and still start a shell.
  const raised = if effects.length == 0 then [BASH_EFFECT] else effects
  return {
    effects: raised,
    execution: {
      kind: "bash",
      command: command
    },
    broadReason: broadReason,
    verbs: verbs
  }
}

/* The broad question for the whole string, with the reason it came to that. */
def broadPlan(command: string, verbs: string[], reason: BroadReason): Plan {
  return bashPlan(command, [BASH_EFFECT], verbs, reason)
}

/* The command word of each simple command, "" for an assignment-only one. */
def verbNames(commands: SimpleCommand[]): string[] {
  return [verbName(command) for command in commands]
}

def verbName(command: SimpleCommand): string {
  const name = command.command
  if (name == null) {
    return ""
  }
  return name.text
}

export def outcomeOf(plan: Plan): string {
  """
  Name a plan's outcome: refuse, shellFree, agency, narrow, or broad.
  """
  return match(plan.execution.kind) {
    "refuse" => "refuse"
    "echo" => "shellFree"
    "write" => "shellFree"
    "grep" => "shellFree"
    "read" => "shellFree"
    "chain" => "shellFree"
    "agency" => "agency"
    "bash" => bashOutcome(plan)
  }
}

def bashOutcome(plan: Plan): string {
  if (plan.broadReason == null) {
    return "narrow"
  }
  return "broad"
}

/** A flattened simple command and whether a pipe supplies its input. */
export type FlatCommand = {
  command: SimpleCommand;
  readsStdin: boolean
}

// Inspect commands inside chains, parentheses, and pipelines so none can
// hide a refused verb from the classifier.
def flattenCommands(commands: Command[]): FlatCommand[] {
  """
  Return every simple command for refusal checks and effect classification.
  """
  let out: FlatCommand[] = []
  for (command in commands) {
    out = [...out, ...flattenOne(command)]
  }
  return out
}

def flattenOne(command: Command): FlatCommand[] {
  // Keep this exhaustive so a new command shape cannot skip refusal checks.
  return match(command) {
    { tag: "simpleCommand" } => [{ command: command, readsStdin: false }]
    { tag: "pipeline", stages } => pipelineCommands(stages)
    { tag: "and", left, right } => [...flattenOne(left), ...flattenOne(right)]
    { tag: "or", left, right } => [...flattenOne(left), ...flattenOne(right)]
    { tag: "parens", command as inner } => flattenOne(inner)
  }
}

/* A pipe's commands: the first stage as it is, and every command in a
 later stage marked as reading the pipe. In `a | (b && c)`, both `b`
 and `c` read it, because the group's stdin is the pipe. */
def pipelineCommands(stages: PipelineStage[]): FlatCommand[] {
  let out: FlatCommand[] = flattenOne(stages[0])
  for (stage in stages.slice(1)) {
    const fed = [{ command: flat.command, readsStdin: true } for flat in flattenOne(stage)]
    out = [...out, ...fed]
  }
  return out
}

// Used only when every command was recognized. The approval says the
// command is, for example, `git status`, so safeBash runs the tree it
// classified and not the original text. A parser bug can then run only
// what the classifier thought it read.
def rebuild(commands: Command[]): Result<string> {
  """
  Render the classified command tree back to Bash source.
  """
  let parts: string[] = []
  for (command in commands) {
    const text = try _astToBash(command)
    if (text is failure(why)) {
      return failure("could not render `${why}`")
    }
    parts.push(text.value)
  }
  return success(parts.join("; "))
}

def trySeeIfShellFree(command: SimpleCommand, cwd: string): Result<Plan> {
  """
  Plan a literal echo command for in-process execution.
  """
  if (isRefused(command)) {
    return failure("refused")
  }
  const name = command.command
  if (name == null) {
    return failure("no command")
  }
  if (name.tag != "literal") {
    return failure("the command word is not a literal")
  }
  if (name.text != "echo") {
    return failure("not echo")
  }
  if (command.assignments.length > 0) {
    return failure("a leading assignment changes what the command does")
  }
  return shellFreePlan(command, cwd)
}

def tryAgencyPlan(command: SimpleCommand): Result<Plan> {
  """
  Plan an Agency CLI command or refuse an Agency binary lookup.
  """
  const name = command.command
  if (name == null || name.tag != "literal" || command.assignments.length > 0) {
    return failure("not an agency command")
  }
  const names = literalNames(command)
  const verbs = verbNames([command])
  return match(name.text) {
    "agency" => agencyCommandPlan(command)
    "which" => refuseIfLookingUpAgency(names.includes("agency"), verbs)
    "type" => refuseIfLookingUpAgency(names.includes("agency"), verbs)
    "command" => refuseIfLookingUpAgency(names.length > 0 && names[0] == "agency", verbs)
    _ => failure("not an agency command")
  }
}

/* The literal non-flag arguments, or none when any is not literal. */
def literalNames(command: SimpleCommand): string[] {
  return match(literalArgs(command)) {
    success(names) => names
    failure(why) => []
  }
}

def refuseIfLookingUpAgency(lookingUp: boolean, verbs: string[]): Result<Plan> {
  if (lookingUp) {
    return success(refusePlan(CLI_NOT_AVAILABLE, verbs))
  }
  return failure("not about agency")
}

def agencyCommandPlan(command: SimpleCommand): Result<Plan> {
  """
  Plan an Agency command with literal arguments and no redirects.
  """
  if (command.redirects.length > 0) {
    return success(refusePlan(CLI_NOT_AVAILABLE, verbNames([command])))
  }
  return match(literalWords(command.args)) {
    success(args) => success({
      effects: [],
      execution: {
        kind: "agency",
        args: args
      },
      broadReason: null,
      verbs: verbNames([command])
    })
    failure(why) => success(refusePlan(CLI_NOT_AVAILABLE, verbNames([command])))
  }
}

// This path never invokes a shell, so it cannot expand variables or globs.
def literalWords(words: Word[]): Result<string[]> {
  """
  Return each word's text, failing when any word is not fully literal.
  """
  let out: string[] = []
  for (arg in words) {
    const text = literalWordText(arg)
    if (isFailure(text)) {
      return text
    }
    out.push(text.value)
  }
  return success(out)
}

def literalWordText(word: Word): Result<string> {
  return match(word) {
    { tag: "literal", text } => success(text)
    { tag: "path", text } => success(text)
    { tag: "singleQuoted", text } => success(text)
    { tag: "doubleQuoted", parts } => literalParts(parts)
    _ => failure("`${word.tag}` is not fully literal")
  }
}

def literalParts(parts: Word[]): Result<string> {
  """
  Return the text of a double-quoted word that contains no expansions.
  """
  let out = ""
  for (part in parts) {
    if (part.tag != "literal") {
      return failure("a double-quoted word contains `${part.tag}`")
    }
    out = out + part.text
  }
  return success(out)
}

/** The flags the shell-free echo prints, modeled on bash's builtin echo.
 `-n` drops the trailing newline. `-e` and `-E` are left out, because
 the shell-free path does not read backslash escapes. bash's echo reads
 flags only at the front (`echo hi -n` prints `hi -n`), so a later one
 sends the line to bash. */
static const ECHO_FLAGS: FlagSpec = {
  plain: ["n"],
  valued: [],
  optionsFirst: true
}

def echoText(command: SimpleCommand): Result<string> {
  """
  Compute echo output for supported literal arguments and the optional -n flag.
  """
  const split = splitFlags("echo", command, ECHO_FLAGS)
  if (isFailure(split)) {
    return split
  }
  const words = literalWords(split.value.positionals)
  if (isFailure(words)) {
    return words
  }
  const end = if (split.value.plain.includes("n")) then "" else "\n"
  return success(words.value.join(" ") + end)
}

// This path builds a string and does nothing else. It cannot write a file
// or reach the network, however wrong the classifier is.
def echoPlan(command: SimpleCommand): Result<Plan> {
  """
  Plan a literal echo without redirects, returning its output without a shell.
  """
  if (command.redirects.length > 0) {
    return failure("a redirected echo is handled elsewhere")
  }
  const text = echoText(command)
  if (isFailure(text)) {
    return text
  }
  return success(
    {
    effects: [],
    execution: {
      kind: "echo",
      content: text.value
    },
    broadReason: null,
    verbs: verbNames([command])
  },
  )
}

def writePlan(command: SimpleCommand, cwd: string): Result<Plan> {
  """
  Plan a redirected literal echo, including the exact bytes in its write approval.
  """
  if (command.redirects.length != 1) {
    return failure("not a single redirect")
  }
  const only = command.redirects[0]
  const text = echoText(command)
  if (isFailure(text)) {
    return text
  }
  const prepared = prepareRedirectWrite(only, cwd, text.value)
  if (isFailure(prepared)) {
    return prepared
  }
  return success(
    {
    effects: [writeEffect(prepared.value)],
    execution: writeExecution(prepared.value),
    broadReason: null,
    verbs: verbNames([command])
  },
  )
}

def shellFreePlan(command: SimpleCommand, cwd: string): Result<Plan> {
  """
  Try an in-process echo, with or without an output redirect.
  """
  const bare = echoPlan(command)
  if (bare is success(plan)) {
    return bare
  }
  return writePlan(command, cwd)
}

// `origin` is how a `gh` command that names no repository gets one without
// planFor running anything. safeBash plans once with no origin, looks up
// the origin remote of the folder `pendingLookups` names, and plans again
// with the answer. The second plan is the one raised and run. A caller who
// plans only once may get std::github effects with "" for owner and repo.
export def planFor(source: string, cwd: string, origin: GhRepo | null = null): Plan {
  """
  Plan approvals and execution for Bash source without running the command.

  @param cwd - The working directory used to resolve paths during classification.
  @param origin - The repository a `gh` command acts on when it names none. Left null, such a command's std::github effects name no repository and say which folder to look it up in.
  """
  const parsed = bashParser(source)
  if (parsed is failure(why)) {
    // Unparseable: nothing was understood, so ask the broad question and
    // hand bash the text the human will have seen.
    return broadPlan(source, [], { kind: "unparseable", detail: why })
  }
  const commands: Command[] = parsed.value

  if (commands.length == 1) {
    const only = commands[0]
    if (only.tag == "simpleCommand") {
      const agency = tryAgencyPlan(only)
      if (agency is success(plan)) {
        return plan
      }
      const inProcess = tryShellFreeStep(only, cwd)
      if (inProcess is success(plan)) {
        return plan
      }
    }
  }
  const chain = tryShellFreeChain(commands, cwd)
  if (chain is success(plan)) {
    return plan
  }

  // Flatten first. A chain hides its halves inside `and`/`or`/`parens`
  // nodes, and `true && rm -rf /` has no top-level simple command at all —
  // without this walk the wall never sees the `rm`.
  const flat = flattenCommands(commands)
  const verbs = verbNames([entry.command for entry in flat])

  for (entry in flat) {
    const command = entry.command
    if (isRefused(command)) {
      const name = command.command
      if (name == null) {
        return refusePlan("this command is not allowed", verbs)
      }
      return refusePlan("`${name.text}` is not allowed", verbs)
    }
  }

  const classified = classifyAll(commands, cwd, origin)
  if (classified is failure(firstMiss)) {
    // We have to ask the broad question anyway, so asking narrow ones
    // first adds prompts without adding information. The ORIGINAL text
    // runs, because that is what the human read.
    return broadPlan(source, verbs, { kind: "unrecognized", detail: firstMiss })
  }
  const narrow: Effect[] = classified.value.effects
  if (narrow.length == 0) {
    // Everything recognized but nothing contributed an effect — a string
    // of nothing but echoes. The audit rule makes this a std::bash
    // question, so by the same rule it runs the original text.
    return broadPlan(source, verbs, { kind: "noEffects", detail: "" })
  }
  // One line gets one lookup, so its payloads all come from one answer.
  if (pendingLookups(narrow).length > 1) {
    return broadPlan(source, verbs, { kind: "unrecognized", detail: "gh commands in two folders need two repository lookups" })
  }
  // Narrow questions were asked, so run the tree we classified.
  const rebuilt = rebuild(classified.value.commands)
  if (rebuilt is failure(why)) {
    // We cannot produce the text we classified, so we must not ask narrow
    // questions about it. Doing this AFTER raising would break the first
    // hard rule.
    return broadPlan(source, verbs, { kind: "unrenderable", detail: why })
  }
  return bashPlan(rebuilt.value, narrow, verbs, null)
}

/** The effects of a command, the working directory once it has run, and
  the command as bash will run it. That is the command as written, except
  that each recognized `cd` names the directory the classifier resolved,
  and each recognized git command is the one `gitCommand` built. */
type Classified = {
  effects: Effect[];
  cwd: string;
  command: Command
}

/** The effects of the whole string and the command tree to run. */
type ClassifiedAll = {
  effects: Effect[];
  commands: Command[]
}

// Classify the whole string. This walks the command tree, where the refuse
// wall reads the flat list, because a `cd` on the left of `&&` moves the
// working directory for the commands to its right.
@capabilities(fileRead)
def classifyAll(commands: Command[], cwd: string, origin: GhRepo | null): Result<ClassifiedAll> {
  """
  Return the effects of every command and the tree to run, or the first reason one needs the broad Bash approval.
  """
  let effects: Effect[] = []
  let rewritten: Command[] = []
  for (command, index in commands) {
    const classified = classify(command, cwd, origin, false)?
    // `cd x && a; b`: `b` runs in `x` only when the `cd` worked, so no
    // payload for `b` would be true in both cases.
    if (classified.cwd != cwd && index < commands.length - 1) {
      return failure("a command after `;` follows a `cd`, and its directory depends on whether the `cd` worked")
    }
    effects = [...effects, ...classified.effects]
    rewritten.push(classified.command)
  }
  return success({ effects: effects, commands: rewritten })
}

@capabilities(fileRead)
def classify(command: Command, cwd: string, origin: GhRepo | null, readsStdin: boolean): Result<Classified> {
  // Keep this exhaustive, like flattenOne, so a new command shape cannot
  // be classified by accident.
  return match(command) {
    { tag: "simpleCommand" } => classifySimple(command, cwd, origin, readsStdin)
    { tag: "pipeline", stages } => classifyPipeline(stages, cwd, origin, readsStdin)
    { tag: "and", left, right } => classifyAnd(left, right, cwd, origin, readsStdin)
    { tag: "or", left, right } => classifyOr(left, right, cwd, origin, readsStdin)
    { tag: "parens", command as inner } => classifyGroup(inner, cwd, origin, readsStdin)
  }
}

@capabilities(fileRead)
def classifySimple(command: SimpleCommand, cwd: string, origin: GhRepo | null, readsStdin: boolean): Result<Classified> {
  const rule = simpleCommandRule(command, cwd, origin, readsStdin)?
  return success({ effects: rule.effects, cwd: cwd, command: rule.command })
}

// The first stage reads what the pipeline itself reads, and every later
// stage reads a pipe. Each stage runs in a subshell of its own, so a `cd`
// inside one moves nothing outside it.
@capabilities(fileRead)
def classifyPipeline(stages: PipelineStage[], cwd: string, origin: GhRepo | null, readsStdin: boolean): Result<Classified> {
  let effects: Effect[] = []
  let rewritten: any[] = []
  for (stage, index in stages) {
    const classified = classify(stage, cwd, origin, readsStdin || index > 0)?
    effects = [...effects, ...classified.effects]
    rewritten.push(classified.command)
  }
  return success({ effects: effects, cwd: cwd, command: { tag: "pipeline", stages: rewritten } })
}

// Parentheses run a subshell, so a `cd` inside them ends with them.
@capabilities(fileRead)
def classifyGroup(inner: Command, cwd: string, origin: GhRepo | null, readsStdin: boolean): Result<Classified> {
  const classified = classify(inner, cwd, origin, readsStdin)?
  return success({ effects: classified.effects, cwd: cwd, command: { tag: "parens", command: classified.command } })
}

// `cd dir && rest`: when the `cd` fails, bash runs nothing to its right, so
// `rest` only ever runs in `dir`. That makes `dir` the true working
// directory for every payload of `rest`. The `cd` itself raises nothing.
//
// `&&` groups to the left, so `cd x && a && b` is `(cd x && a) && b`. The
// directory after the left side is carried to the right side, which is how
// `b` is classified in `x` as well.
@capabilities(fileRead)
def classifyAnd(left: Command, right: Command, cwd: string, origin: GhRepo | null, readsStdin: boolean): Result<Classified> {
  const cd = asCd(left)
  if (cd != null) {
    const moved = cdTarget(cd, cwd)?
    const rest = classify(right, moved, origin, readsStdin)?
    return success({
      effects: rest.effects,
      cwd: rest.cwd,
      command: { tag: "and", left: cdTo(cd, moved), right: rest.command }
    })
  }
  const first = classify(left, cwd, origin, readsStdin)?
  const second = classify(right, first.cwd, origin, readsStdin)?
  return success({
    effects: [...first.effects, ...second.effects],
    cwd: second.cwd,
    command: { tag: "and", left: first.command, right: second.command }
  })
}

// `cd x && a || b`: `b` runs when the `cd` failed and also when `a` failed,
// and the working directory differs between the two. No payload for `b`
// would be true in both cases, so the string asks the broad question.
@capabilities(fileRead)
def classifyOr(left: Command, right: Command, cwd: string, origin: GhRepo | null, readsStdin: boolean): Result<Classified> {
  const first = classify(left, cwd, origin, readsStdin)?
  if (first.cwd != cwd) {
    return failure("a command after `||` follows a `cd`, and its directory depends on whether the `cd` worked")
  }
  const second = classify(right, cwd, origin, readsStdin)?
  return success({
    effects: [...first.effects, ...second.effects],
    cwd: second.cwd,
    command: { tag: "or", left: first.command, right: second.command }
  })
}

// The `cd` that bash runs names the directory the classifier resolved, as
// an absolute real path in single quotes. Bash would otherwise decide for
// itself where the written word leads, and it can disagree in two ways. It
// reads a word that starts with `-` as a flag even when quoted, so
// `cd '-P'` goes home. And it applies `..` to its own record of the path
// it came by, which keeps symlinks, so after `cd link` a `cd ..` returns to
// the folder that holds the link and not to the parent of its target. An
// absolute path starts with `/` and holds no `..`, so neither can happen.
def cdTo(command: SimpleCommand, dir: string): SimpleCommand {
  """
  Rewrite a cd command to name a resolved directory.
  """
  return { ...command, args: [{ tag: "singleQuoted", text: dir }] }
}

def asCd(command: Command): SimpleCommand | null {
  """
  Return the command when it is a simple command whose command word is the literal cd.
  """
  if (command.tag != "simpleCommand") {
    return null
  }
  const name = command.command
  if (name != null && name.tag == "literal" && name.text == "cd") {
    return command
  }
  return null
}

// The directory a `cd` moves to. It has to exist now, because every payload
// to the right of the `cd` names it. `cd` alone goes home, `cd -` goes to
// the previous directory, and a variable is unknown until bash expands it,
// so none of those has a directory to name.
@capabilities(fileRead)
def cdTarget(command: SimpleCommand, cwd: string): Result<string> {
  """
  Resolve the one literal directory a cd command names.
  """
  if (command.assignments.length > 0 || command.redirects.length > 0) {
    return failure("`cd` with an assignment or a redirect")
  }
  if (command.args.length != 1) {
    return failure("`cd` needs exactly one directory to be recognized")
  }
  const word = command.args[0]
  const text = literalWordText(word)
  if (text is failure(why)) {
    return failure("the `cd` directory is not literal")
  }
  if (text.value == "-") {
    return failure("`cd -` goes to the previous directory, which is not known here")
  }
  const target = resolveTarget(text.value, word, cwd)?
  if (target.file != null) {
    return failure("`cd` names a file")
  }
  // The directory is rebuilt inside single quotes, which cannot hold one.
  if (target.dir.includes("'")) {
    return failure("the `cd` directory has a single quote in its path")
  }
  return success(target.dir)
}

/** Commands we decline to run even when a human approves. */
static const REFUSED_COMMANDS: string[] = ["rm", "rmdir", "dd", "shred", "mkfs", "truncate"]

def baseName(text: string): string {
  """
  Return the last component of a slash-separated path.
  """
  const parts = text.split("/")
  return parts[parts.length - 1]
}

export def isRefused(command: SimpleCommand): boolean {
  """
  Check whether a command matches an explicitly refused destructive spelling.
  """
  const name = command.command
  if (name == null) {
    return false
  }
  const word = baseName(name.text)
  if (REFUSED_COMMANDS.includes(word)) {
    return true
  }
  if (word != "git") {
    return false
  }
  return isDestructiveGit(command)
}

// Only the FIRST argument is the subcommand. `git log reset` is a log, not
// a reset, and matching a subcommand name anywhere in the arguments would
// refuse it.
//
// `clean` is destructive by purpose. `restore`, `reset`, and `checkout`
// are only destructive in particular spellings, and refusing the whole
// subcommand would refuse `git checkout main`, which agents do constantly.
def isDestructiveGit(command: SimpleCommand): boolean {
  """
  Check the first argument and flags for explicitly refused destructive Git operations.
  """
  if (command.args.length == 0) {
    return false
  }
  const first = command.args[0]
  if (first.tag != "literal") {
    return false
  }
  return match(first.text) {
    "clean" => true
    "restore" => !onlyUnstages(command)
    "reset" => hasFlag(command, "--hard")
    "checkout" => checkoutDiscards(command)
    _ => false
  }
}

// `git restore --staged <paths>` takes files out of the index and leaves
// the working tree alone. With any other flag, or none, restore discards
// work. The `--` that separates paths is not counted: the parser returns
// it as a flag word.
def onlyUnstages(command: SimpleCommand): boolean {
  const flags = [flag for flag in flagNames(command) if flag != END_OF_FLAGS]
  return flags.length == 1 && flags[0] == "--staged"
}

// Checkout discards work in three spellings: with a `.` argument; with a
// `--`, which says every word after it is a path (`git checkout --
// utils.py`); and with a second word beside the ref (`git checkout main
// utils.py`), which overwrites that file. `-b` and `-B` take a second
// word as a start point, so they are let through.
def checkoutDiscards(command: SimpleCommand): boolean {
  if (hasLiteralArg(command, ".") || hasFlag(command, END_OF_FLAGS)) {
    return true
  }
  const creates = hasFlag(command, "-b") || hasFlag(command, "-B")
  return plainWordCount(command) >= CHECKOUT_WITH_A_SECOND_WORD && !creates
}

/** `checkout`, a ref, and one more word. The subcommand is itself a word. */
static const CHECKOUT_WITH_A_SECOND_WORD = 3

// Every argument that is not a flag, whatever tag the parser gave it: a
// word with a slash is a `path` and a quoted word is `singleQuoted`, and
// both count.
def plainWordCount(command: SimpleCommand): number {
  return [arg for arg in command.args if arg.tag != "flag"].length
}

def hasFlag(command: SimpleCommand, name: string): boolean {
  for (arg in command.args) {
    if (arg.tag == "flag" && arg.flagName == name) {
      return true
    }
  }
  return false
}

def hasLiteralArg(command: SimpleCommand, text: string): boolean {
  for (arg in command.args) {
    if (arg.tag == "literal" && arg.text == text) {
      return true
    }
  }
  return false
}

export def bashParser(code: string): Result<BashAST> {
  """
  Parse a string of bash code into an AST.
  """
  const res = _bashParser(code)
  return match(res.success) {
    true => success(res.result)
    false => failure(res.message)
  }
}

def renderFlag(flag: FlagWord): string {
  """
  Reconstruct a flag as written, including an optional =value.
  """
  if (flag.flagValue == null) {
    return flag.flagName
  }
  return "${flag.flagName}=${flag.flagValue}"
}

// Resolved once, at the top, and then carried on every action. An action
// that did not carry it would run wherever the process happened to be,
// which is the same command doing two different things.
export def resolveCwd(cwd: string): string {
  """
  Use the requested directory, then the agent directory, then the process directory.
  """
  if (cwd != "") {
    return cwd
  }
  const agent = getAgentCwd()
  if (agent != "") {
    return agent
  }
  // `write` rejects an empty dir, and `getAgentCwd()` is empty whenever
  // nothing set one, which is the case the tests run in.
  return "."
}

/** Added to a failed repository lookup, whose own message names the typed
  tools' owner and repo parameters. */
static const GH_REPO_HINT = "With gh, pass --repo OWNER/REPO."

// A gh read that names no repository gets the origin remote of the folder
// it runs in. Looking that up runs git, and planFor runs nothing, so the
// line is planned a second time with the answer. The second plan is the
// one raised and run, so its payloads and its command text come from one
// pass over the same checked data. The lookup goes through _gitRun, which
// adds the hardening flags and drops the GIT_* variables, and `git remote
// get-url` runs no hook or pager.
@capabilities(fileRead, subprocess, env)
def resolvedPlan(first: Plan, source: string, cwd: string): Result<Plan> {
  """
  The plan to raise and run: `first` when it waits on no repository lookup, and otherwise the line planned again with the origin remote of the folder it named.
  """
  const folders = pendingLookups(first.effects)
  if (folders.length == 0) {
    return success(first)
  }
  const coord = try _ghResolveRepo("", "", folders[0])
  if (coord is failure(why)) {
    return failure("${why} ${GH_REPO_HINT}")
  }
  return success(planFor(source, cwd, { owner: coord.value.owner, repo: coord.value.repo }))
}

export def safeBash(
  command: string,
  cwd: string = "",
  timeout: number = 120,
): Result<string> raises <std::bash, std::write, std::grep, std::git::status, std::git::diff, std::git::log, std::git::show, std::git::blame, std::git::branchList, std::git::remoteList, std::git::stashList, std::git::add, std::git::commit, std::git::checkout, std::git::switch, std::git::branchCreate, std::git::branchDelete, std::git::stashPush, std::git::stashPop, std::git::restore, std::github::prGet, std::github::prDiff, std::github::issueGet, std::github::prFiles, std::github::prReviewList, std::github::prReviewCommentList, std::github::prChecks, std::github::issueCommentList, std::github::prList, std::github::issueList, std::github::issueSearch, std::read, std::ls, std::glob, std::exec, std::run, std::guard> {
  """
  Run Bash commands after approval of the actions they perform.
  Return stdout on success. A nonzero exit is a failure carrying the exit
  code, stdout, and stderr, so there is no need to echo `$?` or re-run a
  command to learn how it exited. Read saved long output with readSpill or
  grepSpill, not with bash. A command still running after `timeout`
  seconds is stopped, with everything it started, and the failure carries
  the output so far.

  @param command - One or more bash commands.
  @param cwd - Working directory, defaulting to the agent directory or the process directory.
  @param timeout - Seconds the command may run. Pass more for a command known to be slow, such as a full test suite.
  """
  const dir = resolveCwd(cwd)
  const first = planFor(command, dir)

  // Logged before the refusal check, so a refused plan is on the record
  // too. Nothing has been raised or run yet.
  _debug("safeBash plan", planRecord(first, command, dir))

  // Everything below reads `plan`, the plan that is raised and run. A
  // refused plan raises nothing, so it never waits on a lookup.
  const plan = resolvedPlan(first, command, dir)?
  const exec = plan.execution
  if (pendingLookups(first.effects).length > 0) {
    _debug("safeBash resolved plan", planRecord(plan, command, dir))
  }

  // A command whose repository was never looked up must not run. This
  // cannot happen while resolvedPlan is right; it stops a later change to
  // the planning code from running a gh command with an empty repository.
  if (pendingLookups(plan.effects).length > 0) {
    return failure("safeBash did not look up the repository for a gh command, so it did not run it")
  }

  // A refusal returns before anything is raised: there is nothing to
  // approve. It still has an arm in the match below, because the match is
  // exhaustive over Execution.
  if (exec is { kind: "refuse", reason }) {
    return failure(reason)
  }

  const raised = raiseAll(plan.effects, command, dir, timeout * 1000)
  // The rejection is passed on as it came, not rebuilt with `failure()`,
  // which would drop its `rejected` flag. Without the flag the tool loop
  // shows the user's reason as a tool error and says to call again.
  if (isFailure(raised)) {
    if (plan.broadReason == null) {
      return raised
    }
    // A rejected broad question tells the model why no narrower one was
    // available, so its next attempt can take the narrower path. On its
    // own line: the rejection text comes from the handler or a policy
    // rejectMessage and may or may not end in a period.
    return _addLine(raised, "${broadExplanation(plan.broadReason)}${toolHint(plan.verbs)}")
  }

  // Use the planned text: rebuilt for narrow approval, original for broad
  // approval. Every executor applies the same long-output handling.
  return match(exec) {
    { kind: "write" } => runWrite(exec)
    { kind: "echo", content } => success(keepOutput(content, 0, command))
    { kind: "agency", args } => runAgency(args, dir, command)
    { kind: "grep" } => runGrep(exec, command)
    { kind: "read" } => runRead(exec, command)
    { kind: "chain" } => runChain(exec, command)
    { kind: "bash", command as text } => runBash(text, dir, command, timeout, plan.verbs)
    // Unreachable — the early return above already handled refusal. The
    // arm exists only to keep the match exhaustive over Execution.
    { kind: "refuse", reason } => failure(reason)
  }
}

/** The sentence the model reads for each reason a plan went broad. */
static const BROAD_SENTENCES = {
  unparseable: "the command could not be parsed",
  unrecognized: "it has no rule for one of the commands",
  noEffects: "every command was recognized but none needs an approval of its own, so the shell itself had to be approved",
  unrenderable: "the parsed command could not be rendered back to text"
}

def broadExplanation(reason: BroadReason): string {
  const sentence = BROAD_SENTENCES[reason.kind]
  if (reason.detail == "") {
    return "safeBash could not ask a narrower question because ${sentence}."
  }
  return "safeBash could not ask a narrower question because ${sentence}: ${reason.detail}."
}

/** The tool to suggest when a broad command made only of these verbs is
 rejected. Not wc: the read tool cannot count lines. Not du: the ls
 tool gives each entry's size and no folder total. */
static const READ_TOOL_FOR_VERB: Record<string, string> = {
  grep: "grep",
  cat: "read",
  head: "read",
  tail: "read",
  ls: "ls",
  tree: "ls",
  find: "glob"
}

// safeBash cannot see the policy, so the sentence below does not claim the
// tool needs no approval, only that a policy can approve its question.
def toolHint(verbs: string[]): string {
  """
  Suggest equivalent read tools when every rejected command has one.
  """
  let tools: string[] = []
  for (verb in verbs) {
    const tool = READ_TOOL_FOR_VERB[verb]
    if (tool == null) {
      return ""
    }
    if (!tools.includes(tool)) {
      tools.push(tool)
    }
  }
  if (tools.length == 0) {
    return ""
  }
  return " Call the ${tools.join(" or ")} tool instead: a policy can approve its question in advance."
}

/* What the debug event says about one plan: the decision and why. */
def planRecord(plan: Plan, command: string, cwd: string): Record<string, any> {
  let reason = ""
  let detail = ""
  if (plan.broadReason != null) {
    reason = plan.broadReason.kind
    detail = plan.broadReason.detail
  }
  return {
    command: command,
    cwd: cwd,
    outcome: outcomeOf(plan),
    reason: reason,
    detail: detail,
    verbs: plan.verbs,
    effects: [e.name for e in plan.effects]
  }
}

def runAgency(args: string[], cwd: string, source: string): Result<string> {
  """
  Run an in-process Agency CLI command and return its output.
  """
  return match(cli(args, cwd)) {
    success(result) => cliOutcome(result, source)
    failure(err) => failure(keepOutput("${err}", 1, source))
  }
}

def cliOutcome(result: ExecResult, source: string): Result<string> {
  if (result.exitCode != 0) {
    return failure(keepOutput(result.stdout + result.stderr, result.exitCode, source))
  }
  return success(keepOutput(result.stdout, 0, source))
}

def raiseAll(effects: Effect[], fullCommand: string, cwd: string, timeoutMs: number): Result {
  """
  Request every planned approval before executing any command.
  """
  for (effect in effects) {
    const answered = raiseOne(effect, fullCommand, cwd, timeoutMs)
    if (isFailure(answered)) {
      return answered
    }
  }
  return success(null)
}

// Keep this dispatch exhaustive and typed so new effects need checked raise
// sites. Include the full command in each payload for the approver to inspect.
// An effect is raised at a named site, not by name-as-data, so this is a
// closed dispatch with one arm per effect. That is also why safeBash
// declares them all in its `raises` clause: it is how an agent author
// discovers which handlers to write.
//
// The match is on `effect.name`, not on `effect` with object patterns:
// matching a member path narrows its siblings per arm, so `effect.payload`
// has the right variant type in each body. It is exhaustive with no
// catch-all, so a new Effect variant without a raise site is a type error
// here, not a runtime failure.
@capabilities(fileRead, fileWrite, subprocess, env)
def raiseOne(effect: Effect, fullCommand: string, cwd: string, timeoutMs: number): Result {
  """
  Raise a planned effect with its typed payload and the original command text.
  A payload that has a `timeout` carries the limit the line will run under,
  in milliseconds as the bash and exec tools give it.
  """
  return match(effect.name) {
    "std::bash" => {
      raise std::bash("Are you sure you want to run this shell command?", {
        command: fullCommand,
        cwd: cwd,
        timeout: timeoutMs,
        stdin: ""
      })
      return success(null)
    }
    "std::write" => {
      raise std::write("Are you sure you want to write to this file?", {
        dir: effect.payload.dir,
        filename: effect.payload.filename,
        content: effect.payload.content,
        mode: effect.payload.mode,
        command: fullCommand
      })
      return success(null)
    }
    "std::grep" => {
      raise std::grep("Are you sure you want to search files with grep?", {
        pattern: effect.payload.pattern,
        dir: effect.payload.dir,
        file: effect.payload.file,
        flags: effect.payload.flags,
        maxResults: effect.payload.maxResults,
        ignoreCase: effect.payload.ignoreCase,
        wholeWord: effect.payload.wholeWord,
        filesOnly: effect.payload.filesOnly,
        invert: effect.payload.invert,
        command: fullCommand
      })
      return success(null)
    }
    "std::read" => {
      raise std::read("Are you sure you want to read this file?", {
        dir: effect.payload.dir,
        filename: effect.payload.filename,
        command: fullCommand
      })
      return success(null)
    }
    "std::ls" => {
      raise std::ls("Are you sure you want to list this directory?", {
        dir: effect.payload.dir,
        recursive: effect.payload.recursive,
        maxResults: effect.payload.maxResults,
        command: fullCommand
      })
      return success(null)
    }
    "std::glob" => {
      raise std::glob("Are you sure you want to glob files?", {
        pattern: effect.payload.pattern,
        dir: effect.payload.dir,
        maxResults: effect.payload.maxResults,
        command: fullCommand
      })
      return success(null)
    }
    "std::exec" => {
      // The full line goes in `line`: std::exec already uses `command` for
      // the program, and `@always` pins that field.
      raise std::exec("Are you sure you want to run this command?", {
        command: effect.payload.command,
        args: effect.payload.args,
        subcommand: effect.payload.subcommand,
        cwd: effect.payload.cwd,
        timeout: timeoutMs,
        stdin: effect.payload.stdin,
        line: fullCommand
      })
      return success(null)
    }
    "std::git::status" => {
      raise std::git::status("Show git status", {
        cwd: effect.payload.cwd,
        command: fullCommand
      })
      return success(null)
    }
    "std::git::log" => {
      raise std::git::log("Show git log", {
        cwd: effect.payload.cwd,
        ref: effect.payload.ref,
        path: effect.payload.path,
        command: fullCommand
      })
      return success(null)
    }
    "std::git::diff" => {
      raise std::git::diff("Show git diff", {
        cwd: effect.payload.cwd,
        ref: effect.payload.ref,
        ref2: effect.payload.ref2,
        staged: effect.payload.staged,
        path: effect.payload.path,
        command: fullCommand
      })
      return success(null)
    }
    "std::git::show" => {
      raise std::git::show("Show a commit", {
        cwd: effect.payload.cwd,
        ref: effect.payload.ref,
        command: fullCommand
      })
      return success(null)
    }
    "std::git::blame" => {
      raise std::git::blame("Show who last changed each line of a file", {
        cwd: effect.payload.cwd,
        path: effect.payload.path,
        command: fullCommand
      })
      return success(null)
    }
    "std::git::branchList" => {
      raise std::git::branchList("List branches", {
        cwd: effect.payload.cwd,
        command: fullCommand
      })
      return success(null)
    }
    "std::git::remoteList" => {
      raise std::git::remoteList("List remotes", {
        cwd: effect.payload.cwd,
        command: fullCommand
      })
      return success(null)
    }
    "std::git::stashList" => {
      raise std::git::stashList("List stashes", {
        cwd: effect.payload.cwd,
        command: fullCommand
      })
      return success(null)
    }
    "std::git::add" => {
      raise std::git::add("Stage files", {
        cwd: effect.payload.cwd,
        paths: effect.payload.paths,
        all: effect.payload.all,
        command: fullCommand
      })
      return success(null)
    }
    "std::git::commit" => {
      raise std::git::commit("Commit the staged changes", {
        cwd: effect.payload.cwd,
        message: effect.payload.message,
        command: fullCommand
      })
      return success(null)
    }
    "std::git::checkout" => {
      raise std::git::checkout("Check out a branch or commit", {
        cwd: effect.payload.cwd,
        target: effect.payload.target,
        force: effect.payload.force,
        command: fullCommand
      })
      return success(null)
    }
    "std::git::switch" => {
      raise std::git::switch("Switch branches", {
        cwd: effect.payload.cwd,
        branch: effect.payload.branch,
        create: effect.payload.create,
        command: fullCommand
      })
      return success(null)
    }
    "std::git::branchCreate" => {
      raise std::git::branchCreate("Create a branch", {
        cwd: effect.payload.cwd,
        branch: effect.payload.branch,
        command: fullCommand
      })
      return success(null)
    }
    "std::git::branchDelete" => {
      raise std::git::branchDelete("Delete a branch", {
        cwd: effect.payload.cwd,
        branch: effect.payload.branch,
        force: effect.payload.force,
        command: fullCommand
      })
      return success(null)
    }
    "std::git::stashPush" => {
      raise std::git::stashPush("Stash the uncommitted changes", {
        cwd: effect.payload.cwd,
        message: effect.payload.message,
        command: fullCommand
      })
      return success(null)
    }
    "std::git::stashPop" => {
      raise std::git::stashPop("Apply and drop the newest stash", {
        cwd: effect.payload.cwd,
        command: fullCommand
      })
      return success(null)
    }
    "std::git::restore" => {
      raise std::git::restore("Take files out of the staging area", {
        cwd: effect.payload.cwd,
        paths: effect.payload.paths,
        staged: effect.payload.staged,
        command: fullCommand
      })
      return success(null)
    }
    // The std::github messages are the typed tools' messages for the same
    // effect, so a person sees one question on either path.
    "std::github::prGet" => {
      raise std::github::prGet("Read pull request #${effect.payload.number} on ${effect.payload.owner}/${effect.payload.repo}", {
        owner: effect.payload.owner,
        repo: effect.payload.repo,
        number: effect.payload.number,
        command: fullCommand
      })
      return success(null)
    }
    "std::github::prDiff" => {
      raise std::github::prDiff("Read the diff of pull request #${effect.payload.number} on ${effect.payload.owner}/${effect.payload.repo}", {
        owner: effect.payload.owner,
        repo: effect.payload.repo,
        number: effect.payload.number,
        command: fullCommand
      })
      return success(null)
    }
    "std::github::issueGet" => {
      raise std::github::issueGet("Read issue #${effect.payload.number} on ${effect.payload.owner}/${effect.payload.repo}", {
        owner: effect.payload.owner,
        repo: effect.payload.repo,
        number: effect.payload.number,
        command: fullCommand
      })
      return success(null)
    }
    "std::github::prFiles" => {
      raise std::github::prFiles("List the changed files of pull request #${effect.payload.number} on ${effect.payload.owner}/${effect.payload.repo}", {
        owner: effect.payload.owner,
        repo: effect.payload.repo,
        number: effect.payload.number,
        perPage: effect.payload.perPage,
        page: effect.payload.page,
        command: fullCommand
      })
      return success(null)
    }
    "std::github::prReviewList" => {
      raise std::github::prReviewList("List reviews on pull request #${effect.payload.number} on ${effect.payload.owner}/${effect.payload.repo}", {
        owner: effect.payload.owner,
        repo: effect.payload.repo,
        number: effect.payload.number,
        perPage: effect.payload.perPage,
        page: effect.payload.page,
        command: fullCommand
      })
      return success(null)
    }
    "std::github::prReviewCommentList" => {
      raise std::github::prReviewCommentList("List inline review comments on pull request #${effect.payload.number} on ${effect.payload.owner}/${effect.payload.repo}", {
        owner: effect.payload.owner,
        repo: effect.payload.repo,
        number: effect.payload.number,
        perPage: effect.payload.perPage,
        page: effect.payload.page,
        command: fullCommand
      })
      return success(null)
    }
    "std::github::prChecks" => {
      raise std::github::prChecks("Read CI check runs for pull request #${effect.payload.number} on ${effect.payload.owner}/${effect.payload.repo}", {
        owner: effect.payload.owner,
        repo: effect.payload.repo,
        number: effect.payload.number,
        perPage: effect.payload.perPage,
        page: effect.payload.page,
        command: fullCommand
      })
      return success(null)
    }
    "std::github::issueCommentList" => {
      raise std::github::issueCommentList("List comments on issue #${effect.payload.number} on ${effect.payload.owner}/${effect.payload.repo}", {
        owner: effect.payload.owner,
        repo: effect.payload.repo,
        number: effect.payload.number,
        perPage: effect.payload.perPage,
        page: effect.payload.page,
        command: fullCommand
      })
      return success(null)
    }
    "std::github::prList" => {
      raise std::github::prList("List ${effect.payload.state} pull requests on ${effect.payload.owner}/${effect.payload.repo}", {
        owner: effect.payload.owner,
        repo: effect.payload.repo,
        state: effect.payload.state,
        base: effect.payload.base,
        perPage: effect.payload.perPage,
        page: effect.payload.page,
        command: fullCommand
      })
      return success(null)
    }
    "std::github::issueList" => {
      raise std::github::issueList("List ${effect.payload.state} issues on ${effect.payload.owner}/${effect.payload.repo}", {
        owner: effect.payload.owner,
        repo: effect.payload.repo,
        state: effect.payload.state,
        labels: effect.payload.labels,
        perPage: effect.payload.perPage,
        page: effect.payload.page,
        command: fullCommand
      })
      return success(null)
    }
    "std::github::issueSearch" => {
      raise std::github::issueSearch("Search issues on ${effect.payload.owner}/${effect.payload.repo}: ${effect.payload.query}", {
        owner: effect.payload.owner,
        repo: effect.payload.repo,
        query: effect.payload.query,
        perPage: effect.payload.perPage,
        page: effect.payload.page,
        command: fullCommand
      })
      return success(null)
    }
  }
  return success(null)
}

// ---------------------------------------------------------------------------
// Executors. These run an approved plan, so they call the non-raising
// internals (`_bash`, `_write`, `_read`, `_grep`). They are not exported:
// an exported executor would let any program skip the approvals.
// ---------------------------------------------------------------------------

/**
Requires Bash on the search path. Successful stderr is omitted from the
result. Nonzero exits return failures, including grep's "no match" and
diff's "files differ" statuses. Long output is saved with a preview.
*/
@capabilities(fileRead, subprocess)
def runBash(command: string, cwd: string, source: string = "", timeout: number = 120, verbs: string[] = []): Result<string> {
  """
  Execute a Bash command after its planned effects have been approved.
  Return stdout on success, or an exit failure with output on nonzero exit.
  A command still running after `timeout` seconds is stopped, and the
  failure carries the output so far.
  """
  // `_bash`, NOT `bash`. The `bash` tool raises `std::bash` itself, so
  // calling it here would ask the broad question again, after the human
  // already answered a narrower one, and the entire feature would be a
  // no-op.
  //
  // Bypassing a tool's interrupt is normally forbidden: handlers are
  // safety infrastructure. It is correct here for one specific reason,
  // and only while that reason holds: the narrow interrupt REPLACES the
  // broad one, and the only path into this function runs through a
  // `raiseAll` that raised every effect in the plan and returned success.
  // Every plan raises at least one effect, so no classification bug can
  // turn into an ungated shell call. Do not add a caller that skips
  // `raiseAll`, and do not copy this call anywhere else.
  // `source` is the command as the model wrote it, which can differ from
  // the text this function runs: a `cd` names its resolved folder, and a
  // git command is the one `gitCommand` built. The trace and a failure
  // both name the model's text. A model that read the rewritten text in a
  // failure could copy it, and `git -c ...` has no rule.
  const label = if (source == "") then command else source
  const attempt = try _bash(command, cwd, timeout * 1000, "", {})
  if (attempt is failure(why)) {
    return failure("`${label}` was not run: ${why}")
  }
  // try wraps the returned ExecResult in the success value.
  const result: any = attempt.value
  if (result.timedOut) {
    return timeoutFailure(label, timeout, result.stdout, result.stderr)
  }
  if (result.exitCode != 0) {
    const note = if (isGhLoginFailure(verbs, result.exitCode, result.stderr)) then GH_LOGIN_NOTE else ""
    return exitFailure(label, result.exitCode, result.stdout, result.stderr, label, note)
  }
  return success(keepOutput(result.stdout, result.exitCode, label))
}

/** The exit code gh uses when it is not logged in. */
static const GH_LOGIN_EXIT = 4
static const GH_LOGIN_MARK = "gh auth login"
static const GH_LOGIN_NOTE = "GitHub CLI is not logged in. Tell the user to run `gh auth login`, or to set `GH_TOKEN`. Do not retry the command, and do not run `gh auth login` yourself."

// A model that sees gh's login message may run `gh auth login`, which
// waits for a person to answer its questions until the time limit. The
// exit code belongs to the whole line, so in `gh pr view 1; other` a 4
// could come from `other`; gh's own message in stderr settles it.
def isGhLoginFailure(verbs: string[], exitCode: number, stderr: string): boolean {
  return exitCode == GH_LOGIN_EXIT && verbs.includes("gh") && stderr.includes(GH_LOGIN_MARK)
}

// Include the exit code and both streams, saving long output for later
// retrieval, and a note for the model when there is one.
def exitFailure(command: string, exitCode: number, stdout: string, stderr: string, label: string, note: string = ""): Result<string> {
  const fields = {
    command: command,
    exitCode: exitCode,
    stderr: keepOutput(stderr, exitCode, label),
    stdout: keepOutput(stdout, exitCode, label)
  }
  if (note == "") {
    return failure(JSON.stringify(fields))
  }
  return failure(JSON.stringify({ ...fields, note: note }))
}

// The failure for a command stopped at its time limit: the output so far,
// and what the model can do next.
def timeoutFailure(command: string, seconds: number, stdout: string, stderr: string): Result<string> {
  return failure(
    JSON.stringify(
    {
    command: command,
    exitCode: 1,
    stderr: keepOutput(stderr, 1, command),
    stdout: keepOutput(stdout, 1, command),
    timedOut: true,
    note: "Stopped at the time limit of ${seconds} seconds. stdout and stderr hold the output so far. Run a narrower command (one test file, or one test), or pass a larger timeout."
  },
  ),
  )
}

@capabilities(fileRead)
def runGrep(exec: GrepExec, command: string): Result<string> {
  """
  Execute an approved in-process grep plan and return its rendered output.
  No matches return an exit-code-1 failure.
  """
  const found = grepResults(exec)
  if (isFailure(found)) {
    return found
  }
  const results: any[] = found.value
  if (results.length == 0) {
    return exitFailure(command, 1, "", grepNotes(exec.payload, 0), command)
  }
  return success(keepOutput(grepText(exec, results), 0, command))
}

@capabilities(fileRead)
def printGrep(exec: GrepExec): Result<string> {
  """
  Execute an approved grep plan and return its full output.
  No matches return a failure carrying any search notes.
  """
  const found = grepResults(exec)
  if (isFailure(found)) {
    return found
  }
  const results: any[] = found.value
  if (results.length == 0) {
    return failure(grepNotes(exec.payload, 0))
  }
  return success(grepText(exec, results))
}

@capabilities(fileRead)
def grepResults(exec: GrepExec): Result<any[]> {
  // `_grep`, NOT `grep`, for the reason `runBash` gives: the `grep` tool
  // raises its own std::grep, and the caller already raised one carrying
  // this same payload. The only path here runs through `raiseAll`.
  const payload = exec.payload
  const query = {
    pattern: payload.pattern,
    flags: payload.flags,
    ignoreCase: payload.ignoreCase,
    wholeWord: payload.wholeWord,
    filesOnly: payload.filesOnly,
    invert: payload.invert
  }
  return try _grep(payload.dir, ".", query, payload.maxResults, [], true, payload.file)
}

// Append search notes after the rendered matches.
def grepText(exec: GrepExec, results: any[]): string {
  const printed = _renderGrepOutput(results, exec.render)
  const notes = grepNotes(exec.payload, results.length)
  if (notes == "") {
    return printed
  }
  return printed + notes + "\n"
}

@capabilities(fileRead)
def runRead(exec: ReadExec, command: string): Result<string> {
  """
  Execute approved file reads and return cat, head, or tail output.
  """
  return match(printRead(exec)) {
    success(text) => success(keepOutput(text, 0, command))
    failure(why) => failure(why)
  }
}

/**
Files are concatenated before rendering, so a missing final newline joins
the next file's first line. A failed read drops previously collected text.
*/
@capabilities(fileRead)
def printRead(exec: ReadExec): Result<string> {
  """
  Execute approved file reads and return their full rendered output.
  """
  // `_read`, NOT `read`, for the reason `runBash` gives: the `read` tool
  // raises its own std::read, and the caller already raised one carrying
  // each of these payloads. The only path here runs through `raiseAll`.
  //
  // The plan refused a missing file or a folder before anything ran, so
  // a failure here is a race or a permission error, and `_read`'s own
  // message says which.
  let joined = ""
  for (payload in exec.payloads) {
    const text = try _read(payload.dir, payload.filename)
    if (isFailure(text)) {
      return text
    }
    joined = joined + text.value
  }
  return success(_renderReadView(joined, exec.view))
}

// Report skipped folders and any match limit reached by the in-process grep.
def grepNotes(payload: GrepPayload, found: number): string {
  let notes: string[] = []
  if (payload.file == null) {
    notes.push(_skippedDirsNote())
  }
  if (found >= payload.maxResults) {
    notes.push("(safeBash stopped after ${payload.maxResults} matches. Narrow the pattern or the path.)")
  }
  return notes.join("\n")
}

@capabilities(fileRead, fileWrite)
def runWrite(exec: WriteExec): Result<string> {
  """
  Execute an approved redirected echo write and return an empty stdout string.
  """
  // `_write`, NOT `write`, for the same reason `runBash` uses `_bash`: the
  // `write` tool raises its own `std::write`, and the caller already raised
  // one carrying the content. The only path here runs through `raiseAll`.
  //
  // `destructive { }` because `write()` wraps `_write` in one, and that
  // marker feeds the tool-loop retry rules. Calling `_write` directly
  // without it would give this write a different retry classification
  // from the tool it replaces.
  destructive {
    const written = try _write(exec.dir, exec.filename, exec.content, exec.mode)
    if (isFailure(written)) {
      return written
    }
  }
  return success("")
}

@capabilities(fileRead, fileWrite)
def runChain(exec: ChainExec, command: string): Result<string> {
  """
  Execute approved in-process commands with Bash-style ;, &&, and || joins.
  Return a failure when the last command executed failed.
  """
  let out = ""
  let ok = true
  let lastError = ""
  for (step in exec.steps) {
    if (skipsStep(step.join, ok)) {
      continue
    }
    let printed: Result<string> = success("")
    if (step.execution.kind == "write") {
      // Mark this activation too: a later failure must not let the tool
      // loop retry the chain and repeat an earlier write.
      destructive {
        printed = printStep(step.execution)
      }
    } else {
      printed = printStep(step.execution)
    }
    if (printed is success(text)) {
      out = out + text
      ok = true
    } else if (printed is failure(why)) {
      ok = false
      lastError = "${why}"
    }
  }
  if (!ok) {
    return exitFailure(command, 1, out, lastError, command)
  }
  return success(keepOutput(out, 0, command))
}

/** Whether bash skips a step after this join, given how the last step that
 ran ended. */
def skipsStep(join: Join, ok: boolean): boolean {
  return (join == "and" && !ok) || (join == "or" && ok)
}

@capabilities(fileRead, fileWrite)
def printStep(exec: StepExec): Result<string> {
  """
  Execute an approved chain step before saving long output.
  """
  return match(exec) {
    { kind: "echo", content } => success(content)
    { kind: "write" } => runWrite(exec)
    { kind: "grep" } => printGrep(exec)
    { kind: "read" } => printRead(exec)
  }
}
