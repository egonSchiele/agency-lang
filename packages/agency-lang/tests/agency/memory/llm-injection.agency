import { setMemoryId, remember } from "std::memory"
import { getThread, currentThreadId } from "std::thread"

// Stores a fact, then makes an llm() call with memory: true. The
// memory layer should inject a "Relevant context from memory:" system
// message before the user prompt. We register an onLLMCallStart
// callback that inspects the messages handed to the LLM and asserts
// the injected prefix is actually present — without this, the test
// would falsely pass even if memory injection was completely removed
// (the deterministic client returns the next mock for any prompt).
// After the call, the facts must be gone from the thread: they belong to
// the one request they were recalled for.
let injected: boolean = false

callback("onLLMCallStart") as data {
  for (msg in data.messages) {
    if (msg.role == "system" && msg.content != null) {
      const idx = msg.content.indexOf("Relevant context from memory:")
      if (idx >= 0) {
        injected = true
      }
    }
  }
}

def factsInThread(): boolean {
  const messages = getThread(currentThreadId(), 0, 200)
  if (isFailure(messages)) {
    return true
  }
  for (message in messages.value) {
    if (message.content.includes("Relevant context from memory:")) {
      return true
    }
  }
  return false
}

node main(): any {
  setMemoryId("llm-injection-test")
  remember("Mom likes pottery") with approve
  // Use a short query so structuredLookup's substring match matches
  // "Mom" deterministically without needing live embeddings.
  llm("mom", { memory: true })
  return { injected: injected, removed: !factsInThread() }
}
