import { cliPolicyHandler } from "std::policy"

// What the model reads for each way the user can reject at the prompt.
// It must say the user wrote the text, so a question from the user is not
// read as an error from the tool.

def ask(effectName: string): string {
  if (effectName == "a") {
    interrupt myapp::a("Allow a?", { key: "k" })
  } else if (effectName == "b") {
    interrupt myapp::b("Allow b?", { key: "k" })
  } else if (effectName == "c") {
    interrupt myapp::c("Allow c?", { key: "k" })
  } else {
    interrupt myapp::d("Allow d?", { key: "k" })
  }
  return "approved"
}

node main(args: { policyFile: string }): string[] {
  const handler = cliPolicyHandler(file: args.policyFile, fields: {})
  let reasons: string[] = []
  handle {
    for (name in ["a", "b", "c", "d"]) {
      const result = try ask(name)
      if (result is failure(why)) {
        reasons = [...reasons, why]
      } else {
        reasons = [...reasons, "UNEXPECTEDLY APPROVED"]
      }
    }
  } with handler
  return reasons
}
