// A tool that runs a command. The command exits non-zero, which is the
// command failing and not the tool, so the failure carries the exit code.
def runCommand(id: string): Result<string> {
  if (id.startsWith("ok")) {
    return success("ran ${id}")
  }
  return failure("output of ${id}\n[exit code 1]", { exitCode: 1 })
}

// A tool that breaks: an ordinary failure with no exit code.
def broken(id: string): Result<string> {
  if (id.startsWith("ok")) {
    return success("ran ${id}")
  }
  return failure("boom ${id}")
}

// Six non-zero exits in a row. None counts toward removal, so the sixth
// call still runs.
node exitsNeverRemove() {
  return llm("Use runCommand.", { tools: [runCommand] })
}

// Five ordinary failures in a row remove the tool, so the sixth scripted
// call never starts.
node fiveFailuresRemove() {
  return llm("Use broken.", { tools: [broken] })
}

// A call that works resets the count: four failures, a success, four more
// failures, a success. The tool is never removed.
node successResets() {
  return llm("Use broken.", { tools: [broken] })
}
