node lookups() {
  const obj: Record<string, number> = { present: 42 }
  const arr = [1, 2, 3]
  const zero: Record<string, number> = { z: 0 }
  return {
    missingKey: obj["absent"],
    presentKey: obj["present"],
    outOfBounds: arr[10],
    negativeIndex: arr[-1],
    inBounds: arr[0],
    falsyZero: zero["z"]
  }
}
