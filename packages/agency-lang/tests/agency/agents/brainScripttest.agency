// The scripttest brain from std::agents/brains/scripttest, and its
// runAgency tool. The brain cases use a scripted model. The runAgency cases
// run a real program in a separate process, and need no model.
import test { callerToolsNotIn } from "std::agents/brains/coordinator/code"
import {
  runAgency,
  scripttestBrain,
  withScriptToolsForCoders,
 } from "std::agents/brains/scripttest"
import { AgentSettings } from "std::agents/brains/settings"
import { agencyDocToolsBrief } from "std::agents/lib/toolkits"

// Every model request, in order.
let calls: any[] = []

callback("onLLMCallStart") as data {
  calls = [...calls, data]
}

def emptySettings(): AgentSettings {
  return {
    context: "",
    model: "",
    provider: "",
    reasoningModel: "",
    reasoningProvider: "",
    routerModel: "",
    routerProvider: "",
    coderTools: []
  }
}

def requestHasSystemText(call: any, text: string): boolean {
  for (message in call.messages) {
    const content = "${message.content}"
    if (message.role == "system" && content.includes(text)) {
      return true
    }
  }
  return false
}

// The coordinator's tools are all there, with runAgency and the docs tools.
node offersRunAgencyAndTheCoordinatorTools(): string {
  scripttestBrain(["say hi"], emptySettings(), [])
  const names = [tool.name for tool in calls[0].tools]
  return "${names.includes("runAgency")}|${names.includes("agencyStdlib")}|${names.includes("codeAgent")}|${names.includes("agencyCodeAgent")}"
}

// The coders get runAgency and the docs tools ahead of the caller's coder
// tools, which stay.
node codersGetTheScriptTools(): string[] {
  const settings = {
    ...emptySettings(),
    coderTools: [requestHasSystemText]
  }
  return [tool.name for tool in withScriptToolsForCoders(settings).coderTools]
}

// The Agency coder already has the docs tools, so the copies the brain
// passes are dropped, and runAgency is kept.
node agencyCoderGetsNoDuplicateNames(): string[] {
  const coderTools = withScriptToolsForCoders(emptySettings()).coderTools
  return [tool.name for tool in callerToolsNotIn(agencyDocToolsBrief(), coderTools)]
}

// The model is told to use runAgency, gets the tutorial, and still gets the
// coordinator's own prompt.
node tellsTheModelToUseRunAgency(): string {
  scripttestBrain(["say hi"], emptySettings(), [])
  const rules = requestHasSystemText(calls[0], "runAgency tool")
  const tutorial = requestHasSystemText(calls[0], "<agency_tutorial>")
  const coordinator = requestHasSystemText(calls[0], "codeAgent")
  return "${rules}|${tutorial}|${coordinator}"
}

// A program with a type error comes back with the error and its line, and
// nothing runs: the handler would reject std::run with a different message.
node typeErrorsComeBackAndNothingRuns(): string {
  handle {
    const result = runAgency("export node main(): number {\n  return \"three\"\n}")
    if (result is failure(err)) {
      return "${err.startsWith("The program was not run, because it has type errors:")}|${err.includes("line ")}|${err.includes("AG")}"
    }
    return "ran"
  } with (intr) {
    return reject("std::run was raised")
  }
}

// A program with no errors runs, and its main node's value comes back.
node runsAndReturnsMainsValue(): any {
  handle {
    const result = runAgency("export node main(): number {\n  return 1 + 2\n}")
    if (result is success(value)) {
      return value
    }
    return "${result.error}"
  } with approve
}

// Every effect the program raises reaches this program's handler: first
// std::run to start it, then the program's own file read.
node theProgramsReadAsksThisHandler(): string {
  let seen: string[] = []
  handle {
    runAgency(
      "export node main(): string {\n  const text = read(\"package.json\")\n  return \"read\"\n}",
    )
  } with (intr) {
    seen = [...seen, intr.effect]
    if (intr.effect == "std::run") {
      return approve()
    }
    return reject()
  }
  return seen.join(",")
}
