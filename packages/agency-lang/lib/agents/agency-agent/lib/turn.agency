/** @module
  @summary The harness side of a turn: which brain is selected, and the
  per-turn work (slash expansion, attachments, the hard stop for a subagent
  budget trip) that happens before `agencyAgent` sees the message. See
  docs/dev/agents/agent-brains.md.
*/
import { map } from "std::array"
import { expandSlash } from "std::skills"
import { Attachment, currentThreadId } from "std::thread"

import { answerTurnResult, replyText } from "./answer.agency"
import { detectAttachments, modalityFilter } from "./attachments.agency"
import { guardStopHandler } from "./budget.agency"
import { slashCommands } from "./commandPalette.agency"
import { notice } from "./notice.agency"
import { withProjectContextIfMoved } from "./projectContext.agency"
import { setConversationThread } from "./record.agency"
import { setMessageRewritten } from "./rewrittenMessage.agency"
import { Settings } from "./settings.agency"
import { START_TARGETS, runStartTarget } from "./startTargets.agency"

export static const DEFAULT_BRAIN = "coordinator"

// The brain this run talks to. Set once by main(); read by runTurn.
let _brainName: string = ""

export def setBrainName(name: string) {
  _brainName = name
}

export def currentBrainName(): string {
  return _brainName
}

// A missing brain is a harness bug: main() must call setBrainName() before
// runTurn.
export static const NO_BRAIN = "No brain selected: main() must call setBrainName() first"

/** The `--agent` values a brain accepts besides `main`. Only the
  coordinator brain has subagents to start. */
export def startTargetsFor(brainName: string): string[] {
  if (brainName == "coordinator") {
    return START_TARGETS
  }
  return []
}

export def resolveStartTarget(
  brainName: string,
  requested: string,
): string | null {
  """
  Normalize the CLI's `main` alias to the empty main target and reject names
  the selected brain does not expose.
  """
  let target = requested
  if (target == "main") {
    target = ""
  }
  if (target != "" && !startTargetsFor(brainName).includes(target)) {
    return null
  }
  return target
}

export def resolveBrainName(flag: string | null, settings: Settings): string {
  """
  Which brain to run: the --brain flag, else the `brain` setting, else the
  default.
  """
  if (flag != null && flag != "") {
    return flag
  }
  // settings.json is hand-editable, so check the runtime shape, not just
  // the declared type.
  const fromSettings = settings.brain
  if (fromSettings is string && fromSettings != "") {
    return fromSettings
  }
  return DEFAULT_BRAIN
}

def checkForAttachments(expanded: string): Attachment[] {
  // Auto-attach image/PDF files the user referenced (drag-drop or typed
  // path), filtered to what the resolved model accepts. Never silent:
  // every attach and every skip is a notice.
  const detected = modalityFilter(detectAttachments(expanded))
  for (skippedFile in detected.skipped) {
    notice("📎 skipped ${skippedFile.label} (${skippedFile.reason})", "warning")
  }
  if (detected.attached.length == 0) {
    return []
  }
  for (item in detected.attached) {
    notice("📎 attached ${item.label}")
  }
  const attachments = map(detected.attached) as item {
    return item.attachment
  }
  return attachments
}

// `fromHarness` marks a message the harness wrote, not the user. It gets no
// slash expansion, no project block, and no attachments, and the router does
// not route it.
def dispatchToBrain(target: string, userMsg: string, fromHarness: boolean): Result<string> {
  if (_brainName == "") {
    throw(NO_BRAIN)
    return failure(NO_BRAIN)
  }
  if (fromHarness) {
    setMessageRewritten(true)
    return answerTurnResult(_brainName, userMsg, [])
  }
  // A coder may have changed the agent's working directory on an earlier
  // turn. The model then needs that folder's instructions with this message.
  const expanded = withProjectContextIfMoved(expandSlash(userMsg, slashCommands()))
  setMessageRewritten(expanded != userMsg)
  if (target != "") {
    return success(runStartTarget(target, expanded))
  }
  const attachments = checkForAttachments(expanded)
  return answerTurnResult(_brainName, expanded, attachments)
}

// One turn on the conversation thread. A subagent's budget trip that no
// inner handler owns is answered here as a hard stop, so the subagent
// returns its best result and the brain continues.
def turnResult(target: string, userMsg: string, fromHarness: boolean): Result<string> {
  // The turn runs on this run's active thread, which is the conversation.
  // Recorded before the turn too, so a turn the user cancels still leaves
  // the id behind.
  setConversationThread(currentThreadId())
  let result: Result<string> = failure("the turn did not run")
  handle {
    result = dispatchToBrain(target, userMsg, fromHarness)
  } with guardStopHandler
  setConversationThread(currentThreadId())
  return result
}

export def runTurn(target: string, userMsg: string): string {
  """
  Run one user turn and return the text the user reads. A whole-agent limit
  comes only from the `--max-time` and `--max-cost` flags, which the runtime
  enforces as a root budget.
  """
  return replyText("The agent", turnResult(target, userMsg, false))
}

export def runTurnResult(target: string, userMsg: string): Result<string> {
  """
  Run one user turn and return its result, so the caller can tell a reply
  from a turn that failed.
  """
  return turnResult(target, userMsg, false)
}

export def runContinueTurn(message: string): Result<string> {
  """
  Run one more turn of the brain with a message the harness wrote, such as
  a nudge to finish the task.
  """
  return turnResult("", message, true)
}
