import {
  describe,
  parseAST,
  toSource,
  getNodesOfType,
  testFile,
  ModuleInfo,
  ExportInfo,
  TestReport,
 } from "std::agency"
import { agencyCodingAgent } from "std::agents/agency/coding"
import { agencyReviewAgent } from "std::agents/agency/review"
import { llmOptions } from "std::agents/lib/shared"
import { now, format } from "std::date"
import { mkdir, remove, move } from "std::fs"

import { _read } from "agency-lang/stdlib-lib/builtins.js"
import { expandPath } from "agency-lang/stdlib-lib/expandPath.js"
import { _ls, _exists } from "agency-lang/stdlib-lib/shell.js"

/** @module
  @summary Keep a directory of tools an agent wrote, and write new ones.
  A tool is an Agency module that exports `type Request`,
  `def tool(request: Request)`, and `node main(request: Request)`. `tool`
  returns the `Result` of the guard that wraps its work. `listTools` reads
  a toolbox directory into a catalog. `writeTool` has the coding agent
  draft a new tool. It then checks and tests the draft, shows it to the
  user through an interrupt, and saves it.

  A person reviews the generated code before it is saved. The handler
  below prints the source and asks. A policy that always answers
  `approve()` accepts every draft. A policy that answers `reject()`
  cancels the write.

  ```ts
  import { writeTool, listTools } from "std::toolbox"
  import { runFile } from "std::agency"

  const REVISE_PREFIX = "revise "

  node main() {
    handle {
      const written = writeTool(name: "getNews", purpose: "Summarize today's news for a list of topics as Markdown.")
      if (written is failure(err)) {
        print("not written: ${err}")
        return
      }
      printJSON(listTools())
      const news = runFile(written.value.dir, "tool.agency", "main", { request: { topics: ["tech"], maxItems: 5 } })
      print(news)
    } with (intr) {
      return match (intr.effect) {
        "std::toolbox::review" => {
          print(intr.data.source)
          print("effects: ${intr.data.effects.join(", ")}")
          const answer = input("accept / revise <feedback> / reject: ")
          if (answer == "accept") {
            return approve({ verdict: "accept" })
          }
          if (answer.startsWith(REVISE_PREFIX)) {
            return approve({ verdict: "revise", feedback: answer.slice(REVISE_PREFIX.length) })
          }
          return reject("cancelled by user")
        }
        _ => pass()
      }
    }
  }
  ```

  A program imports a saved tool directly:
  `import { tool as getNews } from "~/.agency-agent/tools/getNews/tool.agency"`.
*/

// Upper bound on tools one scan reads; the same cap std::skills uses for a
// skills directory.
const MAX_TOOLS = 500

// Providers cap tool names at 64 characters; std::skills truncates to the
// same cap, this module refuses so a user-chosen name is never changed.
const MAX_TOOL_NAME_LEN = 64

// The effect list of a tool that does nothing but compute: the guard
// around its work. Only such tools get generated tests, because a tool
// that calls a model or the network has no output an exact test can
// predict.
const PURE_EFFECTS = "std::guard"

// One approval covers the scan; the reads that fulfil it use the
// non-interrupt primitives, as std::skills does.
effect std::toolbox::scan {
  dir: string
}

effect std::toolbox::review {
  name: string;
  stagingDir: string;
  source: string;
  effects: string[];
  tested: boolean
}

/** One tool in a toolbox: what `describe` says about its module plus the
  usage record from meta.json. `broken` carries the reason the directory
  could not be read as a healthy tool: a parse failure, no `tool` export,
  or a meta.json that is missing a field or has one of the wrong type. */
export type ToolEntry = {
  name: string;
  dir: string;
  summary?: string;
  signature: string;
  docstring?: string;
  effects: string[];
  version: number;
  uses: number;
  lastUsedAt?: string;
  recentOutcomes: string[];
  broken?: string
}

/** The value a handler passes to approve() for std::toolbox::review. A
  bare approve() counts as accept. */
export type WriteToolReview =
  | { verdict: "accept" }
  | { verdict: "revise"; feedback: string }

/** What describe() contributes to an entry. */
type ModuleFacts = {
  summary?: string;
  signature: string;
  docstring?: string;
  effects: string[]
}

/** What meta.json contributes to an entry. */
type MetaFacts = {
  version: number;
  uses: number;
  lastUsedAt?: string;
  recentOutcomes: string[]
}

const DEFAULT_META: MetaFacts = {
  version: 1,
  uses: 0,
  lastUsedAt: null,
  recentOutcomes: []
}

const EMPTY_MODULE: ModuleFacts = {
  summary: null,
  signature: "",
  docstring: null,
  effects: []
}

def toolExport(info: ModuleInfo): ExportInfo | null {
  return find(info.exports, \entry -> entry.name == "tool" && entry.kind == "def")
}

def mainExport(info: ModuleInfo): ExportInfo | null {
  return find(info.exports, \entry -> entry.name == "main" && entry.kind == "node")
}

def moduleFacts(toolDir: string): Result<ModuleFacts> {
  const source = try _read(toolDir, "tool.agency", 0, 0)
  if (source is failure) {
    return source
  }
  const info = describe(source.value)
  if (info is failure) {
    return info
  }
  const exported = toolExport(info.value)
  if (exported == null) {
    return failure("no exported `def tool` in tool.agency")
  }
  return success(
    {
      summary: info.value.description,
      signature: exported.signature,
      docstring: exported.docstring,
      effects: exported.effects
    },
  )
}

def isStringList(value: any): boolean {
  return Array.isArray(value) && every(value, \item -> typeof item == "string")
}

// A parsed meta.json is only as good as its fields: a field of the wrong
// type would violate ToolEntry's declared types downstream.
def metaFieldProblem(meta: any): string {
  if (typeof meta != "object" || meta == null || Array.isArray(meta)) {
    return "meta.json must hold an object"
  }
  const version = meta.version ?? DEFAULT_META.version
  const uses = meta.uses ?? DEFAULT_META.uses
  const lastUsedAt = meta.lastUsedAt ?? DEFAULT_META.lastUsedAt
  const recentOutcomes = meta.recentOutcomes ?? DEFAULT_META.recentOutcomes
  if (typeof version != "number") {
    return "meta.json field `version` must be a number"
  }
  if (typeof uses != "number") {
    return "meta.json field `uses` must be a number"
  }
  if (lastUsedAt != null && typeof lastUsedAt != "string") {
    return "meta.json field `lastUsedAt` must be a string or null"
  }
  if (!isStringList(recentOutcomes)) {
    return "meta.json field `recentOutcomes` must be a list of strings"
  }
  return ""
}

// A missing meta.json is the default record. A present one that cannot be
// read, is not JSON, or has a field of the wrong type is a failure, so a
// corrupt file never passes as a healthy tool.
def metaFacts(toolDir: string): Result<MetaFacts> {
  const present = try _exists("meta.json", toolDir, [])
  if (present is failure) {
    return present
  }
  if (!present.value) {
    return success(DEFAULT_META)
  }
  const raw = try _read(toolDir, "meta.json", 0, 0)
  if (raw is failure(readErr)) {
    return failure("meta.json could not be read: ${readErr}")
  }
  const parsed = try JSON.parse(raw.value)
  if (parsed is failure(parseErr)) {
    return failure("meta.json is not valid JSON: ${parseErr}")
  }
  const problem = metaFieldProblem(parsed.value)
  if (problem != "") {
    return failure(problem)
  }
  return success(
    {
      version: parsed.value.version ?? DEFAULT_META.version,
      uses: parsed.value.uses ?? DEFAULT_META.uses,
      lastUsedAt: parsed.value.lastUsedAt ?? DEFAULT_META.lastUsedAt,
      recentOutcomes: parsed.value.recentOutcomes ?? DEFAULT_META.recentOutcomes
    },
  )
}

def entryFor(root: string, name: string): ToolEntry {
  const toolDir = root + "/${name}"
  const module = moduleFacts(toolDir)
  const meta = metaFacts(toolDir)
  const moduleFields: ModuleFacts = module catch EMPTY_MODULE
  const metaFields: MetaFacts = meta catch DEFAULT_META
  let broken: string | null = null
  if (module is failure(moduleErr)) {
    broken = "${moduleErr}"
  } else if (meta is failure(metaErr)) {
    broken = "${metaErr}"
  }
  return {
    name: name,
    dir: toolDir,
    broken: broken,
    ...moduleFields,
    ...metaFields
  }
}

// A plain directory listing, so a tool named `dist` or `build` is not
// hidden by the walking glob's skip list. Dot directories (the staging
// area) are not tools.
def toolNames(root: string): Result<string[]> {
  const entries = try _ls(root, false, [], MAX_TOOLS)
  if (entries is failure) {
    return entries
  }
  const dirs = filter(
    entries.value,
    \entry -> entry.type == "dir" && !entry.name.startsWith("."),
  )
  return success(map(dirs, \entry -> entry.name))
}

export idempotent def listTools(
  dir: string = "~/.agency-agent/tools",
): Result<ToolEntry[]> {
  """
  List the tools in a toolbox directory. Each entry has the tool's name,
  signature, description, the interrupt effects it can raise, and its
  usage record from meta.json: the version, how many times it ran, when
  it last ran, and its recent outcomes.

  @param dir - The toolbox directory to scan
  """
  const root = expandPath(dir)
  return interrupt std::toolbox::scan("Are you sure you want to scan this directory for tools?", {
    dir: root
  })
  const names = toolNames(root)
  if (names is failure) {
    return names
  }
  return success(map(names.value, \name -> entryFor(root, name)))
}

/** Everything the shape rules look at, gathered once. `returnedGuard` is
  the guardBlock that `tool` returns directly, or null; `guardLimits` the
  names of that guard's arguments; the signatures come from describe. */
type ShapeFacts = {
  exportedTypes: string[];
  exportedDefs: string[];
  exportedNodes: string[];
  exportedConsts: string[];
  returnedGuard: any;
  guardLimits: string[];
  toolSignature: string;
  mainSignature: string;
  approveCount: number;
  docstring: string
}

def exportedNamesOf(
  nodes: any[],
  nodeType: string,
  nameOf: (any) -> string,
): string[] {
  const exported = filter(nodes, \astNode -> astNode.type == nodeType && astNode.exported)
  return map(exported, nameOf)
}

// The guard `tool` returns: a top-level `return guard(...) { ... }` in its
// body. A guard assigned to a variable, or nested inside another block, is
// not the one the contract wants, because work can happen outside it.
def returnedGuardOf(toolNode: any): any {
  const returned = find(
    toolNode.body,
    \statement -> statement.type == "returnStatement" && statement.value != null && statement.value.type == "guardBlock",
  )
  if (returned == null) {
    return null
  }
  return returned.value
}

def namedArgumentNames(callArguments: any[]): string[] {
  const named = filter(callArguments, \argument -> argument.type == "namedArgument")
  return map(named, \argument -> argument.name)
}

// The only def that knows AST field names.
def shapeFacts(source: string): Result<ShapeFacts> {
  const ast = parseAST(source)
  if (ast is failure) {
    return ast
  }
  const nodes = ast.value.nodes
  const toolNode = find(
    nodes,
    \astNode -> astNode.type == "function" && astNode.functionName == "tool",
  )
  let returnedGuard = null
  if (toolNode != null) {
    returnedGuard = returnedGuardOf(toolNode)
  }
  let guardLimits: string[] = []
  if (returnedGuard != null) {
    guardLimits = namedArgumentNames(returnedGuard.arguments)
  }
  const modifiers = getNodesOfType(source, ["withModifier"]) catch []
  const approvals = filter(modifiers, \modifier -> modifier.handlerName == "approve")
  let toolSignature = ""
  let mainSignature = ""
  let docstring = ""
  const described = describe(source)
  if (described is success(info)) {
    const tool = toolExport(info)
    if (tool != null) {
      toolSignature = tool.signature
      docstring = tool.docstring ?? ""
    }
    const main = mainExport(info)
    if (main != null) {
      mainSignature = main.signature
    }
  }
  return success(
    {
      exportedTypes: exportedNamesOf(nodes, "typeAlias", \astNode -> astNode.aliasName),
      exportedDefs: exportedNamesOf(nodes, "function", \astNode -> astNode.functionName),
      exportedNodes: exportedNamesOf(nodes, "graphNode", \astNode -> astNode.nodeName),
      exportedConsts: exportedNamesOf(nodes, "assignment", \astNode -> astNode.variableName),
      returnedGuard: returnedGuard,
      guardLimits: guardLimits,
      toolSignature: toolSignature,
      mainSignature: mainSignature,
      approveCount: approvals.length,
      docstring: docstring
    },
  )
}

def guardHasFinalize(guardNode: any): boolean {
  return some(guardNode.body, \child -> child.type == "finalizeBlock")
}

type ShapeRule = {
  ok: boolean;
  message: string
}

def unexpectedExportRules(
  names: string[],
  expected: string,
  kind: string,
): ShapeRule[] {
  const unexpected = filter(names, \name -> name != expected)
  return map(
    unexpected,
    \name -> {
      ok: false,
      message: "unexpected export `${kind} ${name}`; a tool exports only Request, tool, and main"
    },
  )
}

// The contract as data: one entry per rule, in the order problems are reported.
def shapeRules(facts: ShapeFacts): ShapeRule[] {
  const hasTool = facts.exportedDefs.includes("tool")
  const hasMain = facts.exportedNodes.includes("main")
  const guard = facts.returnedGuard
  const hasDocstring = facts.docstring != ""
  return [
    {
      ok: facts.exportedTypes.includes("Request"),
      message: "missing `export type Request`"
    },
    {
      ok: hasTool,
      message: "missing `export def tool(request: Request)`"
    },
    {
      ok: hasMain,
      message: "missing `export node main(request: Request)`"
    },
    ...unexpectedExportRules(facts.exportedTypes, "Request", "type"),
    ...unexpectedExportRules(facts.exportedDefs, "tool", "def"),
    ...unexpectedExportRules(facts.exportedNodes, "main", "node"),
    ...unexpectedExportRules(facts.exportedConsts, "", "const"),
    {
      ok: !hasTool || facts.toolSignature =~ re/^tool\(request: Request\): Result</,
      message: "`tool` must be declared `tool(request: Request): Result<...>`, got `${facts.toolSignature}`"
    },
    {
      ok: !hasMain || facts.mainSignature =~ re/^main\(request: Request\): Result</,
      message: "`main` must be declared `main(request: Request): Result<...>`, got `${facts.mainSignature}`"
    },
    {
      ok: !hasTool || guard != null,
      message: "`tool` must return a guard(time:, cost:) block directly: `return guard(...) { ... }`"
    },
    {
      ok: guard == null || facts.guardLimits.includes("time") && facts.guardLimits.includes("cost"),
      message: "the guard in `tool` needs both a time: and a cost: limit"
    },
    {
      ok: guard == null || guardHasFinalize(guard),
      message: "the guard in `tool` needs a finalize block that returns partial results"
    },
    {
      ok: facts.approveCount == 0,
      message: "`with approve` is not allowed in a tool; the caller decides approvals"
    },
    {
      ok: !hasTool || hasDocstring,
      message: "`tool` needs a docstring"
    },
    {
      ok: !hasDocstring || facts.docstring =~ re/@param request/,
      message: "the docstring on `tool` must document `@param request`"
    },
    {
      ok: !hasDocstring || facts.docstring =~ re/Example:/,
      message: "the docstring on `tool` must include an `Example:` call"
    },
  ]
}

export idempotent def checkToolShape(source: string): string[] {
  """
  Check that Agency source has the shape of a toolbox tool. It must
  export exactly `type Request`, `def tool(request: Request): Result<...>`,
  and `node main(request: Request): Result<...>`. `tool` must return a
  guard with time and cost limits and a finalize, and must not use
  `with approve`. `tool` must have a docstring with `@param request` and
  an example call. Returns one message per problem, empty when the
  source conforms.

  @param source - Agency source code of a tool module
  """
  const facts = shapeFacts(source)
  if (facts is failure(parseErr)) {
    return ["parse error: ${parseErr}"]
  }
  const failing = filter(shapeRules(facts.value), \rule -> !rule.ok)
  return map(failing, \rule -> rule.message)
}

/** The settings one writeTool call hands every pipeline stage. */
type DraftSettings = {
  purpose: string;
  exampleRequest: string;
  stagingDir: string;
  maxTime: number;
  maxCost: number;
  model: string;
  provider: string
}

/** A draft that passed the shape check, the review, and (for a pure tool)
  its own tests. `casesJson` is null when the tool was not tested. */
type Draft = {
  source: string;
  casesJson?: string
}

type GeneratedCases = {
  cases: any[]
}

static const exampleTool = """
import { researcherAgent } from "std::agents/composable/researcher"

/** @module
  @summary Fetch and summarize today's news for a list of topics.
*/

export type Request = {
  topics: string[];
  maxItems: number
}

export def tool(request: Request): Result<string> {
  \"\"\"
  Summarize today's news for the given topics. Each topic is researched
  separately, then the results are merged into one Markdown summary of
  at most maxItems headlines.

  Example: tool({ topics: ["tech", "science"], maxItems: 10 })

  @param request - The topics to cover and the maximum number of headlines
  \"\"\"
  return guard(time: 180000, cost: 1) {
    let collected = ""
    const perTopic = fork(request.topics) as topic {
      return researcherAgent("Today's top \${topic} news, \${request.maxItems} items, with sources.")
    }
    collected = perTopic.join("\\n\\n")
    return llm("Merge these into one Markdown summary of at most \${request.maxItems} headlines:\\n\${collected}")

    finalize {
      return collected
    }
  }
}

export node main(request: Request): Result<string> {
  return tool(request)
}
"""

// maxTime and maxCost arrive as numbers (milliseconds and dollars), so the
// generated guard reads `guard(time: 180000, cost: 1)`. The example above
// uses the same numeric form so the model copies it.
def brief(settings: DraftSettings, feedback: string): string {
  let requestLine = ""
  if (settings.exampleRequest != "") {
    requestLine = "The user request that prompted this tool: \"${settings.exampleRequest}\"."
  }
  let feedbackBlock = ""
  if (feedback != "") {
    feedbackBlock = """
## Feedback on the previous draft
${feedback}
Fix every point above in the new draft.
"""
  }
  return """
Write a reusable Agency tool module. Purpose: ${settings.purpose}
${requestLine}

The module must have exactly this shape, and nothing else exported:

1. `export type Request = { ... }` — every input the tool needs. No hardcoded topics, paths, or counts in the body; pass them in through Request. Do not hardcode dates either. Call `today()` from std::date instead of adding a date field to Request.
2. `export def tool(request: Request): Result<ReturnType>` — the work. The docstring must: state what the tool does; include a line `Example: tool({ ... })` showing one call; and document `@param request`. The body is one guard, with time in milliseconds and cost in dollars: `return guard(time: ${settings.maxTime}, cost: ${settings.maxCost}) { ... finalize { return <partial result> } }`.
3. `export node main(request: Request): Result<ReturnType>` — one line: `return tool(request)`.

Rules:
- Imports name std:: modules only.
- Never write `with approve`.
- A module doc comment at the top with an @summary line.

Here is a complete example of the shape:

```agency
${exampleTool}
```
${feedbackBlock}
"""
}

def casesBrief(source: string): string {
  return """
Write two test cases for this Agency tool module as JSON. Reply with
{ "cases": [ ... ] }. Each case: { "nodeName": "main", "args": { "request": <a Request value> }, "expectedOutput": <the plain value the guard returns, without the Result wrapper> }.
The first case is the happy path; the second is an edge case (an empty list, zero items). The tool is pure computation, so every expected value is exact.

```agency
${source}
```
"""
}

// main returns the guard's Result, so the expected value is wrapped in the
// runtime's own Result envelope; the model supplies plain values.
def expectedResult(value: any): string {
  return JSON.stringify(success(value))
}

def testFileJson(cases: any[]): string {
  const tests = map(
    cases,
    \testCase -> {
      nodeName: testCase.nodeName ?? "main",
      args: testCase.args ?? {},
      expectedOutput: expectedResult(testCase.expectedOutput),
      evaluationCriteria: [{
        type: "exact"
      }]
    },
  )
  return JSON.stringify({
    sourceFile: "tool.agency",
    tests: tests
  }, null, 2)
}

def metaJson(name: string, exampleRequest: string): string {
  return JSON.stringify(
    {
      name: name,
      createdAt: format(now()),
      createdFrom: exampleRequest,
      version: 1,
      uses: 0,
      lastUsedAt: null,
      recentOutcomes: []
    },
    null,
    2,
  )
}

def toolEffects(source: string): string[] {
  const described = describe(source)
  if (described is failure) {
    return []
  }
  const exported = toolExport(described.value)
  if (exported == null) {
    return []
  }
  return exported.effects
}

// llm() raises no interrupt, so it never shows in the effect list; the call
// itself is the signal.
def callsModel(source: string): boolean {
  const calls = getNodesOfType(source, ["functionCall"]) catch []
  return some(calls, \call -> call.functionName == "llm")
}

def isPure(source: string): boolean {
  return toolEffects(source).join(",") == PURE_EFFECTS && !callsModel(source)
}

// ---- the writeTool pipeline ----

def draftSource(settings: DraftSettings, feedback: string): Result<string> {
  const drafted = agencyCodingAgent(
    task: brief(settings, feedback),
    requireMain: true,
    dir: settings.stagingDir,
    model: settings.model,
    provider: settings.provider,
  )
  if (drafted is failure(writeFailure)) {
    return failure(writeFailure.problems.join("\n"))
  }
  return drafted
}

// Static checks first, so a draft with the wrong shape never costs a
// review-agent call.
def reviewSource(source: string, settings: DraftSettings): Result<string> {
  const shapeProblems = checkToolShape(source)
  if (shapeProblems.length > 0) {
    return failure(shapeProblems.join("\n"))
  }
  const reviewed = agencyReviewAgent(
    source,
    task: brief(settings, ""),
    dir: settings.stagingDir,
    model: settings.model,
    provider: settings.provider,
  )
  if (reviewed is failure(reviewErr)) {
    return failure("review failed: ${reviewErr}")
  }
  const errors = filter(reviewed.value, \finding -> finding.error)
  if (errors.length > 0) {
    return failure(map(errors, \finding -> finding.feedback).join("\n"))
  }
  return success(source)
}

def failedCases(report: TestReport): string[] {
  const failing = filter(report.cases, \caseReport -> !caseReport.pass)
  return map(failing, \caseReport -> "${caseReport.node}: ${caseReport.feedback}")
}

// Only a pure tool gets generated tests: a tool that calls a model or the
// network has no output an exact test can predict.
def testSource(source: string, settings: DraftSettings): Result<Draft> {
  const wroteSource = write("tool.agency", source, settings.stagingDir)
  if (wroteSource is failure) {
    return wroteSource
  }
  if (!isPure(source)) {
    return success({
      source: source,
      casesJson: null
    })
  }
  const generated: GeneratedCases = llm(
    casesBrief(source),
    llmOptions(model: settings.model, provider: settings.provider),
  )
  const casesJson = testFileJson(generated.cases)
  const wroteCases = write("tool.test.json", casesJson, settings.stagingDir)
  if (wroteCases is failure) {
    return wroteCases
  }
  const report = testFile(settings.stagingDir, "tool.test.json")
  if (report is failure(testErr)) {
    return failure("tests could not run: ${testErr}")
  }
  if (!report.value.pass) {
    return failure("tests failed:\n${failedCases(report.value).join("\n")}")
  }
  return success({
    source: source,
    casesJson: casesJson
  })
}

def prepareDraft(settings: DraftSettings, feedback: string): Result<Draft> {
  const source = draftSource(settings, feedback)
  if (source is failure) {
    return source
  }
  const reviewed = reviewSource(source.value, settings)
  if (reviewed is failure) {
    return reviewed
  }
  return testSource(reviewed.value, settings)
}

// A rejected interrupt makes this function return a Failure; a bare
// approve() carries no value and counts as accept.
def askUser(
  name: string,
  settings: DraftSettings,
  draft: Draft,
): Result<WriteToolReview> {
  const answer = interrupt std::toolbox::review("Review this tool before it is saved", {
    name: name,
    stagingDir: settings.stagingDir,
    source: draft.source,
    effects: toolEffects(draft.source),
    tested: draft.casesJson != null
  })
  if (answer is failure) {
    return answer
  }
  if (answer == null || answer == true) {
    return success({
      verdict: "accept"
    })
  }
  if (answer.verdict == "accept" || answer.verdict == "revise") {
    return success(answer)
  }
  return failure("unrecognized review answer: ${JSON.stringify(answer)}")
}

// The staged directory already holds tool.agency (and tool.test.json when
// the tool was tested); add meta.json and publish the whole directory with
// one rename, so a tool is either fully present or absent. The existence
// check is repeated here because the one in checkName is stale after the
// model calls.
def saveTool(
  root: string,
  name: string,
  draft: Draft,
  exampleRequest: string,
  stagingDir: string,
): Result<ToolEntry> {
  const savedMeta = write("meta.json", metaJson(name, exampleRequest), stagingDir)
  if (savedMeta is failure) {
    return savedMeta
  }
  const taken = try _exists(name, root, [])
  if (taken is failure) {
    return taken
  }
  if (taken.value) {
    return failure(
      "a tool named `${name}` appeared in ${root} while this one was being written",
    )
  }
  const published = move(stagingDir, "${root}/${name}")
  if (published is failure) {
    return published
  }
  return success(entryFor(root, name))
}

// `feedback` is the only state carried between rounds: the last problem,
// or the user's revision request.
def rounds(
  root: string,
  name: string,
  settings: DraftSettings,
  maxRounds: number,
): Result<ToolEntry> {
  let feedback = ""
  for (round in range(maxRounds)) {
    const prepared = prepareDraft(settings, feedback)
    if (prepared is failure(problem)) {
      feedback = "${problem}"
    } else if (prepared is success(draft)) {
      const answer = askUser(name, settings, draft)
      if (answer is failure) {
        return answer
      } else if (answer is success(review)) {
        if (review.verdict == "accept") {
          return saveTool(
            root,
            name,
            draft,
            settings.exampleRequest,
            settings.stagingDir,
          )
        }
        feedback = review.feedback
      }
    }
  }
  return failure("gave up after ${maxRounds} rounds; last problem:\n${feedback}")
}

def checkName(name: string, dir: string, root: string): Result {
  if (dir == "") {
    return failure("dir must name the toolbox directory; got an empty string")
  }
  if (!(name =~ re/^[a-z][A-Za-z0-9]*$/)) {
    return failure("tool name must be a camelCase identifier, got `${name}`")
  }
  if (name.length > MAX_TOOL_NAME_LEN) {
    return failure(
      "tool name must be at most ${MAX_TOOL_NAME_LEN} characters, got ${name.length}",
    )
  }
  const taken = try _exists(name, root, [])
  if (taken is failure) {
    return taken
  }
  if (taken.value) {
    return failure("a tool named `${name}` already exists in ${root}")
  }
  return success(null)
}

export def writeTool(
  name: string,
  purpose: string,
  exampleRequest: string = "",
  dir: string = "~/.agency-agent/tools",
  maxRounds: number = 3,
  maxTime: number = 3m,
  maxCost: number = $1.00,
  model: string = "",
  provider: string = "",
): Result<ToolEntry> {
  """
  Write a reusable tool into a toolbox directory. The coding agent drafts
  the tool against a fixed contract. writeTool checks and reviews the
  draft, tests it when it is pure computation, shows it to the user for
  acceptance or revision, and saves it.

  @param name - The tool's name; also its directory under dir
  @param purpose - What the tool should do, in plain language
  @param exampleRequest - The user request that prompted this tool, or ""
  @param dir - The toolbox directory to write into
  @param maxRounds - Draft-review rounds before giving up
  @param maxTime - Time limit baked into the tool's guard
  @param maxCost - Cost limit baked into the tool's guard
  @param model - Model override for the coding and review agents, or ""
  @param provider - Provider for the model override
  """
  // Expanded once here: the sandboxed testFile resolves paths without
  // expanding `~`, unlike the file primitives.
  const root = expandPath(dir)
  const nameOk = checkName(name, dir, root)
  if (nameOk is failure) {
    return nameOk
  }
  const stagingDir = "${root}/.staging/${name}"
  const cleared = remove(stagingDir)
  if (cleared is failure) {
    return cleared
  }
  const made = mkdir(stagingDir)
  if (made is failure) {
    return made
  }
  const settings: DraftSettings = {
    purpose: purpose,
    exampleRequest: exampleRequest,
    stagingDir: stagingDir,
    maxTime: maxTime,
    maxCost: maxCost,
    model: model,
    provider: provider
  }
  const outcome = rounds(root, name, settings, maxRounds)
  // After a publish the staging directory is already gone; remove is a no-op.
  const removed = remove(stagingDir)
  if (removed is failure(removeErr)) {
    if (outcome is failure(outcomeErr)) {
      return failure(
        "${outcomeErr}\n(could not clear staging directory ${stagingDir}: ${removeErr})",
      )
    }
    return failure(
      "tool saved to ${root}/${name}, but could not clear staging directory ${stagingDir}: ${removeErr}",
    )
  }
  return outcome
}
