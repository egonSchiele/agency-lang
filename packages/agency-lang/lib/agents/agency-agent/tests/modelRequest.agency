import { Resolved } from "../lib/models.agency"
import {
  ModelFlags,
  ModelRequest,
  detectionInputs,
  localModelOf,
  modelFlagsFromArgs,
  noModelChoices,
  noModelFlags,
  presetModelSettings,
  requestEffort,
  requestLayers,
  requestLlmOptions,
  requestProvider,
 } from "../lib/modelRequest.agency"
import { buildLayers, resolveAll, Ctx } from "../lib/resolution.agency"
import { knownProviders } from "../lib/models.agency"
import { ModelSettings } from "../lib/settings.agency"

static const CTX: Ctx = {
  provider: "anthropic",
  price: "standard"
}

def request(flags: ModelFlags, preset: any, choices: any): ModelRequest {
  return {
    flags: flags,
    preset: preset,
    choices: choices
  }
}

def withPin(pin: string): ModelFlags {
  return {
    ...noModelFlags(),
    pin: pin
  }
}

// Resolve one slot through the real layers and report model + via.
def resolvedSlot(req: ModelRequest, settings: ModelSettings, slot: string): string {
  const layers = buildLayers(requestLayers(req, settings), knownProviders(), true)
  const all = resolveAll(layers, CTX)
  if (isFailure(all)) {
    return "failed: ${all.error}"
  }
  const resolved: Resolved = all.value[slot]
  return "${resolved.model} (${resolved.via})"
}

static const SETTINGS: ModelSettings = {
  slots: { reasoning: "settings-reasoning" }
}

static const PRESET = {
  provider: "anthropic",
  slots: { reasoning: "preset-reasoning", main: "preset-main" }
}

node presetSlotBeatsSettings(): string {
  return resolvedSlot(request(noModelFlags(), PRESET, noModelChoices()), SETTINGS, "reasoning")
}

node flagBeatsPreset(): string {
  const flags = {
    ...noModelFlags(),
    slots: { reasoning: "flag-reasoning" }
  }
  return resolvedSlot(request(flags, { slots: { reasoning: "preset-reasoning" } }, noModelChoices()), SETTINGS, "reasoning")
}

node sessionChoiceBeatsAll(): string {
  const flags = {
    ...noModelFlags(),
    slots: { reasoning: "flag-reasoning" }
  }
  const choices = {
    pin: "",
    slots: { reasoning: "session-reasoning" }
  }
  return resolvedSlot(request(flags, PRESET, choices), SETTINGS, "reasoning")
}

// A flag for a different slot still drops every model field of the preset.
node anyModelFlagDropsThePresetModels(): string {
  const flags = {
    ...noModelFlags(),
    slots: { main: "flag-main" }
  }
  return resolvedSlot(request(flags, PRESET, noModelChoices()), SETTINGS, "reasoning")
}

node providerOnlyCountsAsAModelFlag(): ModelSettings {
  const flags = {
    ...noModelFlags(),
    provider: "openai"
  }
  return presetModelSettings(request(flags, PRESET, noModelChoices()))
}

node providerOrder(): string {
  const fromPreset = requestProvider(request(noModelFlags(), PRESET, noModelChoices()), { provider: "google" })
  const fromSettings = requestProvider(request(noModelFlags(), null, noModelChoices()), { provider: "google" })
  const fromFlag = requestProvider(request({ ...noModelFlags(), provider: "openai" }, PRESET, noModelChoices()), {})
  return "${fromFlag} ${fromPreset} ${fromSettings}"
}

node detectionSeesThePresetModels(): string {
  const inputs = detectionInputs(request(noModelFlags(), PRESET, noModelChoices()))
  return "${inputs.pin}|${inputs.main}|${inputs.reasoning}"
}

node localPresetRunsLocal(): string {
  const preset = {
    local: "qwen3.5-2b",
    slots: { embedding: "mlx/nomic-embed" }
  }
  const local = localModelOf(request(noModelFlags(), preset, noModelChoices()))
  if (local == null) {
    return "hosted"
  }
  return "${local.model}|${local.embedding}"
}

node modelFlagOverridesALocalPreset(): string {
  const local = localModelOf(request(withPin("claude-opus-4-8"), { local: "qwen3.5-2b" }, noModelChoices()))
  if (local == null) {
    return "hosted"
  }
  return local.model
}

node flagsFromArgs(): ModelFlags {
  const args = {
    flags: { model: "reasoning=opus", fastmodel: "sonnet", provider: "anthropic" },
    positionals: []
  }
  const parsed = modelFlagsFromArgs(args)
  if (isFailure(parsed)) {
    return noModelFlags()
  }
  return parsed.value
}

node fastmodelBeatsModelMainFlag(): ModelFlags {
  const args = {
    flags: { model: "main=opus", fastmodel: "sonnet" },
    positionals: []
  }
  const parsed = modelFlagsFromArgs(args)
  if (isFailure(parsed)) {
    return noModelFlags()
  }
  return parsed.value
}

node localWithChatFlagIsAnError(): boolean {
  const args = {
    flags: { local: "qwen3.5-2b", model: "gpt-5.5" },
    positionals: []
  }
  return isFailure(modelFlagsFromArgs(args))
}

node localWithEmbeddingFlagIsFine(): ModelFlags {
  const args = {
    flags: { local: "qwen3.5-2b", model: "embedding=mlx/nomic-embed" },
    positionals: []
  }
  const parsed = modelFlagsFromArgs(args)
  if (isFailure(parsed)) {
    return noModelFlags()
  }
  return parsed.value
}

static const FIREWORKS = { openRouter: { provider: { only: ["fireworks"] } } }
static const AVOID = { openRouter: { provider: { ignore: ["open-inference"] } } }
static const WARM = { temperature: 0.7 }

def optionsFor(flags: ModelFlags, preset: any, choices: any, settings: ModelSettings): string {
  return JSON.stringify(requestLlmOptions(request(flags, preset, choices), settings))
}

node sessionOptionsBeatThePreset(): string {
  const choices = { ...noModelChoices(), llmOptions: WARM }
  return optionsFor(noModelFlags(), { pin: "p", llmOptions: FIREWORKS }, choices, { llmOptions: AVOID })
}

node presetOptionsBeatSettings(): string {
  return optionsFor(noModelFlags(), { pin: "p", llmOptions: FIREWORKS }, noModelChoices(), { llmOptions: AVOID })
}

node settingsOptionsWhenThePresetHasNone(): string {
  return optionsFor(noModelFlags(), { pin: "p" }, noModelChoices(), { llmOptions: AVOID })
}

node noOptionsAnywhere(): string {
  return optionsFor(noModelFlags(), null, noModelChoices(), {})
}

node aModelFlagDropsThePresetOptions(): string {
  return optionsFor(withPin("flag-model"), { pin: "p", llmOptions: FIREWORKS }, noModelChoices(), {})
}

node aLocalPresetKeepsItsOptions(): string {
  return optionsFor(noModelFlags(), { local: "qwen3.5-2b", llmOptions: WARM }, noModelChoices(), {})
}

def flagsFor(flags: Record<string, any>): Result<ModelFlags> {
  return modelFlagsFromArgs({
    flags: flags,
    positionals: []
  })
}

node routerFlagWithoutProviderIsRefused(): string {
  const parsed = flagsFor({ model: "router=jev-1.14" })
  if (parsed is failure(reason)) {
    return reason
  }
  return "accepted"
}

// typesafe and laya are not chat providers, but the router accepts them.
node routerAcceptsTypesafeAndLaya(): string {
  const typesafe = request(unwrapFlags(flagsFor({ model: "router=typesafe/jev-1.14" })), null, noModelChoices())
  const laya = request(unwrapFlags(flagsFor({ model: "router=laya/laya" })), null, noModelChoices())
  return "${resolvedProvider(typesafe, "router")}|${resolvedProvider(laya, "router")}"
}

// A chat slot still does not take typesafe as a provider: the whole value
// stays the model name, on the session's provider.
node mainSlotDoesNotTakeTypesafe(): string {
  const req = request(unwrapFlags(flagsFor({ model: "main=typesafe/jev-1.14" })), null, noModelChoices())
  return resolvedProvider(req, "main")
}

node localWithRouterFlagIsFine(): string {
  const parsed = flagsFor({ local: "qwen3.5-2b", model: "router=openrouter/jev-1.14" })
  if (parsed is failure(reason)) {
    return reason
  }
  const local = localModelOf(request(parsed.value, null, noModelChoices()))
  if (local == null) {
    return "hosted"
  }
  return "${local.model}|${local.router}"
}

def unwrapFlags(parsed: Result<ModelFlags>): ModelFlags {
  if (isFailure(parsed)) {
    return noModelFlags()
  }
  return parsed.value
}

def resolvedProvider(req: ModelRequest, slot: string): string {
  const layers = buildLayers(requestLayers(req, {}), knownProviders(), false)
  const all = resolveAll(layers, CTX)
  if (isFailure(all)) {
    return "failed: ${all.error}"
  }
  const resolved: Resolved = all.value[slot]
  return "${resolved.provider}:${resolved.model}"
}

def effortFor(flags: ModelFlags, preset: any): string {
  return "${requestEffort(request(flags, preset, noModelChoices()))}"
}

node effortFlagBeatsThePreset(): string {
  return effortFor({ ...noModelFlags(), effort: "low" }, { pin: "p", effort: "high" })
}

node presetEffortWhenThereIsNoFlag(): string {
  return effortFor(noModelFlags(), { pin: "p", effort: "high" })
}

// The preset's effort was chosen for its models, so it goes with them.
node aModelFlagDropsThePresetEffort(): string {
  return effortFor(withPin("claude-opus-4-8"), { pin: "p", effort: "high" })
}

node noEffortAnywhere(): string {
  return effortFor(noModelFlags(), { pin: "p" })
}

node effortFromArgs(): string {
  const parsed = modelFlagsFromArgs({ flags: { effort: "High" }, positionals: [] })
  if (isFailure(parsed)) {
    return "failed"
  }
  return "${parsed.value.effort}"
}

node badEffortIsAnError(): boolean {
  return isFailure(modelFlagsFromArgs({ flags: { effort: "max" }, positionals: [] }))
}

def effortWithChoices(choices: any): string {
  return "${requestEffort(request(noModelFlags(), { pin: "p", effort: "high" }, choices))}"
}

// /model changes the models the preset's effort was chosen for.
node aModelChoiceDropsThePresetEffort(): string {
  const pinned = effortWithChoices({ ...noModelChoices(), pin: "claude-opus-4-8" })
  const slotted = effortWithChoices({ ...noModelChoices(), slots: { reasoning: "claude-opus-4-8" } })
  return "${pinned}|${slotted}"
}

node anEmbeddingChoiceKeepsThePresetEffort(): string {
  return effortWithChoices({ ...noModelChoices(), slots: { embedding: "openai/text-embedding-3-small" } })
}

node aModelChoiceKeepsTheFlagEffort(): string {
  const flags = { ...noModelFlags(), effort: "low" }
  return "${requestEffort(request(flags, null, { ...noModelChoices(), pin: "claude-opus-4-8" }))}"
}
