// Hidden messages the author never sees, each with the category the
// support team would give it. Many sit on the two overlaps the
// test's facts settle: billing against refund, and bug against how-to.
//
// The cases run on a small model on purpose. A tool is worth writing when
// the work a strong model put into it makes a weak model good.
import { run } from "./toolbox/triageTicket/impl.agency"
import { setModel } from "std::llm"

def categoryOf(message: string): string {
  setModel("gpt-5-nano")
  const result: any = run({ message: message })
  return "${result.category}"
}

def urgencyOf(message: string): string {
  setModel("gpt-5-nano")
  const result: any = run({ message: message })
  return "${result.urgency}"
}

export node invoiceCopy(): string {
  return categoryOf("Can you send me a copy of my March invoice? I need it for my accountant.")
}

export node declinedRenewal(): string {
  return categoryOf("My renewal payment was declined but my bank says the card is fine. Can you check the charge on your side?")
}

export node planDifference(): string {
  return categoryOf("What is the difference in price between the Team plan and the Business plan?")
}

export node plainRefund(): string {
  return categoryOf("I signed up yesterday and this is not for me. Please give me my money back.")
}

export node crashOnExport(): string {
  return categoryOf("Every time I press Export the app closes itself. It has happened five times today.")
}

export node errorCode(): string {
  return categoryOf("Saving a project shows 'Error 500: internal server error' and nothing is saved.")
}

export node wrongTotals(): string {
  return categoryOf("The monthly report adds up my hours wrong. It shows 12 hours for a week where I logged 40.")
}

export node howToInvite(): string {
  return categoryOf("How do I invite a teammate to my workspace?")
}

export node findDarkMode(): string {
  return categoryOf("Where is the dark mode setting? I have looked through every menu.")
}

export node featureIdea(): string {
  return categoryOf("Love the app. It would be great if you added a calendar view some day.")
