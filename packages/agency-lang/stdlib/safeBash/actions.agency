// The std::github read effects a `gh` read raises. Each payload has the
// fields the effect declares in `std::github`. A `gh` command that names no
// repository gets its pair from the origin remote of a folder, which
// safeBash looks up between two plans. On the first plan the pair is ""
// and `lookup` names that folder; on the second the pair is filled and
// `lookup` is null.

/** The repository a `gh` command acts on. */
export type GhRepo = {
  owner: string;
  repo: string
}

export type GhNumberPayload = {
  owner: string;
  repo: string;
  number: number
}

/** `perPage` 0 means every page `gh` fetches for one pull request or issue. */
export type GhPagedPayload = {
  owner: string;
  repo: string;
  number: number;
  perPage: number;
  page: number
}

export type GhPrListPayload = {
  owner: string;
  repo: string;
  state: string;
  base: string;
  perPage: number;
  page: number
}

export type GhIssueListPayload = {
  owner: string;
  repo: string;
  state: string;
  labels: string[];
  perPage: number;
  page: number
}

export type GhSearchPayload = {
  owner: string;
  repo: string;
  query: string;
  perPage: number;
  page: number
}

export def ghPrGetEffect(payload: GhNumberPayload, lookup: string | null): Effect {
  """Build a std::github::prGet approval descriptor without raising it."""
  return { name: "std::github::prGet", payload: payload, lookup: lookup }
}

export def ghPrDiffEffect(payload: GhNumberPayload, lookup: string | null): Effect {
  """Build a std::github::prDiff approval descriptor without raising it."""
  return { name: "std::github::prDiff", payload: payload, lookup: lookup }
}

export def ghIssueGetEffect(payload: GhNumberPayload, lookup: string | null): Effect {
  """Build a std::github::issueGet approval descriptor without raising it."""
  return { name: "std::github::issueGet", payload: payload, lookup: lookup }
}

export def ghPrFilesEffect(payload: GhPagedPayload, lookup: string | null): Effect {
  """Build a std::github::prFiles approval descriptor without raising it."""
  return { name: "std::github::prFiles", payload: payload, lookup: lookup }
}

export def ghPrReviewListEffect(payload: GhPagedPayload, lookup: string | null): Effect {
  """Build a std::github::prReviewList approval descriptor without raising it."""
  return { name: "std::github::prReviewList", payload: payload, lookup: lookup }
}

export def ghPrReviewCommentListEffect(payload: GhPagedPayload, lookup: string | null): Effect {
  """Build a std::github::prReviewCommentList approval descriptor without raising it."""
  return { name: "std::github::prReviewCommentList", payload: payload, lookup: lookup }
}

export def ghPrChecksEffect(payload: GhPagedPayload, lookup: string | null): Effect {
  """Build a std::github::prChecks approval descriptor without raising it."""
  return { name: "std::github::prChecks", payload: payload, lookup: lookup }
}

export def ghIssueCommentListEffect(payload: GhPagedPayload, lookup: string | null): Effect {
  """Build a std::github::issueCommentList approval descriptor without raising it."""
  return { name: "std::github::issueCommentList", payload: payload, lookup: lookup }
}

export def ghPrListEffect(payload: GhPrListPayload, lookup: string | null): Effect {
  """Build a std::github::prList approval descriptor without raising it."""
  return { name: "std::github::prList", payload: payload, lookup: lookup }
}

export def ghIssueListEffect(payload: GhIssueListPayload, lookup: string | null): Effect {
  """Build a std::github::issueList approval descriptor without raising it."""
  return { name: "std::github::issueList", payload: payload, lookup: lookup }
}

export def ghIssueSearchEffect(payload: GhSearchPayload, lookup: string | null): Effect {
  """Build a std::github::issueSearch approval descriptor without raising it."""
  return { name: "std::github::issueSearch", payload: payload, lookup: lookup }
}

/** The folder whose origin remote names this effect's repository, or null
  when the effect names it already or is not a std::github effect. */
def lookupOf(effect: Effect): string | null {
  return match(effect.name) {
    "std::github::prGet" => effect.lookup
    "std::github::prDiff" => effect.lookup
    "std::github::issueGet" => effect.lookup
    "std::github::prFiles" => effect.lookup
    "std::github::prReviewList" => effect.lookup
    "std::github::prReviewCommentList" => effect.lookup
    "std::github::prChecks" => effect.lookup
    "std::github::issueCommentList" => effect.lookup
    "std::github::prList" => effect.lookup
    "std::github::issueList" => effect.lookup
    "std::github::issueSearch" => effect.lookup
    _ => null
  }
}

export def pendingLookups(effects: Effect[]): string[] {
  """
  The distinct folders whose origin remote these effects still need, in the order first seen.
  """
  let folders: string[] = []
  for (effect in effects) {
    const folder = lookupOf(effect)
    if (folder != null && !folders.includes(folder)) {
      folders.push(folder)
    }
  }
  return folders
}

// One variant per way a plan can be carried out, each carrying only the
// fields that way needs. The dispatch in `safeBash` matches over this union
// exhaustively, so adding a variant is a type error at the dispatch rather
// than a silent fall-through.
/** What happens if every effect in the plan is approved. */
export type Execution = BashExec | EchoExec | WriteExec | AgencyExec | RefuseExec | GrepExec | ReadExec | ChainExec

export type BashExec = {
  kind: "bash";
  command: string
}

export type EchoExec = {
  kind: "echo";
  content: string
}

/** An `agency <subcommand> <file>` line, run through std::agency's cli(). */
export type AgencyExec = {
  kind: "agency";
  args: string[]
}

export type WriteExec = {
  kind: "write";
  filename: string;
  dir: string;
  content: string;
  mode: WriteMode
}

/** Whether grep prints file names: `-H` gives "always", `-h` gives
 "never", neither gives "default". */
export type GrepFileNames = "default" | "always" | "never"

/** What a grep command said about printing. The rules that turn this
 into grep's output live in `_renderGrepOutput`
 (lib/stdlib/grepDialect.ts), whose type of the same name must keep
 these fields. */
export type GrepRender = {
  /** `-n` was given. */
  lineNumbers: boolean;
  fileNames: GrepFileNames;
  /** The path as bash hands it to grep, or "" when none was written. */
  argument: string;
  /** The path names one file, not a directory. */
  oneFile: boolean
}

/** A lone grep, run through the grep tool's own search with no shell.
 The search reads only what `payload` says, so the approval means what
 the grep tool's approval means. */
export type GrepExec = {
  kind: "grep";
  payload: GrepPayload;
  render: GrepRender
}

/**
Build the search execution from the same payload used by `grepEffect`.
*/
export def grepExecution(payload: GrepPayload, render: GrepRender): GrepExec {
  """Build a grep execution plan without running the search."""
  return {
    kind: "grep",
    payload: payload,
    render: render
  }
}

/** How the shell-free path prints a file: whole, numbered (cat -n), the
 first `lines` lines (head), or the last `lines` lines (tail). The rules
 live in `_renderReadView` (lib/stdlib/readDialect.ts), whose type of
 the same name must keep these fields. */
export type ReadView =
  | { kind: "whole" }
  | { kind: "numbered" }
  | { kind: "head"; lines: number }
  | { kind: "tail"; lines: number }

/** A lone cat of one or more files, or a head or tail of one, run
 through the read tool's own read with no shell. The read covers only
 what `payloads` names, so the approval means what the read tool's
 approval means. */
export type ReadExec = {
  kind: "read";
  payloads: ReadPayload[];
  view: ReadView
}

/** How a chain step follows the one before it: `;` always runs it, `&&`
 only after a success, `||` only after a failure. */
export type Join = "seq" | "and" | "or"

/** The executions a chain may hold: every in-process kind, and nothing
 that spawns a shell. */
export type StepExec = EchoExec | WriteExec | GrepExec | ReadExec

export type ChainStep = {
  join: Join;
  execution: StepExec
}

/** Several in-process commands joined by `;`, `&&`, or `||`, run left to
 right with bash's rule for each join. */
export type ChainExec = {
  kind: "chain";
  steps: ChainStep[]
}

/**
Build file reads from the same payloads used by `readEffect`.
*/
export def readExecution(payloads: ReadPayload[], view: ReadView): ReadExec {
  """Build a file-read execution plan without reading files."""
  return {
    kind: "read",
    payloads: payloads,
    view: view
  }
}

export type RefuseExec = {
  kind: "refuse";
  reason: string
}

/** Why a plan asks the broad std::bash question. `detail` is the parser
 message for `unparseable`, the first unrecognized command's message for
 `unrecognized`, the render failure for `unrenderable`, and "" for
 `noEffects`. */
export type BroadReason = {
  kind: "unparseable" | "unrecognized" | "noEffects" | "unrenderable";
  detail: string
}

/** The whole decision about one call to safeBash, made before anything runs. */
export type Plan = {
  effects: Effect[];
  execution: Execution;
  /** Why the plan asks the broad std::bash question, or null when it does not. */
  broadReason: BroadReason | null;
  /** The command word of every simple command planFor decided over, in
    order; "" for an assignment-only command; [] when unparseable. */
  verbs: string[]
}
