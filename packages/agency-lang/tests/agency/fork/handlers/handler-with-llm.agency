// Handler that makes its own llm() call to decide whether to approve or
// reject. The handler runs synchronously inside interruptWithHandlers; if
// it calls llm(), that llm has its own runPrompt, message thread, and
// state machinery. The user should never see the inner interrupt — the
// handler's llm-driven decision intercepts it.

def riskyOp(): string {
  interrupt("read the system clock and report the current time")
  return "operation completed"
}

type SafetyResp = {
  is_safe: boolean
}

node main() {
  handle {
    return riskyOp()
  } with (interrupt) {
    // Have the LLM decide based on the interrupt's message. The operation is
    // a plain read and the rule is mechanical, so every model answers the
    // same way -- the test is about the handler making its own llm() call,
    // not about how cautiously a model judges risk.
    const safety: SafetyResp = llm("An operation is about to run. Set is_safe to true if it only reads information and changes nothing, false if it creates, modifies, deletes, sends, or spends anything. Operation: '${interrupt.message}'.")
    if (safety.is_safe) {
      return approve()
    }
    return reject()
  }
}
