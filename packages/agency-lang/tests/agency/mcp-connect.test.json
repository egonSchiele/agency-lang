    { "nodeName": "httpServerRaisesNothing", "description": "an HTTP server starts no process and raises no mcp::connect", "input": "", "expectedOutput": "0", "evaluationCriteria": [{ "type": "exact" }] },
    { "nodeName": "reconnectAsksAgain", "description": "reconnecting a stdio server asks again, and a rejection leaves it failed", "input": "", "expectedOutput": "\"failed: starting it was not approved\"", "evaluationCriteria": [{ "type": "exact" }] }
