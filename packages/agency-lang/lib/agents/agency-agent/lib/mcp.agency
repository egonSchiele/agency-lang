/** @module MCP for the agency agent: connect the configured servers at
  startup without starting a login, and give the coordinator the tools of
  every connected server on each turn. The @agency-lang/mcp package holds
  each server's state, and this file keeps no copy, so a resumed session
  shows the new process's servers. The `/mcp` menu is in mcpMenu.agency.
  Sits above `settings.agency` (imports from it, nothing imports back), so
  there is no import cycle. */

import {
  McpServerState,
  connectMcpServers,
  mcpServerStates,
  mcpPackageProblem,
  mergeMcpServers,
  isMcpAvailable,
  readProjectMcpConfig,
 } from "std::mcp"
import { keys } from "std::object"
import { cwd } from "std::system"

import { Settings, getMcpServers } from "./settings.agency"

/** The global mcpServers merged with the project's. The project wins when
  both define a name. */
export def mergedMcpServers(settings: Settings): Record<string, any> {
  return mergeMcpServers(getMcpServers(settings), readProjectMcpConfig(cwd()))
}

/** "1 tool" or "<n> tools". */
export def toolCountText(count: number): string {
  if (count == 1) {
    return "1 tool"
  }
  return "${count} tools"
}

/** A server's state as one sentence. Startup, a finished login, and a
  reconnect all print it. */
export def stateLine(state: McpServerState): string {
  const tools = toolCountText(state.tools.length)
  return match(state.status) {
    "connected" => "✔ ${state.name} connected · ${tools}. You can use them from your next message."
    "needsLogin" => "${state.name} needs you to log in."
    _ => "${state.name} failed to connect: ${state.message}"
  }
}

/** The lines startup prints: the package problem alone when there is one,
  otherwise one line for each server that is not connected. */
export def startupLines(problem: string, states: McpServerState[]): string[] {
  if (problem != "") {
    return ["MCP: ${problem}"]
  }
  let lines: string[] = []
  for (state in states) {
    const line = stateLine(state)
    if (state.status == "needsLogin") {
      lines.push("MCP: ${line} Type /mcp to log in.")
    } else if (state.status == "failed") {
      lines.push("MCP: ${line}")
    }
  }
  return lines
}

/** Connect the configured servers. Never starts a login: a server that needs
  one gets a line telling the user to type /mcp. No-op when @agency-lang/mcp
  is not installed or no servers are configured. */
export def maybeLoadMcp(settings: Settings) {
  if (!isMcpAvailable()) {
    return
  }
  const merged = mergedMcpServers(settings)
  if (keys(merged).length == 0) {
    return
  }
  const problem = mcpPackageProblem()
  let states: McpServerState[] = []
  if (problem == "") {
    states = connectMcpServers(merged)
  }
  for (line in startupLines(problem, states)) {
    print(color.yellow(line))
  }
}

/** The tools of every connected MCP server, for the coordinator's tool list.
  Read from the package on every turn, so a login or log out in /mcp shows
  up on the next message. */
export def getMcpTools(): any[] {
  let tools: any[] = []
  for (state in mcpServerStates()) {
    tools = [...tools, ...state.tools]
  }
  return tools
}
