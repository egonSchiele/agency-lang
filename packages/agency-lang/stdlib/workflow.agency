import { compile, describe, run, typecheck, CompiledProgram, ExportInfo, ModuleInfo } from "std::agency"
import { now, format } from "std::date"
import { read } from "std::index"
import { filterEntries } from "std::object"
import { resolve } from "std::path"
import { exists } from "std::shell"
import { Json } from "std::validation"

import { _read, _write } from "agency-lang/stdlib-lib/builtins.js"
import { _mkdir, _realDir } from "agency-lang/stdlib-lib/fs.js"
import { _glob } from "agency-lang/stdlib-lib/shell.js"

import {
  _compileWorkflowSource,
  _pickSignatures,
  _problemsFailure,
  _problemsFromDiagnostics,
  _signatureSources,
  _toolRefs,
  _workflowFailure,
  _workflowNameProblem,
  _catalogEntries,
} from "agency-lang/stdlib-lib/workflow/index.js"

/** @module
@summary Check, run, and save workflows described as JSON steps.

```ts
import { add } from "std::math"
import { runWorkflow, Workflow } from "std::workflow"

node main() {
  const workflow: Workflow = {
    format: 1,
    name: "sum",
    description: "Add two numbers.",
    inputs: "{ a: number; b: number }",
    steps: [{
      id: "total",
      kind: "tool",
      module: "std::math",
      tool: "add",
      args: { a: { "$ref": "inputs.a" }, b: { "$ref": "inputs.b" } }
    }]
  }
  return runWorkflow(workflow, { a: 2, b: 3 }, [add])
}
```

Each step calls a supplied tool or asks a model. References can read inputs
or earlier step results. `checkWorkflow` checks the generated Agency program
without running the workflow. `runWorkflow` checks, requests approval, and
runs it in a subprocess whose interrupts reach the caller's handlers.

Pass original exported Agency functions as tools. Renamed, partially applied,
runtime-built, and package tools cannot be imported into a workflow. Local
tool files must be under `dir`.

Use `writeWorkflow` to save under `<dir>/workflows`, then `loadWorkflow` or
`listWorkflows` to read saved workflows. `workflowTool` and `workflowTools`
expose workflows as tools for an LLM. `catalog` describes available tool
parameters, return types, and effects for workflow authors.
*/

/** Caps on one run of a workflow, or on one step: `maxCost` in dollars and
  `maxTime` in milliseconds, each a positive number. The generated program
  wraps the whole body, or that step, in a guard with them. */
export type WorkflowLimits = {
  maxCost?: number;
  maxTime?: number
}

/** A workflow: a name, a description, the inputs as an Agency object type
  written as text, and the steps. `result` is a reference or a literal; the
  last step's value is returned without it. */
export type Workflow = {
  format: number;
  name: string;
  description: string;
  inputs: string;
  steps: Json[];
  result?: Json;
  limits?: WorkflowLimits;
  /** The effects the workflow may raise, as in an Agency function's `raises` clause (docs/site/guide/effects-and-raises.md). Left out means anything. `[]` means nothing. A built-in set name such as `FileRead` stands for its members, and `"*"` means anything. `checkWorkflow` reports each step that raises an effect not listed. */
  raises?: string[]
}

/** One thing wrong with a workflow, named by step and field. `step` and
  `field` are null only for a problem with the whole workflow. */
export type WorkflowProblem = {
  step: string | null;
  field: string | null;
  message: string
}

/** The data a refused workflow fails with. */
export type WorkflowFailure = {
  problems: WorkflowProblem[]
}

type ToolRef = {
  module: string;
  name: string
}

type Compiled = {
  source: string;
  ranges: Json;
  typeOwners: Json;
  warnings: WorkflowProblem[];
  wallClock: number | null
}

/** A workflow that passed the check: its compiled program, the warnings,
  and the subprocess wall clock (null for `run`'s default). */
type Checked = {
  program: CompiledProgram;
  warnings: WorkflowProblem[];
  wallClock: number | null
}

// Running a workflow. Raised after the check and before the subprocess
// starts, so a rejection starts nothing. An "always" answer pins the
// workflow directory and the workflow's name; the inputs are shown and
// never pinned, since they change with every run. `dir` is always an
// absolute path: a relative one would pin text that means a different
// directory under a different working directory, and the default `""`
// would give the pattern `{,/**}`, which matches every absolute path.
// A loaded workflow's name matches its file name. Caller-built workflows
// use the name in the supplied value.
@alwaysUnder(dir)
@always(name)
effect std::workflow::run {
  name: string;
  dir: string;
  inputs: Json
}

/** The tools one module provides, as `_signatureSources` groups them. */
type SignatureSource = {
  module: string;
  names: string[];
  reExport: string | null
}

/**
Describe a tool module with enough path context to resolve its local imports.
*/
@capabilities(fileRead)
def describeGroup(group: SignatureSource, dir: string): Result<ModuleInfo> {
  if (group.reExport != null) {
    return describe(group.reExport)
  }
  const text = read(group.module, dir)?
  return describe(text, dir: dir, filename: group.module)
}

/** What `describe` says about each tool, keyed by module and name. */
@hidden
@capabilities(fileRead)
export def _signatures(refs: ToolRef[], dir: string): Result<Record<string, ExportInfo>> {
  let signatures: Record<string, ExportInfo> = {}
  for (group in _signatureSources(refs)) {
    const info = describeGroup(group, dir)?
    const picked = _pickSignatures(group, info.exports)?
    signatures = { ...signatures, ...picked }
  }
  return success(signatures)
}

/** The generated source, the lines each step owns, and the warnings. */
@hidden
@capabilities(fileRead)
export def _compileWithRanges(workflow: Workflow, tools: any[], dir: string): Result<Compiled, WorkflowFailure> {
  const refs = _toolRefs(tools, dir)?
  const signatures = _signatures(refs, dir)
  if (signatures is failure) {
    return _workflowFailure(signatures.error)
  }
  return _compileWorkflowSource(workflow, refs, signatures.value)
}

/**
Use the generated source to inspect what a workflow will do, or pass it to
`compile` or `typecheck` from `std::agency`. Use `checkWorkflow` to run both
checks and report diagnostics against the workflow's steps and fields.
*/
@capabilities(fileRead)
export idempotent def compileWorkflow(workflow: Workflow, tools: any[], dir: string = ""): Result<string, WorkflowFailure> {
  """
  Generate Agency source for a workflow without running it.
  Failures identify the step and field with a problem.

  @param tools - Original exported Agency functions available to the workflow's steps.
  @param dir - Directory containing any local tool modules and resolving their paths.
  """
  const compiled = _compileWithRanges(workflow, tools, dir)?
  return success(compiled.source)
}

/** The check behind `checkWorkflow` and `runWorkflow`: generate, typecheck,
  and compile, keeping the compiled program so a run never compiles twice. */
@hidden
@capabilities(fileRead)
export def _checked(workflow: Workflow, tools: any[], dir: string): Result<Checked, WorkflowFailure> {
  const compiled = _compileWithRanges(workflow, tools, dir)?
  const source = compiled.source
  // The typecheck runs first: its errors carry a line and a payload, so each
  // one is mapped to its step and field. A strict compile reports the same
  // errors as one message, so it runs second, for what is left.
  const report = typecheck(source, dir: dir, strict: true)
  if (report is failure) {
    return _workflowFailure(report.error)
  }
  if (report.value.errors.length > 0) {
    return _problemsFailure(_problemsFromDiagnostics(report.value.errors, compiled.ranges, compiled.typeOwners))
  }
  const program = compile(source, dir, strict: true)
  if (program is failure) {
    return _workflowFailure(program.error)
  }
  return success({
    program: program.value,
    warnings: compiled.warnings,
    wallClock: compiled.wallClock
  })
}

/**
Use this before presenting or saving a workflow. Errors identify their step
and field. Success contains warnings for values that cannot be fully checked
until runtime, such as references into a tool result with no declared type.
*/
@capabilities(fileRead)
export idempotent def checkWorkflow(workflow: Workflow, tools: any[], dir: string = ""): Result<WorkflowProblem[], WorkflowFailure> {
  """
  Check a workflow without executing its steps, returning warnings on success.

  @param tools - Original exported Agency functions available to the workflow's steps.
  @param dir - Directory containing any local tool modules and resolving their paths.
  """
  const checked = _checked(workflow, tools, dir)?
  return success(checked.warnings)
}

/** One parameter a workflow step can pass to a tool. */
export type CatalogParam = {
  name: string;
  /** The declared type as Agency text, such as `string[]` or `Note`. Null when none is declared. */
  type: string | null;
  /** The default as Agency source, such as `0` or `null`. Null when the parameter has none, so a step must pass a value. */
  default: string | null;
  /** The text of the docstring's `@param` entry for this parameter, or null. */
  description: string | null;
  /** The JSON Schema a model sees for this parameter. */
  schema: Json
}

/** One tool a workflow may call. */
export type CatalogEntry = {
  /** What a step's `module` field says: `std::math`, or `./notes.agency` relative to `dir`. */
  module: string;
  name: string;
  /** The docstring without its `@param` entries, or the empty string. */
  description: string;
  /** The parameters a step can pass. A function-typed parameter is left out. */
  params: CatalogParam[];
  /** The declared return type as Agency text. Null when none is declared. */
  returns: string | null;
  /** What the tool can raise, as `describe` reports it. A tool that uses `guard` lists `std::guard`. `checkWorkflow`'s `raises` check leaves it out, since a guard trip is a question about budget, not a permission. */
  effects: string[]
}

/**
Use this to populate a workflow editor or inspect what arguments a step can
pass. Entries follow the supplied tool order. Invalid tool lists return
problems in failure data; a rejected or failed module read returns its own
failure instead.
*/
@capabilities(fileRead)
export idempotent def catalog(tools: any[], dir: string = ""): Result<CatalogEntry[]> {
  """
  Describe workflow tools with their parameters, schemas, return types, and effects.

  @param tools - Original exported Agency functions to describe.
  @param dir - Directory containing any local tool modules and resolving their paths.
  """
  const refs = _toolRefs(tools, dir)?
  const signatures = _signatures(refs, dir)
  if (signatures is failure) {
    // Returned as it came, so a rejected read keeps its `rejected` flag.
    return signatures
  }
  return success(_catalogEntries(tools, refs, signatures.value))
}

/**
Validation completes before run approval or subprocess startup. Step
failures identify the step that stopped the workflow. Each step's interrupts
still reach the caller's handlers.

Workflow and step limits are hard caps: the generated program rejects their
guard trips. A tool's own guard retains its handlers, so it can extend its
own budget within those caps. A caller policy that rejects `std::guard`
also rejects that extension.

An "always" run approval pins the resolved directory and workflow name.
It does not pin the inputs or the workflow's contents.
*/
@capabilities(fileRead, fileWrite, subprocess)
export def runWorkflow(workflow: Workflow, inputs: Json, tools: any[], dir: string = ""): Result<Json> {
  """
  Check a workflow, request approval, and execute its steps in a subprocess.

  @param inputs - A value matching the workflow's inputs type.
  @param tools - Original exported Agency functions available to the workflow's steps.
  @param dir - Directory containing local tool modules, defaulting to the working directory.
  """
  const where = resolve(dir)
  const checked = _checked(workflow, tools, where)?
  return interrupt std::workflow::run("Run the workflow ${workflow.name}?", {
    name: workflow.name,
    dir: where,
    inputs: inputs
  })
  const ran = run(compiled: checked.program, node: "main", args: { inputs: inputs }, wallClock: checked.wallClock)?
  return ran.data
}

// ---- a workflow as a tool ----

/** Why a workflow named `name` cannot be handed to a model beside `tools`,
  or null when it can: two tools with one name are refused at the model
  call. */
def nameClashProblem(name: string, tools: any[]): string | null {
  if (!some(tools, \tool -> tool.name == name)) {
    return null
  }
  return "workflow \"${name}\" has the same name as a tool the host passed; rename one of them"
}

/** The tool: runWorkflow with the workflow, the tools, and the directory
  bound, under the workflow's name and description, with the inputs schema
  as the type of its one parameter. */
def toolFor(workflow: Workflow, tools: any[], dir: string, inputsSchema: Json): any {
  const bound = runWorkflow.partial(workflow: workflow, tools: tools, dir: dir)
  const named = bound.rename(workflow.name).describe(workflow.description)
  return named.withParamSchema("inputs", inputsSchema)
}

/**
The returned tool uses the workflow's name and description. Its `inputs`
parameter has the workflow's input schema. Building it checks the workflow
and runs a schema node in a subprocess; calling it later runs the workflow.
A name shared with a supplied tool is refused.
*/
@capabilities(fileRead, fileWrite, subprocess)
export def workflowTool(workflow: Workflow, tools: any[], dir: string = ""): Result<any> {
  """
  Build an LLM-callable tool for a checked workflow.

  @param tools - Original exported Agency functions the workflow may call, with names distinct from the workflow.
  @param dir - Directory containing local tool modules, defaulting to the working directory.
  """
  const where = resolve(dir)
  const clash = nameClashProblem(workflow.name, tools)
  if (clash != null) {
    return failure(clash)
  }
  const checked = _checked(workflow, tools, where)?
  const inputsSchema = _inputsSchema(checked.program)?
  return success(toolFor(workflow, tools, where, inputsSchema))
}

/** One saved workflow as a tool, or the reason it cannot be one. */
def toolForEntry(entry: WorkflowEntry, tools: any[], dir: string): Result<any> {
  if (entry.meta.inputsSchema == null) {
    return failure("${entry.name} was saved before inputs schemas were recorded; save it again with writeWorkflow")
  }
  const clash = nameClashProblem(entry.name, tools)
  if (clash != null) {
    return failure(clash)
  }
  return success(toolFor(entry.workflow, tools, dir, entry.meta.inputsSchema))
}

/**
Use saved input schemas to build tools without starting a subprocess.
Saved workflows are checked against the current tools when called.
A missing schema requires saving the workflow again with `writeWorkflow`.
*/
@capabilities(fileRead)
export def workflowTools(dir: string, tools: any[]): Result<any[]> {
  """
  Build one LLM-callable tool per saved workflow, in name order.

  @param dir - Nonempty project directory holding the workflows folder.
  @param tools - Original exported Agency functions the workflows may call, with names distinct from the workflows.
  """
  const listed = listWorkflows(dir)?
  const where = resolve(dir)
  const built = map(listed, \entry -> toolForEntry(entry, tools, where))
  const broken = find(built, \tool -> isFailure(tool))
  if (broken != null) {
    return broken
  }
  return success(map(built, \tool -> tool.value))
}

// ---- saving and loading ----

const WORKFLOWS_DIR = "workflows"
const FILE_SUFFIX = ".json"
const MAX_WORKFLOWS = 500
const INPUTS_SCHEMA_NODE = "inputsSchema"

/** What a saved workflow's file records beside the workflow. */
export type WorkflowMeta = {
  /** When the workflow was last saved, as ISO text. */
  savedAt: string;
  /** What saved it, such as `writeWorkflow`. */
  savedBy: string;
  /** The JSON Schema of the workflow's `inputs` type, from the program's
    own `inputsSchema` node at save time; null for a workflow saved before
    schemas were recorded. */
  inputsSchema: Json | null
}

/** A saved workflow: its name, the file it is saved in, the workflow, and
  the record saved with it. */
export type WorkflowEntry = {
  name: string;
  path: string;
  workflow: Workflow;
  meta: WorkflowMeta
}

/** The meta record as written; every field may be missing. */
type MetaFile = {
  savedAt?: string;
  savedBy?: string;
  inputsSchema?: Json
}

/** A saved file as written. */
type SavedFile = {
  workflow: Workflow;
  meta?: MetaFile
}

const DEFAULT_META: WorkflowMeta = {
  savedAt: "",
  savedBy: "",
  inputsSchema: null
}

/** Raised before saved workflows are read. `dir` is the real path of the
  project's `workflows` folder, and an "always" answer pins that folder. */
@alwaysUnder(dir)
effect std::workflow::scan {
  dir: string
}

/** Raised once before a workflow is saved, after its check passes. `dir`
  is the real path of the project's `workflows` folder. Saving a name that
  exists replaces that workflow, so an "always" answer pins the name as
  well as the folder. */
@alwaysUnder(dir)
@always(name)
effect std::workflow::save {
  dir: string;
  name: string;
  workflow: Workflow
}

// An empty `dir` is refused because the file primitives would resolve it
// to the process cwd. Every prompt names the real spelling, so an "always"
// answer pins the folder that is actually read and written.
@capabilities(fileRead)
def expandRoot(dir: string): Result<string> {
  if (dir == "") {
    return failure("dir must name the project directory; got an empty string")
  }
  return try _realDir(dir)
}

def savedFile(name: string): string {
  return "${WORKFLOWS_DIR}/${name}${FILE_SUFFIX}"
}

/** The JSON Schema of the program's `Inputs` type, from its `inputsSchema` node. */
@hidden
@capabilities(fileWrite, subprocess)
export def _inputsSchema(program: CompiledProgram): Result<Json> {
  const ran = run(compiled: program, node: INPUTS_SCHEMA_NODE)
  if (ran is failure(runErr)) {
    return failure("could not derive the inputs schema: ${runErr}")
  }
  return success(ran.value.data)
}

/**
Checks the workflow before requesting save approval. It then derives the
input schema in a subprocess and saves it alongside the workflow.
Neither a rejected save nor a rejected schema run writes the workflow.
Saving an existing name replaces its file.
*/
@capabilities(fileRead, fileWrite, subprocess)
export def writeWorkflow(workflow: Workflow, tools: any[], dir: string): Result<WorkflowEntry> {
  """
  Check and save a workflow as `<dir>/workflows/<name>.json` after approval.
  An existing workflow with that name is replaced.

  @param tools - Original exported Agency functions available to the workflow's steps.
  @param dir - Existing project directory containing any local tool modules.
  """
  const root = expandRoot(dir)?
  if (!exists(root)) {
    return failure("${root} does not exist; dir must name an existing project directory")
  }
  // The check also proves `name` is an identifier, so it is safe in a file name.
  const checked = _checked(workflow, tools, root)?
  const folder = "${root}/${WORKFLOWS_DIR}"
  return interrupt std::workflow::save("Save the workflow ${workflow.name}?", {
    dir: folder,
    name: workflow.name,
    workflow: workflow
  })
  // After the save prompt, so a rejected save starts no process, and
  // before the write, so a rejected `std::run` leaves nothing on disk.
  const inputsSchema = _inputsSchema(checked.program)?
  const meta: WorkflowMeta = {
    savedAt: format(now()),
    savedBy: "writeWorkflow",
    inputsSchema: inputsSchema
  }
  const file = savedFile(workflow.name)
  destructive {
    const made = try _mkdir(folder)?
    const content = JSON.stringify({ workflow: workflow, meta: meta }, null, 2)
    const wrote = try _write(root, file, content, "overwrite")?
  }
  return success({
    name: workflow.name,
    path: "${root}/${file}",
    workflow: workflow,
    meta: meta
  })
}

def isPresent(value: Json, key: string): boolean {
  return value != null
}

// The shape check fills a missing field with null, and a null would win
// over the default in a spread, so only the fields the file has are kept.
def metaOf(file: MetaFile | null): WorkflowMeta {
  if (file == null) {
    return DEFAULT_META
  }
  return {
    ...DEFAULT_META,
    ...filterEntries(file, isPresent)
  }
}

// Every failure starts with the workflow's name, so a caller can return it
// as it is.
@capabilities(fileRead)
def entryFor(root: string, name: string): Result<WorkflowEntry> {
  const file = savedFile(name)
  const raw = try _read(root, file, 0, 0)
  if (raw is failure(readErr)) {
    return failure("${name}: ${file} could not be read: ${readErr}")
  }
  const parsed = try JSON.parse(raw.value)
  if (parsed is failure(parseErr)) {
    return failure("${name}: ${file} is not valid JSON: ${parseErr}")
  }
  const saved: SavedFile! = parsed.value
  if (saved is failure(shapeErr)) {
    return failure("${name}: ${file} is not a saved workflow: ${shapeErr}")
  }
  // `std::workflow::run` names the workflow by its own `name`, so a copied
  // file that kept the old name would run under an approval for the old one.
  const workflow = saved.value.workflow
  if (workflow.name != name) {
    return failure("${name}: ${file} holds a workflow named ${workflow.name}; the file name and the workflow's name must match")
  }
  return success({
    name: name,
    path: "${root}/${file}",
    workflow: workflow,
    meta: metaOf(saved.value.meta)
  })
}

/**
The saved workflow's name must match its filename. Loading reads the file
and checks its shape; it does not check the steps against available tools.
*/
@capabilities(fileRead)
export def loadWorkflow(name: string, dir: string): Result<WorkflowEntry> {
  """
  Read a saved workflow by name.

  @param name - Saved workflow identifier, excluding path syntax.
  @param dir - Nonempty project directory holding the workflows folder.
  """
  // The name comes from the caller, so it gets the rule parse gives a
  // workflow's name: `../x` must not name a file outside the folder.
  const problem = _workflowNameProblem(name)
  if (problem != null) {
    return failure(problem)
  }
  const root = expandRoot(dir)?
  // Before the prompt, so a missing workflow fails without asking first,
  // as ls, grep, and glob do (docs/dev/stdlib/grep-flags.md).
  if (!exists(savedFile(name), root)) {
    return failure("no workflow named ${name} in ${root}/${WORKFLOWS_DIR}")
  }
  return interrupt std::workflow::scan("Read the saved workflow ${name}?", {
    dir: "${root}/${WORKFLOWS_DIR}"
  })
  return entryFor(root, name)
}

def workflowName(fileName: string): string {
  return fileName.slice(0, fileName.length - FILE_SUFFIX.length)
}

// A glob `*` matches a name that starts with a dot.
def isVisible(fileName: string): boolean {
  return !fileName.startsWith(".")
}

/**
A project without a workflows folder returns an empty list. An unreadable
or invalid saved file fails the listing with a message naming it.
*/
@capabilities(fileRead)
export def listWorkflows(dir: string): Result<WorkflowEntry[]> {
  """
  List saved workflows in name order.

  @param dir - Nonempty project directory holding the workflows folder.
  """
  const root = expandRoot(dir)?
  const folder = "${root}/${WORKFLOWS_DIR}"
  if (!exists(folder)) {
    return success([])
  }
  return interrupt std::workflow::scan("Read the workflows saved in this project?", {
    dir: folder
  })
  // One more than the cap, so a folder that full is refused, not cut short.
  const fileNames = try _glob(root, WORKFLOWS_DIR, "*${FILE_SUFFIX}", MAX_WORKFLOWS + 1)?
  if (fileNames.length > MAX_WORKFLOWS) {
    return failure("${folder} has more than ${MAX_WORKFLOWS} workflows")
  }
  const unsorted = map(filter(fileNames, isVisible), workflowName)
  const names = sortBy(unsorted, \name -> name)
  const entries = map(names, \name -> entryFor(root, name))
  const broken = find(entries, \entry -> isFailure(entry))
  if (broken != null) {
    return broken
  }
  return success(map(entries, \entry -> entry.value))
}
