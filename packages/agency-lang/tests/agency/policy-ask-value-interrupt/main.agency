import { map } from "std::array"
import { askUserChoices } from "std::policy"
import test { typedValue } from "std::policy"

@always(name)
effect app::env { name: string }

node main(): string {
  const permission = { effect: "app::env", data: { name: "X" }, expectsValue: false }
  const keys1 = map(askUserChoices(permission), \item -> item.key)
  if (keys1.join(",") != "a,r,aa,ap,rr") { return "FAIL permission: ${keys1.join(",")}" }

  const question = { effect: "app::question", data: { prompt: "?" }, expectsValue: true }
  const keys2 = map(askUserChoices(question), \item -> item.key)
  if (keys2.join(",") != "a,r") { return "FAIL question: ${keys2.join(",")}" }

  // A scope whose field the data lacks offers no "here" option.
  const nameless = { effect: "app::env", data: {}, expectsValue: false }
  const keys4 = map(askUserChoices(nameless), \item -> item.key)
  if (keys4.join(",") != "a,r,aa,rr") { return "FAIL nameless: ${keys4.join(",")}" }

  const noScope = { effect: "app::plain", data: {}, expectsValue: false }
  const keys3 = map(askUserChoices(noScope), \item -> item.key)
  if (keys3.join(",") != "a,r,aa,rr") { return "FAIL no scope: ${keys3.join(",")}" }

  // Text typed at a question is its answer. Typed at a permission, it is
  // a rejection reason, and a picked key is never a value.
  const typed = { action: "reject", reason: "me@example.com" }
  if (typedValue(question, typed) != "me@example.com") { return "FAIL typed answer" }
  if (typedValue(permission, typed) != null) { return "FAIL typed reason" }
  if (typedValue(question, { action: "approve", reason: null }) != null) { return "FAIL picked key" }
  return "pass"
}
