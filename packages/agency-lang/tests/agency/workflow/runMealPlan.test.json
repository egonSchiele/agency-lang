{
  "tests": [
    {
      "nodeName": "rejectedStepStopsTheWorkflow",
      "description": "rejecting a step's own interrupt stops the workflow with a failure that names the step",
      "input": "",
      "expectedOutput": "[true,\"add\"]",
      "evaluationCriteria": [
        {
          "type": "exact"
        }
      ],
      "useTestLLMProvider": true,
      "llmMocks": [
        {
          "return": [
            "soup",
            "salad"
          ]
        }
      ]
    },
    {
      "nodeName": "pausedWorkflowResumes",
      "description": "an interrupt no handler answers pauses the child; the resume finishes the workflow",
      "input": "",
      "expectedOutput": "\"added 2 items to l1/Meals\"",
      "evaluationCriteria": [
        {
          "type": "exact"
        }
      ],
      "interruptHandlers": [
        {
          "action": "approve"
        }
      ],
      "useTestLLMProvider": true,
      "llmMocks": [
        {
          "return": [
            "soup",
            "salad"
          ]
        }
      ]
    },
    {
      "nodeName": "guardedLlmStepRuns",
      "description": "an LLM step with limits hands its typed reply to the next step; three meals, so a two-message thread would not pass",
      "input": "",
      "expectedOutput": "\"added 3 items to l1/Meals\"",
      "evaluationCriteria": [
        {
          "type": "exact"
        }
      ],
      "useTestLLMProvider": true,
      "llmMocks": [
        {
          "return": [
            "soup",
            "salad",
            "stew"
          ]
        }
      ]
    },
    {
      "nodeName": "stepLimitTrips",
      "description": "a step's time limit trips its guard; the workflow fails naming the step and the timeout",
      "input": "",
      "expectedOutput": "[\"slow\",\"timeoutFailure\"]",
      "evaluationCriteria": [
        {
          "type": "exact"
        }
      ]
    },
    {
      "nodeName": "stepLimitIsHard",
      "description": "a caller that approves std::guard with more time cannot extend a step's limit; the workflow still fails at the step",
      "input": "",
      "expectedOutput": "[\"slow\",\"timeoutFailure\"]",
      "evaluationCriteria": [
        {
          "type": "exact"
        }
      ]
    },
    {
      "nodeName": "workflowLimitIsHard",
      "description": "a caller that approves std::guard with more time cannot extend the workflow's own limit",
      "input": "",
      "expectedOutput": "[\"timeoutFailure\",100]",
      "evaluationCriteria": [
        {
          "type": "exact"
        }
      ]
    }
  ]
}
