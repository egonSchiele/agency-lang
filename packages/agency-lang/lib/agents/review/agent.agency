import { typecheckFile } from "std::agency"
import { basename, dirname } from "std::path"
import { args } from "std::system"
import { systemMessage } from "std::thread"
systemPrompt = read("prompts/system.md", __dirname)

type Severity = "critical" | "warning" | "suggestion"

type Issue = {
  severity: Severity;
  line: number | null;
  message: string;
  suggestion: string | null
}

type ReviewResult = {
  summary: string;
  issues: Issue[];
  strengths: string[]
}

// The type checker's errors in the file, one per line, or "" when it has
// none. It runs in this process, so no second Node is started. Reading the
// file is approved: it is the one the person asked to have reviewed.
def typeErrorsIn(filePath: string): string {
  const report = typecheckFile(dirname(filePath), basename(filePath)) with approve
  if (report is failure(err)) {
    return "${err}"
  }
  let lines = ""
  for (diagnostic in report.value.errors) {
    let where = ""
    if (diagnostic.loc) {
      where = "line ${diagnostic.loc.line + 1}: "
    }
    lines = lines + where + diagnostic.message + "\n"
  }
  return lines
}

node main() {
  let cliArgs = args()
  if (cliArgs.length < 2) {
    print("Usage: agency review <file.agency>")
    return end()
  }
  let filePath = cliArgs[1]
  let code = read(filePath)
  print("Reviewing: ${filePath}\n")
  print("Running type checker...")
  let typeErrors = typeErrorsIn(filePath)
  if (typeErrors != "") {
    print("Type checker found issues:\n${typeErrors}\n")
  } else {
    print("Type checker passed.\n")
  }
  // Have the LLM review the code
  thread {
    systemMessage(systemPrompt catch "")
    let typeErrorMessage = "The type checker found no errors."
    if (typeErrors != "") {
      typeErrorMessage = "The type checker reported the following errors:\n${typeErrors}"
    }
    const reviewPrompt = """
              Please review the following Agency code.

              File: ${filePath}

              ---CODE START---
              ${code}
              ---CODE END---

              ${typeErrorMessage}

              Provide a structured review with a summary, list of issues (with severity, line number if applicable, message, and suggested fix), and a list of strengths.
            """
    let review: ReviewResult = llm(reviewPrompt)
  }
  // Display the review
  print("\n--- Review Summary ---")
  print(review.summary)
  if (review.strengths.length > 0) {
    print("\n--- Strengths ---")
    for (strength in review.strengths) {
      print("  + ${strength}")
    }
  }
  if (review.issues.length > 0) {
    print("\n--- Issues ---")
    for (issue in review.issues) {
      let prefix = "[${issue.severity}]"
      let lineInfo = ""
      if (issue.line != null) {
        lineInfo = " (line ${issue.line})"
      }
      print("  ${prefix}${lineInfo} ${issue.message}")
      if (issue.suggestion != null) {
        print("    Fix: ${issue.suggestion}")
      }
    }
  } else {
    print("\nNo issues found. Code looks good!")
  }
  return end()
}

node end() {

}