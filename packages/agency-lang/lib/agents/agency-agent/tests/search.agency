/*
 * Tests for planSearchSetup — the pure decision over SearchContext.
 * Every branch in the resolution tree is covered: cloud vs local,
 * saved-and-usable vs saved-and-unusable, first-run with zero/one/two
 * keys, and the non-TTY auto-resolution path.
 *
 * Also covers setActiveBackend passing the choice to the stdlib search
 * module.
 */
import { hostedSearchTools, searchMode, searchTools } from "std::agents/lib/search"

import { planSearchSetup, setActiveBackend } from "../lib/search.agency"

def ctx(isLocal: boolean, isTty: boolean, tav: boolean, brave: boolean, saved: string): any {
  return { isLocal: isLocal, isTty: isTty, hasTavily: tav, hasBrave: brave, savedBackend: saved }
}

def report(p: any): string {
  return "${p.kind}|${p.backend}"
}

// --- planSearchSetup ---------------------------------------------------

node cloudFirstRunDefaultsToHostedWithANote(): string {
  return report(planSearchSetup(ctx(false, true, false, false, "")))
}

node localFirstRunBothKeysSelectsBrave(): string {
  return report(planSearchSetup(ctx(true, true, true, true, "")))
}

node localFirstRunOnlyTavilySelectsTavily(): string {
  return report(planSearchSetup(ctx(true, true, true, false, "")))
}

node localFirstRunOnlyBraveSelectsBrave(): string {
  return report(planSearchSetup(ctx(true, true, false, true, "")))
}

node cloudFirstRunBothKeysSelectsBrave(): string {
  return report(planSearchSetup(ctx(false, true, true, true, "")))
}

node cloudFirstRunOnlyTavilySelectsTavily(): string {
  return report(planSearchSetup(ctx(false, true, true, false, "")))
}

node localFirstRunNoKeysPromptsMissing(): string {
  return report(planSearchSetup(ctx(true, true, false, false, "")))
}

node savedHostedOnLocalWarns(): string {
  return report(planSearchSetup(ctx(true, true, false, false, "hosted")))
}

node savedTavilyWithoutKeyWarns(): string {
  return report(planSearchSetup(ctx(false, true, false, false, "tavily")))
}

node savedTavilyWithKeyIsUsed(): string {
  return report(planSearchSetup(ctx(false, true, true, false, "tavily")))
}

node savedTavilyWithBothKeysIsUsed(): string {
  return report(planSearchSetup(ctx(false, true, true, true, "tavily")))
}

node savedTavilyWithoutKeyWarnsDespiteBrave(): string {
  return report(planSearchSetup(ctx(false, true, false, true, "tavily")))
}

node savedBraveWithoutKeyWarnsDespiteTavily(): string {
  return report(planSearchSetup(ctx(false, true, true, false, "brave")))
}

node savedHostedWithBothKeysIsUsed(): string {
  return report(planSearchSetup(ctx(false, true, true, true, "hosted")))
}

node nonTtyLocalBothKeysDefaultsToBrave(): string {
  return report(planSearchSetup(ctx(true, false, true, true, "")))
}

node nonTtyCloudBothKeysDefaultsToBrave(): string {
  return report(planSearchSetup(ctx(false, false, true, true, "")))
}

node savedOffIsRespected(): string {
  return report(planSearchSetup(ctx(false, true, true, true, "off")))
}

node unknownSavedBackendWarnsAndDisables(): string {
  return report(planSearchSetup(ctx(false, true, true, true, "bing")))
}

// --- setActiveBackend ---------------------------------------------------
// The agent hands out no search tools itself. Its choice has to reach the
// stdlib module every agent takes its tools from. Each test sets the
// backend WITHOUT persisting (`persist: false`) so the test run never
// touches ~/.agency-agent/settings.json.

node backendBecomesTheStdlibSearchMode(): string {
  setActiveBackend("tavily", false)
  const named = searchMode()
  setActiveBackend("bing", false)
  return "${named}|${searchMode()}"
}

// "hosted" still asks the catalog: gpt-4o-mini has hosted search through
// "openai-responses" and none through the base "openai" client.
node hostedBackendKeepsTheProviderCheck(): string {
  setActiveBackend("hosted", false)
  const responses = hostedSearchTools("gpt-4o-mini", "openai-responses")
  const base = hostedSearchTools("gpt-4o-mini", "openai")
  return "${responses.length}|${base.length}|${searchTools().length}"
}

node offBackendOffersNoSearch(): string {
  setActiveBackend("off", false)
  return "${searchTools().length}|${hostedSearchTools("gpt-4o-mini", "openai-responses").length}"
}
