/*
 * listSkills: the scan behind skillsDir, returned as data. One
 * interrupt naming the real directory; a missing directory has no
 * entries; an empty dir string fails before any prompt.
 */
import { map } from "std::array"
import { listSkills, MAX_TOOL_NAME_LEN } from "std::skills"

def fixture(): string {
  return "${__dirname}/skills-subdirs-fixture/explorer"
}

node listsTheFixtureEntries(): boolean {
  const listed = listSkills(fixture()) with approve
  if (listed is failure) {
    return false
  }
  const names = map(listed.value.entries, \entry -> entry.name)
  names.sort()
  const dir: string = listed.value.dir
  return names.length == 2 && names[0] == "repo-orientation" && names[1] == "second" && dir.endsWith("/explorer")
}

node raisesOneInterruptNamingTheDirectory(): boolean {
  let raised = 0
  let dir = ""
  let layout = ""
  handle {
    listSkills(fixture())
  } with (intr) {
    if (intr.effect == "std::skills::skillsDir") {
      raised = raised + 1
      dir = intr.data.dir
      layout = intr.data.layout
    }
    return approve()
  }
  return raised == 1 && dir.endsWith("/skills-subdirs-fixture/explorer") && layout == "flat"
}

node missingDirectoryIsEmpty(): boolean {
  const listed = listSkills("${__dirname}/skills-subdirs-fixture/nowhere") with approve
  if (listed is failure) {
    return false
  }
  return listed.value.entries.length == 0
}

node emptyDirFailsBeforeAnyPrompt(): boolean {
  let raised = 0
  let outcome: any = null
  handle {
    outcome = listSkills("")
  } with (intr) {
    raised = raised + 1
    return approve()
  }
  return raised == 0 && isFailure(outcome)
}

node rejectionIsAFailure(): boolean {
  const listed = listSkills(fixture()) with reject
  return isFailure(listed)
}

node capIsExported(): boolean {
  return MAX_TOOL_NAME_LEN == 64
}
