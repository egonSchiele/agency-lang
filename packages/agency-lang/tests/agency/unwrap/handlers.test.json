    },
    {
      "nodeName": "withApproveOneLine",
      "input": "",
      "expectedOutput": "\"6\"",
      "evaluationCriteria": [{ "type": "exact" }],
      "description": "? and with approve on one line"
    },
    {
      "nodeName": "withRejectOneLine",
      "input": "",
      "expectedOutput": "\"rejected\"",
      "evaluationCriteria": [{ "type": "exact" }],
      "description": "? and with reject on one line returns the failure from the def"
    },
    {
      "nodeName": "ranOnce",
      "input": "",
      "expectedOutput": "\"1\"",
      "evaluationCriteria": [{ "type": "exact" }],
      "description": "The operand runs exactly once"
