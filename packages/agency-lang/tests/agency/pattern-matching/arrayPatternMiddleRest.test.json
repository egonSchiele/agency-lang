      "evaluationCriteria": [
        {
          "type": "exact"
        }
      ]
    },
    {
      "nodeName": "declarationTooShortIsAFailure",
      "description": "A declaration whose value cannot fill both ends surfaces a failure rather than aliasing the two binders to the same element.",
