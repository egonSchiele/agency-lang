/** @module
@summary Ask the user questions and track an agent's todo list.

Give `question` to an LLM when it needs information only the user can
provide. Its interrupt lets a terminal, an application, or a handler supply
the reply. Use `todoWrite` to set a plan and `todoUpdate` to track progress.

```ts
import { todoWrite, todoUpdate } from "std::agent"

todoWrite([{ id: "review", text: "Review the draft", status: "pending" }])
todoUpdate("review", "completed")
```
*/

type Todo = {
  id: string;
  text: string;
  status: "pending" | "in_progress" | "completed"
}

let _todos: Todo[] = []

effect std::question {
  prompt: string
}

export def todoAdd(todo: Todo): Todo[] {
  """
  Add a new todo to the list.
  """
  _todos.push(todo)
  return _todos
}

export def todoUpdate(
  id: string,
  status: "pending" | "in_progress" | "completed",
): Todo[] {
  """
  Update the status of a todo by id.
  """
  for (todo in _todos) {
    if (todo.id == id) {
      todo.status = status
      break
    }
  }
  return _todos
}

export def todoWrite(todos: Todo[]): Todo[] {
  """
  Replace the current todo list.
  """
  _todos = todos
  return _todos
}

export def todoList(): Todo[] {
  """
  Return the current todo list.
  """
  return _todos
}

/** Use this for user input in terminal, hosted, or embedded runs.
A handler can answer with `approve("reply")`. */
export def question(prompt: string): string raises <std::question> {
  """
  Ask the user for information needed to continue and wait for their reply.
  Use it for facts only the user can provide. Do not ask for anything you can
  look up, and do not guess at a fact you could ask for.
  """
  let answer = interrupt std::question(prompt, {
    prompt: prompt
  })
  return answer
}
