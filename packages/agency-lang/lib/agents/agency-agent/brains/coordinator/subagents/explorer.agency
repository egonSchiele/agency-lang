/*
 * The explorer, as the agency agent's coordinator sees it.
 *
 * The agent itself lives in std::agents/explorer, so users get the same
 * surveyor in their own agents. This wrapper supplies the things that are
 * the agency agent's business and not the stdlib's: the slow-model slot
 * the user selected, and `inheritContext` so the survey runs in a
 * subthread of the coordinator's conversation instead of starting blind.
 *
 * The docstring below is what the coordinator reads when deciding whether to
 * call this, so it is written for routing, not for the agent's own behavior.
 */
import { explorerAgent as stdExplorerAgent } from "std::agents/explorer"
import { getThread, listThreads } from "std::thread"

import { getSlowModel, getSlowProvider } from "../../../shared.agency"
import { announce } from "../lib/announce.agency"

export def explorerAgent(userMsg: string): string {
  """
  Ask the explorer — a read-only researcher — to survey many files and
  return a synthesized answer. Use it only when the answer genuinely
  requires broad coverage:

  - "Summarize the Agency docs" / "give me a tour of module Y"
  - "How does Z work across the codebase?"

  Do NOT use this when a handful of targeted reads would answer the
  question — do those reads yourself with your own file tools. Do not
  send it to "map the structure": name the specific questions you need
  answered and the scope to cover ("all of docs/site/guide/", "the
  lib/parsers/ module").

  The explorer sees the conversation so far, so state the questions and
  scope rather than restating the discussion.

  @param userMsg - the specific questions to answer and the scope to cover
  """
  announce("explorer", userMsg)
  const result = stdExplorerAgent(
    question: userMsg,
    model: getSlowModel(),
    provider: getSlowProvider(),
    extraTools: [listThreads, getThread],
    inheritContext: true,
  )
  if (isFailure(result)) {
    return "The explorer could not finish: ${result.error}"
  }
  return result.value
}
