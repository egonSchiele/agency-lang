/** @module
  @summary Writes an Agency program for a task and iterates until it parses,
  typechecks, compiles, and (by default) has a node main.

  This agent's contract ends at VALID source. To also check the program's
  behavior, compose it with agencyVerifierAgent: generate source here, run
  agencyVerifierAgent on the result, and retry with its findings folded into
  the task.
*/
import { compile, typecheck, parseAST } from "std::agency"
import { agencyReviewAgent } from "std::agents/agency/review"
import { renderFeedback, feedbackHasErrors } from "std::agents/lib/feedback"
import {
  llmOptions,
  withContext,
  docsOnlyHandler,
 } from "std::agents/lib/shared"
import {
  agencyDocTools,
  readOnlyFileTools,
  readOnlyGitTools,
 } from "std::agents/lib/toolkits"
import { fetch, fetchJSON, fetchMarkdown } from "std::http"
import { agentSkill } from "std::skills"
import { evalValue } from "std::statelog"
import { Critique, revise } from "std::strategy"
import { systemMessage, threadIsNew } from "std::thread"

/** A failed generation: the last source attempted, with the problems found
  in it (review findings, compile errors, or the reason generation stopped). */
export type WriteFailure = {
  source: string;
  problems: string[]
}

type GeneratedCode = {
  code: string
}

// Kept in sync by hand with the syntax rules in the code subagent prompt
// (lib/agents/agency-agent/brains/coordinator/subagents/code.agency) — the authoritative
// source is docs/site/guide/basic-syntax.md, which the model can read
// through the docs tool.
optimize static const systemPrompt = """You write code in the Agency language.
Agency syntax rules you MUST follow:
- Functions: def name(param: Type): ReturnType { ... }
- Nodes: node name() { ... } — export the entry node.
- if / while / for require parentheses AND curly braces: if (x > 5) { ... }
- The ONLY for loop is for-in over an array: for (item in items) { ... }
  There is NO C-style for (let i = 0; i < n; i++) loop. To count, use a
  while loop:
    let i = 1
    while (i <= 3) {
      print(i)
      i = i + 1
    }
- Declare variables with let or const before use.
- No Python-style colon blocks. Always { ... }.

Agency-specific authoring and QA requirements (follow these exactly):
- Exported API: Any function the caller expects to import or any tool you intend
  for an LLM to call must be declared with the export keyword (export def ...).
  Tests and the harness will import/export by name; missing export will fail.

- Local import filename rule: When importing other source files from the same
  project, always import the .agency file explicitly (for example:
  import { greet } from "./greeting.agency"). The sandbox often rejects bare
  paths that do not include the .agency extension.

- Docstrings for tools: When a function is intended to be given to an LLM as a
  tool, it MUST contain a triple-quoted string literal as the very first
  statement inside the function body (this is the docstring that is sent to
  the LLM). The docstring should be one or two short sentences describing
  when the tool should be called and what arguments to pass, with optional
  @param lines. Do NOT use comments above the def (///) as a substitute;
  those are ignored by the tool-surface logic.

- Idempotent lookup helpers: Pure lookup functions that do not change state
  and are safe to call repeatedly (e.g. price lookup) must be declared with
  the idempotent modifier: idempotent def name(...): Type { ... }.

- Destructive / irreversible effects and interrupts:
  - If your code calls an irreversible effect (posting, charging, removing
    files, etc.), you must follow the interrupt-before-danger pattern:
    1) Declare in the signature that the function raises the named effect: e.g.
       export def postComment(text: string): Result<string> raises <comments::post> { ... }
    2) Raise the interrupt (raise namespace::op(...)) before performing the
       irreversible action. The raise must happen outside the destructive region.
    3) Perform the irreversible call inside a destructive region or in a
       destructive def: destructive { ... } or declare destructive def. The
       destructive region contains the actual irreversible call.
    4) Optionally the function can self-approve (use with approve { ... } or
       an approval handler) but tests often expect the interrupt to be raised
       so the caller may approve; do not always self-approve unless the task
       explicitly requires it.
  - Example safe pattern:
    export def chargeCard(amount: number): Result<string> raises <payments::charge> {
      \"""Ask user for approval; if approved, charge the card and return receipt.\"""
      // raise the approval interrupt before any destructive work
      raise payments::charge(amount)
      destructive {
        // the actual irreversible call
        const r: string = payments::charge(amount)
        return success(r)
      }
    }

- Handler style and matching rules: When you implement interrupt handlers,
  always use a single match on the handler's effect/value rather than a
  chain of if/else tests. In other words, inside a `with (intr) { ... }` or
  `with (data) { ... }` handler preference, write:
    match (intr.effect) {
      "std::read" => approve()
      "std::write" if (intr.data != null && intr.data.dir == ".") => approve()
      _ => reject()
    }
  Use match-arm guards (the `if` after the pattern) for additional conditions
  such as checking intr.data.dir. Return plain reject() on rejections unless
  the test specifies otherwise. When unwrapping Result values in test-like
  tasks, prefer `match(result) { success(v) => ... failure(e) => ... }` to
  ensure the harness can detect the intended pattern.

- Creating tool variants: When you return or export functions intended as LLM
  tools, prefer creating restricted variants with .partial(...) and set a
  stable tool name with .rename("tool-name"). Do NOT hand the LLM a plain
  JS-like object with name/description/fn fields; use the function's
  .partial and .rename methods (and optionally .describe()) so the runtime
  can enforce restrictions. Example: let t = exportFn.partial({ dryRun: true }).rename("delete-files-dry").

- Use standard library helpers (prefer std:: helpers over handwritten loops):
  - Use std::path.extname (extname) for file extension extraction instead
    of implementing extOf manually.
  - Prefer std::array helpers (map, filter, reduce, count/length), std::array.unique,
    std::array.groupBy (or std::helper like unique/groupBy) and std::range
    (range(1, n+1)) for ranges instead of manual while-counting.
  - When transforming or producing a list from another list, prefer map/comprehensions
    (for example: map orders as o { ... } or map items as v { ... }) or
    std::array.map/filter rather than creating an empty array and pushing in a loop
    — tests look for idiomatic usage in many tasks.
  - When grouping by a key (e.g., by extension), prefer groupBy or a stdlib helper
    over manually building a Record and pushing into arrays.
  - Common modules: std::shell (bash, exec, ls), std::http (fetch, fetchJSON),
    std::fs (remove, readFile), std::path (extname), std::array (map, filter),
    std::agent (ask/interrupt helpers), std::agency (runCode). Prefer these helpers
    for concise, idiomatic solutions; many tests assert their presence.

- Loop forms: Only use for (item in list) for array iteration. Use while for
  counting or when you need a numeric index. Prefer declarative array helpers
  (map/filter/reduce/unique/groupBy) when the task expects idiomatic solutions.

- Static module-level constants: If an assignment expects a compile-time
  constant table (rates, config, etc.) declare it as `static const` at the
  module level. Mutable module-level state should be `let` (for example,
  history arrays) and should not be exported unless explicitly required.

- Docstring content and brevity: Docstrings should be concise: one or two
  short sentences stating when to call the tool and what arguments it
  expects, optionally followed by @param lines. Keep them programmatic and
  helpful to an LLM deciding whether to call the tool.

- Tool naming and descriptions: When presenting a tool to an LLM, use .rename
  to give a stable machine-readable name and .describe() or the docstring to
  provide a human-friendly description. Objects with name fields or ad-hoc
  descriptors are not accepted by the test harness.

- Result handling and matches: When a problem asks you to propagate or return
  Result failures from an imported parser or helper, return the original
  failure unchanged (e.g., `return r`) and prefer using `match` or `is
  success/is failure` in ways the tests expect; when in doubt use `match` to
  destructure Result values so grading will detect both success and failure
  arms.

- Diagnostics and typechecking: Typecheck your draft with the tool available
  in your environment and fix ALL reported errors before returning the code.
  If you receive a diagnostic code (AG####), look it up in the diagnostics
  reference rather than guessing the fix. Do not return code that you have
  not successfully typechecked.

- If unsure about a language feature or stdlib function, read the specific
  docs page with the docs tool before writing the code.

Guidance derived from prior grading feedback (use these to maximize test scores):
- When the assignment asks for list transformations or grouped outputs, prefer
  stdlib array helpers or comprehensions rather than building arrays with
  push inside for-loops. Tests penalize manual accumulation when a map/filter
  or groupBy would be natural.
- For "distinct" or "first-seen" extraction use std::array.unique or a
  comprehension with a helper rather than a seen-map while loop.
- For numeric sequences, prefer range(1, n+1) instead of while loops when
  the task explicitly expects idiomatic code.
- When creating tools for LLM use, make two things standard: 1) include a
  triple-quoted docstring first in the function body, and 2) give any LLM-facing
  variant a stable name via .rename and restrict via .partial. Tests check
  for .partial(...).rename("...").describe("...").
- If the task requires an irreversible effect (fs::remove, payments::charge,
  etc.), raise the effect before doing the destructive call and perform the
  call inside a destructive region. Do not forget the raises <namespace::op>
  clause in the signature when applicable.
- When writing handlers use a single match on the handler parameter with
  guards where needed; return approve()/reject()/pass() (not ad-hoc values)
  inside arms. Prefer returning match(...) where the handler's result is
  returned to avoid match-value misuse.

Here are complete, correct Agency programs. Copy their structure: the imports, the `node main`, and the explicit `return` at the end.

EXAMPLE 1, compute and return a value:
node main(): number {
  let total = 0
  for (x in [1, 2, 3]) {
    total = total + x
  }
  return total
}

EXAMPLE 2, import a tool and define and call a helper:
import { bash } from "std::shell"
def greet(name: string): string {
  return "Hello, \${name}"
}
node main(): string {
  bash(command: "echo starting")
  return greet("world")
}

EXAMPLE 3, get structured output from the model by annotating the result type:
type Summary = { title: string; points: string[] }
node main(): Summary {
  const s: Summary = llm("Summarize the water cycle with a title and three bullet points.")
  return s
}

Typecheck your draft before returning it, and fix what it reports. An
attempt you already know does not typecheck wastes a whole round.
You cannot save files or run tests from here: the caller saves the code
you return and runs any tests after that. Do not look for the file or try
to run its tests; when the draft typechecks, return it.
Return only the complete program in the code field."""

// No hosted web search here, unlike codingAgent. This agent writes one
// language whose authoritative docs ship in this package, and an open-ended
// search returns other languages' idioms, which is the exact failure the
// system prompt above spends its length fighting. Targeted fetch is fine: it
// retrieves a page the caller already named.
static const skills = agentSkill("agency/coding")

export def buildTools(): any[] {
  """
  Return the Agency writer's tools: the bundled documentation, the source
  inspectors it checks drafts with, read-only access to the project it is
  writing for, and fetches for a named external resource. Not testFile: the
  writer returns source it has not saved, so there is nothing on disk for a
  harness to test yet.
  """
  return [
    ...agencyDocTools(),
    typecheck,
    parseAST,
    ...readOnlyFileTools(),
    ...readOnlyGitTools(),
    fetch,
    fetchJSON,
    fetchMarkdown,
    skills,
  ]
}

/** True when the source declares a `node main` entry point. Missing main is
  not a typecheck diagnostic, so the loop checks for it directly. */
def hasMainNode(source: string): boolean {
  return source =~ re/node\s+main\s*\(/
}

// The loop's running state as a plain object. saveDraft cannot receive a
// failure Result (failure propagation blocks failures at TS boundaries), so
// the loop tracks a plain outcome and only the public boundary converts it
// to a Result. The guard block returns this same shape, so a salvaged draft
// and a normal return are indistinguishable to the unwrap.
type WriteOutcome = {
  valid: boolean;
  source: string;
  problems: string[]
}

def outcomeToResult(outcome: WriteOutcome): Result<string, WriteFailure> {
  if (outcome.valid) {
    return success(outcome.source)
  }
  return failure({
    source: outcome.source,
    problems: outcome.problems
  })
}

// Judge one generated program. The critique it returns becomes the repair
// instruction the next attempt receives, so what the checker found and what
// the writer is told to fix can never drift apart.
def checkSource(source: string, requireMain: boolean, dir: string): Critique {
  const reviewed = agencyReviewAgent(source: source, dir: dir)
  if (feedbackHasErrors(reviewed)) {
    const findings = renderFeedback(reviewed)
    return {
      accepted: false,
      feedback: "That code has problems:\n${findings}\nReturn a corrected complete program."
    }
  }
  const compiled = compile(source, dir)
  if (compiled is failure(compileErr)) {
    return {
      accepted: false,
      feedback: "That code failed to compile:\n${compileErr}\nReturn a corrected complete program."
    }
  }
  if (requireMain && !hasMainNode(source)) {
    return {
      accepted: false,
      feedback: "The program compiles but has no `node main`. Every program MUST have a node named `main` as its entry point. Add one and return the complete program."
    }
  }
  return {
    accepted: true,
    feedback: ""
  }
}

// The critique doubles as the record of what was wrong with the attempt, so
// an exhausted run reports it alongside the source it belongs to. Each
// attempt is checked once here, and `revise` reads the verdict back out.
def outcomeFor(source: string, requireMain: boolean, dir: string): WriteOutcome {
  const critique = checkSource(source, requireMain: requireMain, dir: dir)
  if (critique.accepted) {
    return {
      valid: true,
      source: source,
      problems: []
    }
  }
  return {
    valid: false,
    source: source,
    problems: [critique.feedback]
  }
}

def critiqueOf(outcome: WriteOutcome): Critique {
  if (outcome.valid) {
    return {
      accepted: true,
      feedback: ""
    }
  }
  return {
    accepted: false,
    feedback: outcome.problems[0]
  }
}

def generateLoop(
  task: string,
  context: string,
  maxAttempts: number,
  model: string,
  provider: string,
  extraTools: any[],
  requireMain: boolean,
  dir: string,
): WriteOutcome {
  if (threadIsNew()) {
    systemMessage(systemPrompt)
  }
  // A module deliverable exports what the task names; only a runnable
  // program needs the `node main` entry point the system prompt teaches.
  let deliverable = "Write an Agency program for this task:"
  if (!requireMain) {
    deliverable = "Write Agency module source for this task. The deliverable is the module contents itself: define and export what the task names. A `node main` is not required."
  }
  const opening = "${deliverable}\n<task>\n${withContext(task: task, context: context)}\n</task>"
  return revise(maxAttempts: maxAttempts, check: critiqueOf) as critique {
    // if/else, not a ternary: a ternary inside a block evaluates to null.
    // See tests/agency/agents/blockProbe.agency.
    let prompt = critique
    if (critique == "") {
      prompt = opening
    }
    const generated: GeneratedCode = llm(
      prompt,
      llmOptions(
        model: model,
        provider: provider,
        tools: buildTools().concat(extraTools),
      ),
    )
    const outcome = outcomeFor(source: generated.code, requireMain: requireMain, dir: dir)
    saveDraft(outcome)
    return outcome
  }
}

export def agencyCodingAgent(
  task: string,
  context: string = "",
  maxAttempts: number = 3,
  maxCost: number = $20.00,
  maxTime: number = 15m,
  model: string = "",
  provider: string = "",
  session: string = "",
  extraTools: any[] = [],
  requireMain: boolean = true,
  dir: string = "",
): Result<string, WriteFailure> {
  """
  Write an Agency program for the task. Iterates until the source parses,
  typechecks, compiles, and (when requireMain) has a node main, or attempts
  run out. On failure returns the last attempted source with the problems
  found in it.

  @param task - What the program should do
  @param context - Extra material folded into the prompt, or ""
  @param maxAttempts - Generation attempts before giving up
  @param maxCost - Hard spend cap
  @param maxTime - Hard wall-clock cap
  @param model - Model override, or "" for the ambient model
  @param provider - Provider for the model override
  @param session - Session name to share a thread across calls, or "" for isolated
  @param extraTools - Extra tools to offer the LLM, appended to the built-in set
  @param requireMain - Demand a `node main` entry point (default). Pass false
    when the deliverable is a library module whose exports the caller places.
  @param dir - Directory the draft's relative imports resolve against, so a
    draft that imports a sibling file typechecks. "" when it imports none.
  """
  const captured = guard(cost: maxCost, time: maxTime, label: "agencyCodingAgent") {
    let outcome: WriteOutcome = {
      valid: false,
      source: "",
      problems: ["generation never ran"]
    }
    thread(label: "agencyCodingAgent", session: session) {
      outcome = generateLoop(
        task: task,
        context: context,
        maxAttempts: maxAttempts,
        model: model,
        provider: provider,
        extraTools: extraTools,
        requireMain: requireMain,
        dir: dir,
      )
    }
    return outcome

    // Salvage the last completed attempt (generateLoop saveDrafts each one)
    // if an outer budget guard trips; the assignment above would drop it.
    finalize {
      return outcome
    }
  }
  // The guard Result cannot pass straight through here: this agent reports
  // failures as a WriteFailure carrying the last source. isFailure, not
  // match, because a match inside a resumed block evaluates to null (see
  // tests/agency/supervise/nestedGuardResume.agency), and the whole error is
  // interpolated rather than a .type field that only guard trips carry.
  if (isFailure(captured)) {
    // Nothing was ever drafted: the run stopped before the first attempt.
    return failure(
      {
        source: "",
        problems: ["agencyCodingAgent stopped before generating: ${captured.error}"]
      },
    )
  }
  // A rejected trip with a saved draft arrives success-shaped carrying the
  // draft, which has the same WriteOutcome shape as a normal return, so
  // this covers both.
  return outcomeToResult(outcome: captured.value)
}

/** What an eval hands the writer: the assignment, and the file to save the
  returned program as. The shape the `evals/agency-coding` suite uses as its
  input. Deliberately agent-agnostic: everything about the deliverable's
  shape (module vs runnable program, what to export) lives in the assignment
  text, so any writer can be scored on the same suite. */
@hidden
export type CodingEvalInput = {
  assignment: string;
  outFile: string
}

/** Eval entry point: `agency eval run stdlib/agents/agency/coding.agency:evalMain
  --suite <dir>`. A node in a library module never runs when the module is
  imported; it only exists so a suite can score this writer without a
  wrapper file. Any other writer scored on the same suite supplies a node
  with this signature. The writer returns source without saving it, so
  saving into the workdir — where the suite's harness pairs grade it — is
  this node's own doing (`with approve`). The writer runs under
  `docsOnlyHandler`, which lets it read the packaged docs and rejects every
  other interrupt, so a budget trip stays a failure. A failed run still saves
  its last draft: harness grading is all-or-nothing, but the grade's
  per-case feedback then names exactly which cases the draft fails. */
node evalMain(input: CodingEvalInput): string {
  evalValue(input)
  // requireMain is this agent's own knob, not part of the suite contract:
  // the assignment text says what shape the deliverable takes, and the
  // harness judges the outcome. So no mechanical main-node check here.
  let written: Result<string, WriteFailure> = failure({
    source: "",
    problems: ["the writer never ran"]
  })
  handle {
    written = agencyCodingAgent(task: input.assignment, requireMain: false, dir: ".")
  } with docsOnlyHandler
  let source = ""
  if (written is success(code)) {
    source = code
  }
  if (written is failure(gaveUp)) {
    source = gaveUp.source
  }
  if (source == "") {
    return "the writer produced no source"
  }
  const saved = write(input.outFile, source) with approve
  if (saved is failure(writeErr)) {
    return "could not save ${input.outFile}: ${writeErr}"
  }
  if (written is failure(err)) {
    return "saved the last draft, but the writer gave up: ${err.problems}"
  }
  return source
}
