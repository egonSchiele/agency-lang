// A `!` parameter check runs once per call. When the function pauses on an
// interrupt and resumes, the resume skips the check and keeps the checked
// value.

import { getMutable, setMutable } from "../../helpers/mutableVar.js"

effect test::confirm { tag: string }

def count(key: string) {
  setMutable(key, getMutable(key, 0) + 1)
}

def checkStamp(value: string): Result<string> {
  count("stamp")
  return success(value)
}

@validate(checkStamp)
type Stamp = string

def checkLabel(value: string): Result<string> {
  count("label")
  return success(value)
}

@validate(checkLabel)
type Label = string

def checkPositive(value: number): Result<number> {
  if (value > 0) {
    return success(value)
  }
  return failure("expected ${value} to be > 0")
}

@validate(checkPositive)
type Count = number

def ask(tag: string) {
  interrupt test::confirm("Go ahead?", { tag: tag })
}

def messageOf(result: any): string {
  if (isFailure(result)) {
    return result.error
  }
  return "no failure"
}

// Pauses in a callee.
def schedule(when: Stamp!): Result<string> {
  ask("schedule")
  return success(when)
}

node once() {
  setMutable("stamp", 0)
  const result = schedule("2026-10-16T09:00:00")
  return [result.value, getMutable("stamp", 0)]
}

// zod drops the unknown key, and the body must see the stripped value after
// the resume too.
def plan(spec: { type: "daily" }!): Result<{ type: "daily" }> {
  ask("plan")
  return success(spec)
}

node checkedValue() {
  const raw: any = { type: "daily", extra: 1 }
  const result = plan(raw)
  return result.value
}

// Pauses in its own body.
def scheduleHere(when: Stamp!): Result<string> {
  interrupt test::confirm("Go ahead?", { tag: "here" })
  return success(when)
}

node bodyRaise() {
  setMutable("stamp", 0)
  const result = scheduleHere("2026-10-16T09:00:00")
  return [result.value, getMutable("stamp", 0)]
}

def scheduleDefault(when: Stamp! = "2026-10-16T09:00:00"): Result<string> {
  ask("default")
  return success(when)
}

node withDefault() {
  setMutable("stamp", 0)
  const result = scheduleDefault()
  return [result.value, getMutable("stamp", 0)]
}

def scheduleLabelled(label: string, when: Stamp!): Result<string> {
  ask("mixed")
  return success("${label}:${when}")
}

node mixedParams() {
  const result = scheduleLabelled("standup", "09:00")
  return result.value
}

def scheduleTwo(label: Label!, when: Stamp!): Result<string> {
  ask("two")
  return success("${label}:${when}")
}

node twoValidated() {
  setMutable("stamp", 0)
  setMutable("label", 0)
  const result = scheduleTwo("standup", "09:00")
  return [result.value, getMutable("label", 0), getMutable("stamp", 0)]
}

def setCount(amount: Count!): Result<string> {
  setMutable("bodyRan", true)
  return success("set ${amount}")
}

node failsBeforeBody() {
  setMutable("bodyRan", false)
  const result = setCount(-5)
  return [getMutable("bodyRan", false), messageOf(result)]
}

// A destructive def commits at entry, but a refused argument never enters.
destructive def wipe(amount: Count!): Result<string> {
  setMutable("wipeRan", true)
  return success("wiped ${amount}")
}

node destructiveRefused() {
  setMutable("wipeRan", false)
  const result = wipe(-1)
  if (isFailure(result)) {
    return [getMutable("wipeRan", false), result.destructiveRan, result.error]
  }
  return "no failure"
}

def askFirst(value: string): Result<string> {
  interrupt test::confirm("ok to validate?", { tag: "validator" })
  return success(value)
}

@validate(askFirst)
type Asked = string

def scheduleAsked(when: Asked!): Result<string> {
  setMutable("askedBodyRan", true)
  return success(when)
}

// A validator that raises an interrupt cannot pause a parameter check. The
// call fails instead of running the body on an unchecked value.
node validatorRaises() {
  setMutable("askedBodyRan", false)
  const result = scheduleAsked("09:00")
  return [getMutable("askedBodyRan", false), messageOf(result)]
}

// A default may name an earlier parameter. It reads the argument as given,
// before the check.
def collect(n: number!, xs: number[] = [n]): Result<number[]> {
  ask("collect")
  return success(xs)
}

node defaultNamesChecked() {
  const result = collect(7)
  return result.value
}

node inForkBranches() {
  setMutable("stamp", 0)
  parallel {
    let first = schedule("09:00")
    let second = schedule("10:00")
  }
  return [first.value, second.value, getMutable("stamp", 0)]
}
