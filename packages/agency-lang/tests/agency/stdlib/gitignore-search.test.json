    },
    {
      "nodeName": "globSearchesFolderNamedInPattern",
      "input": "",
      "expectedOutput": "[\"out/inside.md\"]",
      "evaluationCriteria": [{ "type": "exact" }],
      "description": "glob searches an ignored folder named at the start of the pattern"
    },
    {
      "nodeName": "lsRecursiveSkipsIgnored",
      "input": "",
      "expectedOutput": "[\"kept.md\"]",
      "evaluationCriteria": [{ "type": "exact" }],
      "description": "a recursive ls skips what the fixture's .gitignore ignores"
    },
    {
      "nodeName": "lsRecursiveIncludesIgnoredWhenAsked",
      "input": "",
      "expectedOutput": "[\".gitignore\",\"ignored.md\",\"kept.md\",\"out\",\"out/inside.md\"]",
