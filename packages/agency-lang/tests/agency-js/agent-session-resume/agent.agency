import {
  _installSessionHooks,
  _sessionOnSubmit,
  _readCheckpointFile,
  _readTranscript,
 } from "agency-lang/stdlib-lib/agentSessions.js"
import { assistantMessage, currentThreadId, getThread, userMessage } from "std::thread"
import { env } from "std::system"

import { fakeRepl } from "./loop.js"

// The agency agent's save-and-resume mechanics, without the agent: a
// TypeScript REPL loop, a turn that grows the run's active thread, a record
// per turn, and a fresh process that restores the checkpoint file. Stage
// one (test.js) runs two lines; stage two (resume-stage.js) restores and
// runs one more, and must see all three in the thread and turns == 3.

let turns = 0

// The slug id of the thread the turns run on, recorded after each turn as
// the agent's harness does.
let conversation = ""

def turn(line: string): boolean {
  turns = turns + 1
  // The third line goes in as a content array, the way a prompt with
  // attachments does.
  if (turns == 3) {
    userMessage(["u${turns}: ", line])
  } else {
    userMessage("u${turns}: ${line}")
  }
  assistantMessage("a${turns}")
  conversation = currentThreadId()
  return true
}

def recordTurn(line: string): any {
  return {
    dir: "./sessions",
    record: {
      id: "s1",
      cwd: ".",
      brain: "test",
      created: 1,
      lastActive: turns,
      turns: turns,
      title: "t",
      conversationThread: conversation
    }
  }
}

def messages(): string[] {
  const all = getThread(conversation, 0, 100)
  return [m.content for m in all.value]
}

node main() {
  _installSessionHooks(turn, recordTurn)
  const resume = env("RESUME") with approve
  if (resume == "1") {
    restore(_readCheckpointFile("./sessions", "s1"), {})
  }
  fakeRepl(_sessionOnSubmit)
  // The transcript is read from the file, the way a resume prints it
  // before restoring.
  const saved = _readTranscript(_readCheckpointFile("./sessions", "s1"), conversation)
  return {
    turns: turns,
    messages: messages(),
    transcript: ["${m.role}: ${m.content}" for m in saved]
  }
}
