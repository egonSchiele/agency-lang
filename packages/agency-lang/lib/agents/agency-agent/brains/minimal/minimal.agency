/** @module
  @summary A coding brain with six tools and a short prompt: each turn is
  one tool loop in a single conversation thread, with no subagents. For
  benchmarks and sandboxed runs, where every tool definition and prompt
  line is paid for on every request.
*/
import { AGENT_SPILL_OVER } from "std::agents/lib/shared"
import { minimalCodingTools } from "std::agents/lib/toolkits"
import { Attachment, systemMessage } from "std::thread"

import { AgentBrain, BrainContext } from "../brain.agency"
import { addGlobalInstructions } from "../../lib/globalInstructions.agency"

// Measured against longer prompts in docs/dev/agents/coding-agent.md. The
// last four rules are copied from `systemPrompt` in
// stdlib/agents/coding.agency; change the two together. The bash rule is
// only here, because this brain has no ls, glob, or grep tool.
static const PROMPT = """You are a coding assistant. Help users inspect files, run commands, and modify code.

- Use bash for file operations like ls, grep, find.
- Use read to examine files instead of cat or sed.
- Use edit for targeted changes. Batch changes to one file in a single call.
- Use write only for new files or complete rewrites.
- Be concise in your responses.
"""

// Per-run grounding, from BrainContext. Spliced into the system prompt.
let _context: string = ""

let first = true

def minimalInit(context: BrainContext) {
  _context = context.grounding
  first = true
}

def minimalRunTurn(
  target: string,
  prompt: string | (string | Attachment)[],
): string {
  thread(label: "minimal", session: "minimal") {
    if (first) {
      systemMessage("${PROMPT}${_context}")
      first = false
    }
    addGlobalInstructions()
    const result = llm(
      prompt,
      tools: minimalCodingTools(),
      spillToolResultsOver: AGENT_SPILL_OVER,
    )
  }
  return result
}

export def minimalBrain(): AgentBrain {
  return {
    name: "minimal",
    session: "minimal",
    description: "One coder with six tools (read, bash, edit, write, readSpill, grepSpill) and a short prompt",
    startTargets: [],
    init: minimalInit,
    runTurn: minimalRunTurn
  }
}
