import { defaultEffort, effortToSend, parseEffort } from "../lib/effort.agency"

static const GLM = { provider: "openrouter", model: "z-ai/glm-5.3-flash" }
static const KIMI = { provider: "openrouter", model: "moonshotai/kimi-k3" }
static const OPUS = { provider: "anthropic", model: "claude-opus-4-8" }

// An absent flag names nothing: the preset or the agent's default decides.
node absent(): string {
  return "${parseEffort(null).level == null}|${parseEffort(null).error}"
}
// The four choices, in any case and with stray spaces.
node levels(): string {
  return "${parseEffort("high").level}|${parseEffort("Medium").level}|${parseEffort(" low ").level}|${parseEffort("default").level}"
}
// Anything else is an error that names the choices, and sends nothing.
node unknown(): string {
  const r = parseEffort("max")
  return "${r.level == null}|${r.error}"
}
// An empty value (`--effort=`) is an error too, not the provider's default.
node empty(): string {
  const r = parseEffort("")
  return "${r.level == null}|${r.error}"
}
// A model whose provider defaults to its top level gets high.
node defaultForGlm(): string {
  return "${defaultEffort([GLM, GLM])}|${defaultEffort([GLM, KIMI])}"
}
// One level goes out with every call, so a session with a model outside
// the rules gets none, and so does a session with no chat model.
node noDefaultWhenMixed(): string {
  return "${defaultEffort([GLM, OPUS])}|${defaultEffort([OPUS])}|${defaultEffort([])}"
}
// The same model id on another provider is not the model the rule names.
node noDefaultOnAnotherProvider(): string {
  return "${defaultEffort([{ provider: "zai", model: "z-ai/glm-5.3-flash" }])}"
}
// A named level beats the default, and "default" sends nothing.
node askedWins(): string {
  return "${effortToSend("low", [GLM])}|${effortToSend("default", [GLM])}|${effortToSend(null, [GLM])}|${effortToSend(null, [OPUS])}"
}
