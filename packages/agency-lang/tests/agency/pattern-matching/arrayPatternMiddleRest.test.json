      "expectedOutput": "[\"nested tail\",\"fell through\",\"numeric last\",\"fell through\"]",
      "evaluationCriteria": [
        {
          "type": "exact"
        }
      ]
    },
    {
      "nodeName": "bindingPositionToo",
      "description": "const [a, ...rest, b] = xs is legal; binding position shares the same arithmetic.",
      "input": "",
