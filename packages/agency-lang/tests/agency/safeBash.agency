node ghApiStaysBroad() {
  return [
    ghBroad("gh api repos/o/r/pulls/5/comments?per_page=100"),
    ghBroad("gh api -X POST repos/o/r/issues/7/comments -f body=hi"),
    ghBroad("gh api repos/o/r/issues/7/comments -f body=hi"),
    ghBroad("gh api -X GET --method POST repos/o/r/pulls/5"),
    ghBroad("gh api repos/o/r/pulls/5 --paginate"),
    ghBroad("gh api repos/o/r/pulls/5 --hostname ghe.example.com"),
    ghBroad("gh api repos/o/r/pulls/5 -H 'Accept: x'"),
    ghBroad("gh api repos/o/r/pulls/5 --jq .title"),
    ghBroad("gh api user"),
    ghBroad("gh api graphql -f query=x"),
    ghBroad("gh api repos/o/r/pulls/5/merge"),
    ghBroad("gh api"),
    ghBroad("gh api repos/o/r/pulls/5 repos/o/r/pulls/6"),
    // Only the method check refuses these two.
    ghBroad("gh api -X POST repos/o/r/pulls/5"),
    ghBroad("gh api --method=delete repos/o/r/pulls/5"),
    // A quoted `api` is still gh api, so it does not fall back to std::exec.
    ghBroad("gh 'api' --method POST repos/o/r/issues/1/comments -f body=hi"),
    ghBroad("gh \"api\" -X DELETE repos/o/r/issues/comments/9"),
  ]
}

// The fake gh prints its arguments. The path names the repository the
// lookup found, and the paging the payload shows.
node ghApiRunsWhatItAsked() {
  makeGhFixtures()
  const result = runWithFakeGh("printf '%s\\n' \"$@\"", "gh api repos/{owner}/{repo}/pulls/5/comments", GH_ORIGIN_FIXTURE)
  removeGhFixtures()
  return result
}

node timeLimitStopsTheCommand() {
  let result: any = null
  handle {
    // "A1" and "B2" are text the command prints and does not spell.
    // `sh -c` has no rule, so this asks std::bash, which carries a limit.
    result = safeBash("printf 'A%s\\n' 1; sh -c 'sleep 20'; printf 'B%s\\n' 2", timeout: 1)
  } with (intr) {
    // Every question about this line carries the limit, in milliseconds.
    if (intr.data.timeout != 1000) {
      return reject("timeout was ${intr.data.timeout}")
    }
    return approve()
  }
  if (result is failure(why)) {
    return [
      why.includes("A1"),
      why.includes("B2"),
      why.split("\n").includes("[stopped at the time limit of 1 seconds]"),
    ]
  }
  return "NOT STOPPED"
}
