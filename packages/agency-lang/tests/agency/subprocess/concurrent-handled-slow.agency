import { compile, run } from "std::agency"
import { frameHoldsCommand } from "./frame-check.js"

// Three concurrent child branches each interrupt, and the parent's handler
// does slow work before it answers. Its three runs share one stack. The
// first raise to arrive waits the shortest, so the runs finish in the order
// they started, each while the later ones are still in flight. After its
// wait, each run checks that its own frame is still on the stack. If a run
// removed the top frame when it finished, instead of its own, the last run's
// frame would be gone before its check (#1426).
node main() {
  const source = """
import { bash } from "std::shell"
node main() {
  const results = fork(["a", "b", "c"]) as item {
    let r = bash("echo branch-" + item)
    return r.stdout
  }
  return results
}
"""
  const compileResult = compile(source)
  if (isFailure(compileResult)) {
    return "compile failed"
  }
  let finished = []
  handle {
    const result = run(compiled: compileResult.value, node: "main")
    if (isSuccess(result)) {
      return "${result.value.data} | finished ${finished}"
    }
    return "run failed"
  } with (intr) {
    if (intr.effect == "std::run") {
      return approve()
    }
    // The three runs start in one tick and interleave step by step, so the
    // wait is taken from the interrupt's own data, not from a shared counter.
    const command = intr.data.command
    let wait = 450
    if (command == "echo branch-a") {
      wait = 150
    }
    if (command == "echo branch-b") {
      wait = 300
    }
    sleep(wait)
    const ownFrame = frameHoldsCommand(command)
    finished.push("${command}: ${ownFrame}")
    return approve()
  }
}
