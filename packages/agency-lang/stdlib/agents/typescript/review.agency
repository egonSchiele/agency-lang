import { Feedback, failOpenFeedback } from "std::agents/lib/feedback"
import { hostedSearchTools, searchTools } from "std::agents/lib/search"
import { AGENT_SPILL_OVER, llmOptions, withContext, docsOnlyHandler } from "std::agents/lib/shared"
import {
  communicationTools,
  readOnlyFileTools,
  readOnlyGitTools,
  webTools,
  spillTools,
  SAVE_DRAFT_HINT,
  ASK_USER_HINT,
} from "std::agents/lib/toolkits"
import { guarded } from "std::decorators"
import { agentSkill } from "std::skills"
import { evalValue } from "std::statelog"
import { systemMessage, threadIsNew } from "std::thread"

/** @module
@summary Review TypeScript readability, architecture, and project conventions.

Pass a diff or source text and optional project guidelines. The reviewer
can read repository files and Git history to check duplication and
conventions. It assumes compilers, linters, and tests run separately.

A stopped review may return saved partial findings. A failed review
returns no findings, so an empty list alone does not prove a completed review.
*/

static const systemPrompt = """Review TypeScript readability, architecture, and project conventions.
Compilers, linters, formatters, and tests run separately. Omit findings
those tools can detect.

Check these patterns:
- Duplicated code: search for an existing helper and cite its file before
  claiming duplication.
- Imperative sprawl: propose a small interface when inline loops,
  conditionals, and accumulators obscure what the code does.
- Order-dependent mutable state: prefer values derived from inputs when
  correctness otherwise depends on assignment order.
- Leaky abstractions: callers should use a boundary instead of reading
  internal fields or reconstructing internal state.
- Mixed responsibilities: identify the concepts that need separate
  modules, or cite the size of a file already serving unrelated purposes.
- Inconsistent conventions: cite the existing code that establishes them.
- Unneeded special cases: show that the general path handles the case.
- Swallowed errors: a catch should log or rethrow.
- Narrating comments: keep explanations the code itself cannot provide.
- Density and naming: suggest clearer forms for nested ternaries, one-line
  if bodies, long chains, unnamed constants, obscure names, or deeply
  nested object types.

Read touched files in full and inspect existing helpers and conventions.
Judge against the change's intent. The caller's project guidelines override
conflicting catalog rules.

For each finding, name the pattern, exact location, and concrete fix.
Set error=true for a problem that should block merging and error=false
for an improvement that can wait. Keep findings brief. Report a repeated
problem once and name the other locations. Return an empty list when the
code needs no findings, and omit generic advice.${ASK_USER_HINT}${SAVE_DRAFT_HINT}"""

static const skills = agentSkill("typescript/review")

export def buildTools(): any[] {
  """
  Return repository and web lookup tools for TypeScript reviews.
  """
  return [
    ...readOnlyFileTools(),
    ...readOnlyGitTools(),
    ...webTools(),
    ...spillTools(),
    ...searchTools(),
    skills,
    ...communicationTools(),
  ]
}

def judgeCode(
  work: string,
  task: string,
  guidelines: string,
  context: string,
  model: string,
  provider: string,
  extraTools: any[],
): Feedback[] {
  if (threadIsNew()) {
    systemMessage(systemPrompt)
  }
  let guidelinesSection = ""
  if (guidelines != "") {
    guidelinesSection = """This project's own guidelines. They outrank the built-in catalog:
<guidelines>
${guidelines}
</guidelines>

"""
  }
  const prompt = """
${guidelinesSection}The change was made for this task:
<task>
${withContext(task: task, context: context)}
</task>

<code>
${work}
</code>

Return a list of feedback items.
"""
  // Return position so a model saveDraft propagates as partial findings.
  return llm(
    prompt,
    llmOptions(
      model: model,
      provider: provider,
      tools: buildTools().concat(extraTools).concat([saveDraft]),
      spillToolResultsOver: AGENT_SPILL_OVER,
      hostedTools: hostedSearchTools(model, provider),
    ),
  )
}

export def typescriptReviewAgent(
  work: string,
  task: string = "",
  guidelines: string = "",
  context: string = "",
  maxCost: number = $10.00,
  maxTime: number = 10m,
  model: string = "",
  provider: string = "",
  session: string = "",
  extraTools: any[] = [],
): Result<Feedback[]> {
  """
  Review TypeScript readability, architecture, and project conventions.
  A failed review returns no findings.

  @param work - A diff, a file, or several files supplied as text.
  @param guidelines - Project standards that override conflicting built-in review rules.
  @param maxCost - Cost budget in USD.
  @param maxTime - Time budget in milliseconds.
  @param model - Model override, or "" for the ambient model.
  @param provider - Provider for the model override, ignored when model is empty.
  @param session - Name a conversation to reuse across calls, or "" for an isolated thread.
  @param extraTools - Tools added to the repository and source lookup tools.
  """
  return failOpenFeedback(typescriptReviewUnderBudget(
    work: work,
    task: task,
    guidelines: guidelines,
    context: context,
    model: model,
    provider: provider,
    session: session,
    extraTools: extraTools,
    maxCost: maxCost,
    maxTime: maxTime,
  ))
}

// The guarded half of typescriptReviewAgent, a def of its own because the
// exported def post-processes the guard's Result. Return position: when
// the budget runs out, the findings the model saved reach the guard and
// come back as the result.
@guarded(cost: maxCost, time: maxTime, label: "typescriptReviewAgent")
def typescriptReviewUnderBudget(
  work: string,
  task: string,
  guidelines: string,
  context: string,
  model: string,
  provider: string,
  session: string,
  extraTools: any[],
  maxCost: number,
  maxTime: number,
): Result<Feedback[]> {
  thread(label: "typescriptReviewAgent", session: session) {
    return judgeCode(
      work: work,
      task: task,
      guidelines: guidelines,
      context: context,
      model: model,
      provider: provider,
      extraTools: extraTools,
    )
  }
}

/** What an eval hands the reviewer: the task the code was written for, and
  the file holding that code, seeded into the working directory by the
  test's `files/`. The shape the `evals/typescript-review` suite uses as
  its input. */
export type TsReviewEvalInput = {
  assignment: string;
  sourceFile: string
}

// Any other reviewer scored on the same suite supplies a node with this
// signature. Effects are decided at this boundary. Reading the seeded input
// file is this node's own decision (`with approve`). The reviewer runs under
// `docsOnlyHandler`, which lets it read the packaged docs and rejects every
// other interrupt, so a budget trip stays a failure and the reviewer's
// fail-open result comes back instead of an interrupt escaping the entry
// point.
/** Run this module through an eval suite with `agency eval run stdlib/agents/typescript/review.agency:evalMain --suite <dir>`. */
node evalMain(input: TsReviewEvalInput): Feedback[] {
  evalValue(input)
  const source = read(input.sourceFile) with approve
  if (source is failure(readErr)) {
    return [{ error: true, feedback: "could not read ${input.sourceFile}: ${readErr}" }]
  }
  let reviewed: Result<Feedback[]> = failure("the reviewer never ran")
  handle {
    reviewed = typescriptReviewAgent(work: source.value, task: input.assignment)
  } with docsOnlyHandler
  if (reviewed is failure(err)) {
    return [{ error: true, feedback: "review agent failed: ${err}" }]
  }
  return reviewed.value
}
