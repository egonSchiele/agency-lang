import { Feedback, failOpenFeedback } from "std::agents/lib/feedback"
import {
  llmOptions,
  withContext,
  docsOnlyHandler,
 } from "std::agents/lib/shared"
import {
  communicationTools,
  readOnlyFileTools,
  writableFileTools,
  SAVE_DRAFT_HINT,
  ASK_USER_HINT,
 } from "std::agents/lib/toolkits"
import { guarded } from "std::decorators"
import { agentSkill } from "std::skills"
import { evalValue } from "std::statelog"
import { systemMessage, threadIsNew } from "std::thread"

/** @module
@summary Review prose for readability using built-in or caller-supplied guidelines.

Pass prose or a request naming files. The reviewer reports findings and
can apply edits when the request explicitly asks for them. Separate passes
look for unnecessary passages, verbal tics, and readability problems.

By default, a failed review returns no findings. Pass `failOpen: false` to
receive failures. A budget stop may still return saved partial findings.
*/

optimize static const systemPrompt = """Review prose for readability and whether it communicates the facts its
intended reader needs. Spelling and grammar checks run separately.
Identify the reader and the decisions they need to make, and use that
analysis to judge findings. Do not report the analysis itself.

Check these patterns:
- Garden-path sentences: quote the misleading opening, show the plausible
  misreading, and give a rewrite that avoids it.
- Passive voice: suggest an active rewrite when naming the actor helps.
- Too many concepts in one sentence: give concrete split sentences.
- Em-dash overuse: suggest a comma, conjunction, or split when it helps.
- Unexplained jargon: define the term for this reader using supported
  facts. Terms a contributor uses daily, such as "parse", "typecheck",
  and "stdlib", do not need definitions for that reader.
- Buried lead: move the answer ahead of background the reader does not need.

Separate passes report cuts and verbal tics. Do not duplicate their
findings or reword passages that should be cut.

Use error=true only when you can demonstrate a misreading, loss of thread,
or missed requirement that would cause a knowledgeable reader to act
wrongly. A possible precision improvement is advisory. For example,
"When several complete passes scored the same question, the most recent
one wins" needs no finding merely because it does not define "most recent".
Do not invent a timestamp rule to rewrite it.

Use error=false for polish and helpful clarification. Preserve the facts.
If a rewrite needs a fact missing from the text, offer it only when the
assignment supplies that fact, mark it advisory, and name what you added.
The caller's guidelines override conflicting built-in rules. Note conflicts.

For each finding, quote the passage, name the principle, explain the
problem, and give one concrete rewrite. Keep findings brief. Return an
empty list for clean text and omit generic advice.${ASK_USER_HINT}${SAVE_DRAFT_HINT}"""

// The cuts pass: one question of every part of the text, does this reader
// need it. Returns cuts only, never rewrites.
optimize static const cutsPrompt = """Find prose the intended reader does not need for the task. Report cuts.
Other passes handle rewording, misreadings, and verbal tics.

Identify the reader and the decisions or checks they need to make.
First ask whether the whole piece serves those needs. If it does not,
recommend removing it as one finding. Otherwise, examine each paragraph
and sentence for material the reader does not need, such as:
- Unneeded background or detail meant for a different reader.
- The writer's process or notes about decisions with no lasting consequence.
- Repeated facts or a restatement of the assignment.
- Exhaustive option values when knowing the option exists is enough.
- Praise, reassurance, or commentary on the text itself.

For each cut, quote the passage exactly and explain why this reader does
not need it for their decision. Do not report your reader analysis.
Say "cut". Suggest moving a passage only when the task or text names its
destination. Do not rewrite the passage, add facts, or propose new material.
Set error=true only for removal of a whole piece or section. Other cuts
are advisory, with error=false. Return an empty list when nothing needs cutting.

If the text names files, read and review their contents."""

def askForCuts(
  text: string,
  task: string,
  guidelines: string,
  context: string,
  model: string,
  provider: string,
): Feedback[] {
  let guidelinesSection = ""
  if (guidelines != "") {
    guidelinesSection = """The caller's own writing guidelines. They outrank the rules above:
<guidelines>
${guidelines}
</guidelines>

"""
  }
  if (threadIsNew()) {
    systemMessage(cutsPrompt)
  }
  return llm(
    """
${guidelinesSection}The text was written for this task:
<task>
${withContext(task: task, context: context)}
</task>

<text>
${text}
</text>

Return a list of feedback items.
""",
    llmOptions(
      model: model,
      provider: provider,
      tools: readOnlyFileTools(),
      validationRetries: 1,
    ),
  )
}

def findCuts(
  text: string,
  task: string,
  guidelines: string,
  context: string,
  model: string,
  provider: string,
): Feedback[] {
  """
  Find passages the intended reader does not need and return cut findings.
  """
  let found: Feedback[] = []
  thread(label: "cuts") {
    found = askForCuts(
      text: text,
      task: task,
      guidelines: guidelines,
      context: context,
      model: model,
      provider: provider,
    )
  }
  return found
}

def cutsOrNothing(
  text: string,
  task: string,
  guidelines: string,
  context: string,
  model: string,
  provider: string,
): Feedback[] {
  """
  Find unnecessary passages, returning no findings when that pass fails.
  """
  const found = try findCuts(
    text: text,
    task: task,
    guidelines: guidelines,
    context: context,
    model: model,
    provider: provider,
  )
  return match(found) {
    success(items) => items
    failure(_) => []
  }
}

// The tics pass.
static const ticsPrompt = """You read prose and report verbal tics: phrases a language model reaches for that a careful editor cuts. Report nothing else. Readability, structure, and facts are reviewed by a separate pass.

The rule behind every entry: state the fact. Do not decorate it, rank it, or warn the reader about it.

Sentence shapes:

1. Contrastive binary: "not X, but Y", "neither X nor Y", "X, never Y".
   Bad: "Judge the code as Agency, never as JavaScript."
   Good: "Judge the code as Agency. Do not judge it as JavaScript."

2. Stakes-raising: a sentence that tells the reader how much the last sentence matters.
   Bad: "Facts about Agency. Get these wrong and the review is wrong."
   Good: "Facts about Agency:"

3. Aphoristic ender: a short punchy clause that closes a paragraph with a flourish. "And no more." "Full stop." "The rest is noise." "That is the whole point."

4. Colon reveal: a setup, a colon, then the point delivered as a twist.
   Bad: "The song and dance is all in one step you skipped: the parser parses literals, but the model returns text."
   Good: "The parser parses string literals. The model returns text. Converting between them is where the extra code comes from."

5. Mirrored clauses: two halves built on the same frame for effect.
   Bad: "Keep this to yourself; do not report it as a finding."
   Good: "Do not report this analysis as a finding."

6. Semicolon joins and "but" joins that leave the reader unsure which half is the instruction.
   Bad: "Rebuilding it with `failure(e)` loses nothing but is not an error."
   Good: "Return the original failure unchanged. Rebuilding it with `failure(e)` changes the source of the error message."

7. Meta-signposting: announcing the structure instead of using it. "Three things." "Here's the thing." "A quick word on how this is organized." Use a heading or a numbered list and start.

8. The reframe: "Better posed:", "Put differently:", "In other words". Say it once.

9. Negative-list prohibitions as rhythm: "No checklist, no summary line, no praise."
   Good: "Omit checklists, summary lines, and praise for correct code."

10. Shouting with capitals for emphasis: "ONLY", "NEVER", "ALL". Emphasis is a plain word in a short sentence.

11. Naming a scheme cleverly, or writing about code as if it were a person: "the reject arm has the last word", "the command also answers to", "one document, one fence". Say what the code does, and let the checks state the rule.

12. Turning a verb into a noun to save words: "costs no parse". Say "does not parse the file again".

13. Narrating a correction: "I said it before checking." Give the corrected fact, or "That was wrong."

Words and phrases:

14. "load-bearing", "seam", "surface" (as a verb), "footgun", "trap", "the flagship X". Say what the thing does.

15. "the key insight", "the real fix", "the actual problem", "the root cause". Describe the problem. The reader decides what is key.

16. "genuinely", "honestly", "the honest answer", "to be fair", "frankly". Delete the word.

17. "worth noting", "it is worth stating plainly", "note that". Delete the phrase and keep the fact.

18. "You're absolutely right", "Great question", "Fair question". Answer the question.

19. "essentially", "basically", "simply", "just", "fundamentally", "structurally". Delete.

20. "say so and I will." Delete.

21. Treating an inanimate object as an actor, especially paired with "answered": "the file answered the question", The work is a research agent's answer to the question".

How to report:
- One finding per passage. Quote the passage, name the entry by number and name, and give the plain replacement or say to delete it.
- Report a repeated word once, listing each occurrence in the quote.
- A colon that introduces a list, a code block, or an example is not a colon reveal. A lowercase "only", a short sentence, and a plain "note" as a noun are not tics. Report only the patterns above.
- When a sentence carries no fact of its own (a signpost, a flourish, a list of prohibitions the checks already state), say to delete it. Rewrite only a sentence that carries a fact.
- Clean text gets an empty list.
- Every finding is advisory: set error to false.

If the text names files instead of holding the prose, read each file and review its contents."""

def askForTics(
  text: string,
  task: string,
  guidelines: string,
  context: string,
  model: string,
  provider: string,
): Feedback[] {
  let guidelinesSection = ""
  if (guidelines != "") {
    guidelinesSection = """The caller's own writing guidelines. They outrank the rules above:
<guidelines>
${guidelines}
</guidelines>

"""
  }
  if (threadIsNew()) {
    systemMessage(ticsPrompt)
  }
  return llm(
    """
${guidelinesSection}The text was written for this task:
<task>
${withContext(task: task, context: context)}
</task>

<text>
${text}
</text>

Return a list of feedback items.
""",
    llmOptions(
      model: model,
      provider: provider,
      tools: readOnlyFileTools(),
      validationRetries: 1,
    ),
  )
}

def findVerbalTics(
  text: string,
  task: string,
  guidelines: string,
  context: string,
  model: string,
  provider: string,
): Feedback[] {
  """
  Find verbal tics and return advisory findings.
  """
  let found: Feedback[] = []
  thread(label: "verbalTics") {
    found = askForTics(
      text: text,
      task: task,
      guidelines: guidelines,
      context: context,
      model: model,
      provider: provider,
    )
  }
  return [{
    error: false,
    feedback: item.feedback
  } for item in found]
}

def verbalTicsOrNothing(
  text: string,
  task: string,
  guidelines: string,
  context: string,
  model: string,
  provider: string,
): Feedback[] {
  """
  Find verbal tics, returning no findings when that pass fails.
  """
  const found = try findVerbalTics(
    text: text,
    task: task,
    guidelines: guidelines,
    context: context,
    model: model,
    provider: provider,
  )
  return match(found) {
    success(items) => items
    failure(_) => []
  }
}

static const skills = agentSkill("writing/review")

export def buildTools(): any[] {
  """
  Return the writing reviewer's file editing, skill, and communication tools.
  """
  return [...writableFileTools(), skills, ...communicationTools()]
}

def judgeText(
  text: string,
  task: string,
  guidelines: string,
  context: string,
  model: string,
  provider: string,
  extraTools: any[],
): Feedback[] {
  if (threadIsNew()) {
    systemMessage(systemPrompt)
  }
  let guidelinesSection = ""
  if (guidelines != "") {
    guidelinesSection = """The caller's own writing guidelines. They outrank the built-in catalog:
<guidelines>
${guidelines}
</guidelines>

"""
  }
  const prompt = """
${guidelinesSection}The text was written for this task:
<task>
${withContext(task: task, context: context)}
</task>

<text>
${text}
</text>

If the text names files instead of holding the prose, read each file and
review its contents. Do not write to or edit any file unless the text
explicitly asks you to apply the fixes; when it does, apply them with the
edit tool, one finding at a time, and still return the findings you applied.
Return a list of feedback items.
"""
  // Return position so a model saveDraft propagates as partial findings.
  return llm(
    prompt,
    llmOptions(
      model: model,
      provider: provider,
      tools: buildTools().concat(extraTools).concat([saveDraft]),
    ),
  )
}

export def writingReviewAgent(
  text: string,
  task: string = "",
  guidelines: string = "",
  context: string = "",
  maxCost: number = $5.00,
  maxTime: number = 10m,
  model: string = "",
  provider: string = "",
  session: string = "",
  extraTools: any[] = [],
  failOpen: boolean = true,
): Result<Feedback[]> {
  """
  Review prose for readability and return findings, applying edits only when requested.

  @param text - Prose or a request naming files, explicitly asking for edits if wanted.
  @param task - The intended reader and what the text must communicate.
  @param guidelines - Writing guidelines that override conflicting built-in review rules.
  @param maxCost - Cost budget in USD.
  @param maxTime - Time budget in milliseconds.
  @param model - Model override, or "" for the ambient model.
  @param provider - Provider for the model override, ignored when model is empty.
  @param session - Name a conversation for the main review, or "" for an isolated thread.
  @param extraTools - Tools added to the main review only.
  @param failOpen - False returns review failures, while saved partial findings can still succeed.
  """
  const captured = writingReviewUnderBudget(
    text: text,
    task: task,
    guidelines: guidelines,
    context: context,
    model: model,
    provider: provider,
    session: session,
    extraTools: extraTools,
    maxCost: maxCost,
    maxTime: maxTime,
  )
  if (failOpen) {
    return failOpenFeedback(captured)
  }
  return captured
}

// The guarded half of writingReviewAgent, a def of its own because the
// exported def decides what a failed review returns. The cuts and tics
// passes run first, in parallel, each with its own short prompt, so the
// main prompt carries misreadings only. The main pass runs after them and
// on its own: a draft saved inside a parallel arm never reaches the guard,
// and a trip inside one skips this def's finalize. Here the assignment
// binds the findings the model saved into `items`, and the finalize hands
// them up when the budget runs out.
@guarded(cost: maxCost, time: maxTime, label: "writingReviewAgent")
def writingReviewUnderBudget(
  text: string,
  task: string,
  guidelines: string,
  context: string,
  model: string,
  provider: string,
  session: string,
  extraTools: any[],
  maxCost: number,
  maxTime: number,
): Result<Feedback[]> {
  parallel {
    let cuts = cutsOrNothing(
      text: text,
      task: task,
      guidelines: guidelines,
      context: context,
      model: model,
      provider: provider,
    )
    let tics = verbalTicsOrNothing(
      text: text,
      task: task,
      guidelines: guidelines,
      context: context,
      model: model,
      provider: provider,
    )
  }
  let items: Feedback[] = []
  thread(label: "writingReviewAgent", session: session) {
    items = judgeText(
      text: text,
      task: task,
      guidelines: guidelines,
      context: context,
      model: model,
      provider: provider,
      extraTools: extraTools,
    )
  }
  return [...items, ...cuts, ...tics]

  // The budget ran out during the main pass: the findings the model saved,
  // with the side passes' findings. Null when it saved none, so the guard
  // reports the stop.
  finalize {
    if (items == null) {
      return null
    }
    return [...items, ...cuts, ...tics]
  }
}

/** What an eval hands the reviewer: the task the text was written for, and
  the file holding that text, seeded into the working directory by the
  test's `files/`. The shape the `evals/writing-review` suite uses as its
  input. */
export type WritingReviewEvalInput = {
  assignment: string;
  sourceFile: string
}

// Any other reviewer scored on the same suite supplies a node with this
// signature. Effects are decided at this boundary. Reading the seeded input
// file is this node's own decision (`with approve`). The reviewer runs under
// `docsOnlyHandler`, which lets it read the packaged docs and rejects every
// other interrupt, so a budget trip stays a failure and the reviewer's
// fail-open result comes back instead of an interrupt escaping the entry
// point.
/** Run this module through an eval suite with `agency eval run stdlib/agents/writing/review.agency:evalMain --suite <dir>`. */
node evalMain(input: WritingReviewEvalInput): Feedback[] {
  evalValue(input)
  const source = read(input.sourceFile) with approve
  if (source is failure(readErr)) {
    return [
      {
        error: true,
        feedback: "could not read ${input.sourceFile}: ${readErr}"
      },
    ]
  }
  let reviewed: Result<Feedback[]> = failure("the reviewer never ran")
  handle {
    reviewed = writingReviewAgent(text: source.value, task: input.assignment)
  } with docsOnlyHandler
  if (reviewed is failure(err)) {
    return [{
      error: true,
      feedback: "review agent failed: ${err}"
    }]
  }
  return reviewed.value
}
