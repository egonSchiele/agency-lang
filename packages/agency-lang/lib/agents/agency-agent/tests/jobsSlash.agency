import { jobOutput, listJobs } from "std::jobs"
import { startJob } from "std::safeBash"

import { withPendingNotes } from "../lib/pendingNotes.agency"
import { jobsSlashCommand } from "../lib/slashCommands/jobs.agency"

// The user did not stop a job that had already ended, so the model is not
// told they did.
node stopAfterTheJobEndedLeavesNoNote(): string {
  handle {
    startJob("true")
  } with approve
  const id = listJobs()[0].id
  jobOutput(id, wait: 10)
  jobsSlashCommand("stop ${id}")
  return withPendingNotes("next")
}

node stopOfARunningJobTellsTheModel(): boolean {
  handle {
    startJob("sleep 30")
  } with approve
  const id = listJobs()[0].id
  jobsSlashCommand("stop ${id}")
  return withPendingNotes("next").startsWith("I stopped background job ${id} myself")
}

// The stop reads the job's last output, so the note has to carry it. The
// printf form keeps the expected text, A1, out of the command.
node stopKeepsTheUnreadOutput(): boolean {
  handle {
    startJob("printf 'A%s\\n' 1; sleep 30")
  } with approve
  const id = listJobs()[0].id
  sleep(1s)
  jobsSlashCommand("stop ${id}")
  return withPendingNotes("next").includes("A1")
}
