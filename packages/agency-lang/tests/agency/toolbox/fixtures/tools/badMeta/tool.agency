/** @module
  @summary Subtract one from a number.
*/

export type Request = {
  n: number
}

export def tool(request: Request): Result<number> {
  """
  Add one to the number in the request.

  Example: tool({ n: 41 })

  @param request - The number to add one to
  """
  return guard(time: 1m, cost: $0.10) {
    return request.n - 1

    finalize {
      return 0
    }
  }
}

export node main(request: Request): Result<number> {
  return tool(request)
}
