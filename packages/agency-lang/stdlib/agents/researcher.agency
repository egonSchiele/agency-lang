/** @module
  @summary Answers a question from web and Wikipedia sources and synthesizes
  a cited answer, retrying until every claim is grounded.

  The grounding loop is this agent's own contract: a grounded, cited answer
  is what it produces. Checking that answer against a wider task is the
  caller's job, via reviewAgent.

  Two rules of the loop live here and not in `revise` (`std::strategy`),
  which other agents use for other work. An empty answer is never
  reviewed: the model is asked once more, with no tools, to write its
  answer from what it read, and a second empty reply is a failure naming
  the cause. And a rejected answer is fixed, not redone: the next attempt
  gets the answer and the findings, patches the gaps in a subthread under
  a small round cap, and uses a fact the review already gives with its
  source instead of looking it up again. See
  docs/dev/agents/research-loop.md.
*/
import { feedbackHasErrors, renderFeedback } from "std::agents/lib/feedback"
import { hostedSearchTools, searchTools } from "std::agents/lib/search"
import { llmOptions, withContext } from "std::agents/lib/shared"
import { webTools, SAVE_DRAFT_HINT, ASK_USER_HINT } from "std::agents/lib/toolkits"
import { reviewAgent } from "std::agents/review"
import { now } from "std::date"
import { agentSkill } from "std::skills"
import { evalValue } from "std::statelog"
import { Critique, guarded, revise } from "std::strategy"
import {
  ThreadMessage,
  assistantMessage,
  ensureSystemMessage,
  threadIsNew,
  userMessage,
 } from "std::thread"

import { communicationTools } from "./lib/toolkits.agency"

static const systemPrompt = """You are a research analyst. Answer the task using your source tools.

- Ground every factual claim in a source and cite it. A citation is the full URL of the page, written out (https://...), so the reader can open it. Do not cite a tool call or a search result number.
- If your tools cannot retrieve the needed information, say so plainly. NEVER fabricate sources or facts.
- If no source describes the thing the task asks about (a feature, a product, an event), say that no source describes it. Do not describe it from memory.
- Do your own looking up: never ask the user for something a source could tell you. Answer with what you found, and say what you could not find.
- If a page will not load, try another source; do not stop on one failure.

## Communicating with the user
- Tell the user what you are doing with the `whatIAmDoing` tool when you start and when you change approach. Each call costs a tool round; spend the rounds on sources.${ASK_USER_HINT}${SAVE_DRAFT_HINT}
"""

static const skills = agentSkill("researcher")

export def buildTools(): any[] {
  """
  Return the researcher's tools: the encyclopedia and fetch tools that need
  no key, a local file read for material the caller points at, and whichever
  search providers the environment has a key for.
  """
  return [
    ...webTools(),
    read.partial(useAgentCwd: true),
    ...searchTools(),
    skills,
    ...communicationTools(),
  ]
}

static const groundingInstruction = "Judge grounding: error=true if a claim is ungrounded or uncited or the task is not fully answered. When you verified a point against a page, put that page's URL in `source`."

// A first reply shorter than this is treated as no answer: an empty
// string, or a few words where a cited answer was asked for. Reviewing it
// wastes the review, which in trace wX5GvrUq did the research itself and
// reported seven gaps against nothing. The floor applies to the first
// reply only: a short reply to the follow-up is an answer the model gave
// twice, and the review judges it.
static const MIN_ANSWER_CHARS = 20

static const NO_ANSWER_FOLLOWUP = "You returned no answer. Write your answer now from what you have read, citing sources."

// Tool rounds a fix attempt may use. It starts from an answer and a list
// of gaps, so it needs a few fetches at most, where the first attempt
// needs thirty.
static const FIX_ROUNDS = 8

def answerIsBlank(answer: any): boolean {
  if (answer == null) {
    return true
  }
  const text: string = "${answer}"
  return text.trim().length == 0
}

def answerIsEmpty(answer: any): boolean {
  if (answer == null) {
    return true
  }
  const text: string = "${answer}"
  return text.trim().length < MIN_ANSWER_CHARS
}

/** The brief for a fix attempt: the answer so far and the findings,
  with the instruction to patch the gaps and keep the rest. */
def fixPrompt(answer: string, critique: string): string {
  return """Your answer so far:

<answer>
${answer}
</answer>

A review found these gaps:

<review>
${critique}
</review>

Patch these specific gaps and keep everything else as it is. Where a finding already gives the fact and the source that backs it, use them as given and cite that source; do not look it up again. Fetch only what the review does not give you, and only for a gap it names. Return the complete, corrected answer.
"""
}

def checkGrounding(task: string, startedAt: number, answer: any): Critique {
  // An attempt that could not produce an answer is reported, not
  // reviewed: accepting it ends the loop, and the failure reaches the
  // caller with its cause.
  if (isFailure(answer)) {
    return {
      accepted: true,
      feedback: ""
    }
  }
  // Verification effort scales with the work: the review gets half the
  // time the answer took to produce, clamped between 20s and 2m. A
  // 70-second answer gets a 35-second check instead of a 2-minute one;
  // a long research run keeps the old cap.
  let reviewTime = (now() - startedAt) / 2
  if (reviewTime < 20s) {
    reviewTime = 20s
  }
  if (reviewTime > 2m) {
    reviewTime = 2m
  }
  const reviewed = reviewAgent(
    work: "${answer}",
    task: task,
    context: groundingInstruction,
    maxCost: $1.00,
    maxTime: reviewTime,
    failOpen: false,
  )
  // A review that could not run (its budget ran out with no findings
  // saved, or the model failed) is not a clean pass. Accepting the answer
  // would report it as checked when nothing checked it.
  if (reviewed is failure(err)) {
    return {
      accepted: false,
      feedback: """
The review of your answer could not finish (${err}), so nothing confirmed your sources.

Check that every claim is backed by a source you fetched, cite it, and fix any claim you cannot back.
"""
    }
  }
  if (!feedbackHasErrors(reviewed)) {
    return {
      accepted: true,
      feedback: ""
    }
  }
  // The findings alone. The fix attempt's brief (fixPrompt) says what to
  // do with them; an instruction here to retrieve more would contradict
  // it, and re-fetching is what the fix attempt exists to avoid.
  return {
    accepted: false,
    feedback: """
Your answer has gaps:

${renderFeedback(reviewed)}
"""
  }
}

def researchLoop(
  task: string,
  context: string,
  history: ThreadMessage[],
  maxAttempts: number,
  model: string,
  provider: string,
  extraTools: any[],
): string {
  const researchTools = buildTools()
  const fresh = threadIsNew()
  // A handoff runs on the caller's thread, which may already hold the
  // persona; the push is skipped when it does.
  ensureSystemMessage(systemPrompt)
  if (fresh) {
    // The conversation so far, so the question is read in its context. A
    // shared session already holds its history and is not seeded again.
    for (message in history) {
      if (message.role == "assistant") {
        assistantMessage(message.content)
      } else {
        userMessage(message.content)
      }
    }
  }
  const question = withContext(task: task, context: context)
  const startedAt = now()
  const tools = [...researchTools, ...extraTools, saveDraft]
  const hostedTools = hostedSearchTools(model, provider)
  // The last attempt's answer, for the fix attempt that follows a
  // rejection. The block writes it; revise only hands the next attempt
  // the critique.
  let lastAnswer = ""
  return revise(
    maxAttempts: maxAttempts,
    check: checkGrounding.partial(task: task, startedAt: startedAt),
  ) as critique {
    let answer: any = null
    if (critique == "") {
      answer = llm(
        question,
        llmOptions(
          model: model,
          provider: provider,
          tools: tools,
          hostedTools: hostedTools,
          // A research run is many searches and fetches; the default ten
          // rounds end it before the sources are in.
          maxToolCallRounds: 30
        ),
      )
      if (answerIsEmpty(answer)) {
        // The model read its sources and then wrote nothing (its reply
        // went to thinking, or it stopped). Ask once more on the same
        // thread, with no tools, so the only thing it can do is answer.
        // Any non-blank reply is the attempt, however short: the review
        // judges it. Two blank replies are a failure the caller sees.
        answer = llm(NO_ANSWER_FOLLOWUP, llmOptions(model: model, provider: provider))
        if (answerIsBlank(answer)) {
          return failure("the model returned no answer twice")
        }
      }
    } else {
      // A fix, not a redo: the answer plus the findings, in a subthread
      // so the research thread does not grow by a second attempt, under
      // a round cap sized for patching. A fix that comes back empty
      // keeps the answer it was given, which is still the best one; the
      // check then reviews that answer again, which revise gives no way
      // to skip.
      subthread {
        answer = llm(
          fixPrompt(lastAnswer, critique),
          llmOptions(
            model: model,
            provider: provider,
            tools: tools,
            hostedTools: hostedTools,
            maxToolCallRounds: FIX_ROUNDS
          ),
        )
      }
      if (answerIsEmpty(answer)) {
        answer = lastAnswer
      }
    }
    lastAnswer = answer
    saveDraft(answer)
    return answer
  }
}

@guarded(cost: maxCost, time: maxTime)
export handoff def researcherAgent(
  task: string,
  context: string = "",
  maxAttempts: number = 3,
  maxCost: number = $50.00,
  maxTime: number = 30m,
  model: string = "",
  provider: string = "",
  session: string = "",
  extraTools: any[] = [],
  history: ThreadMessage[] = [],
): Result<string> {
  """
  Answer a research question from web and Wikipedia sources and return a
  cited answer, retrying while a review finds ungrounded claims.

  @param task - The research question
  @param context - Extra material folded into the prompt, or ""
  @param history - The conversation before the question, oldest first, so
    the question is read in its context; [] for none
  @param maxAttempts - Attempts before returning: one research pass, then
    fix passes that patch the review's findings
  @param maxCost - Hard spend cap
  @param maxTime - Hard wall-clock cap
  @param model - Model override, or "" for the ambient model
  @param provider - Provider for the model override
  @param session - Session name to share a thread across calls, or "" for isolated
  @param extraTools - Extra tools to offer the LLM, appended to the built-in set
  """

  // Return position: when the budget runs out, the best answer revise had
  // (its last completed attempt, or the draft a first attempt saved)
  // reaches the guard and comes back as the result.
  return researchLoop(
    task: task,
    context: context,
    history: history,
    maxAttempts: maxAttempts,
    model: model,
    provider: provider,
    extraTools: extraTools,
  )
}

/** Approves the effects a research run needs, web fetches, searches,
  Wikipedia, and the env reads that bind search keys, and rejects every
  other interrupt, so a budget trip stays a failure. */
def researchOnlyHandler(intr) {
  return match(intr.effect) {
    "std::http::fetch" => approve()
    "std::http::fetchJSON" => approve()
    "std::http::fetchMarkdown" => approve()
    "std::search" => approve()
    "std::tavilySearch" => approve()
    "std::wikipedia::search" => approve()
    "std::wikipedia::summary" => approve()
    "std::wikipedia::article" => approve()
    _ => reject()
  }
}

/** What an eval hands the researcher: the question, and the conversation
  before it when the test has one. The shape the `evals/researcher` suite
  uses as its input. */
export type ResearchEvalInput = {
  task: string;
  history?: ThreadMessage[]
}

/** Eval entry point: `agency eval run stdlib/agents/researcher.agency:evalMain
  --suite <dir>`. Runs the researcher with a small budget under
  researchOnlyHandler and returns the answer text, or a line saying why
  there is none, so graders always get a string. */
node evalMain(input: ResearchEvalInput): string {
  evalValue(input)
  let history: ThreadMessage[] = []
  if (input.history != null) {
    history = input.history
  }
  let answer: Result<string> = failure("the researcher never ran")
  handle {
    answer = researcherAgent(
      task: input.task,
      history: history,
      maxCost: $3.00,
      maxTime: 6m,
    )
  } with researchOnlyHandler
  if (answer is failure(err)) {
    return "research agent failed: ${err}"
  }
  return answer.value
}
