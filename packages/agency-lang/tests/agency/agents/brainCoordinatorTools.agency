// The coordinator brain's own tools: which they are, and that the settings
// bound to the subagents never reach the model's schema.
import { coordinatorTools } from "std::agents/brains/coordinator"
import { AgentSettings } from "std::agents/brains/settings"
import { writableFileTools } from "std::agents/lib/toolkits"
import { now } from "std::date"

// Every model request, in order.
let calls: any[] = []

callback("onLLMCallStart") as data {
  calls = [...calls, data]
}

def plainSettings(): AgentSettings {
  return {
    context: "",
    model: "",
    provider: "",
    reasoningModel: "",
    reasoningProvider: "",
    routerModel: "",
    routerProvider: "",
    judgeModel: "",
    judgeProvider: "",
    imageModel: "",
    imageProvider: "",
    coderTools: []
  }
}

// The subagents, the image tools, the file tools, and the clock. No job
// tool and no tool that only the command line offers.
node toolNamesMatch(): string {
  const names = [tool.name for tool in coordinatorTools(plainSettings(), now())]
  const expected = [
    "researchAgent",
    "codeAgent",
    "agencyCodeAgent",
    "reviewAgent",
    "oracleAgent",
    "explorerAgent",
    "writingAgent",
    "rewriteAgent",
    "generateImageFile",
    "viewImageFile",
    ...[tool.name for tool in writableFileTools()],
    "elapsedTime",
  ]
  const missing = [name for name in expected if !names.includes(name)]
  const extra = [name for name in names if !expected.includes(name)]
  if (missing.length > 0 || extra.length > 0) {
    return "FAIL missing ${missing.join(", ")}; extra ${extra.join(", ")}"
  }
  return "pass"
}

// The schema the model receives for each tool has no `settings` and no
// `since` parameter, and the image tool has no `model` or `provider`.
node settingsAreHidden(): string {
  llm("Reply with ok.", { tools: coordinatorTools(plainSettings(), now()) })
  let leaked: string[] = []
  for (tool in calls[0].tools) {
    // A recorded tool's schema keeps its parameters under `def.shape`.
    const params = Object.keys(tool.schema.def.shape)
    const imageModelShown = tool.name == "generateImageFile" && (params.includes("model") || params.includes("provider"))
    if (params.includes("settings") || params.includes("since") || imageModelShown) {
      leaked.push(tool.name)
    }
  }
  if (leaked.length > 0) {
    return "FAIL ${leaked.join(", ")}"
  }
  return "pass"
}

// A one-pixel PNG.
static const PIXEL_PNG = "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+M8AAAMBAQDJ/pLvAAAAAElFTkSuQmCC"

// The image tool makes images with the settings' image model. Editing a
// local image asks before uploading it, and the question names the model
// the image goes to, so the answer shows which model was bound.
node imageToolUsesTheImageModel(): string {
  writeBinary("bct-seed.png", PIXEL_PNG, "/tmp") with approve
  const settings: AgentSettings = {
    ...plainSettings(),
    imageModel: "gemini-3.1-flash-image",
    imageProvider: "google"
  }
  const tools = coordinatorTools(settings, now())
  const imageTool = [tool for tool in tools if tool.name == "generateImageFile"][0]
  let named = "no upload question"
  handle {
    imageTool("restyle it", "/tmp/bct-out.png", images: ["/tmp/bct-seed.png"])
  } with (intr) {
    if (intr.effect == "std::uploadImage") {
      named = "${intr.data.provider}/${intr.data.model}"
    }
    return reject()
  }
  return named
}
