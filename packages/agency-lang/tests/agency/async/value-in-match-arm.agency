// The first mention of `value` is inside a `match` arm. The join is before
// the `match`, so the arm sees the value, after "side end".
import { reset, record, logText } from "./order-log.js"

def slowSide(): string {
  sleep(200)
  record("side end")
  return "side value"
}

node main() {
  reset()
  const kind = "a"
  let value = async slowSide()
  record("main")
  match (kind) {
    "a" => record("use: ${value}")
    _ => record("other")
  }
  return logText()
}
