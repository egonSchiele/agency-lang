import { ExpertGuidance, emptyGuidance } from "std::agents/lib/expertGuidance"
import { llmOptions, withContext } from "std::agents/lib/shared"
import { agencyDocTools, agencyCodeTools } from "std::agents/lib/toolkits"
import { guarded } from "std::decorators"
import { agentSkill } from "std::skills"
import { systemMessage, threadIsNew } from "std::thread"

/** @module
@summary Get Agency syntax guidance and acceptance criteria from the bundled docs.

Use `agencyExpertAgent` before generating Agency source when a task needs
language-specific guidance. Pass `renderGuidance` output as the coding
agent's context, or give the checklist to a verifier. The shared helpers
are in `std::agents/lib/expertGuidance`.
*/

static const skills = agentSkill("agency/expert")

export def buildTools(): any[] {
  """
  Return the Agency expert's documentation and source-checking tools.
  """
  return [...agencyDocTools(), ...agencyCodeTools(), skills]
}

static const systemPrompt = """Advise a coding agent on the Agency knowledge it needs for this task.
Consult the bundled documentation and return:
- domain: "agency-lang".
- rules: applicable syntax, conventions, and pitfalls, with guide citations.
- checklist: acceptance criteria and how to verify each one. Give an exact
  command, such as `agency typecheck <file>`, or the construct to inspect.
  Prefer executable checks.

Call out ambiguity and require affected criteria under every reasonable
reading. Return empty rules and checklist when no special Agency knowledge
is needed."""

def consult(
  task: string,
  context: string,
  model: string,
  provider: string,
  extraTools: any[],
): ExpertGuidance {
  if (threadIsNew()) {
    systemMessage(systemPrompt)
  }
  // Return position so a model saveDraft propagates as partial guidance.
  return llm(
    "Task:\n${withContext(task: task, context: context)}",
    llmOptions(model: model, provider: provider, tools: buildTools().concat(extraTools).concat([saveDraft])),
  )
}

@guarded(cost: maxCost, time: maxTime)
export def agencyExpertAgent(
  task: string,
  context: string = "",
  maxCost: number = $10.00,
  maxTime: number = 10m,
  model: string = "",
  provider: string = "",
  session: string = "",
  extraTools: any[] = [],
): Result<ExpertGuidance> {
  """
  Consult an Agency-language specialist: return the syntax rules and
  acceptance checklist a solver needs, grounded in the bundled docs.

  @param task - The task to advise on
  @param context - Extra material, or ""
  @param maxCost - Cost budget in USD.
  @param maxTime - Time budget in milliseconds.
  @param model - Model override, or "" for the ambient model
  @param provider - Provider for the model override, ignored when model is empty.
  @param session - Session name to share a thread across calls, or "" for isolated
  @param extraTools - Extra tools to offer the LLM, appended to the built-in set
  """
  thread(label: "agencyExpertAgent", session: session) {
    return consult(
      task: task,
      context: context,
      model: model,
      provider: provider,
      extraTools: extraTools,
    )
  }
}
