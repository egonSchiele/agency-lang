import { LlmOptions } from "../../../lib/llmOptions.agency"
import { takePendingLlmOptions } from "../../../lib/session.agency"
import { useLlmOptions } from "../llmOptionTools.agency"

static const AVOID: LlmOptions = { openRouter: { provider: { ignore: ["open-inference"] } } }

node refusesAModelField(): string {
  const options: any = { model: "x" }
  const reply = useLlmOptions(options) with approve
  return "${reply.startsWith("Not set")} ${takePendingLlmOptions() == null}"
}

node anApprovedChangeIsRecordedForTheRepl(): string {
  const reply = useLlmOptions(AVOID) with approve
  const first = takePendingLlmOptions()
  const second = takePendingLlmOptions()
  return "${reply.includes("openRouter")} ${JSON.stringify(first)} ${second == null}"
}

node aRejectedChangeRecordsNothing(): string {
  const reply = useLlmOptions(AVOID) with reject
  return "${isFailure(reply)} ${takePendingLlmOptions() == null}"
}

node anEmptyBlockGoesBack(): string {
  const reply = useLlmOptions({}) with approve
  return "${reply.includes("preset")} ${JSON.stringify(takePendingLlmOptions())}"
}

static const STUDIO_URL = "https://studio.ts.net:8090/v1"

node aServerAddressAsksFirst(): string {
  let asked: string[] = []
  let urlNamed = false
  let reply = ""
  handle {
    reply = useLlmOptions({ baseUrl: { mlx: STUDIO_URL } })
  } with (intr) {
    asked.push(intr.effect)
    if (intr.effect == "agent::llmServer") {
      urlNamed = intr.message.includes(STUDIO_URL) && intr.data.url == STUDIO_URL
    }
    return approve()
  }
  return "${asked.join(",")} ${urlNamed} ${JSON.stringify(takePendingLlmOptions())}"
}

node aRejectedServerRecordsNothing(): string {
  let askedForOptions = false
  let reply = ""
  handle {
    reply = useLlmOptions({ baseUrl: { mlx: STUDIO_URL } })
  } with (intr) {
    if (intr.effect == "agent::llmServer") {
      return reject("not that server")
    }
    askedForOptions = true
    return approve()
  }
  return "${reply.startsWith("Not set")} ${askedForOptions} ${takePendingLlmOptions() == null}"
}

node noServerAddressAsksNoServerQuestion(): string {
  let asked: string[] = []
  handle {
    useLlmOptions(AVOID)
  } with (intr) {
    asked.push(intr.effect)
    return approve()
  }
  takePendingLlmOptions()
  return asked.join(",")
}
