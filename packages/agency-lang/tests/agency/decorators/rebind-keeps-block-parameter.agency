// The decorated function's own block parameter is not in call.args and a
// rebind leaves it alone: the body can still call it.
def ten(call: Call, block: (args: object) -> any): any {
  return block({ n: 10 })
}

@ten
def f(n: number, body: () -> number): number {
  return n + body()
}

node main() {
  return f(1) {
    return 5
  }
}
