/** @module
  @summary The two coders of the Agency agent's coordinator brain. Both are
  the stdlib coding agent (`std::agents/coding`), and both are handoffs:
  they continue the coordinator's conversation, so they see the request and
  whatever was read before it, and their edits and test output stay in its
  history.

  `codeAgent` is for every language but Agency. `agencyCodeAgent` adds the
  Agency prompt, the bundled docs tools, and the typecheck and test tools.
  The docstrings are written for routing, not for the agents' own
  behaviour. The coordinator binds `settings` with `.partial`, so the model
  never sees it.

  Relative paths resolve against the agent working directory
  (`setAgentCwd`/`getAgentCwd`).
*/
import { cli, cliHandles, CLI_NOT_AVAILABLE } from "std::agency"
import { AgentSettings, commandJudgeOf } from "std::agents/brains/settings"
import { timeBudget } from "std::agents/brains/coordinator/budgets"
import { codingAgent } from "std::agents/coding"
import { agencyCodeTools, agencyDocToolsBrief } from "std::agents/lib/toolkits"
import { getAgentCwd } from "std::index"
import { exec } from "std::shell"
import { agentPrompt } from "std::skills"
import { emit } from "std::statelog"
import { ensureSystemMessage } from "std::thread"

export def agencyCli(args: string[]): any {
  """
  Run the `agency` CLI with the given arguments. Returns an object with
  `stdout`, `stderr`, and `exitCode` (same shape as `bash`). `test`,
  `typecheck`, `ast`, `fmt`, and `run <file>` run in-process through the
  matching std::agency function (testFile, typecheckFile, parseAST,
  format, runFile), which you can also call directly. Other subcommands
  run the executable, which may not be installed. Arguments are passed
  directly (no shell interpretation).

  @param args - CLI arguments, e.g. ["typecheck", "foo.agency"]. The
    first element is the subcommand.
  """
  if (args.length > 0 && cliHandles(args[0])) {
    const ran = cli(args, getAgentCwd())
    if (ran is failure(err)) {
      return {
        stdout: "",
        stderr: "${err}",
        exitCode: 1
      }
    }
    return ran.value
  }
  const result = exec("agency", args, useAgentCwd: true)
  if (result.exitCode != 0 && result.stderr.includes("ENOENT")) {
    return {
      stdout: "",
      stderr: CLI_NOT_AVAILABLE,
      exitCode: result.exitCode
    }
  }
  return result
}

// The tour of the language that the stdlib Agency writer also gets. It is ""
// when the file did not ship, and tests/agency/agency-agent-code-prompt.agency
// fails in that case. Exported for that test.
export static const agencyTutorial = agentPrompt("agency-tutorial.md") catch ""

// The Agency coder's rules. "" when the file did not ship, and the same
// test fails in that case. Exported for that test.
export static const agencyCodeRules = agentPrompt("agency-code.md") catch ""

// The Agency coder's system prompt: the rules, then the tutorial. It expires
// with the handoff, as every system message pushed during one does.
export static const agencyCodePrompt = """${agencyCodeRules}

<agency_tutorial>
${agencyTutorial}
</agency_tutorial>
"""

// The default budget for one coder dispatch.
static const CODE_MAX_COST = $20.00
static const CODE_MAX_TIME = 15m

// What the Agency coder is given on top of the stdlib coding agent's own
// tools. The plain coder gets the stdlib tools alone.
def agencyCodeExtras(): any[] {
  return [
    ...agencyDocToolsBrief(),
    ...agencyCodeTools(),
    agencyCli,
  ]
}

// Both coders are the stdlib coding agent. They differ in the tools they
// add.
def runCoder(
  settings: AgentSettings,
  userMsg: string,
  maxSeconds: number | null,
  maxDollars: number | null,
  extras: any[],
): Result<string> {
  return codingAgent(
    task: userMsg,
    context: settings.context,
    maxCost: maxDollars ?? CODE_MAX_COST,
    maxTime: timeBudget(maxSeconds, CODE_MAX_TIME),
    model: settings.model,
    provider: settings.provider,
    extraTools: [...extras, ...settings.coderTools],
    commandJudge: commandJudgeOf(settings),
  )
}

export handoff def codeAgent(
  settings: AgentSettings,
  userMsg: string,
  maxSeconds: number | null = null,
  maxDollars: number | null = null,
): Result<string> {
  """
  Hand a coding task to the coder: reading, writing, and editing code,
  running commands, builds, and tests. Use it for every language except
  Agency. It continues this conversation, so it sees everything above, and
  its edits and command output stay in your history.

  @param userMsg - what needs doing.
  @param maxSeconds - working-time cap in seconds, when the user gave a
    deadline; null for the default (15 minutes).
  @param maxDollars - spend cap in dollars, when the user gave one; null
    for the default ($20).
  """
  emit({ type: "agencyAgent.subagentStart", agent: "codeAgent", message: userMsg })
  return runCoder(settings, userMsg, maxSeconds, maxDollars, [])
}

export handoff def agencyCodeAgent(
  settings: AgentSettings,
  userMsg: string,
  maxSeconds: number | null = null,
  maxDollars: number | null = null,
): Result<string> {
  """
  Hand a task about Agency code to the Agency coder: writing, editing,
  typechecking, running, and testing `.agency` files, and questions about
  Agency syntax, the standard library, or the `agency` CLI. It has the
  Agency documentation and the typechecker, which the general coder does
  not. It continues this conversation, so it sees everything above, and
  its edits and command output stay in your history.

  @param userMsg - what needs doing.
  @param maxSeconds - working-time cap in seconds, when the user gave a
    deadline; null for the default (15 minutes).
  @param maxDollars - spend cap in dollars, when the user gave one; null
    for the default ($20).
  """
  emit({ type: "agencyAgent.subagentStart", agent: "agencyCodeAgent", message: userMsg })
  ensureSystemMessage(agencyCodePrompt)
  return runCoder(settings, userMsg, maxSeconds, maxDollars, agencyCodeExtras())
}
