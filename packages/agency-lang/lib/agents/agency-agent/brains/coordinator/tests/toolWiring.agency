/*
 * Smoke tests for the Agency Agent's subagent wiring.
 *
 * These exercise the exact path that broke when `skillsDir` returned
 * several tools all named `read`: each subagent's exported tool list is
 * handed to a real `llm(...)` call. The runtime rejects duplicate tool
 * names before the request is sent, so a regression to colliding names
 * makes the corresponding `llm()` call fail and the node return "FAIL: …"
 * instead of "ok".
 *
 * On PR CI this runs deterministically under AGENCY_USE_TEST_LLM_PROVIDER
 * (no API key / network). On the post-merge real-LLM workflow the same
 * tests run against a real provider — the assertions only depend on the
 * call succeeding, not on the response content, so both modes pass.
 */
import { codeTools } from "../subagents/code.agency"
import { researchTools } from "../subagents/research.agency"
// The oracle and the explorer live in the stdlib now, so their tool lists
// come from there. The check is the same: the agency agent still offers them,
// so a duplicate name in either list still breaks this agent.
import { buildTools as oracleTools } from "std::agents/oracle"
import { buildTools as explorerTools } from "std::agents/explorer"
// The two research agents researchAgent routes to. researchTools is handed to
// whichever one runs as extraTools, so the list that reaches the provider is
// the agent's own tools plus researchTools plus the saveDraft the agent appends.
import { buildTools as agencyResearcherOwnTools } from "std::agents/agency/researcher"
import { buildTools as researcherOwnTools } from "std::agents/researcher"
import { question } from "std::agent"
import { filter, find, map } from "std::array"
import { now } from "std::date"
import { buildTools as agencyReviewTools } from "std::agents/agency/review"
import { buildTools as reviewTools } from "std::agents/review"
import { buildTools as writingReviewTools } from "std::agents/writing/review"

import test { _setLearnedRoot } from "../../../lib/learned.agency"
import { LEARNED_SKILLS_TOOL, LEARNED_TOOL_PREFIX } from "../../../lib/learned.agency"
import { mainAgentTools, turnTools } from "../coordinator.agency"
import { checkBundledSkill } from "../lib/bundledSkills.agency"

def pingWith(tools: any[]): string {
  // Reject any interrupt a tool might raise. Under the deterministic
  // provider no tools are called, so this never fires. Under a real LLM the
  // model could decide to invoke a tool in response to the prompt; with no
  // handler that interrupt would propagate out of the node and the tool's
  // side effect could run. Rejecting keeps every tool side-effect-free
  // (the tool returns a failure to the model, which then answers in text)
  // while letting the llm() call complete. The assertion only cares that
  // the request — built from this tool list — is accepted by the provider
  // and the call returns, not what the model does with it.
  let r: Result = failure("unset")
  handle {
    r = try llm(
      "Reply with the single word: ok. Do not call any tools.",
      { tools: tools },
    )
  } with (data) {
    return reject()
  }
  if (r is failure(e)) {
    return "FAIL: ${e}"
  }
  return "ok"
}

node codeToolsHaveUniqueNames() {
  return pingWith(codeTools)
}

node researchToolsHaveUniqueNames() {
  return pingWith(researchTools)
}

// Pinging a list on its own is what let a real duplicate through: researchTools
// carried saveDraft and so did the agent receiving it, so neither list was wrong
// by itself. These ping what each research agent actually sends.
node composedAgencyResearchToolsHaveUniqueNames() {
  return pingWith([...agencyResearcherOwnTools(), ...researchTools, question, saveDraft])
}

node composedResearchToolsHaveUniqueNames() {
  return pingWith([...researcherOwnTools(), ...researchTools, saveDraft])
}

node oracleToolsHaveUniqueNames() {
  return pingWith(oracleTools())
}

node explorerToolsHaveUniqueNames() {
  return pingWith(explorerTools())
}

// Learned tools are offered as learned_<name>. That only keeps them from
// shadowing a built-in tool if no built-in tool uses the prefix. Every
// list a learned tool can join is here; PR 5 extends it when it wires a
// subagent whose tools are not yet listed.
node noBuiltinToolUsesTheLearnedPrefix() {
  const builtIn: any[] = [
    ...mainAgentTools,
    ...codeTools,
    ...researchTools,
    ...oracleTools(),
    ...explorerTools(),
    ...agencyResearcherOwnTools(),
    ...researcherOwnTools(),
    ...reviewTools(),
    ...agencyReviewTools(),
    ...writingReviewTools(),
  ]
  const names = map(builtIn, \tool -> "${tool.name}")
  const clashing = filter(names, \name -> name.startsWith(LEARNED_TOOL_PREFIX))
  if (clashing.length > 0) {
    return "FAIL: ${clashing.join(", ")}"
  }
  return "ok"
}

// The coordinator's own list, which is the one learnSkill and writeToolFor
// join. The runtime rejects duplicate names before the request is sent.
node coordinatorToolsHaveUniqueNames() {
  return pingWith(mainAgentTools)
}

// The coordinator builds its list per turn so a tool saved in this
// session is callable on the next one. Before this was wired, a saved
// tool was never offered to any agent.
node coordinatorTurnOffersLearnedTools(): string {
  _setLearnedRoot("${__dirname}/../../../tests/learned-fixture")
  let names: string[] = []
  handle {
    names = map(turnTools(now()), \tool -> "${tool.name}")
  } with approve
  if (!names.includes(LEARNED_SKILLS_TOOL)) {
    return "FAIL: no ${LEARNED_SKILLS_TOOL} in ${names.join(", ")}"
  }
  if (!names.includes("${LEARNED_TOOL_PREFIX}hnTop")) {
    return "FAIL: no ${LEARNED_TOOL_PREFIX}hnTop in ${names.join(", ")}"
  }
  return "ok"
}

node coordinatorSkillsListPresets(): string {
  const tool = find(mainAgentTools, \tool -> tool.name == "coordinator_skills")
  if (tool == null) {
    return "mainAgentTools has no tool named coordinator_skills"
  }
  return match(checkBundledSkill(tool, "presets")) {
    failure(reason) => reason
    _ => ""
  }
}

// Every subagent can ask the user. Most get `question` through
// communicationTools(); the few that do not claim that bundle are handed it
// at the call site, and those lists are pinged below, where a second copy
// of the tool would be rejected as a duplicate name.
def offersQuestion(tools: any[]): boolean {
  return find(tools, \tool -> "${tool.name}" == "question") != null
}

node subagentsOfferQuestion(): string {
  let missing: string[] = []
  if (!offersQuestion(codeTools)) { missing.push("code") }
  if (!offersQuestion(explorerTools())) { missing.push("explorer") }
  if (!offersQuestion(reviewTools())) { missing.push("review") }
  if (!offersQuestion(researcherOwnTools())) { missing.push("researcher") }
  if (!offersQuestion(writingReviewTools())) { missing.push("writing") }
  if (missing.length > 0) {
    return "FAIL: no question tool for ${missing.join(", ")}"
  }
  return "ok"
}

// The coordinator holds the conversation, so it asks directly rather than
// through a subagent. Its list is built per turn, so the check has to build
// one too.
node coordinatorTurnOffersQuestion(): string {
  let names: string[] = []
  handle {
    names = map(turnTools(now()), \tool -> "${tool.name}")
  } with approve
  if (!names.includes("question")) {
    return "FAIL: no question in ${names.join(", ")}"
  }
  return "ok"
}

// The two agents handed `question` at the call site rather than through the
// bundle. Adding communicationTools() to either one without dropping the
// call-site copy would send two tools named `question`, which the runtime
// rejects before the request goes out.
node composedOracleToolsHaveUniqueNames() {
  return pingWith([...oracleTools(), question, saveDraft])
}

node composedAgencyReviewToolsHaveUniqueNames() {
  return pingWith([...agencyReviewTools(), question, saveDraft])
}
