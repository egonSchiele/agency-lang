/** @module
  @summary The harness side of save and resume: which session this run is
  (new, `--continue`, or `--resume`), the restore, and the per-turn
  record. The files live in sessions.agency and the title in
  sessionTitle.agency.
*/
import { now } from "std::date"
import { cwd } from "std::system"
import { chooseOption, ChoiceItem } from "std::ui"

import { _readTranscript } from "agency-lang/stdlib-lib/agentSessions.js"

import {
  SessionRecord,
  findSession,
  listSessions,
  mostRecentSession,
  newSessionId,
  projectDir,
  readCheckpointFile,
  saveSession,
  sessionLabel,
 } from "./sessions.agency"
import { cleanTitle, conversationText, shouldRefreshTitle, titleFor } from "./sessionTitle.agency"
import { showTranscript } from "./transcript.agency"
import { AgentBrain } from "../brains/brain.agency"

// The session this run writes to; null for one-shot runs, which are not
// saved. A `let`, so a restore brings back the resumed session's own
// record, turn count and title included.
let _current: SessionRecord | null = null

// Set by the REPL when a turn ran to completion, so a slash command or an
// empty line is not recorded as a turn.
let _turnDone = false

// Set by `/rename`: the record changed without a turn, and the title is
// the user's now.
let _renamed = false
let _titlePinned = false

// The brain's conversation session, for the title and the transcript.
let _conversation = ""

/** Where to write after a turn: the session directory and its index row. */
export type SaveTarget = {
  dir: string;
  record: SessionRecord
}

/** The footer text: the session title, or "" before the first turn. */
export def sessionTitle(): string {
  const record = _current
  if (record == null) {
    return ""
  }
  return record.title
}

export def markTurnDone() {
  _turnDone = true
}

/** `/rename <title>`: give the session a title of the user's choosing.
  Returns the line to show. The REPL saves after this line. */
export def renameSession(title: string): string {
  const record = _current
  if (record == null) {
    return "No session to rename."
  }
  const clean = cleanTitle(title)
  if (clean == "") {
    return "Usage: /rename <title>"
  }
  record.title = clean
  _renamed = true
  _titlePinned = true
  return "Session renamed: ${clean}"
}

/** Which saved session, if any, this run continues. `resumeArg` is the
  `--resume` value: null when absent, "" for a bare `--resume` (open the
  picker), else an id. Exits on an unknown id. */
export def chooseSession(
  continueFlag: boolean,
  resumeArg: string | null,
): SessionRecord | null {
  if (resumeArg != null && resumeArg != "") {
    const found = findSession(resumeArg)
    if (found == null) {
      print(color.red("No saved session with id ${resumeArg} in ${cwd()}."))
      process.exit(1)
    }
    return found
  }
  if (resumeArg == "") {
    return pickSession()
  }
  if (continueFlag) {
    const recent = mostRecentSession()
    if (recent == null) {
      print(color.yellow("No saved session for this directory; starting a new one."))
    }
    return recent
  }
  return null
}

def pickSession(): SessionRecord | null {
  const all = listSessions()
  if (all.length == 0) {
    print(color.yellow("No saved sessions for this directory; starting a new one."))
    return null
  }
  const nowMs = now()
  // A "new session" row rather than allowCancel: before the REPL exists,
  // Escape raises a cancellation instead of returning "".
  let items: ChoiceItem[] = [
    {
    key: "new",
    label: "Start a new session"
  },
  ]
  for (record in all) {
    items.push({
      key: record.id,
      label: sessionLabel(record, nowMs)
    })
  }
  const choice = chooseOption(
    "Resume a session",
    "Pick a saved session from this directory.",
    items,
  )
  if (choice == "new") {
    return null
  }
  return findSession(choice)
}

/** Start this run's session. A new one gets a fresh record. A saved one
  is restored right here: the Agency execution state becomes the saved
  one and the program continues from the saved point. The saved
  conversation is printed before the restore, since nothing after
  `restore` runs. */
export def startSession(chosen: SessionRecord | null, brain: AgentBrain) {
  _conversation = brain.session
  if (chosen == null) {
    const t = now()
    _current = {
      id: newSessionId(),
      cwd: cwd(),
      brain: brain.name,
      created: t,
      lastActive: t,
      turns: 0,
      title: ""
    }
    return
  }
  const cp = readCheckpointFile(chosen.id)
  if (cp == null) {
    print(color.red("The checkpoint file for session ${chosen.id} is missing or malformed."))
    process.exit(1)
  }
  print(color.dim("Resuming: ${chosen.title}"))
  showTranscript(_readTranscript(cp, brain.session))
  restore(cp, {})
}

/** Record a completed turn: bump the count, refresh the title when due,
  and say where the checkpoint should be written. Null when there is
  nothing to save: no turn ran and no rename happened. */
export def recordTurn(userMsg: string): SaveTarget | null {
  const record = _current
  if (record == null || (!_turnDone && !_renamed)) {
    return null
  }
  _renamed = false
  if (!_turnDone) {
    return {
      dir: projectDir(),
      record: record
    }
  }
  _turnDone = false
  record.turns = record.turns + 1
  record.lastActive = now()
  if (!_titlePinned && shouldRefreshTitle(record.turns)) {
    // Title the conversation so far, the reply included, so turn 1 sees
    // the first exchange and not just the prompt. The prompt alone is the
    // fallback when the brain's thread cannot be read.
    let source = conversationText(_conversation)
    if (source == "") {
      source = userMsg
    }
    const title = titleFor(source)
    if (title != "") {
      record.title = title
    }
  }
  return {
    dir: projectDir(),
    record: record
  }
}

/** Save after the `-i` seed turn, which runs before the REPL. This is
  Agency code with no REPL frame above it, so on resume execution
  continues at the line after `checkpoint()` and then starts the REPL. */
export def saveSeedTurn(userMsg: string) {
  const target = recordTurn(userMsg)
  if (target == null) {
    return
  }
  const id = checkpoint()
  const saved = saveSession(target.record, getCheckpoint(id))
  if (isFailure(saved)) {
    print(color.red("Could not save this session: ${saved.error}"))
  }
}
