import { hostedSearchTools, searchTools } from "std::agents/lib/search"
import { webTools, spillTools } from "std::agents/lib/toolkits"
import { agentSkill } from "std::skills"
import { systemMessage } from "std::thread"
import { AGENT_SPILL_OVER } from "std::agents/lib/shared"

/** @module
@summary Research a topic in an isolated conversation with source tools.

This composable researcher returns the model's answer directly. Use
`std::agents/researcher` when you need configurable budgets, model overrides,
and the shared-conversation handoff behavior.
*/

static const skills = agentSkill("researcher")

export def buildTools(): any[] {
  """
  Return source lookup tools for the composable researcher.
  """
  return [...webTools(), ...spillTools(), read.partial(useAgentCwd: true), ...searchTools(), skills]
}

static const systemPrompt = """Answer the task accurately from sources you retrieve.

- Break the task into questions and research each one before answering.
- Prefer primary sources. Cross-check important, surprising, or contested
  claims. Explain disagreements and which source you trust more and why.
- Check publication dates for time-sensitive facts and state when they
  are current.
- Cite each factual claim inline using a source you opened. Preserve
  quotes, numbers, and dates accurately.
- Lead with the answer and match detail to the question. Label your own
  inferences separately from what sources say.
- When information remains unavailable, report the gap and what you tried.
  Do not fill it with guesses.
"""

export def researcherAgent(topic: string): string {
  """
  Research a topic with source tools and return a cited answer.
  """

  thread {
    systemMessage(systemPrompt)
    const result = llm(
      "Please research this topic: <topic>${topic}</topic>",
      tools: [...buildTools()],
      spillToolResultsOver: AGENT_SPILL_OVER,
      hostedTools: hostedSearchTools(),
    )
    return result
  }
}
