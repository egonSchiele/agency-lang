import { bskySearch } from "std::data/social/bluesky"

node liveSearch(): number {
  handle {
    const posts = bskySearch("news", limit: 3) catch []
    return posts.length
  } with (data) {
    if (data.effect == "std::bluesky") {
      return approve()
    }
    if (data.effect == "std::http::fetchJSON") {
      return approve()
    }
    return reject()
  }
}
