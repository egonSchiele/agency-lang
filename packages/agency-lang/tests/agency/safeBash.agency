      return approve()
    }
    return reject()
  }
  return found
}

node findOutsideTheLaunchDirIsUndecided() {
  // Not /etc: on macOS /etc is a link to /private/etc, and find does not
  // follow a link operand, so `find /etc` is refused. /usr is not a link.
  const plan = planFor("find /usr -name ls", FIXTURES)
  for (effect in plan.effects) {
    if (effect.name == "std::glob") {
      const intr = { effect: effect.name, data: effect.payload }
      return checkPolicy(recommendedAutoApprovePolicy, intr).type
    }
  }
  return "NO GLOB EFFECT"
}

node findAsksOneQuestion() {
  // find lists in directory order, which differs between file systems,
  // so the lines are compared sorted.
  const result = safeBash("find . -name '*.txt'", cwd: FIXTURES)
  if (result is failure(why)) {
    return "FAILED: ${why}"
  }
  return [line for line in result.value.split("\n") if line != ""].sort()
}

