import { jobOutput, stopJob, listJobs } from "std::jobs"
import { safeBash, startJob } from "std::safeBash"

// Each node is its own run, with its own jobs, and the run's cleanup stops
// whatever a node leaves running. Job ids are random, so each node reads
// its job's id from listJobs().

def endsInBackground(question: string): boolean {
  return question.endsWith("in the background?")
}

node rejectedStartsNothing() {
  let result: any = null
  handle {
    result = startJob("sleep 30")
  } with (intr) {
    return reject("no background jobs")
  }
  return [isFailure(result), result.rejected, listJobs().length]
}

node backgroundQuestionSaysSo() {
  let questions: string[] = []
  handle {
    startJob("sleep 1")
    safeBash("sleep 1")
  } with (intr) {
    questions.push(intr.message)
    return approve()
  }
  return [
    endsInBackground(questions[0]),
    endsInBackground(questions[questions.length - 1]),
  ]
}

node startReadStop() {
  let started: any = null
  let id = ""
  let first: any = null
  let second: any = null
  handle {
    // The printf form keeps the expected text, A1 and B2, out of the
    // command, so the output cannot match by echoing the command.
    started = startJob("printf 'A%s\\n' 1; sleep 1; printf 'B%s\\n' 2")
    id = listJobs()[0].id
    first = jobOutput(id, wait: 10)
    second = jobOutput(id)
  } with (intr) {
    return approve()
  }
  return [
    started.value.includes(id),
    first.value.state,
    first.value.exitCode,
    first.value.stdout.includes("A1"),
    first.value.stdout.includes("B2"),
    second.value.stdout,
  ]
}

node stopEndsIt() {
  let stopped: any = null
  handle {
    startJob("sleep 30")
    stopped = stopJob(listJobs()[0].id)
  } with (intr) {
    return approve()
  }
  return [stopped.value.state, listJobs()[0].unread]
}

// A time guard that runs out during a wait raises std::guard, as a trip
// between statements does, so the handler is asked. The job keeps running.
node guardTripDuringWaitAsksTheHandler() {
  let asked = false
  let blockFailed = false
  let state = ""
  handle {
    startJob("sleep 30")
    const id = listJobs()[0].id
    const waited = guard(time: 200ms) {
      return jobOutput(id, wait: 30)
    }
    blockFailed = isFailure(waited)
    state = listJobs()[0].state
    stopJob(id)
  } with (intr) {
    if (intr.effect == "std::guard") {
      asked = true
      return reject()
    }
    return approve()
  }
  return [asked, blockFailed, state]
}

// Approving the trip with more time lets the block finish with the
// report the cut-short wait returned. This fails if the wait throws.
node guardTripDuringWaitCanBeApproved() {
  let asked = false
  let waited: any = null
  handle {
    startJob("sleep 30")
    const id = listJobs()[0].id
    waited = guard(time: 200ms) {
      const report = jobOutput(id, wait: 30)
      if (report is failure(why)) {
        return "read failed: ${why}"
      }
      return report.value.state
    }
    stopJob(id)
  } with (intr) {
    if (intr.effect == "std::guard") {
      asked = true
      return approve({
        maxTime: 60000
      })
    }
    return approve()
  }
  return [asked, isSuccess(waited), waited.value]
}

// A handler that rejects the trip during the wait leaves the output
// unread, so the next read returns it. This fails if the wait and the read
// are one step.
node rejectedWaitKeepsOutput() {
  let later: any = null
  handle {
    startJob("printf 'A%s\\n' 1; sleep 30")
    const id = listJobs()[0].id
    const waited = guard(time: 200ms) {
      return jobOutput(id, wait: 30)
    }
    later = jobOutput(id)
    stopJob(id)
  } with (intr) {
    if (intr.effect == "std::guard") {
      return reject()
    }
    return approve()
  }
  return later.value.stdout.includes("A1")
}

node foregroundForInstantCommands() {
  let result: any = null
  let saysBackground = false
  handle {
    result = startJob("echo hi")
  } with (intr) {
    if (endsInBackground(intr.message)) {
      saysBackground = true
    }
    return approve()
  }
  return [
    result.value.startsWith("This command ran in the foreground"),
    result.value.includes("hi"),
    listJobs().length,
    saysBackground,
  ]
}

// An agency line runs in this process, so it never becomes a job, and the
// line in front of its output must not say it was quick.
node foregroundForAgencyCommands() {
  let result: any = null
  handle {
    result = startJob("agency typecheck tests/agency/jobs.agency")
  } with approve
  return [
    result.value.startsWith("This command ran in the foreground"),
    result.value.includes("finishes at once"),
    listJobs().length,
  ]
}

node unknownId() {
  const read = jobOutput("job-000000")
  const stopped = stopJob("job-000000")
  return [
    isFailure(read) && read.error.includes("There is no job job-000000 in this run"),
    isFailure(stopped) && stopped.error.includes("This run has no jobs"),
  ]
}

node missingFolder() {
  let result: any = null
  handle {
    result = startJob("sleep 1", cwd: "/no/such/folder")
  } with (intr) {
    return approve()
  }
  return [isFailure(result), result.error.includes("was not run"), listJobs().length]
}

node timeLimitCarriesTheLimit() {
  let result: any = null
  handle {
    result = startJob("sleep 1", maxMinutes: 2)
  } with (intr) {
    if (intr.data.timeout != 120000) {
      return reject("timeout was ${intr.data.timeout}")
    }
    return approve()
  }
  return isSuccess(result)
}
