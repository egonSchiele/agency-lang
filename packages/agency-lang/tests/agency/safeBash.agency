    outcomeAndNames("git branch -a newname"),
    outcomeAndNames("git branch --merged"),
    outcomeAndNames("git branch --merged main"),
    outcomeAndNames("git branch --merged main other"),
    outcomeAndNames("git branch -a --merged main"),
    outcomeAndNames("git branch newname"),
    outcomeAndNames("git branch newname start"),
    outcomeAndNames("git branch -d a"),
    outcomeAndNames("git branch --delete a b"),
    outcomeAndNames("git branch -d"),
    outcomeAndNames("git branch -d -v a"),
    outcomeAndNames("git branch -d --merged a"),
    outcomeAndNames("git branch -- newname"),
  ]
}

node gitReadRuns() {
  const result = safeBash("git log -1 --oneline")
  if (result is failure(why)) {
    return "FAILED"
  }
  return result.value.length > 0
}

// Rejected, so nothing runs and the test cannot commit to the repository
// it runs in.
node gitWriteIsAsked() {
  const result = safeBash("git commit -m \"a test commit\"")
  if (isFailure(result)) {
    return result.rejected
  }
  return "UNEXPECTEDLY RAN"
}

/** A repository of its own for the test that runs real git. */
static const GIT_FIXTURE = __dirname + "/stdlib/__safebash_git__"

/** A folder with no repository above it. It has to be outside the
  checkout, because every folder under the checkout has the checkout's
  repository above it. */
static const GIT_NO_REPO = "/tmp/__safebash_git_norepo__"

/** A bare repository: git sees a repository there, and no work tree. */
static const GIT_BARE = __dirname + "/stdlib/__safebash_git_bare__"

static const GIT_MARKER = "MARKER-ONLY-IN-THE-OUTSIDE-FILE"

/** Run a command through safeBash in a folder, after checking the plan
  is narrow. Without that check `with approve` would approve a std::bash
  for the model's own text, and a case would pass while testing nothing. */
def runNarrow(source: string, dir: string): any {
  if (outcomeOf(planFor(source, dir)) != "narrow") {
    return ["NOT-NARROW"]
  }
  const result = safeBash(source, cwd: dir) with approve
  if (result is failure(why)) {
    return ["failure", why]
  }
  return ["success", result.value]
}

def fileText(dir: string, name: string): string {
  const result = bash("cat " + name, cwd: dir) with approve
  return result.stdout
}

// The claims the git rules rest on are claims about git: what it does
// with a `--`, with a path outside the repository, with a pathspec, with
// no repository at all, with a repository that has no work tree. No plan
// test can check those, so this runs the real thing in folders it makes.
node gitRunsSafely() {
  remove(GIT_FIXTURE) with approve
  mkdir(GIT_FIXTURE) with approve
  remove(GIT_NO_REPO) with approve
  mkdir(GIT_NO_REPO) with approve
  remove(GIT_BARE) with approve
  mkdir(GIT_BARE) with approve
  bash("git init -q --bare", cwd: GIT_BARE) with approve
  bash("printf '" + GIT_MARKER + "\\n' > outside.txt", cwd: GIT_NO_REPO) with approve
  const setup = "git init -q -b main && printf 'a = 1\\n' > a.py && printf 'b = 1\\n' > b.py && git add a.py b.py && git -c user.name=Test -c user.email=test@example.com commit -q -m 'Add a and b' && printf 'a = 2\\n' > a.py && printf 'b = 2\\n' > b.py"
  bash(setup, cwd: GIT_FIXTURE) with approve
  const outside = GIT_NO_REPO + "/outside.txt"

  const pathspec = runNarrow("git checkout '*.py'", GIT_FIXTURE)
  const outsideDiff = runNarrow("git diff /dev/null " + outside, GIT_FIXTURE)
  const checkout = runNarrow("git checkout main", GIT_FIXTURE)
  const log = runNarrow("git log --oneline", GIT_FIXTURE)
  const redirected = runNarrow("git diff > out.patch", GIT_FIXTURE)
  const noRepository = runNarrow("git diff /dev/null " + outside, GIT_NO_REPO)
  const bare = runNarrow("git diff /dev/null " + outside, GIT_BARE)
  const gitFolder = runNarrow("git diff /dev/null " + outside, GIT_FIXTURE + "/.git")

  const seen = [
    // The pathspec failed, named the model's own text, and changed no file.
    pathspec[0],
    pathspec[1].includes("\"command\":\"git checkout '*.py'\""),
    pathspec[1].includes("core.fsmonitor"),
    fileText(GIT_FIXTURE, "a.py"),
    fileText(GIT_FIXTURE, "b.py"),
    // A file outside the repository was not printed.
    outsideDiff[0],
    outsideDiff[1].includes(GIT_MARKER),
    checkout[0],
    log[0],
    log[1].includes("Add a and b"),
    redirected[0],
    fileText(GIT_FIXTURE, "out.patch").includes("+a = 2"),
    // With no repository above the folder, the diff did not run.
    noRepository[0],
    noRepository[1].includes("not a git repository"),
    noRepository[1].includes(GIT_MARKER),
    // In a bare repository, and inside a `.git` folder, git sees a
    // repository and no work tree, and the diff did not run either.
    bare[0],
    bare[1].includes("must be run in a work tree"),
    bare[1].includes(GIT_MARKER),
    gitFolder[0],
    gitFolder[1].includes("must be run in a work tree"),
    gitFolder[1].includes(GIT_MARKER),
  ]
  remove(GIT_FIXTURE) with approve
  remove(GIT_NO_REPO) with approve
  remove(GIT_BARE) with approve
  return seen
}

// ---------------------------------------------------------------------------
// gh
//
// The nodes below go through `planFor` and run nothing. A row that uses
// `cd` plans in STDLIB_TESTS, where `grep-fixtures` exists; every other
// row plans in `/repo`, a folder that does not exist.
// ---------------------------------------------------------------------------

/** A plan's outcome, each effect's name and payload, the text that runs,
  the folders still waiting on a repository lookup, and why it went broad. */
def ghPlan(source: string, cwd: string = "/repo", origin: GhRepo | null = null): any {
  const plan = planFor(source, cwd, origin)
  const effects: any[] = plan.effects
  const text = match(plan.execution) {
    { kind: "bash", command as text } => text
    _ => ""
  }
  return [outcomeOf(plan), [[effect.name, effect.payload] for effect in effects], text, pendingLookups(plan.effects), reasonOf(plan)]
}

/** A plan's outcome and why it went broad. */
def ghBroad(source: string, cwd: string = "/repo"): any {
  const plan = planFor(source, cwd)
  return [outcomeOf(plan), reasonOf(plan)]
}

def reasonOf(plan: Plan): any {
  const reason = plan.broadReason
  if (reason == null) {
    return null
  }
  return [reason.kind, reason.detail]
}

static const AGENCY_LANG: GhRepo = { owner: "egonSchiele", repo: "agency-lang" }

node ghReads() {
  return [
    ghPlan("gh pr view 1451"),
    ghPlan("gh pr view 1451", "/repo", AGENCY_LANG),
    ghPlan("gh pr view 1451 --repo egonSchiele/agency-lang"),
    ghPlan("gh pr view https://github.com/egonSchiele/agency-lang/pull/1451"),
    ghPlan("gh pr view 1451 --repo a/b", "/repo", AGENCY_LANG),
    ghPlan("gh pr view 1 -R github.com/o/r --comments"),
    ghPlan("gh pr view 1 --json title,body"),
    ghPlan("gh pr view 1 --json title,files,reviews,latestReviews,comments,statusCheckRollup"),
    ghPlan("gh pr diff 1 --name-only"),
    ghPlan("gh pr checks 1 --required"),
    ghPlan("gh pr checks 1 --json name,state"),
    ghPlan("gh pr list"),
    ghPlan("gh pr list --state merged --base main --limit 5 --author dana"),
    ghPlan("gh pr list -L 100"),
    ghPlan("gh issue view 7"),
    ghPlan("gh issue view 7 --comments"),
    ghPlan("gh issue view 7 --json title,comments"),
    ghPlan("gh issue list --label bug,urgent --state all"),
    ghPlan("gh search issues crash in:title --repo o/r --limit 10"),
    ghPlan("gh pr diff 1 | head -20"),
  ]
}

// The lookup folder is the real path of the folder the `cd` names, which
// differs between machines, so this row reports whether it ends right.
node ghLookupFollowsCd() {
  const plan = planFor("cd grep-fixtures && gh pr view 1", STDLIB_TESTS)
  const folders = pendingLookups(plan.effects)
  return [outcomeOf(plan), folders.length, folders[0].endsWith("/stdlib/grep-fixtures")]
}

node ghStaysBroad() {
  return [
    ghBroad("gh pr view"),
    ghBroad("gh pr view abc"),
    ghBroad("gh pr view 1 --web"),
    ghBroad("gh pr checks 1 --watch"),
    ghBroad("gh pr view 1 --template x"),
    ghBroad("gh pr list --search foo"),
    ghBroad("gh issue list --search foo"),
    ghBroad("gh pr list --limit 101"),
    ghBroad("gh pr list --limit 0"),
    ghBroad("gh pr list -L 5 --limit 500"),
    ghBroad("gh pr list -s open --state closed"),
    ghBroad("gh pr list --state bogus"),
    ghBroad("gh issue list --state merged"),
    ghBroad("gh search issues crash --repo o/r --state all"),
    ghBroad("gh pr list --json comments"),
    ghBroad("gh issue list --json comments"),
    ghBroad("gh pr view 1 --json nope"),
    ghBroad("gh pr list --author 'x repo:other/private'"),
    ghBroad("gh pr view 1 --repo ghe.example.com/o/r"),
    ghBroad("gh pr view 1 --repo ../x"),
    ghBroad("gh pr view https://github.com/a/b/pull/1 --repo c/d"),
    ghBroad("gh search issues crash"),
    ghBroad("gh search issues crash --repo o/r -R other/private"),
    ghBroad("gh search issues crash --repo o/r,other/private"),
    ghBroad("gh search issues repo:other/x crash --repo o/r"),
    ghBroad("gh search issues crash --repo o/r --owner acme"),
    ghBroad("(cd grep-fixtures && gh pr view 1); gh pr view 2", STDLIB_TESTS),
  ]
}

node ghJqHasNoRule() {
  return [
    ghBroad("gh pr view 1 --json title --jq .title"),
    ghBroad("gh pr view 1 --json title --jq=.title"),
    ghBroad("gh pr view 1 --json title -q .title"),
    ghBroad("gh run view 5 --json jobs --jq .jobs"),
    ghBroad("gh run view 5 --json jobs --jq=.jobs"),
    ghBroad("gh run view 5 -wq .jobs"),
    ghBroad("gh run view 5 --json jobs '--jq' '.jobs'"),
    ghBroad("gh run view 5 --json jobs \"--jq=.jobs\""),
    ghBroad("gh run view 5 --json jobs '-q' '.jobs'"),
  ]
}

/** A plan's outcome, and the program and subcommand of each std::exec. */
def ghExecRow(source: string): any {
  const plan = planFor(source, "/repo")
  const effects: any[] = plan.effects
  return [outcomeOf(plan), [[effect.name, effect.payload.command, effect.payload.subcommand] for effect in effects]]
}

node ghUnownedStaysExec() {
  return [
    ghExecRow("gh pr comment 1 -b hi"),
    ghExecRow("gh run view 5"),
    ghExecRow("gh pr create --fill"),
    ghExecRow("gh -R o/r pr view 1"),
  ]
}

/** A git repository whose origin is agency-lang on GitHub, and one with no
  remote. Both are made by the tests below and removed after. */
static const GH_ORIGIN_FIXTURE = __dirname + "/stdlib/__safebash_gh_origin__"
static const GH_NO_REMOTE_FIXTURE = __dirname + "/stdlib/__safebash_gh_noremote__"

/** The folder a fake `gh` is written into for a test. */
static const FAKE_GH_DIR = __dirname + "/stdlib/__safebash_fake_gh__"

def makeGhFixtures() {
  remove(GH_ORIGIN_FIXTURE) with approve
  mkdir(GH_ORIGIN_FIXTURE) with approve
  bash("git init -q && git remote add origin https://github.com/egonSchiele/agency-lang.git", cwd: GH_ORIGIN_FIXTURE) with approve
  remove(GH_NO_REMOTE_FIXTURE) with approve
  mkdir(GH_NO_REMOTE_FIXTURE) with approve
  bash("git init -q", cwd: GH_NO_REMOTE_FIXTURE) with approve
}

def removeGhFixtures() {
  remove(GH_ORIGIN_FIXTURE) with approve
  remove(GH_NO_REMOTE_FIXTURE) with approve
}

/** Run `source` through safeBash in `dir`, approved, with a `gh` on the
  search path that is the shell script `script`. Puts PATH back before it
  returns, whether the run succeeded or failed. */
def runWithFakeGh(script: string, source: string, dir: string): any {
  remove(FAKE_GH_DIR) with approve
  mkdir(FAKE_GH_DIR) with approve
  write("gh", "#!/bin/sh\n${script}\n", FAKE_GH_DIR) with approve
  bash("chmod +x gh", cwd: FAKE_GH_DIR) with approve
  const path = env("PATH") with approve
  setEnv("PATH", "${FAKE_GH_DIR}:${path}") with approve
  const result = runNarrow(source, dir)
  setEnv("PATH", path ?? "") with approve
  remove(FAKE_GH_DIR) with approve
  return result
}

// The handler records the question and rejects it, so gh never runs and
// the test needs no network and no gh.
node ghLookupFillsThePair() {
  makeGhFixtures()
  let seen: any[] = []
  handle {
    safeBash("gh pr view 1451", cwd: GH_ORIGIN_FIXTURE)
  } with (intr) {
    seen.push([intr.effect, intr.data.owner, intr.data.repo, intr.data.number])
    return reject()
  }
  removeGhFixtures()
  return seen
}

node ghLookupFailureRaisesNothing() {
  makeGhFixtures()
  let seen: any[] = []
  let failed = ""
  handle {
    const result = safeBash("gh pr view 1451", cwd: GH_NO_REMOTE_FIXTURE)
    if (result is failure(why)) {
      failed = why
    }
  } with (intr) {
    seen.push(intr.effect)
    return reject()
  }
  removeGhFixtures()
  return [seen, failed.includes("--repo OWNER/REPO")]
}

// The fake gh prints its arguments, one per line. This fails if safeBash
// raises the second plan and runs the first, whose --repo is empty.
node ghRunsWhatItAsked() {
  makeGhFixtures()
  const result = runWithFakeGh("printf '%s\\n' \"$@\"", "gh pr view 1451", GH_ORIGIN_FIXTURE)
  removeGhFixtures()
  return result
}

node timeLimitStopsTheCommand() {
  let result: any = null
  handle {
    // The failure also holds the command's text, so the output is text
    // the command does not spell: "A1" and "B2".
    result = safeBash("printf 'A%s\\n' 1; sleep 20; printf 'B%s\\n' 2", timeout: 1)
  } with (intr) {
    // Every question about this line carries the limit, in milliseconds.
    if (intr.data.timeout != 1000) {
      return reject("timeout was ${intr.data.timeout}")
    }
    return approve()
  }
  if (result is failure(why)) {
    return [why.includes("A1"), why.includes("B2"), why.includes("time limit of 1 seconds")]
  }
  return "NOT STOPPED"
}
