/** @module
  @summary `/jobs`: the user lists the session's background jobs, or stops
  one. The jobs are the session run's, read from their records through the
  driver, so neither runs a leg.
*/
import {
  _sessionJobs,
  _stopSessionJob,
 } from "agency-lang/stdlib-lib/agentTerminalDriver.js"
import { pushMessage } from "std::ui/cli"

import { addNote } from "../pendingNotes.agency"

static const USAGE = "Usage: /jobs lists the background jobs, and /jobs stop <id> stops one."

def listedJobs(): string {
  const jobs = _sessionJobs()
  if (jobs.length == 0) {
    return "No background jobs."
  }
  const rows = ["${job.id}  ${job.status}  ${job.runningFor}  ${job.command}" for job in jobs]
  return rows.join("\n")
}

// The user typed the stop, so it asks no approval, like `!command`. The
// REPL prints the job's finish line, so a stop that worked prints nothing
// more. The model is told with a note on the user's next message. The stop
// moves nothing in the session run, so the model's jobs message lists the
// job as stopped with its output not read, and `jobOutput` returns it.
export def stoppedNote(id: string, command: string): string {
  return "I stopped background job ${id} myself: ${command}"
}

def stopFromSlash(id: string): boolean {
  const stopped = _stopSessionJob(id)
  if (stopped.kind == "stopped") {
    addNote(stoppedNote(id, stopped.job.command))
  } else if (stopped.kind == "alreadyEnded") {
    // A job that already ended was not stopped by the user, so it gets a
    // reply and no note.
    pushMessage("${id} had already ended (${stopped.job.status}).")
  } else {
    pushMessage(stopped.message)
  }
  return true
}

/** `/jobs` lists the jobs. `/jobs stop <id>` stops one. */
export def jobsSlashCommand(args: string): boolean {
  const trimmed = args.trim()
  if (trimmed == "") {
    pushMessage(listedJobs())
    return true
  }
  if (trimmed.startsWith("stop ")) {
    const id = trimmed.slice(5).trim()
    if (id != "") {
      return stopFromSlash(id)
    }
  }
  pushMessage(USAGE)
  return true
}
