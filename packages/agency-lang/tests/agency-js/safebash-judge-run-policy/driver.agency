import { safeBash } from "std::safeBash"

// A broad line: a pipe into awk, which safeBash has no rule for. It is safe
// to run: it prints "hi".
static const LINE = "printf hi | awk NF"

// Runs LINE with a judge. The judge's mocks all refuse, so the line runs
// only when a policy rule decides its question and the judge is skipped.
node judgedLine(): string {
  const result = safeBash(LINE, cwd: __dirname, commandJudge: { model: "jev-1.13", provider: "typesafe" })
  if (result is failure(why)) {
    if (why.startsWith("This command is too complex")) {
      return "refused by the judge"
    }
    return "failed: ${why}"
  }
  return result.value.trim()
}
