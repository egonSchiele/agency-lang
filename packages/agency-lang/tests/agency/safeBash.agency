def refusedFor(source: string): any {
  const parsed = bashParser(source)
  if (parsed is failure(why)) {
    return "UNPARSEABLE"
  }
  const first = parsed.value[0]
  if (first.tag != "simpleCommand") {
    return "NOT-SIMPLE"
  }
  return isRefused(first)
}

node refuseWall() {
  return [
    refusedFor("shred -u build"),
    refusedFor("/bin/shred -u build"),
    refusedFor("./truncate thing"),
    refusedFor("dd if=a of=b"),
    refusedFor("git clean -fd"),
    refusedFor("git reset --hard"),
    refusedFor("git restore src"),
    refusedFor("git reset HEAD"),
    refusedFor("git checkout main"),
    refusedFor("git checkout ."),
    refusedFor("git log reset"),
    refusedFor("git status"),
    refusedFor("echo hi"),
    refusedFor("git restore -- utils.py"),
    refusedFor("git checkout -- utils.py"),
    refusedFor("git checkout -- ."),
    refusedFor("shred -- file"),
    refusedFor("git log -- utils.py"),
  ]
}

def outcomeAndEffects(source: string): any {
  const plan = planFor(source, "/repo")
  return [outcomeOf(plan), [e.name for e in plan.effects]]
}

def execArgs(source: string): any {
  const effect: any = planFor(source, "/repo").effects[0]
  return effect.payload.args
}

node endOfFlagsAndInnerTilde() {
  return [
    outcomeAndEffects("ls -- src"),
    outcomeAndEffects("echo -- hi"),
    outcomeAndEffects("cd -- src"),
    outcomeAndEffects("pnpm test -- --watch"),
    execArgs("pnpm test -- --watch"),
    writePlanDetail("echo hi > a~b"),
    writePlanDetail("echo hi > HEAD^"),
    outcomeAndEffects("git diff HEAD~1"),
    outcomeAndEffects("make DIR=~/x"),
  ]
}

def effectNamesFor(source: string): any {
  const parsed = bashParser(source)
  if (parsed is failure(why)) {
    return "UNPARSEABLE"
  }
  const first = parsed.value[0]
  if (first.tag != "simpleCommand") {
    return "NOT-SIMPLE"
  }
  const effects = effectsFor(first, "/repo")
  if (effects is failure(why)) {
    return "UNRECOGNIZED"
  }
  return [e.name for e in effects.value]
}

node classifyOneCommand() {
  return [
    effectNamesFor("git status"),
    effectNamesFor("git diff"),
    effectNamesFor("git diff --staged"),
    effectNamesFor("git log"),
    effectNamesFor("echo hi"),
    effectNamesFor("xargs"),
    effectNamesFor("git log --all"),
    effectNamesFor("/bin/git status"),
    effectNamesFor("FOO=1 git status"),
    effectNamesFor("echo -n hi"),
    effectNamesFor("echo \"quoted\""),
    effectNamesFor("git diff --staged --no-index"),
  ]
}

node redirectsContribute() {
  return [
    effectNamesFor("git status > out.txt"),
    effectNamesFor("echo hi > out.txt"),
    effectNamesFor("echo hi >> out.txt"),
    effectNamesFor("echo hi > $F"),
    effectNamesFor("echo hi < in.txt"),
    effectNamesFor("echo hi 3> err.txt"),
    effectNamesFor("echo hi > a.txt > b.txt"),
  ]
}

node stderrAndDevNullRedirects() {
  return [
    planSummary("pnpm test 2>/dev/null"),
    planSummary("pnpm test >/dev/null"),
    planSummary("pnpm test >/dev/null 2>&1"),
    planSummary("make 2>build.log"),
    planSummary("make 2>>build.log"),
    planSummary("make >out.log 2>/dev/null"),
    planSummary("pnpm test 1>/dev/null"),
    planSummary("make 1>out.log"),
    planSummary("pnpm test &>/dev/null"),
    planSummary("make 3>x"),
    planSummary("make 3>/dev/null"),
    planSummary("make >out.log 2>err.log"),
    planSummary("make > $NULL"),
    stderrWriteMode("make 2>build.log"),
    stderrWriteMode("make 2>>build.log"),
    executionCommand("pnpm test 2>/dev/null"),
  ]
}

def stderrWriteMode(source: string): any {
  const write: any = planFor(source, "/repo").effects[1]
  return [write.payload.filename, write.payload.mode]
}

def planSummary(source: string): any {
  const plan = planFor(source, "/repo")
  return [plan.execution.kind, [e.name for e in plan.effects]]
}

node wholeStringPlans() {
  return [
    planSummary("git status"),
    planSummary("git status; git log"),
    planSummary("git status; xargs"),
    planSummary("xargs"),
    planSummary("echo hi; echo bye"),
    planSummary("dd if=a of=b"),
    planSummary("git status; dd if=a of=b"),
    planSummary("cat a.txt | grep x"),
    planSummary("git status && git log"),
    planSummary("true && dd if=a of=b"),
    planSummary("(git status && git log)"),
    planSummary("git status && xargs"),
  ]
}

def executionCommand(source: string): any {
  return match(planFor(source, "/repo").execution) {
    { kind: "bash", command } => command
    _ => "NOT-BASH"
  }
}

node rebuiltVersusOriginal() {
  // Hard rule #1. Multi-space input makes it observable: re-rendering
  // normalizes whitespace, so on the narrow path `execution.command` must
  // be the NORMALIZED form, and on the broad path it must be the caller's
  // text VERBATIM.
  return [executionCommand("git    status"), executionCommand("xargs    -0")]
}

def planDetail(source: string): any {
  const plan = planFor(source, "/repo")
  const content = match(plan.execution) {
    { kind: "echo", content as text } => text
    _ => ""
  }
  return [plan.execution.kind, content, [e.name for e in plan.effects]]
}

node shellFreeEcho() {
  return [
    planDetail("echo hello world"),
    planDetail("echo"),
    planDetail("echo 'a  b'"),
    planDetail("echo $HOME"),
    planDetail("echo \"$HOME\""),
    planDetail("echo \"a b\" c"),
    planDetail("echo -n hi"),
    planDetail("echo hi; echo bye"),
    planDetail("echo -n"),
    planDetail("echo -e x"),
    planDetail("echo hi -n"),
    planDetail("echo -n -n hi"),
    planDetail("echo \"-n\" hi"),
    planDetail("echo hi \"-x\""),
  ]
}

def writePlanDetail(source: string): any {
  const plan = planFor(source, "/repo")
  const names = [e.name for e in plan.effects]
  // `mode` is in the tuple deliberately. Without it, a `writeMode` that
  // always returned "overwrite" survives the whole suite, and
  // `echo hi >> notes.txt` silently TRUNCATES the file.
  return match(plan.execution) {
    { kind: "write", content, filename, dir, mode } => return ["write", content, filename, dir, mode, names]
    { kind } => [kind, names]
  }
}

node shellFreeWrite() {
  return [
    writePlanDetail("echo hi > out.txt"),
    writePlanDetail("echo hi >> out.txt"),
    writePlanDetail("echo hi > $F"),
    writePlanDetail("echo $HOME > out.txt"),
    writePlanDetail("echo -n hi > out.txt"),
  ]
}

node payloadValuesAreCorrect() {
  // Every other classification test asserts effect NAMES. A staged diff
  // and an unstaged diff share a name, so only the payload tells them
  // apart. This also pins cwd threading into git payloads.
  const staged = planFor("git diff --staged", "/repo")
  const redirected = planFor("git status > out.txt", "/repo")
  // `any` here only. Effect is a discriminated union so the raise sites in
  // the module typecheck their payloads; a test reading payloads
  // generically would have to narrow five times to say nothing extra.
  const diffPayload: any = staged.effects[0]
  const writeEffect: any = redirected.effects[1]
  return [
    diffPayload.payload.staged,
    diffPayload.payload.cwd,
    writeEffect.name,
    writeEffect.payload.filename,
    writeEffect.payload.dir,
    writeEffect.payload.mode,
  ]
}

node writeContentIsInThePayload() {
  const plan = planFor("echo hi > out.txt", "/repo")
  const effect: any = plan.effects[0]
  return effect.payload.content
}

node echoRunsWithoutApproval() {
  // No interrupt and no shell. If this ever routed through bash, an
  // unlisted interrupt would leave the raw interrupt array as the result
  // and this comparison would fail.
  const result = safeBash("echo hello world")
  if (result is failure(why)) {
    return "FAILED: ${why}"
  }
  return result.value
}

node exactlyOneQuestion() {
  // The test that actually pins the feature. It APPROVES the narrow
  // question and asserts the command ran. A test that only rejects the
  // first interrupt passes whether or not a second std::bash prompt
  // appears — which is how calling `bash()` instead of `_bash()` hides.
  //
  const result = safeBash("git status")
  if (result is failure(why)) {
    return "FAILED"
  }
  return "RAN"
}

node refusedNeverRuns() {
  const result = safeBash("dd if=a of=b")
  if (result is failure(why)) {
    return why
  }
  return "UNEXPECTEDLY RAN"
}

def removeSummary(source: string): any {
  const plan = planFor(source, STDLIB_TESTS)
  return [outcomeOf(plan), [e.name for e in plan.effects]]
}

def removeReason(source: string): any {
  const exec = planFor(source, STDLIB_TESTS).execution
  if (exec is { kind: "refuse", reason }) {
    return reason
  }
  return "NOT REFUSED"
}

// Every row only plans. Nothing here runs an rm.
node removePlans() {
  return [
    removeSummary("rm -rf build"),
    removeSummary("rm one.txt two.txt"),
    removeSummary("rmdir empty"),
    removeSummary("git status && rm -f scratch.py"),
    // A flag off the table, a glob, and a variable have no rule.
    removeSummary("rm -i one.txt"),
    removeSummary("rmdir -p a/b"),
    removeSummary("rm -rf build/*.o"),
    removeSummary("rm -rf $BUILD/out"),
    // A path word is never a recognized command, but the wall reads it.
    removeSummary("/bin/rm one.txt"),
    removeSummary("/bin/rm -rf /"),
  ]
}

// The remove tool's own refusals, for every spelling of the same folders.
node removeRefusals() {
  return [
    removeReason("rm -rf /"),
    removeReason("rm -rf /*"),
    removeReason("rm -rf ~"),
    removeReason("rm -rf ~/*") != "NOT REFUSED",
    removeReason("rm -rf \"$HOME\"") != "NOT REFUSED",
    removeReason("rm -rf $BUILD/*"),
    removeReason("rm -rf /usr") != "NOT REFUSED",
    removeReason("rm -rf ."),
    removeReason("rm -rf *"),
    removeReason("rm -rf .."),
    removeReason("rmdir /") != "NOT REFUSED",
    removeReason("true && rm -rf /"),
    removeReason("git status | rm -rf /"),
    removeReason("rm -rf build"),
  ]
}

// A `cd` earlier in the line changes which folder an rm names. The launch
// folder, reached by stepping out of it, gets no std::remove, so a policy
// that approves deletes under the launch folder cannot approve it. Every
// row only plans.
node removeAfterCd() {
  const launch = cwd()
  const parts = launch.split("/")
  const folder = parts[parts.length - 1]
  const out = planFor("cd .. && rm -rf ${folder}", launch)
  const inside = planFor("cd tests && rm -rf no-such-folder-xyz", launch)
  // The same two lines with the `cd` on a line of its own.
  const outOnItsOwnLine = planFor("cd ..\nrm -rf ${folder}", launch)
  const insideOnItsOwnLine = planFor("cd tests\nrm -rf no-such-folder-xyz", launch)
  return [
    outcomeOf(out),
    [e.name for e in out.effects],
    saysRefused(out),
    outcomeOf(inside),
    [e.name for e in inside.effects],
    outcomeOf(outOnItsOwnLine),
    [e.name for e in outOnItsOwnLine.effects],
    saysRefused(outOnItsOwnLine),
    outcomeOf(insideOnItsOwnLine),
    [e.name for e in insideOnItsOwnLine.effects],
  ]
}

def saysRefused(plan: any): boolean {
  if (plan.broadReason == null) {
    return false
  }
  return plan.broadReason.detail.includes("refused from this folder")
}

// The handler records the question and rejects it, so nothing is deleted.
// The target is the real whole path, as in the remove tool's own payload.
node removeAsksLikeTheRemoveTool() {
  let seen: any[] = []
  let failed = "NOT A FAILURE"
  handle {
    const result = safeBash("rm -f no-such-file-xyz.txt", cwd: STDLIB_TESTS)
    if (result is failure(why)) {
      failed = why
    }
  } with (intr) {
    seen.push([intr.effect, intr.data.target.endsWith("/tests/agency/stdlib/no-such-file-xyz.txt"), intr.data.command])
    return reject("not today")
  }
  return [seen, failed.includes("not today")]
}

node sequenceRunsThroughBash() {
  // The measured divergence that motivated the redesign: v2 returned
  // "hi\n\nbye\n" where bash returns "hi\nbye\n".
  // The trailing `true` keeps the line on the bash path; a chain of
  // echoes alone runs in process.
  const result = safeBash("echo hi && echo bye && true")
  if (result is failure(why)) {
    return "FAILED: ${why}"
  }
  return result.value
}

node nonZeroExitIsAFailure() {
  const result = safeBash("false")
  if (result is failure(why)) {
    return "FAILED"
  }
  return "UNEXPECTEDLY SUCCEEDED"
}

node appendReallyAppends() {
  // The executor is called positionally, and no other test runs it, so a
  // swapped argument order survives everything else.
  safeBash("echo one > __safebash_append__.txt")
  safeBash("echo two >> __safebash_append__.txt")
  const back = read("__safebash_append__.txt") with approve
  remove("__safebash_append__.txt") with approve
  if (back is failure(why)) {
    return "READ FAILED"
  }
  return back.value
}

node defaultCwdIsNeverEmpty() {
  // `write` rejects an empty dir, and `getAgentCwd()` is empty whenever
  // nothing set one — which is the case these tests run in.
  return [resolveCwd(""), resolveCwd("/somewhere")]
}

node quotedRedirectTarget() {
  // A quoted target with no variable is a real filename, so it maps.
  return writePlanDetail("echo hi > \"my file.txt\"")
}

node longOutputIsKept() {
  // A literal longer than MAX_STDOUT_LEN goes through the shell-free path,
  // which keeps output the same way the bash path does — so this also pins
  // the consistency between the two.
  const chars = ["x" for i in range(60000)]
  const long = chars.join("")
  const result = safeBash("echo ${long}") with approve
  if (result is failure(why)) {
    return "FAILED"
  }
  const notice = result.value
  const name = spilledName(notice)
  let savedLength = -1
  let grepHits = -1
  const contents = readSpill(name)
  if (contents is success(text)) {
    savedLength = text.length
  }
  const hits = grepSpill("x{10}", filename: name)
  if (hits is success(matches)) {
    grepHits = matches.length
  }
  return [
    // The end of the one long line comes back, then the notice.
    notice.length < 51000,
    notice.includes("Command exited with code 0"),
    notice.includes("saved as a file: "),
    // The notice gives the path and names no tool.
    name.includes("/agency-spill-") && !notice.includes("readSpill"),
    savedLength,
    grepHits,
  ]
}

/** The path a "saved as a file" notice gives, which the readers take. */
def spilledName(notice: string): string {
  const after = notice.split("saved as a file: ")[1]
  return after.split(" ")[0]
}

node spillToolsTakeNamesOnly() {
  // The read tools accept a name, never a path, so nothing outside the
  // store can be reached through them.
  const up = readSpill("../../etc/passwd")
  const absolute = readSpill("/etc/passwd")
  const hidden = grepSpill("x", filename: ".hidden.log")
  return [isFailure(up), isFailure(absolute), isFailure(hidden)]
}

// --- resolved redirect targets (contained-filenames spec) ---

def writeExecOf(source: string, cwd: string): any {
  return match(planFor(source, cwd).execution) {
    { kind: "write", content, filename, dir, mode } => {
      return { dir: dir, filename: filename, content: content, mode: mode }
    }
    { kind } => {
      return { kind: kind }
    }
  }
}

def writePayloadOf(source: string, cwd: string): any {
  const plan = planFor(source, cwd)
  for (e in plan.effects) {
    if (e.name == "std::write") {
      return e.payload
    }
  }
  return { kind: "no-write-effect" }
}

// An absolute redirect target reports its own parent, not the cwd: the
// policy judges the real destination.
node absoluteRedirectReportsParent(): boolean {
  const exec = writeExecOf("echo hi > /cf-sb-nonexistent-abs/out.txt", "/repo")
  return exec.dir == "/cf-sb-nonexistent-abs" && exec.filename == "out.txt"
}

// The payload and the execution derive from one shared WritePayload, so
// they must agree field for field — on the shell-free echo path AND the
// recognized-command path (git status > target).
node payloadExecutionParity(): boolean {
  const exec = writeExecOf("echo hi > sub/out.txt", "/repo")
  const payload = writePayloadOf("echo hi > sub/out.txt", "/repo")
  const fieldsAgree = exec.dir == payload.dir && exec.filename == payload.filename
  const contentAgrees = exec.content == payload.content && exec.mode == payload.mode
  const resolvedRight = exec.dir == "/repo/sub" && exec.filename == "out.txt"
  const gitPayload = writePayloadOf("git status > sub/g.txt", "/repo")
  const gitOk = gitPayload.dir == "/repo/sub" && gitPayload.filename == "g.txt"
  return fieldsAgree && contentAgrees && resolvedRight && gitOk
}

// Quote-aware tilde. An unquoted `~` is expanded, so the redirect is a
// recognized write whose payload names the real home directory, which is
// the destination the policy should judge. Quoted tildes stay a literal
// name beneath the cwd, exactly as bash treats them.
node tildeRedirectQuoting(): boolean {
  const unquoted = writeExecOf("echo hi > ~/cf-sb-tilde.txt", "/repo")
  const single = writeExecOf("echo hi > '~/cf-sb-tilde.txt'", "/repo")
  const double = writeExecOf("echo hi > \"~/cf-sb-tilde.txt\"", "/repo")
  // An unquoted `~` expands, so the write lands in the real home directory,
  // wherever that is on this machine; a quoted one is a directory literally
  // named `~` under the cwd.
  const unquotedExpanded = unquoted.dir != null && !unquoted.dir.startsWith("/repo") && unquoted.filename == "cf-sb-tilde.txt"
  const singleLiteral = single.dir == "/repo/~" && single.filename == "cf-sb-tilde.txt"
  const doubleLiteral = double.dir == "/repo/~" && double.filename == "cf-sb-tilde.txt"
  return unquotedExpanded && singleLiteral && doubleLiteral
}

def planKind(source: string): string {
  return planFor(source, "/repo").execution.kind
}

node agencyCommandLines() {
  return [
    planKind("agency test x.test.json"),
    planKind("agency typecheck ./x.agency"),
    planKind("which agency"),
    planKind("type agency"),
    planKind("command -v agency"),
    planKind("command agency test x.test.json"),
    planKind("command echo agency"),
    planKind("which git agency"),
    planKind("agency test $f"),
    planKind("agency test x.test.json > out"),
    planKind("xargs agency-lang"),
    planKind("which git"),
  ]
}

def planReason(source: string): any {
  const plan = planFor(source, "/repo")
  if (plan.broadReason == null) {
    return null
  }
  return [plan.broadReason.kind, plan.broadReason.detail]
}

def planOutcome(source: string): string {
  return outcomeOf(planFor(source, "/repo"))
}

node planReasons() {
  return [
    planReason("git status"),
    planReason("xargs rm x"),
    planReason("echo hi | cat"),
    planReason("echo $(date)"),
    planReason("rm -rf build"),
    planReason("git status; xargs rm x"),
  ]
}

node planVerbs() {
  return [
    planFor("git status; xargs rm x", "/repo").verbs,
    planFor("echo $(date)", "/repo").verbs,
    planFor("FOO=bar", "/repo").verbs,
    planFor("rm -rf build", "/repo").verbs,
  ]
}

node planOutcomes() {
  return [
    planOutcome("git status"),
    // A read needs a file that exists, so this row plans in the fixtures.
    outcomeOf(planFor("cat one.txt && git status", FIXTURES)),
    planOutcome("xargs rm x"),
    planOutcome("echo hi"),
    planOutcome("echo hi > out.txt"),
    planOutcome("dd if=a of=b"),
    planOutcome("agency typecheck foo.agency"),
    planOutcome("echo hi | cat"),
  ]
}

node rejectedBroadSaysWhy() {
  const result = safeBash("xargs echo hi")
  if (result is failure(why)) {
    return why
  }
  return "UNEXPECTEDLY RAN"
}

node rejectedAuditSaysWhy() {
  // `$HOME` is not known now, so this asks std::bash, not the quiet question.
  const result = safeBash("echo $HOME | cat")
  if (result is failure(why)) {
    return why
  }
  return "UNEXPECTEDLY RAN"
}

node rejectedNarrowIsUnchanged() {
  const result = safeBash("git status")
  if (result is failure(why)) {
    return why
  }
  return "UNEXPECTEDLY RAN"
}

// The tool loop tells "the user said no" from "the tool broke" by the
// failure's rejected flag, so safeBash must pass a rejection on with it.
node rejectionKeepsFlag() {
  const narrow = safeBash("git status")
  const broad = safeBash("xargs echo hi")
  let flags: boolean[] = []
  for (result in [narrow, broad]) {
    if (isFailure(result)) {
      flags = [...flags, result.rejected]
    }
  }
  return flags
}

node newShapes() {
  return [
    planSummary("git status | git log"),
    planSummary("git status | head"),
    planSummary("echo hi 2>&1"),
    planSummary("echo hi 2>&1 > out.txt"),
    planSummary("echo *.md"),
    planSummary("shred x | cat"),
    planSummary("make 2>&1 | tail -100"),
    planReason("git status | head"),
    executionCommand("git    status |  git   log"),
  ]
}

node pipelineRunsThroughBash() {
  // `tr` reads the pipe and asks nothing, so the line asks the quiet
  // question. What this pins is that a pipe reaches bash through _bash and
  // produces bash's output.
  const result = safeBash("echo hi | tr a-z A-Z")
  if (result is failure(why)) {
    return "FAILED: ${why}"
  }
  return result.value
}

// Commands that only print add no question inside a line. A spelling the
// quiet table does not accept has no rule.
node quietCommandsAskNothing() {
  return [
    treeRow("pwd; ls lib", PACKAGE_DIR),
    treeRow("which node && node --version", PACKAGE_DIR),
    treeRow("command -v gtimeout; ls", PACKAGE_DIR),
    treeRow("uname -a; whoami; hostname; date -u '+%s'; ls", PACKAGE_DIR),
    treeRow("basename a/b.txt; dirname a/b.txt; sleep 1; true; false; :; type git; ls", PACKAGE_DIR),
    treeRow("which agency", PACKAGE_DIR),
    treeRow("which agency; ls", PACKAGE_DIR),
    treeRow("which node_modules/.bin/agency; ls", PACKAGE_DIR),
    treeRow("command ls", PACKAGE_DIR),
    treeRow("hostname x; ls", PACKAGE_DIR),
    treeRow("date -s 1; ls", PACKAGE_DIR),
    treeRow("date 0101; ls", PACKAGE_DIR),
    treeRow("sleep $N; ls", PACKAGE_DIR),
    treeRow("printf -v PATH x; ls", PACKAGE_DIR),
    treeRow("printf \"-v\" PATH x; ls", PACKAGE_DIR),
    treeRow("printf $F x; ls", PACKAGE_DIR),
    treeRow("printf \"$GITHUB_TOKEN\"; ls", PACKAGE_DIR),
    treeRow("printf 'a\\n'; ls", PACKAGE_DIR),
    treeRow("printf '%s\\n' a b; ls", PACKAGE_DIR),
    treeRow("printf 'a%n' PATH; ls", PACKAGE_DIR),
    treeRow("printf '%5n' PATH; ls", PACKAGE_DIR),
    treeRow("printf '%s%ln' a PATH; ls", PACKAGE_DIR),
    treeRow("printf '100%%n\\n'; ls", PACKAGE_DIR),
    treeRow("pwd -P > out.txt", PACKAGE_DIR),
  ]
}

// `timeout <duration> <command>` asks what the command asks. The wrapper
// goes back in front of the command that runs, with the assignments in
// front of it.
node timeoutReadsThrough() {
  return [
    treeRow("timeout 60 pnpm test", PACKAGE_DIR),
    execArgs("timeout 60 pnpm test"),
    treeRow("timeout 5 cat one.txt", FIXTURES),
    treeRow("gtimeout 60s pnpm test", PACKAGE_DIR),
    treeRow("timeout 120 pnpm run typecheck 2>&1 | tail -20", PACKAGE_DIR),
    treeRow("timeout -s KILL 5 pnpm test", PACKAGE_DIR),
    treeRow("timeout 5 timeout 5 ls", PACKAGE_DIR),
    treeRow("timeout 5 git diff", PACKAGE_DIR),
    treeRow("timeout 5s5 ls", PACKAGE_DIR),
    treeRow("timeout 5", PACKAGE_DIR),
    executionCommand("TERM=dumb timeout 60 pnpm test"),
    executionCommand("timeout 5 gh search issues crash --repo o/r"),
    executionCommand("timeout 5 git status > out.txt"),
    planOutcome("timeout 5 rm -rf /"),
    planOutcome("timeout 5 shred x"),
    planOutcome("timeout 5 git reset --hard"),
    planOutcome("timeout 5 timeout 5 rm -rf /"),
  ]
}

// A few variables only change how output looks, and may come in front of
// a command with a plain value. A redirect from or to /dev/null reads and
// writes no file.
node quietAssignmentsAndNull() {
  return [
    treeRow("TERM=dumb pnpm test", PACKAGE_DIR),
    treeRow("NO_COLOR=1 LC_ALL=C pnpm test", PACKAGE_DIR),
    treeRow("tv --help </dev/null", PACKAGE_DIR),
    treeRow("pnpm test &>/dev/null", PACKAGE_DIR),
    treeRow("PATH=/tmp pnpm test", PACKAGE_DIR),
    treeRow("TERM=$X pnpm test", PACKAGE_DIR),
    treeRow("NODE_OPTIONS=x pnpm test", PACKAGE_DIR),
    treeRow("CI=1 pnpm test", PACKAGE_DIR),
    treeRow("TZ=/etc/passwd date", PACKAGE_DIR),
    treeRow("pnpm test &>out.txt", PACKAGE_DIR),
    treeRow("cat < /dev/null", PACKAGE_DIR),
    treeRow("git status < /dev/null", PACKAGE_DIR),
    executionCommand("TERM=dumb git status"),
    executionCommand("TERM=dumb git diff"),
    executionCommand("NO_COLOR=1 gh search issues crash --repo o/r"),
    executionCommandIn("LC_ALL=C grep -rn hello . | head", FIXTURES),
  ]
}

/* A plan's effect names and the text it runs. */
def quietLine(source: string, dir: string): any {
  const plan = planFor(source, dir)
  const ran = match(plan.execution) {
    { kind: "bash", command } => command
    _ => "NOT-BASH"
  }
  return [source, outcomeOf(plan), [effect.name for effect in plan.effects], ran.split(resolve(dir)).join("<dir>")]
}

// A line whose commands raise no question asks std::bash::readonly when
// every word in it is known now, and std::bash when one is not.
node quietLinesAskTheQuietQuestion() {
  return [
    quietLine("pwd", PACKAGE_DIR),
    quietLine("echo \"---\"", PACKAGE_DIR),
    quietLine("which node; date", PACKAGE_DIR),
    quietLine("echo $HOME", PACKAGE_DIR),
    quietLine("echo ~", PACKAGE_DIR),
    quietLine("cd lib", PACKAGE_DIR),
    quietLine("echo hi | grep h", PACKAGE_DIR),
    quietLine("TERM=dumb pwd", PACKAGE_DIR),
  ]
}

// The question reaches a policy as std::bash::readonly, which recommended
// approves. A lone `pwd` runs with no other question.
node quietLineRunsUnderRecommended() {
  let out = ""
  handle {
    const result = safeBash("pwd", cwd: FIXTURES)
    if (result is success(text)) {
      out = text
    }
  } with (intr) {
    if (intr.effect == "std::bash::readonly" && checkPolicy(recommendedAutoApprovePolicy, intr).type == "approve") {
      return approve()
    }
    return reject()
  }
  return out.trim() == resolve(FIXTURES)
}

/** A folder of its own for the file-command and missing-path tests: a
 file `one.txt` and a folder `sub`. */
static const FILES_FIXTURE = __dirname + "/stdlib/__safebash_files__"

def makeFilesFixture() {
  remove(FILES_FIXTURE) with approve
  mkdir(FILES_FIXTURE) with approve
  bash("mkdir sub && printf 'one\\ntwo\\n' > one.txt", cwd: FILES_FIXTURE) with approve
}

/* The path an effect's payload names, with the fixture's folder as `<fix>`. */
def fixturePath(payload: any): string {
  if (payload == null) {
    return ""
  }
  let full: string = payload.dir ?? payload.target ?? payload.cwd ?? ""
  if (payload.filename != null) {
    full = full + "/" + payload.filename
  }
  return full.split(resolve(FILES_FIXTURE)).join("<fix>")
}

/* A plan in the fixture: its outcome, and each effect's name and path. */
def fileRow(source: string): any {
  const plan = planFor(source, FILES_FIXTURE)
  const effects: any[] = plan.effects
  return [source, outcomeOf(plan), [[effect.name, fixturePath(effect.payload)] for effect in effects]]
}

/* The decision a policy makes on the first effect of a plan in the fixture. */
def firstDecision(source: string, policy: any): string {
  const effect: any = planFor(source, FILES_FIXTURE).effects[0]
  return checkPolicy(policy, { effect: effect.name, data: effect.payload }).type
}

// mkdir asks std::mkdir for the real path the mkdir tool would name, and
// touch asks std::write for an empty append, which the with-writes policy
// approves under its folder.
node makeAsksLikeTheTools() {
  makeFilesFixture()
  const touched: any = planFor("touch x.txt", FILES_FIXTURE).effects[0]
  const rows = [
    fileRow("mkdir -p a/b"),
    fileRow("mkdir a b"),
    fileRow("mkdir -p sub/x"),
    fileRow("touch x.txt"),
    [touched.payload.content, touched.payload.mode],
    fileRow("touch one.txt sub/two.txt"),
    fileRow("mkdir -m 700 a"),
    fileRow("mkdir $X"),
    fileRow("touch -t 0101 x"),
    fileRow("mkdir"),
    firstDecision("mkdir -p tmp/x", withWritesPolicy(FILES_FIXTURE)),
    firstDecision("mkdir -p /usr/local/x", withWritesPolicy(FILES_FIXTURE)),
  ]
  remove(FILES_FIXTURE) with approve
  return rows
}

// cp, mv, ln, and sed do one narrow thing to files, and std::exec pins
// only their first argument, so none of them asks std::exec.
node fileProgramsAskBash() {
  return [
    grepNames("cp a b"),
    grepNames("mv -f a b"),
    grepNames("ln -s a b"),
    grepNames("sed -i s/a/b/ one.txt"),
    grepNames("sed -n '1e true' one.txt"),
    grepNames("sed -n 'w out.txt' one.txt"),
  ]
}

// tee in a pipe writes each file it names, as a redirect does.
node teeWritesLikeARedirect() {
  makeFilesFixture()
  const append: any = planFor("pnpm test | tee -a out.log", FILES_FIXTURE).effects[1]
  const rows = [
    fileRow("pnpm test 2>&1 | tee out.log | tail -30"),
    fileRow("pnpm test | tee a.log sub/b.log"),
    append.payload.mode,
    fileRow("tee out.log"),
    fileRow("pnpm test | tee $F"),
  ]
  remove(FILES_FIXTURE) with approve
  return rows
}

// A range read with sed, a checksum, and file are reads; stat is a
// listing of the folder that holds the file.
node readsByOtherNames() {
  makeFilesFixture()
  const rows = [
    fileRow("sed -n 10,20p one.txt"),
    fileRow("sed -n '5p' one.txt"),
    fileRow("sed -n '1,5p;7p' one.txt"),
    fileRow("sed -n p one.txt"),
    fileRow("git log | sed -n 1,5p"),
    fileRow("stat one.txt"),
    fileRow("stat sub"),
    fileRow("shasum one.txt"),
    fileRow("sha256sum one.txt"),
    fileRow("md5sum one.txt"),
    fileRow("file one.txt"),
    fileRow("shasum -c sums.txt"),
    fileRow("file sub"),
  ]
  remove(FILES_FIXTURE) with approve
  return rows
}

// A path that does not exist when the plan is made resolves by its
// parent, when the parent exists and nothing opaque has run before it.
node missingPathsResolveByParent() {
  makeFilesFixture()
  const rows = [
    fileRow("cat nope.txt"),
    planFor("cat nope.txt", FILES_FIXTURE).execution.kind,
    fileRow("ls nope 2>/dev/null || echo missing"),
    fileRow("ls -la one.txt nope.txt"),
    fileRow("wc -l nope.txt sub/nope.txt"),
    fileRow("cat nodir/nope.txt"),
    fileRow("find nope -name x"),
    fileRow("tree nope"),
    fileRow("diff one.txt nope.txt"),
    fileRow("wc -l < nope.txt"),
    fileRow("grep x nope.txt | head"),
    fileRow("pnpm build && cat out.txt"),
    fileRow("git status; cat nope.txt"),
  ]
  remove(FILES_FIXTURE) with approve
  return rows
}

// After a command that ran a program safeBash cannot see into, a missing
// path has no rule: the program may have made it into anything.
node missingPathAfterAProgramIsBroad() {
  makeFilesFixture()
  const rows = [
    fileRow("ln -s /etc/hosts x; cat x"),
    fileRow("mkdir x; ls x"),
    fileRow("cp one.txt y; cat y"),
    fileRow("ln -sf /etc/hosts out.txt > out.txt; cat out.txt"),
    fileRow("pnpm test; cat nope.txt"),
    fileRow("pnpm test | cat nope.txt"),
    // A narrow command that can put a link where a file was forgets the
    // files the line wrote.
    fileRow("echo a > out.txt; rm out.txt; git checkout main; cat out.txt"),
    fileRow("echo a > out.txt; git stash pop; cat out.txt"),
    fileRow("git checkout main > out.txt; cat out.txt"),
  ]
  remove(FILES_FIXTURE) with approve
  return rows
}

// A read of a file the same line wrote resolves to it, even after an
// opaque program: the redirect asked std::write for that very file.
node readsOfFilesTheLineWrote() {
  makeFilesFixture()
  const rows = [
    fileRow("gh pr diff 1 --repo o/r > x.diff 2>&1; wc -l x.diff"),
    fileRow("pnpm test > out.txt 2>&1; tail -50 out.txt"),
    fileRow("tail -5 out.txt; pnpm test > out.txt"),
    fileRow("pnpm test > out.txt | cat out.txt"),
    fileRow("(pnpm test > out.txt); cat out.txt"),
    fileRow("pnpm test > out.txt 2>&1 && cat out.txt | tail -5"),
    fileRow("pnpm test 2>&1 | tee out.txt; grep FAIL out.txt"),
  ]
  remove(FILES_FIXTURE) with approve
  return rows
}

def split(source: string): any {
  const parsed = bashParser(source)
  if (parsed is failure(why)) {
    return "UNPARSEABLE"
  }
  const first = parsed.value[0]
  if (!(first is { tag: "simpleCommand" })) {
    return "NOT-SIMPLE"
  }
  const result = splitFlags("grep", first, GREP_FLAGS)
  if (result is failure(why)) {
    return why
  }
  const args = result.value
  const values = [entry.flag + "=" + entry.value for entry in args.values]
  return [args.plain, values, args.positionals.length]
}

node splitGrepFlags() {
  return [
    split("grep -rni hello ."),
    split("grep -A 3 hello ."),
    split("grep -A3 hello ."),
    split("grep -e hello ."),
    split("grep --color=never hello ."),
    split("grep -nA3 hello ."),
    split("grep -z hello ."),
    split("grep -R hello ."),
    split("grep -e a -e b ."),
    split("grep \"-R\" hello"),
    split("grep -A"),
    split("grep --filter=x hello ."),
    split("grep --save-config hello ."),
    split("grep --include=*.ts -rn hello ."),
    split("grep -e \"-x\" one.txt"),
    split("grep -n hello one.txt -s"),
    split("grep --color=always x one.txt"),
    split("grep -rn x lib --include=\"*.ts\" --include=\"*.md\""),
    split("grep -e a -e b f"),
  ]
}

// A long flag joined to a quoted value is that flag, but only for a table
// that asks for it: gh and find do not, and plan as before.
node joinedFlagWords() {
  return [
    split("grep --include=\"*.ts\" x lib"),
    split("grep --include='*.ts' x lib"),
    split("grep --include=\"$X\" x lib"),
    split("grep \"-R\" src"),
    grepNames("gh pr list --label=\"bug,urgent\""),
    grepNames("find . -name=\"*.ts\""),
  ]
}

/** A find-shaped table: single-dash flags are whole words. */
static const WHOLE_FLAGS: FlagSpec = {
  plain: ["-print"],
  valued: ["-name"],
  optionsFirst: false,
  wholeWords: true
}

def splitSummary(source: string, spec: FlagSpec): any {
  const parsed = bashParser(source)
  if (parsed is failure(why)) {
    return "UNPARSEABLE"
  }
  const first = parsed.value[0]
  if (!(first is { tag: "simpleCommand" })) {
    return "NOT-SIMPLE"
  }
  const result = splitFlags("x", first, spec)
  if (result is failure(why)) {
    return why
  }
  const args = result.value
  const values = [entry.flag + "=" + entry.value for entry in args.values]
  return [args.plain, values, args.positionals.length]
}

node wholeShortFlags() {
  return [
    splitSummary("x -name foo -print f", WHOLE_FLAGS),
    splitSummary("x -name", WHOLE_FLAGS),
    splitSummary("x -nam f", WHOLE_FLAGS),
    splitSummary("x -name=foo f", WHOLE_FLAGS),
    splitSummary("x -n f", WHOLE_FLAGS),
  ]
}

static const FIXTURES = __dirname + "/stdlib/grep-fixtures"

/** The package directory, whose node_modules exists in every checkout
 * and whose .gitignore ignores everything inside it. */
static const PACKAGE_DIR = __dirname + "/../.."

def grepNames(source: string): any {
  const plan = planFor(source, FIXTURES)
  const names = [effect.name for effect in plan.effects]
  return [names, plan.broadReason]
}

def grepPayloadOf(source: string): any {
  const plan = planFor(source, FIXTURES)
  for (effect in plan.effects) {
    if (effect.name == "std::grep") {
      return effect.payload
    }
  }
  return "NO GREP EFFECT"
}

node grepThroughBash() {
  // Not lone (a pipe or a redirect), or a flag the tool lacks: the
  // command runs through bash, with one std::grep per path.
  return [
    grepNames("grep -c hello one.txt"),
    grepNames("grep -A 1 hello one.txt"),
    grepNames("grep -n \"a+b\" one.txt"),
    grepNames("grep -n hello one.txt > out.txt"),
    grepNames("git status && grep -n hello one.txt"),
    grepNames("grep -rn hello one.txt two.txt"),
    grepNames("grep -rn hello --include='*.txt' ."),
    grepNames("git status && grep -rn hello ."),
    grepNames("git status && grep -n hello one.txt -s"),
  ]
}

node grepUnrecognized() {
  return [
    grepNames("grep hello"),
    grepNames("grep -z hello ."),
    grepNames("grep -R hello ."),
    grepNames("grep \"-R\" hello"),
    grepNames("grep -e a -e b ."),
    grepNames("grep --filter=x hello ."),
    grepNames("grep -rn $PAT ."),
    grepNames("grep -rn hello *.txt"),
    grepNames("grep -c hello ."),
    grepNames("rg hello ."),
    grepNames("grep -e \"-x\" one.txt"),
    grepNames("grep --include=*.txt -rn hello ."),
  ]
}

node grepMissingPath() {
  // The detail names an absolute path, which differs per machine, so
  // only the kind is pinned.
  const reason = planFor("grep -rn hello missing-dir", FIXTURES).broadReason
  if (reason == null) {
    return null
  }
  return reason.kind
}

node grepBashPayload() {
  const payload = grepPayloadOf("grep -cin hello one.txt")
  return [payload.pattern, payload.file, payload.ignoreCase, payload.maxResults, payload.flags]
}

def executionKind(source: string): string {
  return planFor(source, FIXTURES).execution.kind
}

node loneGrepIsShellFree() {
  return [
    executionKind("grep -rn hello ."),
    executionKind("grep -rn hello"),
    executionKind("grep -n hello one.txt"),
    executionKind("grep -rniwl hello ."),
    executionKind("grep -rnF \"a+b\" ."),
    executionKind("grep -rnE \"hello|goodbye\" ."),
    executionKind("grep -c hello one.txt"),
    executionKind("grep -n \"a+b\" one.txt"),
    executionKind("grep hello ."),
    executionKind("grep -rn hello . | head"),
    outcomeOf(planFor("grep -rn hello .", FIXTURES)),
    executionKind("grep -rnw \" world\" ."),
    executionKind("grep -n hello one.txt -s"),
  ]
}

node shellFreePayloads() {
  const fixed = grepPayloadOf("grep -rnF \"a+b\" .")
  const dirSearch = grepPayloadOf("grep -rn hello .")
  const fileSearch = grepPayloadOf("grep -n hello one.txt")
  return [
    fixed.pattern,
    [dirSearch.file, dirSearch.maxResults, dirSearch.flags],
    [fileSearch.file, fileSearch.dir == dirSearch.dir],
  ]
}

/** The output's lines in a fixed order, without safeBash's own note lines.
 * grep and the tool's walk visit files in different orders. */
def sortedLines(text: string): string {
  const lines = text.split("\n")
  const matches = [line for line in lines if line != "" && !line.startsWith("(safeBash")]
  return JSON.stringify(matches.sort())
}

def parityOf(source: string): any {
  // Without this check, a row whose command fell back to the bash path
  // would compare real grep with itself and pass for no reason.
  if (planFor(source, FIXTURES).execution.kind != "grep") {
    return "NOT SHELL-FREE: ${source}"
  }
  let ours = ""
  let theirs = ""
  handle {
    const shellFree = safeBash(source, cwd: FIXTURES)
    if (shellFree is success(out)) {
      ours = out
    }
    // bash returns an ExecResult, not a Result.
    const real = bash(source, cwd: FIXTURES)
    theirs = real.stdout
  } with approve
  if (sortedLines(ours) == sortedLines(theirs)) {
    return true
  }
  return [source, ours, theirs]
}

node shellFreeMatchesRealGrep() {
  // No row runs `grep -rn hello` with no path: GNU grep prints bare names
  // there, and BSD grep, macOS's grep, prints `./one.txt`. The rendering
  // follows GNU, and a grepDialect unit test pins it.
  return [
    parityOf("grep -n hello one.txt"),
    parityOf("grep hello one.txt"),
    parityOf("grep -rn hello ."),
    parityOf("grep -rh hello ."),
    parityOf("grep -rl hello ."),
    parityOf("grep -rni hello ."),
    parityOf("grep -rnw hello ."),
    parityOf("grep -rnv hello ."),
    parityOf("grep -rnF \"o w\" ."),
    parityOf("grep -rnE \"hello|goodbye\" ."),
    parityOf("grep -rn \"^hello\" ."),
    parityOf("grep -rn 'world$' ."),
    parityOf("grep -rn \"h.l*o\" ."),
    parityOf("grep -Hn hello one.txt"),
    parityOf("grep -n hello one.txt -s"),
  ]
}

node loneGrepAsksOneQuestion() {
  // One std::grep approval, and no shell: a std::bash prompt would fail
  // the run, because the test file answers only the grep message.
  const result = safeBash("grep -rn hello .", cwd: FIXTURES)
  if (result is failure(why)) {
    return "FAILED: ${why}"
  }
  return [result.value.includes("./one.txt:1:hello world"), result.value.includes("skips node_modules")]
}

node bashGrepOfOneFile() {
  // -c has no tool equivalent, so real grep runs after one std::grep approval.
  const result = safeBash("grep -c hello one.txt", cwd: FIXTURES)
  if (result is failure(why)) {
    return "FAILED: ${why}"
  }
  return result.value
}

node shellFreeNoMatchFails() {
  const result = safeBash("grep -rn nothing-matches-this .", cwd: FIXTURES)
  if (result is failure(why)) {
    return [why.includes("Command exited with code 1"), why.includes("skips node_modules")]
  }
  return "UNEXPECTEDLY MATCHED"
}

node grepUnderRecommendedNeedsNoPrompt() {
  // The launch directory is the package directory, so the fixtures are
  // inside it and recommended approves std::grep there. This test has no
  // interruptHandlers entry, so an unanswered interrupt fails the run.
  let found = false
  handle {
    const result = safeBash("grep -rn hello " + FIXTURES)
    if (result is success(text)) {
      found = text.includes("hello again")
    }
  } with (intr) {
    if (checkPolicy(recommendedAutoApprovePolicy, intr).type == "approve") {
      return approve()
    }
    return reject()
  }
  return found
}

node grepOutsideTheLaunchDirIsUndecided() {
  const plan = planFor("grep -rn root /etc", FIXTURES)
  const effect: any = plan.effects[0]
  const intr = { effect: effect.name, data: effect.payload }
  return checkPolicy(recommendedAutoApprovePolicy, intr).type
}

node rejectedGrepNamesTheTool() {
  const result = safeBash("grep -z hello .", cwd: FIXTURES)
  if (result is failure(why)) {
    return why
  }
  return "UNEXPECTEDLY RAN"
}

node grepOfIgnoredFolder() {
  // A lone grep of a folder .gitignore ignores runs the tool's search like a
  // grep of any other folder, because the tool searches a folder it is given
  // whatever the .gitignore files above it say.
  const plan = planFor("grep -rn parseAgency node_modules", PACKAGE_DIR)
  const names = [effect.name for effect in plan.effects]
  return [plan.execution.kind, names, plan.broadReason]
}

node grepOfPartlyIgnoredFolder() {
  // The repository's .gitignore ignores some entries of stdlib (`.*`,
  // `**/*.js`) but not all of them, so the tool's search still finds the
  // rest and the grep runs shell-free.
  return planFor("grep -rn hello stdlib", PACKAGE_DIR).execution.kind
}

def stdinFlags(source: string): any {
  const parsed = bashParser(source)
  if (parsed is failure(why)) {
    return "UNPARSEABLE"
  }
  const flat = flattenCommands(parsed.value)
  return [entry.readsStdin for entry in flat]
}

node stagesReadStdin() {
  return [
    stdinFlags("git status"),
    stdinFlags("a | b | c"),
    stdinFlags("a | b && c"),
    stdinFlags("(a | b) | c"),
    stdinFlags("a; b | c"),
    stdinFlags("a | (b && c)"),
    stdinFlags("a | (b | c)"),
  ]
}

node grepFilterStages() {
  return [
    grepNames("git status | grep hello"),
    grepNames("git status | grep -v hello | grep -c x"),
    grepNames("git status | grep -rn hello"),
    grepNames("git status | grep hello one.txt"),
    grepNames("git status | grep hello > out.txt"),
    grepNames("git status | grep hello && grep bye"),
    grepNames("git status | grep -R hello"),
    grepNames("echo hi | grep h"),
    grepNames("git status | grep hello -i"),
    grepNames("git status | grep -e hello"),
  ]
}

/** A tree for the grep-through-bash tests. Each of the folders and files
 the grep tool skips holds `needle`, as do a file named `build` and a
 `.git` file, which is what a git worktree has. `outside` sits beside
 `tree`, and links in `tree/src` point at it. */
static const GREP_TREE = __dirname + "/stdlib/__safebash_grep_tree__"
static const GREP_TREE_ROOT = GREP_TREE + "/tree"

def makeGrepTree() {
  remove(GREP_TREE) with approve
  mkdir(GREP_TREE) with approve
  const folders = "mkdir -p tree/.git tree/node_modules/p tree/src/dist tree/src/sub/build tree/lib outside"
  const needles = "for f in tree/.git/config tree/node_modules/p/i.js tree/src/a.ts tree/src/dist/b.js tree/src/sub/build/c.js tree/src/build tree/src/sub/.git outside/s.txt; do echo needle > $f; done"
  const others = "echo hello > tree/one.txt && echo hello > tree/lib/l.ts"
  const links = "ln -s ../../outside/s.txt tree/src/link.txt && ln -s ../../outside tree/src/linkdir"
  bash("${folders} && ${needles} && ${others} && ${links}", cwd: GREP_TREE) with approve
}

def treeRow(source: string, dir: string): any {
  const plan = planFor(source, dir)
  return [source, outcomeOf(plan), [effect.name for effect in plan.effects]]
}

node grepThroughBashAsksStdGrep() {
  makeGrepTree()
  const rows = [
    treeRow("grep -rn hello . | head -20", GREP_TREE_ROOT),
    treeRow("grep -rn \"a\\|b\" src", GREP_TREE_ROOT),
    treeRow("grep -rn hello src lib", GREP_TREE_ROOT),
    treeRow("grep -rn hello src --include=\"*.ts\"", GREP_TREE_ROOT),
    treeRow("grep -n hello one.txt -A 5", GREP_TREE_ROOT),
    treeRow("grep -rn hello node_modules | head", GREP_TREE_ROOT),
    treeRow("grep -rn hello node_modules/p | head", GREP_TREE_ROOT),
    treeRow("grep -n hello src", GREP_TREE_ROOT),
    treeRow("grep -rn hello src", GREP_TREE_ROOT),
    treeRow("grep -rn hello src/dist | head", GREP_TREE_ROOT),
    treeRow("grep -rn hello src/dist/ | head", GREP_TREE_ROOT),
    treeRow("grep -rn hello . | head", GREP_TREE_ROOT + "/src/sub/build"),
    treeRow("grep -rn hello | head", GREP_TREE_ROOT),
    treeRow("pnpm test | grep FAIL -v", GREP_TREE_ROOT),
    treeRow("git status | grep -v deleted -c", GREP_TREE_ROOT),
    treeRow("grep -rn hello src -e x | head", GREP_TREE_ROOT),
  ]
  remove(GREP_TREE) with approve
  return rows
}

// The exact text bash runs. The six names are the grep tool's skip list.
// If a name is added to that list, this fails until the text here agrees,
// which is the check that real grep still skips what the tool skips.
node grepRunsWhatItAsked() {
  makeGrepTree()
  const rows = [
    executionCommandIn("grep -rn hello . | head -20", GREP_TREE_ROOT),
    executionCommandIn("grep -rn hello src --include=\"*.ts\"", GREP_TREE_ROOT),
    executionCommandIn("grep -n hello one.txt -A 5", GREP_TREE_ROOT),
    executionCommandIn("grep -n hello one.txt lib/l.ts | head", GREP_TREE_ROOT),
    executionCommandIn("grep -rn hello | head", GREP_TREE_ROOT),
  ]
  remove(GREP_TREE) with approve
  return rows
}

/* What safeBash prints for a line, approving only std::grep. */
def grepOnly(source: string, dir: string): string {
  let out = ""
  handle {
    const result = safeBash(source, cwd: dir)
    if (result is success(text)) {
      out = text
    } else {
      out = "FAILED"
    }
  } with (intr) {
    if (intr.effect == "std::grep") {
      return approve()
    }
    return reject()
  }
  return out
}

// Real grep through bash reads no file the grep tool skips, follows no
// link out of the folder, and reads the same files the tool reads. This
// runs BSD grep on macOS and GNU grep in CI; a difference is a finding.
node grepThroughBashReadsWhatTheToolReads() {
  makeGrepTree()
  const withPath = grepOnly("grep -rn needle . | sort", GREP_TREE_ROOT)
  const noPath = grepOnly("grep -rn needle | sort", GREP_TREE_ROOT)
  const skipped = outcomeOf(planFor("grep -rn needle src/dist | sort", GREP_TREE_ROOT))
  let toolFiles: string[] = []
  handle {
    const found = grep("needle", GREP_TREE_ROOT, filesOnly: true, respectGitignore: false)
    if (found is success(names)) {
      toolFiles = names
    }
  } with approve
  remove(GREP_TREE) with approve
  return [withPath, noPath, skipped, toolFiles]
}

def filesOf(found: any): any {
  return match(found) {
    { kind: "stdin" } => "stdin"
    { kind: "files", paths } => [p.source.filename for p in paths]
  }
}

def readOf(source: string): any {
  const parsed = bashParser(source)
  if (parsed is failure(why)) {
    return "UNPARSEABLE"
  }
  const first = parsed.value[0]
  if (first is { tag: "simpleCommand" }) {
    const verb = verbName(first)
    const spec = READ_VERBS[verb]
    if (spec == null) {
      return "NOT A READ VERB"
    }
    // A line that has run nothing yet, where a missing path has no rule.
    const line: any = { cwd: FIXTURES, written: [], opaque: false, strict: true }
    return match(readFileVerb(verb, first, line, spec)) {
      success(found) => filesOf(found)
      failure(why) => why
    }
  }
  return "NOT-SIMPLE"
}

node readVerbsReadFiles() {
  return [
    readOf("cat one.txt"),
    readOf("cat one.txt two.txt"),
    readOf("cat -n one.txt"),
    readOf("head one.txt"),
    readOf("head -n 20 one.txt"),
    readOf("head -20 one.txt"),
    readOf("tail -n5 one.txt"),
    readOf("wc -l one.txt"),
    readOf("diff one.txt two.txt"),
    readOf("sort -u one.txt"),
    readOf("uniq -c one.txt"),
    readOf("cat"),
    readOf("head -n 3"),
    readOf("head one.txt two.txt"),
    readOf("uniq one.txt out.txt"),
    readOf("tail -n +5 one.txt"),
    readOf("head -n -5 one.txt"),
    readOf("tail -f one.txt"),
    readOf("cat -A one.txt"),
    readOf("cat $F"),
    readOf("cat *.txt"),
    readOf("diff one.txt"),
    readOf("diff -r one.txt two.txt"),
    readOf("cat ."),
    // The message names an absolute path, which differs per machine.
    readOf("cat nope.txt").startsWith("No file or directory at"),
    readOf("sort -o out.txt one.txt"),
    readOf("cat one.txt -n"),
    readOf("cut -c 1-3 one.txt"),
    readOf("diff"),
    readOf("diff -U x one.txt two.txt"),
    readOf("head -n 1 -n 2 one.txt"),
    readOf("head -2 -n 1 one.txt"),
  ]
}

node readsAskStdRead() {
  return [
    grepNames("cat one.txt"),
    grepNames("cat one.txt two.txt"),
    grepNames("wc -l one.txt"),
    grepNames("diff one.txt two.txt"),
    grepNames("sort one.txt"),
    grepNames("cat one.txt > copy.txt"),
    grepNames("git status && cat one.txt"),
    grepNames("cat one.txt | head -3"),
    grepNames("head -3 one.txt | cat"),
    grepNames("cat"),
    grepNames("cat -A one.txt"),
    grepNames("tail -f one.txt"),
    grepNames("cat ."),
  ]
}

/** A folder of its own for the symlink test. A link in FIXTURES would
 * change the output of the grep parity rows, which search it with -r. */
static const LINK_FIXTURE = __dirname + "/stdlib/__safebash_link__"

node readPayloadNamesTheRealParent(): any {
  remove(LINK_FIXTURE) with approve
  mkdir(LINK_FIXTURE) with approve
  bash("mkdir inside outside && echo hi > outside/target.txt && ln -s ../outside/target.txt inside/link.txt", cwd: LINK_FIXTURE) with approve
  let dir = ""
  let filename = ""
  const plan = planFor("cat link.txt", LINK_FIXTURE + "/inside")
  for (effect in plan.effects) {
    if (effect.name == "std::read") {
      dir = effect.payload.dir
      filename = effect.payload.filename
    }
  }
  remove(LINK_FIXTURE) with approve
  return [dir == LINK_FIXTURE + "/outside", filename]
}

node inputRedirectIsARead() {
  return [
    grepNames("git status < one.txt"),
    grepNames("cat < one.txt"),
    grepNames("echo hi < one.txt > copy.txt"),
    grepNames("git status < $F"),
    grepNames("git status < one.txt < two.txt"),
    grepNames("git status < ."),
    grepNames("git status | grep hello < one.txt"),
    grepNames("echo hi < one.txt"),
  ]
}

node filtersInAPipe() {
  return [
    grepNames("git log | sort | uniq -c"),
    grepNames("cat one.txt | sort -u"),
    grepNames("cat one.txt | cut -d : -f 1"),
    grepNames("cat one.txt | tr a b"),
    grepNames("cat one.txt | tr -d x"),
    grepNames("cat one.txt | tr -s a b"),
    grepNames("cat one.txt | tr a"),
    grepNames("cat one.txt | sort two.txt"),
    grepNames("cat one.txt | sort -o out.txt"),
    grepNames("sort one.txt"),
    grepNames("git log | tee log.txt"),
    grepNames("git log | xargs echo"),
    grepNames("git log | sort > sorted.txt"),
    grepNames("git log | tac"),
    grepNames("cut -d, -f1 one.txt"),
    grepNames("tr a b"),
    grepNames("cat one.txt | tr a $B"),
    grepNames("cat one.txt | tr -dd x"),
  ]
}

/** A plan made in the fixture folder: its outcome, each effect's name and
  the file it reads, and the broad reason. */
def fixtureReadRow(source: string): any {
  const plan = planFor(source, FIXTURES)
  const effects: any[] = plan.effects
  return [outcomeOf(plan), [[effect.name, effect.payload.filename] for effect in effects], plan.broadReason]
}

/** A plan made in a folder that does not exist: its outcome, each
  effect's name and payload, and the broad reason. */
def wordRow(source: string): any {
  const plan = planFor(source, "/repo")
  const effects: any[] = plan.effects
  return [outcomeOf(plan), [[effect.name, effect.payload] for effect in effects], plan.broadReason]
}

// The parser reads `,`, `@`, and `%` as word characters, and braces that
// bash does not expand, so the rules judge these lines like any other.
node punctuationInWords() {
  return [
    fixtureReadRow("cut -d, -f1 one.txt"),
    fixtureReadRow("sort -k2,2n one.txt"),
    wordRow("git show HEAD@{1}"),
    wordRow("date +%Y"),
    wordRow("echo a{b,c}"),
  ]
}

node readUnderRecommendedNeedsNoPrompt() {
  // The launch directory is the package directory, so the fixtures are
  // inside it and recommended approves std::read there, and it approves
  // git status anywhere. This test has no interruptHandlers entry, so an
  // unanswered interrupt fails the run.
  let found = false
  handle {
    const result = safeBash("wc -l " + FIXTURES + "/one.txt && git status")
    if (result is success(text)) {
      found = text.includes("one.txt")
    }
  } with (intr) {
    if (checkPolicy(recommendedAutoApprovePolicy, intr).type == "approve") {
      return approve()
    }
    return reject()
  }
  return found
}

node readOutsideTheLaunchDirIsUndecided() {
  const plan = planFor("cat /etc/hosts", FIXTURES)
  for (effect in plan.effects) {
    if (effect.name == "std::read") {
      const intr = { effect: effect.name, data: effect.payload }
      return checkPolicy(recommendedAutoApprovePolicy, intr).type
    }
  }
  return "NO READ EFFECT"
}

node readAsksExactlyOneQuestion() {
  // The test file answers one std::read and one std::git::status message.
  // A std::bash prompt, or a second read, would fail the run.
  const result = safeBash("wc -l one.txt && git status", cwd: FIXTURES)
  if (result is failure(why)) {
    return "FAILED: ${why}"
  }
  return result.value.includes("one.txt")
}

node rejectedReadNamesTheTool() {
  const result = safeBash("cat -A one.txt", cwd: FIXTURES)
  if (result is failure(why)) {
    return why
  }
  return "UNEXPECTEDLY RAN"
}

node loneReadIsShellFree() {
  return [
    outcomeOf(planFor("cat one.txt", FIXTURES)),
    outcomeOf(planFor("cat -n one.txt", FIXTURES)),
    outcomeOf(planFor("head -3 one.txt", FIXTURES)),
    outcomeOf(planFor("tail -n 2 one.txt", FIXTURES)),
    outcomeOf(planFor("cat -b one.txt", FIXTURES)),
    outcomeOf(planFor("head -c 5 one.txt", FIXTURES)),
    outcomeOf(planFor("head -n 0 one.txt", FIXTURES)),
    outcomeOf(planFor("cat one.txt two.txt", FIXTURES)),
    outcomeOf(planFor("cat one.txt > copy.txt", FIXTURES)),
    outcomeOf(planFor("cat one.txt | head", FIXTURES)),
    outcomeOf(planFor("wc -l one.txt", FIXTURES)),
    outcomeOf(planFor("cat nope.txt", FIXTURES)),
    outcomeOf(planFor("head -n 1 -n 2 one.txt", FIXTURES)),
    outcomeOf(planFor("head -2 -n 1 one.txt", FIXTURES)),
    outcomeOf(planFor("tail -n 1 -n 2 one.txt", FIXTURES)),
    outcomeOf(planFor("head one.txt two.txt", FIXTURES)),
    outcomeOf(planFor("cat -n one.txt two.txt", FIXTURES)),
  ]
}

/** Files whose line endings test the shell-free rendering, kept apart
 * from FIXTURES so no grep parity row's output changes. */
static const READ_FIXTURES = __dirname + "/stdlib/read-fixtures"

def exactParityOf(source: string, kind: string, cwd: string): any {
  // Without this check, a row whose command fell back to the bash path
  // would compare the real program with itself and pass for no reason.
  if (planFor(source, cwd).execution.kind != kind) {
    return "NOT SHELL-FREE: ${source}"
  }
  let ours = ""
  let theirs = ""
  let failed = ""
  handle {
    const shellFree = safeBash(source, cwd: cwd)
    if (shellFree is success(out)) {
      ours = out
    } else if (shellFree is failure(why)) {
      failed = "${why}"
    }
    // bash returns an ExecResult, not a Result.
    const real = bash(source, cwd: cwd)
    theirs = real.stdout
  } with approve
  // A failure is reported, not compared: a failed run and a program that
  // printed nothing would otherwise both be "".
  if (failed != "") {
    return "FAILED: ${failed}"
  }
  // These commands print in order, so the comparison is exact.
  if (ours == theirs) {
    return true
  }
  return [source, ours, theirs]
}

node shellFreeReadMatchesRealTools() {
  return [
    exactParityOf("cat one.txt", "read", READ_FIXTURES),
    exactParityOf("cat -n one.txt", "read", READ_FIXTURES),
    exactParityOf("head -1 one.txt", "read", READ_FIXTURES),
    exactParityOf("head -n 1 one.txt", "read", READ_FIXTURES),
    exactParityOf("head -n 100 one.txt", "read", READ_FIXTURES),
    exactParityOf("tail -1 one.txt", "read", READ_FIXTURES),
    exactParityOf("tail -n 100 one.txt", "read", READ_FIXTURES),
    exactParityOf("cat noeol.txt", "read", READ_FIXTURES),
    exactParityOf("cat -n noeol.txt", "read", READ_FIXTURES),
    exactParityOf("tail -1 noeol.txt", "read", READ_FIXTURES),
    exactParityOf("cat empty.txt", "read", READ_FIXTURES),
    exactParityOf("cat -n empty.txt", "read", READ_FIXTURES),
    exactParityOf("cat crlf.txt", "read", READ_FIXTURES),
    exactParityOf("tail -1 crlf.txt", "read", READ_FIXTURES),
    exactParityOf("cat one.txt noeol.txt", "read", READ_FIXTURES),
    exactParityOf("cat noeol.txt one.txt", "read", READ_FIXTURES),
    exactParityOf("cat empty.txt one.txt", "read", READ_FIXTURES),
    exactParityOf("cat one.txt one.txt", "read", READ_FIXTURES),
  ]
}

node catOfTwoFilesAsksTwoQuestions() {
  // Two std::read approvals, one per file, and no shell. The plan's kind
  // comes first, because the bash path asks the same two questions and
  // prints the same text; only the kind tells the two apart.
  const kind = planFor("cat one.txt two.txt", FIXTURES).execution.kind
  const result = safeBash("cat one.txt two.txt", cwd: FIXTURES)
  if (result is failure(why)) {
    return "FAILED: ${why}"
  }
  return [kind, result.value]
}

node loneReadAsksOneQuestion() {
  // One std::read approval, and no shell: a std::bash prompt would fail
  // the run, because the test file answers only the read message.
  const result = safeBash("head -1 one.txt", cwd: FIXTURES)
  if (result is failure(why)) {
    return "FAILED: ${why}"
  }
  return result.value
}

/** A folder of its own for the tests that write through bash. */
static const SHELL_FIXTURE = __dirname + "/stdlib/__safebash_shell__"

node ampersandRedirectWritesTheFile() {
  // `&>` is a redirect of both streams in bash. Under dash it would be
  // `echo hi &` and then `> out.txt`, which empties the file and prints to
  // stdout. The test file approves the std::bash question.
  remove(SHELL_FIXTURE) with approve
  mkdir(SHELL_FIXTURE) with approve
  const ran = safeBash("echo hi &> out.txt", cwd: SHELL_FIXTURE)
  const written = read("out.txt", SHELL_FIXTURE) with approve
  remove(SHELL_FIXTURE) with approve
  return match(ran) {
    success(out) => [out, written]
    failure(why) => "FAILED: ${why}"
  }
}

node echoIsTheSameAloneAndInAChain() {
  // bash's echo does not read backslash escapes, alone or in a chain. The
  // lone echo asks nothing; the chain asks std::bash::readonly, which is
  // the one question the test file approves. The trailing `true` keeps
  // the chain on the bash path even when chains of echoes run in process;
  // without it this node would compare the in-process echo with itself.
  const alone = safeBash("echo 'a\\tb'")
  const chain = safeBash("echo 'a\\tb'; echo x; true")
  return [alone, chain]
}

node bashOnlyFormsStayUnparseable() {
  // The parser accepts what bash 3.2 accepts, because macOS ships that
  // version. `|&` and `&>>` are bash 4 forms; 3.2 rejects both with a
  // syntax error, so a parser that accepted them would make a narrow plan
  // fail there. Pinned so a tarsec release cannot widen this unnoticed.
  return [grepNames("make |& tail"), grepNames("echo hi &>> log")]
}

node shellFreeEchoMatchesBash() {
  return [
    exactParityOf("echo hi", "echo", FIXTURES),
    exactParityOf("echo -n hi", "echo", FIXTURES),
    exactParityOf("echo -n", "echo", FIXTURES),
    exactParityOf("echo -nn a b", "echo", FIXTURES),
    exactParityOf("echo 'a\\tb'", "echo", FIXTURES),
  ]
}

def chainSummary(source: string): any {
  const plan = planFor(source, FIXTURES)
  return [outcomeOf(plan), plan.execution.kind, [e.name for e in plan.effects]]
}

node chainsOfInProcessCommands() {
  return [
    chainSummary("echo a; echo b"),
    chainSummary("echo \"=== one ===\"; cat one.txt; echo; echo \"=== two ===\"; cat two.txt"),
    chainSummary("cat one.txt && cat two.txt"),
    chainSummary("grep hello one.txt || echo none"),
    chainSummary("echo a && echo b || echo c"),
    chainSummary("echo a; git status"),
    chainSummary("echo a; true"),
    chainSummary("echo a && (echo b || echo c)"),
    chainSummary("echo a; cat one.txt | head"),
    chainSummary("cat nope.txt; echo hi"),
    chainSummary("echo hi > out.txt; cat out.txt"),
    chainSummary("cat one.txt && shred one.txt"),
    chainSummary("echo a; agency --version"),
  ]
}

node chainMatchesBash() {
  // Every grep here names one file, so no skipped-folders note appears
  // and the comparison can be exact.
  return [
    exactParityOf("echo \"=== one ===\"; cat one.txt; echo; echo \"=== two ===\"; cat two.txt", "chain", FIXTURES),
    exactParityOf("cat one.txt && echo finished", "chain", FIXTURES),
    exactParityOf("grep hello one.txt || echo none", "chain", FIXTURES),
    exactParityOf("grep zzz one.txt || echo none", "chain", FIXTURES),
    exactParityOf("echo a && echo b || echo c", "chain", FIXTURES),
    exactParityOf("cat -n one.txt; cat -n two.txt", "chain", FIXTURES),
  ]
}

/** A folder of its own for the chain test that really writes. */
static const CHAIN_FIXTURE = __dirname + "/stdlib/__safebash_chain__"

def destructiveFlag(result: Result<string>): any {
  if (result is failure) {
    return result.destructiveRan
  }
  return "UNEXPECTEDLY SUCCEEDED"
}

node chainFailureAfterAWriteIsDestructive() {
  remove(CHAIN_FIXTURE) with approve
  mkdir(CHAIN_FIXTURE) with approve
  bash("cp " + FIXTURES + "/one.txt .", cwd: CHAIN_FIXTURE) with approve
  // The write ran, then the grep found nothing. The failure must say a
  // destructive step ran, or the tool loop may retry and write twice.
  const after = safeBash("echo hi > out.txt; grep zzz one.txt", cwd: CHAIN_FIXTURE)
  // Here the grep fails first and && skips the write, so nothing ran.
  const before = safeBash("grep zzz one.txt && echo hi > out.txt", cwd: CHAIN_FIXTURE)
  remove(CHAIN_FIXTURE) with approve
  return [destructiveFlag(after), destructiveFlag(before)]
}

node chainFailsLikeBash() {
  // grep with no match exits 1, so && skips the echo and the chain fails;
  // || runs it and the chain succeeds. Approved by the test file.
  const skipped = safeBash("grep zzz one.txt && echo yes", cwd: FIXTURES)
  const ran = safeBash("grep zzz one.txt || echo no", cwd: FIXTURES)
  return [skipped is failure, ran]
}

node chainOfReadsAsksOnlyTheReads() {
  // The two cats ask std::read each; the echoes ask nothing, and no
  // shell runs.
  const result = safeBash("echo \"=== one ===\"; cat one.txt; echo; echo \"=== two ===\"; cat two.txt", cwd: FIXTURES)
  if (result is failure(why)) {
    return "FAILED: ${why}"
  }
  return result.value
}

/** The folder that holds the two fixture folders. */
static const STDLIB_TESTS = __dirname + "/stdlib"

/** A plan's outcome, and for each effect its name and the last folder of
  the directory its payload names. */
def cdSummary(source: string): any {
  const plan = planFor(source, STDLIB_TESTS)
  let seen: any[] = []
  for (effect in plan.effects) {
    seen.push([effect.name, payloadFolder(effect)])
  }
  return [outcomeOf(plan), seen]
}

def payloadFolder(effect: any): string {
  const payload = effect.payload
  if (payload == null) {
    return ""
  }
  const dir: string = payload.dir ?? payload.cwd ?? ""
  const parts = dir.split("/")
  return parts[parts.length - 1]
}

node cdMovesTheRestOfAnAndChain() {
  return [
    cdSummary("cd grep-fixtures && ls"),
    cdSummary("cd grep-fixtures && cat one.txt"),
    cdSummary("cd grep-fixtures && pnpm test"),
    cdSummary("cd grep-fixtures && ls && cat two.txt"),
    cdSummary("cd grep-fixtures && ls | head"),
    cdSummary("cd ./grep-fixtures/ && ls"),
    cdSummary("ls && cd grep-fixtures && ls"),
    rebuiltEndsWith("cd grep-fixtures && ls", "/stdlib/grep-fixtures' && ls"),
  ]
}

// A `cd` that is a whole command moves every command after it. It runs
// behind a guard, `cd '/abs' || exit 1`, so a later command runs in the
// new folder or not at all.
node cdOnItsOwnLineMovesTheRest() {
  return [
    cdSummary("cd grep-fixtures; ls"),
    cdSummary("cd grep-fixtures\nls\ncat one.txt"),
    cdSummary("ls\ncd grep-fixtures\nls"),
    cdSummary("cd grep-fixtures\nls\ncd ../read-fixtures\nls"),
    cdSummary("cd grep-fixtures\ncd ../read-fixtures\nls"),
    cdSummary("cd grep-fixtures\nls || cat one.txt"),
    cdSummary("cd grep-fixtures; cd ../read-fixtures && ls"),
    cdSummary("cd grep-fixtures\n(cd ../read-fixtures && ls)\nls"),
    cdSummary("cd grep-fixtures\nls\ncd .."),
    rebuiltEndsWith("cd grep-fixtures\nls\ncat one.txt", "/stdlib/grep-fixtures' || exit 1; ls; cat one.txt"),
    rebuiltEndsWith("cd grep-fixtures\nls || cat one.txt", "/stdlib/grep-fixtures' || exit 1; ls || cat one.txt"),
  ]
}

// The rebuilt text holds one `cd`, at the front, and ends with the given
// text. The folder's path differs by machine, so only the end is compared.
// On a mismatch the text itself comes back, so the test output shows it.
def rebuiltEndsWith(source: string, ending: string): any {
  const command: string = executionCommandIn(source, STDLIB_TESTS)
  const oneCd = command.split("cd '/").length == 2
  if (command.startsWith("cd '/") && oneCd && command.endsWith(ending)) {
    return true
  }
  return command
}

// Lines that still ask std::bash: a `cd` that names no folder safeBash
// can resolve, whether it comes first or last, a later command that
// moves again and is not last, a line
// where no command raises an effect, and `cd x && a; b`.
node cdOnItsOwnLineStaysStrict() {
  return [
    cdSummary("cd missing\nls"),
    cdSummary("cd -\nls"),
    cdSummary("cd $HOME\nls"),
    cdSummary("cd grep-fixtures\ncd ../read-fixtures && ls\nls"),
    cdSummary("cd grep-fixtures\necho hi"),
    cdSummary("cd grep-fixtures && ls; cat one.txt"),
    cdSummary("ls\ncd missing"),
  ]
}

node cdAnywhereElseIsBroad() {
  return [
    cdSummary("cd grep-fixtures"),
    cdSummary("cd grep-fixtures || ls"),
    cdSummary("ls && cd grep-fixtures"),
    cdSummary("cd grep-fixtures | ls"),
    cdSummary("cd missing && ls"),
    cdSummary("cd grep-fixtures/one.txt && ls"),
    cdSummary("cd && ls"),
    cdSummary("cd - && ls"),
    cdSummary("cd $HOME && ls"),
    cdSummary("cd grep-fixtures read-fixtures && ls"),
    cdSummary("cd grep-fixtures > out.txt && ls"),
    cdSummary("cd grep-fixtures && cd ../read-fixtures && ls"),
    cdSummary("ls || cd grep-fixtures && ls"),
  ]
}

// The directory after a `cd` is known only inside the `&&` chain that
// holds it. A subshell ends the move, so the command after it is
// classified in the original folder. After `;` or `||` the directory
// depends on whether the `cd` worked, so the string is broad.
node cdDoesNotLeakOutOfItsChain() {
  return [
    cdSummary("(cd grep-fixtures && ls) && ls"),
    cdSummary("(cd grep-fixtures && ls) | head"),
    cdSummary("cd grep-fixtures && ls; ls"),
    cdSummary("cd grep-fixtures && ls || ls"),
    cdSummary("ls; cd grep-fixtures && ls"),
  ]
}

def executionCommandIn(source: string, cwd: string): any {
  return match(planFor(source, cwd).execution) {
    { kind: "bash", command } => command
    _ => "NOT-BASH"
  }
}

/** A folder of its own for the cd tests that need a link and a folder
  whose name starts with a dash. */
static const CD_FIXTURE = __dirname + "/stdlib/__safebash_cd__"

// Two cases where bash, given the word as written, goes somewhere other
// than the folder the payload names. The rebuilt `cd` names the resolved
// folder, so each command is run for real and must print the file in the
// folder its payload named.
//
// `link` points at `real/deep`. Bash applies `..` to the path it came by,
// so `cd link && (cd .. && cat x.txt)` as written reads the `x.txt` beside
// the link. The classifier resolves `..` from the link's target, which is
// `real`.
//
// `cd '-P'` as written is a flag to bash, which then goes to the home
// folder. Unquoted, the parser reads `-P` as a flag, so that form is broad.
node cdGoesWhereThePayloadSays() {
  remove(CD_FIXTURE) with approve
  mkdir(CD_FIXTURE) with approve
  bash("mkdir -p real/deep ./-P && echo beside-link > x.txt && echo beside-target > real/x.txt && echo dash > ./-P/notes.txt && ln -s real/deep link", cwd: CD_FIXTURE) with approve
  const linked = "cd link && (cd .. && cat x.txt)"
  const dashed = "cd '-P' && cat notes.txt"
  const linkedFolder = payloadFolder(planFor(linked, CD_FIXTURE).effects[0])
  const dashedFolder = payloadFolder(planFor(dashed, CD_FIXTURE).effects[0])
  const unquoted = outcomeOf(planFor("cd -P && cat notes.txt", CD_FIXTURE))
  const linkedRan = safeBash(linked, cwd: CD_FIXTURE) with approve
  const dashedRan = safeBash(dashed, cwd: CD_FIXTURE) with approve
  remove(CD_FIXTURE) with approve
  return [linkedFolder, printed(linkedRan), dashedFolder, printed(dashedRan), unquoted]
}

def printed(result: Result<string>): string {
  if (result is failure(why)) {
    return "FAILED: ${why}"
  }
  return result.value.trim()
}

node cdRunsInTheNewFolder() {
  // Approved by the test file: one std::read for one.txt in grep-fixtures.
  const result = safeBash("cd grep-fixtures && cat one.txt | head -1", cwd: STDLIB_TESTS)
  if (result is failure(why)) {
    return "FAILED: ${why}"
  }
  return result.value.trim() != ""
}

node cdOnItsOwnLineRunsInTheNewFolder() {
  // Approved by the test file: one std::read for one.txt in grep-fixtures.
  const result = safeBash("cd grep-fixtures\ncat one.txt | head -1", cwd: STDLIB_TESTS)
  if (result is failure(why)) {
    return "FAILED: ${why}"
  }
  return result.value.trim() == "hello world"
}

// `exit 1` ends the shell the guard runs in, so no command after it runs.
// This holds inside a function, a sourced file, and a subshell. The exit
// code check fails if the host ever adds a command after the script.
node guardEndsTheScript() {
  const result = bash("cd '/no-such-folder-xyz' || exit 1; echo ran", cwd: STDLIB_TESTS) with approve
  return [result.stdout.includes("ran"), result.exitCode]
}

node listingsAskStdLs() {
  return [
    grepNames("ls"),
    grepNames("ls -la ."),
    grepNames("ls -R ."),
    grepNames("ls . .."),
    grepNames("tree -L 2 ."),
    grepNames("du -sh ."),
    grepNames("git log | ls"),
    grepNames("ls one.txt"),
    grepNames("ls -L ."),
    grepNames("ls . -la"),
    grepNames("ls --color=always ."),
    grepNames("tree -L x ."),
    grepNames("ls $D"),
    grepNames("ls *.txt"),
    grepNames("ls -la one.txt"),
    grepNames("ls one.txt two.txt"),
    grepNames("ls one.txt .."),
    grepNames("du -sh one.txt"),
    grepNames("tree one.txt"),
    grepNames("ls -R . ."),
    // ls prints "Not a directory" for a file with a trailing slash. The
    // resolver accepts the path, so this asks std::ls for the folder,
    // which names more than runs: safe, and not a gap.
    grepNames("ls one.txt/"),
  ]
}

node listingOfAMissingPath() {
  // The resolver's message names the absolute path, so only its start is
  // pinned. A missing path whose folder exists has a rule, so this one's
  // folder is missing too.
  const detail = grepNames("ls nodir/nope")[1].detail
  return detail.startsWith("No file or directory at")
}

def lsPayloads(source: string): any {
  // A for loop with an `if` on the name, the shape
  // readPayloadNamesTheRealParent uses, so `payload` narrows to LsPayload.
  let out: any[] = []
  for (effect in planFor(source, FIXTURES).effects) {
    if (effect.name == "std::ls") {
      out.push([effect.payload.dir == FIXTURES, effect.payload.recursive])
    }
  }
  return out
}

node lsPayloadFields() {
  return [
    lsPayloads("ls"),
    lsPayloads("ls -R ."),
    lsPayloads("tree ."),
    lsPayloads("du -s ."),
    lsPayloads("ls -R one.txt"),
    lsPayloads("du one.txt"),
    lsPayloads("ls -R . one.txt"),
  ]
}

/** The folders the std::ls effects of a plan name, joined with `,`. A
 * string, so a row compares with `==`, which is not structural for two
 * arrays. */
def lsDirs(source: string, cwd: string): string {
  let dirs: string[] = []
  for (effect in planFor(source, cwd).effects) {
    if (effect.name == "std::ls") {
      dirs.push(effect.payload.dir)
    }
  }
  return dirs.join(",")
}

/** A folder of its own for the listing symlink test. */
static const LS_LINK_FIXTURE = __dirname + "/stdlib/__safebash_ls_link__"

node listingPayloadNamesTheRealFolder() {
  remove(LS_LINK_FIXTURE) with approve
  mkdir(LS_LINK_FIXTURE) with approve
  bash("mkdir inside outside && ln -s ../outside inside/link", cwd: LS_LINK_FIXTURE) with approve
  let dir = ""
  for (effect in planFor("ls link", LS_LINK_FIXTURE + "/inside").effects) {
    if (effect.name == "std::ls") {
      dir = effect.payload.dir
    }
  }
  remove(LS_LINK_FIXTURE) with approve
  return [dir == LS_LINK_FIXTURE + "/outside"]
}

node listingUnderRecommendedNeedsNoPrompt() {
  // The fixtures are inside the launch directory, so recommended approves
  // std::ls there. No interruptHandlers entry: an unanswered interrupt
  // fails the run.
  let found = false
  handle {
    const result = safeBash("ls " + FIXTURES)
    if (result is success(text)) {
      found = text.includes("one.txt")
    }
  } with (intr) {
    if (checkPolicy(recommendedAutoApprovePolicy, intr).type == "approve") {
      return approve()
    }
    return reject()
  }
  return found
}

node listingOutsideTheLaunchDirIsUndecided() {
  // /etc is a link on macOS, but plain ls follows a folder link operand,
  // so the payload names /private/etc and stays a std::ls question.
  const plan = planFor("ls /etc", FIXTURES)
  for (effect in plan.effects) {
    if (effect.name == "std::ls") {
      const intr = { effect: effect.name, data: effect.payload }
      return checkPolicy(recommendedAutoApprovePolicy, intr).type
    }
  }
  return "NO LS EFFECT"
}

node listingAsksOneQuestion() {
  const result = safeBash("ls -1", cwd: FIXTURES)
