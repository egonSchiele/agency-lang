// The researcher under a scripted model: an answer comes back as written
// after one model call, an empty first answer is asked for again, and two
// empty answers are a failure naming the cause. See
// docs/dev/agents/research-loop.md.
import { researcherAgent } from "std::agents/researcher"

// How many copies of the researcher's persona each model request held,
// in request order. Read by followUpHoldsThePersona.
let personaCounts: number[] = []

callback("onLLMCallStart") as data {
  let copies = 0
  for (msg in data.messages) {
    const content = "${msg.content}"
    if (msg.role == "system" && content.startsWith("You are a research analyst.")) {
      copies = copies + 1
    }
  }
  personaCounts = [...personaCounts, copies]
}

def rejectEverything(intr) {
  return reject()
}

def research(task: string): Result<string> {
  handle {
    return researcherAgent(task: task, maxCost: $1.00, maxTime: 1m)
  } with rejectEverything
}

node emptyFirstAnswerIsAskedAgain(): string {
  const answer = research("what did he study")
  if (answer is failure(err)) {
    return "failed: ${err}"
  }
  return answer.value
}

// A short reply to the follow-up is an answer, not a second empty one.
node shortFollowUpIsAnAnswer(): string {
  const answer = research("what did he study")
  if (answer is failure(err)) {
    return "failed: ${err}"
  }
  return answer.value
}

node twoEmptyAnswersAreAFailure(): string {
  const answer = research("what did he study")
  if (answer is failure(err)) {
    return "failed: ${err}"
  }
  return "answered: ${answer.value}"
}

// One research pass and no second look: the answer is the reply as the
// model wrote it.
node answerIsReturnedAsWritten(): string {
  const answer = research("what is the boiling point of water")
  if (answer is failure(err)) {
    return "failed: ${err}"
  }
  return answer.value
}

// The persona expires with the first model call, so the follow-up pushes
// it again: each request holds it once.
node followUpHoldsThePersona(): string {
  const answer = research("what did he study")
  return personaCounts.join(",")
}

// Three replies cut off by the output limit, each empty, are a failure
// from llm() itself. The researcher passes it on: it does not read it as
// an empty answer and ask again.
node threeCutOffRepliesAreAFailure(): string {
  const answer = research("what did he study")
  if (answer is failure(err)) {
    return "failed: ${err}"
  }
  return "answered: ${answer.value}"
}
