// Recursive Language Model (RLM) — worked example
//
// The RLM idea: instead of feeding a long document straight into the model's
// context window, we store it in an external "environment" (here, a per-run
// global) and let the model read it ONLY through tools. Crucially, the model can
// delegate the reading of large regions to a FRESH sub-LLM (the `query` tool) and
// aggregate distilled answers — so the root model never has to ingest the raw
// text. That recursive sub-LLM call is what separates an RLM from plain retrieval.
//
// Agency fits this well:
//   - `doc` is a module-level global, so it's isolated per agent run (see the
//     execution model guide) — the tools can close over it with no concurrency risk.
//   - `fork` collects branch return values, giving us a native map-reduce for the
//     parallel variant below.

let doc: string = ""   // per-run isolated; the model never receives this directly

// --- Inspection tools: "the context is an environment you query" ---

def docLength(): number {
  """Returns the total number of characters in the document."""
  return doc.length
}

def peek(start: number, end: number): string {
  """Returns the document's characters in the range [start, end). Use SMALL ranges
     to sample the text; do not try to read the whole document this way."""
  return doc.slice(start, end)
}

def find(term: string): number {
  """Returns the first character index where `term` appears in the document, or -1
     if it is absent. Use this to locate regions worth reading."""
  return doc.indexOf(term)
}

// --- The RLM heart: recursive sub-LLM call over a slice ---

def query(start: number, end: number, subQuestion: string): string {
  """Reads the document region [start, end) with a FRESH model and returns only the
     answer to `subQuestion`. Prefer this over `peek` for large regions — it keeps
     the raw text out of your own context."""
  const excerpt = doc.slice(start, end)
  const answer: string = llm(`Excerpt from a document:\n\n${excerpt}\n\nAnswer about this excerpt only: ${subQuestion}`)
  return answer
}

// --- Entry node B: depth-1 delegator ---
// One `llm()` call — Agency runs the whole tool-dispatch loop internally. The model
// decides for itself how much of the document to read and when to delegate.

node answerAboutDocument(document: string, question: string): string {
  doc = document
  const answer: string = llm(
    `You are answering a question about a large document you CANNOT see directly.
It is available only through tools. Use docLength/find to locate relevant regions,
peek to sample small ranges, and query to delegate reading of large regions to a
sub-model. Never assume content you have not inspected.

Question: ${question}`,
    { tools: [docLength, peek, find, query] }
  )
  return answer
}

// --- Entry node C: parallel fork map-reduce ---
// Chunk the document, ask `query` of every chunk in parallel (fork collects the
// returns), then reduce the distilled partials. The root only ever holds the
// partials — never the raw text — which is the "process context larger than the
// window" story.

node answerAboutDocumentMapReduce(document: string, question: string, chunkSize: number): string {
  doc = document

  // Build the list of chunk start offsets.
  let starts: number[] = []
  let s = 0
  while (s < doc.length) {
    starts.push(s)
    s = s + chunkSize
  }

  // MAP: one fresh sub-LLM per chunk, in parallel. `fork` collects the returns.
  const partials = fork(starts) as start {
    return query(start, start + chunkSize, question)
  }

  // REDUCE: combine the distilled partials (raw document text never reaches here).
  let combined = ""
  for (p in partials) {
    combined = combined + "\n---\n" + p
  }
  const final: string = llm(`Partial answers from different sections of a document:\n${combined}\n\nCombine these into one final answer to: ${question}`)
  return final
}

// --- Runnable demo ---
// A long, boring document with a single planted "needle". Running this file calls
// node B, which should locate and return the code without reading everything.

node main() {
  const filler = "This maintenance log records routine facility checks. Nothing of note occurred during the morning inspection. All systems nominal. "
  let document = ""
  let i = 0
  while (i < 40) {
    document = document + filler
    if (i == 27) {
      document = document + "The maintenance override code is 4921. "
    }
    i = i + 1
  }

  const answer = answerAboutDocument(document, "What is the maintenance override code?")
  print(answer)

  // To try the parallel map-reduce variant instead, run:
  //   const answer = answerAboutDocumentMapReduce(document, "What is the maintenance override code?", 500)
}
