/** A plan in the package folder: each effect's name and its ref, or its
 folder relative to the package folder. */
def mappedRow(source: string): any {
  const plan = planFor(source, PACKAGE_DIR)
  const effects: any[] = plan.effects
  return [source, outcomeOf(plan), [[effect.name, effect.payload.ref ?? underPackage(effect.payload.dir ?? effect.payload.cwd)] for effect in effects]]
}

def underPackage(dir: string): string {
  // A git payload names the folder as planFor was given it, unresolved.
  const base = resolve(PACKAGE_DIR)
  if (dir == base || dir == PACKAGE_DIR) {
    return "."
  }
  return dir.split(base + "/").join("")
}

// The git reads that map onto an existing effect, one row per line of the
// plan's table: each asks a question whose payload names what it prints.
node gitMappedReads() {
  return [
    mappedRow("git rev-parse HEAD"),
    mappedRow("git rev-parse --short HEAD"),
    mappedRow("git rev-parse --abbrev-ref HEAD"),
    mappedRow("git rev-parse --show-toplevel"),
    mappedRow("git merge-base HEAD main"),
    mappedRow("git ls-files lib"),
    mappedRow("git ls-files --others --exclude-standard"),
    mappedRow("git grep -n planFor -- lib"),
    mappedRow("git grep -n planFor lib stdlib"),
    mappedRow("git grep -n planFor main -- lib"),
    mappedRow("git grep -n planFor"),
    mappedRow("git worktree list"),
    mappedRow("git worktree list --porcelain"),
    mappedRow("git --no-pager log --oneline -5"),
    mappedRow("git -C lib status"),
    mappedRow("git -C lib -C stdlib status"),
    mappedRow("git log -5 --format=%s"),
    mappedRow("git log --format=\"%h %s\" -3"),
    mappedRow("git show --pretty=fuller HEAD"),
    mappedRow("git log --author=\"Dana X\""),
  ]
}

// The flags before a git subcommand do not hide a destructive one from
// the refuse wall.
node gitLeadingFlagRefusals() {
  return [
    refusedFor("git --no-pager checkout ."),
    refusedFor("git -C sub reset --hard"),
    refusedFor("git -C sub --no-pager clean -fd"),
    refusedFor("git -C sub status"),
    refusedFor("git --no-pager log"),
  ]
}

/* The text a plan in the package folder runs, with that folder's path
 replaced by `<pkg>`. */
def packageCommand(source: string): string {
  return match(planFor(source, PACKAGE_DIR).execution) {
    { kind: "bash", command } => command.split(resolve(PACKAGE_DIR)).join("<pkg>")
    _ => "NOT-BASH"
  }
}

node gitLeadingFlagsRun() {
  return [
    packageCommand("git --no-pager log --oneline -5"),
    packageCommand("git -C lib status"),
    packageCommand("git -C lib diff --stat"),
    packageCommand("git log --format=\"%h %s\" -3"),
    packageCommand("git grep -n x main -- src"),
    packageCommand("git grep -n planFor"),
    packageCommand("git ls-files lib"),
  ]
}

node gitInChains() {
  return [
    gitPlan("git add a.py && git commit -m \"x\""),
    gitPlan("git status | head -5"),
    gitPlan("git log | grep fix"),
    gitPlan("git add a.py && git push"),
  ]
}

node gitRestoreStaged() {
  return [
    gitPlan("git restore --staged a.py"),
    gitPlan("git restore --staged -- a.py"),
    refusedFor("git restore a.py"),
    refusedFor("git restore -- a.py"),
    refusedFor("git restore --staged --worktree a.py"),
    refusedFor("git restore --staged a.py"),
    refusedFor("git restore --staged -- a.py"),
  ]
}

node gitCheckoutRefusals() {
  return [
    refusedFor("git checkout main src/utils.py"),
    refusedFor("git checkout main \"utils.py\""),
    refusedFor("git checkout HEAD~1 ."),
    refusedFor("git checkout -b fix origin/main"),
    refusedFor("git checkout -B fix origin/main"),
    refusedFor("git checkout main"),
    refusedFor("git checkout -b fix"),
  ]
}

// The text each plan runs. safeBash writes a git command itself, so this
// is where the two holes are pinned: a `--` after the one ref of a
// checkout, and a diff behind the repository check with its refs and
// paths on either side of a `--`.
node gitRunsWhatItAsked() {
  return [
    executionCommand("git status"),
    executionCommand("git checkout '*.py'"),
    executionCommandIn("git log one.txt", FIXTURES),
    executionCommand("git diff /dev/null /etc/hosts"),
    executionCommand("git diff main | head -5"),
    planOutcome("git diff -- a.py b.py"),
    gitPlan("git diff > out.patch"),
    executionCommand("git diff > out.patch"),
    outcomeAndNames("git log > /etc/hosts"),
    executionCommand("git log -n5"),
    executionCommand("git log -n 5"),
    executionCommand("git log -5"),
    executionCommand("git log --max-count=5"),
    executionCommand("git commit -am \"x\""),
    executionCommand("git log --author=dana"),
    executionCommand("git commit -m \"it's a fix\""),
    executionCommand("git commit -m \"~/x\""),
    executionCommand("git add '~/x'"),
    executionCommand("git add -- a.py"),
    executionCommand("git stash"),
    executionCommand("git stash push -m wip"),
    executionCommand("git branch --merged main -a"),
    executionCommand("git status --porcelain=v1"),
    executionCommand("git checkout -b fix/x"),
    executionCommand("git switch main"),
  ]
}

def outcomeAndNames(source: string): any {
  const plan = planFor(source, "/repo")
  return [outcomeOf(plan), [effect.name for effect in plan.effects]]
}

// `git branch -v newname` creates a branch, so a listing flag beside a
// name must have no rule.
node gitBranchShapes() {
  return [
    outcomeAndNames("git branch"),
    outcomeAndNames("git branch -v"),
    outcomeAndNames("git branch -a -v"),
    outcomeAndNames("git branch -r"),
    outcomeAndNames("git branch --show-current"),
    outcomeAndNames("git branch -v newname"),
    outcomeAndNames("git branch --list newname"),
    outcomeAndNames("git branch -a newname"),
    outcomeAndNames("git branch --merged"),
    outcomeAndNames("git branch --merged main"),
    outcomeAndNames("git branch --merged main other"),
    outcomeAndNames("git branch -a --merged main"),
    outcomeAndNames("git branch newname"),
    outcomeAndNames("git branch newname start"),
    outcomeAndNames("git branch -d a"),
    outcomeAndNames("git branch --delete a b"),
    outcomeAndNames("git branch -d"),
    outcomeAndNames("git branch -d -v a"),
    outcomeAndNames("git branch -d --merged a"),
    outcomeAndNames("git branch -- newname"),
  ]
}

node gitReadRuns() {
  const result = safeBash("git log -1 --oneline")
  if (result is failure(why)) {
    return "FAILED"
  }
  return result.value.length > 0
}

// Rejected, so nothing runs and the test cannot commit to the repository
// it runs in.
node gitWriteIsAsked() {
  const result = safeBash("git commit -m \"a test commit\"")
  if (isFailure(result)) {
    return result.rejected
  }
  return "UNEXPECTEDLY RAN"
}

/** A repository of its own for the test that runs real git. */
static const GIT_FIXTURE = __dirname + "/stdlib/__safebash_git__"

/** A folder with no repository above it. It has to be outside the
  checkout, because every folder under the checkout has the checkout's
  repository above it. */
static const GIT_NO_REPO = "/tmp/__safebash_git_norepo__"

/** A bare repository: git sees a repository there, and no work tree. */
static const GIT_BARE = __dirname + "/stdlib/__safebash_git_bare__"

static const GIT_MARKER = "MARKER-ONLY-IN-THE-OUTSIDE-FILE"

/** Run a command through safeBash in a folder, after checking the plan
  is narrow. Without that check `with approve` would approve a std::bash
  for the model's own text, and a case would pass while testing nothing. */
def runNarrow(source: string, dir: string): any {
  if (outcomeOf(planFor(source, dir)) != "narrow") {
    return ["NOT-NARROW"]
  }
  const result = safeBash(source, cwd: dir) with approve
  if (result is failure(why)) {
    return ["failure", why]
  }
  return ["success", result.value]
}

def fileText(dir: string, name: string): string {
  const result = bash("cat " + name, cwd: dir) with approve
  return result.stdout
}

// The claims the git rules rest on are claims about git: what it does
// with a `--`, with a path outside the repository, with a pathspec, with
// no repository at all, with a repository that has no work tree. No plan
// test can check those, so this runs the real thing in folders it makes.
node gitRunsSafely() {
  remove(GIT_FIXTURE) with approve
  mkdir(GIT_FIXTURE) with approve
  remove(GIT_NO_REPO) with approve
  mkdir(GIT_NO_REPO) with approve
  remove(GIT_BARE) with approve
  mkdir(GIT_BARE) with approve
  bash("git init -q --bare", cwd: GIT_BARE) with approve
  bash("printf '" + GIT_MARKER + "\\n' > outside.txt", cwd: GIT_NO_REPO) with approve
  const setup = "git init -q -b main && printf 'a = 1\\n' > a.py && printf 'b = 1\\n' > b.py && git add a.py b.py && git -c user.name=Test -c user.email=test@example.com commit -q -m 'Add a and b' && printf 'a = 2\\n' > a.py && printf 'b = 2\\n' > b.py"
  bash(setup, cwd: GIT_FIXTURE) with approve
  const outside = GIT_NO_REPO + "/outside.txt"

  const pathspec = runNarrow("git checkout '*.py'", GIT_FIXTURE)
  const outsideDiff = runNarrow("git diff /dev/null " + outside, GIT_FIXTURE)
  const checkout = runNarrow("git checkout main", GIT_FIXTURE)
  const log = runNarrow("git log --oneline", GIT_FIXTURE)
  const redirected = runNarrow("git diff > out.patch", GIT_FIXTURE)
  const noRepository = runNarrow("git diff /dev/null " + outside, GIT_NO_REPO)
  const bare = runNarrow("git diff /dev/null " + outside, GIT_BARE)
  const gitFolder = runNarrow("git diff /dev/null " + outside, GIT_FIXTURE + "/.git")

  const seen = [
    // The pathspec failed with git's exit code, showed none of the command
    // safeBash built, and changed no file.
    pathspec[0],
    pathspec[1].includes("Command exited with code "),
    pathspec[1].includes("core.fsmonitor"),
    fileText(GIT_FIXTURE, "a.py"),
    fileText(GIT_FIXTURE, "b.py"),
    // A file outside the repository was not printed.
    outsideDiff[0],
    outsideDiff[1].includes(GIT_MARKER),
    checkout[0],
    log[0],
    log[1].includes("Add a and b"),
    redirected[0],
    fileText(GIT_FIXTURE, "out.patch").includes("+a = 2"),
    // With no repository above the folder, the diff did not run.
    noRepository[0],
    noRepository[1].includes("not a git repository"),
    noRepository[1].includes(GIT_MARKER),
    // In a bare repository, and inside a `.git` folder, git sees a
    // repository and no work tree, and the diff did not run either.
    bare[0],
    bare[1].includes("must be run in a work tree"),
    bare[1].includes(GIT_MARKER),
    gitFolder[0],
    gitFolder[1].includes("must be run in a work tree"),
    gitFolder[1].includes(GIT_MARKER),
  ]
  // A repository may track files under a folder the grep tool skips. The
  // exclude pathspecs safeBash writes keep git grep out of it, on this git.
  const tracked = "mkdir dist && printf 'NEEDLE\\n' > dist/x.js && printf 'NEEDLE\\n' > c.py && git add dist/x.js c.py && git -c user.name=Test -c user.email=test@example.com commit -q -m 'Add dist'"
  bash(tracked, cwd: GIT_FIXTURE) with approve
  const gitGrep = runNarrow("git grep -n NEEDLE", GIT_FIXTURE)
  seen.push(gitGrep[0])
  seen.push(gitGrep[1].includes("c.py:1:NEEDLE"))
  seen.push(gitGrep[1].includes("dist/x.js"))
  // From a subfolder, `..` reaches the same `dist`, and the excludes
  // still hold because they are read from the top of the repository.
  bash("mkdir sub && printf 'NEEDLE\\n' > sub/d.py && git add sub/d.py", cwd: GIT_FIXTURE) with approve
  const fromBelow = runNarrow("git grep -n NEEDLE ..", GIT_FIXTURE + "/sub")
  seen.push(fromBelow[0])
  seen.push(fromBelow[1].includes("d.py:1:NEEDLE"))
  seen.push(fromBelow[1].includes("dist/x.js"))
  remove(GIT_FIXTURE) with approve
  remove(GIT_NO_REPO) with approve
  remove(GIT_BARE) with approve
  return seen
}

// ---------------------------------------------------------------------------
// gh
//
// The nodes below go through `planFor` and run nothing. A row that uses
// `cd` plans in STDLIB_TESTS, where `grep-fixtures` exists; every other
// row plans in `/repo`, a folder that does not exist.
// ---------------------------------------------------------------------------

/** A plan's outcome, each effect's name and payload, the text that runs,
  the folders still waiting on a repository lookup, and why it went broad. */
def ghPlan(source: string, cwd: string = "/repo", origin: GhRepo | null = null): any {
  const plan = planFor(source, cwd, origin)
  const effects: any[] = plan.effects
  const text = match(plan.execution) {
    { kind: "bash", command as text } => text
    _ => ""
  }
  return [outcomeOf(plan), [[effect.name, effect.payload] for effect in effects], text, pendingLookups(plan.effects), reasonOf(plan)]
}

/** A plan's outcome and why it went broad. */
def ghBroad(source: string, cwd: string = "/repo"): any {
  const plan = planFor(source, cwd)
  return [outcomeOf(plan), reasonOf(plan)]
}

def reasonOf(plan: Plan): any {
  const reason = plan.broadReason
  if (reason == null) {
    return null
  }
  return [reason.kind, reason.detail]
}

static const AGENCY_LANG: GhRepo = { owner: "egonSchiele", repo: "agency-lang" }

node ghReads() {
  return [
    ghPlan("gh pr view 1451"),
    ghPlan("gh pr view 1451", "/repo", AGENCY_LANG),
    ghPlan("gh pr view 1451 --repo egonSchiele/agency-lang"),
    ghPlan("gh pr view https://github.com/egonSchiele/agency-lang/pull/1451"),
    ghPlan("gh pr view 1451 --repo a/b", "/repo", AGENCY_LANG),
    ghPlan("gh pr view 1 -R github.com/o/r --comments"),
    ghPlan("gh pr view 1 --json title,body"),
    ghPlan("gh pr view 1 --json title,files,reviews,latestReviews,comments,statusCheckRollup"),
    ghPlan("gh pr diff 1 --name-only"),
    ghPlan("gh pr checks 1 --required"),
    ghPlan("gh pr checks 1 --json name,state"),
    ghPlan("gh pr list"),
    ghPlan("gh pr list --state merged --base main --limit 5 --author dana"),
    ghPlan("gh pr list -L 100"),
    ghPlan("gh issue view 7"),
    ghPlan("gh issue view 7 --comments"),
    ghPlan("gh issue view 7 --json title,comments"),
    ghPlan("gh issue list --label bug,urgent --state all"),
    ghPlan("gh search issues crash in:title --repo o/r --limit 10"),
    ghPlan("gh search issues 'crash bug' --repo o/r --state closed --label bug,ui --match title,body --author dana"),
    ghPlan("gh search issues crash --repo o/r --include-prs"),
    ghPlan("gh search issues '~/private' --repo o/r"),
    ghPlan("gh pr diff 1 | head -20"),
  ]
}

// The lookup folder is the real path of the folder the `cd` names, which
// differs between machines, so this row reports whether it ends right.
node ghLookupFollowsCd() {
  const plan = planFor("cd grep-fixtures && gh pr view 1", STDLIB_TESTS)
  const folders = pendingLookups(plan.effects)
  return [outcomeOf(plan), folders.length, folders[0].endsWith("/stdlib/grep-fixtures")]
}

