/*
 * Finding and merging the Claude Code skill folders. The folder nodes build
 * a tree under test-output (git-ignored) and remove it before and after;
 * the merge nodes use made-up scans and touch no files.
 */
import { find, map } from "std::array"
import { mkdir, remove } from "std::fs"
import { ClaudeSkillsScan, SkillCommand } from "std::skills"

import test { loadSkillFrom, loadSkillSources } from "../lib/claudeSkills.agency"
import {
  SkillSource,
  claudeSkillDirs,
  mergeSkillSources,
  projectFolders,
  skillListing,
  skillToolFor,
 } from "../lib/claudeSkills.agency"

def tree(): string {
  return __dirname + "/test-output/claude-skills"
}

def clearTree() {
  remove(tree(), allowedPaths: [__dirname + "/test-output"]) with approve
}

def addSkill(folder: string, name: string): boolean {
  mkdir("${folder}/${name}") with approve
  const written = write("SKILL.md", "---\ndescription: ${name} skill.\n---\n${name} body.\n", dir: "${folder}/${name}") with approve
  return written is success
}

// home has `shared` and `mine`; repo has `.git`, `shared`, and `rootonly`;
// repo/sub has `near`; repo/sub/work has no skills. False when a skill
// file could not be written, so a node fails instead of testing an empty tree.
def buildTree(): boolean {
  clearTree()
  const home = tree() + "/home/.claude/skills"
  mkdir(tree() + "/repo/.git") with approve
  mkdir(tree() + "/repo/sub/work") with approve
  const written = [
    addSkill(home, "shared"),
    addSkill(home, "mine"),
    addSkill(tree() + "/repo/.claude/skills", "shared"),
    addSkill(tree() + "/repo/.claude/skills", "rootonly"),
    addSkill(tree() + "/repo/sub/.claude/skills", "near"),
  ]
  return !written.includes(false)
}

def entry(name: string): any {
  return {
    name: name,
    description: "",
    location: "${name}/SKILL.md"
  }
}

def command(name: string): SkillCommand {
  return {
    name: name,
    description: "",
    argHint: "",
    body: ""
  }
}

def source(label: "personal" | "project", dir: string, names: string[], entryNames: string[], commandNames: string[]): SkillSource {
  const scan: ClaudeSkillsScan = {
    dir: dir,
    names: names,
    entries: map(entryNames, \name -> entry(name)),
    commands: map(commandNames, \name -> command(name))
  }
  return {
    label: label,
    scan: scan
  }
}

def entryCount(sources: SkillSource[], name: string): number {
  let count = 0
  for (src in sources) {
    for (item in src.scan.entries) {
      if (item.name == name) {
        count = count + 1
      }
    }
  }
  return count
}

def commandCount(sources: SkillSource[], name: string): number {
  let count = 0
  for (src in sources) {
    for (item in src.scan.commands) {
      if (item.name == name) {
        count = count + 1
      }
    }
  }
  return count
}

node projectFoldersNearestFirst(): boolean {
  return JSON.stringify(projectFolders("/r/s/w", ["/r", "/r/s"])) == JSON.stringify(["/r/s/w", "/r/s", "/r"])
}

node outsideARepoReadsOnlyTheStart(): boolean {
  return JSON.stringify(projectFolders("/a/b", null)) == JSON.stringify(["/a/b"])
}

node atTheRepoRootReadsOnlyIt(): boolean {
  return JSON.stringify(projectFolders("/r", [])) == JSON.stringify(["/r"])
}

node walksUpToTheRepoRoot(): boolean {
  if (!buildTree()) {
    return false
  }
  const repo = tree() + "/repo"
  const dirs = claudeSkillDirs(repo + "/sub/work", tree() + "/home")
  clearTree()
  const projectDirs = [d.dir for d in dirs if d.label == "project"]
  return JSON.stringify(projectDirs) == JSON.stringify([repo + "/sub/.claude/skills", repo + "/.claude/skills"])
}

node personalFolderComesFirst(): boolean {
  if (!buildTree()) {
    return false
  }
  const home = tree() + "/home"
  const dirs = claudeSkillDirs(tree() + "/repo/sub/work", home)
  clearTree()
  return dirs[0].label == "personal" && dirs[0].dir == home + "/.claude/skills"
}

node personalWinsOnASharedName(): boolean {
  if (!buildTree()) {
    return false
  }
  const sources = loadSkillSources(tree() + "/repo/sub/work", tree() + "/home")
  clearTree()
  const personal = find(sources, \src -> src.label == "personal")
  if (personal == null) {
    return false
  }
  const inPersonal = find(personal.scan.entries, \item -> item.name == "shared")
  return entryCount(sources, "shared") == 1 && inPersonal != null
}

node manualOnlyWinnerHidesTheEntry(): boolean {
  const merged = mergeSkillSources([
    source("personal", "/h/.claude/skills", ["deploy"], [], ["deploy"]),
    source("project", "/p/.claude/skills", ["deploy"], ["deploy"], ["deploy"]),
  ])
  return entryCount(merged, "deploy") == 0
      && commandCount(merged, "deploy") == 1
      && commandCount([merged[0]], "deploy") == 1
}

node modelOnlyWinnerHidesTheCommand(): boolean {
  const merged = mergeSkillSources([
    source("personal", "/h/.claude/skills", ["deploy"], ["deploy"], []),
    source("project", "/p/.claude/skills", ["deploy"], ["deploy"], ["deploy"]),
  ])
  return commandCount(merged, "deploy") == 0 && entryCount(merged, "deploy") == 1
}

node outerRejectStopsTheScans(): boolean {
  if (!buildTree()) {
    return false
  }
  let sources: SkillSource[] = []
  handle {
    sources = loadSkillSources(tree() + "/repo/sub/work", tree() + "/home")
  } with reject
  clearTree()
  return sources.length == 0
}

node homeAsProjectIsReadOnce(): boolean {
  const merged = mergeSkillSources([
    source("personal", "/h/.claude/skills", ["a"], ["a"], ["a"]),
    source("project", "/h/.claude/skills", ["a"], ["a"], ["a"]),
  ])
  return merged.length == 1 && merged[0].label == "personal"
}

def described(name: string, description: string): any {
  return {
    name: name,
    description: description,
    location: "${name}/SKILL.md"
  }
}

def twoSources(): SkillSource[] {
  return [
    {
      label: "personal",
      scan: {
        dir: "/h/.claude/skills",
        names: ["alpha"],
        entries: [described("alpha", "the first skill, 20c")],
        commands: []
      }
    },
    {
      label: "project",
      scan: {
        dir: "/p/.claude/skills",
        names: ["beta"],
        entries: [described("beta", "the second skill 20c")],
        commands: []
      }
    },
  ]
}

node listingHasEverySkillInOrder(): boolean {
  const listing = skillListing(twoSources(), 1000)
  const alpha = listing.indexOf("- alpha: the first skill, 20c")
  const beta = listing.indexOf("- beta: the second skill 20c")
  return alpha != -1 && beta > alpha
}

// The lines are 30 and 29 characters with their newlines. Under a budget
// of 40 only the first keeps its description.
node listingDropsTheLastDescriptionsFirst(): boolean {
  const listing = skillListing(twoSources(), 40)
  return listing.includes("- alpha: the first skill, 20c") && listing.includes("- beta\n") && !listing.includes("- beta:")
}

node listingKeepsEveryNameOverBudget(): boolean {
  const listing = skillListing(twoSources(), 1)
  return listing.includes("- alpha\n") && listing.includes("- beta\n") && !listing.includes("20c")
}

node oneToolNamedSkill(): boolean {
  const tools = skillToolFor(twoSources())
  return tools.length == 1 && "${tools[0].name}" == "skill"
}

node noSkillsNoTool(): boolean {
  const empty: SkillSource[] = [
    source("personal", "/h/.claude/skills", ["a"], [], ["a"]),
  ]
  return skillToolFor(empty).length == 0
}

node loadsASkillByName(): boolean {
  if (!buildTree()) {
    return false
  }
  const sources = loadSkillSources(tree() + "/repo/sub/work", tree() + "/home")
  const loaded = loadSkillFrom(sources, "mine", "SKILL.md") with approve
  clearTree()
  if (loaded is failure) {
    return false
  }
  return loaded.value.includes("mine body.") && loaded.value.startsWith("Base directory for this skill: ")
}

node loadsAFileTheSkillLinksTo(): boolean {
  if (!buildTree()) {
    return false
  }
  write("notes.md", "Linked notes.", dir: tree() + "/home/.claude/skills/mine") with approve
  const sources = loadSkillSources(tree() + "/repo/sub/work", tree() + "/home")
  const loaded = loadSkillFrom(sources, "mine", "notes.md") with approve
  const escaped = loadSkillFrom(sources, "mine", "../shared/SKILL.md") with approve
  clearTree()
  return loaded is success && loaded.value == "Linked notes." && escaped is failure
}

node unknownSkillIsAFailure(): boolean {
  const loaded = loadSkillFrom(twoSources(), "nope", "SKILL.md") with approve
  return loaded is failure && loaded.error.includes("nope")
}
