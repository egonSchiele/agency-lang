import { githubAgent } from "std::agents/github"
import { hostedSearchTools, searchTools } from "std::agents/lib/search"
import { AGENT_SPILL_OVER, llmOptions, withContext } from "std::agents/lib/shared"
import {
  codingFileAndShellTools,
  memoryTools,
  webTools,
  ASK_USER_HINT,
  PROGRESS_NOTE,
  SAVE_DRAFT_HINT,
 } from "std::agents/lib/toolkits"
import { guarded } from "std::decorators"
import { setAgentCwd, getAgentCwd } from "std::index"
import { agentSkill } from "std::skills"
import { systemMessage } from "std::thread"

import { communicationTools } from "./lib/toolkits.agency"

/** @module
@summary Write, edit, and run code to complete a task on disk.

The returned string summarizes the work. Files and other effects are the
deliverable. Use `verifierAgent` afterwards to check the result against the
task, or `std::agents/agency/coding` to generate Agency source as text.

```ts
import { codingAgent } from "std::agents/coding"

node main() {
  const result = codingAgent("Create a CSV report in report.csv")
  print(result)
}
```

When called as an LLM tool, `codingAgent` continues the caller's conversation.
From code, wrap the call in `thread { ... }` to keep its messages out of the
current thread. GitHub work goes through `githubAgent`, which it carries as a
tool.

The model reports progress in a sentence beside each tool call, and
nothing prints it by default. `std::agents/lib/toolkits` shows the
callback that does.
*/

// Kept short on purpose. Read docs/dev/agents/coding-agent.md before adding a rule.
// The four rules are copied in the agent's minimal brain
// (lib/agents/agency-agent/brains/minimal/minimal.agency); change the two together.
static const systemPrompt = """You are a coding assistant. Help users inspect files, run commands, and modify code.

- Use read to examine files instead of cat or sed.
- Use edit for targeted changes. Batch changes to one file in a single call.
- Use write only for new files or complete rewrites.
- Be concise in your responses.

## Communicating with the user
${PROGRESS_NOTE}${ASK_USER_HINT}${SAVE_DRAFT_HINT}
"""

static const skills = agentSkill("coding")

export def buildTools(): any[] {
  """
  Return the coding agent's built-in tools for inspection or extension.
  """
  return [
    setAgentCwd,
    getAgentCwd,
    ...codingFileAndShellTools(),
    githubAgent,
    ...memoryTools(),
    ...webTools(),
    ...searchTools(),
    ...communicationTools(),
    skills,
  ]
}

def solve(
  task: string,
  context: string,
  model: string,
  provider: string,
  extraTools: any[],
): string {
  systemMessage(systemPrompt, expires: "llmCall")
  return llm(
    withContext(task: task, context: context),
    llmOptions(
    model: model,
    provider: provider,
    tools: [...buildTools(), ...extraTools, saveDraft],
    spillToolResultsOver: AGENT_SPILL_OVER,
    hostedTools: hostedSearchTools(model, provider),
  ),
  )
}

/** Called from code, this runs on the caller's thread like any function:
  the tool results and the answer stay there, and the system prompt is
  removed when the agent finishes. Wrap the call in `thread { ... }` to
  keep them apart. */
@guarded(cost: maxCost, time: maxTime)
export handoff def codingAgent(
  task: string,
  context: string = "",
  maxCost: number = $50.00,
  maxTime: number = 30m,
  model: string = "",
  provider: string = "",
  extraTools: any[] = [],
): Result<string> {
  """
  Write, edit, and run code to complete a task on disk. Returns a short
  summary; the real output is filesystem side effects. It continues your
  conversation, so it already sees the work above.

  @param task - What to accomplish
  @param context - Extra material folded into the prompt, or ""
  @param maxCost - Cost budget in USD.
  @param maxTime - Time budget in milliseconds.
  @param model - Model override, or "" for the ambient model
  @param provider - Provider for the model override, ignored when model is empty.
  @param extraTools - Extra tools to offer the LLM, appended to the built-in set
  """

  // Return position: a draft the model saved reaches the guard, which
  // returns it as the backup answer if the budget runs out.
  return solve(
    task: task,
    context: context,
    model: model,
    provider: provider,
    extraTools: extraTools,
  )
}
