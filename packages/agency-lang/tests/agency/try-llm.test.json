    {
      "nodeName": "toolInterruptSurfaces",
      "description": "return try llm(...) in a def: an interrupt raised by a tool the model calls comes out of the def, and after approval the reply comes back",
      "input": "",
      "useTestLLMProvider": true,
      "llmMocks": [
        {
          "toolCall": {
            "name": "lookUp",
            "args": {
              "topic": "whales"
            }
          }
        },
        {
          "return": "Whales are large."
        }
      ],
      "interruptHandlers": [
        {
          "action": "approve",
          "expectedMessage": "Look this up?"
        }
      ],
      "expectedOutput": "\"Whales are large.\"",
      "evaluationCriteria": [
        {
          "type": "exact"
        }
      ]
    },
