// A destructive def commits at entry, so its failure reports that destructive
// work already ran. runPrompt tells the model this tool can no longer be
// called and drops it, so the next round answers without it.

destructive def alwaysFail(): Result<string> {
  return failure("permanent failure")
}

type Resp = {
  msg: string
}

node main() {
  const result: Resp = llm("Call alwaysFail. If its error says the tool can no longer be called, put exactly the string 'tool-removed' in the msg field. Do not try the tool again.", {
    tools: [alwaysFail]
  })
  return result.msg
}
