// Two fork arms. The "quiet" arm sits inside `handle { ... } with approve`
// for 400ms. The "asker" arm waits 100ms, so that handler is surely
// registered, and then raises with no handler of its own. The sibling's
// approval must not answer it: the interrupt reaches the host, which
// rejects it. If handlers leaked across branches, the asker would read
// "asker: approved".
def quiet(): string {
  handle {
    sleep(400)
    return "quiet done"
  } with approve
}

def risky(): string {
  sleep(100)
  return interrupt("asker asks")
  return "approved"
}

node main() {
  const results = fork(["quiet", "asker"]) as tag {
    if (tag == "quiet") {
      return quiet()
    }
    const answer = risky()
    if (isFailure(answer)) {
      return "asker: rejected"
    }
    return "asker: ${answer}"
  }
  return results
}
