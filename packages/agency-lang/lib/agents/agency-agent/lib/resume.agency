/** @module
  @summary The terminal's side of save and resume: which session this run
  is (new, `--continue`, or `--resume`), the picker, and the restore. The
  record itself is in record.agency, the files in sessions.agency and the
  title in sessionTitle.agency.
*/
import { _exit } from "agency-lang/stdlib-lib/system.js"
import { _printAgentTrace } from "agency-lang/stdlib-lib/agentToolTrace.js"
import { now } from "std::date"
import { cwd } from "std::system"
import { chooseOption, ChoiceItem } from "std::ui/cli"

import { _readTranscript } from "agency-lang/stdlib-lib/agentSessions.js"

import { recordTurn, setCurrentRecord } from "./record.agency"
import {
  SessionRecord,
  findSession,
  isAnotherFrontEndsSession,
  listSessions,
  mostRecentSession,
  newSessionId,
  readCheckpointFile,
  saveSession,
  sessionLabel,
 } from "./sessions.agency"
import { showTranscript } from "./transcript.agency"

export def incognitoProblem(continueFlag: boolean, resumeArg: string | null, logging: boolean): string {
  """
  Why an --incognito run cannot start, or "" when it can.

  @param continueFlag - Whether --continue was passed
  @param resumeArg - The --resume value, or null when absent
  @param logging - Whether this run's statelog records anything
  """
  if (continueFlag || resumeArg != null) {
    return "--incognito sessions are not saved, so they cannot continue or resume one."
  }
  // The launcher turns logging off. An agent started another way keeps
  // the logging it was built with, and the header would be wrong.
  if (logging) {
    return "--incognito needs logging off, and this run has it on. Start it with agency agent --incognito."
  }
  return ""
}

/** Which saved session, if any, this run continues. `resumeArg` is the
  `--resume` value: null when absent, "" for a bare `--resume` (open the
  picker), else an id. Exits on an unknown id. */
export def chooseSession(
  continueFlag: boolean,
  resumeArg: string | null,
): SessionRecord | null {
  if (resumeArg != null && resumeArg != "") {
    const found = findSession(resumeArg)
    if (found == null && isAnotherFrontEndsSession(resumeArg)) {
      print(color.red("Session ${resumeArg} was saved by another app and can't be opened here yet."))
      _exit(1)
    }
    if (found == null) {
      print(color.red("No saved session with id ${resumeArg} in ${cwd()}."))
      _exit(1)
    }
    return found
  }
  if (resumeArg == "") {
    return pickSession()
  }
  if (continueFlag) {
    const recent = mostRecentSession()
    if (recent == null) {
      print(color.yellow("No saved session for this directory; starting a new one."))
    }
    return recent
  }
  return null
}

def pickSession(): SessionRecord | null {
  const all = listSessions()
  if (all.length == 0) {
    print(color.yellow("No saved sessions for this directory; starting a new one."))
    return null
  }
  const nowMs = now()
  // A "new session" row rather than allowCancel: before the REPL exists,
  // Escape raises a cancellation instead of returning "".
  let items: ChoiceItem[] = [
    {
    key: "new",
    label: "Start a new session"
  },
  ]
  for (record in all) {
    items.push({
      key: record.id,
      label: sessionLabel(record, nowMs)
    })
  }
  const choice = chooseOption(
    "Resume a session",
    "Pick a saved session from this directory.",
    items,
  )
  if (choice == "new") {
    return null
  }
  return findSession(choice)
}

/** Start this run's session. A new one gets a fresh record. A saved one
  is restored right here: the Agency execution state becomes the saved
  one and the program continues from the saved point. The saved
  conversation is printed before the restore, since nothing after
  `restore` runs. */
export def startSession(chosen: SessionRecord | null, brainName: string) {
  if (chosen == null) {
    const t = now()
    setCurrentRecord({
      id: newSessionId(),
      cwd: cwd(),
      brain: brainName,
      created: t,
      lastActive: t,
      turns: 0,
      title: ""
    })
    return
  }
  const cp = readCheckpointFile(chosen.id)
  if (cp == null) {
    print(color.red("The checkpoint file for session ${chosen.id} is missing or malformed."))
    _exit(1)
  }
  print(color.dim("Resuming: ${chosen.title}"))
  showTranscript(_readTranscript(cp, chosen.conversationThread ?? ""))
  restore(cp, {})
}

/** Save after the `-i` seed turn, which runs before the REPL. This is
  Agency code with no REPL frame above it, so on resume execution
  continues at the line after `checkpoint()` and then starts the REPL. */
export def saveSeedTurn(userMsg: string) {
  const target = recordTurn(userMsg)
  if (target == null) {
    return
  }
  const id = checkpoint()
  const saved = saveSession(target.record, getCheckpoint(id))
  if (isFailure(saved)) {
    _printAgentTrace({ kind: "sessionSaveFailure", message: saved.error })
  }
}
