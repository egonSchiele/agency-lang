import { hostedSearchTools } from "std::agents/lib/search"
import { AGENT_SPILL_OVER, llmOptions, withContext } from "std::agents/lib/shared"
import {
  writableFileTools,
  shellTools,
  gitTools,
  githubTools,
  agencyCodeTools,
  memoryTools,
  agencyDocTools,
  planningTools,
  webTools,
  ASK_USER_HINT,
 } from "std::agents/lib/toolkits"
import { guarded } from "std::decorators"
import { setAgentCwd, getAgentCwd } from "std::index"
import { agentSkill } from "std::skills"
import { systemMessage, threadIsNew } from "std::thread"

import { communicationTools } from "./lib/toolkits.agency"

/** @module
@summary Write, edit, and run code to complete a task on disk.

The returned string summarizes the work. Files and other effects are the
deliverable. Use `verifierAgent` afterwards to check the result against the
task, or `std::agents/agency/coding` to generate Agency source as text.

```ts
import { codingAgent } from "std::agents/coding"

node main() {
  const result = codingAgent("Create a CSV report in report.csv")
  print(result)
}
```
*/

static const systemPrompt = """Complete the task by writing and running code with your tools.

- Produce the requested artifact on disk and exercise it. Report only
  results you actually obtained from tools.
- Follow the exact output requirements, including paths, formats, fields,
  whitespace, and trailing newlines.
- When an exact check decides success, identify ambiguous requirements
  and check each reasonable reading. Finish once the checks pass.
  Repeat a check only after a change, failure, or unresolved concern.
- A malformed tool argument does not move or delete files. Correct the
  argument and retry.
- Save progress with `saveDraft` after meaningful steps: files written,
  checks run, and work remaining. A budget stop returns the latest draft.
- For tasks with more than two steps, use `todoWrite` to track the work
  and update it as each step finishes.
- Use web search when the task needs current or external information.

Prefer the specialized tools over `safeBash` and `exec`. Use command
execution when the other tools cannot do the job. Commands may need
human approval, which may be unavailable in a non-interactive run.
If a required permission is rejected, stop and report which permission
is missing. Do not seek a workaround for the rejection.

Use `whatIAmDoing` to keep the user informed as you work.${ASK_USER_HINT}
"""

static const finalizeReminder = "Before finishing, re-read the task's exact output requirements (filename, format, fields, whitespace, trailing newline) and confirm the artifact on disk matches them exactly."

static const skills = agentSkill("coding")

export def buildTools(): any[] {
  """
  Return the coding agent's built-in tools for inspection or extension.
  """
  return [
    setAgentCwd,
    getAgentCwd,
    ...writableFileTools(),
    ...shellTools(),
    ...gitTools(),
    ...githubTools(),
    ...agencyCodeTools(),
    ...memoryTools(),
    ...agencyDocTools(),
    ...planningTools(),
    ...webTools(),
    ...communicationTools(),
    skills,
  ]
}

def solve(
  task: string,
  context: string,
  model: string,
  provider: string,
  extraTools: any[],
): string {
  if (threadIsNew()) {
    systemMessage(systemPrompt)
  }
  const prompt = """
${withContext(task: task, context: context)}

${finalizeReminder}
"""
  return llm(
    prompt,
    llmOptions(
    model: model,
    provider: provider,
    tools: [...buildTools(), ...extraTools, saveDraft],
    spillToolResultsOver: AGENT_SPILL_OVER,
    hostedTools: hostedSearchTools(model, provider),
  ),
  )
}

@guarded(cost: maxCost, time: maxTime)
export def codingAgent(
  task: string,
  context: string = "",
  maxCost: number = $50.00,
  maxTime: number = 30m,
  model: string = "",
  provider: string = "",
  session: string = "",
  extraTools: any[] = [],
): Result<string> {
  """
  Write, edit, and run code to complete a task on disk. Returns a short
  summary; the real output is filesystem side effects.

  @param task - What to accomplish
  @param context - Extra material folded into the prompt, or ""
  @param maxCost - Cost budget in USD.
  @param maxTime - Time budget in milliseconds.
  @param model - Model override, or "" for the ambient model
  @param provider - Provider for the model override, ignored when model is empty.
  @param session - Session name to share a thread across calls, or "" for isolated
  @param extraTools - Extra tools to offer the LLM, appended to the built-in set
  """

  thread(label: "codingAgent", session: session) {
    return solve(
      task: task,
      context: context,
      model: model,
      provider: provider,
      extraTools: extraTools,
    )
  }
}
