/*
 * Tests for planModels' provider-routing rule: OpenAI is always promoted to
 * the Responses API (both fast and slow) so hosted web_search works on the
 * agent's default models. Other providers are unchanged.
 */
import {
  planModels,
  resolveDetected,
  ModelPlan,
  parseModelSpec,
  ModelSpec,
  priceDefault,
  Resolved,
  parseModelFlag,
  knownProviders,
  providerForModel,
  takesSlashModelNames,
 } from "../lib/models.agency"

static const KNOWN = ["openai", "anthropic", "google", "openrouter", "litellm"]

def unwrapResolved(result: Result<Resolved>): Resolved {
  if (isFailure(result)) {
    return {
      model: "ERR",
      provider: "ERR",
      via: "ERR"
    }
  }
  return result.value
}

node openaiDetectedRoutesBothToResponses(): ModelPlan {
  return planModels("", "", "", "", "openai")
}

node anthropicDetectedKeepsNative(): ModelPlan {
  return planModels("", "", "", "", "anthropic")
}

node explicitOpenaiModelStillRoutedThroughResponses(): ModelPlan {
  return planModels("gpt-4o", "", "", "openai", "openai")
}

// `--provider openrouter` alone resolves to the baked open-model defaults,
// both routed through the openrouter provider (no Responses promotion).
node openrouterDetectedUsesDefaults(): ModelPlan {
  return planModels("", "", "", "openrouter", "openrouter")
}

// litellm has no built-in defaults (deployment-specific model names), so
// `--provider litellm` with no model is an error — caught before any env
// read, so this is deterministic regardless of LITELLM_* env vars.
node litellmWithoutModelIsError(): boolean {
  const r = resolveDetected("", "", "", "litellm")
  if (r is failure(f)) {
    return true
  }
  return false
}

node specSplitOnKnownProvider(): ModelSpec {
  return parseModelSpec("anthropic/claude-opus-4-8", false, KNOWN)
}

node specOpenrouterMultiSegment(): ModelSpec {
  return parseModelSpec("openrouter/deepseek/deepseek-r1", false, KNOWN)
}

node specProviderEstablishedNoSplit(): ModelSpec {
  return parseModelSpec("deepseek/deepseek-r1", true, KNOWN)
}

node specBareModel(): ModelSpec {
  return parseModelSpec("gpt-5.5", false, KNOWN)
}

node specUnknownPrefixNoSplit(): ModelSpec {
  return parseModelSpec("unknown-vendor/some-model", false, KNOWN)
}

node priceMainAnthropic(): Resolved {
  return unwrapResolved(priceDefault("anthropic", "main", "standard"))
}

node priceReasoningAnthropic(): Resolved {
  return unwrapResolved(priceDefault("anthropic", "reasoning", "standard"))
}

node priceMainOpenaiPromoted(): Resolved {
  return unwrapResolved(priceDefault("openai", "main", "standard"))
}

node priceEmbeddingDerived(): Resolved {
  return unwrapResolved(priceDefault("anthropic", "embedding", "standard"))
}

node priceUnknownProviderFails(): boolean {
  return isFailure(priceDefault("litellm", "main", "standard"))
}

node modelFlagPerSlot(): { slot: string; model: string } {
  return parseModelFlag("reasoning=claude-opus-4-8")
}

node modelFlagGlobal(): { slot: string; model: string } {
  return parseModelFlag("gpt-5.5")
}

node modelFlagAliasFast(): { slot: string; model: string } {
  return parseModelFlag("fast=gpt-4o")
}

node modelFlagUnifiedNoMissplit(): { slot: string; model: string } {
  return parseModelFlag("anthropic/claude-opus-4-8")
}


// The local providers are known, so an embedding slot can name mlx/<model>.
node localProvidersAreKnown(): string {
  const known = knownProviders()
  return "${known.includes("mlx")}/${known.includes("llama-cpp")}"
}

node embeddingSpecWithLocalProvider(): ModelSpec {
  return parseModelSpec("mlx/mlx-community/Qwen3-Embedding-4B-4bit-DWQ", false, knownProviders())
}

// With no --provider, a model named by a flag picks the provider that
// serves it. resolveDetected checks that provider's key, so the cases
// that depend on keys are in tests/agency-js/llm-provider-defaults.
node bareModelUsesCatalogProvider(): string {
  return providerForModel("claude-sonnet-5-5")
}

node providerPrefixWins(): string {
  return providerForModel("openrouter/anthropic/claude-sonnet-5-5")
}

node openaiModelStaysOpenai(): string {
  return providerForModel("gpt-5.5")
}

// The catalog lists this one under "openai-responses".
node responsesOnlyModelGetsThePublicName(): string {
  return providerForModel("gpt-5.5-pro")
}

node uncatalogedModelHasNoProvider(): string {
  return providerForModel("my-private-finetune")
}

// The fallback reads no key, so this does not depend on the environment.
node uncatalogedModelFallsBackToOpenai(): string {
  const r = resolveDetected("my-private-finetune", "", "", "")
  if (r is failure(f)) {
    return "ERR"
  }
  return r.value
}

// Which providers' own model names can hold a `/`.
node slashModelNamesByProvider(): Record<string, boolean> {
  return {
    anthropic: takesSlashModelNames("anthropic"),
    openai: takesSlashModelNames("openai"),
    google: takesSlashModelNames("google"),
    openrouter: takesSlashModelNames("openrouter"),
    litellm: takesSlashModelNames("litellm"),
    mlx: takesSlashModelNames("mlx")
  }
}
