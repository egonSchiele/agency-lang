// Checks that a per-call options object reaches the LLM client. maxTokens has
// to be roomy: a reasoning model spends the same budget on thinking, so a
// small one leaves no visible output to validate.
node main() {
  const result: number = llm("What is 2 + 2? Return just the number.", {
    maxTokens: 2000
  })
  return result
}
