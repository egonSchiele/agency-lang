import { keys } from "std::object"
import { buildScopedMatch, ScopedField, ScopedRuleFields } from "std::policy"

node main() {
  const fields: ScopedRuleFields = {
    "std::read": [{ field: "dir", matchSubpaths: true }],
    "std::exec": [
      { field: "command", matchSubpaths: false },
      { field: "subcommand", matchSubpaths: false },
    ],
  }
  const readIntr = {
    effect: "std::read",
    data: { dir: "/Users/x/project", filename: "foo.ts" }
  }
  const m1 = buildScopedMatch(readIntr, fields)
  // matchSubpaths brace-expands the value
  if (m1.dir != "{/Users/x/project,/Users/x/project/**}") {
    return "FAIL: brace-expansion wrong, got ${m1.dir}"
  }

  const execIntr = {
    effect: "std::exec",
    data: { command: "git", subcommand: "log", args: ["log"] }
  }
  const m2 = buildScopedMatch(execIntr, fields)
  if (m2.command != "git") { return "FAIL: command not pinned" }
  if (m2.subcommand != "log") { return "FAIL: subcommand not pinned" }

  // Kind not in the fields map → empty match
  const otherIntr = { effect: "myapp::deploy", data: { env: "prod" } }
  const m3 = buildScopedMatch(otherIntr, fields)
  if (keys(m3).length != 0) { return "FAIL: should be empty for unknown kind" }

  // mcp::call pins server+tool and EXCLUDES the nested per-call args object, so
  // an "always" rule keeps matching later calls with different args.
  const mcpFields: ScopedRuleFields = {
    "mcp::call": [
      { field: "server", matchSubpaths: false },
      { field: "tool", matchSubpaths: false },
    ],
  }
  const mcpIntr = {
    effect: "mcp::call",
    data: { server: "fs", tool: "read_file", args: { path: "/tmp/a" } }
  }
  const m4 = buildScopedMatch(mcpIntr, mcpFields)
  if (m4.server != "fs") { return "FAIL: mcp server not pinned" }
  if (m4.tool != "read_file") { return "FAIL: mcp tool not pinned" }
  if (keys(m4).length != 2) { return "FAIL: mcp match should be server+tool only, not args" }

  // Values are escaped: a rule generated from "ls *.md" must not be a glob.
  const bashFields: ScopedRuleFields = {
    "std::bash": [
      { field: "command", matchSubpaths: false },
      { field: "cwd", matchSubpaths: false },
    ],
  }
  const bashIntr = { effect: "std::bash", data: { command: "ls *.md", cwd: "/tmp/{a,b}" } }
  const m5 = buildScopedMatch(bashIntr, bashFields)
  if (m5.command != "ls \\*.md") { return "FAIL: command not escaped, got ${m5.command}" }
  if (m5.cwd != "/tmp/\\{a\\,b\\}") { return "FAIL: cwd not escaped, got ${m5.cwd}" }

  // Subpath values are escaped inside the brace expansion.
  const readIntr2 = { effect: "std::read", data: { dir: "/u/[x]", filename: "f" } }
  const m6 = buildScopedMatch(readIntr2, fields)
  if (m6.dir != "{/u/\\[x\\],/u/\\[x\\]/**}") { return "FAIL: subpath not escaped, got ${m6.dir}" }

  return "pass"
}
