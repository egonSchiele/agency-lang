// ExportParam is never named here. A schema built from ExportInfo refers to
// it by name, and the compiler does not import it on its own, so the
// module fails to load without this import.
import { describe, run, CompiledProgram, ExportInfo, ExportParam, ModuleInfo } from "std::agency"
import { llmOptions } from "std::agents/lib/shared"
import { now, format } from "std::date"
import { read } from "std::index"
import { filterEntries } from "std::object"
import { resolve } from "std::path"
import { exists } from "std::shell"
import { Json } from "std::validation"

import { _read, _write } from "agency-lang/stdlib-lib/builtins.js"
import { _mkdir, _realDir } from "agency-lang/stdlib-lib/fs.js"
import { _glob } from "agency-lang/stdlib-lib/shell.js"

import {
  _compileWorkflowSource,
  _pickSignatures,
  _problemsFailure,
  _problemsFromDiagnostics,
  _signatureSources,
  _toolRefs,
  _workflowFailure,
  _workflowNameProblem,
  _catalogEntries,
  _compileTrusted,
  _describeTrusted,
  _typecheckTrusted,
  describeProblem,
} from "agency-lang/stdlib-lib/workflow/index.js"

/** @module
@summary Check, run, and save workflows described as JSON steps.

Use a workflow when an agent should do the same task the same way every
time. A skill is a set of instructions that the agent reads and then decides
how to follow. A workflow is a fixed list of steps, so it runs the same way
on every call, and a person can still read it as easily as a skill.

A workflow has tool steps, LLM steps, and references from one step to an
earlier step's result. Anything else belongs in an Agency function that a
tool step calls.

```ts
import { add } from "std::math"
import { runWorkflow, Workflow } from "std::workflow"

node main() {
  const workflow: Workflow = {
    format: 1,
    name: "sum",
    description: "Add two numbers.",
    inputs: "{ a: number; b: number }",
    steps: [{
      id: "total",
      kind: "tool",
      module: "std::math",
      tool: "add",
      args: { a: { "$ref": "inputs.a" }, b: { "$ref": "inputs.b" } }
    }]
  }
  return runWorkflow(workflow, { a: 2, b: 3 }, [add])
}
```

Each step calls a supplied tool or asks a model. References can read inputs
or earlier step results. `checkWorkflow` checks the generated Agency program
without running the workflow. `runWorkflow` checks, requests approval, and
runs it in a subprocess whose interrupts reach the caller's handlers.

Pass original exported Agency functions as tools. Renamed, partially applied,
runtime-built, and package tools cannot be imported into a workflow. Local
tool files must be under `dir`.

Use `writeWorkflow` to save under `<dir>/workflows`, then `loadWorkflow` or
`listWorkflows` to read saved workflows. `workflowTool` and `workflowTools`
expose workflows as tools for an LLM. `catalog` describes available tool
parameters, return types, and effects for workflow authors.
`checkWorkflowWithSchemas` gives a host that stores workflows itself the
check's warnings with the JSON Schemas of the inputs and of each LLM step's
output, from one compile.

`designWorkflow` has a model draft a workflow from a request, shows each
draft for review, and saves the accepted one. `draftWorkflow` makes one
checked draft for a host that reviews and saves workflows itself.
*/

/** Caps on one run of a workflow, or on one step: `maxCost` in dollars and
  `maxTime` in milliseconds, each a positive number. The generated program
  wraps the whole body, or that step, in a guard with them. */
export type WorkflowLimits = {
  maxCost?: number;
  maxTime?: number
}

/** A workflow: a name, a description, the inputs as an Agency object type
  written as text, and the steps. `result` is a reference or a literal; the
  last step's value is returned without it. */
export type Workflow = {
  format: number;
  name: string;
  description: string;
  inputs: string;
  steps: Json[];
  result?: Json;
  limits?: WorkflowLimits;
  /** The effects the workflow may raise, as in an Agency function's `raises` clause (docs/site/guide/effects-and-raises.md). Left out means anything. `[]` means nothing. A built-in set name such as `FileRead` stands for its members, and `"*"` means anything. `checkWorkflow` reports each step that raises an effect not listed. */
  raises?: string[]
}

/** One thing wrong with a workflow, named by step and field. `step` and
  `field` are null only for a problem with the whole workflow. */
export type WorkflowProblem = {
  step: string | null;
  field: string | null;
  message: string
}

/** The data a refused workflow fails with. */
export type WorkflowFailure = {
  problems: WorkflowProblem[]
}

type ToolRef = {
  module: string;
  name: string
}

type Compiled = {
  source: string;
  ranges: Json;
  typeOwners: Json;
  warnings: WorkflowProblem[];
  wallClock: number | null
}

/** A workflow that passed the check: its compiled program, the warnings,
  and the subprocess wall clock (null for `run`'s default). */
type Checked = {
  program: CompiledProgram;
  warnings: WorkflowProblem[];
  wallClock: number | null
}

// Running a workflow. Raised after the check and before the subprocess
// starts, so a rejection starts nothing. An "always" answer pins the
// workflow directory and the workflow's name; the inputs are shown and
// never pinned, since they change with every run. `dir` is always an
// absolute path: a relative one would pin text that means a different
// directory under a different working directory, and the default `""`
// would give the pattern `{,/**}`, which matches every absolute path.
// A loaded workflow's name matches its file name. Caller-built workflows
// use the name in the supplied value.
@alwaysUnder(dir)
@always(name)
effect std::workflow::run {
  name: string;
  dir: string;
  inputs: Json
}

/** The tools one module provides, as `_signatureSources` groups them. */
type SignatureSource = {
  module: string;
  names: string[];
  reExport: string | null
}

// A `std::` module is described from its re-export line. A local module is
// read from `dir`, which asks for approval, and described with its path, so
// its own imports of other local files resolve. Those files are read without
// prompts of their own, as `_checked`'s type check already reads them. A
// local module may be a trusted module (`sandbox.trustedModules` in
// agency.json): `_describeTrusted` describes it with the host's list, which
// the public `describe` never sees.
/**
Describe a tool module with enough path context to resolve its local imports.
*/
@capabilities(fileRead)
def describeGroup(group: SignatureSource, dir: string): Result<ModuleInfo> {
  if (group.reExport != null) {
    return describe(group.reExport)
  }
  const text = read(group.module, dir)?
  return try _describeTrusted(text, dir, group.module)
}

/** What `describe` says about each tool, keyed by module and name. */
@hidden
@capabilities(fileRead)
export def _signatures(refs: ToolRef[], dir: string): Result<Record<string, ExportInfo>> {
  let signatures: Record<string, ExportInfo> = {}
  for (group in _signatureSources(refs)) {
    const info = describeGroup(group, dir)?
    const picked = _pickSignatures(group, info.exports)?
    signatures = { ...signatures, ...picked }
  }
  return success(signatures)
}

/** The generated source, the lines each step owns, and the warnings. */
@hidden
@capabilities(fileRead)
export def _compileWithRanges(workflow: Workflow, tools: any[], dir: string): Result<Compiled, WorkflowFailure> {
  const refs = _toolRefs(tools, dir)?
  const signatures = _signatures(refs, dir)
  if (signatures is failure) {
    return _workflowFailure(signatures.error)
  }
  return _compileWorkflowSource(workflow, refs, signatures.value)
}

/**
Use the generated source to inspect what a workflow will do, or pass it to
`compile` or `typecheck` from `std::agency`. Use `checkWorkflow` to run both
checks and report diagnostics against the workflow's steps and fields.
*/
@capabilities(fileRead)
export idempotent def compileWorkflow(workflow: Workflow, tools: any[], dir: string = ""): Result<string, WorkflowFailure> {
  """
  Generate Agency source for a workflow without running it.
  Failures identify the step and field with a problem.

  @param tools - Original exported Agency functions available to the workflow's steps.
  @param dir - Directory containing any local tool modules and resolving their paths.
  """
  const compiled = _compileWithRanges(workflow, tools, dir)?
  return success(compiled.source)
}

/** The check behind `checkWorkflow` and `runWorkflow`: generate, typecheck,
  and compile, keeping the compiled program so a run never compiles twice. */
@hidden
@capabilities(fileRead)
export def _checked(workflow: Workflow, tools: any[], dir: string): Result<Checked, WorkflowFailure> {
  const compiled = _compileWithRanges(workflow, tools, dir)?
  return checkCompiled(compiled, dir)
}

/** `_checked` with the tools already described, so checking draft after
  draft does not read the tool modules again. */
@hidden
@capabilities(fileRead)
export def _checkedWith(
  workflow: Workflow,
  refs: ToolRef[],
  signatures: Record<string, ExportInfo>,
  dir: string,
): Result<Checked, WorkflowFailure> {
  const compiled = _compileWorkflowSource(workflow, refs, signatures)?
  return checkCompiled(compiled, dir)
}

@capabilities(fileRead)
def checkCompiled(compiled: Compiled, dir: string): Result<Checked, WorkflowFailure> {
  const source = compiled.source
  // The typecheck runs first: its errors carry a line and a payload, so each
  // one is mapped to its step and field. A strict compile reports the same
  // errors as one message, so it runs second, for what is left. Both use
  // the host's trusted modules, so a step may call a tool whose module
  // imports TypeScript; the public `typecheck` and `compile` never do.
  const report = try _typecheckTrusted(source, dir, true)
  if (report is failure) {
    return _workflowFailure(report.error)
  }
  if (report.value.errors.length > 0) {
    return _problemsFailure(_problemsFromDiagnostics(report.value.errors, compiled.ranges, compiled.typeOwners))
  }
  const program = try _compileTrusted(source, dir, true)
  if (program is failure) {
    return _workflowFailure(program.error)
  }
  return success({
    program: program.value,
    warnings: compiled.warnings,
    wallClock: compiled.wallClock
  })
}

/**
Use this before presenting or saving a workflow. Errors identify their step
and field. Success contains warnings for values that cannot be fully checked
until runtime, such as references into a tool result with no declared type.
*/
@capabilities(fileRead)
export idempotent def checkWorkflow(workflow: Workflow, tools: any[], dir: string = ""): Result<WorkflowProblem[], WorkflowFailure> {
  """
  Check a workflow without executing its steps, returning warnings on success.

  @param tools - Original exported Agency functions available to the workflow's steps.
  @param dir - Directory containing any local tool modules and resolving their paths.
  """
  const checked = _checked(workflow, tools, dir)?
  return success(checked.warnings)
}

/** What `checkWorkflowWithSchemas` reports for a workflow that passed. */
export type CheckedWorkflow = {
  /** What the check could not settle until the workflow runs. */
  warnings: WorkflowProblem[];
  /** The JSON Schema of the workflow's `inputs` type, in the input form: an input with a default is optional. */
  inputsSchema: Json;
  /** The JSON Schema of each LLM step's `output` type, by step id. Tool steps are not here. */
  outputSchemas: Record<string, Json>
}

/**
Use this where the check's warnings and the schemas are needed together,
such as a host that saves workflows itself and shows a later step what an
LLM step produces. It compiles once and runs the program's `workflowSchemas`
node in one subprocess, which raises `std::run`. A workflow with problems
fails with them, as `checkWorkflow` does, and starts no process.
*/
@capabilities(fileRead, fileWrite, subprocess)
export def checkWorkflowWithSchemas(workflow: Workflow, tools: any[], dir: string = ""): Result<CheckedWorkflow, WorkflowFailure> {
  """
  Check a workflow and return its warnings with the JSON Schemas of its inputs and of each LLM step's output.

  @param tools - Original exported Agency functions available to the workflow's steps.
  @param dir - Directory containing any local tool modules and resolving their paths.
  """
  const checked = _checked(workflow, tools, dir)?
  // A failure comes back as it came: a refused or failed run has
  // `rejected` and no `problems`, a failed node has its problem.
  const schemas = _workflowSchemas(checked.program)?
  return success({
    warnings: checked.warnings,
    inputsSchema: schemas.inputs,
    outputSchemas: schemas.outputs
  })
}

/** One parameter a workflow step can pass to a tool. */
export type CatalogParam = {
  name: string;
  /** The declared type as Agency text, such as `string[]` or `Note`. Null when none is declared. */
  type: string | null;
  /** The default as Agency source, such as `0` or `null`. Null when the parameter has none, so a step must pass a value. */
  default: string | null;
  /** The text of the docstring's `@param` entry for this parameter, or null. */
  description: string | null;
  /** The JSON Schema a model sees for this parameter. */
  schema: Json
}

/** One tool a workflow may call. */
export type CatalogEntry = {
  /** What a step's `module` field says: `std::math`, or `./notes.agency` relative to `dir`. */
  module: string;
  name: string;
  /** The docstring without its `@param` entries, or the empty string. */
  description: string;
  /** The parameters a step can pass. A function-typed parameter is left out. */
  params: CatalogParam[];
  /** The declared return type as Agency text. Null when none is declared. */
  returns: string | null;
  /** The JSON Schema of the value a reference into this tool's step reads: the declared return type, or the success type inside a `Result`. Null when the tool declares no return type, or its return type holds a function or a `regex` (which JSON Schema cannot express), or names a type its module cannot reach at run time (#1371). */
  returnSchema: Json;
  /** What the tool can raise, as `describe` reports it. A tool that uses `guard` lists `std::guard`. `checkWorkflow`'s `raises` check leaves it out, since a guard trip is a question about budget, not a permission. */
  effects: string[];
  /** True for a `handoff def`, so a picker can tell an agent from a function. A step calls it like any tool. */
  handoff: boolean
}

/**
Use this to populate a workflow editor or inspect what arguments a step can
pass. Entries follow the supplied tool order. Invalid tool lists return
problems in failure data; a rejected or failed module read returns its own
failure instead.
*/
@capabilities(fileRead)
export idempotent def catalog(tools: any[], dir: string = ""): Result<CatalogEntry[]> {
  """
  Describe workflow tools with their parameters, schemas, return types, and effects.

  @param tools - Original exported Agency functions to describe.
  @param dir - Directory containing any local tool modules and resolving their paths.
  """
  const described = describeTools(tools, dir)?
  return success(described.entries)
}

/** The tools as import references, what `describe` says about each, and
  their catalog entries: everything the designer needs from the tool
  modules, read once. */
type DescribedTools = {
  refs: ToolRef[];
  signatures: Record<string, ExportInfo>;
  entries: CatalogEntry[]
}

@capabilities(fileRead)
def describeTools(tools: any[], dir: string): Result<DescribedTools> {
  const refs = _toolRefs(tools, dir)?
  const signatures = _signatures(refs, dir)
  if (signatures is failure) {
    // Returned as it came, so a rejected read keeps its `rejected` flag.
    return signatures
  }
  return success({
    refs: refs,
    signatures: signatures.value,
    entries: _catalogEntries(tools, refs, signatures.value)
  })
}

/**
Validation completes before run approval or subprocess startup. Step
failures identify the step that stopped the workflow. Each step's interrupts
still reach the caller's handlers.

Workflow and step limits are hard caps: the generated program rejects their
guard trips. A tool's own guard retains its handlers, so it can extend its
own budget within those caps. A caller policy that rejects `std::guard`
also rejects that extension.

An "always" run approval pins the resolved directory and workflow name.
It does not pin the inputs or the workflow's contents.
*/
@capabilities(fileRead, fileWrite, subprocess)
export def runWorkflow(workflow: Workflow, inputs: Json, tools: any[], dir: string = ""): Result<Json> {
  """
  Check a workflow, request approval, and execute its steps in a subprocess.

  @param inputs - A value matching the workflow's inputs type.
  @param tools - Original exported Agency functions available to the workflow's steps.
  @param dir - Directory containing local tool modules, defaulting to the working directory.
  """
  const where = resolve(dir)
  const checked = _checked(workflow, tools, where)?
  return interrupt std::workflow::run("Run the workflow ${workflow.name}?", {
    name: workflow.name,
    dir: where,
    inputs: inputs
  })
  const ran = run(compiled: checked.program, node: "main", args: { inputs: inputs }, wallClock: checked.wallClock)?
  return ran.data
}

// ---- a workflow as a tool ----

/** Why a workflow named `name` cannot be handed to a model beside `tools`,
  or null when it can: two tools with one name are refused at the model
  call. */
def nameClashProblem(name: string, tools: any[]): string | null {
  if (!some(tools, \tool -> tool.name == name)) {
    return null
  }
  return "workflow \"${name}\" has the same name as a tool the host passed; rename one of them"
}

/** The tool: runWorkflow with the workflow, the tools, and the directory
  bound, under the workflow's name and description, with the inputs schema
  as the type of its one parameter. */
def toolFor(workflow: Workflow, tools: any[], dir: string, inputsSchema: Json): any {
  const bound = runWorkflow.partial(workflow: workflow, tools: tools, dir: dir)
  const named = bound.rename(workflow.name).describe(workflow.description)
  return named.withParamSchema("inputs", inputsSchema)
}

/**
The returned tool uses the workflow's name and description. Its `inputs`
parameter has the workflow's input schema. Building it checks the workflow
and runs a schema node in a subprocess; calling it later runs the workflow.
A name shared with a supplied tool is refused.
*/
@capabilities(fileRead, fileWrite, subprocess)
export def workflowTool(workflow: Workflow, tools: any[], dir: string = ""): Result<any> {
  """
  Build an LLM-callable tool for a checked workflow.

  @param tools - Original exported Agency functions the workflow may call, with names distinct from the workflow.
  @param dir - Directory containing local tool modules, defaulting to the working directory.
  """
  const where = resolve(dir)
  const clash = nameClashProblem(workflow.name, tools)
  if (clash != null) {
    return failure(clash)
  }
  const checked = _checked(workflow, tools, where)?
  const inputsSchema = _inputsSchema(checked.program)?
  return success(toolFor(workflow, tools, where, inputsSchema))
}

/** One saved workflow as a tool, or the reason it cannot be one. */
def toolForEntry(entry: WorkflowEntry, tools: any[], dir: string): Result<any> {
  if (entry.meta.inputsSchema == null) {
    return failure("${entry.name} was saved before inputs schemas were recorded; save it again with writeWorkflow")
  }
  const clash = nameClashProblem(entry.name, tools)
  if (clash != null) {
    return failure(clash)
  }
  return success(toolFor(entry.workflow, tools, dir, entry.meta.inputsSchema))
}

/**
Use saved input schemas to build tools without starting a subprocess.
Saved workflows are checked against the current tools when called.
A missing schema requires saving the workflow again with `writeWorkflow`.
*/
@capabilities(fileRead)
export def workflowTools(dir: string, tools: any[]): Result<any[]> {
  """
  Build one LLM-callable tool per saved workflow, in name order.

  @param dir - Nonempty project directory holding the workflows folder.
  @param tools - Original exported Agency functions the workflows may call, with names distinct from the workflows.
  """
  const listed = listWorkflows(dir)?
  const where = resolve(dir)
  const built = map(listed, \entry -> toolForEntry(entry, tools, where))
  const broken = find(built, \tool -> isFailure(tool))
  if (broken != null) {
    return broken
  }
  return success(map(built, \tool -> tool.value))
}

// ---- saving and loading ----

const WORKFLOWS_DIR = "workflows"
const FILE_SUFFIX = ".json"
const MAX_WORKFLOWS = 500
const SCHEMAS_NODE = "workflowSchemas"

/** What a saved workflow's file records beside the workflow. */
export type WorkflowMeta = {
  /** When the workflow was last saved, as ISO text. */
  savedAt: string;
  /** What saved it, such as `writeWorkflow`. */
  savedBy: string;
  /** The JSON Schema of the workflow's `inputs` type, from the program's
    own `workflowSchemas` node's `inputs` at save time; null for a workflow saved before
    schemas were recorded. */
  inputsSchema: Json | null
}

/** A saved workflow: its name, the file it is saved in, the workflow, and
  the record saved with it. */
export type WorkflowEntry = {
  name: string;
  path: string;
  workflow: Workflow;
  meta: WorkflowMeta
}

/** The meta record as written; every field may be missing. */
type MetaFile = {
  savedAt?: string;
  savedBy?: string;
  inputsSchema?: Json
}

/** A saved file as written. */
type SavedFile = {
  workflow: Workflow;
  meta?: MetaFile
}

const DEFAULT_META: WorkflowMeta = {
  savedAt: "",
  savedBy: "",
  inputsSchema: null
}

/** Raised before saved workflows are read. `dir` is the real path of the
  project's `workflows` folder, and an "always" answer pins that folder. */
@alwaysUnder(dir)
effect std::workflow::scan {
  dir: string
}

/** Raised once before a workflow is saved, after its check passes. `dir`
  is the real path of the project's `workflows` folder. Saving a name that
  exists replaces that workflow, so an "always" answer pins the name as
  well as the folder. */
@alwaysUnder(dir)
@always(name)
effect std::workflow::save {
  dir: string;
  name: string;
  workflow: Workflow
}

// An empty `dir` is refused because the file primitives would resolve it
// to the process cwd. Every prompt names the real spelling, so an "always"
// answer pins the folder that is actually read and written.
@capabilities(fileRead)
def expandRoot(dir: string): Result<string> {
  if (dir == "") {
    return failure("dir must name the project directory; got an empty string")
  }
  return try _realDir(dir)
}

def savedFile(name: string): string {
  return "${WORKFLOWS_DIR}/${name}${FILE_SUFFIX}"
}

/** What the program's `workflowSchemas` node returns. */
type WorkflowSchemas = {
  inputs: Json;
  outputs: Record<string, Json>
}

/** The JSON Schemas of the program's `Inputs` type and of each LLM step's
  output type, from one run of its `workflowSchemas` node. */
@hidden
@capabilities(fileWrite, subprocess)
export def _workflowSchemas(program: CompiledProgram): Result<WorkflowSchemas> {
  const ran = run(compiled: program, node: SCHEMAS_NODE)
  if (ran is failure) {
    // A rejected std::run, a spawn error, a timeout: not the workflow's
    // fault, so returned as it came, with its `rejected` flag and no
    // `problems`.
    return ran
  }
  // The envelope's `data` is what the node returned. The check refuses
  // the one type JSON Schema cannot express, a regex, so the node does
  // not fail in practice; if it does, that is the workflow's fault.
  if (ran.value.data is failure(nodeErr)) {
    return _workflowFailure("could not derive the workflow's schemas: ${nodeErr}")
  }
  return success(ran.value.data)
}

/** The JSON Schema of the program's `Inputs` type. */
@hidden
@capabilities(fileWrite, subprocess)
export def _inputsSchema(program: CompiledProgram): Result<Json> {
  const schemas = _workflowSchemas(program)?
  return success(schemas.inputs)
}

// The optional fields of a workflow. A shape check (`Workflow!`) fills each
// one with null when it is absent, and null means the same as absent.
static const OPTIONAL_FIELDS = ["result", "limits", "raises"]

def isWritten(value: Json, key: string): boolean {
  return value != null || !OPTIONAL_FIELDS.includes(key)
}

// Drops the nulls a shape check filled in, so a saved file carries only
// the fields someone wrote, not `"limits": null`.
def withoutNullOptionals(workflow: Workflow): Workflow {
  return filterEntries(workflow, isWritten)
}

/**
Checks the workflow before requesting save approval. It then derives the
input schema in a subprocess and saves it alongside the workflow.
Neither a rejected save nor a rejected schema run writes the workflow.
Saving an existing name replaces its file.
*/
@capabilities(fileRead, fileWrite, subprocess)
export def writeWorkflow(workflow: Workflow, tools: any[], dir: string): Result<WorkflowEntry> {
  """
  Check and save a workflow as `<dir>/workflows/<name>.json` after approval.
  An existing workflow with that name is replaced.

  @param tools - Original exported Agency functions available to the workflow's steps.
  @param dir - Existing project directory containing any local tool modules.
  """
  const root = expandRoot(dir)?
  if (!exists(root)) {
    return failure("${root} does not exist; dir must name an existing project directory")
  }
  const saving = withoutNullOptionals(workflow)
  // The check also proves `name` is an identifier, so it is safe in a file name.
  const checked = _checked(saving, tools, root)?
  const folder = "${root}/${WORKFLOWS_DIR}"
  return interrupt std::workflow::save("Save the workflow ${saving.name}?", {
    dir: folder,
    name: saving.name,
    workflow: saving
  })
  // After the save prompt, so a rejected save starts no process, and
  // before the write, so a rejected `std::run` leaves nothing on disk.
  const inputsSchema = _inputsSchema(checked.program)?
  const meta: WorkflowMeta = {
    savedAt: format(now()),
    savedBy: "writeWorkflow",
    inputsSchema: inputsSchema
  }
  const file = savedFile(saving.name)
  destructive {
    const made = try _mkdir(folder)?
    const content = JSON.stringify({ workflow: saving, meta: meta }, null, 2)
    const wrote = try _write(root, file, content, "overwrite")?
  }
  return success({
    name: saving.name,
    path: "${root}/${file}",
    workflow: saving,
    meta: meta
  })
}

def isPresent(value: Json, key: string): boolean {
  return value != null
}

// The shape check fills a missing field with null, and a null would win
// over the default in a spread, so only the fields the file has are kept.
def metaOf(file: MetaFile | null): WorkflowMeta {
  if (file == null) {
    return DEFAULT_META
  }
  return {
    ...DEFAULT_META,
    ...filterEntries(file, isPresent)
  }
}

// Every failure starts with the workflow's name, so a caller can return it
// as it is.
@capabilities(fileRead)
def entryFor(root: string, name: string): Result<WorkflowEntry> {
  const file = savedFile(name)
  const raw = try _read(root, file, 0, 0)
  if (raw is failure(readErr)) {
    return failure("${name}: ${file} could not be read: ${readErr}")
  }
  const parsed = try JSON.parse(raw.value)
  if (parsed is failure(parseErr)) {
    return failure("${name}: ${file} is not valid JSON: ${parseErr}")
  }
  const saved: SavedFile! = parsed.value
  if (saved is failure(shapeErr)) {
    return failure("${name}: ${file} is not a saved workflow: ${shapeErr}")
  }
  // `std::workflow::run` names the workflow by its own `name`, so a copied
  // file that kept the old name would run under an approval for the old one.
  const workflow = saved.value.workflow
  if (workflow.name != name) {
    return failure("${name}: ${file} holds a workflow named ${workflow.name}; the file name and the workflow's name must match")
  }
  return success({
    name: name,
    path: "${root}/${file}",
    workflow: workflow,
    meta: metaOf(saved.value.meta)
  })
}

/**
The saved workflow's name must match its filename. Loading reads the file
and checks its shape; it does not check the steps against available tools.
*/
@capabilities(fileRead)
export def loadWorkflow(name: string, dir: string): Result<WorkflowEntry> raises <std::workflow::scan> {
  """
  Read a saved workflow by name.

  @param name - Saved workflow identifier, excluding path syntax.
  @param dir - Nonempty project directory holding the workflows folder.
  """
  // The name comes from the caller, so it gets the rule parse gives a
  // workflow's name: `../x` must not name a file outside the folder.
  const problem = _workflowNameProblem(name)
  if (problem != null) {
    return failure(problem)
  }
  const root = expandRoot(dir)?
  // Before the prompt, so a missing workflow fails without asking first,
  // as ls, grep, and glob do (docs/dev/stdlib/grep-flags.md).
  if (!exists(savedFile(name), root)) {
    return failure("no workflow named ${name} in ${root}/${WORKFLOWS_DIR}")
  }
  return interrupt std::workflow::scan("Read the saved workflow ${name}?", {
    dir: "${root}/${WORKFLOWS_DIR}"
  })
  return entryFor(root, name)
}

def workflowName(fileName: string): string {
  return fileName.slice(0, fileName.length - FILE_SUFFIX.length)
}

// A glob `*` matches a name that starts with a dot.
def isVisible(fileName: string): boolean {
  return !fileName.startsWith(".")
}

// The names saved under `<root>/workflows`, from the file names alone. It
// reads no saved file, so it asks nothing, as `exists` asks nothing before
// `loadWorkflow`'s prompt. The designer uses it to refuse a draft that
// would replace a saved workflow.
@capabilities(fileRead)
def savedWorkflowNames(root: string): Result<string[]> {
  const folder = "${root}/${WORKFLOWS_DIR}"
  if (!exists(folder)) {
    return success([])
  }
  // One more than the cap, so a folder that full is refused, not cut short.
  const fileNames = try _glob(root, WORKFLOWS_DIR, "*${FILE_SUFFIX}", MAX_WORKFLOWS + 1)?
  if (fileNames.length > MAX_WORKFLOWS) {
    return failure("${folder} has more than ${MAX_WORKFLOWS} workflows")
  }
  return success(map(filter(fileNames, isVisible), workflowName))
}

/**
A project without a workflows folder returns an empty list. An unreadable
or invalid saved file fails the listing with a message naming it.
*/
@capabilities(fileRead)
export def listWorkflows(dir: string): Result<WorkflowEntry[]> raises <std::workflow::scan> {
  """
  List saved workflows in name order.

  @param dir - Nonempty project directory holding the workflows folder.
  """
  const root = expandRoot(dir)?
  const folder = "${root}/${WORKFLOWS_DIR}"
  if (!exists(folder)) {
    return success([])
  }
  return interrupt std::workflow::scan("Read the workflows saved in this project?", {
    dir: folder
  })
  const names = sortBy(savedWorkflowNames(root)?, \name -> name)
  const entries = map(names, \name -> entryFor(root, name))
  const broken = find(entries, \entry -> isFailure(entry))
  if (broken != null) {
    return broken
  }
  return success(map(entries, \entry -> entry.value))
}

// ---- designing a workflow ----

// The first part of the designer's brief. It is a `"""` string, so `${`
// starts an interpolation: write `\${` for a literal one, as the `welcome`
// example does. The example is named so no test or stdlib function shares
// it: the language server finds stdlib functions by matching `export def`
// in the source text, strings included (lib/lsp/codeAction.ts). It shows the workflow object as the model is asked to
// write it, without the saved file's outer `workflow` field, and leaves
// out limits, which a host adds at its own save.
static const DESIGN_TUTORIAL = """
A workflow is a fixed list of steps written as JSON. Each step is either a tool call or an LLM call. The steps are compiled to an Agency program and run in order.

## Your first workflow

This workflow adds two numbers and doubles the sum, using the `add` and `multiply` tools from the `std::math` module in Agency's standard library.

```json
{
  "format": 1,
  "name": "doubleSum",
  "description": "Add two numbers and double the sum.",
  "inputs": "{ a: number; b: number }",
  "steps": [
    {
      "id": "sum",
      "kind": "tool",
      "module": "std::math",
      "tool": "add",
      "args": {
        "a": { "$ref": "inputs.a" },
        "b": { "$ref": "inputs.b" }
      }
    },
    {
      "id": "doubled",
      "kind": "tool",
      "module": "std::math",
      "tool": "multiply",
      "args": {
        "a": { "$ref": "steps.sum" },
        "b": 2
      }
    }
  ],
  "result": { "$ref": "steps.doubled" }
}
```

Things to note:
- `format` is always 1.
- `inputs` declares an Agency object type as text. Here, callers must supply two numbers.
- Each step has a unique `id`.
- A `tool` step names the function's module, the function, and its arguments. In Agency, functions are tools.

The workflow runs its steps in order. `sum` adds the two inputs, then `doubled` multiplies that result by `2`.

## Passing values between steps

```json
{
  "noteId": { "$ref": "steps.notes[0].id" },
  "title": { "$ref": "inputs.title" },
  "tags": ["shopping", { "$ref": "inputs.category" }]
}
```

This argument object combines literal values and references. References work in a tool step's `args`, an LLM step's `context`, and the workflow's `result`. You can nest them in objects and arrays.

## Adding an LLM step

An LLM step asks a model. This step, added after `doubled` in the first example, explains the result:

```json
{
  "id": "explain",
  "kind": "llm",
  "prompt": "Explain how adding the two inputs and doubling their sum gives the result. Use one short sentence.",
  "context": [
    { "$ref": "inputs.a" },
    { "$ref": "inputs.b" },
    { "$ref": "steps.doubled" }
  ],
  "output": "{ explanation: string }"
}
```

Things to note:
- The prompt text is literal. Put values that change in `context`, not in the prompt.
- The model receives the prompt followed by the context values, each with a label. Strings keep their text, and other values become JSON. Write `"context": []` when there is no context.
- `output` is an Agency type written as text, such as `"string"`, `"string[]"`, or `"{ title: string; items: string[] }"`. The model's reply has that type, and it is the step's value. A later reference reads a field of it, such as `{ "$ref": "steps.explain.explanation" }`.
- An LLM step gets no tools.

## Result types

Agency uses Result types for error handling. Functions can return either a success or a failure.

If a function that you use in a workflow returns a `Result`, Agency unwraps the `Result` for you. If the Result is a failure, the workflow stops and returns a failure naming that step.

## Returning a value from the workflow

The `result` field chooses what the workflow returns. If you leave it out, the workflow returns the last step's value. You can return a value assembled from several references:

```json
"result": {
  "sum": { "$ref": "steps.sum" },
  "doubled": { "$ref": "steps.doubled" }
}
```

## Calling functions from local files

Suppose a project has this function in `tools.agency`:

```ts
export def welcome(name: string): string {
  return "Hello, \${name}!"
}
```

A step calls it by the module path:

```json
{
  "id": "greeting",
  "kind": "tool",
  "module": "./tools.agency",
  "tool": "welcome",
  "args": { "name": { "$ref": "inputs.name" } }
}
```

Use each tool's module exactly as the tool list gives it.
"""

/** A draft as text, and what was wrong with it. The next draft is asked to
  fix it. It holds a draft that failed the check, the draft a person gave
  feedback on, or an edited workflow that failed the check. */
export type DraftProblem = {
  draft: string;
  problems: string
}

def renderParam(param: CatalogParam): string {
  const type = param.type ?? "any"
  const dflt = if param.default == null then "" else " = ${param.default}"
  const desc = if param.description == null then "" else " — ${param.description}"
  return "  - ${param.name}: ${type}${dflt}${desc}"
}

def renderEntry(entry: CatalogEntry): string {
  const params = if entry.params.length == 0 then "  (none)" else map(entry.params, renderParam).join("\n")
  const returns = entry.returns ?? "any"
  const effects = if entry.effects.length == 0 then "none" else entry.effects.join(", ")
  return "### ${entry.name} (module \"${entry.module}\")\n${entry.description}\nParameters:\n${params}\nReturns: ${returns}\nEffects: ${effects}"
}

def revisionSection(problem: DraftProblem | null): string {
  if (problem == null) {
    return ""
  }
  return """
# The previous draft
${problem.draft}

# What is wrong with it
${problem.problems}

Write a new draft that fixes every point above and keeps what was right.
"""
}

/**
The brief has three parts: a tutorial on the workflow format, the tools as
`catalog` describes them, and the request with the rules for a draft. A
`problem` adds the previous draft and what was wrong with it at the end.
Read it to see what the designer's model is told, or to measure its length
over a large tool list.
*/
export def workflowDesignBrief(request: string, entries: CatalogEntry[], problem: DraftProblem | null = null): string {
  """
  Build the prompt the workflow designer sends to its model.

  @param request - What the workflow should do, and which values change between runs.
  @param entries - The tools a step may call, as `catalog` returns them.
  @param problem - A previous draft and what was wrong with it, or null for a first draft.
  """
  const catalogText = map(entries, renderEntry).join("\n\n")
  return """
Write a workflow in Agency's JSON format that does what the request asks.

# How workflows are written
${DESIGN_TUTORIAL}

# The tools the workflow may call
The examples above use tools that may not exist here. A step may call only the tools below, by the exact module and name given.

${catalogText}

# The request
${request}

Rules:
- Values that change from run to run are inputs. Everything else is a literal in a step's args.
- When the request leaves out something a step needs, such as which list or which folder, make it an input and say so in the description. Do not guess it.
- Pick a short camelCase identifier for the name, and a one-sentence description.
- Reply with the workflow object only, as JSON text. Do not wrap it in another object, and do not add limits.
${revisionSection(problem)}
"""
}

/** The model's reply. The workflow is JSON text, not a `Workflow`: its
  `Json` fields become open schemas, which Anthropic and OpenAI refuse in
  a structured reply. */
type WorkflowDraftReply = {
  workflowJson: string
}

/** A draft that passed the check, with the check's warnings. */
type CheckedDraft = {
  workflow: Workflow;
  warnings: WorkflowProblem[]
}

/** A drafted workflow that passed the check. */
export type WorkflowDraft = {
  workflow: Workflow;
  /** What the check could not settle until the workflow runs. */
  warnings: WorkflowProblem[];
  /** Model calls the draft took to pass the check. */
  attempts: number
}

// Check failures go back to the model without the user, up to this many
// times per draft, as `designTool`'s CHECK_ATTEMPTS. Feedback from the
// user starts a new draft.
static const DESIGN_ATTEMPTS = 6

/** The check's problems, one line each, or its message when it named none. */
def problemsText(failed: any): string {
  const problems = failed.data.problems
  if (problems == null) {
    return "- ${failed.error}"
  }
  return map(problems, \problem -> "- ${describeProblem(problem)}").join("\n")
}

def draftFailure(draft: string, problems: string): Result<CheckedDraft, DraftProblem> {
  return failure("the draft has problems:\n${problems}", { draft: draft, problems: problems })
}

/** The problem line for a name a saved workflow already has, or "". Case is
  ignored: on a case-insensitive disk, as macOS uses by default, saving
  `DoubleSum` writes into `doubleSum.json`, and that file then fails to load
  because its name no longer matches the workflow inside it. */
def takenNameProblem(name: string, savedNames: string[]): string {
  if (map(savedNames, \saved -> saved.toLowerCase()).includes(name.toLowerCase())) {
    return "- A workflow named ${name} is already saved (names are compared ignoring case). Choose another name."
  }
  return ""
}

// One draft through every stage: JSON, the workflow's shape, then the check
// and the name together, so a draft with a taken name and another problem
// hears about both in one attempt. A failure at any stage is a DraftProblem
// holding the text as written, so the next attempt sees what it wrote and
// what was wrong.
@capabilities(fileRead)
def attemptDraft(text: string, tools: DescribedTools, root: string, savedNames: string[]): Result<CheckedDraft, DraftProblem> {
  const parsed = try JSON.parse(text)
  if (parsed is failure(parseErr)) {
    return draftFailure(text, "- The reply is not valid JSON: ${parseErr}")
  }
  const shaped: Workflow! = parsed.value
  if (shaped is failure(shapeErr)) {
    return draftFailure(text, "- The workflow has the wrong shape: ${shapeErr}")
  }
  const workflow = withoutNullOptionals(shaped.value)
  const taken = takenNameProblem(workflow.name, savedNames)
  const checked = _checkedWith(workflow, tools.refs, tools.signatures, root)
  if (checked is failure) {
    if (taken == "") {
      return draftFailure(text, problemsText(checked))
    }
    return draftFailure(text, "${taken}\n${problemsText(checked)}")
  }
  if (taken != "") {
    return draftFailure(text, taken)
  }
  return success({ workflow: workflow, warnings: checked.value.warnings })
}

// The last problem's text, for the failure after a loop that never passed.
def lastProblems(problem: DraftProblem | null): string {
  if (problem == null) {
    return "(none)"
  }
  return problem.problems
}

// One draft: up to DESIGN_ATTEMPTS model calls, each one seeing the problem
// the previous one left. A reply that is still the wrong shape after the
// client's own retry ends the call, since the provider and not the draft
// is wrong.
@capabilities(fileRead)
def draftFrom(
  request: string,
  tools: DescribedTools,
  root: string,
  savedNames: string[],
  revise: DraftProblem | null,
  options: any,
): Result<WorkflowDraft> {
  let problem: DraftProblem | null = revise
  for (attempt in range(DESIGN_ATTEMPTS)) {
    const brief = workflowDesignBrief(request, tools.entries, problem)
    const reply: WorkflowDraftReply! = llm(brief, options)
    if (reply is failure(replyErr)) {
      return failure("the model's reply had the wrong shape: ${replyErr}")
    }
    const attempted = attemptDraft(reply.value.workflowJson, tools, root, savedNames)
    if (attempted is success(drafted)) {
      return success({ workflow: drafted.workflow, warnings: drafted.warnings, attempts: attempt + 1 })
    }
    problem = attempted.data
    // The problems quote what the model wrote, which can hold terminal
    // escapes, so only the count is printed. The model sees them in full.
    print("draftWorkflow: attempt ${attempt + 1} of ${DESIGN_ATTEMPTS} failed the check; drafting again")
  }
  return failure("no draft passed the check in ${DESIGN_ATTEMPTS} attempts; the last problems were:\n${lastProblems(problem)}")
}

/**
Use this when the host reviews and saves workflows itself. It makes one
draft and raises no interrupt of its own: reading the tools' local modules
asks with `std::read`, once per module. Problems the check finds go back to
the model, up to six times. To redraft after a person's feedback, pass
`revise` with the draft they saw as JSON text and their words as
`problems`.
*/
@capabilities(fileRead)
export def draftWorkflow(
  request: string,
  tools: any[],
  dir: string,
  revise: DraftProblem | null = null,
  model: string = "",
  provider: string = "",
): Result<WorkflowDraft> raises <std::read> {
  """
  Draft a workflow over these tools from a request, and check it.

  @param request - What the workflow should do, and which values change between runs.
  @param tools - Original exported Agency functions the steps may call.
  @param dir - Existing project directory containing any local tool modules.
  @param revise - A previous draft and what to change in it, or null for a first draft.
  @param model - Model override, or "" for the configured model.
  @param provider - Provider for the model override, ignored when model is empty.
  """
  const root = expandRoot(dir)?
  const described = describeTools(tools, root)?
  const options = llmOptions(model, provider, validationRetries: 1)
  return draftFrom(request, described, root, [], revise, options)
}

/** Raised with each draft that passed the check, before it is saved. The
  answer is a bare approval or `accept` to save the draft, feedback text for
  the next draft, or an edited workflow, which is checked and saved without
  another draft. The raise expects a value. Under `cliPolicyHandler` and
  under `agency run --interactive`, a policy rule does not answer it: the
  person does. In a run with nobody to ask, an approve rule accepts the
  draft. An answer someone gave survives an outer approval with no value. */
effect std::workflow::review {
  name: string;
  workflow: Workflow;
  /** The draft the previous round showed, or null on the first round. */
  previous: Workflow | null;
  warnings: WorkflowProblem[];
  /** Model calls this draft took to pass the check. */
  attempts: number;
  /** This round, counting from 1. Feedback given in the last round is not drafted. */
  round: number;
  maxRounds: number
}

static const ACCEPT_DESIGN = "accept"

/** What a review answer asks for. */
type ReviewAnswer = {
  kind: "accept"
} | {
  kind: "feedback";
  text: string
} | {
  kind: "edited";
  text: string
}

def reviewAnswer(answer: any): Result<ReviewAnswer> {
  // A bare approval is null when a handler answers in this process, and
  // true when the run paused and resumed (the generated code sets an
  // assignment-position raise's variable to true for an approval with no
  // value). Both accept.
  if (answer == null || answer == true) {
    return success({ kind: "accept" })
  }
  if (typeof answer == "string") {
    // Typed at a prompt, so " Accept" accepts too.
    if (answer.trim().toLowerCase() == ACCEPT_DESIGN) {
      return success({ kind: "accept" })
    }
    if (answer.trim() == "") {
      return failure("feedback for the next draft cannot be blank")
    }
    return success({ kind: "feedback", text: answer })
  }
  if (typeof answer != "object") {
    return failure("unrecognized review answer ${JSON.stringify(answer)}: answer \"${ACCEPT_DESIGN}\" or approve with no value to save, give feedback as text, or send back an edited workflow")
  }
  // An object is an edit, kept as text. attemptDraft checks its shape like
  // a model's draft, so an edit with the wrong shape goes to the model with
  // its problems instead of ending the call.
  return success({ kind: "edited", text: JSON.stringify(answer, null, 2) })
}

/**
Shows each draft in a `std::workflow::review` interrupt and saves the
accepted one with `writeWorkflow`, which asks with `std::workflow::save`.
Problems the check finds go back to the model without asking anyone. A
draft never takes the name of a workflow already saved in `dir`. Answer
the review with `accept`, with feedback for the next draft, or with an
edited workflow, which is checked and saved without another draft.
*/
@capabilities(fileRead, fileWrite, subprocess)
export def designWorkflow(
  request: string,
  tools: any[],
  dir: string,
  maxRounds: number = 3,
  model: string = "",
  provider: string = "",
): Result<WorkflowEntry> raises <std::workflow::review, std::workflow::save, std::read, std::run, std::guard> {
  """
  Draft a workflow over these tools from a request, show it for review, revise it on feedback, and save it once accepted.

  @param request - What the workflow should do, and which values change between runs.
  @param tools - Original exported Agency functions the steps may call.
  @param dir - Existing project directory; the workflow is saved under its workflows folder.
  @param maxRounds - How many drafts the user may see before the call fails.
  @param model - Model override, or "" for the configured model.
  @param provider - Provider for the model override, ignored when model is empty.
  """
  const root = expandRoot(dir)?
  if (!exists(root)) {
    return failure("${root} does not exist; dir must name an existing project directory")
  }
  const described = describeTools(tools, root)?
  const options = llmOptions(model, provider, validationRetries: 1)
  let revise: DraftProblem | null = null
  let previous: Workflow | null = null
  for (round in range(maxRounds)) {
    const savedNames = savedWorkflowNames(root)?
    const drafted = draftFrom(request, described, root, savedNames, revise, options)?
    print("designWorkflow: round ${round + 1} draft '${drafted.workflow.name}' passed the check after ${drafted.attempts} attempt(s)")
    const answer = interrupt std::workflow::review("Review this workflow before it is saved: answer accept, give feedback for the next draft, or send back an edited workflow", {
      name: drafted.workflow.name,
      workflow: drafted.workflow,
      previous: previous,
      warnings: drafted.warnings,
      attempts: drafted.attempts,
      round: round + 1,
      maxRounds: maxRounds
    })
    const decided = reviewAnswer(answer)?
    // A review can wait for hours, across a restart from a checkpoint, so
    // the names are read again: a workflow saved under this name meanwhile
    // sends the draft back to the model instead of being replaced.
    const savedNow = savedWorkflowNames(root)?
    if (decided.kind == "accept") {
      const taken = takenNameProblem(drafted.workflow.name, savedNow)
      if (taken == "") {
        return writeWorkflow(drafted.workflow, tools, root)
      }
      revise = { draft: JSON.stringify(drafted.workflow, null, 2), problems: taken }
    }
    if (decided.kind == "feedback") {
      revise = { draft: JSON.stringify(drafted.workflow, null, 2), problems: decided.text }
    }
    if (decided.kind == "edited") {
      const edit = attemptDraft(decided.text, described, root, savedNow)
      if (edit is success(checked)) {
        return writeWorkflow(checked.workflow, tools, root)
      }
      revise = edit.data
    }
    previous = drafted.workflow
  }
  return failure("no draft was accepted in ${maxRounds} rounds; the last problems were:\n${lastProblems(revise)}")
}
