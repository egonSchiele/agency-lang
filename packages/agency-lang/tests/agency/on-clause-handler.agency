// The on-clause handler alias (#926) must reach the SAME verdicts as the
// canonical `handle {} with (intr) { match ... }` form — no shape may turn a
// reject into an approve. Both nodes below run the same program under the two
// spellings and must agree.

effect app::write { dir: string }

// Raises app::write, then (only if approved) returns success. A rejected
// interrupt makes this function return a failure instead.
def act(dir: string): Result<string> raises <app::write> {
  raise app::write("writing", { dir: dir })
  return success(dir)
}

def tag(r: Result<string>): string {
  return match (r) {
    success(s) => "ok"
    failure(e) => "no"
  }
}

// The alias: expression-position `handle` + on-clause handler.
node onClause(): string {
  let a: Result<string> = handle (act(dir: ".")) with {
    on app::write(data) { if (data.dir == ".") { approve() } else { reject() } }
    on _ { reject() }
  }
  let b: Result<string> = handle (act(dir: "/etc")) with {
    on app::write(data) { if (data.dir == ".") { approve() } else { reject() } }
    on _ { reject() }
  }
  // The else-less conditional clause: "." must still be APPROVED, not degraded
  // to pass. This is the execution-level check for the else-less-if lifting.
  let c: Result<string> = handle (act(dir: ".")) with {
    on app::write(data) { if (data.dir == ".") { approve() } }
  }
  return "${tag(a)} ${tag(b)} ${tag(c)}"
}

// The canonical hand-written form of the same three handlers.
node canonical(): string {
  let a: Result<string> = handle (act(dir: ".")) with (intr) {
    return match (intr.effect) {
      "app::write" => {
        const data = intr.data
        if (data.dir == ".") { return approve() } else { return reject() }
      }
      _ => return reject()
    }
  }
  let b: Result<string> = handle (act(dir: "/etc")) with (intr) {
    return match (intr.effect) {
      "app::write" => {
        const data = intr.data
        if (data.dir == ".") { return approve() } else { return reject() }
      }
      _ => return reject()
    }
  }
  return "${tag(a)} ${tag(b)}"
}
