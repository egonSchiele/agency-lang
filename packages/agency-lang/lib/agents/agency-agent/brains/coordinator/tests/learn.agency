/*
 * learnSkill and writeToolFor: a one-shot run is refused before any
 * model call or prompt; an accepted skill lands on disk and in the
 * catalog; a rejected review saves nothing; an overlong tool name is
 * refused before any prompt. Roots are repointed at a sandbox under
 * test-output first and verified, so a failing test can never touch
 * the real agent home.
 */
import { remove } from "std::fs"
import { exists } from "std::shell"

import test { _setLearnedRoot, learnedSkillsRoot } from "../../../lib/learned.agency"
import { learnedCatalog } from "../../../lib/learned.agency"
import { NO_REVIEWER, learnSkill, setLearnOneShot, writeToolFor } from "../learn.agency"

def sandboxRoot(node: string): string {
  return "${__dirname}/test-output/learn/${node}"
}

// A fresh sandbox for one node. The delete is fenced to the test's own
// output directory, so a wrong path is refused rather than removed.
// Returns false if the repoint did not take.
def sandboxed(node: string): boolean {
  const root = sandboxRoot(node)
  remove(root, allowedPaths: ["${__dirname}/test-output"]) with approve
  _setLearnedRoot(root)
  setLearnOneShot(false)
  return learnedSkillsRoot() == "${root}/skills"
}

node oneShotRunIsRefusedBeforeAnyPrompt(): boolean {
  if (!sandboxed("one-shot")) {
    return false
  }
  setLearnOneShot(true)
  let raised = 0
  let skillReply = ""
  let toolReply = ""
  handle {
    skillReply = learnSkill("How to orient in an unfamiliar repo")
    toolReply = writeToolFor("Fetch the top stories", "hnTop", "{ maxItems: number }")
  } with (intr) {
    raised = raised + 1
    return approve()
  }
  return raised == 0 && skillReply == NO_REVIEWER && toolReply == NO_REVIEWER
}

// The draft is the one llmMocks entry; the review's bare approve is an
// accept, and the save gate is approved too.
node acceptedSkillIsSavedAndCatalogued(): boolean {
  if (!sandboxed("accepted")) {
    return false
  }
  let reply = ""
  let catalogued = 0
  handle {
    reply = learnSkill("How to orient in an unfamiliar repo")
    catalogued = learnedCatalog().skills.entries.length
  } with approve
  const saved = exists("${learnedSkillsRoot()}/repo-orientation.md")
  return reply.includes("Saved the 'repo-orientation' skill") && saved && catalogued == 1
}

node givenNameAndDescriptionWin(): boolean {
  if (!sandboxed("given")) {
    return false
  }
  let reply = ""
  handle {
    reply = learnSkill("How to orient in an unfamiliar repo", "my-name", "My description")
  } with approve
  const saved = exists("${learnedSkillsRoot()}/my-name.md")
  return reply.includes("Saved the 'my-name' skill") && saved
}

node rejectedReviewSavesNothing(): boolean {
  if (!sandboxed("rejected")) {
    return false
  }
  let reply = ""
  let catalogued = 0
  handle {
    reply = learnSkill("How to orient in an unfamiliar repo")
    catalogued = learnedCatalog().skills.entries.length
  } with (intr) {
    if (intr.effect == "std::skills::review") {
      return reject("not now")
    }
    return approve()
  }
  const saved = exists("${learnedSkillsRoot()}/repo-orientation.md")
  return reply.startsWith("Not saved:") && !saved && catalogued == 0
}

// designTool makes a staging directory before it drafts anything, so
// rejecting that mkdir is the cheapest way through its failure path: no
// model call, and the catalog must be untouched afterwards.
node rejectedToolStagingSavesNothing(): boolean {
  if (!sandboxed("staging-rejected")) {
    return false
  }
  let reply = ""
  let catalogued = 0
  handle {
    reply = writeToolFor("Fetch the top stories", "hnTop", "{ maxItems: number }")
    catalogued = learnedCatalog().tools.length
  } with (intr) {
    if (intr.effect == "std::mkdir") {
      return reject("no staging")
    }
    return approve()
  }
  return reply.startsWith("Not saved:") && catalogued == 0
}

node malformedDraftIsNotSaved(): boolean {
  if (!sandboxed("malformed")) {
    return false
  }
  let raised = 0
  let reply = ""
  handle {
    reply = learnSkill("How to orient in an unfamiliar repo")
  } with (intr) {
    raised = raised + 1
    return approve()
  }
  return raised == 0 && reply.startsWith("Not saved: the draft had the wrong shape")
}

node overlongToolNameIsRefusedBeforeAnyPrompt(): boolean {
  if (!sandboxed("overlong")) {
    return false
  }
  let raised = 0
  let reply = ""
  const name = "aToolNameFarTooLongToAdvertiseBehindTheLearnedPrefixXxYzq"
  handle {
    reply = writeToolFor("Fetch the top stories", name, "{ maxItems: number }")
  } with (intr) {
    raised = raised + 1
    return approve()
  }
  return raised == 0 && reply.startsWith("Not saved:") && reply.includes("56")
}
