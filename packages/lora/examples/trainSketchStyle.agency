// Train a style adapter from an already-captioned folder, then say what
// the file knows about itself.
//
//   agency run --approve lora::train --approve lora::info examples/trainSketchStyle.agency
import { trainLora, loraInfo } from "../index.agency"

node main() {
  const r = trainLora(
    "./drawings",
    "pen and ink",
    "diffusers:Laxhar/noobai-XL-1.1",
    "./adapters/sketch.safetensors",
    steps: 1000,
    flip: true,
    samplePrompts: ["pen and ink, a cat sitting on a chair", "pen and ink, a bicycle leaning against a tree"],
  )
  if (isFailure(r)) {
    print("failed: ${r.error}")
    return
  }
  print("adapter at ${r.value.path} after ${r.value.minutes} minutes; grids: ${r.value.samples.join(", ")}")
  const info = loraInfo(r.value.path)
  if (isSuccess(info)) {
    print("trained on ${info.value.base} for ${info.value.steps} steps, trigger \"${info.value.trigger}\"")
  }
}
