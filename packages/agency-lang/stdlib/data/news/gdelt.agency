import { connectorFetch } from "std::data/connector"

/** @module
  @summary Search recent worldwide news coverage with GDELT.
  ## GDELT — worldwide news coverage

  Search global online news via the [GDELT DOC 2.0 API](https://blog.gdeltproject.org/gdelt-doc-2-0-api-debuts/).
  Find recent articles about an event, company, or topic. Results include
  source links and publication metadata for checking the reporting.

  No API key required. GDELT asks callers to make at most one request every 5 seconds; on a
  zero-match query it returns no `articles` (this connector returns an empty list).

  ### Usage

  ```ts
  import { gdeltNews } from "std::data/news/gdelt"

  node main() {
    const articles = gdeltNews("Federal Reserve interest rate decision", 10, "1w") catch []
    for (article in articles) {
      print("${article.seenDate}  ${article.domain}  ${article.title}")
    }
  }
  ```
*/

effect std::gdelt { query: string }

/** One news article returned by GDELT. `seenDate` is GDELT's `YYYYMMDDTHHMMSSZ` string. */
export type NewsArticle = {
  title: string;
  url: string;
  domain: string;
  language: string;
  sourceCountry: string;
  seenDate: string
}

// resolveUrl adds a slash before the path; buildGdeltPath supplies "doc?...".
// Together they produce the DOC endpoint /api/v2/doc/doc with its query.
const GDELT_BASE = "https://api.gdeltproject.org/api/v2/doc"
const GDELT_DOMAINS = ["api.gdeltproject.org"]

/* Build the GDELT DOC query path (query is URL-encoded). */
def buildGdeltPath(query: string, maxRecords: number, timespan: string): string {
  const q = encodeURIComponent(query)
  const t = encodeURIComponent(timespan)
  return "doc?query=${q}&mode=artlist&format=json&maxrecords=${maxRecords}&timespan=${t}"
}

/* Reshape a raw GDELT DOC response body into NewsArticle[]. */
def parseGdelt(raw: any): NewsArticle[] {
  const r: any = raw ?? {}
  const articles = r.articles ?? []
  return map(articles) as article {
    return {
      title: article.title ?? "",
      url: article.url ?? "",
      domain: article.domain ?? "",
      language: article.language ?? "",
      sourceCountry: article.sourcecountry ?? "",
      seenDate: article.seendate ?? ""
    }
  }
}

/* Turn a fetchJSON Result into the final Result. */
def gdeltFinalize(fetchResult: any): Result {
  return match (fetchResult) {
    success(body) => success(parseGdelt(body))
    failure(err) => failure("GDELT request failed (the API may be rate-limited to 1 request / 5s): ${err}")
  }
}

@capabilities(network)
export def gdeltNews(query: string, maxRecords: number = 25, timespan: string = "3d"): Result<NewsArticle[]> raises <std::gdelt, std::http::fetchJSON> {
  """
  Search recent worldwide news coverage with GDELT. Allow five seconds
  between requests.

  @param query - GDELT DOC search syntax, such as "Federal Reserve rate cut".
  @param maxRecords - Request from 1 through 250 articles.
  @param timespan - How far back to search, such as "24h", "3d", or "1w".
  """
  return interrupt std::gdelt("Search GDELT news for this query?", { query: query })
  // Bind the fetch to its own statement so the std::http::fetchJSON interrupt fires at
  // statement level (resumable) rather than inside a match scrutinee or call argument.
  const result = connectorFetch(GDELT_BASE, GDELT_DOMAINS, buildGdeltPath(query, maxRecords, timespan)) with approve
  return gdeltFinalize(result)
}
