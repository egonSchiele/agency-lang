import { searchTools, searchProviderNames, hostedSearchTools } from "std::agents/lib/search"

// Which keys a developer has set varies, so this pins the invariants that
// hold either way: every name comes from the catalog, and the selected
// provider contributes at most one tool. No keys means an empty array.
node namesComeFromTheCatalog(): boolean {
  const known = ["Tavily", "Brave"]
  return every(searchProviderNames(), \name -> known.includes(name))
}

node atMostOneSearchTool(): boolean {
  const tools = searchTools()
  return tools.length <= 1 && tools.length == searchProviderNames().length
}

// Hosted search is requested from one place rather than hardcoded at each
// agent, and the answer depends on the ROUTE (see _hostedSearchTools in
// stdlib-lib/llm): gpt-4o-mini has hosted search through "openai-responses"
// and none through the base "openai" client, so the same model answers
// differently by provider. An unknown model still requests search, because
// wrongly withholding it is the invisible failure.
node hostedSearchFollowsTheRoute(): boolean {
  const responses = hostedSearchTools("gpt-4o-mini", "openai-responses")
  const base = hostedSearchTools("gpt-4o-mini", "openai")
  const unknown = hostedSearchTools("some-local-model-nobody-shipped")
  return responses.includes("web_search") && base.length == 0 && unknown.includes("web_search")
}
