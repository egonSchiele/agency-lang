import { githubAgent } from "std::agents/github"
import { hostedSearchTools, searchTools } from "std::agents/lib/search"
import { AGENT_SPILL_OVER, llmOptions, withContext } from "std::agents/lib/shared"
import {
  memoryTools,
  webTools,
  ASK_USER_HINT,
  PROGRESS_NOTE,
  SAVE_DRAFT_HINT,
 } from "std::agents/lib/toolkits"
import { guarded } from "std::decorators"
import { edit } from "std::fs"
import { setAgentCwd, getAgentCwd } from "std::index"
import { safeBash } from "std::safeBash"
import { ls, glob, grep, exec } from "std::shell"
import { agentSkill } from "std::skills"
import { readSpill, grepSpill } from "std::spill"
import { systemMessage } from "std::thread"

import { communicationTools } from "./lib/toolkits.agency"

/** @module
@summary Write, edit, and run code to complete a task on disk.

The returned string summarizes the work. Files and other effects are the
deliverable. Use `verifierAgent` afterwards to check the result against the
task, or `std::agents/agency/coding` to generate Agency source as text.

```ts
import { codingAgent } from "std::agents/coding"

node main() {
  const result = codingAgent("Create a CSV report in report.csv")
  print(result)
}
```

When called as an LLM tool, `codingAgent` continues the caller's conversation.
From code, wrap the call in `thread { ... }` to keep its messages out of the
current thread. GitHub work goes through `githubAgent`, which it carries as a
tool.

The model reports progress in a sentence beside each tool call, and
nothing prints it by default. `std::agents/lib/toolkits` shows the
callback that does.
*/

// Kept short on purpose. On SWE-bench, a longer prompt with rules about
// output contracts, planning, and re-checking, together with a closing
// reminder on the task, about doubled the tokens a task took and did not
// raise the pass rate. Beyond the four rules, the prompt carries only the
// hint each tool needs to be used at all: progress sentences, `question`,
// and `saveDraft`.
static const systemPrompt = """You are a coding assistant. Help users inspect files, run commands, and modify code.

- Use read to examine files instead of cat or sed.
- Use edit for targeted changes. Batch changes to one file in a single call.
- Use write only for new files or complete rewrites.
- Be concise in your responses.

## Communicating with the user
${PROGRESS_NOTE}${ASK_USER_HINT}${SAVE_DRAFT_HINT}
"""

static const skills = agentSkill("coding")

/** The most lines `read` returns when the model gives no limit. A model
  that reads a 20,000-line file whole pays for it on every later request. */
static const READ_LINE_LIMIT = 2000

// The read tool with a default limit. `read` itself has none, because a
// program that calls `read("data.csv")` wants the whole file.
idempotent def readCapped(
  filename: string,
  dir: string = ".",
  offset: number = 0,
  limit: number = 0,
): Result {
  """
  Read the contents of a file and return it as a string. At most 2000 lines are returned unless limit says otherwise; a longer file ends with a line saying which lines were shown and how many the file has, and offset reads on from there.

  @param filename - Relative path inside dir; absolute paths, ~, escapes, and symlink components are refused. To reach another directory, pass it as dir.
  @param dir - Base directory for filename
  @param offset - 1-indexed line to start at (0 means start of file)
  @param limit - Maximum number of lines to return (0 means 2000)
  """
  let lines = limit
  if (limit == 0) {
    lines = READ_LINE_LIMIT
  }
  return read(filename: filename, dir: dir, offset: offset, limit: lines, useAgentCwd: true)
}

// safeBash under the name models know. `cwd` is bound to the agent's
// working directory; a command that needs another folder starts with `cd`.
def bashTool(): any {
  return safeBash.partial(cwd: "").rename("bash").describe(
    "Run a bash command in the working directory and return its stdout. A command that exits non-zero fails with its output and exit code, so there is no need to echo the exit status or run it again. Long output is saved; read it with readSpill or grepSpill. A command still running after timeout seconds (default 120) is stopped."
  )
}

// The file and shell tools. These are the bundles in
// std::agents/lib/toolkits with three changes: `read` has a default limit,
// `write` always overwrites, and safeBash is offered as `bash`.
def fileAndShellTools(): any[] {
  return [
    readCapped.rename("read"),
    ls.partial(useAgentCwd: true, respectGitignore: true),
    glob.partial(useAgentCwd: true, respectGitignore: true),
    grep.partial(useAgentCwd: true, respectGitignore: true),
    write.partial(useAgentCwd: true, mode: "overwrite"),
    edit.partial(useAgentCwd: true),
    bashTool(),
    exec.partial(useAgentCwd: true),
    readSpill,
    grepSpill,
  ]
}

export def buildTools(): any[] {
  """
  Return the coding agent's built-in tools for inspection or extension.
  """
  return [
    setAgentCwd,
    getAgentCwd,
    ...fileAndShellTools(),
    githubAgent,
    ...memoryTools(),
    ...webTools(),
    ...searchTools(),
    ...communicationTools(),
    skills,
  ]
}

def solve(
  task: string,
  context: string,
  model: string,
  provider: string,
  extraTools: any[],
): string {
  systemMessage(systemPrompt, expires: "llmCall")
  return llm(
    withContext(task: task, context: context),
    llmOptions(
    model: model,
    provider: provider,
    tools: [...buildTools(), ...extraTools, saveDraft],
    spillToolResultsOver: AGENT_SPILL_OVER,
    hostedTools: hostedSearchTools(model, provider),
  ),
  )
}

/** Called from code, this runs on the caller's thread like any function:
  the tool results and the answer stay there, and the system prompt is
  removed when the agent finishes. Wrap the call in `thread { ... }` to
  keep them apart. */
@guarded(cost: maxCost, time: maxTime)
export handoff def codingAgent(
  task: string,
  context: string = "",
  maxCost: number = $50.00,
  maxTime: number = 30m,
  model: string = "",
  provider: string = "",
  extraTools: any[] = [],
): Result<string> {
  """
  Write, edit, and run code to complete a task on disk. Returns a short
  summary; the real output is filesystem side effects. It continues your
  conversation, so it already sees the work above.

  @param task - What to accomplish
  @param context - Extra material folded into the prompt, or ""
  @param maxCost - Cost budget in USD.
  @param maxTime - Time budget in milliseconds.
  @param model - Model override, or "" for the ambient model
  @param provider - Provider for the model override, ignored when model is empty.
  @param extraTools - Extra tools to offer the LLM, appended to the built-in set
  """

  // Return position: a draft the model saved reaches the guard, which
  // returns it as the backup answer if the budget runs out.
  return solve(
    task: task,
    context: context,
    model: model,
    provider: provider,
    extraTools: extraTools,
  )
}
