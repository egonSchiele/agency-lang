// What the fix pass is told when the grounding review ran out of budget:
// the gaps the review had saved, and nothing for a draft that is not a
// Feedback list. See docs/dev/agents/subagent-budgets.md.
import test { gapsFoundBeforeStop } from "std::agents/researcher"

node savedGapsAreListed(): string {
  return gapsFoundBeforeStop({
    draft: [
      { error: false, feedback: "Q1 is cited" },
      { error: true, feedback: "Q2 has no source", source: "https://example.com/q2" }
    ]
  })
}

node noGapsAddNothing(): string {
  return gapsFoundBeforeStop({ draft: [{ error: false, feedback: "Q1 is cited" }] })
}

// The reviewer in trace iA6rvAcr saved its findings as JSON text.
node aDraftThatIsNotFeedbackAddsNothing(): string {
  return gapsFoundBeforeStop({ draft: "[\"[satisfied] Q1 is cited\"]" })
}

node noDataAddsNothing(): string {
  return gapsFoundBeforeStop(null)
}
