// The catalog of tools a workflow may call: what describe and each
// tool's parameter schema say, in the tool list's order. No node here
// calls a model.
import { catalog, CatalogEntry, CatalogParam } from "std::workflow"
import { add, round } from "std::math"
import { searchNotes } from "./fixtures/tools/notes.agency"
import { addListItems } from "./fixtures/tools/lists.agency"
import { greet, nested, outer } from "./fixtures/tools/withHelper.agency"
import { askPlanner } from "./fixtures/tools/agents.agency"
import { keys } from "std::object"
import { Json } from "std::validation"
import { getMutable, setMutable } from "../../helpers/mutableVar.js"

const DIR = __dirname + "/fixtures/tools"

/** A JSON Schema's `type`, or null for no schema. */
def schemaType(schema: Json): Json {
  if (schema == null) {
    return null
  }
  return schema.type
}

/** One parameter as a row: name, type, default, description. */
def paramRow(param: CatalogParam): Json {
  return [param.name, param.type, param.default, param.description]
}

/** Lists `tools`, recording every effect raised in "effects". A true
  `rejectRead` rejects `std::read`. */
def runCatalog(tools: any[], rejectRead: boolean = false): Result<CatalogEntry[]> {
  setMutable("effects", [])
  handle {
    return catalog(tools, DIR)
  } with (intr) {
    getMutable("effects", []).push(intr.effect)
    if (rejectRead && intr.effect == "std::read") {
      return reject("not this file")
    }
    return approve()
  }
}

node stdToolEntry(): Json {
  const listed = runCatalog([round])
  if (listed is failure(err)) {
    return "failed: ${err}"
  }
  const entry = listed.value[0]
  return [
    entry.module,
    entry.name,
    entry.description.startsWith("Round a number"),
    entry.description.includes("@param"),
    map(entry.params, paramRow),
    entry.params[1].schema.description,
    entry.returns,
    getMutable("effects", [])
  ]
}

node localToolEntry(): Json {
  const listed = runCatalog([searchNotes])
  if (listed is failure(err)) {
    return "failed: ${err}"
  }
  const entry = listed.value[0]
  return [
    entry.module,
    entry.description,
    map(entry.params, paramRow),
    entry.params[0].schema,
    entry.returns,
    getMutable("effects", [])
  ]
}

node entriesFollowTheToolList(): Json {
  const listed = runCatalog([searchNotes, add, round])
  return map(listed catch [], \entry -> entry.name)
}

node refusedLikeCheckWorkflow(): Json {
  const listed = runCatalog([round.partial(precision: 2), add.rename("plus")])
  if (listed is success) {
    return "listed"
  }
  const messages = map(listed.data.problems, \problem -> problem.message)
  return [messages, getMutable("effects", [])]
}

node repeatedToolRefused(): Json {
  const listed = runCatalog([add, add])
  if (listed is success) {
    return "listed"
  }
  return map(listed.data.problems, \problem -> problem.message)
}

node rejectedReadKeepsTheRejection(): Json {
  const listed = runCatalog([searchNotes], true)
  return [isFailure(listed), listed.rejected, listed.data.problems == null]
}

node emptyToolList(): Json {
  return runCatalog([]) catch "failed"
}

node effectsListed(): Json {
  const listed = runCatalog([addListItems, round])
  if (listed is failure(err)) {
    return "failed: ${err}"
  }
  return map(listed.value, \entry -> entry.effects)
}

// The schema of what a reference into the step reads: the success type's
// for a Result, the declared type's otherwise.
node returnSchemas(): Json {
  const listed = runCatalog([searchNotes, round])
  if (listed is failure(err)) {
    return "failed: ${err}"
  }
  const notes = listed.value[0].returnSchema
  const rounded = listed.value[1].returnSchema
  return [notes.type, notes.items.type, keys(notes.items.properties), notes.items.required, rounded.type]
}

// `outer` returns `Outer`, which withHelper.agency imports, so its schema
// prints `Outer` by name and has a binding, although `Outer`'s body names
// `Inner`, which the module never imports. `nested` returns a Record of
// `Outer`, whose schema inlines `Outer` and so prints `Inner`: no binding,
// so the compiler emits no schema rather than one that fails at load.
// `greet` returns a string.
node unboundAliasHasNoReturnSchema(): Json {
  const listed = runCatalog([outer, nested, greet])
  if (listed is failure(err)) {
    return "failed: ${err}"
  }
  return map(listed.value, \entry -> [entry.name, entry.returns, schemaType(entry.returnSchema)])
}

node handoffMarked(): Json {
  const listed = runCatalog([askPlanner, add])
  if (listed is failure(err)) {
    return "failed: ${err}"
  }
  return map(listed.value, \entry -> [entry.name, entry.handoff])
}
