import { writeTool, listTools } from "std::toolbox"
import { exists } from "std::shell"
import { remove } from "std::fs"

const OUT = __dirname + "/test-output"
const TOOLS = __dirname + "/fixtures/tools"

// Approve every non-review interrupt; answer the review with the scripted
// verdicts in order. A null verdict rejects; the string "bare" answers with
// a valueless approve(). Returns writeTool's result.
def runWrite(name: string, dir: string, verdicts: any[]) {
  let reviewCount = 0
  handle {
    return writeTool(name: name, purpose: "Add one to a number.", dir: dir, maxRounds: 3)
  } with (intr) {
    return match (intr.effect) {
      "std::toolbox::review" => {
        const verdict = verdicts[reviewCount]
        reviewCount = reviewCount + 1
        if (verdict == null) {
          return reject("cancelled by the test")
        }
        if (verdict == "bare") {
          return approve()
        }
        return approve(verdict)
      }
      _ => approve()
    }
  }
}

def cleanup(name: string) {
  remove(OUT + "/" + name) with approve
  remove(OUT + "/staging") with approve
}

def savedFiles(name: string): boolean {
  const hasSource = exists("${name}/tool.agency", OUT)
  const hasCases = exists("${name}/tool.test.json", OUT)
  const hasMeta = exists("${name}/meta.json", OUT)
  const stagingGone = !exists("staging/${name}", OUT)
  return hasSource && hasCases && hasMeta && stagingGone
}

node acceptSavesThreeFiles(): boolean {
  cleanup("addOne")
  const result = runWrite("addOne", OUT, [{ verdict: "accept" }])
  const saved = savedFiles("addOne")
  const listed = listTools(OUT) with approve
  let inCatalog = false
  if (listed is success(entries)) {
    inCatalog = some(entries, \entry -> entry.name == "addOne" && entry.broken == null)
  }
  cleanup("addOne")
  return result is success && saved && inCatalog
}

node rejectWritesNothing(): boolean {
  cleanup("addTwo")
  const result = runWrite("addTwo", OUT, [null])
  const nothing = !exists("addTwo", OUT) && !exists("staging/addTwo", OUT)
  const keptMessage = result is failure && "${result.error}" =~ re/cancelled by the test/
  cleanup("addTwo")
  return keptMessage && nothing
}

node reviseRunsASecondRound(): boolean {
  cleanup("addThree")
  const verdicts = [{ verdict: "revise", feedback: "name the variable sum" }, { verdict: "accept" }]
  const result = runWrite("addThree", OUT, verdicts)
  const ok = result is success && result.value.version == 1
  cleanup("addThree")
  return ok
}

// The first draft has an extra export. checkToolShape must send it back
// so the second draft is the one saved: the saved source has no `helper`.
node badShapeGoesBackToTheCodingAgent(): boolean {
  cleanup("addFour")
  const result = runWrite("addFour", OUT, [{ verdict: "accept" }])
  const saved = read("addFour/tool.agency", OUT) with approve
  let cleanSource = false
  if (saved is success(source)) {
    cleanSource = !(source =~ re/helper/)
  }
  cleanup("addFour")
  return result is success && cleanSource
}

// No mocks: the name check runs before staging and before any model call.
// This is the test that fails if the existence check moves later.
node refusesAnExistingName(): boolean {
  const result = runWrite("good", TOOLS, [{ verdict: "accept" }])
  return result is failure && "${result.error}" =~ re/exists/
}

node refusesALongName(): boolean {
  // 65 characters, one over the cap.
  const name = "abbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
  const result = runWrite(name, OUT, [{ verdict: "accept" }])
  return result is failure && "${result.error}" =~ re/64/
}

node refusesAnEmptyDir(): boolean {
  const result = runWrite("addFive", "", [{ verdict: "accept" }])
  return result is failure && "${result.error}" =~ re/dir/
}

node bareApproveAccepts(): boolean {
  cleanup("addSix")
  const result = runWrite("addSix", OUT, ["bare"])
  const saved = savedFiles("addSix")
  cleanup("addSix")
  return result is success && saved
}

// A tool that calls a model draws no test-cases mock and saves without a
// tool.test.json.
node modelToolSkipsTests(): boolean {
  cleanup("greet")
  const result = runWrite("greet", OUT, [{ verdict: "accept" }])
  const hasSource = exists("greet/tool.agency", OUT)
  const hasMeta = exists("greet/meta.json", OUT)
  const noCases = !exists("greet/tool.test.json", OUT)
  cleanup("greet")
  return result is success && hasSource && hasMeta && noCases
}

node refusesTheStagingName(): boolean {
  const result = runWrite("staging", OUT, [{ verdict: "accept" }])
  return result is failure && "${result.error}" =~ re/staging/
}

// std::shell is outside PURE_IMPORTS, so no cases call and no test file.
node impureImportSkipsTests(): boolean {
  cleanup("whichCmd")
  const result = runWrite("whichCmd", OUT, [{ verdict: "accept" }])
  const noCases = !exists("whichCmd/tool.test.json", OUT)
  cleanup("whichCmd")
  return result is success && noCases
}

node reviseWithoutFeedbackFails(): boolean {
  cleanup("addSeven")
  const result = runWrite("addSeven", OUT, [{ verdict: "revise" }])
  const nothing = !exists("addSeven", OUT)
  cleanup("addSeven")
  return result is failure && "${result.error}" =~ re/feedback/ && nothing
}

// Round 1 is pure and writes a test file; the user asks for a revision;
// round 2 calls a model. The saved tool must not ship round 1's tests.
node staleTestFileDoesNotShip(): boolean {
  cleanup("greetTwice")
  const verdicts = [{ verdict: "revise", feedback: "use a model instead" }, { verdict: "accept" }]
  const result = runWrite("greetTwice", OUT, verdicts)
  const noCases = !exists("greetTwice/tool.test.json", OUT)
  const hasSource = exists("greetTwice/tool.agency", OUT)
  cleanup("greetTwice")
  return result is success && hasSource && noCases
}
