      "input": "",
      "expectedOutput": "[\"with-since\"]",
      "evaluationCriteria": [
        {
          "type": "exact"
        }
      ],
      "fetchMocks": [
        {
          "urlPattern": "since=",
          "return": { "posts": [{ "record": { "text": "with-since" } }] }
        },
        {
          "url": "https://public.api.bsky.app/xrpc/app.bsky.feed.searchPosts*",
          "return": { "posts": [{ "record": { "text": "no-since" } }] }
        }
      ]
    },
    {
      "nodeName": "searchOmitsSinceByDefault",
      "input": "",
