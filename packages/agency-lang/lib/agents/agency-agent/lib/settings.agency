/** @module
  Generic on-disk settings for the agency agent — the first general
  settings file (alongside `policy.json` and the history dir under
  `~/.agency-agent`). Stores user preferences only; never secrets.

  Mirrors std::policy's `parsePolicyFile` pattern: read + JSON.parse,
  returning empty settings on any failure so a missing or corrupt file
  never crashes startup.

  ## Usage

  ```ts
  import { loadSettings, saveSettings } from "./settings.agency"

  const s = loadSettings()
  s.search = { backend: "tavily" }
  saveSettings(s)
  ```
*/
import { mkdir } from "std::fs"
import { keys } from "std::object"
import { dirname, basename } from "std::path"
import { exists } from "std::shell"

import { SETTINGS_PATH, POLICY_DIR, SETTINGS_FILE } from "./config.agency"
import { CapabilitySettings, sanitizeCapabilitySettings } from "./capabilities.agency"
import { embeddingSpecHasProvider } from "./models.agency"
import { isKnownSlot, canonicalSlot } from "./slots.agency"


export type SearchSettings = {
  backend?: string
}

export type ModelSettings = {
  provider?: string;
  slots?: Record<string, string>;
  pin?: string
}

export type Settings = {
  search?: SearchSettings;
  model?: ModelSettings;
  capabilities?: CapabilitySettings;
  mcpServers?: Record<string, any>;
  brain?: string;
  presets?: Record<string, any>
}

/** Return a NEW ModelSettings with unknown slot keys dropped (warned). Does NOT
  mutate the input. Pure except the warning print. */
export def sanitizeModelSettings(settings: ModelSettings): ModelSettings {
  // Bind to a local so the null-guard narrows for the loop (member-path
  // narrowing of `settings.slots` does not survive across statements).
  const slots = settings.slots
  if (slots == null) {
    return {
      ...settings
    }
  }
  let kept: Record<string, string> = {}
  for (key in Object.keys(slots)) {
    if (!isKnownSlot(key)) {
      print(
        "Warning: settings.json model.slots has unknown slot '${key}'; ignoring it.",
      )
      continue
    }
    const canonical = canonicalSlot(key)
    if (canonical == "embedding" && !embeddingSpecHasProvider(slots[key])) {
      // The embedding slot points away from the chat provider, so its
      // provider can never be inferred. Require the explicit form.
      print(
        "Warning: settings.json model.slots.embedding needs the provider/model form, e.g. openai/text-embedding-3-small; ignoring it.",
      )
      continue
    }
    kept[canonical] = slots[key]
  }
  return {
    ...settings,
    slots: kept
  }
}

export def getModelSettings(settings: Settings): ModelSettings {
  if (settings.model == null) {
    return {}
  }
  return settings.model
}

/** The capabilities section, or empty when absent. */
export def getCapabilitySettings(settings: Settings): CapabilitySettings {
  if (settings.capabilities == null) {
    return {}
  }
  return settings.capabilities
}

/** The global mcpServers block, or empty when absent. */
export def getMcpServers(settings: Settings): Record<string, any> {
  if (settings.mcpServers == null) {
    return {}
  }
  return settings.mcpServers
}

/** Parse settings.json text. The failure says what is wrong with the file. */
def parseSettingsText(text: string): Result<Settings> {
  const parsed = try JSON.parse(text)
  if (isFailure(parsed)) {
    return failure("${SETTINGS_PATH} is not valid JSON")
  }
  const value = parsed.value
  if (value == null || typeof value != "object" || Array.isArray(value)) {
    return failure("${SETTINGS_PATH} is not a JSON object")
  }
  return success(value)
}

export def readSettingsFile(): Result<Settings> {
  """
  Read settings.json exactly as saved. A missing file reads as empty
  settings. A file that cannot be read or parsed is a failure, so a
  caller that writes the file back never replaces one it could not read.
  """
  if (!exists(SETTINGS_FILE, POLICY_DIR)) {
    return success({})
  }
  const text = read(SETTINGS_FILE, POLICY_DIR)
  if (isFailure(text)) {
    return failure("could not read ${SETTINGS_PATH}: ${text.error}")
  }
  return parseSettingsText(text.value)
}

export def writeSettingsFile(settings: Settings): Result<boolean> {
  """
  Write settings.json, creating the agent home first when it is missing.

  @param settings - The complete settings to write.
  """
  if (!exists(basename(POLICY_DIR), dirname(POLICY_DIR))) {
    const made = mkdir(POLICY_DIR)
    if (isFailure(made)) {
      return failure("could not create ${POLICY_DIR}: ${made.error}")
    }
  }
  const written = write(SETTINGS_FILE, JSON.stringify(settings), POLICY_DIR)
  if (isFailure(written)) {
    return failure("could not write ${SETTINGS_PATH}: ${written.error}")
  }
  return success(true)
}

// Changes the freshly parsed object in place. Nothing else holds it.
def sanitizeSettings(value: Settings): Settings {
  if (value.model != null) {
    value.model = sanitizeModelSettings(value.model)
  }
  if (value.capabilities != null) {
    value.capabilities = sanitizeCapabilitySettings(value.capabilities)
  }
  return value
}

export def loadSettings(): Settings {
  """
  Read settings.json and return the parsed Settings. Returns an empty
  object on any failure (file missing, unreadable, or malformed JSON);
  an unreadable or malformed file also prints a warning.
  """
  // `with approve` auto-approves the read interrupt: settings.json is an
  // agent-internal preferences file the user opted into by running the
  // agent. Mirrors std::policy's `parsePolicyFile` pattern.
  const loaded = readSettingsFile() with approve
  if (isFailure(loaded)) {
    print("Warning: ${loaded.error}; ignoring it.")
    return {}
  }
  return sanitizeSettings(loaded.value)
}

export def saveSettings(settings: Settings) {
  """
  Write settings.json with the given Settings object, creating
  ~/.agency-agent/ if needed. Logs a warning on write failure but does
  not throw.

  @param settings - The Settings object to persist.
  """
  // `with approve`: persisting a user preference must never block the
  // agent on an approval prompt. The user opted in by changing the setting.
  const result = writeSettingsFile(settings) with approve
  if (isFailure(result)) {
    print("Warning: could not save settings: ${result.error}")
  }
}

