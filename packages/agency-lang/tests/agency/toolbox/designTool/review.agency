import { exists } from "std::shell"
import test { cannotFix, unresolvedFor, clearUnresolved } from "std::toolbox"
import { runDesignSeeing, cleanup, shownReviews } from "./helpers.agency"

const OUT = __dirname + "/test-output/review"

// A finding the reviewer marks error=false does not block the draft. It
// used to be thrown away; now the user reads it beside the first draft.
node reviewerAdviceReachesTheUser(): boolean {
  cleanup(OUT, "addAdvised")
  const result = runDesignSeeing(OUT, "addAdvised", ["accept"])
  const seen = shownReviews()
  const shown = seen.length == 1 && seen[0].notes.length == 1 && seen[0].notes[0] =~ re/publicationTime/
  const clean = seen[0].blocking.length == 0 && seen[0].unresolved.length == 0
  cleanup(OUT, "addAdvised")
  return result is success && shown && clean
}

// The reviewer's first blocking findings go back to the author. The user
// sees one review, of the second draft, with nothing open on it.
node firstBlockIsFixedWithoutTheUser(): boolean {
  cleanup(OUT, "addFixed")
  const result = runDesignSeeing(OUT, "addFixed", ["accept"])
  const seen = shownReviews()
  const once = seen.length == 1 && seen[0].blocking.length == 0
  cleanup(OUT, "addFixed")
  return result is success && once
}

// The author answers the reviewer's point with cannotFix. The draft goes
// to the user with the point and the reason, and is not reviewed again:
// the review queue holds one mock, so a second review call would fail.
node cannotFixSkipsTheSecondReview(): boolean {
  cleanup(OUT, "addStuck")
  const result = runDesignSeeing(OUT, "addStuck", ["accept"])
  const seen = shownReviews()
  let told = false
  if (seen.length == 1 && seen[0].unresolved.length == 1) {
    const item = seen[0].unresolved[0]
    told = item.point =~ re/publication time/ && item.reason =~ re/returns a date/
  }
  cleanup(OUT, "addStuck")
  return result is success && told
}

// The redraft that calls cannotFix does not assemble, so another draft is
// written. The open point goes back in the feedback, the author reports
// it again, and it reaches the user with the draft that did assemble.
node pointReportedAgainAfterABrokenRedraft(): boolean {
  cleanup(OUT, "addStuckTwice")
  const result = runDesignSeeing(OUT, "addStuckTwice", ["accept"])
  const seen = shownReviews()
  let told = false
  if (seen.length == 1 && seen[0].unresolved.length == 1) {
    told = seen[0].unresolved[0].point =~ re/publication time/ && !(seen[0].source =~ re/compute/)
  }
  cleanup(OUT, "addStuckTwice")
  return result is success && told
}

// Same three rounds, except the draft that finally assembles reports
// nothing. The author is taken at its word: the point is gone, so the
// draft is reviewed like any other and reaches the user with nothing
// open on it. The review queue holds a mock for that round, which an
// unreviewed draft would leave undrawn.
node redraftThatReportsNothingIsReviewedAgain(): boolean {
  cleanup(OUT, "addUnstuck")
  const result = runDesignSeeing(OUT, "addUnstuck", ["accept"])
  const seen = shownReviews()
  const clean = seen.length == 1 && seen[0].unresolved.length == 0 && seen[0].blocking.length == 0
  cleanup(OUT, "addUnstuck")
  return result is success && clean
}

// The reviewer blocks the redraft too, and the author reported nothing.
// The user is shown the draft with the findings instead of waiting
// through a third round, and may accept it anyway.
node secondBlockGoesToTheUser(): boolean {
  cleanup(OUT, "addBlocked")
  const result = runDesignSeeing(OUT, "addBlocked", ["accept"])
  const seen = shownReviews()
  const shown = seen.length == 1 && seen[0].blocking.length == 1 && seen[0].blocking[0] =~ re/ignores request/
  cleanup(OUT, "addBlocked")
  return result is success && shown
}

// With nobody to review it, as in a one-shot run, the blocked draft is
// not saved and the failure says what the reviewer objected to.
node unacceptedBlockedDraftNamesTheFindings(): boolean {
  cleanup(OUT, "addUnsaved")
  const result = runDesignSeeing(OUT, "addUnsaved", [null])
  let named = false
  if (result is failure(reason)) {
    named = reason =~ re/nobody is here/ && reason =~ re/Reviewer: run ignores request/
  }
  const unsaved = !exists("addUnsaved/impl.agency", OUT)
  cleanup(OUT, "addUnsaved")
  return named && unsaved
}

// Two designTool calls made as tool calls in one LLM round share module
// globals, so the points are kept under each call's staging directory.
node unresolvedPointsAreKeptPerStagingDir(): boolean {
  cannotFix("/staging/a-1", "point a", "reason a")
  cannotFix("/staging/b-2", "point b", "reason b")
  cannotFix("/staging/a-1", "point a2", "reason a2")
  const forA = unresolvedFor("/staging/a-1")
  const forB = unresolvedFor("/staging/b-2")
  clearUnresolved("/staging/a-1")
  const again = unresolvedFor("/staging/a-1")
  clearUnresolved("/staging/b-2")
  return forA.length == 2 && forA[1].point == "point a2" && forB.length == 1 && forB[0].reason == "reason b" && again.length == 0
}
