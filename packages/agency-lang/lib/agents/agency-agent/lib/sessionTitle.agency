/** @module
  @summary The one-line title a saved session shows in the resume picker
  and the REPL footer. Written from the first prompt, then rewritten
  every few turns as a summary of the conversation so far, unless the
  user set one with `/rename`.
*/
import { getThread, listThreads, sessionThreadId } from "std::thread"

// Rewrite the title on turn 1 and every TITLE_EVERY turns after that.
export static const TITLE_EVERY = 5

// The summary call reads the tail of the conversation, not all of it.
static const MAX_CONVERSATION_CHARS = 6000
static const MAX_MESSAGES = 1000

export def shouldRefreshTitle(turns: number): boolean {
  return turns == 1 || turns % TITLE_EVERY == 0
}

type Titled = {
  title: string
}

/** The conversation thread (the brain's `session`) as plain text,
  newest last, cut to the last MAX_CONVERSATION_CHARS. "" when there is
  none. */
export def conversationText(session: string): string {
  const id = sessionThreadId(session)
  if (id == "") {
    return ""
  }
  const info = find(listThreads(false) catch [], \t -> t.id == id)
  if (info == null) {
    return ""
  }
  const offset = Math.max(0, info.messageCount - MAX_MESSAGES)
  const messages = getThread(id, offset, MAX_MESSAGES)
  if (isFailure(messages)) {
    return ""
  }
  let lines: string[] = []
  for (m in messages.value) {
    if ((m.role == "user" || m.role == "assistant") && m.content is string) {
      lines.push("${m.role}: ${m.content}")
    }
  }
  const text = lines.join("\n")
  if (text.length <= MAX_CONVERSATION_CHARS) {
    return text
  }
  return text.slice(text.length - MAX_CONVERSATION_CHARS)
}

static const MAX_TITLE_CHARS = 80

/** The model's title as one plain line: whitespace runs collapsed,
  control characters dropped, cut to MAX_TITLE_CHARS. */
export def cleanTitle(raw: string): string {
  const oneLine = raw.replace(re/[\x00-\x1f\x7f]+/g, " ").replace(re/\s+/g, " ").trim()
  return oneLine.slice(0, MAX_TITLE_CHARS)
}

/** One short title for `text`, which is either the first prompt or the
  conversation so far. Runs in its own thread so the call never touches
  the coordinator's conversation. Fails open to "": a title is never
  worth failing a turn over. */
export def titleFor(text: string): string {
  let title = ""
  const attempt = try titleCall(text)
  if (attempt is success(value)) {
    title = value
  }
  return title
}

def titleCall(text: string): string {
  let out: Titled = { title: "" }
  thread(label: "sessionTitle", session: "sessionTitle") {
    const titled: Titled = llm(
      """
      Write a title for this conversation, at most eight words, as a
      short noun phrase a person could pick out of a list. No quotes,
      no trailing period.

      <conversation>
      ${text}
      </conversation>
      """,
    )
    out = titled
  }
  return cleanTitle(out.title)
}
