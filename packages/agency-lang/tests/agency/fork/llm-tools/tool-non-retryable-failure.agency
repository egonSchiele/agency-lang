// A failure that reports destructive work already ran. runPrompt tells the
// model this tool can no longer be called and drops it, so the next round
// answers without it.

def alwaysFail(): string {
  return failure("permanent failure", { destructiveRan: true })
}

type Resp = {
  msg: string
}

node main() {
  const result: Resp = llm("Call alwaysFail. If its error says the tool can no longer be called, put exactly the string 'tool-removed' in the msg field. Do not try the tool again.", {
    tools: [alwaysFail]
  })
  return result.msg
}
