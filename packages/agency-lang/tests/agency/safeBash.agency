}

node planOutcomes() {
  return [
    planOutcome("git status"),
    // A read needs a file that exists, so this row plans in the fixtures.
    outcomeOf(planFor("cat one.txt && git status", FIXTURES)),
    planOutcome("xargs rm x"),
    planOutcome("echo hi"),
    planOutcome("echo hi > out.txt"),
    planOutcome("rm -rf build"),
    planOutcome("agency typecheck foo.agency"),
    planOutcome("echo hi | cat"),
  ]
}

node rejectedBroadSaysWhy() {
  const result = safeBash("xargs echo hi")
  if (result is failure(why)) {
    return why
  }
  return "UNEXPECTEDLY RAN"
}

node rejectedAuditSaysWhy() {
  const result = safeBash("echo hi | cat")
  if (result is failure(why)) {
    return why
  }
  return "UNEXPECTEDLY RAN"
}

node rejectedNarrowIsUnchanged() {
  const result = safeBash("git status")
  if (result is failure(why)) {
    return why
  }
  return "UNEXPECTEDLY RAN"
}

// The tool loop tells "the user said no" from "the tool broke" by the
// failure's rejected flag, so safeBash must pass a rejection on with it.
node rejectionKeepsFlag() {
  const narrow = safeBash("git status")
  const broad = safeBash("xargs echo hi")
  let flags: boolean[] = []
  for (result in [narrow, broad]) {
    if (isFailure(result)) {
      flags = [...flags, result.rejected]
    }
  }
  return flags
}

node newShapes() {
  return [
    planSummary("git status | git log"),
    planSummary("git status | head"),
    planSummary("echo hi 2>&1"),
    planSummary("echo hi 2>&1 > out.txt"),
    planSummary("echo *.md"),
    planSummary("rm -rf x | cat"),
    planSummary("make 2>&1 | tail -100"),
    planReason("git status | head"),
    executionCommand("git    status |  git   log"),
  ]
}

node pipelineRunsThroughBash() {
  // `tr` has no rule, so this plan is broad and runs the original text.
  // What this pins is that a pipe in a broad string reaches bash through
  // _bash and produces bash's output. The rebuilt-text path through a
  // pipe is pinned by the executionCommand row in newShapes.
  const result = safeBash("echo hi | tr a-z A-Z")
  if (result is failure(why)) {
    return "FAILED: ${why}"
  }
  return result.value
}

def split(source: string): any {
  const parsed = bashParser(source)
  if (parsed is failure(why)) {
    return "UNPARSEABLE"
  }
  const first = parsed.value[0]
  if (!(first is { tag: "simpleCommand" })) {
    return "NOT-SIMPLE"
  }
  const result = splitFlags("grep", first, GREP_FLAGS)
  if (result is failure(why)) {
    return why
  }
  const args = result.value
  const values = [entry.flag + "=" + entry.value for entry in args.values]
  return [args.plain, values, args.positionals.length]
}

node splitGrepFlags() {
  return [
    split("grep -rni hello ."),
    split("grep -A 3 hello ."),
    split("grep -A3 hello ."),
    split("grep -e hello ."),
    split("grep --color=never hello ."),
    split("grep -nA3 hello ."),
    split("grep -z hello ."),
    split("grep -R hello ."),
    split("grep -e a -e b ."),
    split("grep \"-R\" hello"),
    split("grep -A"),
    split("grep --filter=x hello ."),
    split("grep --save-config hello ."),
    split("grep --include=*.ts -rn hello ."),
    split("grep -e \"-x\" one.txt"),
    split("grep -n hello one.txt -s"),
    split("grep --color=always x one.txt"),
  ]
}

/** A find-shaped table: single-dash flags are whole words. */
static const WHOLE_FLAGS: FlagSpec = {
  plain: ["-print"],
  valued: ["-name"],
  optionsFirst: false,
  wholeWords: true
}

def splitSummary(source: string, spec: FlagSpec): any {
  const parsed = bashParser(source)
  if (parsed is failure(why)) {
    return "UNPARSEABLE"
  }
  const first = parsed.value[0]
  if (!(first is { tag: "simpleCommand" })) {
    return "NOT-SIMPLE"
  }
  const result = splitFlags("x", first, spec)
  if (result is failure(why)) {
    return why
  }
  const args = result.value
  const values = [entry.flag + "=" + entry.value for entry in args.values]
  return [args.plain, values, args.positionals.length]
}

node wholeShortFlags() {
  return [
    splitSummary("x -name foo -print f", WHOLE_FLAGS),
    splitSummary("x -name", WHOLE_FLAGS),
    splitSummary("x -nam f", WHOLE_FLAGS),
    splitSummary("x -name=foo f", WHOLE_FLAGS),
    splitSummary("x -n f", WHOLE_FLAGS),
  ]
}

static const FIXTURES = __dirname + "/stdlib/grep-fixtures"

/** The package directory, whose node_modules exists in every checkout
 * and whose .gitignore ignores everything inside it. */
static const PACKAGE_DIR = __dirname + "/../.."

def grepNames(source: string): any {
  const plan = planFor(source, FIXTURES)
  const names = [effect.name for effect in plan.effects]
  return [names, plan.broadReason]
}

def grepPayloadOf(source: string): any {
  const plan = planFor(source, FIXTURES)
  for (effect in plan.effects) {
    if (effect.name == "std::grep") {
      return effect.payload
    }
  }
  return "NO GREP EFFECT"
}

node grepThroughBash() {
  // Not lone (a pipe or a redirect), or a flag the tool lacks: the
  // command runs through bash, narrow only for one file.
  return [
    grepNames("grep -c hello one.txt"),
    grepNames("grep -A 1 hello one.txt"),
    grepNames("grep -n \"a+b\" one.txt"),
    grepNames("grep -n hello one.txt > out.txt"),
    grepNames("git status && grep -n hello one.txt"),
  ]
}

node grepUnrecognized() {
  return [
    grepNames("grep hello"),
    grepNames("grep -z hello ."),
    grepNames("grep -R hello ."),
    grepNames("grep \"-R\" hello"),
    grepNames("grep -e a -e b ."),
    grepNames("grep --filter=x hello ."),
    grepNames("grep -rn $PAT ."),
    grepNames("grep -rn hello *.txt"),
    grepNames("grep -rn hello one.txt two.txt"),
    grepNames("grep -rn hello --include='*.txt' ."),
    grepNames("grep -c hello ."),
    grepNames("git status && grep -rn hello ."),
    grepNames("rg hello ."),
    grepNames("git status && grep -n hello one.txt -s"),
    grepNames("grep -e \"-x\" one.txt"),
    grepNames("grep --include=*.txt -rn hello ."),
  ]
}

node grepMissingPath() {
  // The detail names an absolute path, which differs per machine, so
  // only the kind is pinned.
  const reason = planFor("grep -rn hello missing-dir", FIXTURES).broadReason
  if (reason == null) {
    return null
  }
  return reason.kind
}

node grepBashPayload() {
  const payload = grepPayloadOf("grep -cin hello one.txt")
  return [payload.pattern, payload.file, payload.ignoreCase, payload.maxResults, payload.flags]
}

def executionKind(source: string): string {
  return planFor(source, FIXTURES).execution.kind
}

node loneGrepIsShellFree() {
  return [
    executionKind("grep -rn hello ."),
    executionKind("grep -rn hello"),
    executionKind("grep -n hello one.txt"),
    executionKind("grep -rniwl hello ."),
    executionKind("grep -rnF \"a+b\" ."),
    executionKind("grep -rnE \"hello|goodbye\" ."),
    executionKind("grep -c hello one.txt"),
    executionKind("grep -n \"a+b\" one.txt"),
    executionKind("grep hello ."),
    executionKind("grep -rn hello . | head"),
    outcomeOf(planFor("grep -rn hello .", FIXTURES)),
    executionKind("grep -rnw \" world\" ."),
    executionKind("grep -n hello one.txt -s"),
  ]
}

node shellFreePayloads() {
  const fixed = grepPayloadOf("grep -rnF \"a+b\" .")
  const dirSearch = grepPayloadOf("grep -rn hello .")
  const fileSearch = grepPayloadOf("grep -n hello one.txt")
  return [
    fixed.pattern,
    [dirSearch.file, dirSearch.maxResults, dirSearch.flags],
    [fileSearch.file, fileSearch.dir == dirSearch.dir],
  ]
}

/** The output's lines in a fixed order, without safeBash's own note lines.
 * grep and the tool's walk visit files in different orders. */
def sortedLines(text: string): string {
  const lines = text.split("\n")
  const matches = [line for line in lines if line != "" && !line.startsWith("(safeBash")]
  return JSON.stringify(matches.sort())
}

def parityOf(source: string): any {
  // Without this check, a row whose command fell back to the bash path
  // would compare real grep with itself and pass for no reason.
  if (planFor(source, FIXTURES).execution.kind != "grep") {
    return "NOT SHELL-FREE: ${source}"
  }
  let ours = ""
  let theirs = ""
  handle {
    const shellFree = safeBash(source, cwd: FIXTURES)
    if (shellFree is success(out)) {
      ours = out
    }
    // bash returns an ExecResult, not a Result.
    const real = bash(source, cwd: FIXTURES)
    theirs = real.stdout
  } with approve
  if (sortedLines(ours) == sortedLines(theirs)) {
    return true
  }
  return [source, ours, theirs]
}

node shellFreeMatchesRealGrep() {
  // No row runs `grep -rn hello` with no path: GNU grep prints bare names
  // there, and BSD grep, macOS's grep, prints `./one.txt`. The rendering
  // follows GNU, and a grepDialect unit test pins it.
  return [
    parityOf("grep -n hello one.txt"),
    parityOf("grep hello one.txt"),
    parityOf("grep -rn hello ."),
    parityOf("grep -rh hello ."),
    parityOf("grep -rl hello ."),
    parityOf("grep -rni hello ."),
    parityOf("grep -rnw hello ."),
    parityOf("grep -rnv hello ."),
    parityOf("grep -rnF \"o w\" ."),
    parityOf("grep -rnE \"hello|goodbye\" ."),
    parityOf("grep -rn \"^hello\" ."),
    parityOf("grep -rn 'world$' ."),
    parityOf("grep -rn \"h.l*o\" ."),
    parityOf("grep -Hn hello one.txt"),
    parityOf("grep -n hello one.txt -s"),
  ]
}

node loneGrepAsksOneQuestion() {
  // One std::grep approval, and no shell: a std::bash prompt would fail
  // the run, because the test file answers only the grep message.
  const result = safeBash("grep -rn hello .", cwd: FIXTURES)
  if (result is failure(why)) {
    return "FAILED: ${why}"
  }
  return [result.value.includes("./one.txt:1:hello world"), result.value.includes("skips node_modules")]
}

node bashGrepOfOneFile() {
  // -c has no tool equivalent, so real grep runs after one std::grep approval.
  const result = safeBash("grep -c hello one.txt", cwd: FIXTURES)
  if (result is failure(why)) {
    return "FAILED: ${why}"
  }
  return result.value
}

node shellFreeNoMatchFails() {
  const result = safeBash("grep -rn nothing-matches-this .", cwd: FIXTURES)
  if (result is failure(why)) {
    return [why.includes("\"exitCode\":1"), why.includes("skips node_modules")]
  }
  return "UNEXPECTEDLY MATCHED"
}

node grepUnderRecommendedNeedsNoPrompt() {
  // The launch directory is the package directory, so the fixtures are
  // inside it and recommended approves std::grep there. This test has no
  // interruptHandlers entry, so an unanswered interrupt fails the run.
  let found = false
  handle {
    const result = safeBash("grep -rn hello " + FIXTURES)
    if (result is success(text)) {
      found = text.includes("hello again")
    }
  } with (intr) {
    if (checkPolicy(recommendedAutoApprovePolicy, intr).type == "approve") {
      return approve()
    }
    return reject()
  }
  return found
}

node grepOutsideTheLaunchDirIsUndecided() {
  const plan = planFor("grep -rn root /etc", FIXTURES)
  const effect: any = plan.effects[0]
  const intr = { effect: effect.name, data: effect.payload }
  return checkPolicy(recommendedAutoApprovePolicy, intr).type
}

node rejectedGrepNamesTheTool() {
  const result = safeBash("grep -z hello .", cwd: FIXTURES)
  if (result is failure(why)) {
    return why
  }
  return "UNEXPECTEDLY RAN"
}

node grepOfIgnoredFolder() {
  // A lone grep of a folder .gitignore ignores runs the tool's search like a
  // grep of any other folder, because the tool searches a folder it is given
  // whatever the .gitignore files above it say.
  const plan = planFor("grep -rn parseAgency node_modules", PACKAGE_DIR)
  const names = [effect.name for effect in plan.effects]
  return [plan.execution.kind, names, plan.broadReason]
}

node grepOfPartlyIgnoredFolder() {
  // The repository's .gitignore ignores some entries of stdlib (`.*`,
  // `**/*.js`) but not all of them, so the tool's search still finds the
  // rest and the grep runs shell-free.
  return planFor("grep -rn hello stdlib", PACKAGE_DIR).execution.kind
}

def stdinFlags(source: string): any {
  const parsed = bashParser(source)
  if (parsed is failure(why)) {
    return "UNPARSEABLE"
  }
  const flat = flattenCommands(parsed.value)
  return [entry.readsStdin for entry in flat]
}

node stagesReadStdin() {
  return [
    stdinFlags("git status"),
    stdinFlags("a | b | c"),
    stdinFlags("a | b && c"),
    stdinFlags("(a | b) | c"),
    stdinFlags("a; b | c"),
    stdinFlags("a | (b && c)"),
    stdinFlags("a | (b | c)"),
  ]
}

node grepFilterStages() {
  return [
    grepNames("git status | grep hello"),
    grepNames("git status | grep -v hello | grep -c x"),
    grepNames("git status | grep -rn hello"),
    grepNames("git status | grep hello one.txt"),
    grepNames("git status | grep hello > out.txt"),
    grepNames("git status | grep hello && grep bye"),
    grepNames("git status | grep -R hello"),
    grepNames("echo hi | grep h"),
    grepNames("git status | grep hello -i"),
    grepNames("git status | grep -e hello"),
  ]
}

def filesOf(found: any): any {
  return match(found) {
    { kind: "stdin" } => "stdin"
    { kind: "files", paths } => [p.filename for p in paths]
  }
}

def readOf(source: string): any {
  const parsed = bashParser(source)
  if (parsed is failure(why)) {
    return "UNPARSEABLE"
  }
  const first = parsed.value[0]
  if (first is { tag: "simpleCommand" }) {
    const verb = verbName(first)
    const spec = READ_VERBS[verb]
    if (spec == null) {
      return "NOT A READ VERB"
    }
    return match(readFileVerb(verb, first, FIXTURES, spec)) {
      success(found) => filesOf(found)
      failure(why) => why
    }
  }
  return "NOT-SIMPLE"
}

node readVerbsReadFiles() {
  return [
    readOf("cat one.txt"),
    readOf("cat one.txt two.txt"),
    readOf("cat -n one.txt"),
    readOf("head one.txt"),
    readOf("head -n 20 one.txt"),
    readOf("head -20 one.txt"),
    readOf("tail -n5 one.txt"),
    readOf("wc -l one.txt"),
    readOf("diff one.txt two.txt"),
    readOf("sort -u one.txt"),
    readOf("uniq -c one.txt"),
    readOf("cat"),
    readOf("head -n 3"),
    readOf("head one.txt two.txt"),
    readOf("uniq one.txt out.txt"),
    readOf("tail -n +5 one.txt"),
    readOf("head -n -5 one.txt"),
    readOf("tail -f one.txt"),
    readOf("cat -A one.txt"),
    readOf("cat $F"),
    readOf("cat *.txt"),
    readOf("diff one.txt"),
    readOf("diff -r one.txt two.txt"),
    readOf("cat ."),
    // The message names an absolute path, which differs per machine.
    readOf("cat nope.txt").startsWith("No file or directory at"),
    readOf("sort -o out.txt one.txt"),
    readOf("cat one.txt -n"),
    readOf("cut -c 1-3 one.txt"),
    readOf("diff"),
    readOf("diff -U x one.txt two.txt"),
    readOf("head -n 1 -n 2 one.txt"),
    readOf("head -2 -n 1 one.txt"),
  ]
}

node readsAskStdRead() {
  return [
    grepNames("cat one.txt"),
    grepNames("cat one.txt two.txt"),
    grepNames("wc -l one.txt"),
    grepNames("diff one.txt two.txt"),
    grepNames("sort one.txt"),
    grepNames("cat one.txt > copy.txt"),
    grepNames("git status && cat one.txt"),
    grepNames("cat one.txt | head -3"),
    grepNames("head -3 one.txt | cat"),
    grepNames("cat"),
    grepNames("cat -A one.txt"),
    grepNames("tail -f one.txt"),
    grepNames("cat ."),
  ]
}

/** A folder of its own for the symlink test. A link in FIXTURES would
 * change the output of the grep parity rows, which search it with -r. */
static const LINK_FIXTURE = __dirname + "/stdlib/__safebash_link__"

node readPayloadNamesTheRealParent(): any {
  remove(LINK_FIXTURE) with approve
  mkdir(LINK_FIXTURE) with approve
  bash("mkdir inside outside && echo hi > outside/target.txt && ln -s ../outside/target.txt inside/link.txt", cwd: LINK_FIXTURE) with approve
  let dir = ""
  let filename = ""
  const plan = planFor("cat link.txt", LINK_FIXTURE + "/inside")
  for (effect in plan.effects) {
    if (effect.name == "std::read") {
      dir = effect.payload.dir
      filename = effect.payload.filename
    }
  }
  remove(LINK_FIXTURE) with approve
  return [dir == LINK_FIXTURE + "/outside", filename]
}

node inputRedirectIsARead() {
  return [
    grepNames("git status < one.txt"),
    grepNames("cat < one.txt"),
    grepNames("echo hi < one.txt > copy.txt"),
    grepNames("git status < $F"),
    grepNames("git status < one.txt < two.txt"),
    grepNames("git status < ."),
    grepNames("git status | grep hello < one.txt"),
    grepNames("echo hi < one.txt"),
  ]
}

node filtersInAPipe() {
  return [
    grepNames("git log | sort | uniq -c"),
    grepNames("cat one.txt | sort -u"),
    grepNames("cat one.txt | cut -d : -f 1"),
    grepNames("cat one.txt | tr a b"),
    grepNames("cat one.txt | tr -d x"),
    grepNames("cat one.txt | tr -s a b"),
    grepNames("cat one.txt | tr a"),
    grepNames("cat one.txt | sort two.txt"),
    grepNames("cat one.txt | sort -o out.txt"),
    grepNames("sort one.txt"),
    grepNames("git log | tee log.txt"),
    grepNames("git log | xargs echo"),
    grepNames("git log | sort > sorted.txt"),
    grepNames("git log | tac"),
    grepNames("cut -d, -f1 one.txt"),
    grepNames("tr a b"),
    grepNames("cat one.txt | tr a $B"),
    grepNames("cat one.txt | tr -dd x"),
  ]
}

/** A plan made in the fixture folder: its outcome, each effect's name and
  the file it reads, and the broad reason. */
def fixtureReadRow(source: string): any {
  const plan = planFor(source, FIXTURES)
  const effects: any[] = plan.effects
  return [outcomeOf(plan), [[effect.name, effect.payload.filename] for effect in effects], plan.broadReason]
}

/** A plan made in a folder that does not exist: its outcome, each
  effect's name and payload, and the broad reason. */
def wordRow(source: string): any {
  const plan = planFor(source, "/repo")
  const effects: any[] = plan.effects
  return [outcomeOf(plan), [[effect.name, effect.payload] for effect in effects], plan.broadReason]
}

// tarsec 0.5.8 reads `,`, `@`, and `%` as word characters, and braces bash
// does not expand. These lines were unparseable before it, and the rules
// that already exist recognize them now.
node wordsTarsecNowAccepts() {
  return [
    fixtureReadRow("cut -d, -f1 one.txt"),
    fixtureReadRow("sort -k2,2n one.txt"),
    wordRow("git show HEAD@{1}"),
    wordRow("date +%Y"),
    wordRow("echo a{b,c}"),
  ]
}

node readUnderRecommendedNeedsNoPrompt() {
  // The launch directory is the package directory, so the fixtures are
  // inside it and recommended approves std::read there, and it approves
  // git status anywhere. This test has no interruptHandlers entry, so an
  // unanswered interrupt fails the run.
  let found = false
  handle {
    const result = safeBash("wc -l " + FIXTURES + "/one.txt && git status")
    if (result is success(text)) {
      found = text.includes("one.txt")
    }
  } with (intr) {
    if (checkPolicy(recommendedAutoApprovePolicy, intr).type == "approve") {
      return approve()
    }
    return reject()
  }
  return found
}

node readOutsideTheLaunchDirIsUndecided() {
  const plan = planFor("cat /etc/hosts", FIXTURES)
  for (effect in plan.effects) {
    if (effect.name == "std::read") {
      const intr = { effect: effect.name, data: effect.payload }
      return checkPolicy(recommendedAutoApprovePolicy, intr).type
    }
  }
  return "NO READ EFFECT"
}

node readAsksExactlyOneQuestion() {
  // The test file answers one std::read and one std::git::status message.
  // A std::bash prompt, or a second read, would fail the run.
  const result = safeBash("wc -l one.txt && git status", cwd: FIXTURES)
  if (result is failure(why)) {
    return "FAILED: ${why}"
  }
  return result.value.includes("one.txt")
}

node rejectedReadNamesTheTool() {
  const result = safeBash("cat -A one.txt", cwd: FIXTURES)
  if (result is failure(why)) {
    return why
  }
  return "UNEXPECTEDLY RAN"
}

node loneReadIsShellFree() {
  return [
    outcomeOf(planFor("cat one.txt", FIXTURES)),
    outcomeOf(planFor("cat -n one.txt", FIXTURES)),
    outcomeOf(planFor("head -3 one.txt", FIXTURES)),
    outcomeOf(planFor("tail -n 2 one.txt", FIXTURES)),
    outcomeOf(planFor("cat -b one.txt", FIXTURES)),
    outcomeOf(planFor("head -c 5 one.txt", FIXTURES)),
    outcomeOf(planFor("head -n 0 one.txt", FIXTURES)),
    outcomeOf(planFor("cat one.txt two.txt", FIXTURES)),
    outcomeOf(planFor("cat one.txt > copy.txt", FIXTURES)),
    outcomeOf(planFor("cat one.txt | head", FIXTURES)),
    outcomeOf(planFor("wc -l one.txt", FIXTURES)),
    outcomeOf(planFor("cat nope.txt", FIXTURES)),
    outcomeOf(planFor("head -n 1 -n 2 one.txt", FIXTURES)),
    outcomeOf(planFor("head -2 -n 1 one.txt", FIXTURES)),
    outcomeOf(planFor("tail -n 1 -n 2 one.txt", FIXTURES)),
    outcomeOf(planFor("head one.txt two.txt", FIXTURES)),
    outcomeOf(planFor("cat -n one.txt two.txt", FIXTURES)),
  ]
}

/** Files whose line endings test the shell-free rendering, kept apart
 * from FIXTURES so no grep parity row's output changes. */
static const READ_FIXTURES = __dirname + "/stdlib/read-fixtures"

def exactParityOf(source: string, kind: string, cwd: string): any {
  // Without this check, a row whose command fell back to the bash path
  // would compare the real program with itself and pass for no reason.
  if (planFor(source, cwd).execution.kind != kind) {
    return "NOT SHELL-FREE: ${source}"
  }
  let ours = ""
  let theirs = ""
  let failed = ""
  handle {
    const shellFree = safeBash(source, cwd: cwd)
    if (shellFree is success(out)) {
      ours = out
    } else if (shellFree is failure(why)) {
      failed = "${why}"
    }
    // bash returns an ExecResult, not a Result.
    const real = bash(source, cwd: cwd)
    theirs = real.stdout
  } with approve
  // A failure is reported, not compared: a failed run and a program that
  // printed nothing would otherwise both be "".
  if (failed != "") {
    return "FAILED: ${failed}"
  }
  // These commands print in order, so the comparison is exact.
  if (ours == theirs) {
    return true
  }
  return [source, ours, theirs]
}

node shellFreeReadMatchesRealTools() {
  return [
    exactParityOf("cat one.txt", "read", READ_FIXTURES),
    exactParityOf("cat -n one.txt", "read", READ_FIXTURES),
    exactParityOf("head -1 one.txt", "read", READ_FIXTURES),
    exactParityOf("head -n 1 one.txt", "read", READ_FIXTURES),
    exactParityOf("head -n 100 one.txt", "read", READ_FIXTURES),
    exactParityOf("tail -1 one.txt", "read", READ_FIXTURES),
    exactParityOf("tail -n 100 one.txt", "read", READ_FIXTURES),
    exactParityOf("cat noeol.txt", "read", READ_FIXTURES),
    exactParityOf("cat -n noeol.txt", "read", READ_FIXTURES),
    exactParityOf("tail -1 noeol.txt", "read", READ_FIXTURES),
    exactParityOf("cat empty.txt", "read", READ_FIXTURES),
    exactParityOf("cat -n empty.txt", "read", READ_FIXTURES),
    exactParityOf("cat crlf.txt", "read", READ_FIXTURES),
    exactParityOf("tail -1 crlf.txt", "read", READ_FIXTURES),
    exactParityOf("cat one.txt noeol.txt", "read", READ_FIXTURES),
    exactParityOf("cat noeol.txt one.txt", "read", READ_FIXTURES),
    exactParityOf("cat empty.txt one.txt", "read", READ_FIXTURES),
    exactParityOf("cat one.txt one.txt", "read", READ_FIXTURES),
  ]
}

node catOfTwoFilesAsksTwoQuestions() {
  // Two std::read approvals, one per file, and no shell. The plan's kind
  // comes first, because the bash path asks the same two questions and
  // prints the same text; only the kind tells the two apart.
  const kind = planFor("cat one.txt two.txt", FIXTURES).execution.kind
  const result = safeBash("cat one.txt two.txt", cwd: FIXTURES)
  if (result is failure(why)) {
    return "FAILED: ${why}"
  }
  return [kind, result.value]
}

node loneReadAsksOneQuestion() {
  // One std::read approval, and no shell: a std::bash prompt would fail
  // the run, because the test file answers only the read message.
  const result = safeBash("head -1 one.txt", cwd: FIXTURES)
  if (result is failure(why)) {
    return "FAILED: ${why}"
  }
  return result.value
}

/** A folder of its own for the tests that write through bash. */
static const SHELL_FIXTURE = __dirname + "/stdlib/__safebash_shell__"

node ampersandRedirectWritesTheFile() {
  // `&>` is a redirect of both streams in bash. Under dash it would be
  // `echo hi &` and then `> out.txt`, which empties the file and prints to
  // stdout. The test file approves the std::bash question.
  remove(SHELL_FIXTURE) with approve
  mkdir(SHELL_FIXTURE) with approve
  const ran = safeBash("echo hi &> out.txt", cwd: SHELL_FIXTURE)
  const written = read("out.txt", SHELL_FIXTURE) with approve
  remove(SHELL_FIXTURE) with approve
  return match(ran) {
    success(out) => [out, written]
    failure(why) => "FAILED: ${why}"
  }
}

node echoIsTheSameAloneAndInAChain() {
  // bash's echo does not read backslash escapes, alone or in a chain. The
  // lone echo asks nothing; the chain asks std::bash, which is the one
  // question the test file approves. The trailing `true` has no rule, so
  // the chain stays on the bash path even when chains of echoes run in
  // process; without it this node would compare the in-process echo with
  // itself.
  const alone = safeBash("echo 'a\\tb'")
  const chain = safeBash("echo 'a\\tb'; echo x; true")
  return [alone, chain]
}

node bashOnlyFormsStayUnparseable() {
  // The parser accepts what bash 3.2 accepts, because macOS ships that
  // version. `|&` and `&>>` are bash 4 forms; 3.2 rejects both with a
  // syntax error, so a parser that accepted them would make a narrow plan
  // fail there. Pinned so a tarsec release cannot widen this unnoticed.
  return [grepNames("make |& tail"), grepNames("echo hi &>> log")]
}

node shellFreeEchoMatchesBash() {
  return [
    exactParityOf("echo hi", "echo", FIXTURES),
    exactParityOf("echo -n hi", "echo", FIXTURES),
    exactParityOf("echo -n", "echo", FIXTURES),
    exactParityOf("echo -nn a b", "echo", FIXTURES),
    exactParityOf("echo 'a\\tb'", "echo", FIXTURES),
  ]
}

def chainSummary(source: string): any {
  const plan = planFor(source, FIXTURES)
  return [outcomeOf(plan), plan.execution.kind, [e.name for e in plan.effects]]
}

node chainsOfInProcessCommands() {
  return [
    chainSummary("echo a; echo b"),
    chainSummary("echo \"=== one ===\"; cat one.txt; echo; echo \"=== two ===\"; cat two.txt"),
    chainSummary("cat one.txt && cat two.txt"),
    chainSummary("grep hello one.txt || echo none"),
    chainSummary("echo a && echo b || echo c"),
    chainSummary("echo a; git status"),
    chainSummary("echo a; true"),
    chainSummary("echo a && (echo b || echo c)"),
    chainSummary("echo a; cat one.txt | head"),
    chainSummary("cat nope.txt; echo hi"),
    chainSummary("echo hi > out.txt; cat out.txt"),
    chainSummary("cat one.txt && rm one.txt"),
    chainSummary("echo a; agency --version"),
  ]
}

node chainMatchesBash() {
  // Every grep here names one file, so no skipped-folders note appears
  // and the comparison can be exact.
  return [
    exactParityOf("echo \"=== one ===\"; cat one.txt; echo; echo \"=== two ===\"; cat two.txt", "chain", FIXTURES),
    exactParityOf("cat one.txt && echo finished", "chain", FIXTURES),
    exactParityOf("grep hello one.txt || echo none", "chain", FIXTURES),
    exactParityOf("grep zzz one.txt || echo none", "chain", FIXTURES),
    exactParityOf("echo a && echo b || echo c", "chain", FIXTURES),
    exactParityOf("cat -n one.txt; cat -n two.txt", "chain", FIXTURES),
  ]
}

/** A folder of its own for the chain test that really writes. */
static const CHAIN_FIXTURE = __dirname + "/stdlib/__safebash_chain__"

def destructiveFlag(result: Result<string>): any {
  if (result is failure) {
    return result.destructiveRan
  }
  return "UNEXPECTEDLY SUCCEEDED"
}

node chainFailureAfterAWriteIsDestructive() {
  remove(CHAIN_FIXTURE) with approve
  mkdir(CHAIN_FIXTURE) with approve
  bash("cp " + FIXTURES + "/one.txt .", cwd: CHAIN_FIXTURE) with approve
  // The write ran, then the grep found nothing. The failure must say a
  // destructive step ran, or the tool loop may retry and write twice.
  const after = safeBash("echo hi > out.txt; grep zzz one.txt", cwd: CHAIN_FIXTURE)
  // Here the grep fails first and && skips the write, so nothing ran.
  const before = safeBash("grep zzz one.txt && echo hi > out.txt", cwd: CHAIN_FIXTURE)
  remove(CHAIN_FIXTURE) with approve
  return [destructiveFlag(after), destructiveFlag(before)]
}

node chainFailsLikeBash() {
  // grep with no match exits 1, so && skips the echo and the chain fails;
  // || runs it and the chain succeeds. Approved by the test file.
  const skipped = safeBash("grep zzz one.txt && echo yes", cwd: FIXTURES)
  const ran = safeBash("grep zzz one.txt || echo no", cwd: FIXTURES)
  return [skipped is failure, ran]
}

node chainOfReadsAsksOnlyTheReads() {
  // The two cats ask std::read each; the echoes ask nothing, and no
  // shell runs.
  const result = safeBash("echo \"=== one ===\"; cat one.txt; echo; echo \"=== two ===\"; cat two.txt", cwd: FIXTURES)
  if (result is failure(why)) {
    return "FAILED: ${why}"
  }
  return result.value
}

/** The folder that holds the two fixture folders. */
static const STDLIB_TESTS = __dirname + "/stdlib"

/** A plan's outcome, and for each effect its name and the last folder of
  the directory its payload names. */
def cdSummary(source: string): any {
  const plan = planFor(source, STDLIB_TESTS)
  let seen: any[] = []
  for (effect in plan.effects) {
    seen.push([effect.name, payloadFolder(effect)])
  }
  return [outcomeOf(plan), seen]
}

def payloadFolder(effect: any): string {
  const payload = effect.payload
  if (payload == null) {
    return ""
  }
  const dir: string = payload.dir ?? payload.cwd ?? ""
  const parts = dir.split("/")
  return parts[parts.length - 1]
}

node cdMovesTheRestOfAnAndChain() {
  return [
    cdSummary("cd grep-fixtures && ls"),
    cdSummary("cd grep-fixtures && cat one.txt"),
    cdSummary("cd grep-fixtures && pnpm test"),
    cdSummary("cd grep-fixtures && ls && cat two.txt"),
    cdSummary("cd grep-fixtures && ls | head"),
    cdSummary("cd ./grep-fixtures/ && ls"),
    cdSummary("ls && cd grep-fixtures && ls"),
    rebuiltCdNamesTheResolvedFolder("cd grep-fixtures && ls"),
  ]
}

// The rebuilt `cd` names the absolute folder in single quotes. The path
// differs by machine, so check its two ends.
def rebuiltCdNamesTheResolvedFolder(source: string): boolean {
  const command: string = executionCommandIn(source, STDLIB_TESTS)
  return command.startsWith("cd '/") && command.endsWith("/stdlib/grep-fixtures' && ls")
}

node cdAnywhereElseIsBroad() {
  return [
    cdSummary("cd grep-fixtures"),
    cdSummary("cd grep-fixtures; ls"),
    cdSummary("cd grep-fixtures || ls"),
    cdSummary("ls && cd grep-fixtures"),
    cdSummary("cd grep-fixtures | ls"),
    cdSummary("cd missing && ls"),
    cdSummary("cd grep-fixtures/one.txt && ls"),
    cdSummary("cd && ls"),
    cdSummary("cd - && ls"),
    cdSummary("cd $HOME && ls"),
    cdSummary("cd grep-fixtures read-fixtures && ls"),
    cdSummary("cd grep-fixtures > out.txt && ls"),
    cdSummary("cd grep-fixtures && cd ../read-fixtures && ls"),
    cdSummary("ls || cd grep-fixtures && ls"),
  ]
}

// The directory after a `cd` is known only inside the `&&` chain that
// holds it. A subshell ends the move, so the command after it is
// classified in the original folder. After `;` or `||` the directory
// depends on whether the `cd` worked, so the string is broad.
node cdDoesNotLeakOutOfItsChain() {
  return [
    cdSummary("(cd grep-fixtures && ls) && ls"),
    cdSummary("(cd grep-fixtures && ls) | head"),
    cdSummary("cd grep-fixtures && ls; ls"),
    cdSummary("cd grep-fixtures && ls || ls"),
    cdSummary("ls; cd grep-fixtures && ls"),
  ]
}

def executionCommandIn(source: string, cwd: string): any {
  return match(planFor(source, cwd).execution) {
    { kind: "bash", command } => command
    _ => "NOT-BASH"
  }
}

/** A folder of its own for the cd tests that need a link and a folder
  whose name starts with a dash. */
static const CD_FIXTURE = __dirname + "/stdlib/__safebash_cd__"

// Two cases where bash, given the word as written, goes somewhere other
// than the folder the payload names. The rebuilt `cd` names the resolved
// folder, so each command is run for real and must print the file in the
// folder its payload named.
//
// `link` points at `real/deep`. Bash applies `..` to the path it came by,
// so `cd link && (cd .. && cat x.txt)` as written reads the `x.txt` beside
// the link. The classifier resolves `..` from the link's target, which is
// `real`.
//
// `cd '-P'` as written is a flag to bash, which then goes to the home
// folder. Unquoted, the parser reads `-P` as a flag, so that form is broad.
node cdGoesWhereThePayloadSays() {
  remove(CD_FIXTURE) with approve
  mkdir(CD_FIXTURE) with approve
  bash("mkdir -p real/deep ./-P && echo beside-link > x.txt && echo beside-target > real/x.txt && echo dash > ./-P/notes.txt && ln -s real/deep link", cwd: CD_FIXTURE) with approve
  const linked = "cd link && (cd .. && cat x.txt)"
  const dashed = "cd '-P' && cat notes.txt"
  const linkedFolder = payloadFolder(planFor(linked, CD_FIXTURE).effects[0])
  const dashedFolder = payloadFolder(planFor(dashed, CD_FIXTURE).effects[0])
  const unquoted = outcomeOf(planFor("cd -P && cat notes.txt", CD_FIXTURE))
  const linkedRan = safeBash(linked, cwd: CD_FIXTURE) with approve
  const dashedRan = safeBash(dashed, cwd: CD_FIXTURE) with approve
  remove(CD_FIXTURE) with approve
  return [linkedFolder, printed(linkedRan), dashedFolder, printed(dashedRan), unquoted]
}

def printed(result: Result<string>): string {
  if (result is failure(why)) {
    return "FAILED: ${why}"
  }
  return result.value.trim()
}

node cdRunsInTheNewFolder() {
  // Approved by the test file: one std::read for one.txt in grep-fixtures.
  const result = safeBash("cd grep-fixtures && cat one.txt | head -1", cwd: STDLIB_TESTS)
  if (result is failure(why)) {
    return "FAILED: ${why}"
  }
  return result.value.trim() != ""
}

node listingsAskStdLs() {
  return [
    grepNames("ls"),
    grepNames("ls -la ."),
    grepNames("ls -R ."),
    grepNames("ls . .."),
    grepNames("tree -L 2 ."),
    grepNames("du -sh ."),
    grepNames("git log | ls"),
    grepNames("ls one.txt"),
    grepNames("ls -L ."),
    grepNames("ls . -la"),
    grepNames("ls --color=always ."),
    grepNames("tree -L x ."),
    grepNames("ls $D"),
    grepNames("ls *.txt"),
    grepNames("ls -la one.txt"),
    grepNames("ls one.txt two.txt"),
    grepNames("ls one.txt .."),
    grepNames("du -sh one.txt"),
    grepNames("tree one.txt"),
    grepNames("ls -R . ."),
    // ls prints "Not a directory" for a file with a trailing slash. The
    // resolver accepts the path, so this asks std::ls for the folder,
    // which names more than runs: safe, and not a gap.
    grepNames("ls one.txt/"),
  ]
}

node listingOfAMissingPath() {
  // The resolver's message names the absolute path, so only its start is
  // pinned.
  const detail = grepNames("ls nope")[1].detail
  return detail.startsWith("No file or directory at")
}

def lsPayloads(source: string): any {
  // A for loop with an `if` on the name, the shape
  // readPayloadNamesTheRealParent uses, so `payload` narrows to LsPayload.
  let out: any[] = []
  for (effect in planFor(source, FIXTURES).effects) {
    if (effect.name == "std::ls") {
      out.push([effect.payload.dir == FIXTURES, effect.payload.recursive])
    }
  }
  return out
}

node lsPayloadFields() {
  return [
    lsPayloads("ls"),
    lsPayloads("ls -R ."),
    lsPayloads("tree ."),
    lsPayloads("du -s ."),
    lsPayloads("ls -R one.txt"),
    lsPayloads("du one.txt"),
    lsPayloads("ls -R . one.txt"),
  ]
}

/** The folders the std::ls effects of a plan name, joined with `,`. A
 * string, so a row compares with `==`, which is not structural for two
 * arrays. */
def lsDirs(source: string, cwd: string): string {
  let dirs: string[] = []
  for (effect in planFor(source, cwd).effects) {
    if (effect.name == "std::ls") {
      dirs.push(effect.payload.dir)
    }
  }
  return dirs.join(",")
}

/** A folder of its own for the listing symlink test. */
static const LS_LINK_FIXTURE = __dirname + "/stdlib/__safebash_ls_link__"

node listingPayloadNamesTheRealFolder() {
  remove(LS_LINK_FIXTURE) with approve
  mkdir(LS_LINK_FIXTURE) with approve
  bash("mkdir inside outside && ln -s ../outside inside/link", cwd: LS_LINK_FIXTURE) with approve
  let dir = ""
  for (effect in planFor("ls link", LS_LINK_FIXTURE + "/inside").effects) {
    if (effect.name == "std::ls") {
      dir = effect.payload.dir
    }
  }
  remove(LS_LINK_FIXTURE) with approve
  return [dir == LS_LINK_FIXTURE + "/outside"]
}

node listingUnderRecommendedNeedsNoPrompt() {
  // The fixtures are inside the launch directory, so recommended approves
  // std::ls there. No interruptHandlers entry: an unanswered interrupt
  // fails the run.
  let found = false
  handle {
    const result = safeBash("ls " + FIXTURES)
    if (result is success(text)) {
      found = text.includes("one.txt")
    }
  } with (intr) {
    if (checkPolicy(recommendedAutoApprovePolicy, intr).type == "approve") {
      return approve()
    }
    return reject()
  }
  return found
}

node listingOutsideTheLaunchDirIsUndecided() {
  // /etc is a link on macOS, but plain ls follows a folder link operand,
  // so the payload names /private/etc and stays a std::ls question.
  const plan = planFor("ls /etc", FIXTURES)
  for (effect in plan.effects) {
    if (effect.name == "std::ls") {
      const intr = { effect: effect.name, data: effect.payload }
      return checkPolicy(recommendedAutoApprovePolicy, intr).type
    }
  }
  return "NO LS EFFECT"
}

node listingAsksOneQuestion() {
  const result = safeBash("ls -1", cwd: FIXTURES)
  if (result is failure(why)) {
    return "FAILED: ${why}"
  }
  return result.value
}

node rejectedListingNamesTheTool() {
  const result = safeBash("ls -L .", cwd: FIXTURES)
  if (result is failure(why)) {
    return why
  }
  return "UNEXPECTEDLY RAN"
}

