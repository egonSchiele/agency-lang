import { compile, describe, run, typecheck, CompiledProgram, ExportInfo } from "std::agency"
import { now, format } from "std::date"
import { read } from "std::index"
import { filterEntries } from "std::object"
import { resolve } from "std::path"
import { exists } from "std::shell"
import { Json } from "std::validation"

import { _read, _write } from "agency-lang/stdlib-lib/builtins.js"
import { _mkdir, _realDir } from "agency-lang/stdlib-lib/fs.js"
import { _glob } from "agency-lang/stdlib-lib/shell.js"

import {
  _compileWorkflowSource,
  _pickSignatures,
  _problemsFailure,
  _problemsFromDiagnostics,
  _signatureSources,
  _toolRefs,
  _workflowFailure,
  _workflowNameProblem,
} from "agency-lang/stdlib-lib/workflow/index.js"

/** @module
  @summary Turn a workflow, a JSON list of steps, into an Agency program.
  When you want an agent to do the same task the same way every time, a
  skill is only a suggestion: the agent reads it and then decides what to
  do. A workflow is a list of steps, as JSON, where each step calls a tool
  or asks a model, and a later step's arguments can point at an earlier
  step's result with `{ "$ref": "steps.note[0].id" }`. It is as fixed as
  code and as easy to show a person as a skill.

  A workflow is a thin layer over Agency: anything that needs behavior is
  an Agency function the workflow calls. It is not a second language: it
  has tool steps, LLM steps, and references, and nothing else.

  ```ts
  import { checkWorkflow, runWorkflow } from "std::workflow"
  import { searchNotes } from "./notes.agency"

  const problems = checkWorkflow(workflow, [searchNotes], __dirname)
  const result = runWorkflow(workflow, { noteTitle: "Groceries" }, [searchNotes], __dirname)
  ```

  `runWorkflow` checks the workflow, asks with `std::workflow::run`, and
  runs the program in a subprocess. Each step's interrupts reach the
  caller's handlers, so a policy decides what the workflow may do.

  `writeWorkflow` saves a checked workflow into a project directory as
  `<dir>/<name>/workflow.json` and `meta.json`; `loadWorkflow` and
  `listWorkflows` read them back.
*/

/** Caps on one run of a workflow, or on one step: `maxCost` in dollars and
  `maxTime` in milliseconds, each a positive number. The generated program
  wraps the whole body, or that step, in a guard with them. */
export type WorkflowLimits = {
  maxCost?: number;
  maxTime?: number
}

/** A workflow: a name, a description, the inputs as an Agency object type
  written as text, and the steps. `result` is a reference or a literal; the
  last step's value is returned without it. */
export type Workflow = {
  format: number;
  name: string;
  description: string;
  inputs: string;
  steps: Json[];
  result?: Json;
  limits?: WorkflowLimits
}

/** One thing wrong with a workflow, named by step and field. `step` and
  `field` are null only for a problem with the whole workflow. */
export type WorkflowProblem = {
  step: string | null;
  field: string | null;
  message: string
}

/** The data a refused workflow fails with. */
export type WorkflowFailure = {
  problems: WorkflowProblem[]
}

type ToolRef = {
  module: string;
  name: string
}

type Compiled = {
  source: string;
  ranges: Json;
  typeOwners: Json;
  warnings: WorkflowProblem[];
  wallClock: number | null
}

/** A workflow that passed the check: its compiled program, the warnings,
  and the subprocess wall clock (null for `run`'s default). */
type Checked = {
  program: CompiledProgram;
  warnings: WorkflowProblem[];
  wallClock: number | null
}

// Running a workflow. Raised after the check and before the subprocess
// starts, so a rejection starts nothing. An "always" answer pins the
// workflow directory and the workflow's name; the inputs are shown and
// never pinned, since they change with every run. `dir` is always an
// absolute path: a relative one would pin text that means a different
// directory under a different working directory, and the default `""`
// would give the pattern `{,/**}`, which matches every absolute path.
// `name` is a field of the workflow value the caller passed. A workflow
// from `loadWorkflow` has the name of its folder; one the caller built has
// whatever name it was given.
@alwaysUnder(dir)
@always(name)
effect std::workflow::run {
  name: string;
  dir: string;
  inputs: Json
}

/** What `describe` says about each tool, keyed by module and name. A
  `std::` module is described from a re-export line; a local module is
  read from `dir`, which asks for approval. */
@hidden
@capabilities(fileRead)
export def _signatures(refs: ToolRef[], dir: string): Result<Record<string, ExportInfo>> {
  let signatures: Record<string, ExportInfo> = {}
  for (group in _signatureSources(refs)) {
    let source = group.reExport
    if (source == null) {
      const text = read(group.module, dir)
      if (text is failure) {
        return text
      }
      source = text.value
    }
    const info = describe(source)
    if (info is failure) {
      return info
    }
    const picked = _pickSignatures(group, info.value.exports)
    if (picked is failure) {
      return picked
    }
    signatures = { ...signatures, ...picked.value }
  }
  return success(signatures)
}

/** The generated source, the lines each step owns, and the warnings. */
@hidden
@capabilities(fileRead)
export def _compileWithRanges(workflow: Workflow, tools: any[], dir: string): Result<Compiled, WorkflowFailure> {
  const refs = _toolRefs(tools, dir)
  if (refs is failure) {
    return failure(refs.error, refs.data)
  }
  const signatures = _signatures(refs.value, dir)
  if (signatures is failure) {
    return _workflowFailure(signatures.error)
  }
  return _compileWorkflowSource(workflow, refs.value, signatures.value)
}

/** The source is text, not a compiled program: hand it to `compile` or
  `typecheck` from `std::agency`, or to `checkWorkflow`, which does both and
  maps each error back to its step. Reading a local tool's module raises
  `std::read`. */
@capabilities(fileRead)
export idempotent def compileWorkflow(workflow: Workflow, tools: any[], dir: string = ""): Result<string, WorkflowFailure> {
  """
  Generate the Agency source of a workflow's program. A malformed workflow fails with every problem, each naming its step and field.

  @param workflow - The workflow to generate a program for
  @param tools - The functions the workflow may call. A step may only name one of these
  @param dir - The directory a workflow's local modules are named relative to
  """
  const compiled = _compileWithRanges(workflow, tools, dir)
  if (compiled is failure) {
    return failure(compiled.error, compiled.data)
  }
  return success(compiled.value.source)
}

/** The check behind `checkWorkflow` and `runWorkflow`: generate, typecheck,
  and compile, keeping the compiled program so a run never compiles twice. */
@hidden
@capabilities(fileRead)
export def _checked(workflow: Workflow, tools: any[], dir: string): Result<Checked, WorkflowFailure> {
  const compiled = _compileWithRanges(workflow, tools, dir)
  if (compiled is failure) {
    return failure(compiled.error, compiled.data)
  }
  const source = compiled.value.source
  // The typecheck runs first: its errors carry a line and a payload, so each
  // one is mapped to its step and field. A strict compile reports the same
  // errors as one message, so it runs second, for what is left.
  const report = typecheck(source, dir: dir, strict: true)
  if (report is failure) {
    return _workflowFailure(report.error)
  }
  if (report.value.errors.length > 0) {
    return _problemsFailure(_problemsFromDiagnostics(report.value.errors, compiled.value.ranges, compiled.value.typeOwners))
  }
  const program = compile(source, dir, strict: true)
  if (program is failure) {
    return _workflowFailure(program.error)
  }
  return success({
    program: program.value,
    warnings: compiled.value.warnings,
    wallClock: compiled.value.wallClock
  })
}

/** Every problem the generator and the typechecker can find, in one pass,
  so an author fixes them together. A wrong argument name, a missing
  argument, a wrong type, or a path into a step's value that does not exist
  is a type error in the generated program, reported on the step and field
  it came from. Reading a local tool's module raises `std::read`. */
@capabilities(fileRead)
export idempotent def checkWorkflow(workflow: Workflow, tools: any[], dir: string = ""): Result<WorkflowProblem[], WorkflowFailure> {
  """
  Check a workflow without running it. Fails with every problem, each naming its step and field; succeeds with the warnings, such as a tool that declares no return type.

  @param workflow - The workflow to check
  @param tools - The functions the workflow may call. A step may only name one of these
  @param dir - The directory a workflow's local modules are named relative to
  """
  const checked = _checked(workflow, tools, dir)
  if (checked is failure) {
    return failure(checked.error, checked.data)
  }
  return success(checked.value.warnings)
}

/** Check, ask, run. The check compiles the program and the run uses it. The
  prompt comes after the check, so a workflow with problems asks nothing,
  and before `run`, so a rejection starts no process. `run` raises its own
  `std::run`. The subprocess wall clock is the workflow's `maxTime` plus 30
  seconds, or `run`'s default. The node's `Result` comes back as the data
  of `run`'s envelope; its failure names the step that stopped the workflow. */
@capabilities(fileRead, fileWrite, subprocess)
export def runWorkflow(workflow: Workflow, inputs: Json, tools: any[], dir: string = ""): Result<Json> {
  """
  Run a workflow: check it, ask to run it, and run its program in a subprocess.

  @param workflow - The workflow to run
  @param inputs - The workflow's inputs, a value of its `inputs` type
  @param tools - The functions the workflow may call. A step may only name one of these
  @param dir - The directory a workflow's local modules are named relative to. Resolved to an absolute path, which is what an "always" answer to `std::workflow::run` pins, along with the workflow's name
  """
  const where = resolve(dir)
  const checked = _checked(workflow, tools, where)
  if (checked is failure) {
    return failure(checked.error, checked.data)
  }
  return interrupt std::workflow::run("Run the workflow ${workflow.name}?", {
    name: workflow.name,
    dir: where,
    inputs: inputs
  })
  const ran = run(compiled: checked.value.program, node: "main", args: { inputs: inputs }, wallClock: checked.value.wallClock)
  if (ran is failure) {
    return ran
  }
  return ran.value.data
}

// ---- saving and loading ----

const WORKFLOW_FILE = "workflow.json"
const META_FILE = "meta.json"
const MAX_WORKFLOWS = 500

/** What `meta.json` records about a saved workflow. */
export type WorkflowMeta = {
  createdAt: string;
  createdBy: string
}

/** A saved workflow: its name, its folder, the workflow, and its meta.json record. */
export type WorkflowEntry = {
  name: string;
  dir: string;
  workflow: Workflow;
  meta: WorkflowMeta
}

/** meta.json as written; every field may be missing. */
type MetaFile = {
  createdAt?: string;
  createdBy?: string
}

const DEFAULT_META: WorkflowMeta = {
  createdAt: "",
  createdBy: ""
}

// Reading saved workflows. One approval covers the reads that fulfil it,
// which use the non-interrupt primitives, as std::skills and std::toolbox
// do. `dir` is the real spelling of the directory read.
@alwaysUnder(dir)
effect std::workflow::scan {
  dir: string
}

// Saving a workflow. Raised after the check and before anything is
// written. Saving a name that exists replaces it, so an "always" answer
// pins the workflow's name as well as the directory: this workflow, in
// this directory. `dir` is the real spelling of the project directory.
@alwaysUnder(dir)
@always(name)
effect std::workflow::save {
  dir: string;
  name: string;
  workflow: Workflow
}

// Every entry point takes the project directory the same way. An empty
// string is refused because the file primitives would resolve it to the
// process cwd. The real spelling is what every prompt names, so one
// "always" answer covers the reads and writes that fulfil it.
@capabilities(fileRead)
def expandRoot(dir: string): Result<string> {
  if (dir == "") {
    return failure("dir must name the project directory; got an empty string")
  }
  return try _realDir(dir)
}

@capabilities(fileRead, fileWrite)
export def writeWorkflow(workflow: Workflow, tools: any[], dir: string): Result<WorkflowEntry> {
  """
  Save a workflow into a project directory, as `<dir>/<name>/workflow.json` and `meta.json`, after the full check and one `std::workflow::save` prompt. A workflow with problems is not saved and asks nothing. Saving a name that exists replaces it.

  @param workflow - The workflow to save. Its `name` names the folder
  @param tools - The functions the workflow may call, for the check
  @param dir - The project directory, which must exist: the workflow is saved under it, and a local tool's file must be under it too, since the saved workflow imports the tool by a path relative to it
  """
  const root = expandRoot(dir)
  if (root is failure) {
    return root
  }
  // The project directory holds the tool modules the check reads, so it
  // must already exist; only the workflow's own folder is created.
  if (!exists(root.value)) {
    return failure("${root.value} does not exist; dir must name an existing project directory")
  }
  // The check runs first, so a workflow with problems asks nothing. It
  // also proves `name` is an identifier, so it is safe as a folder name.
  const checked = _checked(workflow, tools, root.value)
  if (checked is failure) {
    return failure(checked.error, checked.data)
  }
  return interrupt std::workflow::save("Save the workflow ${workflow.name}?", {
    dir: root.value,
    name: workflow.name,
    workflow: workflow
  })
  const meta: WorkflowMeta = {
    createdAt: format(now()),
    createdBy: "writeWorkflow"
  }
  const folder = workflow.name
  destructive {
    // The host's mkdir is recursive, so an existing folder is not an error.
    const made = try _mkdir("${root.value}/${folder}")
    if (made is failure) {
      return made
    }
    const wroteWorkflow = try _write(root.value, "${folder}/${WORKFLOW_FILE}", JSON.stringify(workflow, null, 2), "overwrite")
    if (wroteWorkflow is failure) {
      return wroteWorkflow
    }
    const wroteMeta = try _write(root.value, "${folder}/${META_FILE}", JSON.stringify(meta, null, 2), "overwrite")
    if (wroteMeta is failure) {
      return wroteMeta
    }
  }
  return success({
    name: workflow.name,
    dir: "${root.value}/${folder}",
    workflow: workflow,
    meta: meta
  })
}

@capabilities(fileRead)
def readJsonFile(root: string, path: string): Result<Json> {
  const raw = try _read(root, path, 0, 0)
  if (raw is failure(readErr)) {
    return failure("${path} could not be read: ${readErr}")
  }
  const parsed = try JSON.parse(raw.value)
  if (parsed is failure(parseErr)) {
    return failure("${path} is not valid JSON: ${parseErr}")
  }
  return success(parsed.value)
}

def isPresent(value: Json, key: string): boolean {
  return value != null
}

// A missing meta.json is the default record. A present one that cannot be
// read, is not JSON, or has a field of the wrong type is a failure.
// Validation fills a missing optional field with null, and a null would
// win over the default in a spread, so only the fields the file has are kept.
@capabilities(fileRead)
def metaFor(root: string, name: string): Result<WorkflowMeta> {
  if (!exists("${name}/${META_FILE}", root)) {
    return success(DEFAULT_META)
  }
  const parsed = readJsonFile(root, "${name}/${META_FILE}")
  if (parsed is failure) {
    return parsed
  }
  const file: MetaFile! = parsed.value
  if (file is failure(shapeErr)) {
    return failure("${META_FILE} has the wrong shape: ${shapeErr}")
  }
  return success({
    ...DEFAULT_META,
    ...filterEntries(file.value, isPresent)
  })
}

// `root` is the directory the scan named and `name` a folder under it.
// Every failure starts with the workflow's name, so a caller can return it
// as it is.
@capabilities(fileRead)
def entryFor(root: string, name: string): Result<WorkflowEntry> {
  const parsed = readJsonFile(root, "${name}/${WORKFLOW_FILE}")
  if (parsed is failure(readErr)) {
    return failure("${name}: ${readErr}")
  }
  const checked: Workflow! = parsed.value
  if (checked is failure(shapeErr)) {
    return failure("${name}: ${WORKFLOW_FILE} is not a workflow: ${shapeErr}")
  }
  const meta = metaFor(root, name)
  if (meta is failure(metaErr)) {
    return failure("${name}: ${metaErr}")
  }
  // The file's own value, not the checked one: the check fills a missing
  // `result` or `limits` with null, and a null `result` is a literal
  // result to the generator.
  const saved: Workflow = parsed.value
  return success({
    name: name,
    dir: "${root}/${name}",
    workflow: saved,
    meta: meta.value
  })
}

@capabilities(fileRead)
export def loadWorkflow(name: string, dir: string): Result<WorkflowEntry> {
  """
  Load a saved workflow by name from a project directory. Raises one `std::workflow::scan` prompt for the workflow's folder before reading it, and nothing else.

  @param name - The workflow's name, which is its folder under `dir`
  @param dir - The project directory the workflow was saved under
  """
  const problem = _workflowNameProblem(name)
  if (problem != null) {
    return failure(problem)
  }
  const root = expandRoot(dir)
  if (root is failure) {
    return root
  }
  // Checked before the prompt, so a missing workflow fails with a message
  // instead of asking first: the check ls, grep, and glob make before
  // their interrupt (docs/dev/stdlib/grep-flags.md).
  if (!exists(name, root.value)) {
    return failure("no workflow named ${name} in ${root.value}")
  }
  return interrupt std::workflow::scan("Read the saved workflow ${name}?", {
    dir: "${root.value}/${name}"
  })
  return entryFor(root.value, name)
}

// The glob's `*` matches a name that starts with a dot, so dot folders are
// left out by hand.
def workflowFolder(path: string): string {
  return path.split("/")[0]
}

def isVisible(name: string): boolean {
  return !name.startsWith(".")
}

@capabilities(fileRead)
export def listWorkflows(dir: string): Result<WorkflowEntry[]> {
  """
  List the workflows saved in a project directory. Raises one `std::workflow::scan` prompt before reading anything, and nothing else. A directory that does not exist has no workflows. A folder whose files cannot be read fails the listing, with a message naming the folder.

  @param dir - The project directory the workflows were saved under
  """
  const root = expandRoot(dir)
  if (root is failure) {
    return root
  }
  if (!exists(root.value)) {
    return success([])
  }
  return interrupt std::workflow::scan("Read the workflows saved in this directory?", {
    dir: root.value
  })
  // Asked for one more than the cap, so a listing that long is refused
  // instead of cut short without a word.
  const paths = try _glob(root.value, ".", "*/${WORKFLOW_FILE}", MAX_WORKFLOWS + 1)
  if (paths is failure) {
    return paths
  }
  if (paths.value.length > MAX_WORKFLOWS) {
    return failure("${root.value} has more than ${MAX_WORKFLOWS} workflows")
  }
  const names = filter(map(paths.value, workflowFolder), isVisible)
  const entries = map(names, \name -> entryFor(root.value, name))
  const broken = find(entries, \entry -> isFailure(entry))
  if (broken != null) {
    return broken
  }
  return success(map(entries, \entry -> entry.value))
}
