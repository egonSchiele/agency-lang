/** @module In-session model selection for the agency agent. Holds the
  `/model` command's switch logic and the model pickers. This module sits
  ABOVE the resolution / slot / shared layers: it imports from them, and
  nothing they own imports back, so there is no import cycle. */

import { _localModelsAllowed } from "agency-lang/stdlib-lib/agentProcess.js"
import { _exit } from "agency-lang/stdlib-lib/system.js"
import {
  printLocalCatalog,
  localModelsSupported,
  listModelNames,
 } from "std::agency/local"
import { hostedModelInfo, listHostedModels, setLlmOptions } from "std::llm"
import { disableMemory } from "std::memory"
import { filterEntries } from "std::object"
import { isTTY } from "std::system"
import { chooseOption, ChoiceItem } from "std::ui/cli"
import { pushMessage } from "std::ui/cli"

import { EFFORT_CHOICES, EffortChoice, EffortModel, effortToSend, noDefaultWarning } from "./effort.agency"
import { LlmOptions, applyLlmOptions, mixedProviderWarning } from "./llmOptions.agency"
import {
  filterHostedModels,
  ModelFilters,
 } from "./modelFilters.agency"
import {
  ModelChoices,
  ModelFlags,
  ModelRequest,
  localModelOf,
  modelFlagsFromArgs,
  noModelChoices,
  noModelFlags,
  requestEffort,
  requestIsLocal,
  requestLlmOptions,
  requestProvider,
 } from "./modelRequest.agency"
import {
  LOCAL_PROVIDERS,
  knownProviders,
  parseModelFlag,
  lacksProviderForm,
  missingProviderEnvVar,
  Resolved,
  takesSlashModelNames,
 } from "./models.agency"
import { activePreset, activePresetName, editPresets, findPreset, setActivePreset } from "./presets.agency"
import { checkPreset, Preset } from "./presetRules.agency"
import { presetChangeLines, sessionPreset } from "./presetSnapshot.agency"
import { configureSearch, getSearchSession } from "./search.agency"
import {
  diffResolved,
  Ctx,
  SlotChange,
 } from "./resolution.agency"
import {
  ModelSettings,
  getModelSettings,
  loadSettings,
 } from "./settings.agency"
import { notice } from "./notice.agency"
import { chatSlots, providerFormExample, providerFormTitle, SLOTS } from "./slots.agency"
import { ToolLimits, applyToolLimits, startupLimitFlags } from "./toolLimits.agency"
import {
  demoteProvider,
  applyResolved,
  overrideFromResolved,
  configureLocalModel,
  defaultSlots,
  explicitRouterSpec,
  getResolvedSlots,
  getCapabilities,
  getCapabilitiesResolved,
  currentProvider,
  markMemoryEnabledByOverride,
  embeddingKeyStatus,
  memoryEnablePlan,
  enableAgentMemory,
  resolveHostedModels,
  resolveRequestAgainst,
 } from "../shared.agency"

// In-session model selection state: the /model choices.
export type Session = ModelChoices

// Whether startup enabled memory WITH the embedding override. The pause
// guard in reactToSlotChange consults this instead of re-deriving from the
// slots: a keyless override took the fallback path, so memory runs on
// DERIVED embeddings and a main-provider change still shifts the embedding
// space. Exported mutator so tests (and agent startup) can drive the guard.
let _memoryEmbeddingsPinned = false

export def markMemoryEmbeddingsPinned(pinned: boolean) {
  _memoryEmbeddingsPinned = pinned
}

// The startup model flags and settings.model, kept for the session so
// /model and /preset resolve with the same inputs startup did, without
// reading settings.json inside a turn.
let _startupFlags: ModelFlags = noModelFlags()
let _startupModelSettings: ModelSettings = {}
// The default slots whose provider had its key at startup. Reading the
// key inside a turn would become an env prompt, so it is read once.
let _startupDefaultSlots: Record<string, string> = {}

export def setStartupModelFlags(
  flags: ModelFlags,
  settings: ModelSettings,
  defaults: Record<string, string> = {},
) {
  _startupFlags = flags
  _startupModelSettings = settings
  _startupDefaultSlots = defaults
}

// A session saved before the default router existed restores this global
// as null: a resume does not run the initializer again.
def startupDefaultSlots(): Record<string, string> {
  return _startupDefaultSlots ?? {}
}

/** The request for this session's startup flags, active preset, and these /model choices. */
export def currentModelRequest(choices: ModelChoices): ModelRequest {
  return {
    flags: _startupFlags,
    preset: activePreset(),
    choices: choices
  }
}

export static const LOCAL_MODELS_OFF = "Local models are not available here."

// Where the process cannot host a local model, a slot on a local provider
// is refused too. `mlx/some-model` as a model spec names one without
// `--local` or a local preset.
def refusesALocalSlot(resolved: Record<string, Resolved>): boolean {
  if (_localModelsAllowed()) {
    return false
  }
  for (slot, model in resolved) {
    if (model != null && LOCAL_PROVIDERS.includes(model.provider)) {
      return true
    }
  }
  return false
}

export def applyModelRequest(request: ModelRequest, settings: ModelSettings): Result<boolean> {
  """
  Resolve and apply a request's models, local or hosted. A failure
  changes nothing and returns the message. A local request is a failure
  in a process that cannot host one (agentProcess.ts). The
  web-search setup is the caller's job.

  @param request - What the run asked for
  @param settings - settings.model
  """
  const local = localModelOf(request)
  if (local != null) {
    if (!_localModelsAllowed()) {
      return failure(LOCAL_MODELS_OFF)
    }
    configureLocalModel(local.model, local.embedding, local.router)?
    applyRequestOptions(request, settings)
    return success(true)
  }
  const resolved = resolveHostedModels(request, settings, startupDefaultSlots())
  if (isFailure(resolved)) {
    return resolved
  }
  if (refusesALocalSlot(resolved.value)) {
    return failure(LOCAL_MODELS_OFF)
  }
  applyResolved(resolved.value)
  applyRequestOptions(request, settings)
  return success(true)
}

def chatModels(): EffortModel[] {
  const slots = getResolvedSlots()
  return [
    { provider: slotProvider(slots[slot]), model: slots[slot].model }
    for slot in chatSlots(Object.keys(slots))
    if slots[slot] != null
  ]
}

// Call after the models are applied: the warning and the effort read them.
def applyRequestOptions(request: ModelRequest, settings: ModelSettings) {
  const options = requestLlmOptions(request, settings)
  applyLlmOptions(options)
  const models = chatModels()
  const asked = requestEffort(request)
  // A null removes the level an earlier model or preset set.
  setLlmOptions({
    reasoningEffort: effortToSend(asked, models)
  })
  const warnings = [mixedProviderWarning(options, [model.provider for model in models]), noDefaultWarning(asked, models)]
  for (warning in warnings) {
    if (warning != "") {
      notice("Warning: ${warning}", "warning")
    }
  }
}

// An empty provider means smoltalk picks it from the model name, so look
// the model up the same way.
def slotProvider(resolved: Resolved): string {
  if (resolved.provider != "") {
    return resolved.provider
  }
  const info = hostedModelInfo(resolved.model)
  if (info == null) {
    return ""
  }
  return info.provider
}

// What the coordinator's useLlmOptions tool asked for, applied by the REPL
// after the turn. A tool runs in a branch, and setLlmOptions there writes
// the branch's own defaults, which are dropped when the branch joins.
let _pendingLlmOptions: LlmOptions | null = null

export def requestSessionLlmOptions(options: LlmOptions) {
  _pendingLlmOptions = options
}

/** The block the chat tool asked for, or null. Clears it. */
export def takePendingLlmOptions(): LlmOptions | null {
  const pending = _pendingLlmOptions
  _pendingLlmOptions = null
  return pending
}

/** Apply the block the useLlmOptions tool asked for during the turn, if
  there is one, and say so in a notice. Call it after the turn, outside
  the tool's branch. */
export def applyPendingLlmOptions() {
  const pending = takePendingLlmOptions()
  if (pending == null) {
    return
  }
  applyLlmOptionsAnswer(pending)
  const fields = Object.keys(pending)
  const listed = if fields.length == 0 then "none (back to the preset's)" else fields.join(", ")
  notice("Options set for the next turn: ${listed}")
}

/** An empty block clears the session's own, so the preset's or
  settings.model's apply again. Takes effect from the next turn. */
export def applySessionLlmOptions(prior: Session, options: LlmOptions): Session {
  """
  Make `options` this session's llm() options. Returns the new session.

  @param prior - The session before
  @param options - The block the user asked for
  """
  const models: Session = withoutOptions(prior)
  const next: Session = if Object.keys(options).length == 0 then models else {
    ...models,
    llmOptions: options
  }
  applyRequestOptions(currentModelRequest(next), _startupModelSettings)
  return next
}

def withoutOptions(session: Session): Session {
  return filterEntries(session, \(value, field) -> field != "llmOptions")
}

// The session's own block was written for the models it was set beside.
def withoutStaleOptions(prior: Session, next: Session): Session {
  if (next.pin == prior.pin && JSON.stringify(next.slots) == JSON.stringify(prior.slots)) {
    return next
  }
  return withoutOptions(next)
}

// Persistent knowledge graph, gated on the capability profile.
export def maybeEnableMemory() {
  const status = embeddingKeyStatus(getResolvedSlots())
  const capabilities = getCapabilitiesResolved()
  const plan = memoryEnablePlan(capabilities.values.memory, capabilities.sources.memory, status)
  markMemoryEmbeddingsPinned(plan == "enable-override")
  return match(plan) {
    "skip" => null
    "enable-override" => {
      if (!capabilities.values.memory) {
        markMemoryEnabledByOverride()
      }
      enableAgentMemory(status.override)
      return null
    }
    "enable-fallback" => {
      print(
        color.dim(
        "Memory: the embedding slot needs ${status.varName}, which is not set. Falling back to the default embedding behavior.",
      ),
      )
      enableAgentMemory()
      return null
    }
    _ => {
      enableAgentMemory()
      return null
    }
  }
}

/** What a model switch produced: the new choices, every resolved slot,
  and the slots that changed. */
export type ModelSwitch = {
  session: Session;
  resolved: Record<string, Resolved>;
  changes: SlotChange[]
}

/** Apply an in-session model selection. Takes effect on
  the NEXT turn; no in-flight call is mutated. A switch that cannot be
  made prints why and returns the session as it was. A caller that needs
  to know it failed uses trySwitchModel. */
export def switchModel(
  prior: Session,
  spec: string,
  ctx: Ctx,
  before: Record<string, Resolved>,
): ModelSwitch {
  const switched = trySwitchModel(prior, spec, ctx, before)
  if (switched is failure(reason)) {
    pushMessage(color.red(reason))
    return {
      session: prior,
      resolved: before,
      changes: []
    }
  }
  return switched.value
}

/** switchModel, with a switch that cannot be made returned as a failure.
  It prints nothing and changes nothing when it fails. */
export def trySwitchModel(
  prior: Session,
  spec: string,
  ctx: Ctx,
  before: Record<string, Resolved>,
): Result<ModelSwitch> {
  // The caller builds ctx from currentProvider(), which returns the
  // PROMOTED name on openai sessions. priceDefault and the built-in
  // tables key by public provider names, so demote before resolving —
  // otherwise a switch that lets any slot fall through to the built-in
  // defaults fails with "openai-responses has no built-in defaults".
  const ctx2: Ctx = {
    provider: demoteProvider(ctx.provider),
    price: ctx.price
  }
  let next: Session = JSON.parse(JSON.stringify(prior))
  const parsed = parseModelFlag(spec)
  if (parsed.slot != "" && !SLOTS.includes(parsed.slot)) {
    return failure("Unknown model slot '${parsed.slot}'. Valid slots: ${SLOTS.join(", ")}.")
  }
  if (lacksProviderForm(parsed.slot, parsed.model)) {
    // A derived slot exists to point AWAY from the chat provider, so the
    // provider can never be inferred. Require the explicit form.
    return failure(
      "${providerFormTitle(parsed.slot)} models need the provider/model form, e.g. ${parsed.slot}=${providerFormExample(parsed.slot)}.",
    )
  }
  if (parsed.slot == "") {
    next.pin = parsed.model
  } else {
    next.slots[parsed.slot] = parsed.model
  }
  next = withoutStaleOptions(prior, next)

  const request = currentModelRequest(next)
  const settings = _startupModelSettings
  const established = requestProvider(request, settings) != ""
  const all = resolveRequestAgainst(request, settings, ctx2, established, startupDefaultSlots())
  if (all is failure(reason)) {
    return failure("Could not switch model: ${reason}")
  }
  const resolved = all.value
  if (refusesALocalSlot(resolved)) {
    return failure("Could not switch model: ${LOCAL_MODELS_OFF}")
  }
  applyResolved(resolved)
  applyRequestOptions(request, settings)
  return success({
    session: next,
    resolved: resolved,
    changes: diffResolved(before, resolved)
  })
}

// The session's own model choices: what /model and the useLlmOptions tool
// have set since startup. Session state, so it is kept here with the
// startup flags and not in the terminal's REPL: a front-end that resumes
// the session must find it.
let _choices: ModelChoices = noModelChoices()

/** The model choices this session has made since it started. */
export def modelChoices(): ModelChoices {
  return _choices
}

export def setModelChoices(choices: ModelChoices) {
  _choices = choices
}

/** The part of a spec before its first `/`, when it is not a provider the
  agent knows and the spec is no model of the session's provider, else "".
  With a provider fixed, the spec is read whole, as its model. So it is
  under a provider whose model names hold a `/`: on an OpenRouter session
  `z-ai/glm-5.2` is one of its models. `reasoning=openai/gpt-4o` names its
  provider after the slot. A spec with no `/` names no provider. */
def unknownProvider(spec: string): string {
  if (fixedProvider() != "") {
    return ""
  }
  if (takesSlashModelNames(demoteProvider(currentProvider()))) {
    return ""
  }
  const model = parseModelFlag(spec).model
  const idx = model.indexOf("/")
  if (idx <= 0) {
    return ""
  }
  const prefix = model.substring(0, idx)
  if (knownProviders().includes(prefix)) {
    return ""
  }
  return prefix
}

/** Switch models from a spec such as `opus` or `reasoning=claude-opus-4-8`,
  for the session's own choices. Returns every resolved slot. A switch
  that cannot be made is a failure, and nothing changes. */
export def applyModelSpec(spec: string): Result<Record<string, Resolved>> {
  const ctx: Ctx = {
    provider: currentProvider(),
    price: "standard"
  }
  const unknown = unknownProvider(spec)
  if (unknown != "") {
    return failure("Unknown provider: ${unknown}. Known: ${knownProviders().join(", ")}")
  }
  const switched = trySwitchModel(_choices, spec, ctx, getResolvedSlots())
  if (isFailure(switched)) {
    return switched
  }
  _choices = switched.value.session
  for (change in switched.value.changes) {
    reactToSlotChange(change)
  }
  return success(switched.value.resolved)
}

/** Set the session's own LLM options, as the useLlmOptions tool asks.
  They take effect from the next turn. */
export def applyLlmOptionsAnswer(options: LlmOptions) {
  _choices = applySessionLlmOptions(_choices, options)
}

/** The provider this session is fixed to, by the name a person sees, or
  "" when none is. `--provider`, the preset or settings.model fixes one.
  Then a model spec is read whole, as a model of that provider:
  `openai/gpt-4o` under a fixed `anthropic` is a model by that name, not
  a switch to OpenAI. A front-end reads this to know which it will get. */
export def fixedProvider(): string {
  return demoteProvider(requestProvider(currentModelRequest(_choices), _startupModelSettings))
}

/** The effort this session asks for, as `--effort` words it: a level,
  "default" to send none, or "" when no one named one and the models'
  own rule decides. */
export def askedEffort(): string {
  return requestEffort(currentModelRequest(_choices)) ?? ""
}

/** Set the session's own reasoning effort: a level, or "default" to send
  none. It takes effect from the next turn and outlasts a model switch.
  A value that is not an effort is a failure, and nothing changes. */
export def applyEffortAnswer(effort: string): Result<boolean> {
  if (!EFFORT_CHOICES.includes(effort)) {
    return failure("The effort must be ${EFFORT_CHOICES.join(", ")}; got '${effort}'.")
  }
  _choices = { ..._choices, effort: effort as EffortChoice }
  applyRequestOptions(currentModelRequest(_choices), _startupModelSettings)
  return success(true)
}

/** Switch the session to a saved preset: its models, options, effort and
  tool limits, with the session's own choices started again. A preset that
  is unknown or cannot be used is a failure, and nothing changes. Returns
  what the switch produced, for a caller that shows it. */
export def applyPresetAnswer(name: string): Result<PresetSwitch> {
  const switched = switchPreset(name)
  if (isFailure(switched)) {
    return switched
  }
  _choices = switched.value.session
  for (change in switched.value.changes) {
    reactToSlotChange(change)
  }
  return switched
}

/** React to one resolved-slot change. Phase 1: a `main`-slot provider change
  means the embedding space behind memory changed, so pause memory and warn.
  (std::memory has no tier-2-only toggle yet -- full pause; structured recall
  returns when a selective toggle lands.) Returns true if it emitted the notice. */
export def reactToSlotChange(change: SlotChange): boolean {
  if (change.slot == "main" && change.before.provider != change.after.provider) {
    // Skip the pause only when startup actually enabled memory WITH the
    // override. A set-but-keyless slot took the fallback path, so memory
    // runs on derived embeddings and the provider change still shifts
    // the embedding space behind recall.
    if (_memoryEmbeddingsPinned) {
      return false
    }
    notice("Warning: provider changed - memory is paused until restart (recall would be unreliable).")
    // `with approve`: the agent is deliberately auto-pausing memory on a
    // provider switch, not asking the user — so don't surface an approval prompt.
    disableMemory() with approve
    return true
  }
  if (change.slot == "embedding") {
    const override = overrideFromResolved(change.after)
    if (override != null) {
      const missing = missingProviderEnvVar(override.provider)
      if (missing != "") {
        notice(
          "Warning: the embedding slot needs ${missing}, which is not set. The assignment takes effect at next agent start, and memory falls back to the default embedding behavior until it is exported.",
          "warning",
        )
        return true
      }
      // The healthy path must not be silent: enableMemory already ran,
      // so the user would otherwise believe embeddings switched now.
      notice(
        "Embedding slot set: memory embeddings use ${override.provider}/${override.model} at next agent start.",
      )
      return true
    }
  }
  return false
}

/** `/local`: run the session on a local model, as the `local` answer asks.
  The router the user set keeps routing; the default router stays out of a
  local session. Refused where the process cannot host a local model. */
export def useLocalModel(model: string): Result<boolean> {
  if (!_localModelsAllowed()) {
    return failure(LOCAL_MODELS_OFF)
  }
  const before = getResolvedSlots()
  const router = explicitRouterSpec()
  configureLocalModel(model, "", router)?
  configureSearch(true)
  for (change in diffResolved(before, getResolvedSlots())) {
    reactToSlotChange(change)
  }
  return success(true)
}

// ChoiceItem list for the model pickers: the hosted catalog, filtered, each
// labeled with provider + input price for an informed pick.
/** The provider a session is held to by --provider, a preset, or
  settings.model, or "" when none is. switchModel never splits a
  `provider/model` spec under one, so the picker has to know. */
export def establishedProvider(choices: ModelChoices): string {
  return requestProvider(currentModelRequest(choices), _startupModelSettings)
}

// The key is what switchModel receives, so it carries the provider: a
// bare name would be sent to the session's current provider. Under an
// established provider a `provider/model` key is
// never split, so there the list narrows to that provider and the keys
// stay bare. Providers are compared and written demoted, because the
// catalog says `openai-responses` and the resolver only knows `openai`.
export def modelChoiceItems(filters: ModelFilters, established: string = ""): ChoiceItem[] {
  let items: ChoiceItem[] = []
  for (model in filterHostedModels(listHostedModels(), filters)) {
    const provider = demoteProvider(model.provider)
    if (established != "" && provider != demoteProvider(established)) {
      continue
    }
    const label = "${model.name}  (${model.provider}, $${model.inputCost}/1M in, $${model.outputCost}/1M out)"
    const key = if established == "" then "${provider}/${model.name}" else model.name
    items.push({
      key: key,
      label: label
    })
  }
  return items
}

// What the /model picker says when the provider is established. The list
// is that provider's only, and a `provider/model` spec is not split, so
// /model cannot move the session to another provider. A provider with no
// rows in the hosted catalog, such as a proxy or a local one, leaves the
// list empty, and the model has to be typed.
export def scopedPickerNotes(established: string, itemCount: number): string[] {
  if (established == "") {
    return []
  }
  const scope = "Listing ${established} models only. The provider is fixed by --provider, a preset, or settings.model.provider, and /model cannot change it; start without that setting to pick from every provider."
  if (itemCount == 0) {
    return [scope, "The catalog has no models for ${established}. Type the model name."]
  }
  return [scope]
}

// Parse a `/models [provider]` command line into filters. Bare `/models` (or a
// trailing-space-only arg) yields no filters; `/models <provider>` narrows to
// one provider. Extracted from the handler so it is unit-testable.
export def parseModelsFilters(cmd: string): ModelFilters {
  const prefix = "/models "
  if (!cmd.startsWith(prefix)) {
    return {}
  }
  const arg = cmd.substring(prefix.length).trim()
  if (arg == "") {
    return {}
  }
  return {
    provider: arg
  }
}

// Bare --local: prompt for a model, or print the catalog and exit when
// there is no terminal to prompt on.
def pickGuidedLocalModel(): string {
  if (!isTTY()) {
    printLocalCatalog()
    _exit(0)
  }
  if (!localModelsSupported()) {
    print(color.yellow("Local models need the smoltalk-llama-cpp package."))
    print("Install it, then re-run:  ! npm i -g smoltalk-llama-cpp")
    _exit(1)
  }
  const items = map(listModelNames(), \modelName -> { key: modelName.name, label: modelName.name })
  const choice = chooseOption(
    "Local model",
    "Pick a model, or type an hf: URI / .gguf path (downloads on first use):",
    items,
    allowFreeText: true,
    allowCancel: true,
  )
  if (choice == "" || choice == null) {
    _exit(0)
  }
  return choice
}

def withGuidedLocal(flags: ModelFlags): ModelFlags {
  if (flags.local != "") {
    return flags
  }
  return {
    ...flags,
    local: pickGuidedLocalModel()
  }
}

/** The model flags from the command line, for the session program's
  start. A bare `--local` asks which local model first. Exits with a
  message on bad flags. */
export def startupModelFlags(args: Record<string, any>): ModelFlags {
  const parsed = modelFlagsFromArgs(args)
  if (parsed is failure(reason)) {
    print(color.red(reason))
    _exit(1)
  }
  if (parsed is success(flags)) {
    return withGuidedLocal(flags)
  }
  return noModelFlags()
}

/** Resolve and apply the agent's models at startup from the CLI flags,
  the active preset, and settings.model. Exits with a message on bad
  flags or an unresolvable request. */
export def pickModelsForAgent(args: Record<string, any>) {
  const parsed = modelFlagsFromArgs(args)
  if (parsed is failure(reason)) {
    print(color.red(reason))
    _exit(1)
    return
  }
  const started = startModels(withGuidedLocal(parsed.value))
  if (started is failure(reason)) {
    print(reason)
    _exit(1)
    return
  }
}

/** Resolve and apply a session's models at startup from the model flags,
  the active preset, and settings.model. A request that cannot be
  resolved is a failure. It asks nothing and never ends the process, so
  a front-end with no terminal can call it. It can still print a line
  about the web search backend.

  `saveSearchChoice` is whether the search backend picked for this
  session is also saved to settings.json. The terminal saves it. An app
  does not: its environment often lacks the search keys a terminal has,
  and a choice saved from there would follow the user back. */
export def startModels(flags: ModelFlags, saveSearchChoice: boolean = true): Result<boolean> {
  // A one-shot run gets the default slots too: this runs before the
  // agent branches on one-shot.
  setStartupModelFlags(flags, getModelSettings(loadSettings()), defaultSlots())
  const request = currentModelRequest(noModelChoices())
  const applied = applyModelRequest(request, _startupModelSettings)
  if (isFailure(applied)) {
    return applied
  }
  configureSearch(requestIsLocal(request), saveSearchChoice)
  return success(true)
}

/** What a switch produced. The first three fields have the meaning they
  have in switchModel's result; `session` is always the empty choices. */
export type PresetSwitch = {
  session: Session;
  resolved: Record<string, Resolved>;
  changes: SlotChange[];
  limits: ToolLimits
}

// configureSearch reads and saves settings.json, so it runs only when the
// switch changes local versus hosted, the same case /local covers.
def followLocality(isLocal: boolean) {
  if (isLocal != getSearchSession().isLocal) {
    configureSearch(isLocal)
  }
}

/** A `/preset` command line: list the presets, switch to one, or save
  the session to one. `name` is "" for a list, and for a save to the
  active preset. */
export type PresetCommand = {
  kind: "list" | "switch" | "save";
  name: string
}

export def parsePresetCommand(cmd: string): PresetCommand {
  const prefix = "/preset"
  const rest = if cmd.startsWith(prefix) then cmd.substring(prefix.length).trim() else ""
  if (rest == "") {
    return { kind: "list", name: "" }
  }
  if (rest == "save") {
    return { kind: "save", name: "" }
  }
  const savePrefix = "save "
  if (rest.startsWith(savePrefix)) {
    return { kind: "save", name: rest.substring(savePrefix.length).trim() }
  }
  return { kind: "switch", name: rest }
}

// /local moves the session to a local model without changing its request,
// so the request no longer describes the models the session runs.
def movedByLocalCommand(request: ModelRequest): boolean {
  const main = getResolvedSlots()["main"]
  const runsLocal = main != null && main.via == "local"
  return runsLocal != requestIsLocal(request)
}

export def saveSessionPreset(name: string, choices: ModelChoices): string[] {
  """
  Save this session's models, effort, options, and tool limits to a
  preset, and return the lines to print: a heading and one line per
  field that changed. Does not switch to the preset or clear the /model
  choices.

  @param name - The preset to write, or "" for the active one
  @param choices - This session's /model choices
  """
  const saved = writeSessionPreset(name, choices)
  if (saved is failure(reason)) {
    return [reason]
  }
  return saved.value
}

/** `saveSessionPreset`, with a save that was refused as a failure that
  holds the line saying why. Success holds the lines to show, which say
  what was saved, or that there was nothing to save. The session core
  sends a failure as an error notice. */
export def writeSessionPreset(name: string, choices: ModelChoices): Result<string[]> {
  const target = if name == "" then activePresetName() else name
  if (target == "") {
    return failure("No preset is active. Name one: /preset save <name>")
  }
  const request = currentModelRequest(choices)
  if (movedByLocalCommand(request)) {
    return failure("Not saved: this session moved to or from a local model with /local, which a save cannot copy. Start with --local or a local preset, then save.")
  }
  const settingsFixProvider = (_startupModelSettings.provider ?? "") != ""
  const preset = sessionPreset(request, startupLimitFlags(), getResolvedSlots(), settingsFixProvider)
  const checked = checkPreset(target, preset, false)
  if (checked is failure(reason)) {
    return failure("Not saved: ${reason}")
  }
  // A new name, or a saved preset that is not valid: every field prints.
  let before: Preset | null = null
  const found = findPreset(target)
  if (found is success(saved)) {
    before = saved
  }
  const changes = presetChangeLines(before, checked.value)
  if (changes.length == 0 && before != null) {
    return success(["Nothing to save: this session matches the '${target}' preset."])
  }
  // The user asked for this write, so this handler does not object. A
  // policy in the chain still decides.
  const edited = editPresets({ kind: "save", name: target, preset: checked.value }) with approve
  if (edited is failure(reason)) {
    return failure("Not saved: ${reason}")
  }
  const heading = if edited.value.existed then "Saved the '${target}' preset:" else "Created the '${target}' preset:"
  return success([heading, ...changes])
}

export def switchPreset(name: string): Result<PresetSwitch> {
  """
  Switch this session to a saved preset, with no /model choices. Takes
  effect on the next turn. Changes nothing, and returns the reason, when
  the preset is unknown or its models do not resolve.

  @param name - The preset's name
  """
  const preset = findPreset(name)
  if (isFailure(preset)) {
    return preset
  }
  const before = getResolvedSlots()
  const request: ModelRequest = {
    flags: _startupFlags,
    preset: preset.value,
    choices: noModelChoices()
  }
  const applied = applyModelRequest(request, _startupModelSettings)
  if (isFailure(applied)) {
    return applied
  }
  followLocality(requestIsLocal(request))
  setActivePreset(name)
  const after = getResolvedSlots()
  return success({
    session: noModelChoices(),
    resolved: after,
    changes: diffResolved(before, after),
    limits: applyToolLimits(preset.value, false)
  })
}
