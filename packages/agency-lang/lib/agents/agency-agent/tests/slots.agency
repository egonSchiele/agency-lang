import { canonicalSlot, chatSlots, isKnownSlot, providersFor, slotKind } from "../lib/slots.agency"

node aliasFastToMain(): string {
  return canonicalSlot("fast")
}

node unknownStaysUnknown(): boolean {
  return isKnownSlot("resoning")
}

node knownAfterAlias(): boolean {
  return isKnownSlot("slow")
}

node kindOfReasoning(): string {
  return slotKind("slow")
}

node kindOfEmbedding(): string {
  return slotKind("embedding")
}

// The router takes only the providers that answer decisions; every other
// slot takes the chat providers it is given.
node routerTakesTheDecisionProviders(): string {
  const router = providersFor("router", ["anthropic"]).join(",")
  const main = providersFor("main", ["anthropic"]).join(",")
  return "${router}|${main}"
}

// An llmOptions block reaches the chat slots only.
node optionsReachTheChatSlots(): string {
  return chatSlots(["main", "reasoning", "embedding", "router"]).join(",")
}
