effect test::check { n: number }

let validatorRuns = 0
let neighborRuns = 0

def askFirst(value: number): Result<number> {
  validatorRuns += 1
  interrupt test::check("ok?", { n: value })
  return success(value)
}

@validate(askFirst)
type Asked = number

def neighbor(): number {
  neighborRuns += 1
  return 1
}

def both(a: any, b: number): number {
  return b
}

node once() {
  handle {
    const r = both(6 as Asked!, neighbor())
  } with approve
  return [validatorRuns, neighborRuns]
}

node perIteration() {
  let i = 0
  handle {
    while (isSuccess(i as Asked!) && i < 2) {
      i += 1
    }
  } with approve
  return validatorRuns
}
