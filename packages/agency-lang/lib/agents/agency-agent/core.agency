/** @module
  @summary The session core: one conversation as one run that any
  front-end can drive. It waits for an answer with an interrupt, runs a
  turn or applies a command, and reports through events. It draws nothing
  and asks no one, so the terminal, an app's engine, and a test drive it
  the same way, and a session one of them saved is a file another can
  resume. See docs/dev/agents/session-core.md.

  A front-end answers the pause, `agent::sessionInput`, with an `Answer`.
  Its policy must leave that effect to `propagate`. Every approval the
  run's policy does not decide leaves the run as an interrupt too.

  Events: `session.reply`, `session.error`, `session.notice`,
  `session.budgetStop`, `session.editDiff`.
*/
import { editDiff } from "agency-lang/stdlib-lib/editDiff.js"
import { emit } from "std::statelog"

import { setReplyStyle, setTurnBudget } from "./lib/answer.agency"
import { checkCliBundles, setJobToolsOn } from "./lib/cliTools.agency"
import { compactIfDue, contextStatus } from "./lib/compaction.agency"
import { groundingText, setGrounding } from "./lib/grounding.agency"
import { Resolved } from "./lib/models.agency"
import { notice } from "./lib/notice.agency"
import { addNote, withPendingNotes } from "./lib/pendingNotes.agency"
import { activePresetName } from "./lib/presets.agency"
import {
  conversationThread,
  currentRecord,
  markTurnDone,
  recordTurn,
  setCurrentRecord,
 } from "./lib/record.agency"
import {
  applyEffortAnswer,
  applyLlmOptionsAnswer,
  applyModelSpec,
  applyPendingLlmOptions,
  applyPresetAnswer,
  askedEffort,
  fixedProvider,
 } from "./lib/session.agency"
import { setSessionFolder } from "./lib/sessionFolder.agency"
import { SessionRecord } from "./lib/sessions.agency"
import { currentBrainName, resolveStartTarget, runTurn, startTargetsFor } from "./lib/turn.agency"
import { isPlainObject } from "./lib/utils.agency"
import { getResolvedSlots } from "./shared.agency"

/** One turn's limits: a cost in dollars and a time in milliseconds. A
  negative value is no limit. */
export type TurnBudget = {
  maxCost: number;
  maxTime: number
}

/** What a front-end shows and saves between turns. */
export type PauseData = {
  // The id of the thread the conversation runs on, "" before the first turn.
  thread: string;
  // The agent's working folder now. A coder can move it.
  cwd: string;
  // Null for a session that is not saved.
  record: SessionRecord | null;
  // The resolved model of each slot: main, reasoning, router.
  models: Record<string, Resolved>;
  // The active preset's name, or "".
  preset: string;
  // The provider the session is fixed to, or "". When one is fixed, a
  // `model` answer's spec is read whole, as a model of that provider.
  fixedProvider: string;
  // The effort the session asks for: a level, "default" to send none, or
  // "" when no one named one and the models' own rule decides.
  effort: string;
  budget: TurnBudget;
  // How full the conversation's context window is, as the footer says it.
  context: string;
  // The brain that runs the session, by its name. Unlike `record.brain`,
  // it is there when the session is not saved.
  brain: string;
  // The policy the session was started under, or null. See SessionStart.
  policy: any
}

effect agent::sessionInput {
  thread: string;
  cwd: string;
  record: any;
  models: any;
  preset: string;
  fixedProvider: string;
  effort: string;
  budget: any;
  context: string;
  brain: string;
  policy: any
}

export type SessionStart = {
  // The folder the agent works in.
  cwd: string;
  // A line on how to format replies for this front-end, or "".
  replyStyle: string;
  // The session's record, or null for a session that is not saved.
  record: SessionRecord | null;
  // The flags the session was started with, which the session facts list,
  // or null. Flags only, never anything a user typed as a message: the
  // session facts sit above the user-message boundary.
  flags: Record<string, any> | null;
  // The limits of each turn until a `budget` answer changes them. A
  // negative value is no limit.
  budget: TurnBudget;
  // The policy the session's policy flags resolved to, such as
  // `--policy minimal`, or null when it was started with none. The core
  // only carries it and reports it at every pause. A front-end that
  // resumes the session runs it under this policy in place of its own
  // saved one. It is `any` for the reason `options` is: checking a value
  // against a type fills each optional field it lacks with null.
  policy: any
}

/** A message from the user. `notes` are lines put above it, such as the
  output of a shell command the user ran, or an image's path. `target` is
  a start target such as "code", or "" for the main agent. */
export type Message = {
  kind: "message";
  text: string;
  notes: string[];
  target: string
}

/** Switch models, from a spec such as `opus` or `reasoning=claude-opus-4-8`. */
export type ModelChange = {
  kind: "model";
  spec: string
}

/** Set the session's own LLM options, such as the temperature or the
  routing (the keys of `LlmOptions`). The effort is not one of them: it
  has its own answer. `options` is
  `any` and not `LlmOptions` on purpose: checking a value against a type
  fills each optional field it lacks with null, and a null there means
  "remove this option". */
export type OptionsChange = {
  kind: "options";
  options: any
}

/** Set the limits of each later turn. */
export type BudgetChange = {
  kind: "budget";
  maxCost: number;
  maxTime: number
}

/** Set the reasoning effort: "low", "medium", "high", or "default" to
  send none. It outlasts a model switch. */
export type EffortChange = {
  kind: "effort";
  effort: string
}

/** Switch to a saved preset, whole: its models, options, effort and tool
  limits. The session's own model and effort choices are dropped. */
export type PresetChange = {
  kind: "preset";
  name: string
}

/** Everything the pause accepts. */
export type Answer = Message | ModelChange | OptionsChange | BudgetChange | EffortChange | PresetChange

def pauseData(budget: TurnBudget, policy: any): PauseData {
  const threadId = conversationThread()
  return {
    thread: threadId,
    cwd: getAgentCwd(),
    record: currentRecord(),
    models: getResolvedSlots(),
    preset: activePresetName(),
    fixedProvider: fixedProvider(),
    effort: askedEffort(),
    budget: budget,
    context: contextStatus(threadId),
    brain: currentBrainName(),
    policy: policy
  }
}

/** The record with the brain this run really has, which is what a
  front-end lists the session under. */
def recordFor(record: SessionRecord | null): SessionRecord | null {
  if (record == null) {
    return null
  }
  return { ...record, brain: currentBrainName() }
}

/** Report one file edit's diff, for a front-end to show on the edit and
  on its approval: which edit it is (`filename` and `edits`, as the edit
  tool prepared them) and its hunks. An edit too big to diff, or data that
  is not an edit's, gets no hunks. */
def reportEdit(data: any) {
  if (data == null) {
    return
  }
  emit({
    type: "session.editDiff",
    filename: data.filename,
    edits: data.edits,
    hunks: editDiff(data.before, data.after)
  })
}

// The match over an Answer has no `_` arm on purpose. The type checker
// does not check an object union for a missing case yet. When it does, a
// `_` arm would hide the case it reports.
//
// The turn is run with `try`, so a turn that throws is reported and the
// session goes on, as the terminal's REPL does.
export node session(start: SessionStart) {
  setAgentCwd(start.cwd)
  setSessionFolder(start.cwd)
  setCurrentRecord(recordFor(start.record))
  setReplyStyle(start.replyStyle)
  // A job belongs to the run and stops when the run pauses, and this run
  // pauses after every turn.
  setJobToolsOn(false)
  const bundles = checkCliBundles()
  if (bundles is failure(reason)) {
    throw(reason)
    return
  }
  // Built once. Each turn adds this same text to the conversation.
  setGrounding(groundingText(currentBrainName(), start.flags))
  let budget: TurnBudget = start.budget
  // The session's own policy. Kept in this frame, so every checkpoint
  // holds it and every pause reports it. A start from a front-end that
  // sends no policy carries none.
  let policy: any = start.policy ?? null
  while (true) {
    const raw: any = raise agent::sessionInput("Waiting for the user", pauseData(budget, policy))
    // A run policy that answers this pause sends nothing. Raising again
    // would get the same answer, forever, without ever pausing.
    if (raw == null) {
      return "The session ended: its pause was answered with nothing."
    }
    const answer: Answer! = raw
    if (answer is failure(problem)) {
      emit({
        type: "session.error",
        message: "The run was sent an answer it can't read: ${problem}"
      })
    } else if (answer is success(next)) {
      match(next) {
        { kind: "message", text, notes, target } => {
          const brainName = currentBrainName()
          if (resolveStartTarget(brainName, target) == null) {
            // Refused before anything runs, so it is not a turn.
            const valid = ["main", ...startTargetsFor(brainName)].join(", ")
            emit({
              type: "session.error",
              message: "Unknown start target: ${target}. Valid for the ${brainName} brain: ${valid}"
            })
            continue
          }
          if (target != "" && target != "main" && (budget.maxCost >= 0 || budget.maxTime >= 0)) {
            // A start target calls its subagent directly, and the turn
            // budget is applied where the main agent is called.
            notice("The turn budget does not apply to a turn sent straight to the ${target} agent.", "warning")
          }
          for (note in notes) {
            addNote(note)
          }
          setTurnBudget(budget.maxCost, budget.maxTime)
          // The message is worked out on its own line. A call inside the
          // argument of a `try` call is run again when a paused turn is
          // resumed, and takes the saved frame of the turn (a compiler bug:
          // "Resume desync").
          const message = withPendingNotes(text)
          const startTarget = if target == "main" then "" else target
          let reply: Result<string> = failure("The turn did not run.")
          handle {
            reply = try runTurn(startTarget, message)
          } with (intr) {
            // Every edit's diff. A handler sees an edit even when the
            // run's policy answers it, so an edit a rule approves is
            // reported too. This handler never decides: it always passes.
            if (intr.effect == "std::edit") {
              reportEdit(intr.data)
            }
            return pass()
          }
          if (reply is success(replyText)) {
            emit({ type: "session.reply", text: replyText })
          } else if (reply is failure(err)) {
            emit({ type: "session.error", message: "${err}" })
          }
          applyPendingLlmOptions()
          markTurnDone()
          recordTurn(text)
          compactIfDue(conversationThread())
        }
        { kind: "model", spec } => {
          const switched = applyModelSpec(spec)
          if (switched is failure(reason)) {
            notice(reason, "error")
          }
        }
        { kind: "options", options } => {
          if (isPlainObject(options)) {
            applyLlmOptionsAnswer(options)
          } else {
            emit({
              type: "session.error",
              message: "The run was sent LLM options it can't read: they must be an object."
            })
          }
        }
        { kind: "effort", effort } => {
          const applied = applyEffortAnswer(effort)
          if (applied is failure(reason)) {
            notice(reason, "error")
          }
        }
        { kind: "preset", name } => {
          const presetSwitch = applyPresetAnswer(name)
          if (presetSwitch is failure(reason)) {
            notice("Could not switch preset: ${reason}", "error")
          }
        }
        { kind: "budget", maxCost, maxTime } => {
          budget = {
            maxCost: maxCost,
            maxTime: maxTime
          }
        }
      }
    }
  }
}
