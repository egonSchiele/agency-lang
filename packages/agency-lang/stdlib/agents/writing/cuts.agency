/** @module
  @summary A pass over prose that answers one question for each part: does
  this reader need it? It returns cuts only, never rewrites. Runs beside
  the writing reviewer's main pass.
*/
import { Feedback } from "std::agents/lib/feedback"
import { llmOptions } from "std::agents/lib/shared"
import { readOnlyFileTools } from "std::agents/lib/toolkits"
import { systemMessage, threadIsNew } from "std::thread"

optimize static const cutsPrompt = """You read a piece of prose and decide what the reader does not need. You report cuts only. Rewording, misreadings, and verbal tics are handled by other passes.

Start from the task the text was written for. Name the reader and the decisions or checks they must be able to make after reading. Then go through the text one paragraph at a time, and within a paragraph one sentence at a time, and ask of each: does this reader need it to make those decisions? Material the reader does not need is a cut. Common cuts:
- Background the reader already has, or does not need for the decision.
- The writer's own process: what they tried, checked, or thought before arriving at the fact.
- A second statement of a fact the text already states.
- Detail that serves a different reader (an implementer's note in a user doc, a user's note in a design doc).
- Restating the assignment back to the reader.
- Every value of an option or every member of a set, where knowing the option or set exists is enough for the reader.
- Praise, reassurance, and sentences that comment on the text itself.
- A note the writer left about a decision they made while working, when the decision has no lasting consequence for the reader. A paragraph saying that something did not need to be done, and why, records the writer's checking; the reader will never act on it. The reasoning behind it does not make it needed.
- A whole piece that gives the reader nothing they need. Then say so and recommend removing it; do not list its sentences. Ask this of the whole piece first, before going sentence by sentence.

How to report:
- Do not report the reader or the decisions; they are for your judgment only. Report cuts.
- One finding per cut. Quote the passage exactly, then say why this reader does not need it, in terms of the decision they are making.
- Say "cut". Say "move to <where>" only when the task or the text names a place the passage belongs; do not invent a destination. Do not offer a shorter version of the passage; a cut is a cut.
- Do not add facts and do not suggest new material.
- Set error to true only when the whole piece, or a whole section, should go. Every other cut is advisory: error false.
- Text the reader needs gets no finding. A text with nothing to cut gets an empty list.

If the text names files instead of holding the prose, read each file and review its contents."""

def askForCuts(work: string, task: string, model: string, provider: string): Feedback[] {
  if (threadIsNew()) {
    systemMessage(cutsPrompt)
  }
  return llm(
    """
The text was written for this task:
<task>
${task}
</task>

<text>
${work}
</text>

Return a list of feedback items.
""",
    llmOptions(model: model, provider: provider, tools: readOnlyFileTools(), validationRetries: 1),
  )
}

export def findCuts(
  work: string,
  task: string,
  model: string,
  provider: string,
): Feedback[] {
  """
  Find the parts of the text this reader does not need and return them as
  cut findings.

  @param work - The text under review, or a request naming the files that hold it
  @param task - Who the text is for and what it must get across, or ""
  @param model - Model override, or "" for the ambient model
  @param provider - Provider for the model override
  """
  let found: Feedback[] = []
  thread(label: "cuts") {
    found = askForCuts(work: work, task: task, model: model, provider: provider)
  }
  return found
}

export def cutsOrNothing(
  work: string,
  task: string,
  model: string,
  provider: string,
): Feedback[] {
  """
  findCuts, with a failed call reported as no findings, so the main review
  is not lost because this pass could not run.

  @param work - The text under review, or a request naming the files that hold it
  @param task - Who the text is for and what it must get across, or ""
  @param model - Model override, or "" for the ambient model
  @param provider - Provider for the model override
  """
  const found = try findCuts(work: work, task: task, model: model, provider: provider)
  return match(found) {
    success(items) => items
    failure(_) => []
  }
}
